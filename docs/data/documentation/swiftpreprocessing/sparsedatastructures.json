{"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Memory-Efficient Sparse Matrix Representations","modules":[{"name":"SwiftPreprocessing"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"]}],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"abstract":[{"type":"text","text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats."}],"topicSections":[{"title":"Sparse Data Types","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"],"anchor":"Sparse-Data-Types"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"],"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. "},{"type":"codeVoice","code":"SparseMatrix"},{"text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x.","type":"text"}]},{"text":"Storage Formats","level":2,"type":"heading","anchor":"Storage-Formats"},{"level":3,"text":"Compressed Sparse Row (CSR)","type":"heading","anchor":"Compressed-Sparse-Row-CSR"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stores non-zero values row-by-row:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"values","type":"codeVoice"},{"text":": Non-zero numerical entries.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"colIndices","type":"codeVoice"},{"text":": Column indices corresponding to each entry in ","type":"text"},{"code":"values","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"rowPointers","type":"codeVoice"},{"text":": Offsets into ","type":"text"},{"code":"values","type":"codeVoice"},{"text":" marking where each row begins (length: ","type":"text"},{"code":"rowCount + 1","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"syntax":null,"type":"codeListing","code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"]},{"text":"Compressed Sparse Column (CSC)","level":3,"type":"heading","anchor":"Compressed-Sparse-Column-CSC"},{"type":"paragraph","inlineContent":[{"text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication.","type":"text"}]},{"text":"Apple Accelerate Sparse BLAS","level":2,"type":"heading","anchor":"Apple-Accelerate-Sparse-BLAS"},{"type":"paragraph","inlineContent":[{"text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), ","type":"text"},{"type":"codeVoice","code":"SparseMatrix"},{"text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"sparse_matrix_create_double","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sparse_insert_row_double","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sparse_commit","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sparse_matrix_vector_product_dense_double","type":"codeVoice"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput.","type":"text"}]},{"text":"Example Usage","level":2,"type":"heading","anchor":"Example-Usage"},{"syntax":"swift","type":"codeListing","code":["import SwiftPreprocessing","","\/\/ 1. Create a sparse matrix from a dense array","let dense: [[Double]] = [","    [1.0, 0.0, 0.0],","    [0.0, 2.0, 0.0],","    [0.0, 0.0, 3.0]","]","let sparse = SparseMatrix(dense: dense, format: .csr)","print(\"Sparsity: \\(sparse.sparsity)\") \/\/ ~ 0.667","","\/\/ 2. Accelerated matrix-vector product","let x = [1.0, 2.0, 3.0]","let y = try sparse.multiply(vector: x)","print(y) \/\/ [1.0, 4.0, 9.0]","","\/\/ 3. Matrix Transpose & CSC conversion","let csc = sparse.toCSC()","let transposed = sparse.transpose()"]}]}],"sections":[],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/FeatureScaling":{"role":"article","type":"topic","title":"Feature Scaling, Normalization & Flat 1D Memory","abstract":[{"text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using ","type":"text"},{"type":"codeVoice","code":"StandardScaler"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MinMaxScaler"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RobustScaler"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"Normalizer"},{"text":" powered by Apple Accelerate ","type":"text"},{"type":"codeVoice","code":"vDSP"},{"text":".","type":"text"}],"identifier"