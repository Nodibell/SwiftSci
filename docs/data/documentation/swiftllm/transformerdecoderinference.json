{"abstract":[{"type":"text","text":"Explore the low-level mechanics of Metal GPU-accelerated transformer decoders and KV-Caching in SwiftLLM."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference"},"metadata":{"modules":[{"name":"SwiftLLM"}],"title":"Autoregressive Transformer Decoder Architecture","roleHeading":"API Collection","role":"collectionGroup"},"topicSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache"],"anchor":"LLM-Components","title":"LLM Components"}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"text":" implements modern decoder-only generative transformer models (such as Llama, Qwen, and Gemma) leveraging MLX Metal acceleration on Apple Silicon unified memory.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"1. Key Architectural Blocks","anchor":"1-Key-Architectural-Blocks","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rotary Position Embedding (RoPE)"}]},{"type":"text","text":": Encodes positional information by rotating query and key vectors in 2D planes, preserving relative distance relationships."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"RMSNorm"}]},{"type":"text","text":": Root Mean Square Layer Normalization provides training stability with reduced computational overhead compared to LayerNorm."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SwiGLU Activation"}]},{"type":"text","text":": Gated linear unit activation "},{"type":"codeVoice","code":"SwiGLU(x) = Swish(x · W_1) ⊙ (x · W_2)"},{"type":"text","text":" for enhanced non-linear representation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Paged KV-Cache"}]},{"type":"text","text":": Stores precomputed Key and Value projection matrices across generation steps, eliminating "},{"type":"codeVoice","code":"O(N²)"},{"type":"text","text":" recomputation."}],"type":"paragraph"}]}]},{"type":"heading","text":"2. Generating Tokens","anchor":"2-Generating-Tokens","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftLLM","","\/\/ Load model weights and tokenizer","let config = LLMConfiguration(","    vocabSize: 32000,","    hiddenDimension: 4096,","    numLayers: 32,","    numHeads: 32,","    contextLength: 4096",")","","let model = TransformerDecoder(configuration: config)","","\/\/ Stream autoregressive tokens","for try await token in model.generateStream(prompt: \"The future of scientific computing\", maxTokens: 50) {","    print(token, terminator: \"\")","}"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/transformerdecoderinference"]}],"references":{"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoder":{"type":"topic","title":"TransformerDecoder","abstract":[{"text":"A full N-layer decoder-only Transformer.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransformerDecoder","kind":"identifier"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","url":"\/documentation\/swiftllm\/transformerdecoder","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"TransformerDecoder","kind":"identifier"}]},"doc://SwiftLLM/documentation/SwiftLLM/KVCache":{"url":"\/documentation\/swiftllm\/kvcache","title":"KVCache","abstract":[{"type":"text","text":"Key-Value cache storing previous Attention Keys and Values per layer for O(N) generation."}],"type":"topic","navigatorTitle":[{"text":"KVCache","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KVCache","kind":"identifier"}]},"doc://SwiftLLM/documentation/SwiftLLM":{"title":"SwiftLLM","abstract":[{"text":"Local Causal Transformer Decoder & Weight Parsers.","type":"text"}],"url":"\/documentation\/swiftllm","role":"collection","kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","type":"topic"}}}