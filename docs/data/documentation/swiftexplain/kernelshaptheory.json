{"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"title":"SHAP Explainer APIs","anchor":"SHAP-Explainer-APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SHAP (SHapley Additive exPlanations)"}]},{"type":"text","text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory."}]},{"level":2,"anchor":"1-The-Four-Shapley-Axioms","type":"heading","text":"1. The Four Shapley Axioms"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Efficiency","type":"text"}]},{"type":"text","text":": Feature attributions sum up to the difference between model prediction "},{"type":"codeVoice","code":"f(x)"},{"type":"text","text":" and expected background prediction "},{"type":"codeVoice","code":"E[f(X)]"},{"type":"text","text":":"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"code":"Σ_i=1..M φ_i = f(x) - E[f(X)]","type":"codeVoice"}]}],"type":"aside","style":"note"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Symmetry","type":"text"}]},{"type":"text","text":": If two features contribute equally to all possible feature subsets, their attributions are equal."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Dummy (Null Player)"}],"type":"strong"},{"text":": A feature that does not change the model prediction for any coalition receives an attribution of zero (","type":"text"},{"code":"φ_i = 0","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Additivity"}],"type":"strong"},{"text":": For ensemble models ","type":"text"},{"code":"f = f1 + f2","type":"codeVoice"},{"text":", attributions satisfy ","type":"text"},{"code":"φ_i(f) = φ_i(f1) + φ_i(f2)","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"level":2,"anchor":"2-Explaining-Predictions-in-SwiftSci","type":"heading","text":"2. Explaining Predictions in SwiftSci"},{"code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"],"type":"codeListing","syntax":"swift"}]}],"metadata":{"role":"collectionGroup","roleHeading":"API Collection","title":"Game-Theoretic Interpretability with Kernel SHAP","modules":[{"name":"SwiftExplain"}]},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"variants":[{"paths":["\/documentation\/swiftexplain\/kernelshaptheory"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"role":"collection","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","title":"SwiftExplain","type":"topic","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}],"url":"\/documentation\/swiftexplain","kind":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}],"url":"\/documentation\/swiftexplain\/kernelshap","title":"KernelSHAP","kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KernelSHAP","kind":"identifier"}]}}}