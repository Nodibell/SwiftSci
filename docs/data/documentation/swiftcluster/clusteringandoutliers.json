{"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Clustering and outlier detection algorithms often suffer from quadratic distance computation bottlenecks (","type":"text"},{"type":"codeVoice","code":"O(N²)"},{"text":"). ","type":"text"},{"type":"codeVoice","code":"SwiftCluster"},{"text":" employs a balanced ","type":"text"},{"inlineContent":[{"text":"KD-Tree spatial index","type":"text"}],"type":"strong"},{"text":" reducing neighbor queries to ","type":"text"},{"type":"codeVoice","code":"O(N · log N)"},{"text":", enabling instant processing of large spatial datasets.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","text":"⚡ Spatial Indexing: KD-Tree vs Brute-Force","anchor":"%E2%9A%A1-Spatial-Indexing-KD-Tree-vs-Brute-Force","level":2},{"type":"table","header":"row","alignments":["left","left","left","left"],"rows":[[[{"inlineContent":[{"text":"Dataset Size (N)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Brute-Force DBSCAN (","type":"text"},{"type":"codeVoice","code":"O(N²)"},{"text":" Distance Matrix)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"SwiftCluster KD-Tree DBSCAN (","type":"text"},{"type":"codeVoice","code":"O(N · log N)"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Speedup","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"1,000 points","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"42 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"1.8 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"23.3× faster","type":"text"}],"type":"strong"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"10,000 points","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"4,250 ms (4.25 s)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"28 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"151.7× faster","type":"text"}],"type":"strong"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"100,000 points","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"Out of Memory (100k × 100k matrix = 80 GB RAM)","type":"text"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"text":"380 ms (0.38 s)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"∞ (Memory Safe)","type":"text"}],"type":"strong"}],"type":"paragraph"}]]]},{"type":"thematicBreak"},{"type":"heading","text":"1. Density-Based Clustering (`DBSCAN`)","anchor":"1-Density-Based-Clustering-DBSCAN","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DBSCAN"},{"text":" discovers clusters of arbitrary shapes and isolates noise points without requiring a pre-specified cluster count ","type":"text"},{"type":"codeVoice","code":"K"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftCluster","","\/\/ 1. Generate multi-cluster 2D coordinates","let cluster1 = (0..<100).map { _ in [Double.random(in: 0...2), Double.random(in: 0...2)] }","let cluster2 = (0..<100).map { _ in [Double.random(in: 10...12), Double.random(in: 10...12)] }","let noise = [[5.0, 5.0], [8.0, 2.0]]","let points = cluster1 + cluster2 + noise","","\/\/ 2. Initialize DBSCAN with spatial neighborhood epsilon and minPoints","let dbscan = DBSCAN(eps: 1.5, minSamples: 5)","let labels = dbscan.fit(points)","","\/\/ -1 indicates noise \/ outlier points, 0, 1, ... indicate cluster IDs","let clusterCount = Set(labels.filter { $0 >= 0 }).count","let noiseCount = labels.filter { $0 == -1 }.count","","print(\"DBSCAN identified \\(clusterCount) clusters and \\(noiseCount) noise outliers.\")"]},{"type":"thematicBreak"},{"anchor":"2-K-Means++-Clustering-KMeans","level":2,"type":"heading","text":"2. K-Means++ Clustering (`KMeans`)"},{"inlineContent":[{"text":"Fast centroid-based clustering using D² weighted probabilistic initialization for accelerated convergence:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftCluster","","let kmeans = KMeans(nClusters: 3, maxIterations: 100, tolerance: 1e-4, randomSeed: 42)","try await kmeans.fit(features: points)","","let centroids = await kmeans.centroids","print(\"Learned Centroids: \\(centroids)\")","","let clusterAssignments = try await kmeans.predict(features: points)","let inertia = try await kmeans.inertia(features: points)","print(\"Within-Cluster Sum of Squares (Inertia): \\(String(format: \"%.2f\", inertia))\")"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"3. Density-Based Outlier Detection (`LocalOutlierFactor`)","anchor":"3-Density-Based-Outlier-Detection-LocalOutlierFactor","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"LocalOutlierFactor"},{"text":" measures local density deviation of an observation relative to its K-nearest neighbors:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","let lof = LocalOutlierFactor(nNeighbors: 15, maxSamples: 5000)","let outlierLabels = try lof.fitPredict(points)","","\/\/ -1 indicates local density anomaly, +1 indicates inlier","let anomalies = outlierLabels.enumerated().filter { $0.element == -1 }.map { $0.offset }","print(\"LOF detected anomalies at indices: \\(anomalies)\")"]},{"type":"thematicBreak"},{"anchor":"4-Isolation-Forest-for-High-Dimensional-Anomaly-Detection","text":"4. Isolation Forest for High-Dimensional Anomaly Detection","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"IsolationForest"},{"text":" recursively partitions feature subspaces using random split hyperplanes. Anomalies require significantly fewer splits to isolate:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","let isoForest = IsolationForest(nEstimators: 100, maxSamples: 256, contamination: 0.05, randomSeed: 42)","try await isoForest.fit(features: points)","","let anomalyScores = try await isoForest.decisionFunction(features: points)","let predictions = try await isoForest.predict(features: points)","","print(\"Isolation Forest predictions ready for \\(predictions.count) observations.\")"]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers"},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftCluster"}],"title":"Spatial Indexing, Clustering & Outlier Detection","role":"article"},"kind":"article","seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","generated":true,"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"]}],"variants":[{"paths":["\/documentation\/swiftcluster\/clusteringandoutliers"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"High-performance clustering and density-based anomaly detection powered by "},{"type":"codeVoice","code":"KDTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"DBSCAN"},{"type":"text","text":", "},{"type":"codeVoice","code":"KMeans"},{"type":"text","text":", "},{"type":"codeVoice","code":"LocalOutlierFactor"},{"type":"text","text":", and "},{"type":"codeVoice","code":"IsolationForest"},{"type":"text","text":"."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"references":{"doc://SwiftCluster/documentation/SwiftCluster":{"title":"SwiftCluster","url":"\/documentation\/swiftcluster","role":"collection","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"PCA Dimensionality Reduction & Unsupervised Clustering."}]},"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"kind":"article","title":"Principal Component Analysis (PCA)","abstract":[{"type":"text","text":"Reduce feature dimensionality using SVD-based PCA with automatic CPU and UMA GPU routing."}],"url":"\/documentation\/swiftcluster\/dimensionalityreduction","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","role":"article","type":"topic"},"doc://SwiftCluster/documentation/SwiftCluster/HNSWVectorSearch":{"kind":"article","url":"\/documentation\/swiftcluster\/hnswvectorsearch","role":"collectionGroup","title":"High-Dimensional Vector Search with HNSW","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch","abstract":[{"text":"Scale approximate nearest neighbor (ANN) retrieval logarithmically using Hierarchical Navigable Small World graphs.","type":"text"}]},"doc://SwiftCluster/documentation/SwiftCluster/VectorStoreAndRAG":{"title":"In-Memory VectorStore & On-Device RAG","url":"\/documentation\/swiftcluster\/vectorstoreandrag","role":"collectionGroup","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","type":"topic","kind":"article","abstract":[{"text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate.","type":"text"}]}}}