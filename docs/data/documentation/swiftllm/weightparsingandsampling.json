ders for Quantized LLMs"},"doc://SwiftLLM/documentation/SwiftLLM/Sampler":{"url":"\/documentation\/swiftllm\/sampler","abstract":[{"type":"text","text":"Generates next token predictions from logits using probabilistic sampling."}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"title":"Sampler","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler"},"doc://SwiftLLM/documentation/SwiftLLM":{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/swiftllm","title":"SwiftLLM","abstract":[{"type":"text","text":"Local Causal Transformer Decoder & Weight Parsers."}]}}}