{"kind":"article","sections":[],"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","title":"Data Lineage & Transformation Audit Trails"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/datalineageaudit"]}],"abstract":[{"type":"text","text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents."}],"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"topicSections":[{"anchor":"Audit-Types","title":"Audit Types","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"text":" automatically generates an immutable audit trail of ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true,"type":"reference"},{"text":" entries for each command evaluated.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"LineageRecord-Structure","type":"heading","text":"LineageRecord Structure"},{"inlineContent":[{"text":"Each ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true,"type":"reference"},{"text":" contains:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stepIndex"},{"type":"text","text":": Sequential index of the step within the agent trajectory."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"operation"},{"type":"text","text":": The normalized DSL command executed (e.g., "},{"type":"codeVoice","code":"filter(age)"},{"type":"text","text":", "},{"type":"codeVoice","code":"groupBy(category,mean)"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"inputRows"},{"type":"text","text":": Dataset row count immediately prior to transformation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"outputRows"},{"type":"text","text":": Dataset row count produced by the transformation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"},{"type":"text","text":": The exact timestamp of execution."}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Example-Accessing-Audit-Trails","type":"heading","text":"Example: Accessing Audit Trails"},{"code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"abstract":[{"text":"Agentic REPL Execution Sandbox & RAG Summary Engine.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","title":"SwiftAgent","url":"\/documentation\/swiftagent","role":"collection