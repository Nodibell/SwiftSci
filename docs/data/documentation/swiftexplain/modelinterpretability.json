{"abstract":[{"text":"Understand black-box machine learning predictions using ","type":"text"},{"type":"codeVoice","code":"TreeSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"KernelSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"LIMEExplainer"},{"type":"text","text":", "},{"type":"codeVoice","code":"PermutationImportance"},{"text":", and ","type":"text"},{"code":"PartialDependencePlot","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Explainable Artificial Intelligence (XAI) bridges the gap between predictive accuracy and decision transparency. "},{"type":"codeVoice","code":"SwiftExplain"},{"type":"text","text":" provides exact Shapley mathematical decomposition for tree-based models, local linear surrogate modeling with LIME, and model-agnostic permutation metrics."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"%F0%9F%93%8A-Explainability-Methods-Comparison","text":"📊 Explainability Methods Comparison","level":2},{"rows":[[[{"inlineContent":[{"type":"text","text":"Method"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Supported Models"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Algorithmic Complexity","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Scope"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Recommendation"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"TreeSHAP","type":"codeVoice"}]}],"type":"paragraph"}],[{"inlineContent":[{"code":"DecisionTreeClassifier","type":"codeVoice"},{"type":"text","text":", "},{"code":"DecisionTreeRegressor","type":"codeVoice"},{"type":"text","text":", "},{"code":"RandomForestClassifier","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RandomForestRegressor"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"O(T · 2^K · L)","type":"codeVoice"},{"text":" exact (","type":"text"},{"code":"K ≤ 12","type":"codeVoice"},{"text":"); ","type":"text"},{"code":"O(T · S · K · L)","type":"codeVoice"},{"text":" seeded MC (","type":"text"},{"code":"K > 12","type":"codeVoice"},{"text":", ","type":"text"},{"code":"S = 2048","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Local & Global","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Exact for ","type":"text"},{"code":"K ≤ 12","type":"codeVoice"},{"type":"text","text":" distinct split features"}],"type":"strong"},{"text":" using path-dependent uniform leaf weights (","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":"). Does not support ","type":"text"},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"text":" or per-class probability attributions in ","type":"text"},{"type":"codeVoice","code":"v3.13.x"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"KernelSHAP","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Any black-box model (MLP, SVM, Ensembles)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(S · D²)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Local","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Universal Shapley attribution using weighted coalition sampling.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"LIME"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any black-box model (MLP, Vision, NLP)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(S · D)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Local","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fast local surrogate."}]},{"type":"text","text":" Fits an interpretable weighted linear model around perturbations."}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PermutationImportance"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any model"}]}],[{"inlineContent":[{"code":"O(D · N)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Global","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fast global feature ranking by measuring validation loss degradation upon feature column shuffling."}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"code":"PartialDependencePlot","type":"codeVoice"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Any model","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"O(G · N)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Global"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Visualizes marginal effect of 1 or 2 features across an evaluation grid.","type":"text"}],"type":"paragraph"}]]],"alignments":["left","left","left","left","left"],"type":"table","header":"row"},{"type":"thematicBreak"},{"level":2,"text":"1. Path-Dependent TreeSHAP for Decision Trees & Random Forests","anchor":"1-Path-Dependent-TreeSHAP-for-Decision-Trees--Random-Forests","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"TreeSHAP","type":"codeVoice"},{"type":"text","text":" evaluates path-dependent conditional expectations over each tree’s leaves using uniform leaf weights ("},{"code":"1.0","type":"codeVoice"},{"text":"). When a tree splits on ","type":"text"},{"type":"codeVoice","code":"K ≤ TreeSHAP.maxExactFeatures"},{"text":" (","type":"text"},{"type":"codeVoice","code":"12"},{"text":") distinct features, ","type":"text"},{"type":"codeVoice","code":"TreeSHAP"},{"type":"text","text":" enumerates all "},{"code":"2^K","type":"codeVoice"},{"type":"text","text":" coalitions in "},{"type":"codeVoice","code":"O(2^K · L)"},{"type":"text","text":" time to compute exact Shapley values; when "},{"type":"codeVoice","code":"K > 12"},{"type":"text","text":", it switches to deterministic seeded Monte Carlo permutation sampling ("},{"type":"codeVoice","code":"approximationSamples = 2048"},{"text":"):","type":"text"}]},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"text":"Known limitations in ","type":"text"},{"code":"v3.13.x","type":"codeVoice"},{"text":" (deferred to a future release):","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"G-035 ("},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"type":"text","text":")"}],"type":"strong"},{"text":": ","type":"text"},{"code":"TreeSHAP","type":"codeVoice"},{"text":" does not provide a ","type":"text"},{"code":"GradientBoostedTreesRegressor","type":"codeVoice"},{"text":" adapter in ","type":"text"},{"code":"v3.13.x","type":"codeVoice"},{"type":"text","text":" ("},{"code":"explainDetailed(trees:)","type":"codeVoice"},{"text":" computes an unweighted ","type":"text"},{"code":"1\/T","type":"codeVoice"},{"text":" ensemble average rather than ","type":"text"},{"code":"initialPrediction + learningRate * sum_m T_m(x)","type":"codeVoice"},{"text":"). Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","type":"reference"},{"text":" for GBDT models.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"G-036 (Classification & Leaf Weights)","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"FlatTreeNode","type":"codeVoice"},{"text":" does not store training sample counts (","type":"text"},{"code":"cover","type":"codeVoice"},{"text":"), so ","type":"text"},{"code":"TreeSHAP","type":"codeVoice"},{"text":" weights all leaves uniformly (","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":"); ","type":"text"},{"code":"RandomForestClassifier","type":"codeVoice"},{"text":" trees do not populate ","type":"text"},{"code":"classDistribution","type":"codeVoice"},{"text":" on leaves, and ","type":"text"},{"code":"DecisionTreeClassifier.prune(alpha:)","type":"codeVoice"},{"text":" clears ","type":"text"},{"code":"classDistribution","type":"codeVoice"},{"text":" on collapsed nodes. Consequently, classifier ","type":"text"},{"code":"TreeSHAP","type":"codeVoice"},{"text":" attributes the scalar ","type":"text"},{"type":"codeVoice","code":"node.value"},{"text":" label code rather than per-class ","type":"text"},{"type":"codeVoice","code":"predictProbability"},{"text":" distributions.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftML","import SwiftExplain","","\/\/ 1. Train a Random Forest Classifier","let X = [[1.0, 2.0], [2.0, 1.0], [5.0, 4.0], [6.0, 5.0]]","let y = [0, 0, 1, 1]","","let forest = try RandomForestClassifier(nEstimators: 10, maxDepth: 4)","try await forest.fit(features: X, labels: y)","","\/\/ 2. Explain prediction on a target instance","let treeSHAP = TreeSHAP()","let instance = [5.5, 4.2]","","let shapValues = await treeSHAP.explain(randomForest: forest, instance: instance)","","print(\"=== TreeSHAP Feature Attributions ===\")","for (featureIdx, attribution) in shapValues.enumerated() {","    print(\"Feature \\(featureIdx): Contribution = \\(String(format: \"%+.4f\", attribution))\")","}"]},{"type":"thematicBreak"},{"text":"2. Local Interpretable Model-agnostic Explanations (`LIME`)","type":"heading","anchor":"2-Local-Interpretable-Model-agnostic-Explanations-LIME","level":2},{"inlineContent":[{"code":"LIMEExplainer","type":"codeVoice"},{"text":" perturbs the neighborhood of a target sample using Box-Muller Gaussian noise, weights samples by an exponential distance kernel, and fits a weighted Ridge regression surrogate model:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Black-box model closure","let modelClosure: @Sendable ([Double]) async -> Double = { x in","    \/\/ Non-linear complex interaction","    return 3.0 * x[0] + sin(x[1] * 2.0) - 1.5 * x[2] * x[2] + 4.0","}","","let instance = [1.5, 0.8, -0.4]","","let lime = LIMEExplainer(kernelWidth: 0.75, regularization: 0.1)","let explanation = await lime.explain(","    model: modelClosure,","    instance: instance,","    numSamples: 500",")","","print(\"=== LIME Local Surrogate Explanation ===\")","print(\"Local Prediction: \\(String(format: \"%.4f\", explanation.prediction))\")","print(\"Surrogate Intercept: \\(String(format: \"%.4f\", explanation.intercept))\")","print(\"Local Goodness-of-Fit (R²): \\(String(format: \"%.2f%%\", explanation.localR2 * 100))\")","","for (d, weight) in explanation.featureWeights.enumerated() {","    print(\"Feature [\\(d)] Local Slope: \\(String(format: \"%+.4f\", weight))\")","}"],"syntax":"swift"},{"type":"thematicBreak"},{"anchor":"3-Global-Permutation-Feature-Importance","type":"heading","level":2,"text":"3. Global Permutation Feature Importance"},{"inlineContent":[{"type":"text","text":"Measure global model dependence by quantifying score drop when a single feature column is randomly permuted:"}],"type":"paragraph"},{"code":["import SwiftExplain","","let perm = PermutationImportance()","let importances = try await perm.computeImportance(","    features: X,","    targets: y.map(Double.init)",") { matrix in","    try await forest.predict(features: matrix).map(Double.init)","}","","print(\"=== Global Feature Importance Ranking ===\")","for (feat, score) in importances.sorted(by: { $0.value > $1.value }) {","    print(\"\\(feat): Importance Score = \\(String(format: \"%.4f\", score))\")","}"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/modelinterpretability"]}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","seeAlsoSections":[{"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions"],"generated":true}],"metadata":{"title":"Model Interpretability & XAI Guide","roleHeading":"Article","modules":[{"name":"SwiftExplain"}],"role":"article"},"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}],"url":"\/documentation\/swiftexplain\/kernelshap","title":"KernelSHAP","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KernelSHAP"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"},"doc://SwiftExplain/documentation/SwiftExplain/LIMEExplainer":{"abstract":[{"type":"text","text":"Local Interpretable Model-agnostic Explanations (LIME)."}],"role":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","url":"\/documentation\/swiftexplain\/limeexplainer","kind":"symbol","type":"topic","navigatorTitle":[{"text":"LIMEExplainer","kind":"identifier"}],"title":"LIMEExplainer","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"LIMEExplainer"}]},"doc://SwiftExplain/documentation/SwiftExplain/ShapleyAttributions":{"type":"topic","role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"Explain machine learning model predictions with game-theoretic Shapley value attributions (TreeSHAP, KernelSHAP) and local linear surrogates (LIME)."}],"url":"\/documentation\/swiftexplain\/shapleyattributions","title":"SHAP & LIME Model Interpretability","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions"},"doc://SwiftExplain/documentation/SwiftExplain":{"type":"topic","role":"collection","kind":"symbol","abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"url":"\/documentation\/swiftexplain","title":"SwiftExplain","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain"}}}