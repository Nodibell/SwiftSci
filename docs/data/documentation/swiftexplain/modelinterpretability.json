ype":"thematicBreak"},{"anchor":"1-Path-Dependent-TreeSHAP-for-Trees-Forests--GBDTs","type":"heading","level":2,"text":"1. Path-Dependent TreeSHAP for Trees, Forests & GBDTs"},{"type":"paragraph","inlineContent":[{"code":"TreeSHAP","type":"codeVoice"},{"type":"text","text":" evaluates path-dependent conditional expectations over each tree’s leaves using either "},{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeNodeWeighting\/uniformLeaf","isActive":true,"type":"reference"},{"type":"text","text":" (default, leaf weight "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":") or "},{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeNodeWeighting\/empiricalCover","isActive":true,"type":"reference"},{"type":"text","text":" (leaf weight "},{"code":"FlatTreeNode.cover","type":"codeVoice"},{"type":"text","text":", with automatic fallback to "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" when decoding legacy "},{"code":"<= 3.13.3","type":"codeVoice"},{"type":"text","text":" serialized models). When a tree splits on "},{"code":"K ≤ TreeSHAP.maxExactFeatures","type":"codeVoice"},{"type":"text","text":" ("},{"code":"12","type":"codeVoice"},{"type":"text","text":") distinct features, "},{"code":"TreeSHAP","type":"codeVoice"},{"type":"text","text":" enumerates all "},{"code":"2^K","type":"codeVoice"},{"type":"text","text":" coalitions in "},{"code":"O(2^K · L)","type":"codeVoice"},{"type":"text","text":" time to compute exact Shapley values; when "},{"code":"K > 12","type":"codeVoice"},{"type":"text","text":", it switches to deterministic seeded Monte Carlo permutation sampling ("},{"code":"approximationSamples = 2048","type":"codeVoice"},{"type":"text","text":"):"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"GBDT ("},{"code":"GradientBoostedTreesRegressor","type":"codeVoice"},{"type":"text","text":")"}],"type":"strong"},{"text":": ","type":"text"},{"code":"explainDetailed(gbdt:instance:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"explain(gbdt:instance:)","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"explainBatch(gbdt:instances:)","type":"codeVoice"},{"text":" apply ","type":"text"},{"code":"initialPrediction + learningRate * sum_m T_m(x)","type":"codeVoice"},{"text":" with per-tree Shapley attributions scaled by ","type":"text"},{"code":"learningRate","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Per-Class Classification ("},{"code":"DecisionTreeClassifier","type":"codeVoice"},{"type":"text","text":", "},{"code":"RandomForestClassifier","type":"codeVoice"},{"type":"text","text":")"}],"type":"strong"},{"text":": ","type":"text"},{"code":"explainClassDetailed","type":"codeVoice"},{"text":", ","type":"text"},{"code":"explainAllClassesDetailed","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"explainBatchClass","type":"codeVoice"},{"text":" decompose calibrated ","type":"text"},{"code":"predictProbability","type":"codeVoice"},{"text":" outputs (supporting ","type":"text"},{"code":"ForestProbabilityMode.hardVote","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ForestProbabilityMode.softLeafDistribution","type":"codeVoice"},{"text":"), while ","type":"text"},{"code":"explain(decisionTree:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"explain(randomForest:)","type":"codeVoice"},{"text":" preserve scalar ","type":"text"},{"code":"FlatTreeNode.value","type":"codeVoice"},{"text":" compatibility. ","type":"text"},{"code":"DecisionTreeClassifier.prune(alpha:)","type":"codeVoice"},{"text":" preserves both empirical ","type":"text"},{"code":"classDistribution","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cover","type":"codeVoice"},{"text":" on collapsed leaves.","type":"text"}]}]}],"type":"unorderedList"},{"code":["import Foundation","import SwiftML","import S