{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"abstract":[{"type":"text","text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon and perform zero-shot classification without model training."}],"topicSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"],"anchor":"Embedding-Engine-Types","title":"Embedding Engine Types"},{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotClassificationResult"],"anchor":"Zero-Shot-Classification","title":"Zero-Shot Classification"}],"variants":[{"paths":["\/documentation\/swiftnlp\/denselocalembeddings"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings","interfaceLanguage":"swift"},"metadata":{"title":"Dense Local Text Embeddings & Zero-Shot Classification","modules":[{"name":"SwiftNLP"}],"role":"collectionGroup","roleHeading":"API Collection"},"kind":"article","sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modern Retrieval-Augmented Generation (RAG), semantic vector search, and automated data categorization require fast, high-quality vector representations of text. "},{"code":"SwiftNLP","type":"codeVoice"},{"text":" provides a unified architecture via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider"},{"type":"text","text":", offering two distinct engine implementations:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","isActive":true,"type":"reference"}]},{"type":"text","text":": Native 512-dimensional contextual semantic embeddings powered by Apple Natural Language and Core ML foundation models with Accelerate $L_2$ unit normalization."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","isActive":true,"type":"reference"}]},{"text":": Deterministic, lightweight subword N-gram hashing projection producing customizable $D$-dimensional embeddings in microseconds with zero disk weight.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both engines integrate seamlessly with "},{"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","isActive":true},{"type":"text","text":" for zero-shot text categorization and "},{"type":"reference","identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftcluster\/vectorstore\/","isActive":true},{"type":"text","text":" for real-time similarity search."}]},{"type":"codeListing","code":["graph TD","    Text[Raw Text \/ Document] --> Provider[SentenceEmbeddingProvider]","    Provider --> Apple[AppleSentenceEmbeddingEngine: 512-D Core ML]","    Provider --> Hash[LocalEmbeddingEngine: Subword N-Gram Projection]","    Apple --> SIMDNorm[Accelerate vDSP L2 Unit Normalization]","    Hash --> SIMDNorm","    SIMDNorm --> NormalizedVec[Unit Vector: ||v|| = 1.0]","    NormalizedVec --> VectorStore[(SwiftCluster VectorStore \/ HNSW)]","    NormalizedVec --> ZeroShot[ZeroShotTextClassifier Softmax Probabilities]"],"syntax":"mermaid"},{"type":"thematicBreak"},{"anchor":"1-Choosing-an-Embedding-Engine","type":"heading","text":"1. Choosing an Embedding Engine","level":2},{"alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Feature","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppleSentenceEmbeddingEngine"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalEmbeddingEngine"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Underlying Mechanism"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Apple Natural Language \/ Core ML","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Subword N-Gram Hashing (FNV-1a + Signs)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Embedding Dimension"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fixed 512-D","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Configurable (e.g., 64, 128, 256, 512)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Weights on Disk"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"0 MB (pre-installed system foundation model)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"0 MB (algorithmic hash projection)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Semantic Awareness"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"High (contextual, synonym & paraphrase aware)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Lexical \/ Syntactic (spelling, morphology, keyword)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Typical Latency"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"~0.5 – 1.5 ms \/ text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"~0.05 – 0.15 ms \/ text","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Best Used For"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"RAG retrieval, zero-shot classification, semantic search","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"High-throughput deduplication, fuzzy search, microcontrollers","type":"text"}]}]]],"header":"row","type":"table"},{"type":"thematicBreak"},{"anchor":"2-Using-AppleSentenceEmbeddingEngine","type":"heading","text":"2. Using `AppleSentenceEmbeddingEngine`","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","isActive":true},{"type":"text","text":" leverages Apple Silicon’s Neural Engine to produce 512-dimensional contextual embeddings. All output vectors are automatically normalized to unit length ($|v|_2 = 1.0$) using Accelerate SIMD operations ("},{"type":"codeVoice","code":"vDSP_svesqD"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vDSP_vsdivD"},{"type":"text","text":"):"}]},{"code":["import SwiftNLP","","\/\/ Initialize native Apple sentence embedder","let engine = AppleSentenceEmbeddingEngine()","","\/\/ Verify availability for current device and locale","guard engine.isAvailable(for: .english) else {","    fatalError(\"Apple sentence embedding model not available for English on this system.\")","}","","\/\/ Generate a 512-dimensional embedding","let embedding = try await engine.embed(\"Retrieval-Augmented Generation with SwiftSci\")","print(\"Vector length: \\(embedding.count)\") \/\/ 512","","\/\/ Batch asynchronous embedding generation","let documents = [","    \"Apple Accelerate provides vectorized SIMD routines.\",","    \"Metal Performance Shaders accelerate tensor operations.\",","    \"SwiftData provides declarative SQLite persistence.\"","]","let batchVectors = try await engine.embedBatch(documents)"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"3-Using-LocalEmbeddingEngine","type":"heading","text":"3. Using `LocalEmbeddingEngine`","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For memory-constrained environments or extreme throughput requirements, "},{"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","isActive":true},{"type":"text","text":" computes embeddings via subword character n-gram projections without model weights:"}]},{"code":["import SwiftNLP","","\/\/ Initialize with custom dimensionality (default: 128)","let fastEngine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Synchronous and asynchronous embedding","let vector = fastEngine.embed(\"Fast in-memory hashing projection\")","let batch = try await fastEngine.embedBatch([\"Document A\", \"Document B\"])"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"4-Measuring-Semantic-Similarity","type":"heading","text":"4. Measuring Semantic Similarity","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because all embeddings produced by "},{"type":"codeVoice","code":"SentenceEmbeddingProvider"},{"type":"text","text":" are unit-normalized, the "},{"type":"strong","inlineContent":[{"text":"Cosine Similarity","type":"text"}]},{"type":"text","text":" between two vectors $u$ and $v$ is mathematically identical to their direct "},{"type":"strong","inlineContent":[{"text":"Dot Product","type":"text"}]},{"type":"text","text":":"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"$$\\text{CosineSimilarity}(u, v) = \\frac{u \\cdot v}{|u|_2 |v|_2} = u \\cdot v$$"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate cosine similarity at native memory speeds using Apple Accelerate:"}]},{"code":["import Accelerate","","func cosineSimilarity(_ a: [Double], _ b: [Double]) -> Double {","    guard a.count == b.count, !a.isEmpty else { return 0.0 }","    var dot: Double = 0.0","    vDSP_dotprD(a, 1, b, 1, &dot, vDSP_Length(a.count))","    return dot","}","","let queryVec = try await engine.embed(\"Vector mathematics on Mac\")","let docVec = try await engine.embed(\"Apple Accelerate linear algebra\")","let similarity = cosineSimilarity(queryVec, docVec)","print(\"Semantic similarity score: \\(similarity)\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"5-Zero-Shot-Text-Classification","type":"heading","text":"5. Zero-Shot Text Classification","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Classify arbitrary text documents into dynamic candidate categories on the fly without training a classifier or labeling training sets:"}]},{"code":["import SwiftNLP","","\/\/ Initialize classifier with Apple embeddings","let classifier = ZeroShotTextClassifier(","    embeddingEngine: AppleSentenceEmbeddingEngine(),","    hypothesisTemplate: \"This text is about {}.\"",")","","\/\/ Single-label classification (Softmax distribution)","let result = try await classifier.classify(","    text: \"The patient presented with elevated systolic pressure and sinus tachycardia.\",","    candidateLabels: [\"Cardiology\", \"Astronomy\", \"Sports\", \"Politics\"],","    multiLabel: false",")","","print(\"Top label: \\(result.topLabel ?? \"\") (confidence: \\(result.topScore))\")","for (label, score) in result.scores {","    print(\"  • \\(label): \\(String(format: \"%.3f\", score))\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Multi-Label-Classification","type":"heading","text":"Multi-Label Classification","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For documents that can belong to multiple categories simultaneously, set "},{"type":"codeVoice","code":"multiLabel: true"},{"type":"text","text":" to compute independent sigmoid activations:"}]},{"code":["let multiResult = try await classifier.classify(","    text: \"Quarterly corporate earnings and federal interest rate decisions.\",","    candidateLabels: [\"Finance\", \"Government\", \"Culinary\", \"Gaming\"],","    multiLabel: true",")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"6-DataFrame-Zero-Shot-Categorization","type":"heading","text":"6. DataFrame Zero-Shot Categorization","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Classify entire columns of tabular data directly within a "},{"type":"reference","identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","isActive":true},{"type":"text","text":" using "},{"type":"codeVoice","code":"zeroShotClassify"},{"type":"text","text":":"}]},{"code":["import SwiftDataFrame","import SwiftNLP","","var feedbackDF = DataFrame(columns: [","    TypedColumn(name: \"FeedbackID\", values: [1, 2, 3]),","    TypedColumn(name: \"ReviewText\", values: [","        \"The app crashed when opening the PDF export screen.\",","        \"Monthly subscription pricing is too expensive.\",","        \"Smooth navigation and beautiful dark mode aesthetics.\"","    ])","])","","\/\/ Classify ReviewText column into sentiment and topic categories","let classifiedDF = try await feedbackDF.zeroShotClassify(","    textColumn: \"ReviewText\",","    candidateLabels: [\"Bug Report\", \"Pricing\", \"User Interface\"],","    outputColumn: \"Category\"",")","","print(classifiedDF.summary())"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"}],"kind":"content"}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/AppleSentenceEmbeddingEngine":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","kind":"symbol","navigatorTitle":[{"text":"AppleSentenceEmbeddingEngine","kind":"identifier"}],"abstract":[{"text":"A sentence embedding generator powered by Apple’s native pre-trained ","type":"text"},{"code":"NLEmbedding","type":"codeVoice"},{"text":" models.","type":"text"}],"type":"topic","url":"\/documentation\/swiftnlp\/applesentenceembeddingengine","title":"AppleSentenceEmbeddingEngine","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AppleSentenceEmbeddingEngine","kind":"identifier"}]},"doc://SwiftNLP/documentation/SwiftNLP/SentenceEmbeddingProvider":{"abstract":[{"type":"text","text":"A protocol representing a local or model-based sentence embedding generator."}],"url":"\/documentation\/swiftnlp\/sentenceembeddingprovider","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SentenceEmbeddingProvider","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"SentenceEmbeddingProvider","kind":"identifier"}],"title":"SentenceEmbeddingProvider","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider"},"doc://SwiftNLP/documentation/SwiftNLP/ZeroShotTextClassifier":{"abstract":[{"text":"A zero-shot text classifier that categorizes text into arbitrary classes without task-specific training.","type":"text"}],"kind":"symbol","title":"ZeroShotTextClassifier","url":"\/documentation\/swiftnlp\/zeroshottextclassifier","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ZeroShotTextClassifier"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ZeroShotTextClassifier"}]},"https://nodibell.github.io/SwiftSci/documentation/swiftdataframe/":{"titleInlineContent":[{"code":"SwiftDataFrame","type":"codeVoice"}],"type":"link","url":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","title":"SwiftDataFrame","identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/"},"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"kind":"symbol","abstract":[{"text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"LocalEmbeddingEngine","kind":"identifier"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LocalEmbeddingEngine","kind":"identifier"}],"url":"\/documentation\/swiftnlp\/localembeddingengine","role":"symbol","title":"LocalEmbeddingEngine"},"doc://SwiftNLP/documentation/SwiftNLP/ZeroShotClassificationResult":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotClassificationResult","kind":"symbol","navigatorTitle":[{"text":"ZeroShotClassificationResult","kind":"identifier"}],"abstract":[{"type":"text","text":"The output of a zero-shot text classification inference."}],"type":"topic","url":"\/documentation\/swiftnlp\/zeroshotclassificationresult","title":"ZeroShotClassificationResult","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZeroShotClassificationResult","kind":"identifier"}]},"doc://SwiftNLP/documentation/SwiftNLP":{"title":"SwiftNLP","url":"\/documentation\/swiftnlp","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"role":"collection","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","kind":"symbol","type":"topic"},"https://nodibell.github.io/SwiftSci/documentation/swiftcluster/vectorstore/":{"titleInlineContent":[{"code":"SwiftCluster.VectorStore","type":"codeVoice"}],"type":"link","url":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftcluster\/vectorstore\/","title":"SwiftCluster.VectorStore","identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftcluster\/vectorstore\/"}}}