ragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MetalQuantizedEngine"}],"role":"symbol","url":"\/documentation\/swiftllm\/metalquantizedengine","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MetalQuantizedEngine"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalQuantizedEngine","abstract":[{"type":"text","text":"A thread-safe executor and pipeline cache for Metal quantized MSL GEMV \/ GEMM kernels."}]},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoderInference":{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","abstract":[{"type":"text","text":"Execute two-stage autoregressive generation with full prompt prefill and incremental single-token decoding using Apple Silicon KV-caching."}],"kind":"article","title":"Autoregressive Transformer Decoder Inference","role":"collectionGroup","url":"\/documentation\/swiftllm\/transformerdecoderinference","type":"topic"},"doc://SwiftLLM/documentation/SwiftLLM/MetalQuantizedError":{"type":"topic","title":"MetalQuantizedError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MetalQuantizedError","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swiftllm\/metalquantizederror","kind":"symbol","navigatorTitle":[{"text":"MetalQuantizedError","kind":"identifier"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalQuantizedError","abstract":[{"type":"text","text":"Errors occurring during Metal quantized kernel pipeline creation or GPU buffer execution."}]},"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"kind":"article","type":"topic","url":"\/documentation\/swiftllm\/weightparsingandsampling","abstract":[{"text":"Parse GGUF and SafeTensors model weights zero-copy into Apple Silicon unified memory and sample tokens with fine-grained logits controls.","type":"text"}],"role":"collectionGroup","title":"GGUF\/SafeTensors Parsing & Sampling","