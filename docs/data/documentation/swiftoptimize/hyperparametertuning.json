{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"Finding the optimal combination of hyperparameters is critical for maximizing generalization accuracy. ","type":"text"},{"code":"SwiftOptimize","type":"codeVoice"},{"text":" provides exhaustive grid search, randomized sampling for high-dimensional parameter spaces, and end-to-end ","type":"text"},{"code":"AutoML","type":"codeVoice"},{"text":" selection across multiple model families.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"1. AutoML — Automated Model Selection","anchor":"1-AutoML-Automated-Model-Selection"},{"inlineContent":[{"code":"AutoML","type":"codeVoice"},{"text":" cross-validates a fixed set of baseline architectures (Logistic\/Linear Regression, Decision Tree, Random Forest, MLP) and ranks them by the ","type":"text"},{"inlineContent":[{"text":"mean per-fold","type":"text"}],"type":"strong"},{"text":" score: macro F1 for classification, R² for regression. Classification uses ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/StratifiedKFold","type":"reference","isActive":true},{"text":"; regression uses shuffled ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/KFold","type":"reference","isActive":true},{"text":". All metrics come from ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/EvaluationHarness","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftOptimize","import SwiftML","","\/\/ 1. Synthetic classification dataset","let N = 120","let D = 4","let X = (0..<N).map { i in","    (0..<D).map { d in Double(i * D + d) * 0.05 + sin(Double(i + d)) }","}","let y = (0..<N).map { i in Double(i % 2) }","","\/\/ 2. Configure AutoML with 3-fold stratified cross-validation","let autoML = AutoML(","    timeBudgetSeconds: 30,","    taskType: .classification,","    nFolds: 3,","    seed: 42",")","","\/\/ 3. Run model selection","let report = try await autoML.fit(features: X, targets: y)","","print(\"Best model: \\(await autoML.bestModelName ?? \"-\")\")","print(\"CV macro F1: \\(report.metrics[\"cv_score\"]!) ± \\(report.metrics[\"cv_std\"]!)\")","","for entry in await autoML.leaderboard {","    print(entry.displayName, entry.meanScore, entry.foldScores)","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Task type:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".auto","type":"codeVoice"},{"text":" (default) classifies integer targets with ≤ 10 distinct values, treats non-integer or high-cardinality targets as regression, and throws ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLError\/ambiguousTaskType(uniqueValues:sampleCount:)","type":"reference","isActive":true},{"text":" in between. Pass ","type":"text"},{"code":"taskType","type":"codeVoice"},{"text":" explicitly in that case.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Time budget:","type":"text"}]},{"text":" soft. It is checked before each candidate and fold; a running fit is not interrupted, and the first candidate always completes.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Search:","type":"text"}]},{"text":" only ","type":"text"},{"code":".modelSelection","type":"codeVoice"},{"text":" is available. To tune hyperparameters of a single estimator, use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/GridSearchCV"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/RandomizedSearchCV"},{"text":" below.","type":"text"}]}]}]},{"type":"thematicBreak"},{"level":2,"text":"2. Exhaustive Grid Search (`GridSearchCV`)","type":"heading","anchor":"2-Exhaustive-Grid-Search-GridSearchCV"},{"inlineContent":[{"code":"GridSearchCV","type":"codeVoice"},{"type":"text","text":" exhaustively tests all Cartesian combinations of hyperparameter discrete values."}],"type":"paragraph"},{"code":["import SwiftOptimize","import SwiftML","","\/\/ Define hyperparameter search grid for DecisionTreeClassifier","let paramGrid: [String: [Any]] = [","    \"maxDepth\": [3, 5, 8],","    \"minSamplesSplit\": [2, 5, 10],","    \"criterion\": [\"gini\", \"entropy\"]","]","","let gridSearch = GridSearchCV(","    estimator: DecisionTreeClassifier(maxDepth: 3),","    paramGrid: paramGrid,","    cv: 5,","    scoring: .accuracy",")","","try await gridSearch.fit(features: X, targets: y)","","if let bestParams = gridSearch.bestParams {","    print(\"Optimal Depth: \\(bestParams[\"maxDepth\"] ?? \"default\")\")","    print(\"Peak CV Accuracy: \\(String(format: \"%.4f\", gridSearch.bestScore ?? 0.0))\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"3-Randomized-Search-RandomizedSearchCV","level":2,"text":"3. Randomized Search (`RandomizedSearchCV`)","type":"heading"},{"inlineContent":[{"type":"text","text":"When searching through large continuous or discrete combinatorial spaces, "},{"type":"codeVoice","code":"RandomizedSearchCV"},{"type":"text","text":" samples $N$ random configurations, finding near-optimal solutions in a fraction of the compute time."}],"type":"paragraph"},{"type":"codeListing","code":["import SwiftOptimize","import SwiftML","","let distributions: [String: [Any]] = [","    \"learningRate\": [0.001, 0.005, 0.01, 0.05, 0.1],","    \"epochs\": [100, 200, 500, 1000],","    \"l2Penalty\": [0.0, 0.0001, 0.001, 0.01]","]","","let randomSearch = RandomizedSearchCV(","    estimator: LogisticRegression(learningRate: 0.01),","    paramDistributions: distributions,","    nIter: 20,","    cv: 3,","    randomSeed: 42",")","","try await randomSearch.fit(features: X, targets: y)","print(\"Top Configuration Score: \\(randomSearch.bestScore ?? 0.0)\")"],"syntax":"swift"}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"SwiftOptimize"}],"title":"Hyperparameter Tuning & AutoML Engine","roleHeading":"Article","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/HyperparameterTuning"},"abstract":[{"type":"text","text":"Automate model exploration and parameter optimization with "},{"type":"codeVoice","code":"GridSearchCV"},{"type":"text","text":", "},{"type":"codeVoice","code":"RandomizedSearchCV"},{"type":"text","text":", and the intelligent "},{"type":"codeVoice","code":"AutoML"},{"type":"text","text":" model selector."}],"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftoptimize\/hyperparametertuning"]}],"kind":"article","seeAlsoSections":[{"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection"],"generated":true}],"references":{"doc://SwiftOptimize/documentation/SwiftOptimize/KFold":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KFold"}],"type":"topic","abstract":[{"type":"text","text":"Splits a dataset into K folds for cross-validation."}],"title":"KFold","kind":"symbol","url":"\/documentation\/swiftoptimize\/kfold","navigatorTitle":[{"kind":"identifier","text":"KFold"}],"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/KFold","role":"symbol"},"doc://SwiftOptimize/documentation/SwiftOptimize/RandomizedSearchCV":{"role":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/RandomizedSearchCV","url":"\/documentation\/swiftoptimize\/randomizedsearchcv","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomizedSearchCV","kind":"identifier"}],"title":"RandomizedSearchCV","navigatorTitle":[{"text":"RandomizedSearchCV","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Performs parallel Randomized Search over random hyperparameter combinations"},{"type":"text","text":" "},{"text":"via K-Fold Cross-Validation.","type":"text"}]},"doc://SwiftOptimize/documentation/SwiftOptimize/CrossValidationFolds":{"url":"\/documentation\/swiftoptimize\/crossvalidationfolds","type":"topic","kind":"article","role":"article","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","abstract":[{"type":"text","text":"Evaluate model stability and generalization performance across dataset splits using "},{"code":"KFold","type":"codeVoice"},{"text":", ","type":"text"},{"code":"StratifiedKFold","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"TimeSeriesSplit","type":"codeVoice"},{"type":"text","text":"."}],"title":"Cross-Validation Strategies"},"doc://SwiftOptimize/documentation/SwiftOptimize/StratifiedKFold":{"navigatorTitle":[{"text":"StratifiedKFold","kind":"identifier"}],"title":"StratifiedKFold","url":"\/documentation\/swiftoptimize\/stratifiedkfold","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/StratifiedKFold","type":"topic","abstract":[{"text":"Stratified K-Fold cross-validator.","type":"text"},{"text":" ","type":"text"},{"text":"Provides train\/validation indices such that class proportions are preserved in each fold.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"StratifiedKFold"}]},"doc://SwiftOptimize/documentation/SwiftOptimize/ParallelModelSelection":{"title":"Concurrent Model Selection & Cross-Validation","url":"\/documentation\/swiftoptimize\/parallelmodelselection","role":"collectionGroup","kind":"article","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection","type":"topic","abstract":[{"type":"text","text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency "},{"code":"TaskGroup","type":"codeVoice"},{"text":" primitives.","type":"text"}]},"doc://SwiftOptimize/documentation/SwiftOptimize/GridSearchCV":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GridSearchCV"}],"type":"topic","abstract":[{"type":"text","text":"Performs parallel Grid Search over a hyperparameter grid for DecisionTreeClassifier"},{"type":"text","text":" "},{"type":"text","text":"to find the best hyperparameter combination via Stratified K-Fold Cross-Validation."}],"title":"GridSearchCV","kind":"symbol","url":"\/documentation\/swiftoptimize\/gridsearchcv","navigatorTitle":[{"kind":"identifier","text":"GridSearchCV"}],"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/GridSearchCV","role":"symbol"},"doc://SwiftOptimize/documentation/SwiftOptimize/AutoMLError/ambiguousTaskType(uniqueValues:sampleCount:)":{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLError\/ambiguousTaskType(uniqueValues:sampleCount:)","abstract":[{"code":".auto","type":"codeVoice"},{"text":" could not confidently decide between classification and regression.","type":"text"}],"type":"topic","url":"\/documentation\/swiftoptimize\/automlerror\/ambiguoustasktype(uniquevalues:samplecount:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ambiguousTaskType"},{"kind":"text","text":"("},{"text":"uniqueValues","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s: