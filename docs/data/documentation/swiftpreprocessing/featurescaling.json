codeListing","syntax":null,"code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All arithmetic operations ("},{"type":"codeVoice","code":"vDSP_vsubD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_vsdivD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP.sort"},{"type":"text","text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections."}]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"1-StandardScaler-Z-Score-Standardization","text":"1. `StandardScaler` (Z-Score Standardization)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforms features to have zero mean ("},{"type":"codeVoice","code":"μ = 0"},{"type":"text","text":") and unit variance ("},{"type":"codeVoice","code":"σ² = 1"},{"type":"text","text":"):"}]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"z = (x - μ) \/ σ"}]}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"2-MinMaxScaler-Bounded-Range-Scaling","text":"2. `MinMaxScaler` (Bounded Range Scaling)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Linearly transforms features into a bounded range "},{"type":"codeVoice","code":"[a, b]"},{"type":"text","text":" (defaults to "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":"):"}]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)"}]}]},{"type":"codeListing","syntax":"swift","code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"3-RobustScaler-Median--IQR-Scaling","text":"3. `RobustScaler` (Median & IQR Scaling)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When datasets contain extreme outliers, mean and standard deviation are distorted. "},{"type":"codeVoice","code":"RobustScaler"},{"type":"text","text":" scales features using the "},{"type":"strong","inlineContent":[{"text":"Median","type":"text"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"text":"Interquartile Range (IQR = Q3 - Q1)","type":"text"}]},{"type":"text","text":":"}]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"x' = (x - Median) \/ IQR"}]}]},{"type":"codeListing","syntax":"swift","code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling","text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Scales each sample independently to have unit L1, L2, or Max norm:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"]},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Memory & Performance Tip:"}],"type":"strong"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Float"},{"text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput.","type":"text"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/featurescaling"]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"],"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"references":{