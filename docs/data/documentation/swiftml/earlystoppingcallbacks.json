O  ──► Continue training"],"syntax":null,"type":"codeListing"},{"text":"Configuration Parameters","level":3,"anchor":"Configuration-Parameters","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"patience"},{"text":": Number of consecutive non-improving evaluations tolerated before triggering an early halt.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"minDelta"},{"text":": Minimum absolute improvement required to qualify as progress.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"direction","type":"codeVoice"},{"type":"text","text":": "},{"code":".minimize","type":"codeVoice"},{"type":"text","text":" for loss functions (cross-entropy, MSE) or "},{"code":".maximize","type":"codeVoice"},{"type":"text","text":" for scoring metrics (accuracy, R2, AUC)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"restoreBestWeights","type":"codeVoice"},{"text":": When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", automatically restores the model parameters from the epoch that achieved ","type":"text"},{"code":"bestScore","type":"codeVoice"},{"text":", avoiding overfit tail iterations.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Example-Usage","text":"Example Usage","level":2},{"type":"codeListing","code":["import SwiftML","","\/\/ 1. Configure early stopping callback","let es = EarlyStopping(","    patience: 5,","    minDelta: 1e-4,","    direction: .minimize,","    restoreBestWeights: true",")","","\/\/ 2. Fit MLP with validation monitoring","let mlp = MLPClassifier(hiddenLayerSizes: [32, 16], maxIter: 200)","try await mlp.fit(","    features: X_train,","    targets: y_train,","    validationFeatures: X_val,","    validationTargets: y_val,","    earlyStopping: es",")"],"syntax":"swift"}]}],"metadata":{"role":"collectionGroup","title":"Early Stopping & Generalization Control","modules":[{"