{"abstract":[{"text":"Automate model exploration and parameter optimization with ","type":"text"},{"type":"codeVoice","code":"GridSearchCV"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RandomizedSearchCV"},{"text":", and the intelligent ","type":"text"},{"type":"codeVoice","code":"AutoML"},{"text":" model selector.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection"],"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Finding the optimal combination of hyperparameters is critical for maximizing generalization accuracy. ","type":"text"},{"type":"codeVoice","code":"SwiftOptimize"},{"text":" provides exhaustive grid search, randomized sampling for high-dimensional parameter spaces, and end-to-end ","type":"text"},{"type":"codeVoice","code":"AutoML"},{"text":" selection across multiple model families.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"1-AutoML-Automated-Model--Parameter-Selection","level":2,"text":"1. AutoML — Automated Model & Parameter Selection","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"AutoML"},{"text":" evaluates candidate model architectures (Decision Trees, Random Forests, Logistic Regression, Linear Regression, and Multi-Layer Perceptrons) using cross-validation, ranking candidates by performance metrics (F1-score for classification, R² for regression).","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftOptimize","import SwiftML","","\/\/ 1. Synthetic classification dataset","let N = 120","let D = 4","let X = (0..<N).map { i in","    (0..<D).map { d in Double(i * D + d) * 0.05 + sin(Double(i + d)) }","}","let y = (0..<N).map { i in i % 2 }","","\/\/ 2. Configure AutoML with 3-fold cross validation","let autoML = AutoML(","    task: .classification,","    timeLimitSeconds: 30,","    cvFolds: 3,","    metric: \"f1\"",")","","\/\/ 3. Train and select the optimal estimator","let result = try await autoML.fit(features: X, targets: y)","","print(\"=== AutoML Optimization Results ===\")","print(\"Selected Best Model: \\(result.bestModelName)\")","print(\"Validation F1 Score: \\(String(format: \"%.4f\", result.bestScore))\")","print(\"Tuned Hyperparameters: \\(result.bestParameters)\")","","\/\/ 4. Run inference directly on new test samples","let newSample = [0.5, 1.2, 0.3, 0.8]","let testPrediction = try await result.bestEstimator.predict(features: [newSample])","print(\"Prediction: \\(testPrediction)\")"]},{"type":"thematicBreak"},{"anchor":"2-Exhaustive-Grid-Search-GridSearchCV","level":2,"text":"2. Exhaustive Grid Search (`GridSearchCV`)","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"GridSearchCV","type":"codeVoice"},{"type":"text","text":" exhaustively tests all Cartesian combinations of hyperparameter discrete values."}]},{"type":"codeListing","syntax":"swift","code":["import SwiftOptimize","import SwiftML","","\/\/ Define hyperparameter search grid for DecisionTreeClassifier","let paramGrid: [String: [Any]] = [","    \"maxDepth\": [3, 5, 8],","    \"minSamplesSplit\": [2, 5, 10],","    \"criterion\": [\"gini\", \"entropy\"]","]","","let gridSearch = GridSearchCV(","    estimator: DecisionTreeClassifier(maxDepth: 3),","    paramGrid: paramGrid,","    cv: 5,","    scoring: .accuracy",")","","try await gridSearch.fit(features: X, targets: y)","","if let bestParams = gridSearch.bestParams {","    print(\"Optimal Depth: \\(bestParams[\"maxDepth\"] ?? \"default\")\")","    print(\"Peak CV Accuracy: \\(String(format: \"%.4f\", gridSearch.bestScore ?? 0.0))\")","}"]},{"type":"thematicBreak"},{"anchor":"3-Randomized-Search-RandomizedSearchCV","type":"heading","level":2,"text":"3. Randomized Search (`RandomizedSearchCV`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When searching through large continuous or discrete combinatorial spaces, "},{"type":"codeVoice","code":"RandomizedSearchCV"},{"text":" samples $N$ random configurations, finding near-optimal solutions in a fraction of the compute time.","type":"text"}]},{"code":["import SwiftOptimize","import SwiftML","","let distributions: [String: [Any]] = [","    \"learningRate\": [0.001, 0.005, 0.01, 0.05, 0.1],","    \"epochs\": [100, 200, 500, 1000],","    \"l2Penalty\": [0.0, 0.0001, 0.001, 0.01]","]","","let randomSearch = RandomizedSearchCV(","    estimator: LogisticRegression(learningRate: 0.01),","    paramDistributions: distributions,","    nIter: 20,","    cv: 3,","    randomSeed: 42",")","","try await randomSearch.fit(features: X, targets: y)","print(\"Top Configuration Score: \\(randomSearch.bestScore ?? 0.0)\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"title":"Hyperparameter Tuning & AutoML Engine","role":"article","roleHeading":"Article","modules":[{"name":"SwiftOptimize"}]},"sections":[],"identifier":{"url":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/HyperparameterTuning","interfaceLanguage":"swift"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftoptimize\/hyperparametertuning"]}],"references":{"doc://SwiftOptimize/documentation/SwiftOptimize/CrossValidationFolds":{"title":"Cross-Validation Strategies","kind":"article","url":"\/documentation\/swiftoptimize\/crossvalidationfolds","role":"article","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","abstract":[{"text":"Evaluate model stability and generalization performance across dataset splits using ","type":"text"},{"code":"KFold","type":"codeVoice"},{"text":", ","type":"text"},{"code":"StratifiedKFold","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"TimeSeriesSplit","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic"},"doc://SwiftOptimize/documentation/SwiftOptimize/ParallelModelSelection":{"title":"Concurrent Model Selection & Cross-Validation","kind":"article","role":"collectionGroup","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection","url":"\/documentation\/swiftoptimize\/parallelmodelselection","abstract":[{"type":"text","text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency "},{"type":"codeVoice","code":"TaskGroup"},{"type":"text","text":" primitives."}],"type":"topic"},"doc://SwiftOptimize/documentation/SwiftOptimize":{"url":"\/documentation\/swiftoptimize","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize","kind":"symbol","abstract":[{"text":"AutoML, Cross-Validation Folds & Hyperparameter Tuning.","type":"text"}],"type":"topic","role":"collection","title":"SwiftOptimize"}}}