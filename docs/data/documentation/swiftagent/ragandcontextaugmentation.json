{"abstract":[{"text":"Construct privacy-preserving Retrieval-Augmented Generation workflows on Apple Silicon.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/ragandcontextaugmentation"]}],"kind":"article","metadata":{"modules":[{"name":"SwiftAgent"}],"title":"Building On-Device RAG Pipelines","roleHeading":"API Collection","role":"collectionGroup"},"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Agent-Components","title":"Agent Components"}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGAndContextAugmentation"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"On-Device RAG combines fast local vector retrieval with on-device language models to provide accurate, grounded answers from private local documents without cloud network dependencies.","type":"text"}]},{"code":["graph LR","    Query[User Query] --> Embed[LocalEmbeddingEngine]","    Embed --> Vec[Dense Vector]","    Vec --> Search[VectorStore Top-K]","    Docs[Private Document Index] --> Search","    Search --> Chunks[Retrieved Text Snippets]","    Chunks --> Prompt[Augmented Prompt]","    Prompt --> LLM[SwiftLLM Metal Engine]","    LLM --> Answer[Grounded Answer]"],"syntax":"mermaid","type":"codeListing"},{"anchor":"1-Complete-End-to-End-Pipeline-Example","level":2,"text":"1. Complete End-to-End Pipeline Example","type":"heading"},{"type":"codeListing","syntax":"swift","code":["import SwiftAgent","import SwiftCluster","import SwiftNLP","import SwiftLLM","","\/\/ 1. Initialize local embedding engine and vector store","let embedEngine = LocalEmbeddingEngine(dimension: 128)","let vectorStore = VectorStore(metric: .cosineSimilarity)","","\/\/ 2. Ingest private knowledge base","let corpus = [","    \"SwiftSci uses Apple Accelerate vDSP for SIMD arithmetic.\",","    \"MLX provides unified memory GPU tensor computation on Mac.\",","    \"WiredMemoryManager prevents out-of-memory errors on shared RAM.\"","]","","for (id, text) in corpus.enumerated() {","    let vec = embedEngine.embed(text)","    vectorStore.add(id: \"doc_\\(id)\", vector: vec, metadata: [\"content\": text])","}","","\/\/ 3. Retrieve relevant context for user question","let userQuestion = \"How does SwiftSci accelerate vector math?\"","let queryVector = embedEngine.embed(userQuestion)","let topMatches = vectorStore.search(query: queryVector, topK: 1)","","let contextSnippet = topMatches.first?.metadata[\"content\"] ?? \"\"","","\/\/ 4. Assemble augmented prompt and query local LLM","let augmentedPrompt = \"\"\"","Context: \\(contextSnippet)","Question: \\(userQuestion)","Answer:","\"\"\""]}]}],"sections":[],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"type":"topic","role":"collection","title":"SwiftAgent","kind":"symbol","url":"\/documentation\/swiftagent","abstract":[{"text":"Agentic REPL Execution Sandbox & RAG Summary Engine.","type":"text"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"kind":"symbol","abstract":[{"text":"Agentic Swift Execution Sandbox Evaluator.","type":"text"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","url":"\/documentation\/swiftagent\/swiftagentevaluator","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"text":"SwiftAgentEvaluator","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SwiftAgentEvaluator"}],"title":"SwiftAgentEvaluator","type":"topic"}}}