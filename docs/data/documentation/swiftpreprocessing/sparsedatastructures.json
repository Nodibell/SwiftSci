{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"]}],"abstract":[{"text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"sections":[],"topicSections":[{"title":"Sparse Data Types","anchor":"Sparse-Data-Types","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"]}],"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"],"generated":true}],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. ","type":"text"},{"code":"SparseMatrix","type":"codeVoice"},{"text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x.","type":"text"}],"type":"paragraph"},{"text":"Storage Formats","anchor":"Storage-Formats","level":2,"type":"heading"},{"text":"Compressed Sparse Row (CSR)","anchor":"Compressed-Sparse-Row-CSR","level":3,"type":"heading"},{"inlineContent":[{"text":"Stores non-zero values row-by-row:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"values"},{"text":": Non-zero numerical entries.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"colIndices"},{"text":": Column indices corresponding to each entry in ","type":"text"},{"type":"codeVoice","code":"values"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"rowPointers"},{"text":": Offsets into ","type":"text"},{"type":"codeVoice","code":"values"},{"text":" marking where each row begins (length: ","type":"text"},{"type":"codeVoice","code":"rowCount + 1"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"syntax":null,"code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"],"type":"codeListing"},{"text":"Compressed Sparse Column (CSC)","anchor":"Compressed-Sparse-Column-CSC","level":3,"type":"heading"},{"inlineContent":[{"text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication.","type":"text"}],"type":"paragraph"},{"text":"Apple Accelerate Sparse BLAS","anchor":"Apple-Accelerate-Sparse-BLAS","level":2,"type":"heading"},{"inlineContent":[{"text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), ","type":"text"},{"code":"SparseMatrix","type":"codeVoice"},{"text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_matrix_create_double"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_insert_row_double"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_commit"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_matrix_vector_product_dense_double"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput.","type":"text"}],"type":"paragraph"},{"text":"Example Usage","anchor":"Example-Usage","level":2,"type":"heading"},{"syntax":"swift","code":["import SwiftPreprocessing","","\/\/ 1. Create a sparse matrix from a dense array","let dense: [[Double]] = [","    [1.0, 0.0, 0.0],","    [0.0, 2.0, 0.0],","    [0.0, 0.0, 3.0]","]","let sparse = SparseMatrix(dense: dense, format: .csr)","print(\"Sparsity: \\(sparse.sparsity)\") \/\/ ~ 0.667","","\/\/ 2. Accelerated matrix-vector product","let x = [1.0, 2.0, 3.0]","let y = try sparse.multiply(vector: x)","print(y) \/\/ [1.0, 4.0, 9.0]","","\/\/ 3. Matrix Transpose & CSC conversion","let csc = sparse.toCSC()","let transposed = sparse.transpose()"],"type":"codeListing"}],"kind":"content"}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"SwiftPreprocessing"}],"title":"Memory-Efficient Sparse Matrix Representations","roleHeading":"API Collection","role":"collectionGroup"},"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/FeatureScaling":{"kind":"article","role":"article","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","title":"Feature Scaling, Normalization & Flat 1D Memory","abstract":[{"text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using ","type":"text"},{"code":"StandardScaler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MinMaxScaler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RobustScaler","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Normalizer","type":"codeVoice"},{"text":" powered by Apple Accelerate ","type":"text"},{"code":"vDSP","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiftpreprocessing\/featurescaling","type":"topic"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"title":"SwiftPreprocessing","role":"collection","type":"topic","url":"\/documentation\/swiftpreprocessing","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","kind":"symbol","abstract":[{"text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines.","type":"text"}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseMatrix":{"type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparseMatrix"}],"navigatorTitle":[{"kind":"identifier","text":"SparseMatrix"}],"title":"SparseMatrix","abstract":[{"text":"Memory-efficient sparse matrix storage implementing Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"url":"\/documentation\/swiftpreprocessing\/sparsematrix"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseFormat":{"navigatorTitle":[{"kind":"identifier","text":"SparseFormat"}],"title":"SparseFormat","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat","type":"topic","abstract":[{"text":"Storage format for compressed sparse matrix structures.","type":"text"}],"kind":"symbol","url":"\/documentation\/swiftpreprocessing\/sparseformat","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparseFormat"}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"type":"topic","abstract":[{"text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer.","type":"text"}],"identifier":"doc:\/\/SwiftPr