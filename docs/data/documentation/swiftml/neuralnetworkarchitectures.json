{"metadata":{"modules":[{"name":"SwiftML"}],"roleHeading":"Article","title":"Multi-Layer Perceptrons & Neural Network Architecture","role":"article"},"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/NeuralNetworkArchitectures","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftml\/neuralnetworkarchitectures"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","abstract":[{"text":"Train neural network classifiers and regressors with hardware-accelerated BLAS forward passes, Adam optimization, Dropout regularization, and Batch Normalization.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiftML","type":"codeVoice"},{"type":"text","text":" provides "},{"code":"MLPClassifier","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MLPRegressor","type":"codeVoice"},{"type":"text","text":" multi-layer perceptrons designed for high-throughput tabular modeling. The architecture uses contiguous "},{"code":"LayerWeights","type":"codeVoice"},{"type":"text","text":" flat buffers with Apple Accelerate BLAS "},{"code":"cblas_dgemm","type":"codeVoice"},{"type":"text","text":" matrix multiplications and vectorized Adam optimizer updates."}]},{"code":["Input Layer (D features)","      │","      ▼","┌──────────────┐","│ Linear (W1)  │ ───► Apple Accelerate cblas_dgemm","├──────────────┤","│  BatchNorm   │ ───► (x - mean) \/ sqrt(var + eps)","├──────────────┤","│  Activation  │ ───► ReLU \/ Tanh \/ Sigmoid","├──────────────┤","│   Dropout    │ ───► Bernoulli Mask (p = 0.2)","└──────────────┘","      │","      ▼","┌──────────────┐","│ Linear (W2)  │ ───► cblas_dgemm","├──────────────┤","│  Softmax\/Lin │ ───► Probabilities \/ Continuous Output","└──────────────┘"],"type":"codeListing","syntax":null},{"type":"thematicBreak"},{"anchor":"1-Mathematical-Formulation","text":"1. Mathematical Formulation","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For each hidden layer $l$:"},{"type":"text","text":" "},{"type":"text","text":"$$\\mathbf{z}^{(l)} = \\mathbf{W}^{(l)} \\mathbf{a}^{(l-1)} + \\mathbf{b}^{(l)}$$"},{"type":"text","text":" "},{"type":"text","text":"$$\\mathbf{a}^{(l)} = \\sigma\\left(\\mathbf{z}^{(l)}\\right)$$"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported activations ($\\sigma$):"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"ReLU"}]},{"type":"text","text":": $\\max(0, x)$"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tanh"}]},{"text":": $\\tanh(x) = \\frac{e^x - e^{-x}}{e^x + e^{-x}}$","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Sigmoid","type":"text"}]},{"type":"text","text":": $\\sigma(x) = \\frac{1}{1 + e^{-x}}$"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Linear","type":"text"}],"type":"strong"},{"text":": $f(x) = x$","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"2-Training-an-MLP-Classifier-with-Dropout--BatchNorm","text":"2. Training an MLP Classifier with Dropout & BatchNorm"},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftML","","\/\/ 1. Synthetic training dataset (100 samples, 4 features)","let sampleCount = 100","let inDim = 4","let X_train = (0..<sampleCount).map { i in","    (0..<inDim).map { d in Double(i * inDim + d) * 0.02 }","}","let y_train = (0..<sampleCount).map { $0 % 2 } \/\/ Binary classification","","\/\/ 2. Configure MLPClassifier with hidden layers, Adam optimizer, Dropout, and BatchNorm","let mlp = try MLPClassifier(","    hiddenLayerSizes: [32, 16],","    activation: .relu,","    learningRate: 0.01,","    maxEpochs: 150,","    batchSize: 16,","    dropoutRate: 0.2,","    batchNorm: true,","    randomSeed: 42",")","","\/\/ 3. Train model asynchronously under Swift 6 actor isolation","try await mlp.fit(features: X_train, targets: y_train)","","\/\/ 4. Predict class labels and posterior probabilities","let X_test = [[0.1, 0.2, 0.3, 0.4], [1.5, 1.8, 2.1, 2.4]]","let predictions = try await mlp.predict(features: X_test)","let probabilities = try await mlp.predictProba(features: X_test)","","print(\"Predictions: \\(predictions)\")","for (idx, prob) in probabilities.enumerated() {","    print(\"Sample \\(idx) Class 1 Probability: \\(String(format: \"%.2f%%\", prob[1] * 100))\")","}"]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"3-Training-an-MLP-Regressor","text":"3. Training an MLP Regressor"},{"type":"paragraph","inlineContent":[{"text":"For continuous target estimation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let y_reg = X_train.map { $0.reduce(0.0, +) * 2.5 }","","let regressor = try MLPRegressor(","    hiddenLayerSizes: [64, 32],","    activation: .tanh,","    learningRate: 0.005,","    maxEpochs: 200,","    batchSize: 32",")","","try await regressor.fit(features: X_train, targets: y_reg)","let regPredictions = try await regressor.predict(features: X_test)","print(\"Regression Predictions: \\(regPredictions)\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"4-Binary-Core-ML-Model-Export","text":"4. Binary Core ML Model Export"},{"type":"paragraph","inlineContent":[{"text":"Export trained MLP architectures directly to Apple Core ML binary protobuf ","type":"text"},{"code":".mlmodel","type":"codeVoice"},{"text":" files:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["try await mlp.writeCoreML(","    to: URL(fileURLWithPath: \"TabularMLP.mlmodel\"),","    featureNames: [\"feat_0\", \"feat_1\", \"feat_2\", \"feat_3\"],","    outputName: \"target_class\"",")","print(\"Successfully exported MLP to Core ML binary format.\")"]}]}],"references":{"doc://SwiftML/documentation/SwiftML":{"role":"collection","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","url":"\/documentation\/swiftml","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"kind":"symbol","title":"SwiftML"}}}