{"kind":"article","sections":[],"abstract":[{"text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native ","type":"text"},{"type":"codeVoice","code":"NaturalLanguage"},{"text":" framework.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"SwiftNLP"}],"roleHeading":"Article","role":"article","title":"Text Normalization, Tokenization & Linguistic Tagging"},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}]},{"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","text":"1. Multi-lingual Word & Sentence Tokenization","level":3,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"]},{"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","text":"2. POS Tagging, Lemmatization & Entity Extraction","level":3,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"]},{"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","text":"3. Sentiment Analysis (VADER & NLSentiment)","level":3,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"]}]}],"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"title":"SwiftNLP","kind":"symbol","role":"collection","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","url":"\/documentation\/swiftnlp"},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"abstract":[{"type":"text","text":"Convert text corpora into numerical and sparse feature matrices using "},{"type":"codeVoice","code":"TFIDFVectorizer"},{"text":", ","type":"text"},{"code":"CountVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HashingVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SparseVector","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"LocalEmbeddingEngine","type":"codeVoice"},{"text":".","type":"text"}],"kind":"article","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","role":"article","type":"topic","title":"Text Feature Vectorization, Sparse TF-IDF & Local Embeddings","url":"\/documentation\/swiftnlp\/vectorizationandembeddings"}}}