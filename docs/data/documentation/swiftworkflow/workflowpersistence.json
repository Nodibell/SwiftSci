{"identifier":{"url":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftworkflow\/workflowpersistence"]}],"metadata":{"title":"Deploying and Persisting Scientific Workflows","roleHeading":"Article","role":"article","modules":[{"name":"SwiftWorkflow"}]},"hierarchy":{"paths":[["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","abstract":[{"type":"text","text":"Learn how to safely persist, reload, and evaluate end-to-end machine learning workflows across processes."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"In production scientific machine learning systems, data leakage between training and evaluation phases is one of the most common causes of overly optimistic validation metrics. "},{"code":"SwiftWorkflow","type":"codeVoice"},{"type":"text","text":" eliminates leakage by enforcing structural invariants at the API level:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Explicit Supervised Batch Splitting"}],"type":"strong"},{"text":": Workflows accept ","type":"text"},{"code":"PreparedSupervisedBatch","type":"codeVoice"},{"text":" instances where row selection explicitly tracks ","type":"text"},{"code":"originalRowIndices","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Immutable Stages"}],"type":"strong"},{"text":": Once trained, a workflow exposes no mutable hyperparameters or refitting paths.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Atomic Schema Validation"}],"type":"strong"},{"text":": When loading from JSON, dimensions and feature names are checked against the artifact header before initializing models.","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","text":"End-to-End Persistence Pattern","anchor":"End-to-End-Persistence-Pattern","level":3},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftDataFrame","import SwiftWorkflow","","\/\/ Train workflow on designated training rows","let workflow = try await PCAClassificationWorkflow.train(","    training: trainingBatch,","    components: 2,","    learningRate: 0.125,","    epochs: 64",")","","\/\/ Serialize fitted stages to JSON artifact","let artifactURL = URL(fileURLWithPath: \"PCAWorkflow.json\")","try workflow.save(to: artifactURL)","","\/\/ Reload across independent processes with verified dimensions","let reloaded = try PCAClassificationWorkflow.load(from: artifactURL)","let predictions = try await reloaded.predict(unlabeledBatch)"]}]}],"sections":[],"references":{"doc://SwiftWorkflow/documentation/SwiftWorkflow":{"identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow","title":"SwiftWorkflow","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization."}],"type":"topic","url":"\/documentation\/swiftworkflow"}}}