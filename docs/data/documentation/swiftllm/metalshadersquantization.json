{"abstract":[{"text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU.","type":"text"}],"topicSections":[{"title":"Quantization & Metal Execution","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedTensor","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedLayoutMetadata","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedLinear","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizationScheme","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalQuantizedEngine","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalQuantizedError"],"anchor":"Quantization--Metal-Execution"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/swiftllm\/metalshadersquantization"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"},"kind":"article","metadata":{"modules":[{"name":"SwiftLLM"}],"role":"collectionGroup","title":"Native Metal MSL Shaders for Quantized LLMs","roleHeading":"API Collection"},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Large language models like Llama 3, Mistral, and DeepSeek require massive memory bandwidth. Weight-only quantization (such as GGUF Q4_0 and Q8_0) compresses 16-bit floating-point weights into 4-bit or 8-bit integer blocks with group scaling factors, reducing memory footprint by 50% to 75%."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"text":" implements native Metal Shading Language (MSL) SIMD kernels executing hardware dequantization and GEMV \/ GEMM transformations directly on Apple Silicon GPUs without intermediate CPU memory allocations.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Architecture","text":"Architecture","type":"heading"},{"syntax":null,"code":["Packed Quantized Weights [Q4_0 \/ Q8_0]   Scale Factors [FP16]   Input Activations [FP32]","                 │                               │                        │","                 └───────────────────────┬───────┴────────────────────────┘","                                         ▼","                   Metal Compute Command Encoder","                                         │","                 ┌───────────────────────┴───────────────────────┐","                 ▼                                               ▼","     MSL Kernel: gemv_q4_0                           MSL Kernel: gemv_q8_0","   - Unpack 4-bit nibbles (w - 8)                  - Load signed 8-bit integers","   - Multiply by group FP16 scale                  - Multiply by group FP16 scale","   - Accumulate with input vector                  - Accumulate with input vector","                 │                                               │","                 └───────────────────────┬───────────────────────┘","                                         ▼","                            Output Activation Vector","                               (Unified Memory)"],"type":"codeListing"},{"level":2,"text":"SIMD-Group Matrix Multiplication","anchor":"SIMD-Group-Matrix-Multiplication","type":"heading"},{"inlineContent":[{"type":"text","text":"On Apple Silicon (M-series GPUs), threads within a 32-thread SIMD-group collaborate on 8x8 matrix tiles using "},{"type":"codeVoice","code":"metal_simdgroup_matrix"},{"type":"text","text":". This eliminates thread divergence and ensures maximal utilization of the GPU arithmetic units:"}],"type":"paragraph"},{"syntax":"metal","code":["#include <metal_stdlib>","#include <metal_simdgroup_matrix>","","using namespace metal;","","kernel void gemm_simdgroup_q4_0(","    device const half* A               [[buffer(0)]],","    device const half* B               [[buffer(1)]],","    device half* C                     [[buffer(2)]],","    constant uint& M                   [[buffer(3)]],","    constant uint& N                   [[buffer(4)]],","    constant uint& K                   [[buffer(5)]],","    uint2 threadgroup_position_in_grid [[threadgroup_position_in_grid]],","    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]]",") {","    simdgroup_matrix<half, 8, 8> acc;","    acc = make_filled_simdgroup_matrix<half, 8, 8>(0.0h);","    \/\/ Accumulate across inner K dimension...","}"],"type":"codeListing"},{"level":2,"text":"Swift API Integration","anchor":"Swift-API-Integration","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"QuantizedLinear"},{"text":" exposes both MLX tensor inference and direct Metal kernel execution:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import SwiftLLM","","\/\/ 1. Create a quantized linear layer (e.g. 4096 in, 4096 out)","let linear = QuantizedLinear(","    inFeatures: 4096,","    outFeatures: 4096,","    scheme: .q4_0,","    weight: mlxWeights,","    scales: mlxScales",")","","\/\/ 2. Direct Metal shader execution without CPU round-trips","let outputs = try linear.forwardMetal(","    inVector: inputActivations,","    rawWeights: packedQ4Bytes,","    rawScales: fp16Scales",")"],"syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"sections":[],"references":{"doc://SwiftLLM/documentation/SwiftLLM/QuantizedTensor":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedTensor","navigatorTitle":[{"kind":"identifier","text":"QuantizedTensor"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"QuantizedTensor"}],"title":"QuantizedTensor","url":"\/documentation\/swiftllm\/quantizedtensor","type":"topic","abstract":[{"text":"A semantic representation of a parsed tensor preserving raw quantized layout without eager dequantization.","type":"text"}]},"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"role":"article","kind":"article","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","title":"GGUF\/SafeTensors Parsing & Sampling","type":"topic","url":"\/documentation\/swiftllm\/weightparsingandsampling","abstract":[{"type":"text","text":"Parse GGUF and SafeTensors model weights zero-copy and sample tokens using Temperature and Top-K sampling."}]},"doc://SwiftLLM/documentation/SwiftLLM/MetalQuantizedError":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MetalQuantizedError"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalQuantizedError","url":"\/documentation\/swiftllm\/metalquantizederror","type":"topic","kind":"symbol","abstract":[{"text":"Errors occurring during Metal quantized kernel pipeline creation or GPU buffer execution.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MetalQuantizedError"}],"title":"MetalQuantizedError","role":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/QuantizedLayoutMetadata":{"role":"symbol","navigatorTitle":[{"text":"QuantizedLayoutMetadata","kind":"identifier"}],"url":"\/documentation\/swiftllm\/quantizedlayoutmetadata","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QuantizedLayoutMetadata","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedLayoutMetadata","kind":"symbol","title":"QuantizedLayoutMetadata","abstract":[{"type":"text","text":"Scheme-specific layout metadata for quantized tensors."}]},"doc://SwiftLLM/documentation/SwiftLLM/MetalQuantizedEngine":{"role":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalQuantizedEngine","kind":"symbol","navigatorTi