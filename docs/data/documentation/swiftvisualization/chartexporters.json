{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","metadata":{"modules":[{"name":"SwiftVisualization"}],"title":"Native SwiftUI Charting & Interactive Plotly Exporters","roleHeading":"Article","role":"article"},"abstract":[{"type":"text","text":"Render charts with zero external dependencies using "},{"type":"codeVoice","code":"SwiftSciChartView"},{"type":"text","text":" in SwiftUI, or export interactive HTML reports with "},{"type":"codeVoice","code":"ChartExporter"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftVisualization\/documentation\/SwiftVisualization\/ChartExporters"},"variants":[{"paths":["\/documentation\/swiftvisualization\/chartexporters"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"code":"SwiftVisualization","type":"codeVoice"},{"text":" provides two complementary visualization engines:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Native SwiftUI Engine ("},{"code":"SwiftSciChartView","type":"codeVoice"},{"type":"text","text":")"}],"type":"strong"},{"text":": Zero-dependency ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" SwiftUI view rendering line charts, bar charts, scatter plots, histograms, and 2D correlation heatmaps on a high-performance hardware-accelerated ","type":"text"},{"code":"Canvas","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Interactive HTML Exporter ("},{"code":"ChartExporter","type":"codeVoice"},{"type":"text","text":")"}],"type":"strong"},{"text":": Standalone browser-ready HTML diagnostic reports (ROC Curves with trapezoidal Area Under Curve \/ AUC computation, Feature Importances, Confusion Matrices).","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"anchor":"1-Native-SwiftUI-Charting-SwiftSciChartView","level":2,"type":"heading","text":"1. Native SwiftUI Charting (`SwiftSciChartView`)"},{"inlineContent":[{"type":"text","text":"Embed responsive, animated charts in iOS and macOS SwiftUI user interfaces:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import SwiftVisualization","","struct ModelDiagnosticsView: View {","    let lossHistory: [Double] = [0.85, 0.62, 0.45, 0.38, 0.29, 0.22, 0.18, 0.15]","    let epochLabels: [String] = (1...8).map { \"Ep \\($0)\" }","    ","    var body: some View {","        VStack(alignment: .leading, spacing: 16) {","            Text(\"Training Loss Convergence\")","                .font(.headline)","            ","            \/\/ 1. Line Chart with custom options","            SwiftSciChartView(","                type: .line,","                data: lossHistory,","                labels: epochLabels,","                options: ChartOptions(","                    accentColor: .blue,","                    showAxes: true,","                    lineWidth: 3.0,","                    customYAxisLabel: \"Loss (Cross-Entropy)\"","                )","            )","            .frame(height: 250)","            .padding()","            .background(Color(.windowBackgroundColor).opacity(0.5))","            .cornerRadius(12)","        }","        .padding()","    }","}"]},{"type":"thematicBreak"},{"anchor":"2-2D-Correlation-Heatmaps-in-SwiftUI","level":2,"type":"heading","text":"2. 2D Correlation Heatmaps in SwiftUI"},{"inlineContent":[{"type":"text","text":"Render 2D covariance and correlation matrices with automatic color gradients:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import SwiftVisualization","","struct CorrelationMatrixView: View {","    \/\/ 3x3 Correlation Grid","    let matrix2D: [[Double]] = [","        [ 1.00,  0.82, -0.45],","        [ 0.82,  1.00, -0.30],","        [-0.45, -0.30,  1.00]","    ]","    let featureNames = [\"Revenue\", \"Profit\", \"Expenses\"]","    ","    var body: some View {","        SwiftSciChartView(","            type: .heatmap2D(matrix2D),","            data: [],","            labels: featureNames,","            options: ChartOptions(showAxes: true)","        )","        .frame(width: 320, height: 320)","    }","}"]},{"type":"thematicBreak"},{"anchor":"3-Interactive-Plotly-HTML-Reports-with-AUC","level":2,"type":"heading","text":"3. Interactive Plotly HTML Reports with AUC"},{"inlineContent":[{"type":"text","text":"Generate standalone HTML diagnostics viewable in any modern browser:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftVisualization","","\/\/ 1. Export ROC Curve with exact trapezoidal AUC computation","let yTrue = [0, 0, 1, 1, 0, 1]","let yScores = [0.1, 0.35, 0.8, 0.92, 0.2, 0.75]","","let rocHTML = ChartExporter.plotROCCurve(yScores: yScores, yTrue: yTrue)","let outputURL = URL(fileURLWithPath: \"roc_curve_report.html\")","try rocHTML.write(to: outputURL, atomically: true, encoding: .utf8)","","print(\"Saved interactive ROC report with trapezoidal AUC title.\")","","\/\/ 2. Export Feature Importance bar chart","let featureImportances = [\"age\": 0.35, \"income\": 0.45, \"education\": 0.20]","let featHTML = ChartExporter.plotFeatureImportances(featureImportances)"]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftVisualization\/documentation\/SwiftVisualization"]]},"references":{"doc://SwiftVisualization/documentation/SwiftVisualization":{"identifier":"doc:\/\/SwiftVisualization\/documentation\/SwiftVisualization","type":"topic","abstract":[{"text":"Standalone Interactive HTML Chart Exporters.","type":"text"}],"kind":"symbol","role":"collection","title":"SwiftVisualization","url":"\/documentation\/swiftvisualization"}}}