{"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensemble methods combine multiple base estimators to improve generalization and reduce variance. "},{"type":"codeVoice","code":"SwiftML"},{"type":"text","text":" implements both "},{"type":"strong","inlineContent":[{"type":"text","text":"Random Forests"}]},{"type":"text","text":" (bagging) and "},{"type":"strong","inlineContent":[{"type":"text","text":"Gradient Boosted Decision Trees"}]},{"type":"text","text":" (boosting) with high-performance tree split search."}]},{"type":"heading","level":2,"anchor":"1-Random-Forest-Classification--Regression","text":"1. Random Forest Classification & Regression"},{"type":"paragraph","inlineContent":[{"code":"RandomForestClassifier","type":"codeVoice"},{"text":" trains an ensemble of randomized decision trees using bootstrap aggregation (bagging) and random feature subsets:","type":"text"}]},{"type":"codeListing","code":["import SwiftML","","let rf = try RandomForestClassifier(","    nEstimators: 100,","    maxDepth: 10,","    minSamplesSplit: 2,","    criterion: .gini",")","","try await rf.fit(features: X_train, targets: y_train)","let predictions = try await rf.predict(features: X_test)","let probabilities = try await rf.predictProba(features: X_test)"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"2-Gradient-Boosted-Decision-Trees-GBDT","text":"2. Gradient Boosted Decision Trees (GBDT)"},{"type":"paragraph","inlineContent":[{"code":"GradientBoostingClassifier","type":"codeVoice"},{"type":"text","text":" sequentially trains decision trees to minimize pseudo-residuals using gradient descent in function space:"}]},{"type":"codeListing","code":["let gbdt = try GradientBoostingClassifier(","    nEstimators: 50,","    learningRate: 0.1,","    maxDepth: 5",")","","try await gbdt.fit(features: X_train, targets: y_train)"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"3-Feature-Importance-Extraction","text":"3. Feature Importance Extraction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both tree models compute Gini\/MSE feature importances directly:"}]},{"type":"codeListing","code":["let importances = rf.featureImportances","print(\"Feature importances: \\(importances)\")"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/ensemblelearning"]}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftML"}],"title":"Ensemble Learning: Random Forests & Gradient Boosted Trees"},"sections":[],"topicSections":[{"title":"Tree Estimators","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestClassifier","doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestRegressor"],"anchor":"Tree-Estimators"}],"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"references":{"doc://SwiftML/documentation/SwiftML/RandomForestClassifier":{"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Actor-isolated Random Forest Classifier."},{"type":"text","text":" "},{"type":"text","text":"Each tree is trained concurrently in a TaskGroup on a bootstrapped sample."}],"navigatorTitle":[{"text":"RandomForestClassifier","kind":"identifier"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestClassifier","type":"topic","url":"\/documentation\/swiftml\/randomforestclassifier","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomForestClassifier","kind":"identifier"}],"title":"RandomForestClassifier"},"doc://Swift