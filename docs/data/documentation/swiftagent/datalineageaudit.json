{"topicSections":[{"title":"Audit Types","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Audit-Types"}],"metadata":{"roleHeading":"API Collection","title":"Data Lineage & Transformation Audit Trails","role":"collectionGroup","modules":[{"name":"SwiftAgent"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit"},"abstract":[{"type":"text","text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents."}],"kind":"article","sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation."}]},{"type":"paragraph","inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"type":"text","text":" automatically generates an immutable audit trail of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord"},{"type":"text","text":" entries for each command evaluated."}]},{"text":"LineageRecord Structure","level":2,"anchor":"LineageRecord-Structure","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true},{"type":"text","text":" contains:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"stepIndex"},{"text":": Sequential index of the step within the agent trajectory.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"operation","type":"codeVoice"},{"text":": The normalized DSL command executed (e.g., ","type":"text"},{"code":"filter(age)","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"groupBy(category,mean)"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"inputRows"},{"type":"text","text":": Dataset row count immediately prior to transformation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"outputRows","type":"codeVoice"},{"text":": Dataset row count produced by the transformation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"timestamp"},{"type":"text","text":": The exact timestamp of execution."}],"type":"paragraph"}]}]},{"text":"Example: Accessing Audit Trails","anchor":"Example-Accessing-Audit-Trails","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"]}]}],"variants":[{"paths":["\/documentation\/swiftagent\/datalineageaudit"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"navigatorTitle":[{"text":"SwiftAgentEvaluator","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiftAgentEvaluator"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","title":"SwiftAgentEvaluator","url":"\/documentation\/swiftagent\/swiftagentevaluator","abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"type":"topic","kind":"symbol","role":"symbol"},"doc://SwiftAgent/documentation/SwiftAgent":{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","title":"SwiftAgent","kind":"symbol","role":"collection","url":"\/documentation\/swiftagent","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"type":"topic"},"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"navigatorTitle":[{"kind":"identifier","text":"LineageRecord"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","kind":"symbol","abstract":[{"type":"text","text":"Represents an immutable audit trail entry recording a discrete data transformation step."}],"type":"topic","role":"symbol","title":"LineageRecord","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LineageRecord"}],"url":"\/documentation\/swiftagent\/lineagerecord"}}}