{"abstract":[{"type":"text","text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"]}],"sections":[],"kind":"article","metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftDataFrame"}],"role":"collectionGroup","title":"High-Performance GroupBy & Vectorized Aggregations"},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory."}]},{"type":"heading","level":2,"text":"1. Basic GroupBy Aggregation","anchor":"1-Basic-GroupBy-Aggregation"},{"type":"codeListing","syntax":"swift","code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"]},{"type":"heading","level":2,"text":"2. Multi-Column Grouping","anchor":"2-Multi-Column-Grouping"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can group by multiple categorical dimensions simultaneously:"}]},{"type":"codeListing","syntax":"swift","code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"]},{"type":"heading","level":2,"text":"3. Performance & Memory Efficiency","anchor":"3-Performance--Memory-Efficiency"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Single-Pass Hash Accumulation","type":"text"}]},{"text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"vDSP Vector Reductions","type":"text"}]},{"text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines (","type":"text"},{"code":"vDSP_sveD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_meanvD","type":"codeVoice"},{"text":").","type":"text"}]}]}]}]}],"topicSections":[{"anchor":"Grouping-APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"],"title":"Grouping APIs"},{"anchor":"Exact-integer-totals","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/CheckedIntegerSums"],"title":"Exact integer totals"}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"abstract":[{"type":"text","text":"Returns a "},{"type":"codeVoice","code":"GroupedDataFrame"},{"type":"text","text":" for aggregation."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupBy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"...) -> ","kind":"text"},{"text":"GroupedDataFrame","kind":"typeIdentifier","preciseIdentifier":"s:14SwiftDataFrame07GroupedbC0V"}],"title":"groupBy(_:)","kind":"symbol","url":"\/documentation\/swiftdataframe\/dataframe\/groupby(_:)","type":"topic","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)","role":"symbol"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/CheckedIntegerSums":{"title":"Checked integer group sums","type":"topic","url":"\/documentation\/swiftdataframe\/checkedintegersums","role":"article","kind":"article","abstract":[{"text":"Use ","type":"text"},{"code":"sumChecked()","type":"codeVoice"},{"text":" when integer totals must remain exact. Existing ","type":"text"},{"code":"sum()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"agg","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"transform"},{"text":" calls keep their Double results and conversion behavior.","type":"text"}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/CheckedIntegerSums"},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"role":"collection","type":"topic","url":"\/documentation\/swiftdataframe","abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}],"kind":"symbol","title":"SwiftDataFrame","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"}}}