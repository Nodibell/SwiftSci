{"hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"In real-time computer vision models such as YOLO, post-processing can generate tens of thousands of candidate detections per frame. Standard bounding box objects with heap-allocated "},{"code":"String","type":"codeVoice"},{"type":"text","text":" class names induce significant ARC and memory allocation overhead."}],"type":"paragraph"},{"inlineContent":[{"code":"SwiftVision","type":"codeVoice"},{"type":"text","text":" introduces "},{"type":"reference","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBoxSIMD","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Zero-Heap Value Representation","type":"text"}]},{"type":"text","text":": Encapsulates bounding coordinates in hardware "},{"type":"codeVoice","code":"SIMD4<Float>"},{"type":"text","text":" registers and replaces strings with integer "},{"type":"codeVoice","code":"classId: Int32"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Accelerated Vector IoU","type":"text"}]},{"type":"text","text":": Computes intersection, union, and clamping entirely within SIMD registers without memory allocations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"High-Throughput NMS","type":"text"}]},{"type":"text","text":": Provides "},{"type":"reference","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/NonMaximumSuppression\/filter(boxes:iouThreshold:scoreThreshold:)-5ernf","isActive":true},{"type":"text","text":" operating directly on SIMD bounding boxes."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Usage-Example","text":"Usage Example","level":2,"t