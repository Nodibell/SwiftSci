{"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"],"generated":true,"title":"Guides & Tutorials"}],"variants":[{"paths":["\/documentation\/swiftdatabase\/databaseconnectors"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"modules":[{"name":"SwiftDatabase"}],"title":"Relational Database Drivers & Zero-Copy SQL Ingestion","roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into ","type":"text"},{"type":"codeVoice","code":"SwiftDataFrame"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiftDatabase","type":"codeVoice"},{"text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 ","type":"text"},{"code":"public actor","type":"codeVoice"},{"text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks.","type":"text"}]},{"type":"thematicBreak"},{"text":"🔒 Driver Architecture & Concurrency Model","type":"heading","anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model","level":2},{"type":"codeListing","code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"],"syntax":null},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Actor Isolation:"}],"type":"strong"},{"text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Streaming "},{"type":"codeVoice","code":"recv"},{"type":"text","text":" Buffer:"}],"type":"strong"},{"text":" Network drivers use a 64KB receive buffer reading continuously until ","type":"text"},{"code":"ReadyForQuery ('Z')","type":"codeVoice"},{"text":" is received.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication:"}],"type":"strong"},{"text":" Built-in support for Cleartext and MD5 password authentication via ","type":"text"},{"code":"CommonCrypto","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"text":"1. Querying SQLite Databases & C-Pointer Lifecycle Safety","type":"heading","anchor":"1-Querying-SQLite-Databases--C-Pointer-Lifecycle-Safety","level":2},{"type":"paragraph","inlineContent":[{"code":"SQLiteConnection","type":"codeVoice"},{"text":" executes SQL statements through native ","type":"text"},{"code":"sqlite3_prepare_v2","type":"codeVoice"},{"text":" and directly streams result rows into columnar ","type":"text"},{"code":"TypedColumn","type":"codeVoice"},{"text":" buffers with full C-pointer lifecycle safety:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Statement Finalization:"}],"type":"strong"},{"text":" All prepared statements are guaranteed to be finalized via ","type":"text"},{"code":"defer { if let stmt { sqlite3_finalize(stmt) } }","type":"codeVoice"},{"text":", preventing statement pointer leaks during both normal termination and thrown query errors.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Resource Cleanup:"}],"type":"strong"},{"text":" In-memory or file-backed database handles are automatically closed via ","type":"text"},{"code":"sqlite3_close_v2","type":"codeVoice"},{"text":" upon deallocation. Callers may also invoke ","type":"text"},{"code":"await sqlite.close()","type":"codeVoice"},{"text":" to immediately release operating system locks and memory.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = SQLiteConnection(databasePath: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)","","\/\/ 3. Explicitly release SQLite database handle when done","await sqlite.close()"],"syntax":"swift"},{"type":"thematicBreak"},{"text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","type":"heading","anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol","level":2},{"type":"paragraph","inlineContent":[{"text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries (","type":"text"},{"code":"libpq","type":"codeVoice"},{"text":"):","type":"text"}]},{"type":"codeListing","code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    user: \"postgres\",","    password: \"secure_password\",","    sslMode: .disable",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"],"syntax":"swift"},{"type":"thematicBreak"},{"text":"3. High-Throughput Bulk Writeback (`toSQL`)","type":"heading","anchor":"3-High-Throughput-Bulk-Writeback-toSQL","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bulk export in-memory "},{"type":"codeVoice","code":"DataFrame"},{"type":"text","text":" objects back into database tables with configurable append, replace, or fail-if-exists modes:"}]},{"type":"codeListing","code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append, .replace, or .failIfExists","    batchSize: 500",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"],"syntax":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors"},"sections":[],"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","type":"topic","abstract":[{"text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions.","type":"text"}],"role":"collectionGroup","title":"Database Type System & Value Representation","kind":"article","url":"\/documentation\/swiftdatabase\/typesystem"},"doc://SwiftDatabase/documentation/SwiftDatabase":{"role":"collection","url":"\/documentation\/swiftdatabase","i