{"kind":"article","metadata":{"title":"Dense Local Text Embeddings & Zero-Shot Classification","modules":[{"name":"SwiftNLP"}],"roleHeading":"API Collection","role":"collectionGroup"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Modern Retrieval-Augmented Generation (RAG), semantic vector search, and automated data categorization require fast, high-quality vector representations of text. ","type":"text"},{"type":"codeVoice","code":"SwiftNLP"},{"text":" provides a unified architecture via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider","type":"reference"},{"text":", offering two distinct engine implementations:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","type":"reference","isActive":true}]},{"type":"text","text":": Native 512-dimensional contextual semantic embeddings powered by Apple Natural Language and Core ML foundation models with Accelerate $L_2$ unit normalization."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","isActive":true,"type":"reference"}]},{"text":": Deterministic, lightweight subword N-gram hashing projection producing customizable $D$-dimensional embeddings in microseconds with zero disk weight.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Both engines integrate seamlessly with ","type":"text"},{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","type":"reference","isActive":true},{"text":" for zero-shot text categorization and ","type":"text"},{"identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftcluster\/vectorstore\/","type":"reference","isActive":true},{"text":" for real-time similarity search.","type":"text"}]},{"type":"codeListing","syntax":"mermaid","code":["graph TD","    Text[Raw Text \/ Document] --> Provider[SentenceEmbeddingProvider]","    Provider --> Apple[AppleSentenceEmbeddingEngine: 512-D Core ML]","    Provider --> Hash[LocalEmbeddingEngine: Subword N-Gram Projection]","    Apple --> SIMDNorm[Accelerate vDSP L2 Unit Normalization]","    Hash --> SIMDNorm","    SIMDNorm --> NormalizedVec[Unit Vector: ||v|| = 1.0]","    NormalizedVec --> VectorStore[(SwiftCluster VectorStore \/ HNSW)]","    NormalizedVec --> ZeroShot[ZeroShotTextClassifier Softmax Probabilities]"]},{"type":"thematicBreak"},{"anchor":"1-Choosing-an-Embedding-Engine","type":"heading","level":2,"text":"1. Choosing an Embedding Engine"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Feature","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppleSentenceEmbeddingEngine"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalEmbeddingEngine"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Underlying Mechanism"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Apple Natural Language \/ Core ML","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Subword N-Gram Hashing (FNV-1a + Signs)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Embedding Dimension"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fixed 512-D","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Configurable (e.g., 64, 128, 256, 512)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Weights on Disk"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0 MB (pre-installed system foundation model)"}]}],[{"inlineContent":[{"type":"text","text":"0 MB (algorithmic hash projection)"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Semantic Awareness","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"High (contextual, synonym & paraphrase aware)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lexical \/ Syntactic (spelling, morphology, keyword)"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Typical Latency","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"~0.5 – 1.5 ms \/ text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"~0.05 – 0.15 ms \/ text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Best Used For","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"RAG retrieval, zero-shot classification, semantic search"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"High-throughput deduplication, fuzzy search, microcontrollers"}]}]]],"type":"table","alignments":["left","left","left"],"header":"row"},{"type":"thematicBreak"},{"anchor":"2-Using-AppleSentenceEmbeddingEngine","type":"heading","text":"2. Using `AppleSentenceEmbeddingEngine`","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","isActive":true,"type":"reference"},{"type":"text","text":" leverages Apple Silicon’s Neural Engine to produce 512-dimensional contextual embeddings. All output vectors are automatically normalized to unit length ($|v|_2 = 1.0$) using Accelerate SIMD operations ("},{"code":"vDSP_svesqD","type":"codeVoice"},{"type":"text","text":" and "},{"code":"vDSP_vsdivD","type":"codeVoice"},{"type":"text","text":"):"}]},{"type":"codeListing","code":["import SwiftNLP","","\/\/ Initialize native Apple sentence embedder","let engine = AppleSentenceEmbeddingEngine()","","\/\/ Verify availability for current device and locale","guard engine.isAvailable(for: .english) else {","    fatalError(\"Apple sentence embedding model not available for English on this system.\")","}","","\/\/ Generate a 512-dimensional embedding","let embedding = try await engine.embed(\"Retrieval-Augmented Generation with SwiftSci\")","print(\"Vector length: \\(embedding.count)\") \/\/ 512","","\/\/ Batch asynchronous embedding generation","let documents = [","    \"Apple Accelerate provides vectorized SIMD routines.\",","    \"Metal Performance Shaders accelerate tensor operations.\",","    \"SwiftData provides declarative SQLite persistence.\"","]","let batchVectors = try await engine.embedBatch(documents)"],"syntax":"swift"},{"type":"thematicBreak"},{"anchor":"3-Using-LocalEmbeddingEngine","type":"heading","text":"3. Using `LocalEmbeddingEngine`","level":2},{"inlineContent":[{"text":"For memory-constrained environments or extreme throughput requirements, ","type":"text"},{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","isActive":true,"type":"reference"},{"text":" computes embeddings via subword character n-gram projections without model weights:","type":"text"}],"type":"paragraph"},{"code":["import SwiftNLP","","\/\/ Initialize with custom dimensionality (default: 128)","let fastEngine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Synchronous and asynchronous embedding","let vector = fastEngine.embed(\"Fast in-memory hashing projection\")","let batch = try await fastEngine.embedBatch([\"Document A\", \"Document B\"])"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"anchor":"4-Measuring-Semantic-Similarity","type":"heading","text":"4. Measuring Semantic Similarity"},{"inlineContent":[{"text":"Because all embeddings produced by ","type":"text"},{"code":"SentenceEmbeddingProvider","type":"codeVoice"},{"text":" are unit-normalized, the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Cosine Similarity"}]},{"text":" between two vectors $u$ and $v$ is mathematically identical to their direct ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Dot Product"}]},{"type":"text","text":":"}],"type":"paragraph"},{"inlineContent":[{"text":"$$\\text{CosineSimilarity}(u, v) = \\frac{u \\cdot v}{|u|_2 |v|_2} = u \\cdot v$$","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Calculate cosine similarity at native memory speeds using Apple Accelerate:"}],"type":"paragraph"},{"code":["import Accelerate","","func cosineSimilarity(_ a: [Double], _ b: [Double]) -> Double {","    guard a.count == b.count, !a.isEmpty else { return 0.0 }","    var dot: Double = 0.0","    vDSP_dotprD(a, 1, b, 1, &dot, vDSP_Length(a.count))","    return dot","}","","let queryVec = try await engine.embed(\"Vector mathematics on Mac\")","let docVec = try await engine.embed(\"Apple Accelerate linear algebra\")","let similarity = cosineSimilarity(queryVec, docVec)","print(\"Semantic similarity score: \\(similarity)\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"anchor":"5-Zero-Shot-Text-Classification","type":"heading","text":"5. Zero-Shot Text Classification"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Classify arbitrary text documents into dynamic candidate categories on the fly without training a classifier or labeling training sets:"}]},{"type":"codeListing","code":["import SwiftNLP","","\/\/ Initialize classifier with Apple embeddings","let classifier = ZeroShotTextClassifier(","    embeddingEngine: AppleSentenceEmbeddingEngine(),","    hypothesisTemplate: \"This text is about {}.\"",")","","\/\/ Single-label classification (Softmax distribution)","let result = try await classifier.classify(","    text: \"The patient presented with elevated systolic pressure and sinus tachycardia.\",","    candidateLabels: [\"Cardiology\", \"Astronomy\", \"Sports\", \"Politics\"],","    multiLabel: false",")","","print(\"Top label: \\(result.topLabel ?? \"\") (confidence: \\(result.topScore))\")","for (label, score) in result.scores {","    print(\"  • \\(label): \\(String(format: \"%.3f\", score))\")","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Multi-Label-Classification","text":"Multi-Label Classification"},{"type":"paragraph","inlineContent":[{"text":"For documents that can belong to multiple categories simultaneously, set ","type":"text"},{"code":"multiLabel: true","type":"codeVoice"},{"text":" to compute independent sigmoid activations:","type":"text"}]},{"code":["let multiResult = try await classifier.classify(","    text: \"Quarterly corporate earnings and federal interest rate decisions.\",","    candidateLabels: [\"Finance\", \"Government\", \"Culinary\", \"Gaming\"],","    multiLabel: true",")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"6-DataFrame-Zero-Shot-Categorization","text":"6. DataFrame Zero-Shot Categorization"},{"type":"paragraph","inlineContent":[{"text":"Classify entire columns of tabular data directly within a ","type":"text"},{"identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","isActive":true,"type":"reference"},{"text":" using ","type":"text"},{"code":"zeroShotClassify","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["import SwiftDataFrame","import SwiftNLP","","var feedbackDF = DataFrame(columns: [","    TypedColumn(name: \"FeedbackID\", values: [1, 2, 3]),","    TypedColumn(name: \"ReviewText\", values: [","        \"The app crashed when opening the PDF export screen.\",","        \"Monthly subscription pricing is too expensive.\",","        \"Smooth navigation and beautiful dark mode aesthetics.\"","    ])","])","","\/\/ Classify ReviewText column into sentiment and topic categories","let classifiedDF = try await feedbackDF.zeroShotClassify(","    textColumn: \"ReviewText\",","    candidateLabels: [\"Bug Report\", \"Pricing\", \"User Interface\"],","    outputColumn: \"Category\"",")","","print(classifiedDF.summary())"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"}]}],"variants":[{"paths":["\/documentation\/swiftnlp\/denselocalembeddings"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon and perform zero-shot classification without model training.","type":"text"}],"topicSections":[{"anchor":"Embedding-Engine-Types","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"],"title":"Embedding Engine Types"},{"anchor":"Zero-Shot-Classification","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotClassificationResult"],"title":"Zero-Shot Classification"}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings","interfaceLanguage":"swift"},"references":{"https://nodibell.github.io/SwiftSci/documentation/swiftdataframe/":{"identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","titleInlineContent":[{"code":"SwiftDataFrame","type":"codeVoice"}],"url":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","type":"link","title":"SwiftDataFrame"},"https://nodibell.github.io/SwiftSci/documentation/swiftcluster/vectorstore/":{"identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftcluster\/vectorstore\/","titleInlineContent":[{"code":"SwiftCluster.VectorStore","type":"codeVoice"}],"url":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftcluster\/vectorstore\/","type":"link","title":"SwiftCluster.VectorStore"},"doc://SwiftNLP/documentation/SwiftNLP/SentenceEmbeddingProvider":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SentenceEmbeddingProvider"}],"navigatorTitle":[{"kind":"identifier","text":"SentenceEmbeddingProvider"}],"url":"\/documentation\/swiftnlp\/sentenceembeddingprovider","abstract":[{"type":"text","text":"A protocol representing a local or model-based sentence embedding generator."}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider","type":"topic","kind":"symbol","role":"symbol","title":"SentenceEmbeddingProvider"},"doc://SwiftNLP/documentation/SwiftNLP/AppleSentenceEmbeddingEngine":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AppleSentenceEmbeddingEngine","kind":"identifier"}],"navigatorTitle":[{"text":"AppleSentenceEmbeddingEngine","kind":"identifier"}],"url":"\/documentation\/swiftnlp\/applesentenceembeddingengine","abstract":[{"type":"text","text":"A sentence embedding generator powered by Apple’s native pre-trained "},{"code":"NLEmbedding","type":"codeVoice"},{"text":" models.","type":"text"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","type":"topic","kind":"symbol","role":"symbol","title":"AppleSentenceEmbeddingEngine"},"doc://SwiftNLP/documentation/SwiftNLP/ZeroShotTextClassifier":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZeroShotTextClassifier","kind":"identifier"}],"navigatorTitle":[{"text":"ZeroShotTextClassifier","kind":"identifier"}],"abstract":[{"text":"A zero-shot text classifier that categorizes text into arbitrary classes without task-specific training.","type":"text"}],"url":"\/documentation\/swiftnlp\/zeroshottextclassifier","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","type":"topic","kind":"symbol","role":"symbol","title":"ZeroShotTextClassifier"},"doc://SwiftNLP/documentation/SwiftNLP":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","type":"topic","url":"\/documentation\/swiftnlp","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"role":"collection","title":"SwiftNLP","kind":"symbol"},"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LocalEmbeddingEngine"}],"navigatorTitle":[{"text":"LocalEmbeddingEngine","kind":"identifier"}],"abstract":[{"type":"text","text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon."}],"url":"\/documentation\/swiftnlp\/localembeddingengine","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","type":"topic","kind":"symbol","role":"symbol","title":"LocalEmbeddingEngine"},"doc://SwiftNLP/documentation/SwiftNLP/ZeroShotClassificationResult":{"kind":"symbol","title":"ZeroShotClassificationResult","url":"\/documentation\/swiftnlp\/zeroshotclassificationresult","role":"symbol","type":"topic","abstract":[{"text":"The output of a zero-shot text classification inference.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ZeroShotClassificationResult"}],"navigatorTitle":[{"kind":"identifier","text":"ZeroShotClassificationResult"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotClassificationResult"}}}