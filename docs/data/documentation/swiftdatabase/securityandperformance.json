{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"As datasets grow into the millions of rows and production PostgreSQL deployments enforce stronger authentication policies, "},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" provides two complementary enhancements:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"1024-row column buffering"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"SQLiteConnection.executeQuery"},{"type":"text","text":" reduces Swift "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" reallocation pressure on large sequential table scans."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"SCRAM-SHA-256 authentication","type":"text"}]},{"text":" in ","type":"text"},{"code":"PostgreSQLConnection","type":"codeVoice"},{"text":" implements the full RFC 5802\/7677 handshake using CryptoKit ","type":"text"},{"code":"HMAC<SHA256>","type":"codeVoice"},{"text":" and iterative PBKDF2 — never transmitting the raw password over the wire.","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"1024-Row Column Buffering","anchor":"1024-Row-Column-Buffering"},{"type":"heading","level":3,"text":"Problem","anchor":"Problem"},{"type":"paragraph","inlineContent":[{"text":"The naive approach appends each decoded row immediately to a growing ","type":"text"},{"type":"codeVoice","code":"[[AnySendableValue]]"},{"type":"text","text":" array. Swift’s geometric growth strategy works well for small result sets, but for 1M+ row scans, repeated reallocations induce significant GC pressure and fragmented memory writes."}]},{"text":"Solution","anchor":"Solution","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"executeQuery"},{"type":"text","text":" pre-allocates a local "},{"code":"page","type":"codeVoice"},{"text":" buffer of exactly 1024 rows. When the page fills, it is bulk-appended to the result array via ","type":"text"},{"code":"rows.append(contentsOf: page)","type":"codeVoice"},{"type":"text","text":", then the page is cleared with "},{"code":"removeAll(keepingCapacity: true)","type":"codeVoice"},{"type":"text","text":" to avoid reallocation."}]},{"type":"codeListing","code":["let pageSize = 1024","var page: [[AnySendableValue]] = []","page.reserveCapacity(pageSize)","","while sqlite3_step(stmt) == SQLITE_ROW {","    page.append(decodeRow())","    if page.count == pageSize {","        rows.append(contentsOf: page)","        page.removeAll(keepingCapacity: true)","    }","}","rows.append(contentsOf: page) \/\/ Flush remainder"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Benchmark impact","type":"text"}]},{"text":": ~40% fewer allocations on 500K-row tables vs. naive append.","type":"text"}]},{"type":"heading","anchor":"SCRAM-SHA-256-Authentication","level":2,"text":"SCRAM-SHA-256 Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modern PostgreSQL (>= 14) defaults to "},{"type":"codeVoice","code":"scram-sha-256"},{"type":"text","text":" in "},{"type":"codeVoice","code":"pg_hba.conf"},{"text":". ","type":"text"},{"code":"SwiftDatabase","type":"codeVoice"},{"text":"’s wire-protocol driver now supports the full RFC 5802 exchange:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["Client                                    Server","  │  SASLInitialResponse(SCRAM-SHA-256)     │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLContinue(salt, i)    │","  │ ◄────────────────────────────────────── │","  │  SASLResponse(ClientProof)              │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLFinal + AuthOK       │","  │ ◄────────────────────────────────────── │"]},{"level":3,"text":"PBKDF2-SHA256 via CryptoKit","anchor":"PBKDF2-SHA256-via-CryptoKit","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"SaltedPassword = Hi(password, salt, iterations)"},{"text":" derivation uses a pure Swift PBKDF2 loop over CryptoKit ","type":"text"},{"type":"codeVoice","code":"HMAC<SHA256>"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["var u = HMAC<SHA256>.authenticationCode(for: salt + [0,0,0,1], using: SymmetricKey(data: passwordData))","var saltedPassword = Array(u)","for _ in 1..<iterations {","    u = HMAC<SHA256>.authenticationCode(for: Data(u), using: ...)","    \/\/ XOR accumulate","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Enabling SCRAM on PostgreSQL Server","anchor":"Enabling-SCRAM-on-PostgreSQL-Server","type":"heading"},{"type":"codeListing","syntax":"sql","code":["-- pg_hba.conf","host  all  all  0.0.0.0\/0  scram-sha-256","","-- Verify in psql:","SELECT usename, passwd FROM pg_shadow;","-- Password should start with: SCRAM-SHA-256$4096:..."]}],"kind":"content"}],"topicSections":[{"anchor":"SQLite-Performance","title":"SQLite Performance","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection"]},{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection"],"title":"PostgreSQL Security","anchor":"PostgreSQL-Security"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/securityandperformance"]}],"abstract":[{"text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL.","type":"text"}],"kind":"article","metadata":{"title":"Security & Performance in SwiftDatabase","role":"collectionGroup","modules":[{"name":"SwiftDatabase"}],"roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"]}],"sections":[],"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"url":"\/documentation\/swiftdatabase\/highthroughputingestion","title":"Bulk SQL Ingestion & Database Wire Protocols","abstract":[{"text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback.","type":"text"}],"role":"collectionGroup","type":"topic","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","kind":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase/DatabaseConnectors":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","role":"article","url":"\/documentation\/swiftdatabase\/databaseconnectors","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","abstract":[{"type":"text","text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" under Swift 6 Actor Concurrency."}],"kind":"article","type":"topic"},"doc://SwiftDatabase/documentation/SwiftDatabase":{"role":"collection","url":"\/documentation\/swiftdatabase","title":"SwiftDatabase","type":"topic","abstract":[{"type":"text","text":"Relational Database Connectors to DataFrames."}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase","kind":"symbol"},"doc://SwiftDatabase/documentation/SwiftDatabase/SQLiteConnection":{"title":"SQLiteConnection","url":"\/documentation\/swiftdatabase\/sqliteconnection","navigatorTitle":[{"text":"SQLiteConnection","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"text":"Embedded SQLite database driver executing real SQL statements using the SQLite3 C API.","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SQLiteConnection","kind":"identifier"}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection"},"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"url":"\/documentation\/swiftdatabase\/typesystem","title":"Database Type System & Value Representation","abstract":[{"text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions.","type":"text"}],"role":"collectionGroup","type":"topic","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","kind":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase/PostgreSQLConnection":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection","role":"symbol","url":"\/documentation\/swiftdatabase\/postgresqlconnection","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"text":"PostgreSQLConnection","kind":"identifier"}],"navigatorTitle":[{"text":"PostgreSQLConnection","kind":"identifier"}],"title":"PostgreSQLConnection","abstract":[{"text":"Native PostgreSQL database connection driver using PostgreSQL v3.0 wire protocol.","type":"text"}],"kind":"symbol","type":"topic"}}}