{"abstract":[{"type":"text","text":"Understand how SwiftSci automatically routes workloads between CPU (Accelerate\/AMX\/NEON) and Metal GPU (MLX) with strict concurrency safety."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouterAndMemory"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Hardware Routing & Unified Memory Governance","modules":[{"name":"SwiftPreprocessing"}]},"kind":"article","topicSections":[{"anchor":"Memory--Routing-APIs","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket"],"title":"Memory & Routing APIs"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Apple Silicon features a ","type":"text"},{"inlineContent":[{"text":"Unified Memory Architecture (UMA)","type":"text"}],"type":"strong"},{"text":" where the CPU, GPU, and Apple Neural Engine (ANE) share a single high-bandwidth memory pool. ","type":"text"},{"type":"codeVoice","code":"SwiftPreprocessing"},{"text":" provides intelligent hardware routing and memory reservation primitives to prevent GPU saturation and avoid data copying.","type":"text"}]},{"level":2,"type":"heading","anchor":"1-The-Hardware-Router","text":"1. The Hardware Router"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"HardwareRouter"},{"text":" assesses tensor dimensions and operation complexity to select the optimal computing engine:","type":"text"}]},{"code":["graph TD","    Op[Compute Operation] --> Router{HardwareRouter}","    Router -->|Small \/ Vector < 50k| CPU[Accelerate \/ AMX \/ NEON]","    Router -->|Large Matrix \/ Autodiff| GPU[MLX Metal GPU]","    Router -->|Static Inference| ANE[Core ML Engine]"],"syntax":"mermaid","type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Small Vectors ($N < 50{,}000$)"}]},{"text":": Routed to CPU Accelerate (vDSP\/BLAS\/LAPACK) to eliminate GPU kernel dispatch latency.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Large Tensors & Deep Learning"}]},{"text":": Routed to MLX Metal GPU for massive parallel throughput.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","anchor":"2-WiredMemoryManager--Ticket-System","text":"2. WiredMemoryManager & Ticket System"},{"type":"paragraph","inlineContent":[{"text":"To prevent out-of-memory (OOM) conditions during concurrent analytical workloads, ","type":"text"},{"type":"codeVoice","code":"WiredMemoryManager"},{"text":" implements an asynchronous FIFO reservation system:","type":"text"}]},{"code":["import SwiftPreprocessing","","\/\/ Acquire a GPU execution slot","let ticket = try await WiredMemoryManager.shared.reserveMemory(estimatedBytes: 64 * 1024 * 1024)","","\/\/ Execute heavy MLX operations","\/\/ ...","","\/\/ Automatically flushes GPU caches upon completion","await ticket.release()"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftpreprocessing\/hardwarerouterandmemory"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/HardwareRouter":{"navigatorTitle":[{"kind":"identifier","text":"HardwareRouter"}],"abstract":[{"type":"text","text":"Serializes device selection and MLX default-device changes (global MLX state)."}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"HardwareRouter"}],"url":"\/documentation\/swiftpreprocessing\/hardwarerouter","type":"topic","title":"HardwareRouter"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryManager":{"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"WiredMemoryManager"}],"navigatorTitle":[{"kind":"identifier","text":"WiredMemoryManager"}],"type":"topic","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","title":"WiredMemoryManager","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Actor-based manager that controls concurrent allocations and tasks in Apple Silicon Unified Memory."}],"url":"\/documentation\/swiftpreprocessing\/wiredmemorymanager"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryTicket":{"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"WiredMemoryTicket"}],"navigatorTitle":[{"kind":"identifier","text":"WiredMemoryTicket"}],"title":"WiredMemoryTicket","abstract":[{"type":"text","text":"A ticket representing a reservation of memory and concurrency slot."},{"type":"text","text":" "},{"type":"text","text":"When finished or deinitialized, it flushes the GPU memory cache and releases the slot."}],"role":"symbol","url":"\/documentation\/swiftpreprocessing\/wiredmemoryticket"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"type":"topic","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","title":"SwiftPreprocessing","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines."}],"