{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","metadata":{"role":"article","modules":[{"name":"SwiftDatabase"}],"title":"Relational Database Drivers & Zero-Copy SQL Ingestion","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"],"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"variants":[{"paths":["\/documentation\/swiftdatabase\/databaseconnectors"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into ","type":"text"},{"type":"codeVoice","code":"SwiftDataFrame"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiftDatabase","type":"codeVoice"},{"text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 ","type":"text"},{"code":"public actor","type":"codeVoice"},{"text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks.","type":"text"}]},{"type":"thematicBreak"},{"text":"🔒 Driver Architecture & Concurrency Model","anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model","type":"heading","level":2},{"syntax":null,"code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Actor Isolation:"}]},{"text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Streaming ","type":"text"},{"type":"codeVoice","code":"recv"},{"text":" Buffer:","type":"text"}]},{"type":"text","text":" Network drivers use a 64KB receive buffer reading continuously until "},{"type":"codeVoice","code":"ReadyForQuery ('Z')"},{"type":"text","text":" is received."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication:"}]},{"text":" Built-in support for Cleartext and MD5 password authentication via ","type":"text"},{"type":"codeVoice","code":"CommonCrypto"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"anchor":"1-Querying-SQLite-Databases","text":"1. Querying SQLite Databases","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SQLiteConnection"},{"text":" executes SQL statements through native ","type":"text"},{"type":"codeVoice","code":"sqlite3_prepare_v2"},{"text":" and directly streams result rows into columnar ","type":"text"},{"type":"codeVoice","code":"TypedColumn"},{"text":" buffers:","type":"text"}]},{"code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = try SQLiteConnection(path: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol"},{"type":"paragraph","inlineContent":[{"text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries (","type":"text"},{"type":"codeVoice","code":"libpq"},{"type":"text","text":"):"}]},{"type":"codeListing","code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = try PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    username: \"postgres\",","    password: \"secure_password\",","    useSSL: false",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","anchor":"3-High-Throughput-Bulk-Writeback-toSQL","level":2,"text":"3. High-Throughput Bulk Writeback (`toSQL`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bulk export in-memory "},{"code":"DataFrame","type":"codeVoice"},{"text":" objects back into database tables with configurable append or replace modes:","type":"text"}]},{"syntax":"swift","code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append or .replace","    batchSize: 500,","    failIfExists: false",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Concurrency Tip:","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"For multi-threaded web servers and asynchronous pipelines, initialize a pool of actor connections ("},{"code":"DatabasePool","type":"codeVoice"},{"type":"text","text":") to parallelize read workloads across multiple connections."}]}],"name":"Note","type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","abstract":[{"text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions.","type":"text"}],"kind":"article","url":"\/documentation\/swiftdatabase\/typesystem","type":"topic","role":"collectionGroup","title":"Database Type System & Value Representation"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","abstract":[{"text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback.","type":"text"}],"kind":"article","url":"\/documentation\/swiftdatabase\/highthroughputingestion","type":"topic","role":"collectionGroup","title":"Bulk SQL Ingestion & Database Wire Protocols"},"doc://SwiftDatabase/documentation/SwiftDatabase":{"kind":"symbol","title":"SwiftDatabase","type":"topic","abstract":[{"type":"text","text":"Relational Database Connectors to DataFrames."}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase","url":"\/documenta