{"kind":"symbol","sections":[],"metadata":{"role":"collection","externalID":"SwiftWorkflow","symbolKind":"module","title":"SwiftWorkflow","modules":[{"name":"SwiftWorkflow"}],"roleHeading":"Framework"},"topicSections":[{"identifiers":["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/PCAClassificationWorkflow"],"title":"Workflows","anchor":"Workflows"},{"identifiers":["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence"],"title":"Articles","anchor":"Articles"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"code":"SwiftWorkflow","type":"codeVoice"},{"type":"text","text":" provides immutable, production-grade pipelines that compose missing-value imputation, feature scaling, dimensionality reduction, and classification into single deployable units."}],"type":"paragraph"},{"type":"heading","text":"Key Capabilities","anchor":"Key-Capabilities","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Fitted End-to-End Pipeline"}],"type":"strong"},{"text":": ","type":"text"},{"code":"PCAClassificationWorkflow","type":"codeVoice"},{"text":" integrating mean imputation, standard scaling, SVD-based PCA projection, and binary logistic regression.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Strict Row Provenance"}],"type":"strong"},{"text":": ","type":"text"},{"code":"Predictions","type":"codeVoice"},{"text":" preserving ","type":"text"},{"code":"sourceRowIndices","type":"codeVoice"},{"text":" directly from the input ","type":"text"},{"code":"PreparedSupervisedBatch","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"PreparedNumericBatch","type":"codeVoice"},{"text":" across non-contiguous batch selections.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Training-Only Fitting"}],"type":"strong"},{"text":": Fitted state is computed solely on the designated training batch, preventing data leakage from test or validation sets.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Atomic JSON Serialization"}],"type":"strong"},{"text":": Lightweight, versioned JSON serialization (","type":"text"},{"code":"save(to:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"load(from:)","type":"codeVoice"},{"text":") enabling cross-process persistence and cold-start inference without retaining raw datasets.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Example Usage","anchor":"Example-Usage","level":3},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftDataFrame","import SwiftWorkflow","","\/\/ 1. Prepare supervised numeric batch","let batch = try rawDF.prepareNumericBatch([\"signal\", \"companion\", \"noise\", \"target\"])","let supervised = try PreparedSupervisedBatch(batch, targetColumn: \"target\")","","\/\/ 2. Train workflow strictly on training partition","let trainingBatch = try supervised.selectingRows([0, 1, 2, 4, 5])","let workflow = try await PCAClassificationWorkflow.train(","    training: trainingBatch,","    components: 2,","    learningRate: 0.125,","    epochs: 64",")","","\/\/ 3. Atomically persist to disk","let fileURL = URL(fileURLWithPath: \"model.json\")","try workflow.save(to: fileURL)","","\/\/ 4. Reload and predict with zero test leakage","let loadedWorkflow = try PCAClassificationWorkflow.load(from: fileURL)","let predictions = try await loadedWorkflow.predict(heldOutBatch.features)"]}]}],"abstract":[{"text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftworkflow"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow"},"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SwiftWorkflow/documentation/SwiftWorkflow/PCAClassificationWorkflow":{"identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/PCAClassificationWorkflow","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PCAClassificationWorkflow"}],"title":"PCAClassificationWorkflow","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A fitted CPU mean-imputation, standardization, PCA and binary logistic workflow."},{"type":"text","text":" "},{"type":"text","text":"Published instances expose no mutable stages. Saving never refits or reads prediction data."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PCAClassificationWorkflow"}],"url":"\/documentation\/swiftworkflow\/pcaclassificationworkflow"},"doc://SwiftWorkflow/documentation/SwiftWorkflow/WorkflowPersistence":{"identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence","title":"Deploying and Persisting Scientific Workflows","role":"article","kind":"article","abstract":[{"type":"text","text":"Learn how to safely persist, reload, and evaluate end-to-end machine learning workflows across processes."}],"type":"topic","url":"\/documentation\/swiftworkflow\/workflowpersistence"},"doc://SwiftWorkflow/documentation/SwiftWorkflow":{"identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow","title":"SwiftWorkflow","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization."}],"type":"topic","url":"\/documentation\/swiftworkflow"}}}