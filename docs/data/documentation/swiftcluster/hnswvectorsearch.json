{"variants":[{"paths":["\/documentation\/swiftcluster\/hnswvectorsearch"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","topicSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult"],"title":"Spatial Indexing","anchor":"Spatial-Indexing"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"},"abstract":[{"text":"Scale approximate nearest neighbor (ANN) retrieval logarithmically using Hierarchical Navigable Small World graphs.","type":"text"}],"sections":[],"metadata":{"modules":[{"name":"SwiftCluster"}],"role":"collectionGroup","title":"High-Dimensional Vector Search with HNSW","roleHeading":"API Collection"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"When vector collections expand beyond tens of thousands of items, exact (O(N)) linear scans become a major latency bottleneck for real-time recommendation and retrieval-augmented generation (RAG) systems.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"HNSWIndex","type":"codeVoice"},{"text":" actor provides a hierarchical graph-based spatial partitioning index with sub-millisecond query latency and logarithmic (O(\\log N)) search scaling.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Hierarchical Navigable Small World Architecture","type":"heading","anchor":"Hierarchical-Navigable-Small-World-Architecture"},{"inlineContent":[{"text":"HNSW constructs a hierarchy of graph layers:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Top Layers (Sparse)","type":"text"}],"type":"strong"},{"text":": Contain widely spaced long-range highway edges for rapid coarse geometric routing across distant clusters.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Intermediate Layers","type":"text"}],"type":"strong"},{"text":": Progressively decrease edge length while increasing vertex density.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Bottom Layer (Layer 0, Dense)","type":"text"}],"type":"strong"},{"text":": Contains all indexed vertices connected by dense short-range edges for high-accuracy localized nearest-neighbor refinement.","type":"text"}]}]}]},{"code":["Layer 2 (Express):   [A] ───────────────────────────► [F]","                      │                                │","                      ▼                                ▼","Layer 1 (Regional):  [A] ──────────► [C] ────────────► [F]","                      │               │                │","                      ▼               ▼                ▼","Layer 0 (Base):      [A] ──► [B] ──► [C] ──► [D] ──► [E] ──► [F]"],"type":"codeListing","syntax":null},{"level":2,"text":"Key Configuration Parameters","type":"heading","anchor":"Key-Configuration-Parameters"},{"alignments":["left","left","left"],"rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Recommended Default"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Impact on Search Quality & Index Build Time"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"M","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"16","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Maximum outgoing connections per node. Higher values improve recall at the cost of higher memory and index construction time."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"efConstruction","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"200","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Size of dynamic candidate evaluation queue during insertion. Larger values produce higher-quality graph connectivity."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"efSearch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"50","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Dynamic queue size during search traversal. Higher values increase search recall towards 100% exact match."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"metric","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Choice of "},{"code":".euclideanDistance","type":"codeVoice"},{"type":"text","text":", "},{"code":".cosineSimilarity","type":"codeVoice"},{"type":"text","text":", or "},{"code":".dotProduct","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"level":2,"text":"Example Usage","type":"heading","anchor":"Example-Usage"},{"code":["import SwiftCluster","","\/\/ 1. Initialize the actor-isolated index","let hnsw = HNSWIndex(metric: .cosineSimilarity, M: 16, efConstruction: 200, efSearch: 50)","","\/\/ 2. Add embeddings asynchronously","await hnsw.add(id: \"doc_news_1\", vector: [0.12, 0.94, -0.31], metadata: [\"category\": \"news\"])","await hnsw.add(id: \"doc_tech_2\", vector: [-0.85, 0.11, 0.52], metadata: [\"category\": \"technology\"])","","\/\/ 3. Query Top-K nearest neighbors","let queryEmbedding = [0.10, 0.90, -0.30]","let matches = await hnsw.search(query: queryEmbedding, topK: 5)","","for match in matches {","    print(\"Matched: \\(match.id) with score: \\(match.score)\")","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Thread Safety & Swift 6 Strict Concurrency","type":"heading","anchor":"Thread-Safety--Swift-6-Strict-Concurrency"},{"inlineContent":[{"code":"HNSWIndex","type":"codeVoice"},{"text":" is implemented as an isolated Swift ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":", guaranteeing thread safety and eliminating race conditions when multiple background tasks insert items or execute queries concurrently.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"],"title":"Guides & Tutorials","anchor":"Guides--Tutorials","generated":true}],"references":{"doc://SwiftCluster/documentation/SwiftCluster":{"role":"collection","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster","title":"SwiftCluster","kind":"symbol","abstract":[{"text":"PCA Dimensionality Reduction & Unsupervised Clustering.","type":"text"}],"url":"\/documentation\/swiftcluster"},"doc://SwiftCluster/documentation/SwiftCluster/ClusteringAndOutliers":{"kind":"article","abstract":[{"text":"High-performance clustering and density-based anomaly detection powered by ","type":"text"},{"code":"KDTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DBSCAN","type":"codeVoice"},{"text":", ","type":"text"},{"code":"KMeans","type":"codeVoice"},{"text":", ","type":"text"},{"code":"LocalOutlierFactor","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"IsolationForest","type":"codeVoice"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","url":"\/documentation\/swiftcluster\/clusteringandoutliers","title":"Spatial Indexing, Clustering & Outlier Detection","role":"article","type":"topic"},"doc://SwiftCluster/documentation/SwiftCluster/HNSWIndex":{"navigatorTitle":[{"kind":"identifier",