{"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"metadata":{"title":"Dense Local Text Embeddings & Zero-Shot Classification","modules":[{"name":"SwiftNLP"}],"role":"collectionGroup","roleHeading":"API Collection"},"abstract":[{"type":"text","text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon and perform zero-shot classification without model training."}],"topicSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"],"anchor":"Embedding-Engine-Types","title":"Embedding Engine Types"},{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotClassificationResult"],"anchor":"Zero-Shot-Classification","title":"Zero-Shot Classification"}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Modern Retrieval-Augmented Generation (RAG), semantic vector search, and automated data categorization require fast, high-quality vector representations of text. "},{"type":"codeVoice","code":"SwiftNLP"},{"type":"text","text":" provides a unified architecture via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider"},{"type":"text","text":", offering two distinct engine implementations:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine"}],"type":"strong"},{"text":": Native 512-dimensional contextual semantic embeddings powered by Apple Natural Language and Core ML foundation models with Accelerate $L_2$ unit normalization.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"}],"type":"strong"},{"text":": Deterministic, lightweight subword N-gram hashing projection producing customizable $D$-dimensional embeddings in microseconds with zero disk weight.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Both engines integrate seamlessly with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier"},{"type":"text","text":" for zero-shot text categorization and "},{"type":"reference","isActive":true,"identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftcluster\/vectorstore\/"},{"type":"text","text":" for real-time similarity search."}],"type":"paragraph"},{"type":"codeListing","syntax":"mermaid","code":["graph TD","    Text[Raw Text \/ Document] --> Provider[SentenceEmbeddingProvider]","    Provider --> Apple[AppleSentenceEmbeddingEngine: 512-D Core ML]","    Provider --> Hash[LocalEmbeddingEngine: Subword N-Gram Projection]","    Apple --> SIMDNorm[Accelerate vDSP L2 Unit Normalization]","    Hash --> SIMDNorm","    SIMDNorm --> NormalizedVec[Unit Vector: ||v|| = 1.0]","    NormalizedVec --> VectorStore[(SwiftCluster VectorStore \/ HNSW)]","    NormalizedVec --> ZeroShot[ZeroShotTextClassifier Softmax Probabilities]"]},{"type":"thematicBreak"},{"anchor":"1-Choosing-an-Embedding-Engine","text":"1. Choosing an Embedding Engine","level":2,"type":"heading"},{"header":"row","type":"table","alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Feature","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppleSentenceEmbeddingEngine"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalEmbeddingEngine"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Underlying Mechanism","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Apple Natural Language \/ Core ML","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Subword N-Gram Hashing (FNV-1a + Signs)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Embedding Dimension","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Fixed 512-D","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Configurable (e.g., 64, 128, 256, 512)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Weights on Disk","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"0 MB (pre-installed system foundation model)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"0 MB (algorithmic hash projection)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Semantic Awareness","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"High (contextual, synonym & paraphrase aware)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Lexical \/ Syntactic (spelling, morphology, keyword)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Typical Latency"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"~0.5 – 1.5 ms \/ text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"~0.05 – 0.15 ms \/ text","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Best Used For","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"RAG retrieval, zero-shot classification, semantic search"}]}],[{"type":"paragraph","inlineContent":[{"text":"High-throughput deduplication, fuzzy search, microcontrollers","type":"text"}]}]]]},{"type":"thematicBreak"},{"level":2,"text":"2. Using `AppleSentenceEmbeddingEngine`","anchor":"2-Using-AppleSentenceEmbeddingEngine","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","type":"reference","isActive":true},{"text":" leverages Apple Silicon’s Neural Engine to produce 512-dimensional contextual embeddings. All output vectors are automatically normalized to unit length ($|v|_2 = 1.0$) using Accelerate SIMD operations (","type":"text"},{"type":"codeVoice","code":"vDSP_svesqD"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"vDSP_vsdivD"},{"text":"):","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","\/\/ Initialize native Apple sentence embedder","let engine = AppleSentenceEmbeddingEngine()","","\/\/ Verify availability for current device and locale","guard engine.isAvailable(for: .english) else {","    fatalError(\"Apple sentence embedding model not available for English on this system.\")","}","","\/\/ Generate a 512-dimensional embedding","let embedding = try await engine.embed(\"Retrieval-Augmented Generation with SwiftSci\")","print(\"Vector length: \\(embedding.count)\") \/\/ 512","","\/\/ Batch asynchronous embedding generation","let documents = [","    \"Apple Accelerate provides vectorized SIMD routines.\",","    \"Metal Performance Shaders accelerate tensor operations.\",","    \"SwiftData provides declarative SQLite persistence.\"","]","let batchVectors = try await engine.embedBatch(documents)"]},{"type":"thematicBreak"},{"anchor":"3-Using-LocalEmbeddingEngine","text":"3. Using `LocalEmbeddingEngine`","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"For memory-constrained environments or extreme throughput requirements, "},{"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","isActive":true},{"type":"text","text":" computes embeddings via subword character n-gram projections without model weights:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","\/\/ Initialize with custom dimensionality (default: 128)","let fastEngine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Synchronous and asynchronous embedding","let vector = fastEngine.embed(\"Fast in-memory hashing projection\")","let batch = try await fastEngine.embedBatch([\"Document A\", \"Document B\"])"]},{"type":"thematicBreak"},{"anchor":"4-Measuring-Semantic-Similarity","text":"4. Measuring Semantic Similarity","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Because all embeddings produced by "},{"type":"codeVoice","code":"SentenceEmbeddingProvider"},{"type":"text","text":" are unit-normalized, the "},{"type":"strong","inlineContent":[{"text":"Cosine Similarity","type":"text"}]},{"type":"text","text":" between two vectors $u$ and $v$ is mathematically identical to their direct "},{"type":"strong","inlineContent":[{"text":"Dot Product","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"$$\\text{CosineSimilarity}(u, v) = \\frac{u \\cdot v}{|u|_2 |v|_2} = u \\cdot v$$"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Calculate cosine similarity at native memory speeds using Apple Accelerate:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Accelerate","","func cosineSimilarity(_ a: [Double], _ b: [Double]) -> Double {","    guard a.count == b.count, !a.isEmpty else { return 0.0 }","    var dot: Double = 0.0","    vDSP_dotprD(a, 1, b, 1, &dot, vDSP_Length(a.count))","    return dot","}","","let queryVec = try await engine.embed(\"Vector mathematics on Mac\")","let docVec = try await engine.embed(\"Apple Accelerate linear algebra\")","let similarity = cosineSimilarity(queryVec, docVec)","print(\"Semantic similarity score: \\(similarity)\")"]},{"type":"thematicBreak"},{"anchor":"5-Zero-Shot-Text-Classification","text":"5. Zero-Shot Text Classification","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Classify arbitrary text documents into dynamic candidate categories on the fly without training a classifier or labeling training sets:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","\/\/ Initialize classifier with Apple embeddings","let classifier = ZeroShotTextClassifier(","    embeddingEngine: AppleSentenceEmbeddingEngine(),","    hypothesisTemplate: \"This text is about {}.\"",")","","\/\/ Single-label classification (Softmax distribution)","let result = try await classifier.classify(","    text: \"The patient presented with elevated systolic pressure and sinus tachycardia.\",","    candidateLabels: [\"Cardiology\", \"Astronomy\", \"Sports\", \"Politics\"],","    multiLabel: false",")","","print(\"Top label: \\(result.topLabel ?? \"\") (confidence: \\(result.topScore))\")","for (label, score) in result.scores {","    print(\"  • \\(label): \\(String(format: \"%.3f\", score))\")","}"]},{"anchor":"Multi-Label-Classification","text":"Multi-Label Classification","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"For documents that can belong to multiple categories simultaneously, set "},{"type":"codeVoice","code":"multiLabel: true"},{"type":"text","text":" to compute independent sigmoid activations:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let multiResult = try await classifier.classify(","    text: \"Quarterly corporate earnings and federal interest rate decisions.\",","    candidateLabels: [\"Finance\", \"Government\", \"Culinary\", \"Gaming\"],","    multiLabel: true",")"]},{"type":"thematicBreak"},{"anchor":"6-DataFrame-Zero-Shot-Categorization","text":"6. DataFrame Zero-Shot Categorization","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Classify entire columns of tabular data directly within a "},{"type":"reference","identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","isActive":true},{"type":"text","text":" using "},{"type":"codeVoice","code":"zeroShotClassify"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftDataFrame","import SwiftNLP","","var feedbackDF = DataFrame(columns: [","    TypedColumn(name: \"FeedbackID\", values: [1, 2, 3]),","    TypedColumn(name: \"ReviewText\", values: [","        \"The app crashed when opening the PDF export screen.\",","        \"Monthly subscription pricing is too expensive.\",","        \"Smooth navigation and beautiful dark mode aesthetics.\"","    ])","])","","\/\/ Classify ReviewText column into sentiment and topic categories","let classifiedDF = try await feedbackDF.zeroShotClassify(","    textColumn: \"ReviewText\",","    candidateLabels: [\"Bug Report\", \"Pricing\", \"User Interface\"],","    outputColumn: \"Category\"",")","","print(classifiedDF.summary())"]},{"type":"thematicBreak"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/denselocalembeddings"]}],"kind":"article","references":{"doc://SwiftNLP/documentation/SwiftNLP/AppleSentenceEmbeddingEngine":{"role":"symbol","url":"\/documentation\/swiftnlp\/applesentenceembeddingengine","title":"AppleSentenceEmbeddingEngine","kind":"symbol","abstract":[{"text":"A sentence embedding generator powered by Apple’s native pre-trained ","type":"text"},{"code":"NLEmbedding","type":"codeVoice"},{"text":" models.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AppleSentenceEmbeddingEngine","kind":"identifier"}],"navigatorTitle":[{"text":"AppleSentenceEmbeddingEngine","kind":"identifier"}]},"doc://SwiftNLP/documentation/SwiftNLP":{"type":"topic","title":"SwiftNLP","url":"\/documentation\/swiftnlp","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","kind":"symbol","role":"collection"},"https://nodibell.github.io/SwiftSci/documentation/swiftcluster/vectorstore/":{"identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftcluster\/vectorstore\/","title":"SwiftCluster.VectorStore","titleInlineContent":[{"type":"codeVoice","code":"SwiftCluster.VectorStore"}],"url":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftcluster\/vectorstore\/","type":"link"},"doc://SwiftNLP/documentation/SwiftNLP/ZeroShotTextClassifier":{"abstract":[{"text":"A zero-shot text classifier that categorizes text into arbitrary classes without task-specific training.","type":"text"}],"type":"topic","title":"ZeroShotTextClassifier","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","url":"\/documentation\/swiftnlp\/zeroshottextclassifier","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZeroShotTextClassifier","kind":"identifier"}],"navigatorTitle":[{"text":"ZeroShotTextClassifier","kind":"identifier"}],"kind":"symbol"},"https://nodibell.github.io/SwiftSci/documentation/swiftdataframe/":{"identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","title":"SwiftDataFrame","titleInlineContent":[{"type":"codeVoice","code":"SwiftDataFrame"}],"url":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","type":"link"},"doc://SwiftNLP/documentation/SwiftNLP/SentenceEmbeddingProvider":{"role":"symbol","url":"\/documentation\/swiftnlp\/sentenceembeddingprovider","title":"SentenceEmbeddingProvider","kind":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider","abstract":[{"type":"text","text":"A protocol representing a local or model-based sentence embedding generator."}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SentenceEmbeddingProvider","kind":"identifier"}],"navigatorTitle":[{"text":"SentenceEmbeddingProvider","kind":"identifier"}]},"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","url":"\/documentation\/swiftnlp\/localembeddingengine","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LocalEmbeddingEngine","kind":"identifier"}],"type":"topic","title":"LocalEmbeddingEngine","kind":"symbol","navigatorTitle":[{"text":"LocalEmbeddingEngine","kind":"identifier"}],"abstract":[{"type":"text","text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon."}]},"doc://SwiftNLP/documentation/SwiftNLP/ZeroShotClassificationResult":{"navigatorTitle":[{"text":"ZeroShotClassificationResult","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZeroShotClassificationResult","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/swiftnlp\/zeroshotclassificationresult","kind":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotClassificationResult","title":"ZeroShotClassificationResult","abstract":[{"text":"The output of a zero-shot text classification inference.","type":"text"}]}}}