{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"topicSections":[{"anchor":"Core-Inference-Components","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/PagedKVCache","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMConfig","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/RoPEEmbedding"],"title":"Core Inference Components"},{"anchor":"Sampling--Decoding","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies"],"title":"Sampling & Decoding"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"type":"text","text":" implements modern decoder-only causal transformer architectures (such as Llama 3, Mistral, and Gemma) leveraging MLX unified memory acceleration on Apple Silicon GPUs. Inference is divided into two distinct computational phases:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Prompt Prefill Phase ("},{"code":"isPrefill: true","type":"codeVoice"},{"type":"text","text":")"}]},{"text":": Processes all initial prompt tokens in parallel, computing attention matrices and populating the key-value cache across all transformer layers.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Incremental Decoding Phase ("},{"code":"isPrefill: false","type":"codeVoice"},{"type":"text","text":")"}]},{"text":": Processes a single token per step, computing query projections and attending over the accumulated key-value history in $O(1)$ step time.","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"level":2,"text":"1. Two-Stage Generation Loop","type":"heading","anchor":"1-Two-Stage-Generation-Loop"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following complete example demonstrates configuring a model, prefilling the KV-cache, and executing an autoregressive generation loop:"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftLLM","import MLX","","\/\/ 1. Initialize configuration and decoder","let config = LLMConfig.llama3_8B","let decoder = TransformerDecoder(config: config)","let cache = KVCache(config: config)","","\/\/ Tokenized prompt sequence","let promptTokens: [Int] = [128000, 791, 7453, 374]","var generatedTokens = promptTokens","let maxNewTokens = 64","","\/\/ 2. Stage 1: Prefill prompt tokens into KV-cache","let promptLogits = try decoder.forward(","    tokens: promptTokens,","    cache: cache,","    isPrefill: true",")","","\/\/ 3. Configure sampling parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","\/\/ 4. Sample first generated token from prefill logits","var currentToken = Sampler.sample(","    logits: promptLogits,","    config: sampling,","    pastTokens: generatedTokens",")","generatedTokens.append(currentToken)","","\/\/ 5. Stage 2: Incremental single-token decoding loop","for _ in 1..<maxNewTokens {","    \/\/ Forward single token with isPrefill: false","    let stepLogits = try decoder.forward(","        tokens: [currentToken],","        cache: cache,","        isPrefill: false","    )","    ","    \/\/ Sample next token ID","    let nextToken = Sampler.sample(","        logits: stepLogits,","        config: sampling,","        pastTokens: generatedTokens","    )","    ","    generatedTokens.append(nextToken)","    currentToken = nextToken","    ","    \/\/ Check for EOS (End of Sequence) tokens","    if nextToken == 128001 || nextToken == 128009 {","        break","    }","}","","print(\"Generated total sequence: \\(generatedTokens.count) tokens.\")"]},{"type":"thematicBreak"},{"level":2,"text":"2. Rotary Position Embeddings (RoPE) During Incremental Decoding","type":"heading","anchor":"2-Rotary-Position-Embeddings-RoPE-During-Incremental-Decoding"},{"type":"paragraph","inlineContent":[{"type":"text","text":"During single-token decoding ("},{"code":"isPrefill: false","type":"codeVoice"},{"type":"text","text":"), position frequencies must match the actual sequential position in the generated sequence rather than index "},{"code":"0","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"RoPEEmbedding","type":"codeVoice"},{"type":"text","text":" tracks this via the "},{"code":"positionOffset","type":"codeVoice"},{"type":"text","text":" parameter:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Internal RoPE position calculation:","\/\/ position = positionOffset + tokenIndex","let rotatedQ = rope.apply(x: query, positionOffset: cache.currentLength)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because "},{"code":"KVCache","type":"codeVoice"},{"type":"text","text":" dynamically tracks "},{"code":"currentLength","type":"codeVoice"},{"type":"text","text":", positions increment faithfully from the end of the prefill boundary through every subsequent token generation step."}]},{"type":"thematicBreak"},{"level":2,"text":"3. High-Level Streaming API","type":"heading","anchor":"3-High-Level-Streaming-API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For streaming applications, "},{"code":"LLMModel","type":"codeVoice"},{"type":"text","text":" wraps the decoder and cache lifecycle into an asynchronous sequence:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftLLM","","let options = LLMOptions(","    maxTokens: 128,","    sampling: SamplingConfiguration(temperature: 0.7, topK: 40, topP: 0.9)",")","","for try await token in model.generateStream(prompt: \"Explain rotary embeddings:\", options: options) {","    print(token, terminator: \"\")","}"]},{"type":"thematicBreak"}]}],"kind":"article","identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Execute two-stage autoregressive generation with full prompt prefill and incremental single-token decoding using Apple Silicon KV-caching.","type":"text"}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"title":"Guides & Tutorials","generated":true}],"metadata":{"modules":[{"name":"SwiftLLM"}],"title":"Autoregressive Transformer Decoder Inference","role":"collectionGroup","roleHeading":"API Collection"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/transformerdecoderinference"]}],"references":{"doc://SwiftLLM/documentation/SwiftLLM/PagedKVCache":{"navigatorTitle":[{"text":"PagedKVCache","kind":"identifier"}],"type":"topic","title":"PagedKVCache","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PagedKVCache","kind":"identifier"}],"abstract":[{"text":"A dynamic paged Key-Value attention cache allocator for high-throughput batch and stream inference.","type":"text"}],"kind":"symbol","url":"\/documentation\/swiftllm\/pagedkvcache","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/PagedKVCache","role":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/RoPEEmbedding":{"type":"topic","abstract":[{"text":"Rotary Positional Embedding (RoPE) applying frequency-based rotations to query and key tensors.","type":"text"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/RoPEEmbedding","url":"\/documentation\/swiftllm\/ropeembedding","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RoPEEmbedding","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"RoPEEmbedding","kind":"identifier"}],"role":"symbol","title":"RoPEEmbedding"},"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","type":"topic","kind":"article","title":"GGUF\/SafeTensors Parsing & Sampling","url":"\/documentation\/swiftllm\/weightparsingandsampling","abstract":[{"type":"text","text":"Parse GGUF and SafeTensors model weights zero-copy into Apple Silicon unified memory and sample tokens with fine-grained logits controls."}],"role":"collectionGroup"},"doc://SwiftLLM/documentation/SwiftLLM":{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","type":"topic","role":"collection","abstract":[{"text":"Local Causal Transformer Decoder & Weight Parsers.","type":"text"}],"url":"\/documentation\/swiftllm","kind":"symbol","title":"SwiftLLM"},"doc://SwiftLLM/documentation/SwiftLLM/MetalShadersQuantization":{"url":"\/documentation\/swiftllm\/metalshadersquantization","role":"collectionGroup","type":"topic","kind":"article","abstract":[{"text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU.","type":"text"}],"title":"Native Metal MSL Shaders for Quantized LLMs","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoder":{"title":"TransformerDecoder","kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","navigatorTitle":[{"kind":"identifier","text":"TransformerDecoder"}],"url":"\/do