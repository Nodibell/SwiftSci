{"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Audit-Types","title":"Audit Types"}],"variants":[{"paths":["\/documentation\/swiftagent\/datalineageaudit"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents.","type":"text"}],"metadata":{"modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Data Lineage & Transformation Audit Trails"},"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftAgentEvaluator"},{"type":"text","text":" automatically generates an immutable audit trail of "},{"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true},{"type":"text","text":" entries for each command evaluated."}]},{"text":"LineageRecord Structure","anchor":"LineageRecord-Structure","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true},{"type":"text","text":" contains:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"stepIndex","type":"codeVoice"},{"text":": Sequential index of the step within the agent trajectory.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"operation","type":"codeVoice"},{"text":": The normalized DSL command executed (e.g., ","type":"text"},{"code":"filter(age)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"groupBy(category,mean)","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"inputRows","type":"codeVoice"},{"text":": Dataset row count immediately prior to transformation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"outputRows","type":"codeVoice"},{"text":": Dataset row count produced by the transformation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"},{"text":": The exact timestamp of execution.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Example: Accessing Audit Trails","anchor":"Example-Accessing-Audit-Trails","type":"heading","level":2},{"syntax":"swift","code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","kind":"symbol","url":"\/documentation\/swiftagent\/lineagerecord","title":"LineageRecord","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text