{"topicSections":[{"title":"Audit Types","anchor":"Audit-Types","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"]}],"abstract":[{"text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents.","type":"text"}],"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/datalineageaudit"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"type":"text","text":" automatically generates an immutable audit trail of "},{"isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","type":"reference"},{"type":"text","text":" entries for each command evaluated."}],"type":"paragraph"},{"anchor":"LineageRecord-Structure","text":"LineageRecord Structure","level":2,"type":"heading"},{"inlineContent":[{"text":"Each ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true,"type":"reference"},{"text":" contains:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"stepIndex","type":"codeVoice"},{"type":"text","text":": Sequential index of the step within the agent trajectory."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"operation"},{"text":": The normalized DSL command executed (e.g., ","type":"text"},{"type":"codeVoice","code":"filter(age)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"groupBy(category,mean)"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"inputRows","type":"codeVoice"},{"type":"text","text":": Dataset row count immediately prior to transformation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"outputRows"},{"text":": Dataset row count produced by the transformation.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"timestamp","type":"codeVoice"},{"text":": The exact timestamp of execution.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Example: Accessing Audit Trails","anchor":"Example-Accessing-Audit-Trails","type":"heading"},{"code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"syntax":"swift","type":"codeListing"}]}],"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"API Collection","title":"Data Lineage & Transformation Audit Trails","role":"collectionGroup","modules":[{"name":"SwiftAgent"}]},"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"type":"topic","title":"SwiftAgent","role":"collection","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","kind":"symbol","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"url":"\/documentation\/swiftagent