{"abstract":[{"text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native ","type":"text"},{"code":"NaturalLanguage","type":"codeVoice"},{"text":" framework.","type":"text"}],"metadata":{"modules":[{"name":"SwiftNLP"}],"roleHeading":"Article","title":"Text Normalization, Tokenization & Linguistic Tagging","role":"article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}]},{"level":3,"text":"1. Multi-lingual Word & Sentence Tokenization","type":"heading","anchor":"1-Multi-lingual-Word--Sentence-Tokenization"},{"code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"2. POS Tagging, Lemmatization & Entity Extraction","type":"heading","anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction"},{"code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"3. Sentiment Analysis (VADER & NLSentiment)","type":"heading","anchor":"3-Sentiment-Analysis-VADER--NLSentiment"},{"code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"syntax":"swift","type":"codeListing"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization"},"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"abstract":[{"type":"text","text":"Convert text corpora into numerical and sparse feature matrices using "},{"type":"codeVoice","code":"TFIDFVectorizer"},{"type":"text","text":", "},{"type":"codeVoice","code":"CountVectorizer"},{"type":"text","text":", "},{"type":"codeVoice","code":"HashingVectorizer"},{"type":"text","text":", "},{"type":"codeVoice","code":"SparseVector"},{"type":"text","text":", and "},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"type":"text","text":"."}],"type":"topic","kind":"article","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","url":"\/documentation\/swiftnlp\/vectorizationandembeddings","title":"Text Feature Vectorization, Sparse TF-IDF & Local Embeddings","role":"article"},"doc://SwiftNLP/documentation/SwiftNLP":{"abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"url":"\/documentation\/swiftnlp","role":"collection","title":"SwiftNLP","kind":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","type":"topic"}}}