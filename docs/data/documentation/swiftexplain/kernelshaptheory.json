{"metadata":{"modules":[{"name":"SwiftExplain"}],"role":"collectionGroup","title":"Game-Theoretic Interpretability with Kernel SHAP","roleHeading":"API Collection"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SHAP (SHapley Additive exPlanations)"}]},{"type":"text","text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory."}]},{"type":"heading","text":"1. The Four Shapley Axioms","anchor":"1-The-Four-Shapley-Axioms","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Efficiency","type":"text"}],"type":"strong"},{"text":": Feature attributions sum up to the difference between model prediction ","type":"text"},{"code":"f(x)","type":"codeVoice"},{"text":" and expected background prediction ","type":"text"},{"code":"E[f(X)]","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"code":"Σ_i=1..M φ_i = f(x) - E[f(X)]","type":"codeVoice"}]}],"name":"Note"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Symmetry"}]},{"type":"text","text":": If two features contribute equally to all possible feature subsets, their attributions are equal."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Dummy (Null Player)"}],"type":"strong"},{"type":"text","text":": A feature that does not change the model prediction for any coalition receives an attribution of zero ("},{"code":"φ_i = 0","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Additivity","type":"text"}],"type":"strong"},{"text":": For ensemble models ","type":"text"},{"code":"f = f1 + f2","type":"codeVoice"},{"text":", attributions satisfy ","type":"text"},{"code":"φ_i(f) = φ_i(f1) + φ_i(f2)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"anchor":"2-Explaining-Predictions-in-SwiftSci","level":2,"type":"heading","text":"2. Explaining Predictions in SwiftSci"},{"syntax":"swift","type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory"},"abstract":[{"type":"text","text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model."}],"variants":[{"paths":["\/documentation\/swiftexplain\/kernelshaptheory"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","topicSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"title":"SHAP Explainer APIs","anchor":"SHAP-Explainer-APIs"}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"sections":[],"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"title":"KernelSHAP","kind":"symbol","role":"symbol","url":"\/documentation\/swiftexplain\/kernelshap","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KernelSHAP"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}],"type":"topic"},"doc://SwiftExplain/documentation/SwiftExplain":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","url":"\/documentation\/swiftexplain","kind":"symbol","title":"SwiftExplain","type":"topic","role":"collection","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}]}}}