{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGAndContextAugmentation"},"kind":"article","metadata":{"roleHeading":"API Collection","title":"Building On-Device RAG Pipelines","modules":[{"name":"SwiftAgent"}],"role":"collectionGroup"},"abstract":[{"type":"text","text":"Construct privacy-preserving Retrieval-Augmented Generation workflows and autonomous knowledge agents on Apple Silicon."}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/ragandcontextaugmentation"]}],"sections":[],"topicSections":[{"anchor":"Agent-Components","title":"Agent Components","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMemory","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SemanticVectorMemory","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SlidingWindowMemory","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/ReActAgent"]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"On-Device Retrieval-Augmented Generation (RAG) combines local vector similarity search with on-device large language models (LLMs) to answer questions grounded in private documents. By running the entire pipeline locally, user data never leaves the device, network latency is eliminated, and cloud API expenses are removed.","type":"text"}],"type":"paragraph"},{"syntax":"mermaid","type":"codeListing","code":["graph TD","    subgraph Ingestion[\"1. Knowledge Ingestion & Indexing\"]","        RawDocs[Private Documents \/ PDFs \/ Notes] --> Chunker[SentenceTokenizer & Chunking]","        Chunker --> Chunks[Text Chunks with Metadata]","        Chunks --> Embedder[AppleSentenceEmbeddingEngine]","        Embedder --> Vectors[512-D L2 Normalized Vectors]","        Vectors --> VStore[(SwiftCluster VectorStore)]","    end","","    subgraph Retrieval[\"2. Query & Context Retrieval\"]","        UserQ[User Question] --> QEmbed[Embed Query]","        QEmbed --> QVec[Query Vector]","        QVec --> TopK[SIMD Accelerate Top-K Search]","        VStore --> TopK","        TopK --> RelevantChunks[Top Relevant Context Chunks]","    end","","    subgraph Generation[\"3. Augmentation & LLM Generation\"]","        RelevantChunks --> PromptBuilder[ChatTemplate Prompt Formatter]","        UserQ --> PromptBuilder","        PromptBuilder --> AugmentedPrompt[Augmented System + User Prompt]","        AugmentedPrompt --> LLM[SwiftLLM Metal TransformerDecoder]","        LLM --> GroundedAnswer[Grounded, Private Answer]","    end"]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"1-Document-Chunking--Preprocessing","text":"1. Document Chunking & Preprocessing"},{"inlineContent":[{"type":"text","text":"Effective retrieval depends on breaking large texts into concise, semantically coherent passages. "},{"type":"codeVoice","code":"SwiftNLP"},{"type":"text","text":" provides tokenizers to chunk documents without splitting sentences mid-thought:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftNLP","","let document = \"\"\"","SwiftSci is an accelerated scientific computing suite for Apple Silicon.","It provides high-performance modules for data frames, machine learning, clustering, and NLP.","The SwiftForecast module implements classical time series forecasting including ARIMA, ETS, and WAPE evaluation.","The SwiftLLM module enables on-device transformer inference using Metal and unified memory.","\"\"\"","","\/\/ 1. Split document into clean sentences","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: document)","","\/\/ 2. Group sentences into overlapping chunks (e.g. 2 sentences per chunk with 1 sentence overlap)","var chunks: [(id: String, text: String)] = []","let chunkSize = 2","let overlap = 1","","var index = 0","var chunkId = 0","while index < sentences.count {","    let endIndex = min(index + chunkSize, sentences.count)","    let chunkText = sentences[index..<endIndex].joined(separator: \" \")","    chunks.append((id: \"chunk_\\(chunkId)\", text: chunkText))","    chunkId += 1","    index += (chunkSize - overlap)","}","","print(\"Created \\(chunks.count) overlapping text chunks.\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"2-Choosing-an-Embedding-Strategy","text":"2. Choosing an Embedding Strategy"},{"inlineContent":[{"type":"codeVoice","code":"SwiftNLP"},{"type":"text","text":" provides two built-in embedding engines conforming to "},{"code":"SentenceEmbeddingProvider","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ Strategy A: Native Apple Neural Embeddings (512-D, High Semantic Accuracy)","let appleEngine = try AppleSentenceEmbeddingEngine(language: .english)","","\/\/ Strategy B: Lightweight Offline Subword Hashing (128-D, Ultra-Low Latency)","let localEngine = LocalEmbeddingEngine(dimension: 128)"],"syntax":"swift","type":"codeListing"},{"alignments":["left","center","center","left"],"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Engine"}]}],[{"inlineContent":[{"text":"Dimension","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependencies"}]}],[{"inlineContent":[{"type":"text","text":"Best For"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"code":"AppleSentenceEmbeddingEngine","type":"codeVoice"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"512","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Native Apple "},{"type":"codeVoice","code":"NLEmbedding"}]}],[{"inlineContent":[{"text":"High-fidelity conceptual matching, complex sentence semantics.","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"LocalEmbeddingEngine","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"128–512"}]}],[{"inlineContent":[{"text":"Zero (Pure Swift & SIMD)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Micro-memory environments, instant token\/keyword hashing."}],"type":"paragraph"}]]]},{"type":"thematicBreak"},{"type":"heading","text":"3. Ingesting Chunks into VectorStore","level":2,"anchor":"3-Ingesting-Chunks-into-VectorStore"},{"inlineContent":[{"type":"text","text":"Store the generated embeddings alongside chunk text and metadata into "},{"type":"codeVoice","code":"SwiftCluster.VectorStore"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiftCluster","","let vectorStore = VectorStore(metric: .cosineSimilarity)","","\/\/ Generate embeddings in batch and index","for chunk in chunks {","    let embedding = try appleEngine.embed(chunk.text)","    vectorStore.add(","        id: chunk.id,","        vector: embedding,","        metadata: [","            \"text\": chunk.text,","            \"document\": \"SwiftSci_Architecture.md\"","        ]","    )","}","","print(\"Indexed \\(vectorStore.count) chunks into VectorStore.\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","text":"4. Retrieving Context with Score Thresholding","anchor":"4-Retrieving-Context-with-Score-Thresholding","level":2},{"type":"paragraph","inlineContent":[{"text":"When a user submits a query, embed the question and query the vector store. Apply a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"minimum similarity threshold"}]},{"type":"text","text":" (e.g. "},{"code":"0.65","type":"codeVoice"},{"text":") to filter out irrelevant passages:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let userQuery = \"Which module handles time series forecasting?\"","let queryVector = try appleEngine.embed(userQuery)","","\/\/ Search for Top-2 nearest chunks","let searchResults = vectorStore.search(query: queryVector, topK: 2)","","\/\/ Filter by relevance threshold","let similarityThreshold = 0.65","let relevantMatches = searchResults.filter { $0.score >= similarityThreshold }","","let retrievedContext: String","if relevantMatches.isEmpty {","    retrievedContext = \"No sufficiently relevant documentation found.\"","} else {","    retrievedContext = relevantMatches.enumerated().map { idx, match in","        \"[\\(idx + 1)] \\(match.metadata[\"text\"] ?? \"\")\"","    }.joined(separator: \"\\n\\n\")","}","","print(\"Retrieved Context:\\n\\(retrievedContext)\")"]},{"type":"thematicBreak"},{"anchor":"5-Assembling-the-Augmented-Prompt-with-ChatTemplate","level":2,"type":"heading","text":"5. Assembling the Augmented Prompt with ChatTemplate"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"SwiftNLP.ChatTemplate"},{"text":" to format the prompt according to your local model’s specific chat schema (such as Llama 3 or Mistral), enforcing strict grounding rules to eliminate hallucinations:","type":"text"}],"type":"paragraph"},{"code":["import SwiftNLP","","let systemInstruction = \"\"\"","You are a factual, private documentation assistant.","Answer the user's question strictly and exclusively based on the Context provided below.","If the answer cannot be determined from the Context, state clearly: \"I cannot find this information in the provided document.\"","Never hallucinate or assume facts not present in the Context.","\"\"\"","","let userPrompt = \"\"\"","Context:","\\(retrievedContext)","","Question:","\\(userQuery)","\"\"\"","","\/\/ Format prompt using Llama 3 instruct template","let template = ChatTemplate(format: .llama3)","let formattedPrompt = template.render(","    systemPrompt: systemInstruction,","    userPrompt: userPrompt",")","","print(\"Formatted LLM Prompt:\\n\\(formattedPrompt)\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"6. On-Device Generation with SwiftLLM","anchor":"6-On-Device-Generation-with-SwiftLLM","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Feed the formatted prompt into ","type":"text"},{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"TransformerDecoder"},{"text":" for Metal-accelerated inference with KV-cache reuse:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftLLM","","\/\/ Initialize local model decoder (e.g. Llama 3 8B or Mistral 7B)","\/\/ let decoder = try TransformerDecoder(checkpointPath: modelURL)","\/\/ let responseStream = try await decoder.generate(prompt: formattedPrompt, maxTokens: 256)","\/\/ for await token in responseStream {","\/\/     print(token, terminator: \"\")","\/\/ }"]},{"type":"thematicBreak"},{"anchor":"7-Agentic-RAG-with-SemanticVectorMemory--ReActAgent","text":"7. Agentic RAG with SemanticVectorMemory & ReActAgent","type":"heading","level":2},{"inlineContent":[{"text":"Rather than performing a single static retrieval step, autonomous agents built with ","type":"text"},{"type":"codeVoice","code":"SwiftAgent"},{"text":" can use ","type":"text"},{"type":"codeVoice","code":"SemanticVectorMemory"},{"text":" (backed by ","type":"text"},{"code":"HNSWIndex","type":"codeVoice"},{"type":"text","text":") or call "},{"code":"VectorStore","type":"codeVoice"},{"type":"text","text":" as an explicit tool:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftAgent","import SwiftCluster","","\/\/ Define a Knowledge Search Tool for the ReActAgent","let knowledgeSearchTool = AgentToolV2(","    name: \"search_knowledge_base\",","    description: \"Searches private documentation for relevant information matching a query.\",","    parameters: [","        AgentParameter(name: \"query\", type: .string, description: \"The search query keywords.\")","    ]",") { params in","    guard let query = params[\"query\"] as? String else {","        return \"Error: missing query parameter.\"","    }","    let queryVec = try appleEngine.embed(query)","    let hits = vectorStore.search(query: queryVec, topK: 2)","    return hits.map { $0.metadata[\"text\"] ?? \"\" }.joined(separator: \"\\n---\\n\")","}","","\/\/ Ingest long-term semantic conversation memory","let memory = SemanticVectorMemory(metric: .cosineSimilarity) { text in","    try await appleEngine.embed(text)","}","","try await memory.record(","    content: \"User inquired about SwiftForecast ARIMA models on October 15.\",","    role: \"system\",","    metadata: [\"topic\": \"forecasting\"]",")"]},{"type":"thematicBreak"},{"text":"8. Tabular Dataset RAG with RAGContextGenerator","type":"heading","level":2,"anchor":"8-Tabular-Dataset-RAG-with-RAGContextGenerator"},{"type":"paragraph","inlineContent":[{"text":"When an AI agent needs to analyze or answer questions regarding tabular datasets (","type":"text"},{"code":"DataFrame","type":"codeVoice"},{"text":"), use ","type":"text"},{"code":"RAGContextGenerator","type":"codeVoice"},{"text":" to create token-efficient Markdown summaries containing column schemas, row counts, and structural dimensions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftDataFrame","import SwiftAgent","","let df = try DataFrame(columns: [","    TypedColumn(name: \"Product\", values: [\"Widget A\", \"Widget B\", \"Widget C\"]),","    TypedColumn(name: \"Price\", values: [19.99, 29.99, 49.99]),","    TypedColumn(name: \"Stock\", values: [100, 45, 12])","])","","let generator = RAGContextGenerator()","let datasetSummary = generator.generateSummary(df: df, name: \"InventoryDataset\")","","print(\"RAG Prompt Context:\\n\\(datasetSummary)\")","\/\/ Output:","\/\/ ## InventoryDataset Profile","\/\/ - Rows: 3, Columns: 3","\/\/ - Columns: Product, Price, Stock"]},{"type":"thematicBreak"}],"kind":"content"}],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","title":"SwiftAgent","kind":"symbol","role":"collection","url":"\/documentation\/swiftagent","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"type":"topic"},"doc://SwiftAgent/documentation/SwiftAgent/SemanticVectorMemory":{"navigatorTitle":[{"text":"SemanticVectorMemory","kind":"identifier"}],"abstract":[{"text":"A long-term semantic memory store backed by a Hierarchical Navigable Small World (","type":"text"},{"code":"HNSWIndex","type":"codeVoice"},{"text":") graph.","type":"text"}],"url":"\/documentation\/swiftagent\/semanticvectormemory","title":"SemanticVectorMemory","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SemanticVectorMemory"}],"role":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SemanticVectorMemory","kind":"symbol"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"navigatorTitle":[{"text":"SwiftAgentEvaluator","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiftAgentEvaluator"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","title":"SwiftAgentEvaluator","url":"\/documentation\/swiftagent\/swiftagentevaluator","abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"type":"topic","kind":"symbol","role":"symbol"},"doc://SwiftAgent/documentation/SwiftAgent/ReActAgent":{"navigatorTitle":[{"text":"ReActAgent","kind":"identifier"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/ReActAgent","kind":"symbol","abstract":[{"text":"Autonomous ReAct (Reasoning + Acting) Agent executing multi-step decision loops over tool pipelines.","type":"text"}],"type":"topic","role":"symbol","title":"ReActAgent","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"ReActAgent"}],"url":"\/documentation\/swiftagent\/reactagent"},"doc://SwiftAgent/documentation/SwiftAgent/SlidingWindowMemory":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SlidingWindowMemory","url":"\/documentation\/swiftagent\/slidingwindowmemory","role":"symbol","abstract":[{"text":"A short-term memory store retaining a sliding window of the most recent agent interactions.","type":"text"}],"title":"SlidingWindowMemory","navigatorTitle":[{"text":"SlidingWindowMemory","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SlidingWindowMemory","kind":"identifier"}]},"doc://SwiftAgent/documentation/SwiftAgent/RAGContextGenerator":{"role":"symbol","title":"RAGContextGenerator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RAGContextGenerator"}],"url":"\/documentation\/swiftagent\/ragcontextgenerator","abstract":[{"type":"text","text":"RAG Context summary generator for dataframes."}],"navigatorTitle":[{"kind":"identifier","text":"RAGContextGenerator"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator","kind":"symbol","type":"topic"},"doc://SwiftAgent/documentation/SwiftAgent/AgentMemory":{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMemory","kind":"symbol","abstract":[{"type":"text","text":"Abstract protocol governing conversational, episodic, and semantic agent memory stores."}],"url":"\/documentation\/swiftagent\/agentmemory","type":"topic","role":"symbol","navigatorTitle":[{"text":"AgentMemory","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AgentMemory","kind":"identifier"}],"title":"AgentMemory"}}}