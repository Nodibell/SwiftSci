codeRow())","    if page.count == pageSize {","        rows.append(contentsOf: page)","        page.removeAll(keepingCapacity: true)","    }","}","rows.append(contentsOf: page) \/\/ Flush remainder"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Benchmark impact"}],"type":"strong"},{"text":": ~40% fewer allocations on 500K-row tables vs. naive append.","type":"text"}]},{"anchor":"SCRAM-SHA-256-Authentication","type":"heading","level":2,"text":"SCRAM-SHA-256 Authentication"},{"type":"paragraph","inlineContent":[{"text":"Modern PostgreSQL (>= 14) defaults to ","type":"text"},{"code":"scram-sha-256","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"pg_hba.conf","type":"codeVoice"},{"text":". ","type":"text"},{"code":"SwiftDatabase","type":"codeVoice"},{"text":"’s wire-protocol driver now supports the full RFC 5802 exchange:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["Client                                    Server","  │  SASLInitialResponse(SCRAM-SHA-256)     │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLContinue(salt, i)    │","  │ ◄────────────────────────────────────── │","  │  SASLResponse(ClientProof)              │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLFinal + AuthOK       │","  │ ◄────────────────────────────────────── │"]},{"anchor":"PBKDF2-SHA256-via-CryptoKit","type":"heading","level":3,"text":"PBKDF2-SHA256 via CryptoKit"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"SaltedPassword = Hi(password, salt, iterations)","type":"codeVoice"},{"text":" derivation uses a pure Swift PBKDF2 loop over CryptoKit ","type":"text"},{"code":"HMAC<SHA256>","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var u = HMAC<SHA256>.authenticationCode(for: salt + [0,0,0,1], using: SymmetricKey(data: passwordData))","var saltedPassword = Array(u)","for _ in 1..<iterations {","    u = HMAC<SHA256>.authenticationCode(for: Data(u), using: ...)","    \/\/ XOR accumulate","}"]},{"anchor":"Enabling-SCRAM-on-PostgreSQL-Server","type":"heading","level":2,"text":"Enabling SCRAM on PostgreSQL Server"},{"type":"codeListing","syntax":"sql","code":["-- pg_hba.conf","host  all  all  0.0.0.0\/0  scram-sha-256","","-- Verify in psql:","SELECT usename, passwd FROM pg_shadow;","-- Password should start with: SCRAM-SHA-256$4096:..."]}],"kind":"content"}],"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/SQLiteConnection":{"abstract":[{"text":"Embedded SQLite database driver executing real SQL statements using the SQLite3 C API.","type":"text"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SQLiteConnection"}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection","navigatorTitle":[{"kind":"identifier","text":"SQLiteConnection"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/swiftdatabase\/sqliteconnection","title":"SQLiteConnection"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","abstract":[{"text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback.","type":"text"}],"role":"collectionGroup","type":"topic","title":"Bulk SQL Ingestion & Database Wire Protocols","kind":"article","url":"\/documentation\/swiftdatabase\/highthroughputingestion"},"doc://SwiftDatabase/documentation/SwiftDatabase/DatabaseConnectors":{"kind":"article","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","type":"topic","url":"\/documentation\/swiftdatabase\/databaseconnectors","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","role":"article","abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL