{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors"},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiftDatabase"},{"text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 ","type":"text"},{"type":"codeVoice","code":"public actor"},{"text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"🔒 Driver Architecture & Concurrency Model","anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model"},{"type":"codeListing","syntax":null,"code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Actor Isolation:","type":"text"}]},{"text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Streaming ","type":"text"},{"code":"recv","type":"codeVoice"},{"text":" Buffer:","type":"text"}]},{"text":" Network drivers use a 64KB receive buffer reading continuously until ","type":"text"},{"code":"ReadyForQuery ('Z')","type":"codeVoice"},{"text":" is received.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Authentication:","type":"text"}]},{"text":" Built-in support for Cleartext and MD5 password authentication via ","type":"text"},{"code":"CommonCrypto","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"level":2,"text":"1. Querying SQLite Databases","type":"heading","anchor":"1-Querying-SQLite-Databases"},{"inlineContent":[{"code":"SQLiteConnection","type":"codeVoice"},{"text":" executes SQL statements through native ","type":"text"},{"code":"sqlite3_prepare_v2","type":"codeVoice"},{"text":" and directly streams result rows into columnar ","type":"text"},{"code":"TypedColumn","type":"codeVoice"},{"text":" buffers:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = try SQLiteConnection(path: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)"]},{"type":"thematicBreak"},{"level":2,"text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","type":"heading","anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol"},{"inlineContent":[{"text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries (","type":"text"},{"code":"libpq","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = try PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    username: \"postgres\",","    password: \"secure_password\",","    useSSL: false",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"]},{"type":"thematicBreak"},{"level":2,"text":"3. High-Throughput Bulk Writeback (`toSQL`)","type":"heading","anchor":"3-High-Throughput-Bulk-Writeback-toSQL"},{"inlineContent":[{"text":"Bulk export in-memory ","type":"text"},{"code":"DataFrame","type":"codeVoice"},{"text":" objects back into database tables with configurable append or replace modes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append or .replace","    batchSize: 500,","    failIfExists: false",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"]},{"name":"Note","content":[{"inlineContent":[{"inlineContent":[{"text":"Concurrency Tip:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"For multi-threaded web servers and asynchronous pipelines, initialize a pool of actor connections (","type":"text"},{"code":"DatabasePool","type":"codeVoice"},{"text":") to parallelize read workloads across multiple connections.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/databaseconnectors"]}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"],"generated":true,"title":"Guides & Tutorials"}],"metadata":{"modules":[{"name":"SwiftDatabase"}],"roleHeading":"Article","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","role":"article"},"kind":"article","abstract":[{"type":"text","text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into "},{"code":"SwiftDataFrame","type":"codeVoice"},{"type":"text","text":" under Swift 6 Actor Concurrency."}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/SecurityAndPerformance":{"type":"topic","abstract":[{"text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL.","type":"text"}],"url":"\/documentation\/swiftdatabase\/securityandperformance","kind":"article","title":"Security & Performance in SwiftDatabase","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","role":"collectionGroup"},"doc://SwiftDatabase/documentation/SwiftDatabase":{"url":"\/documentation\/swiftdatabase","kind":"symbol","title":"SwiftDatabase","role":"collection","type":"topic","abstract":[{"text":"Relational Database Connectors to DataFrames.","type":"text"}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"},"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"kind":"article","type":"topic","abstract":[{"text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions.","type":"text"}],"title":"Database Type System & Value Representation","role":"collectionGroup","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","url":"\/documentation\/swiftdatabase\/typesystem"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"type":"topic","abstract":[{"text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback.","type":"text"}],"url":"\/documentation\/swiftdatabase\/highthroughputingestion","kind":"article","title":"Bulk SQL Ingestion & Database Wire Protocols","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","role":"collectionGroup"}}}