{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration"},"topicSections":[{"identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"],"anchor":"Arrow-Classes--Readers","title":"Arrow Classes & Readers"}],"variants":[{"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"metadata":{"modules":[{"name":"SwiftDataFrame"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Apache Arrow & Feather Zero-Copy Integration"},"abstract":[{"type":"text","text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization."}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties.","type":"text"}]},{"type":"heading","text":"1. Arrow Memory Layout & Bitmaps","level":2,"anchor":"1-Arrow-Memory-Layout--Bitmaps"},{"type":"paragraph","inlineContent":[{"text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:","type":"text"}]},{"type":"codeListing","code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"],"syntax":null},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Validity Bitmaps"}],"type":"strong"},{"text":": Each bit represents the presence (1) or absence (0) of a value at that index.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"SIMD Null Filtering"}],"type":"strong"},{"type":"text","text":": Vectorized operations skip null evaluations using SIMD bitmasks ("},{"code":"vDSP_vcmprsD","type":"codeVoice"},{"text":"), allowing full CPU register utilization.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"2. Feather File Format (Arrow IPC)","level":2,"anchor":"2-Feather-File-Format-Arrow-IPC"},{"type":"paragraph","inlineContent":[{"text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:","type":"text"}]},{"type":"codeListing","code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"syntax":"swift"},{"type":"heading","text":"3. Lazy Feather Streaming","level":2,"anchor":"3-Lazy-Feather-Streaming"},{"type":"paragraph","inlineContent":[{"text":"For large datasets, SwiftDataFrame supports streaming chunked reads:","type":"text"}]},{"type":"codeListing","code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"syntax":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"url":"\/documentation\/swiftdataframe","type":"topic","role":"collection","title":"SwiftDataFrame","abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","kind":"symbol","title":"FeatherReader","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeatherReader","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swiftdataframe\/featherreader","abstract":[{"text":"Reader for Feather \/ Apache Arrow IPC binary file format.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"FeatherReader","kind":"identifier"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","title":"FeatherWriter","abstract":[{"text":"Writer for Feather \/ Apache Arrow IPC binary file format.","type":"text"}],"url":"\/documentation\/swiftdataframe\/featherwriter","role":"symbol","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeatherWriter","kind":"identifier"}],"navigatorTitle":[{"text":"FeatherWriter","kind":"identifier"}],"type":"topic"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn","kind":"symbol","title":"TypedColumn","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypedColumn","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swiftdataframe\/typedcolumn","type":"topic","abstract":[{"type":"text","text":"A strongly-typed column backed by a contiguous Swift array."},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" elements represent null \/ missing values."}],"navigatorTitle":[{"text":"TypedColumn","kind":"identifier"}]}}}