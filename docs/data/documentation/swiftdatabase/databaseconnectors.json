{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/databaseconnectors"]}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"sections":[],"abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"metadata":{"title":"Relational Database Drivers & Zero-Copy SQL Ingestion","modules":[{"name":"SwiftDatabase"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"inlineContent":[{"code":"SwiftDatabase","type":"codeVoice"},{"type":"text","text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 "},{"code":"public actor","type":"codeVoice"},{"type":"text","text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"🔒 Driver Architecture & Concurrency Model","level":2,"anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model","type":"heading"},{"syntax":null,"code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Actor Isolation:","type":"text"}]},{"type":"text","text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Streaming "},{"type":"codeVoice","code":"recv"},{"type":"text","text":" Buffer:"}],"type":"strong"},{"type":"text","text":" Network drivers use a 64KB receive buffer reading continuously until "},{"code":"ReadyForQuery ('Z')","type":"codeVoice"},{"type":"text","text":" is received."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication:"}],"type":"strong"},{"type":"text","text":" Built-in support for Cleartext and MD5 password authentication via "},{"code":"CommonCrypto","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"anchor":"1-Querying-SQLite-Databases","text":"1. Querying SQLite Databases","level":2,"type":"heading"},{"inlineContent":[{"code":"SQLiteConnection","type":"codeVoice"},{"text":" executes SQL statements through native ","type":"text"},{"code":"sqlite3_prepare_v2","type":"codeVoice"},{"text":" and directly streams result rows into columnar ","type":"text"},{"code":"TypedColumn","type":"codeVoice"},{"text":" buffers:","type":"text"}],"type":"paragraph"},{"code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = try SQLiteConnection(path: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol","text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","level":2},{"inlineContent":[{"text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries (","type":"text"},{"code":"libpq","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = try PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    username: \"postgres\",","    password: \"secure_password\",","    useSSL: false",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","anchor":"3-High-Throughput-Bulk-Writeback-toSQL","text":"3. High-Throughput Bulk Writeback (`toSQL`)","level":2},{"inlineContent":[{"text":"Bulk export in-memory ","type":"text"},{"code":"DataFrame","type":"codeVoice"},{"text":" objects back into database tables with configurable append or replace modes:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append or .replace","    batchSize: 500,","    failIfExists: false",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"],"type":"codeListing","syntax":"swift"},{"type":"aside","name":"Note","content":[{"inlineContent":[{"inlineContent":[{"text":"Concurrency Tip:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"For multi-threaded web servers and asynchronous pipelines, initialize a pool of actor connections (","type":"text"},{"code":"DatabasePool","type":"codeVoice"},{"text":") to parallelize read workloads across multiple connections.","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors"},"kind":"article","references":{"doc://SwiftDatabase/documentation/SwiftDatabase":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase","role":"collection","abstract":[{"text":"Relational Database Connectors to DataFrames.","type":"text"}],"url":"\/documentation\/swiftdatabase","kind":"symbol","title":"SwiftDatabase","type":"topic"}}}