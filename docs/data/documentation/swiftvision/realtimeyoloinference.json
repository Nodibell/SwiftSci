{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Real-Time YOLOv8 Object Detection & Hardware Acceleration","roleHeading":"Article","role":"article","modules":[{"name":"SwiftVision"}]},"variants":[{"paths":["\/documentation\/swiftvision\/realtimeyoloinference"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/RealTimeYOLOInference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Execute real-time anchor-free object detection on Apple Silicon GPU and Neural Engine using "},{"type":"codeVoice","code":"YOLOv8Detector"},{"type":"text","text":", "},{"type":"codeVoice","code":"YOLOPreprocessor"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ImageDataset"},{"type":"text","text":"."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftVision","type":"codeVoice"},{"text":" implements the full ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"YOLOv8"}]},{"text":" deep learning architecture in native Swift and MLX. The pipeline combines Apple Accelerate ","type":"text"},{"code":"vImageScale_PlanarF","type":"codeVoice"},{"text":" for bilinear letterbox scaling, deep CSPDarknet backbone evaluation, decoupled PANet feature pyramid routing, and anchorless box decoding with Non-Maximum Suppression (NMS).","type":"text"}]},{"syntax":null,"type":"codeListing","code":["Input Image (RGB \/ File \/ CVPixelBuffer)","               │","               ▼","┌────────────────────────────────────────┐","│ Apple Accelerate vImage Letterbox      │ ───► Resizes to 640x640 with (114, 114, 114) padding","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOBackbone (CSPDarknet + SPPF)       │ ───► P3, P4, P5 multi-scale feature maps","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLONeck (PANet Feature Pyramid)       │ ───► Top-down & bottom-up cross-scale fusion","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOHead (Decoupled Class & Box DFL)   │ ───► 8,400 raw candidate anchor predictions","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ Vectorized Non-Maximum Suppression     │ ───► Final BoundingBoxes with class IDs & confidences","└────────────────────────────────────────┘"]},{"type":"thematicBreak"},{"type":"heading","text":"1. Loading Weights and Executing Detection","level":2,"anchor":"1-Loading-Weights-and-Executing-Detection"},{"type":"paragraph","inlineContent":[{"text":"Load pre-trained ","type":"text"},{"code":".onnx","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".safetensors","type":"codeVoice"},{"text":" model weights and detect objects:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftVision","","\/\/ 1. Initialize YOLOv8 detector from model weights file","let modelURL = URL(fileURLWithPath: \"yolov8n.onnx\")","let detector = try YOLOv8Detector(weightsURL: modelURL)","","\/\/ 2. Perform object detection on an image file","let imageURL = URL(fileURLWithPath: \"street_scene.jpg\")","let detections = try await detector.detect(","    imageURL: imageURL,","    confidenceThreshold: 0.4,","    iouThreshold: 0.45",")","","print(\"=== YOLOv8 Detection Results ===\")","for box in detections {","    let rect = box.rect","    print(\"Class: '\\(box.className)' (ID: \\(box.classId)) | Confidence: \\(String(format: \"%.2f%%\", box.confidence * 100)) | Box: [x=\\(rect.minX), y=\\(rect.minY), w=\\(rect.width), h=\\(rect.height)]\")","}"]},{"type":"thematicBreak"},{"type":"heading","text":"2. Hardware-Accelerated Letterbox Preprocessing (`vImage`)","level":2,"anchor":"2-Hardware-Accelerated-Letterbox-Preprocessing-vImage"},{"type":"paragraph","inlineContent":[{"code":"YOLOPreprocessor","type":"codeVoice"},{"text":" uses Apple Accelerate’s ","type":"text"},{"code":"vImageScale_PlanarF","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"kvImageHighQualityResampling","type":"codeVoice"},{"text":", performing aspect-ratio preserving downsampling directly in hardware:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftVision","","\/\/ Preprocess raw image buffer into normalized Float32 planar tensor","let inputImage = URL(fileURLWithPath: \"input_1920x1080.jpg\")","let (tensorBuffer, scaleFactor, padX, padY) = try YOLOPreprocessor.preprocess(","    imageURL: inputImage,","    targetSize: (width: 640, height: 640)",")","","print(\"Preprocessed tensor count: \\(tensorBuffer.count) Float elements.\")","print(\"Scale Factor: \\(scaleFactor), Padding: (\\(padX), \\(padY))\")"]},{"type":"thematicBreak"},{"type":"heading","text":"3. Training & Batching Image Datasets","level":2,"anchor":"3-Training--Batching-Image-Datasets"},{"type":"paragraph","inlineContent":[{"text":"Load and normalize computer vision datasets in compact ","type":"text"},{"code":"Float32","type":"codeVoice"},{"text":" tensors:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let dataset = try ImageDataset(","    directoryURL: URL(fileURLWithPath: \"coco_val2017\/\"),","    targetSize: (width: 256, height: 256),","    normalize: true",")","","print(\"Loaded \\(dataset.count) images. Memory per image: \\(dataset.data.count * 4 \/ 1024) KB.\")"]}]}],"references":{"doc://SwiftVision/documentation/SwiftVision":{"url":"\/documentation\/swiftvision","role":"collection","kind":"symbol","abstract":[{"text":"Computer Vision Neural Inference, Object Detection & Image Datasets.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision","title":"SwiftVision"}}}