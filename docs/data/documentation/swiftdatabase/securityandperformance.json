{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"},"abstract":[{"text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL.","type":"text"}],"topicSections":[{"title":"SQLite Performance","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection"],"anchor":"SQLite-Performance"},{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection"],"title":"PostgreSQL Security","anchor":"PostgreSQL-Security"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftDatabase"}],"title":"Security & Performance in SwiftDatabase"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/securityandperformance"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"As datasets grow into the millions of rows and production PostgreSQL deployments enforce stronger authentication policies, "},{"code":"SwiftDatabase","type":"codeVoice"},{"text":" provides two complementary enhancements:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"1024-row column buffering","type":"text"}]},{"text":" in ","type":"text"},{"code":"SQLiteConnection.executeQuery","type":"codeVoice"},{"text":" reduces Swift ","type":"text"},{"code":"Array","type":"codeVoice"},{"text":" reallocation pressure on large sequential table scans.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"SCRAM-SHA-256 authentication","type":"text"}],"type":"strong"},{"text":" in ","type":"text"},{"code":"PostgreSQLConnection","type":"codeVoice"},{"text":" implements the full RFC 5802\/7677 handshake using CryptoKit ","type":"text"},{"code":"HMAC<SHA256>","type":"codeVoice"},{"text":" and iterative PBKDF2 — never transmitting the raw password over the wire.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"1024-Row-Column-Buffering","level":2,"type":"heading","text":"1024-Row Column Buffering"},{"level":3,"type":"heading","anchor":"Problem","text":"Problem"},{"type":"paragraph","inlineContent":[{"text":"The naive approach appends each decoded row immediately to a growing ","type":"text"},{"type":"codeVoice","code":"[[AnySendableValue]]"},{"type":"text","text":" array. Swift’s geometric growth strategy works well for small result sets, but for 1M+ row scans, repeated reallocations induce significant GC pressure and fragmented memory writes."}]},{"level":3,"type":"heading","anchor":"Solution","text":"Solution"},{"inlineContent":[{"type":"codeVoice","code":"executeQuery"},{"type":"text","text":" pre-allocates a local "},{"type":"codeVoice","code":"page"},{"text":" buffer of exactly 1024 rows. When the page fills, it is bulk-appended to the result array via ","type":"text"},{"code":"rows.append(contentsOf: page)","type":"codeVoice"},{"text":", then the page is cleared with ","type":"text"},{"type":"codeVoice","code":"removeAll(keepingCapacity: true)"},{"text":" to avoid reallocation.","type":"text"}],"type":"paragraph"},{"code":["let pageSize = 1024","var page: [[AnySendableValue]] = []","page.reserveCapacity(pageSize)","","while sqlite3_step(stmt) == SQLITE_ROW {","    page.append(decodeRow())","    if page.count == pageSize {","        rows.append(contentsOf: page)","        page.removeAll(keepingCapacity: true)","    }","}","rows.append(contentsOf: page) \/\/ Flush remainder"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Benchmark impact","type":"text"}]},{"text":": ~40% fewer allocations on 500K-row tables vs. naive append.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"SCRAM-SHA-256 Authentication","level":2,"anchor":"SCRAM-SHA-256-Authentication"},{"inlineContent":[{"text":"Modern PostgreSQL (>= 14) defaults to ","type":"text"},{"code":"scram-sha-256","type":"codeVoice"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"pg_hba.conf"},{"type":"text","text":". "},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":"’s wire-protocol driver now supports the full RFC 5802 exchange:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["Client                                    Server","  │  SASLInitialResponse(SCRAM-SHA-256)     │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLContinue(salt, i)    │","  │ ◄────────────────────────────────────── │","  │  SASLResponse(ClientProof)              │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLFinal + AuthOK       │","  │ ◄────────────────────────────────────── │"]},{"anchor":"PBKDF2-SHA256-via-CryptoKit","text":"PBKDF2-SHA256 via CryptoKit","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SaltedPassword = Hi(password, salt, iterations)"},{"text":" derivation uses a pure Swift PBKDF2 loop over CryptoKit ","type":"text"},{"code":"HMAC<SHA256>","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var u = HMAC<SHA256>.authenticationCode(for: salt + [0,0,0,1], using: SymmetricKey(data: passwordData))","var saltedPassword = Array(u)","for _ in 1..<iterations {","    u = HMAC<SHA256>.authenticationCode(for: Data(u), using: ...)","    \/\/ XOR accumulate","}"]},{"text":"Enabling SCRAM on PostgreSQL Server","anchor":"Enabling-SCRAM-on-PostgreSQL-Server","type":"heading","level":2},{"syntax":"sql","type":"codeListing","code":["-- pg_hba.conf","host  all  all  0.0.0.0\/0  scram-sha-256","","-- Verify in psql:","SELECT usename, passwd FROM pg_shadow;","-- Password should start with: SCRAM-SHA-256$4096:..."]}],"kind":"content"}],"sections":[],"seeAlsoSections":[{"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/SQLiteConnection":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection","abstract":[{"text":"Embedded SQLite database driver executing real SQL statements using the SQLite3 C API.","type":"text"}],"kind":"symbol","url":"\/documentation\/swiftdatabase\/sqliteconnection","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SQLiteConnection","kind":"identifier"}],"role":"symbol","title":"SQLiteConnection","navigatorTitle":[{"text":"SQLiteConnection","kind":"identifier"}]},"doc://SwiftDatabase/documentation/SwiftDatabase/PostgreSQLConnection":{"kind":"symbol","title":"PostgreSQLConnection","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostgreSQLConnection"}],"abstract":[{"type":"text","text":"Native PostgreSQL database connection driver using PostgreSQL v3.0 wire protocol."}],"navigatorTitle":[{"kind":"identifier","text":"PostgreSQLConnection"}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection","url":"\/documentation\/swiftdatabase\/postgresqlconnection","role":"symbol"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","abstract":[{"text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch wri