{"hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"metadata":{"title":"Deep Convolutional U-Net Semantic Segmentation","modules":[{"name":"SwiftVision"}],"role":"collectionGroup","roleHeading":"API Collection"},"identifier":{"url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetSegmentationArchitecture","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Train and deploy deep convolutional U-Net neural networks for image segmentation directly on Apple Silicon MLX GPU."}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Vision Network Types","anchor":"Vision-Network-Types","identifiers":["doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetArchitecture","doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetDoubleConv","doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetDown","doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetUp","doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetOutConv"]}],"variants":[{"paths":["\/documentation\/swiftvision\/unetsegmentationarchitecture"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The U-Net architecture is the gold standard for semantic image segmentation, consisting of a contracting path (encoder) to capture context and a symmetric expanding path (decoder) for precise spatial localization, linked via skip connections.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["Input Image ──► [ DoubleConv ] ────────────────────── Skip ─────────────────────► [ Up + Conv ] ──► Mask","                     │                                                                ▲","                  [ Down ] ──► [ DoubleConv ] ──────── Skip ───────► [ Up + Conv ] ───┘","                                   │                                     ▲","                                [ Down