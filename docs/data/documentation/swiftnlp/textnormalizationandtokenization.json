{"metadata":{"modules":[{"name":"SwiftNLP"}],"roleHeading":"Article","role":"article","title":"Text Normalization, Tokenization & Linguistic Tagging"},"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"type":"codeVoice","code":"NaturalLanguage"},{"type":"text","text":" framework."}],"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"title":"Guides & Tutorials","generated":true}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"1. Multi-lingual Word & Sentence Tokenization","anchor":"1-Multi-lingual-Word--Sentence-Tokenization"},{"type":"codeListing","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"syntax":"swift"},{"type":"heading","level":3,"text":"2. POS Tagging, Lemmatization & Entity Extraction","anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction"},{"type":"codeListing","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"syntax":"swift"},{"type":"heading","level":3,"text":"3. Sentiment Analysis (VADER & NLSentiment)","anchor":"3-Sentiment-Analysis-VADER--NLSentiment"},{"type":"codeListing","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"syntax":"swift"}],"kind":"content"}],"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"type":"topic","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"kind":"symbol","role":"collection","title":"SwiftNLP","url":"\/documentation\/swiftnlp","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP"},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"abstract":[{"type":"text","text":"Convert text corpora into numerical and sparse feature matrices using "},{"type":"codeVoice","code":"TFIDFVectorizer"},{"type":"text","text":", "},{"type":"codeVoice","code":"CountVectorizer"},{"type":"text","text":", "},{"type":"codeVoice","code":"HashingVectorizer"},{"type":"text","text":", "},{"type":"codeVoice","code":"SparseVector"},{"type":"text","text":", and "},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"type":"text","text":"."}],"url":"\/documentation\/swiftnlp\/vectorizationandembeddings","kind":"article","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","role":"article","title":"Text Feature Vectorization, Sparse TF-IDF & Local Embeddings"}}}