{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"On-Device RAG combines fast local vector retrieval with on-device language models to provide accurate, grounded answers from private local documents without cloud network dependencies."}]},{"type":"codeListing","syntax":"mermaid","code":["graph LR","    Query[User Query] --> Embed[LocalEmbeddingEngine]","    Embed --> Vec[Dense Vector]","    Vec --> Search[VectorStore Top-K]","    Docs[Private Document Index] --> Search","    Search --> Chunks[Retrieved Text Snippets]","    Chunks --> Prompt[Augmented Prompt]","    Prompt --> LLM[SwiftLLM Metal Engine]","    LLM --> Answer[Grounded Answer]"]},{"type":"heading","anchor":"1-Complete-End-to-End-Pipeline-Example","text":"1. Complete End-to-End Pipeline Example","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftAgent","import SwiftCluster","import SwiftNLP","import SwiftLLM","","\/\/ 1. Initialize local embedding engine and vector store","let embedEngine = LocalEmbeddingEngine(dimension: 128)","let vectorStore = VectorStore(metric: .cosineSimilarity)","","\/\/ 2. Ingest private knowledge base","let corpus = [","    \"SwiftSci uses Apple Accelerate vDSP for SIMD arithmetic.\",","    \"MLX provides unified memory GPU tensor computation on Mac.\",","    \"WiredMemoryManager prevents out-of-memory errors on shared RAM.\"","]","","for (id, text) in corpus.enumerated() {","    let vec = embedEngine.embed(text)","    vectorStore.add(id: \"doc_\\(id)\", vector: vec, metadata: [\"content\": text])","}","","\/\/ 3. Retrieve relevant context for user question","let userQuestion = \"How does SwiftSci accelerate vector math?\"","let queryVector = embedEngine.embed(userQuestion)","let topMatches = vectorStore.search(query: queryVector, topK: 1)","","let contextSnippet = topMatches.first?.metadata[\"content\"] ?? \"\"","","\/\/ 4. Assemble augmented prompt and query local LLM","let augmentedPrompt = \"\"\"","Context: \\(contextSnippet)","Question: \\(userQuestion)","Answer:","\"\"\""]}]}],"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGAndContextAugmentation","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Construct privacy-preserving Retrieval-Augmented Generation workflows on Apple Silicon."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/ragandcontextaugmentation"]}],"kind":"article","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftAgent"}],"title":"Building On-Device RAG Pipelines","roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"topicSections":[{"title":"Agent Components","anchor":"Agent-Components","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"]}],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"type":"topic","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","title":"SwiftAgent","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"role":"collection","kind":"symbol","url":"\/documentation\/swiftagent"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"type":"topic","abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"title":"SwiftAgentEvaluator","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SwiftAgentEvaluator"}],"url":"\/documentation\/swiftagent\/swiftagentevaluator","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiftAgentEvaluator"}]}}}