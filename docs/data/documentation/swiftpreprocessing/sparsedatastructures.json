{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x."}],"type":"paragraph"},{"text":"Storage Formats","anchor":"Storage-Formats","level":2,"type":"heading"},{"text":"Compressed Sparse Row (CSR)","anchor":"Compressed-Sparse-Row-CSR","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Stores non-zero values row-by-row:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"values"},{"type":"text","text":": Non-zero numerical entries."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"colIndices"},{"type":"text","text":": Column indices corresponding to each entry in "},{"type":"codeVoice","code":"values"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"rowPointers"},{"type":"text","text":": Offsets into "},{"type":"codeVoice","code":"values"},{"type":"text","text":" marking where each row begins (length: "},{"type":"codeVoice","code":"rowCount + 1"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"syntax":null,"type":"codeListing","code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"]},{"type":"heading","text":"Compressed Sparse Column (CSC)","level":3,"anchor":"Compressed-Sparse-Column-CSC"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication."}]},{"type":"heading","text":"Apple Accelerate Sparse BLAS","level":2,"anchor":"Apple-Accelerate-Sparse-BLAS"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_matrix_create_double"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_insert_row_double"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_commit"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_matrix_vector_product_dense_double"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput."}]},{"type":"heading","text":"Example Usage","level":2,"anchor":"Example-Usage"},{"syntax":"swift","type":"codeListing","code":["import SwiftPreprocessing","","\/\/ 1. Create a sparse matrix from a dense array","let dense: [[Double]] = [","    [1.0, 0.0, 0.0],","    [0.0, 2.0, 0.0],","    [0.0, 0.0, 3.0]","]","let sparse = SparseMatrix(dense: dense, format: .csr)","print(\"Sparsity: \\(sparse.sparsity)\") \/\/ ~ 0.667","","\/\/ 2. Accelerated matrix-vector product","let x = [1.0, 2.0, 3.0]","let y = try sparse.multiply(vector: x)","print(y) \/\/ [1.0, 4.0, 9.0]","","\/\/ 3. Matrix Transpose & CSC conversion","let csc = sparse.toCSC()","let transposed = sparse.transpose()"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"sections":[],"seeAlsoSections":[{"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"]}],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","interfaceLanguage":"swift"},"abstract":[{"text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"kind":"article","metadata":{"roleHeading":"API Collection","title":"Memory-Efficient Sparse Matrix Representations","role":"collectionGroup","modules":[{"name":"SwiftPreprocessing"}]},"topicSections":[{"anchor":"Sparse-Data-Types","title":"Sparse Data Types","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"]}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseMatrix":{"abstract":[{"text":"Memory-efficient sparse matrix storage implementing Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","title":"SparseMatrix","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SparseMatrix"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparseMatrix","kind":"identifier"}],"url":"\/documentation\/swiftpreprocessing\/sparsematrix","kind":"symbol","type":"topic"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessin