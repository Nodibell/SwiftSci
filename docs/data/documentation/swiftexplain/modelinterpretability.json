{"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Explainable Artificial Intelligence (XAI) bridges the gap between predictive accuracy and decision transparency. "},{"type":"codeVoice","code":"SwiftExplain"},{"type":"text","text":" provides exact Shapley mathematical decomposition for tree-based models, local linear surrogate modeling with LIME, and model-agnostic permutation metrics."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"anchor":"%F0%9F%93%8A-Explainability-Methods-Comparison","text":"📊 Explainability Methods Comparison"},{"alignments":["left","left","left","left","left"],"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Supported Models","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Algorithmic Complexity","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Scope"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Recommendation"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"TreeSHAP","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decision Trees, Random Forests, GBDT"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(T · L · D²)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local & Global"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Recommended for all tree models.","type":"text"}]},{"type":"text","text":" Exact polynomial Shapley computation directly on flat nodes without sampling noise."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"KernelSHAP","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Any black-box model (MLP, SVM, Ensembles)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(S · D²)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local"}]}],[{"type":"paragraph","inlineContent":[{"text":"Universal Shapley attribution using weighted coalition sampling.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"LIME","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any black-box model (MLP, Vision, NLP)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(S · D)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Local","type":"text"}]}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Fast local surrogate."}],"type":"strong"},{"text":" Fits an interpretable weighted linear model around perturbations.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PermutationImportance"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Any model","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"O(D · N)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Global","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fast global feature ranking by measuring validation loss degradation upon feature column shuffling."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"PartialDependencePlot","type":"codeVoice"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Any model"}],"type":"paragraph"}],[{"inlineContent":[{"code":"O(G · N)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Global"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Visualizes marginal effect of 1 or 2 features across an evaluation grid."}],"type":"paragraph"}]]]},{"type":"thematicBreak"},{"text":"1. Exact TreeSHAP for Tree Ensembles","anchor":"1-Exact-TreeSHAP-for-Tree-Ensembles","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeSHAP"},{"type":"text","text":" traverses tree branches in polynomial time, calculating exact Shapley values without random coalition sampling:"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftML","import SwiftExplain","","\/\/ 1. Train a Random Forest Classifier","let X = [[1.0, 2.0], [2.0, 1.0], [5.0, 4.0], [6.0, 5.0]]","let y = [0, 0, 1, 1]","","let forest = try RandomForestClassifier(nTrees: 10, maxDepth: 4)","try await forest.fit(features: X, labels: y)","","\/\/ 2. Explain prediction on a target instance","let treeSHAP = TreeSHAP()","let instance = [5.5, 4.2]","","let shapValues = try await treeSHAP.explain(model: forest, instance: instance)","","print(\"=== TreeSHAP Feature Attributions ===\")","for (featureIdx, attribution) in shapValues.enumerated() {","    print(\"Feature \\(featureIdx): Contribution = \\(String(format: \"%+.4f\", attribution))\")","}"]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"2. Local Interpretable Model-agnostic Explanations (`LIME`)","anchor":"2-Local-Interpretable-Model-agnostic-Explanations-LIME"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LIMEExplainer"},{"text":" perturbs the neighborhood of a target sample using Box-Muller Gaussian noise, weights samples by an exponential distance kernel, and fits a weighted Ridge regression surrogate model:","type":"text"}]},{"code":["import SwiftExplain","import SwiftML","","\/\/ Black-box model closure","let modelClosure: @Sendable ([Double]) async -> Double = { x in","    \/\/ Non-linear complex interaction","    return 3.0 * x[0] + sin(x[1] * 2.0) - 1.5 * x[2] * x[2] + 4.0","}","","let instance = [1.5, 0.8, -0.4]","","let lime = LIMEExplainer(kernelWidth: 0.75, regularization: 0.1)","let explanation = await lime.explain(","    model: modelClosure,","    instance: instance,","    numSamples: 500",")","","print(\"=== LIME Local Surrogate Explanation ===\")","print(\"Local Prediction: \\(String(format: \"%.4f\", explanation.prediction))\")","print(\"Surrogate Intercept: \\(String(format: \"%.4f\", explanation.intercept))\")","print(\"Local Goodness-of-Fit (R²): \\(String(format: \"%.2f%%\", explanation.localR2 * 100))\")","","for (d, weight) in explanation.featureWeights.enumerated() {","    print(\"Feature [\\(d)] Local Slope: \\(String(format: \"%+.4f\", weight))\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"3. Global Permutation Feature Importance","type":"heading","level":2,"anchor":"3-Global-Permutation-Feature-Importance"},{"inlineContent":[{"type":"text","text":"Measure global model dependence by quantifying score drop when a single feature column is randomly permuted:"}],"type":"paragraph"},{"code":["import SwiftExplain","","let perm = PermutationImportance()","let importances = try await perm.computeImportance(","    features: X,","    targets: y.map(Double.init)",") { matrix in","    try await forest.predict(features: matrix).map(Double.init)","}","","print(\"=== Global Feature Importance Ranking ===\")","for (feat, score) in importances.sorted(by: { $0.value > $1.value }) {","    print(\"\\(feat): Importance Score = \\(String(format: \"%.4f\", score))\")","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability"},"abstract":[{"text":"Understand black-box machine learning predictions using ","type":"text"},{"code":"TreeSHAP","type":"codeVoice"},{"text":", ","type":"text"},{"code":"KernelSHAP","type":"codeVoice"},{"text":", ","type":"text"},{"code":"LIMEExplainer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PermutationImportance","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"PartialDependencePlot","type":"codeVoice"},{"text":".","type":"text"}],"sections":[],"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Model Interpretability & XAI Guide","modules":[{"name":"SwiftExplain"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/modelinterpretability"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","url":"\/documentation\/swiftexplain","kind":"symbol","title":"SwiftExplain","type":"topic","role":"collection","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}]},"doc://SwiftExplain/documentation/SwiftExplain/ShapleyAttributions":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions","abstract":[{"type":"text","text":"Compute exact and approximate Shapley feature importance scores using parallel KernelSHAP and tree-accelerated TreeSHAP."}],"kind":"article","title":"SHAP Feature Attributions","role":"article","type":"topic","url":"\/documentation\/swiftexplain\/shapleyattributions"}}}