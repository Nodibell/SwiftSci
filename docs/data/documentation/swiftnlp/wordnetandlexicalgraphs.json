{"topicSections":[{"anchor":"WordNet-Types","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNet","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/Synset","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS"],"title":"WordNet Types"}],"variants":[{"paths":["\/documentation\/swiftnlp\/wordnetandlexicalgraphs"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"code":"WordNet","type":"codeVoice"},{"text":" is a large lexical database of English where nouns, verbs, adjectives, and adverbs are organized into sets of cognitive synonyms called ","type":"text"},{"inlineContent":[{"text":"Synsets","type":"text"}],"type":"strong"},{"text":", interlinked by conceptual-semantic and lexical relations.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"1-Looking-Up-Synsets--Definitions","text":"1. Looking Up Synsets & Definitions","type":"heading"},{"syntax":"swift","code":["import SwiftNLP","","let wordnet = WordNet.shared","","\/\/ Look up all noun synsets for \"bank\"","let synsets = wordnet.synsets(for: \"bank\", pos: .noun)","for s in synsets {","    print(\"ID: \\(s.id), Definition: \\(s.definition)\")","}"],"type":"codeListing"},{"level":2,"anchor":"2-Semantic-Similarity-Metrics","text":"2. Semantic Similarity Metrics","type":"heading"},{"inlineContent":[{"text":"SwiftSci implements standard lexical similarity algorithms:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Path Similarity"}]},{"type":"text","text":": Shortest path distance in the hypernym taxonomy:"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"Sim_path(