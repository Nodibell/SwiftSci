xt","text":" as "},{"type":"codeVoice","code":".double"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SQLITE_TEXT"},{"type":"text","text":": Ingested directly as UTF-8 "},{"type":"codeVoice","code":".string"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SQLITE_BLOB"},{"type":"text","text":": Read directly via "},{"type":"codeVoice","code":"sqlite3_column_blob"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sqlite3_column_bytes"},{"type":"text","text":" into "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" without string conversion."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SQLITE_NULL"},{"type":"text","text":": Mapped to "},{"type":"codeVoice","code":".null"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"text":"Thread Safety & Swift 6 Strict Concurrency","level":3,"type":"heading","anchor":"Thread-Safety--Swift-6-Strict-Concurrency"},{"inlineContent":[{"text":"All instances of ","type":"text"},{"code":"AnySendableValue","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SQLQueryResult","type":"codeVoice"},{"text":" conform unconditionally to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". Value semantics ensure that data rows fetched across actor boundaries (e.g. from ","type":"text"},{"code":"SQLiteConnection","type":"codeVoice"},{"text":" to background compute tasks) never introduce data races or retain cycles.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"title":"Value Types","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/AnySendableValue","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLQueryResult"],"anchor":"Value-Types"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/Da