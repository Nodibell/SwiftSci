{"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"abstract":[{"text":"High-throughput, on-device causal language model execution on Apple Silicon Unified Memory Architecture using ","type":"text"},{"type":"codeVoice","code":"TransformerDecoder"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PagedKVCache"},{"text":", ","type":"text"},{"type":"codeVoice","code":"GGUFParser"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SafeTensorsParser"},{"text":".","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"variants":[{"paths":["\/documentation\/swiftllm\/transformerdecoderarchitecture"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"SwiftLLM"}],"role":"article","title":"Transformer Architecture & LLM Inference Guide","roleHeading":"Article"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Architecture Overview","type":"heading","anchor":"Architecture-Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" implements the modern Llama-3 \/ Mistral autoregressive causal decoder architecture natively in pure Swift and MLX:"}]},{"type":"codeListing","syntax":null,"code":["                          ┌────────────────────────┐","                          │    Input Token IDs     │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │   Token Embeddings     │","                          └───────────┬────────────┘","                                      ▼","                      ┌────────────────────────────────┐","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │ Multi-Head Attention + RoPE│ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │      SwiGLU FFN (SiLU)     │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │ └─────────────┬──────────────┘ │ x N Layers","                      └───────────────┼────────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │     Final RMSNorm      │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │  LM Head (Logits)      │","                          └────────────────────────┘"]},{"type":"thematicBreak"},{"text":"1. Core Architectural Components","type":"heading","anchor":"1-Core-Architectural-Components","level":2},{"text":"RoPE (Rotary Position Embedding)","type":"heading","anchor":"RoPE-Rotary-Position-Embedding","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applies 2D rotation to query and key vectors based on absolute position index "},{"type":"codeVoice","code":"m"},{"type":"text","text":", preserving relative token distance properties without learned position embeddings."}]},{"text":"SwiGLU Feed-Forward Network","type":"heading","anchor":"SwiGLU-Feed-Forward-Network","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replaces legacy ReLU\/GELU activations with Swish-Gated Linear Units (Llama-style):"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"SwiGLU(x) = (SiLU(x · W_gate) ⊙ (x · W_up)) · W_down","type":"codeVoice"}]}],"name":"Note","style":"note"},{"text":"Paged KV-Cache","type":"heading","anchor":"Paged-KV-Cache","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Manages attention Key-Value projection states in fixed-size contiguous memory pages (vLLM architecture), eliminating RAM fragmentation during dynamic multi-turn autoregressive decoding."}]},{"type":"thematicBreak"},{"text":"2. Parsing Weight Formats (SafeTensors & GGUF)","type":"heading","anchor":"2-Parsing-Weight-Formats-SafeTensors--GGUF","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" includes strict parsers for both HuggingFace "},{"type":"codeVoice","code":".safetensors"},{"type":"text","text":" headers and "},{"type":"codeVoice","code":"GGUF"},{"type":"text","text":" quantized binary models:"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftLLM","","\/\/ 1. Parse SafeTensors weight metadata","let safeTensorsURL = URL(fileURLWithPath: \"model.safetensors\")","let (tensors, metadata) = try SafeTensorsParser.parse(fileURL: safeTensorsURL)","","print(\"Found \\(tensors.count) tensor layers in SafeTensors archive.\")","for (tensorName, info) in tensors.prefix(5) {","    print(\"Layer '\\(tensorName)': dtype=\\(info.dtype), shape=\\(info.shape)\")","}","","\/\/ 2. Parse GGUF Quantized Binary Archive","let ggufURL = URL(fileURLWithPath: \"llama-3-8b.Q4_K_M.gguf\")","let ggufModel = try GGUFParser.parse(fileURL: ggufURL)","print(\"Loaded GGUF Model with \\(ggufModel.tensors.count) quantized tensors.\")"]},{"type":"thematicBreak"},{"text":"3. End-to-End Decoder Configuration & Inference","type":"heading","anchor":"3-End-to-End-Decoder-Configuration--Inference","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct an N-layer "},{"type":"codeVoice","code":"TransformerDecoder"},{"type":"text","text":" using standard presets ("},{"type":"codeVoice","code":"LLMConfig.llama3_8B"},{"type":"text","text":" or "},{"type":"codeVoice","code":"LLMConfig.custom"},{"type":"text","text":") and generate tokens:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftLLM","","\/\/ 1. Initialize TransformerDecoder with Llama-3-8B configuration","let config = LLMConfig.llama3_8B","let decoder = TransformerDecoder(config: config)","","\/\/ 2. Load model weights into memory","let weightsDictionary: [String: [Double]] = [:] \/\/ Populated from SafeTensors\/GGUF","try decoder.loadWeights(weightsDictionary)","","\/\/ 3. Configure sampling strategy","let sampler = TopKSampler(temperature: 0.7, topK: 40, topP: 0.9)","","\/\/ 4. Autoregressive token generation loop","let promptTokens: [Int] = [128000, 791, 7453, 374] \/\/ Tokenized input","var generatedTokens = promptTokens","let maxNewTokens = 50","","print(\"Generating output tokens...\")","for _ in 0..<maxNewTokens {","    let logits = try decoder.forward(tokens: generatedTokens)","    let nextToken = sampler.sample(logits: logits)","    ","    generatedTokens.append(nextToken)","    if nextToken == 128001 { \/\/ End of Sequence token (EOS)","        break","    }","}","","print(\"Generated sequence length: \\(generatedTokens.count) tokens.\")"]},{"type":"thematicBreak"},{"text":"4. Structured JSON Grammar Decoding","type":"heading","anchor":"4-Structured-JSON-Grammar-Decoding","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enforce strict output conformance to Swift "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" schemas using "},{"type":"codeVoice","code":"JSONGrammarDecoder"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftLLM","","struct SentimentResponse: Codable {","    let label: String","    let confidence: Double","}","","let grammarDecoder = JSONGrammarDecoder(schema: SentimentResponse.self)","let constrainedTokens = try grammarDecoder.constrainSampling(logits: logits, validTokens: vocabulary)"]}]}],"sections":[],"references":{"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"role":"article","abstract":[{"text":"Parse GGUF and SafeTensors model weights zero-copy and sample tokens using Temperature and Top-K sampling.","type":"text"}],"url":"\/documentation\/swiftllm\/weightparsingandsampling","type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","title":"GGUF\/SafeTensors Parsing & Sampling","kind":"article"},"doc://SwiftLLM/documentation/SwiftLLM":{"role":"collection","abstract":[{"text":"Local Causal Transformer Decoder & Weight Parsers.","type":"text"}],"url":"\/documentation\/swiftllm","type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","title":"SwiftLLM","kind":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/MetalShadersQuantization":{"role":"collectionGroup","abstract":[{"type":"text","text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU."}],"url":"\/documentation\/swiftllm\/metalshadersquantization","type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization","title":"Native Metal MSL Shaders for Quantized LLMs","kind":"article"}}}