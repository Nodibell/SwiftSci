","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftAgent"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"MultiAgentOrchestrator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AgentMessageBus"},{"type":"text","text":", a reactive multi-agent framework built on Swift’s structured concurrency primitives ("},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" and "},{"type":"codeVoice","code":"withTaskGroup"},{"type":"text","text":")."}]},{"level":2,"anchor":"Architectural-Topology","type":"heading","text":"Architectural Topology"},{"code":["                         ┌───────────────────────┐","                         │   User \/ Prompt Task  │","                         └───────────┬───────────┘","                                     │","                                     ▼","                       ┌───────────────────────────┐","                       │      AgentMessageBus      │","                       │       (AsyncStream)       │","                       └─────────────┬─────────────┘","                                     │ Broadcasts","         ┌───────────────────────────┼───────────────────────────┐","         ▼                           ▼                           ▼","┌──────────────────┐       ┌──────────────────┐       ┌──────────────────┐","│     Planner      │       │     Analyst      │       │      Critic      │","│ Decomposes steps │       │ Queries & Models │       │ Validates logic  │","└────────┬─────────┘       └────────┬─────────┘       └────────┬─────────┘","         │                          │                          │","         └──────────────────────────┼──────────────────────────┘","                                    │ Parallel Tool Calls","                                    ▼","                     ┌─────────────────────────────┐","                     │ MultiAgentOrchestrator      │","                     │ withTaskGroup Tool Executor │","                     └──────────────┬──────────────┘","                                    │","               ┌────────────────────┴────────────────────┐","               ▼                                         ▼","      DataFrame Query Tool                      Statistical Model Tool"],"type":"codeListing","syntax":null},{"level":2,"anchor":"Parallel-Tool-Calling","type":"heading","text":"Parallel Tool Calling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When an agent requests multiple tool executions in a single reasoning step (e.g. computing standard deviations across three columns concurrently), "},{"code":"MultiAgentOrchestrator.executeToolsInParallel(_:)","type":"codeVoice"},{"type":"text","text":" executes them simultaneously across available CPU cores using "},{"code":"withTaskGroup","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"text":"This reduces total latency from $\\sum_{i=1}^M T_i$ to $\\max_{i} T_i$.","type":"text"}],"type":"paragraph"},{"anchor":"Example-Usage","text":"Example Usage","level":2,"type":"heading"},{"code":["import SwiftAgent","import SwiftDataFrame","","\/\/ 1. Initialize orchestrator and message bus","let orchestrator = MultiAgentOrchestrator(maxRounds: 5)","","\/\/ 2. Register specialized agents","orchestrator.registerAgent(PlannerAgent())","orchestrator.registerAgent(DataAnalystAgent())","orchestrator.registerAgent(CriticAgent())","","\/\/ 3. Register tools","orchestrator.registerTool(DataFrameAgentTool(dataframe: salesData))","","\/\/ 4. Run collaborative execution","let solution = try await orchestrator.run(","    taskPrompt: \"Identify top 3 departments by salary variance and critique findings.\"",")","print(\"Consensus Answer: \\(solution)\")"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/swiftagent\/multiagentcollaboration"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftAgent/documentation/SwiftAgent/AgentMessage":{"identifier":"doc:\/\/Swift