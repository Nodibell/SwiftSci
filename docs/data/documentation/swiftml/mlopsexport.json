{"sections":[],"abstract":[{"text":"Export trained SwiftSci estimators to native Apple Core ML (","type":"text"},{"code":".mlmodel","type":"codeVoice"},{"text":") and cross-platform ONNX (","type":"text"},{"code":".onnx","type":"codeVoice"},{"text":") binary artifacts for production deployment.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/mlopsexport"]}],"metadata":{"title":"Exporting Models to Core ML and ONNX","role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftML"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedClassification","doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLInference","doc:\/\/SwiftML\/documentation\/SwiftML\/BoundedInference","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/ReusableCPUPrediction"],"anchor":"Guides--Tutorials","generated":true}],"topicSections":[{"title":"Core ML Exporter API","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter"],"anchor":"Core-ML-Exporter-API"}],"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"SwiftSci provides native, wire-format serialization engines for both Apple Core ML and ONNX without requiring external Python tooling or code generation steps. Models trained natively in Swift can be directly exported to binary artifacts compatible with Apple Neural Engine (ANE), Metal GPU, CPU, and ONNX Runtime."}],"type":"paragraph"},{"level":2,"text":"1. Core ML Binary Export (`.mlmodel`)","anchor":"1-Core-ML-Binary-Export-mlmodel","type":"heading"},{"inlineContent":[{"type":"text","text":"SwiftSci implements binary Protocol Buffer serialization directly conforming to Apple’s "},{"type":"codeVoice","code":"Model.proto"},{"type":"text","text":" specification (v4)."}],"type":"paragraph"},{"level":3,"text":"Supported Estimators","anchor":"Supported-Estimators","type":"heading"},{"header":"row","alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Estimator","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Core ML Message","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Target Hardware","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"LinearRegression","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"GLMRegressor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"LogisticRegression","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"GLMClassifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"DecisionTreeClassifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TreeEnsembleClassifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"DecisionTreeRegressor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TreeEnsembleRegressor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"RandomForestClassifier"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TreeEnsembleClassifier","type":"codeVoice"},{"type":"text","text":" (multi-tree)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"RandomForestRegressor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TreeEnsembleRegressor","type":"codeVoice"},{"text":" (multi-tree)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}]}]]],"type":"table"},{"level":3,"text":"Using the `CoreMLExportable` Protocol","anchor":"Using-the-CoreMLExportable-Protocol","type":"heading"},{"inlineContent":[{"type":"text","text":"All supported model types conform to the "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","isActive":true},{"type":"text","text":" protocol, providing asynchronous export methods:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftML","","\/\/ Train a Random Forest Classifier","let rf = try RandomForestClassifier(nEstimators: 50, maxDepth: 8)","try await rf.fit(features: X_train, targets: y_train)","","\/\/ Export directly to a .mlmodel file","let exportURL = URL(fileURLWithPath: \"\/path\/to\/RandomForest.mlmodel\")","try await rf.writeCoreML(","    to: exportURL,","    featureNames: [\"age\", \"income\", \"credit_score\"],","    outputName: \"approved\"",")"],"type":"codeListing"},{"level":3,"text":"Direct Serialization via `CoreMLExporter`","anchor":"Direct-Serialization-via-CoreMLExporter","type":"heading"},{"inlineContent":[{"type":"text","text":"You can also use static methods on "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","isActive":true},{"type":"text","text":" to produce binary "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" payloads:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Export fitted linear regression","let modelData = CoreMLExporter.exportBinaryLinearModel(","    name: \"HousePricePredictor\",","    inputNames: [\"sqft\", \"bedrooms\", \"bathrooms\"],","    outputName: \"price\",","    weights: [250.0, 15000.0, 10000.0],","    bias: 50000.0",")","","try modelData.write(to: URL(fileURLWithPath: \"HousePricePredictor.mlmodel\"))"],"type":"codeListing"},{"level":3,"text":"Exporting Composite Pipelines & Modern .mlpackage","anchor":"Exporting-Composite-Pipelines--Modern-mlpackage","type":"heading"},{"inlineContent":[{"type":"text","text":"SwiftSci v3.3.0 supports exporting multi-stage composite pipelines and modern "},{"type":"codeVoice","code":".mlpackage"},{"type":"text","text":" directory bundles:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Export composite pipeline chaining preprocessing + classifier","let pipelineData = CoreMLExporter.exportBinaryPipelineClassifier(","    models: [scalerData, rfData],","    names: [\"Scaler\", \"RandomForestClassifier\"],","    inputNames: [\"age\", \"income\"],","    outputName: \"approved\"",")","","\/\/ Export directly into modern .mlpackage bundle format","try CoreMLExporter.writeMLPackage(","    modelData: pipelineData,","    to: URL(fileURLWithPath: \"\/path\/to\/MyPipeline.mlpackage\"),","    author: \"SwiftSci Developer\",","    description: \"End-to-end data science inference pipeline\"",")"],"type":"codeListing"},{"level":3,"text":"Loading in Client Applications","anchor":"Loading-in-Client-Applications","type":"heading"},{"inlineContent":[{"type":"text","text":"Exported "},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":" and "},{"type":"codeVoice","code":".mlpackage"},{"type":"text","text":" files can be compiled and loaded dynamically using Apple’s "},{"type":"codeVoice","code":"CoreML"},{"type":"text","text":" framework:"}],"type":"paragraph"},{"syntax":"swift","code":["import CoreML","","let compiledURL = try MLModel.compileModel(at: exportURL)","let mlModel = try MLModel(contentsOf: compiledURL)","","let inputDict: [String: Any] = [\"age\": 35.0, \"income\": 75000.0, \"credit_score\": 720.0]","let featureProvider = try MLDictionaryFeatureProvider(dictionary: inputDict)","let output = try mlModel.prediction(from: featureProvider)"],"type":"codeListing"},{"level":2,"text":"2. ONNX Binary Export (`.onnx`)","anchor":"2-ONNX-Binary-Export-onnx","type":"heading"},{"inlineContent":[{"type":"text","text":"SwiftSci provides native binary ONNX wire-format export via "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftML","","let onnxData = ONNXExporter.exportBinaryONNX(","    name: \"LinearONNX\",","    inputs: [\"features\"],","    output: \"prediction\",","    weights: [1.5, -2.0, 0.75],","    bias: 0.5",")","","try onnxData.write(to: URL(fileURLWithPath: \"model.onnx\"))"],"type":"codeListing"}]}],"kind":"article","references":{"doc://SwiftML/documentation/SwiftML/ONNXExporter":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ONNXExporter"}],"url":"\/documentation\/swiftml\/onnxexporter","title":"ONNXExporter","abstract":[{"text":"Exporter for serializing SwiftML models into ONNX model graph specification JSON format.","type":"text"},{"text":" ","type":"text"},{"text":"Note: Produces a JSON representation of the ONNX graph, not a binary .onnx file.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ONNXExporter"}]},"doc://SwiftML/documentation/SwiftML/EarlyStoppingCallbacks