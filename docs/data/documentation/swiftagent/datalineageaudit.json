{"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"abstract":[{"text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/datalineageaudit"]}],"kind":"article","sections":[],"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","title":"Data Lineage & Transformation Audit Trails"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation."}]},{"type":"paragraph","inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"type":"text","text":" automatically generates an immutable audit trail of "},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true,"type":"reference"},{"type":"text","text":" entries for each command evaluated."}]},{"level":2,"text":"LineageRecord Structure","type":"heading","anchor":"LineageRecord-Structure"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true,"type":"reference"},{"type":"text","text":" contains:"}]},{"items":[{"content":[{"inlineContent":[{"code":"stepIndex","type":"codeVoice"},{"text":": Sequential index of the step within the agent trajectory.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"operation","type":"codeVoice"},{"text":": The normalized DSL command executed (e.g., ","type":"text"},{"code":"filter(age)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"groupBy(category,mean)","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"inputRows","type":"codeVoice"},{"text":": Dataset row count immediately prior to transformation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"outputRows","type":"codeVoice"},{"text":": Dataset row count produced by the transformation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"timestamp","type":"codeVoice"},{"text":": The exact timestamp of execution.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Example: Accessing Audit Trails","type":"heading","anchor":"Example-Accessing-Audit-Trails"},{"type":"codeListing","syntax":"swift","code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit"},"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Audit-Types","title":"Audit Types"}],"references":{"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"navigatorTitle":[{"text":"LineageRecord","kind":"identifier"}],"type":"topic","title":"LineageRecord","abstract":[{"type":"text","text":"Represents an immutable audit trail entry recording a discrete data transformation step."}],"kind":"symbol