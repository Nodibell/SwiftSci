{"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftStats\/documentation\/SwiftStats"]]},"metadata":{"role":"article","title":"Hypothesis Testing & ANOVA","roleHeading":"Article","modules":[{"name":"SwiftStats"}]},"identifier":{"url":"doc:\/\/SwiftStats\/documentation\/SwiftStats\/HypothesisTesting","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftStats\/documentation\/SwiftStats\/DescriptiveStatistics"],"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"sections":[],"variants":[{"paths":["\/documentation\/swiftstats\/hypothesistesting"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftStats"},{"type":"text","text":" supports complete inferential statistics with exact p-value and confidence interval calculations."}]},{"level":3,"text":"1. Two-Sample Student’s t-Test","type":"heading","anchor":"1-Two-Sample-Students-t-Test"},{"code":["import SwiftStats","","let groupA: [Double] = [12.1, 14.3, 11.8, 13.5, 15.0]","let groupB: [Double] = [9.8, 10.5, 11.2, 10.1, 9.4]","","let result = Stats.ttest(groupA, groupB)","print(\"t-statistic: \\(result.statistic), p-value: \\(result.pValue)\")","if result.isSignificant {","    print(\"Statistically significant difference (p < 0.05)\")","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"2. One-Way ANOVA","type":"heading","anchor":"2-One-Way-ANOVA"},{"code":["let samples: [[Double]] = [groupA, groupB, [8.5, 9.0, 8.8]]","let anova = Stats.anova(samples)","print(\"F-statistic: \\(anova.statistic), p-value: \\(anova.pValue)\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"text":"Perform Student’s t-tests, paired t-tests, Chi-Square independence tests, and Analysis of Variance (ANOVA).","type":"text"}],"references":{"doc://