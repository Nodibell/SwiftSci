{"sections":[],"metadata":{"modules":[{"name":"SwiftDataFrame"}],"role":"collectionGroup","roleHeading":"API Collection","title":"High-Performance GroupBy & Vectorized Aggregations"},"abstract":[{"type":"text","text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame."}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy"},"topicSections":[{"identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"],"title":"Grouping APIs","anchor":"Grouping-APIs"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory.","type":"text"}]},{"type":"heading","text":"1. Basic GroupBy Aggregation","anchor":"1-Basic-GroupBy-Aggregation","level":2},{"code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"2. Multi-Column Grouping","anchor":"2-Multi-Column-Grouping","level":2},{"type":"paragraph","inlineContent":[{"text":"You can group by multiple categorical dimensions simultaneously:","type":"text"}]},{"code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"3. Performance & Memory Efficiency","anchor":"3-Performance--Memory-Efficiency","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Single-Pass Hash Accumulation"}],"type":"strong"},{"type":"text","text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"vDSP Vector Reductions"}],"type":"strong"},{"type":"text","text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines ("},{"code":"vDSP_sveD","type":"codeVoice"},{"type":"text","text":", "},{"code":"vDSP_meanvD","type":"codeVoice"},{"type":"text","text":")."}]}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","title":"SwiftDataFrame","url":"\/documentation\/swiftdataframe","role":"collection","type":"topic","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"abstract":[{"type":"text","text":"Returns a "},{"code":"GroupedDataFrame","type":"codeVoice"},{"type":"text","text":" for aggregation."}],"title":"groupBy(_:)","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupBy"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"...) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14SwiftDataFrame07GroupedbC0V","text":"GroupedDataFrame"}],"role":"symbol","url":"\/documentation\/swiftdataframe\/dataframe\/groupby(_:)","kind":"symbol","type":"topic"}}}