{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"During autoregressive language generation, logits from the transformer output layer are converted into probability distributions over the vocabulary. ","type":"text"},{"code":"SwiftLLM","type":"codeVoice"},{"text":" executes sampling transformations strictly at the unnormalized logits level prior to softmax evaluation:","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"$$\\text{Logits} \\xrightarrow{\\text{Repetition Penalty}} \\xrightarrow{\\text{Temperature}} \\xrightarrow{\\text{Top-K Mask (-inf)}} \\xrightarrow{\\text{Top-P Mask (-inf)}} \\xrightarrow{\\text{Softmax}} \\xrightarrow{\\text{Sample}}$$","type":"text"}]},{"type":"heading","text":"1. Supported Sampling Methods","anchor":"1-Supported-Sampling-Methods","level":2},{"type":"table","alignments":["left","left","left"],"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Mathematical Formulation"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Semantics & Defaults","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Temperature ("},{"type":"codeVoice","code":"temperature"},{"type":"text","text":")"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"$z_i \\leftarrow z_i \/ T$"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Controls distribution entropy. ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" = identity; ","type":"text"},{"code":"0.0","type":"codeVoice"},{"type":"text","text":" = greedy deterministic argmax. Default: "},{"type":"codeVoice","code":"0.7"},{"type":"text","text":"."}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Top-K ("},{"code":"topK","type":"codeVoice"},{"type":"text","text":")"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Masks all tokens outside top $K$ with $-\\infty$","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Eliminates low-probability tail tokens. "},{"type":"codeVoice","code":"0"},{"type":"text","text":" disables Top-K filtering. Default: "},{"type":"codeVoice","code":"40"},{"type":"text","text":"."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Top-P Nucleus ("},{"code":"topP","type":"codeVoice"},{"type":"text","text":")"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Retains cumulative probability $\\sum P(w_i) \\ge p$","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Dynamically bounds candidates based on probability mass. ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" disables Top-P. Default: ","type":"text"},{"code":"0.9","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Repetition Penalty ("},{"type":"codeVoice","code":"repetitionPenalty"},{"type":"text","text":")"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"$z_i \\leftarrow z_i > 0 \\ ? \\ z_i \/ \\theta : z_i \\cdot \\theta$"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Penalizes tokens previously emitted in generation history. ","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":" disables penalty. Default: ","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":".","type":"text"}]}]]]},{"level":2,"anchor":"2-Configuration--Code-Example","type":"heading","text":"2. Configuration & Code Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generation options are unified within "},{"code":"SamplingConfiguration","type":"codeVoice"},{"type":"text","text":", serving as the single source of truth inside "},{"code":"LLMOptions","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["import SwiftLLM","","\/\/ 1. Define decoupled sampling parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","\/\/ 2. Configure model generation options","let options = LLMOptions(","    maxTokens: 128,","    stopTokens: [128001, 128009],","    sampling: sampling",")","","\/\/ 3. Stream generated tokens asynchronously","for try await token in model.generateStream(prompt: \"Explain rotary positional embeddings:\", options: options) {","    print(token, terminator: \"\")","}"],"syntax":"swift","type":"codeListing"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies"},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"],["doc:\/\/SwiftLLM\/documentation\/SwiftLLM","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference"],["doc:\/\/SwiftLLM\/documentation\/SwiftLLM","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling"]]},"abstract":[{"type":"text","text":"Control autoregressive language generation with Temperature, Top-P Nucleus, Top-K, and Repetition Penalty."}],"topicSections":[{"anchor":"Sampling-Types","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions"],"title":"Sampling Types"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"variants":[{"paths":["\/documentation\/swiftllm\/samplinganddecodingstrategies"],"tr