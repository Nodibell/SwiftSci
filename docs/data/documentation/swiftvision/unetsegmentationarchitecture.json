{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"SwiftVision"}],"roleHeading":"API Collection","title":"Deep Convolutional U-Net Semantic Segmentation","role":"collectionGroup"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"The U-Net architecture is the gold standard for semantic image segmentation, consisting of a contracting path (encoder) to capture context and a symmetric expanding path (decoder) for precise spatial localization, linked via skip connections.","type":"text"}],"type":"paragraph"},{"code":["Input Image ──► [ DoubleConv ] ────────────────────── Skip ─────────────────────► [ Up + Conv ] ──► Mask","                     │                                                                ▲","                  [ Down ] ──► [ DoubleConv ] ──────── Skip ───────► [ Up + Conv ] ───┘","                                   │                                     ▲","                                [ Down ] ──► [ Bottleneck Conv ] ────────┘"],"type":"codeListing","syntax":null},{"level":2,"type":"heading","text":"1. Initializing and Running U-Net","anchor":"1-Initializing-and-Running-U-Net"},{"code":["import SwiftVision","","\/\/ Initialize U-Net on Apple Silicon Metal GPU","let unet = UNetArchitecture(inChannels: 3, outChannels: 1, baseFeatures: 32)","","\/\/ Forward pass on image tensor (Batch x Height x Width x Channels)","let imageTensor = try ImageTensorLoader.load(url: URL(fileURLWithPath: \"sample.jpg\"))","let maskOutput = try unet.forward(image: imageTensor)","","print(\"Output mask dimensions: \\(maskOutput.shape)\")"],"type":"codeListing","syntax":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetSegmentationArchitecture","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftvision\/unetsegmentationarchitecture"]}],