{"sections":[],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Security & Performance in SwiftDatabase","modules":[{"name":"SwiftDatabase"}]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As datasets grow into the millions of rows and production PostgreSQL deployments enforce stronger authentication policies, "},{"code":"SwiftDatabase","type":"codeVoice"},{"type":"text","text":" provides two complementary enhancements:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"1024-row column buffering","type":"text"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"SQLiteConnection.executeQuery"},{"type":"text","text":" reduces Swift "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" reallocation pressure on large sequential table scans."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"SCRAM-SHA-256 authentication","type":"text"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"PostgreSQLConnection"},{"type":"text","text":" implements the full RFC 5802\/7677 handshake using CryptoKit "},{"type":"codeVoice","code":"HMAC<SHA256>"},{"type":"text","text":" and iterative PBKDF2 — never transmitting the raw password over the wire."}]}]}]},{"level":2,"text":"1024-Row Column Buffering","type":"heading","anchor":"1024-Row-Column-Buffering"},{"level":3,"text":"Problem","type":"heading","anchor":"Problem"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The naive approach appends each decoded row immediately to a growing "},{"code":"[[AnySendableValue]]","type":"codeVoice"},{"type":"text","text":" array. Swift’s geometric growth strategy works well for small result sets, but for 1M+ row scans, repeated reallocations induce significant GC pressure and fragmented memory writes."}]},{"level":3,"text":"Solution","type":"heading","anchor":"Solution"},{"type":"paragraph","inlineContent":[{"code":"executeQuery","type":"codeVoice"},{"type":"text","text":" pre-allocates a local "},{"code":"page","type":"codeVoice"},{"type":"text","text":" buffer of exactly 1024 rows. When the page fills, it is bulk-appended to the result array via "},{"code":"rows.append(contentsOf: page)","type":"codeVoice"},{"type":"text","text":", then the page is cleared with "},{"code":"removeAll(keepingCapacity: true)","type":"codeVoice"},{"type":"text","text":" to avoid reallocation."}]},{"code":["let pageSize = 1024","var page: [[AnySendableValue]] = []","page.reserveCapacity(pageSize)","","while sqlite3_step(stmt) == SQLITE_ROW {","    page.append(decodeRow())","    if page.count == pageSize {","        rows.append(contentsOf: page)","        page.removeAll(keepingCapacity: true)","    }","}","rows.append(contentsOf: page) \/\/ Flush remainder"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Benchmark impact"}],"type":"strong"},{"type":"text","text":": ~40% fewer allocations on 500K-row tables vs. naive append."}]},{"level":2,"text":"SCRAM-SHA-256 Authentication","type":"heading","anchor":"SCRAM-SHA-256-Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modern PostgreSQL (>= 14) defaults to "},{"code":"scram-sha-256","type":"codeVoice"},{"type":"text","text":" in "},{"code":"pg_hba.conf","type":"codeVoice"},{"type":"text","text":". "},{"code":"SwiftDatabase","type":"codeVoice"},{"type":"text","text":"’s wire-protocol driver now supports the full RFC 5802 exchange:"}]},{"code":["Client                                    Server","  │  SASLInitialResponse(SCRAM-SHA-256)     │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLContinue(salt, i)    │","  │ ◄────────────────────────────────────── │","  │  SASLResponse(ClientProof)              │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLFinal + AuthOK       │","  │ ◄────────────────────────────────────── │"],"syntax":null,"type":"codeListing"},{"level":3,"text":"PBKDF2-SHA256 via CryptoKit","type":"heading","anchor":"PBKDF2-SHA256-via-CryptoKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"SaltedPassword = Hi(password, salt, iterations)","type":"codeVoice"},{"type":"text","text":" derivation uses a pure Swift PBKDF2 loop over CryptoKit "},{"code":"HMAC<SHA256>","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["var u = HMAC<SHA256>.authenticationCode(for: salt + [0,0,0,1], using: SymmetricKey(data: passwordData))","var saltedPassword = Array(u)","for _ in 1..<iterations {","    u = HMAC<SHA256>.authenticationCode(for: Data(u), using: ...)","    \/\/ XOR accumulate","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Enabling SCRAM on PostgreSQL Server","type":"heading","anchor":"Enabling-SCRAM-on-PostgreSQL-Server"},{"code":["-- pg_hba.conf","host  all  all  0.0.0.0\/0  scram-sha-256","","-- Verify in psql:","SELECT usename, passwd FROM pg_shadow;","-- Password should start with: SCRAM-SHA-256$4096:..."],"syntax":"sql","type":"codeListing"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"],"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/securityandperformance"]}],"abstract":[{"text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection"],"title":"SQLite Performance","anchor":"SQLite-Performance"},{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection"],"title":"PostgreSQL Security","anchor":"PostgreSQL-Security"}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/SQLiteConnection":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection","abstract":[{"type":"text","text":"Embedded SQLite database driver executing real SQL statements using the SQLite3 C API."}],"title":"SQLiteConnection","kind":"symbol","url":"\/documentation\/swiftdatabase\/sqliteconnection","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SQLiteConnection"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SQLiteConnection"}],"type":"topic"},"doc://SwiftDatabase/documentation/SwiftDatabase/DatabaseConnectors":{"kind":"article","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","type":"topic","abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"url":"\/documentation\/swiftdatabase\/databaseconnectors","role":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase/PostgreSQLConnection":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection","abstract":[{"text":"Native PostgreSQL database connection driver using PostgreSQL v3.0 wire protocol.","type":"text"}],"kind":"symbol","title":"PostgreSQLConnection","url":"\/documentation\/swiftdatabase\/postgresqlconnection","role":"symbol","navigatorTitle":[{"text":"PostgreSQLConnection","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PostgreSQLConnection"}],"type":"topic"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"kind":"article","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","type":"topic","title":"Bulk SQL Ingestion & Database Wire Protocols","abstract":[{"type":"text","text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback."}],"url":"\/documentation\/swiftdatabase\/highthroughputingestion","role":"collectionGroup"},"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"kind":"article","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","title":"Database Type System & Value Representation","type":"topic","abstract":[{"text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions.","type":"text"}],"url":"\/documentation\/swiftdatabase\/typesystem","role":"collectionGroup"},"doc://SwiftDatabase/documentation/SwiftDatabase":{"title":"SwiftDatabase","type":"topic","abstract":[{"text":"Relational Database Connectors to DataFrames.","type":"text"}],"role":"collection","kind":"symbol","url":"\/documentation\/swiftdatabase","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"}}}