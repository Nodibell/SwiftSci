agments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LLMConfig","kind":"identifier"}],"abstract":[{"text":"Architectural hyperparameter configuration for a decoder-only Transformer language model.","type":"text"}]}}}