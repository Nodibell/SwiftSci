n and predict from prepared classification data","role":"article","type":"topic","url":"\/documentation\/swiftml\/preparedclassification","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedClassification"},"doc://SwiftML/documentation/SwiftML/BoundedInference":{"type":"topic","abstract":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"CoreMLBatchPipeline.run"},{"type":"text","text":" to pull batches through fitted preprocessing and a fixed-shape Core ML model. The pipeline holds capacity until each result consumer returns."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/BoundedInference","url":"\/documentation\/swiftml\/boundedinference","title":"Run bounded batch inference","kind":"article","role":"article"},"doc://SwiftML/documentation/SwiftML/EnsembleLearning":{"type":"topic","abstract":[{"text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism.","type":"text"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","url":"\/documentation\/swiftml\/ensemblelearning","title":"Ensemble Learning: Random Forests & Gradient Boosted Trees","kind":"article","role":"collectionGroup"},"doc://SwiftML/documentation/SwiftML/EarlyStoppingCallbacks":{"title":"Early Stopping & Generalization Control","type":"topic","kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","role":"collectionGroup","url":"\/documentation\/swiftml\/earlystoppingcallbacks","abstract":[{"type":"text","text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting."}]},"doc://SwiftML/documentation/SwiftML":{"title":"SwiftML","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","role":"collection","url":"\/documentation\/swiftml","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}]},"doc://SwiftML/documentation/SwiftML/SupervisedRegressors":{"type":"topic","abstract":[{"type":"text","text":"Perform continuous target predictions using LinearRegression (exact OLS), DecisionTreeRegressor, and GradientBoostedTreesRegressor."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","url":"\/documentation\/swiftml\/supervisedregressors","title":"Supervised Regression Models","kind":"article","role":"article"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingRegressor":{"type":"topic","abstract":[{"text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular regression.","type":"text"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","navigatorTitle":[{"kind":"identifier","text":"HistGradientBoostingRegressor"}],"url":"\/documentation\/swiftml\/histgradientboostingregressor","title":"HistGradientBoostingRegressor","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistGradientBoostingRegressor"}],"kind":"symbol","role":"symbol"},"doc://SwiftML/documentation/SwiftML/MLOpsExport":{"abstract":[{"type":"text","text":"Export trained SwiftSci estimators to native Apple Core ML ("},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":") and cross-platform ONNX ("},{"type":"codeVoice","code":".onnx"},{"type":"text","text":") binary artifacts for production deployment."}],"kind":"article","title":"Exporting Models to Core ML and ONNX","role":"collectionGroup","type":"topic","url":"\/documentation\/swiftml\/mlopsexport","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport"}}}