{"kind":"article","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Permutation Feature Importance & Model Diagnostics","modules":[{"name":"SwiftExplain"}],"role":"collectionGroup","roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"abstract":[{"text":"Measure true feature importance by evaluating loss degradation after shuffling feature columns.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationFeatureImportance"},"topicSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationImportance"],"anchor":"Diagnostic-Tools","title":"Diagnostic Tools"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"inlineContent":[{"text":"Permutation Feature Importance","type":"text"}],"type":"strong"},{"text":" measures how much a trained model’s error increases when a single feature column is randomly shuffled, breaking the relationship between that feature and the target outcome.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"$$\\text{Importance}(f_j) = L(X_{\\text{shuffled}(j)}, y) - L(X, y)$$","type":"text"}],"type":"paragraph"},{"text":"1. Computing Permutation Importance","level":2,"type":"heading","anchor":"1-Computing-Permutation-Importance"},{"syntax":"swift","type":"codeListing","code":["import SwiftExplain","import SwiftML","","let importance = try await PermutationImportance.compute(","    model: trainedModel,","    features: X_val,","    targets: y_val,","    metric: .meanSquaredError,","    nRepeats: 10",")","","for (idx, score) in importance.enumerated() {","    print(\"Feature \\(idx): Mean drop = \\(score.mean), Std = \\(score.std)\")","}"]}]}],"variants":[{"paths":["\/documentation\/swiftexplain\/permutationfeatureimportance"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftExplain/documentation/SwiftExplain/PermutationImportance":{"kind":"symbol","title":"PermutationImportance","navigatorTitle":[{"kind":"identifier","text":"PermutationImportance"}],"url":"\/documentation\/swiftexplain\/permutationimportance","abstract":[{"text":"Permutation Feature Importance calculator.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PermutationImportance"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationImportance","type":"topic","role":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain":{"kind":"symbol","title":"SwiftExplain","url":"\/documentation\/swiftexplain","abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","type":"topic","role":"collection"}}}