{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling"},"metadata":{"modules":[{"name":"SwiftPreprocessing"}],"roleHeading":"Article","role":"article","title":"Feature Scaling, Normalization & Flat 1D Memory"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"abstract":[{"text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using ","type":"text"},{"code":"StandardScaler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MinMaxScaler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RobustScaler","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Normalizer","type":"codeVoice"},{"text":" powered by Apple Accelerate ","type":"text"},{"code":"vDSP","type":"codeVoice"},{"text":".","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Feature scaling is crucial for gradient-based estimators (Neural Networks, Logistic Regression) and distance-based estimators (KNN, DBSCAN, SVM). Without scaling, features with large numeric scales disproportionately dominate distance calculations and gradient updates.","type":"text"}]},{"type":"thematicBreak"},{"anchor":"%E2%9A%A1-Flat-1D-Memory-Layout--Hardware-Vectorization","text":"⚡ Flat 1D Memory Layout & Hardware Vectorization","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftPreprocessing"},{"text":" operates on contiguous 1D row-major flat buffers ","type":"text"},{"type":"codeVoice","code":"[Double]"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"[Float]"},{"text":") with stride indexing ","type":"text"},{"type":"codeVoice","code":"index = row * cols + col"},{"text":":","type":"text"}]},{"syntax":null,"code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"All arithmetic operations (","type":"text"},{"type":"codeVoice","code":"vDSP_vsubD"},{"text":", ","type":"text"},{"type":"codeVoice","code":"vDSP_vsdivD"},{"text":", ","type":"text"},{"type":"codeVoice","code":"vDSP.sort"},{"text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections.","type":"text"}]},{"type":"thematicBreak"},{"anchor":"1-StandardScaler-Z-Score-Standardization","text":"1. `StandardScaler` (Z-Score Standardization)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Transforms features to have zero mean (","type":"text"},{"type":"codeVoice","code":"μ = 0"},{"text":") and unit variance (","type":"text"},{"type":"codeVoice","code":"σ² = 1"},{"text":"):","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"z = (x - μ) \/ σ"}]}],"style":"note","type":"aside","name":"Note"},{"syntax":"swift","code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"anchor":"2-MinMaxScaler-Bounded-Range-Scaling","text":"2. `MinMaxScaler` (Bounded Range Scaling)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Linearly transforms features into a bounded range ","type":"text"},{"type":"codeVoice","code":"[a, b]"},{"text":" (defaults to ","type":"text"},{"type":"codeVoice","code":"[0, 1]"},{"text":"):","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)"}]}],"style":"note","type":"aside","name":"Note"},{"syntax":"swift","code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"anchor":"3-RobustScaler-Median--IQR-Scaling","text":"3. `RobustScaler` (Median & IQR Scaling)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"When datasets contain extreme outliers, mean and standard deviation are distorted. ","type":"text"},{"type":"codeVoice","code":"RobustScaler"},{"text":" scales features using the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Median"}]},{"text":" and ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Interquartile Range (IQR = Q3 - Q1)"}]},{"text":":","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"x' = (x - Median) \/ IQR"}]}],"style":"note","type":"aside","name":"Note"},{"syntax":"swift","code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling","text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Scales each sample independently to have unit L1, L2, or Max norm:","type":"text"}]},{"syntax":"swift","code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Memory & Performance Tip:"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput."}]}],"style":"note","type":"aside","name":"Note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/featurescaling"]}],"kind":"article","references":{