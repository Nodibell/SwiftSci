{"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies.","type":"text"}]},{"type":"heading","level":3,"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","text":"1. Multi-lingual Word & Sentence Tokenization"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"]},{"type":"heading","level":3,"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","text":"2. POS Tagging, Lemmatization & Entity Extraction"},{"type":"codeListing","syntax":"swift","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"]},{"type":"heading","level":3,"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","text":"3. Sentiment Analysis (VADER & NLSentiment)"},{"type":"codeListing","syntax":"swift","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization"},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ChatAPI","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LlamaTokenizer"],"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"type":"codeVoice","code":"NaturalLanguage"},{"type":"text","text":" framework."}],"metadata":{"modules":[{"name":"SwiftNLP"}],"role":"article","title":"Text Normalization, Tokenization & Linguistic Tagging","roleHeading":"Article"},"references":{"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"kind":"article","title":"Text Feature Vectorization, Sparse TF-IDF & Local Embeddings","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","role":"article","abstract":[{"text":"Convert text corpora into numerical and sparse feature matrices using ","type":"text"},{"code":"TFIDFVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CountVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HashingVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SparseVector","type":"codeVoice"},{"t