{"abstract":[{"text":"Randomized Singular Value Decomposition using the Halko et al. (2011) algorithm.","type":"text"}],"metadata":{"symbolKind":"enum","modules":[{"name":"SwiftCluster"}],"externalID":"s:12SwiftCluster13RandomizedSVDO","roleHeading":"Enumeration","navigatorTitle":[{"text":"RandomizedSVD","kind":"identifier"}],"title":"RandomizedSVD","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RandomizedSVD","kind":"identifier"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/RandomizedSVD\/Result"],"generated":true},{"title":"Type Methods","generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/RandomizedSVD\/compute(X:nComponents:nOversamples:nPowerIter:seed:)","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/RandomizedSVD\/svdFlip(u:vt:uBasedDecision:)"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/PreparedPCA","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/PCA","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/TSNE"],"generated":true,"title":"Dimensionality Reduction","anchor":"Dimensionality-Reduction"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RandomizedSVD"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Computes an approximate rank-k SVD of an M×N matrix A:","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"A ≈ U * diag(S) * Vᵀ"}],"type":"paragraph"},{"inlineContent":[{"text":"where U is M×k orthonormal, S is k-vector of singular values, Vᵀ is k×N.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Complexity","anchor":"Complexity","type":"heading"},{"inlineContent":[{"text":"Range sketch + power iterations + projection run in (O(M \\cdot N \\cdot l \\cdot (q + 1))) floating-point work","type":"text"},{"text":" ","type":"text"},{"text":"(with QR on an (M \\times l) sketch and exact SVD on an (l \\times N) core matrix, where (l = \\min(\\min(M, N), k + p))),","type":"text"},{"text":" ","type":"text"},{"text":"dramatically faster than full ","type":"text"},{"code":"dgesdd_","type":"codeVoice"},{"text":" (O(M \\cdot N \\cdot \\min(M, N))) when (k \\ll \\min(M, N)).","type":"text"}],"type":"paragraph"},{"level":2,"text":"Algorithm (Halko 2011)","anchor":"Algorithm-Halko-2011","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Draw random Gaussian matrix (\\Omega \\in \\mathbb{R}^{N \\times l}) where (l = \\min(\\min(M, N), k + p))."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Compute range sketch (Y = A \\cdot \\Omega) via BLAS "},{"type":"codeVoice","code":"dgemm"},{"type":"text","text":" with (q) subspace power iterations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Orthonormalize (Y) via thin QR ("},{"type":"codeVoice","code":"dgeqrf"},{"type":"text","text":" + "},{"type":"codeVoice","code":"dorgqr"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Project (B = Q^T \\cdot A) (small (l \\times N) matrix)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Compute small exact SVD of (B) with "},{"type":"codeVoice","code":"dgesdd_"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Back-project left singular vectors: (U = Q \\cdot \\tilde{U})."}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"Accuracy","anchor":"Accuracy","type":"heading"},{"inlineContent":[{"text":"Probabilistic error follows Halko, Martinsson, & Tropp (2011) bounds governed by singular-value decay,","type":"text"},{"text":" ","type":"text"},{"text":"oversampling ","type":"text"},{"code":"nOversamples","type":"codeVoice"},{"text":" (","type":"text"},{"code":"p","type":"codeVoice"},{"text":"), and power iterations ","type":"text"},{"code":"nPowerIter","type":"codeVoice"},{"text":" (","type":"text"},{"code":"q","type":"codeVoice"},{"text":"); this is not an unconditional","type":"text"},{"text":" ","type":"text"},{"text":"deterministic (1 + \\varepsilon) guarantee for flat or slow-decay spectra.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Reference","anchor":"Reference","type":"heading"},{"inlineContent":[{"text":"Halko N., Martinsson P.G., Tropp J.A. (2011). Finding Structure with Randomness:","type":"text"},{"text":" ","type":"text"},{"text":"Probabilistic Algorithms for Constructing Approximate Matrix Decompositions.","type":"text"},{"text":" ","type":"text"},{"text":"SIAM Review 53(2):217–288.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftcluster\/randomizedsvd"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/RandomizedSVD","interfaceLanguage":"swift"},"sections":[],"references":{"doc://SwiftCluster/documentation/SwiftCluster/RandomizedSVD/compute(X:nComponents:nOversamples:nPowerIter:seed:)":{"role":"symbol","url":"\/documentation\/swiftcluster\/randomizedsvd\/compute(x:ncomponents:noversamples:npoweriter:seed:)","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/RandomizedSVD\/compute(X:nComponents:nOversamples:nPowerIter:seed:)","type":"topic","title":"compute(X:nComponents:nOversamples:nPowerIter:seed:)","abstract":[{"text":"Computes an approximate rank-k SVD of matrix X (row-major, M rows × N cols).","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text