{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"topicSections":[{"anchor":"SHAP-Explainer-APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"title":"SHAP Explainer APIs"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/kernelshaptheory"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory"},"abstract":[{"type":"text","text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model."}],"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}],"type":"strong"},{"type":"text","text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory."}],"type":"paragraph"},{"level":2,"type":"heading","text":"1. The Four Shapley Axioms","anchor":"1-The-Four-Shapley-Axioms"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Efficiency","type":"text"}]},{"text":": Feature attributions sum up to the difference between model prediction ","type":"text"},{"code":"f(x)","type":"codeVoice"},{"type":"text","text":" and expected background prediction "},{"type":"codeVoice","code":"E[f(X)]"},{"type":"text","text":":"}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}]}],"name":"Note"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Symmetry"}],"type":"strong"},{"type":"text","text":": If two features contribute equally to all possible feature subsets, their attributions are equal."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Dummy (Null Player)","type":"text"}]},{"text":": A feature that does not change the model prediction for any coalition receives an attribution of zero (","type":"text"},{"code":"φ_i = 0","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Additivity","type":"text"}]},{"text":": For ensemble models ","type":"text"},{"code":"f = f1 + f2","type":"codeVoice"},{"text":", attributions satisfy ","type":"text"},{"code":"φ_i(f) = φ_i(f1) + φ_i(f2)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"text":"2. Explaining Predictions in SwiftSci","anchor":"2-Explaining-Predictions-in-SwiftSci","type":"heading","level":2},{"syntax":"swift","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"],"type":"codeListing"}],"kind":"content"}],"metadata":{"modules":[{"name":"SwiftExplain"}],"role":"collectionGroup","title":"Game-Theoretic Interpretability with Kernel SHAP","roleHeading":"API Collection"},"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"url":"\/documentation\/swiftexplain\/kernelshap","navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KernelSHAP"}],"kind":"symbol","type":"topic","title":"KernelSHAP","role":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain":{"abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"title":"SwiftExplain","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","url":"\/documentation\/swiftexplain","role":"collection"}}}