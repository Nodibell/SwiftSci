{"abstract":[{"text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate.","type":"text"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftCluster"}],"title":"In-Memory VectorStore & On-Device RAG"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Vector databases are essential for modern semantic search and AI agent knowledge retrieval. "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"VectorStore"},{"type":"text","text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations ("},{"type":"codeVoice","code":"vDSP_dotprD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_svesqD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_distancesqD"},{"type":"text","text":")."}],"type":"paragraph"},{"level":2,"text":"1. Creating a VectorStore","anchor":"1-Creating-a-VectorStore","type":"heading"},{"code":["import SwiftCluster","import SwiftNLP","","\/\/ Initialize vector store with Cosine Similarity","let store = VectorStore(metric: .cosineSimilarity)","","\/\/ Generate dense text embeddings","let engine = LocalEmbeddingEngine(dimension: 128)","","let articles = [","    (id: \"art_1\", title: \"Apple Silicon Architecture\", text: \"Unified memory and neural engine overview\"),","    (id: \"art_2\", title: \"Swift Strict Concurrency\", text: \"Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"2. Top-K Semantic Search","anchor":"2-Top-K-Semantic-Search","type":"heading"},{"code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"3. Supported Metrics","anchor":"3-Supported-Metrics","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".cosineSimilarity"}],"type":"strong"},{"type":"text","text":": Ideal for normalized text embeddings (returns "},{"code":"[-1.0, 1.0]","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".dotProduct","type":"codeVoice"}]},{"type":"text","text":": Direct inner product for unnormalized projections."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".euclideanDistance"}],"type":"strong"},{"text":": Geometric L2 distance for spatial clustering.","type":"text"}]}]}],"type":"unorderedList"}]}],"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"kind":"article","topicSections":[{"title":"Vector Store Types","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"],"anchor":"Vector-Store-Types"}],"variants":[{"paths":["\/documentation\/swiftcluster\/vectorstoreandrag"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiftCluster/documentation/SwiftCluster/VectorMetric":{"abstract":[{"type":"text","text":"Distance or similarity metrics supported by "},{"type":"reference","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","isActive":true},{"type":"text","text":"."}],"navigatorTitle":[{"text":"VectorMetric","kind":"identifier"}],"title":"VectorMetric","kind":"symbol","role":"symbol","url":"\/documentation\/swiftcluster\/vectormetric","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorMetric","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"},"doc://SwiftCluster/documentation/SwiftCluster":{"abstract":[{"text":"PCA Dimensionality Reduction & Unsupervised Clustering.","type":"text"}],"role":"collection","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster","title":"SwiftCluster","kind":"symbol","url":"\/documentation\/swiftcluster"},"doc://SwiftCluster/documentation/SwiftCluster/VectorStore":{"title":"VectorStore","kind":"symbol","role":"symbol","url":"\/documentation\/swiftcluster\/vectorstore","abstract":[{"type":"text","text":"An in-memory vector database and similarity search index optimized for Apple Silicon."}],"type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"VectorStore"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","navigatorTitle":[{"kind":"identifier","text":"VectorStore"}]},"doc://SwiftCluster/documentation/SwiftCluster/VectorSearchResult":{"title":"VectorSearchResult","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorSearchResult","kind":"identifier"}],"navigatorTitle":[{"text":"VectorSearchResult","kind":"identifier"}],"url":"\/documentation\/swiftcluster\/vectorsearchresult","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","abstract":[{"type":"text","text":"Represents a single nearest-neighbor match result from a vector search query."}],"type":"topic"}}}