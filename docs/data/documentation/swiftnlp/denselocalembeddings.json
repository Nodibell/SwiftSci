{"variants":[{"paths":["\/documentation\/swiftnlp\/denselocalembeddings"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon.","type":"text"}],"kind":"article","topicSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"],"anchor":"Embedding-APIs","title":"Embedding APIs"}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"metadata":{"modules":[{"name":"SwiftNLP"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Dense Local Text Embeddings with Accelerate"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Modern Retrieval-Augmented Generation (RAG) and semantic search systems require dense vector representations of text. Traditional approaches depend on remote APIs (e.g. OpenAI) or large multi-gigabyte models that exhaust memory. ","type":"text"},{"code":"SwiftNLP","type":"codeVoice"},{"text":" introduces ","type":"text"},{"code":"LocalEmbeddingEngine","type":"codeVoice"},{"text":", a subword N-gram character hashing projection engine that produces deterministic, unit-normalized dense embeddings in sub-millisecond execution times.","type":"text"}],"type":"paragraph"},{"level":2,"text":"1. Algorithmic Foundation","anchor":"1-Algorithmic-Foundation","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"LocalEmbeddingEngine","type":"codeVoice"},{"text":" operates through a three-stage mathematical pipeline:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Subword N-gram Hashing"}],"type":"strong"},{"text":": Text is tokenized into word and character n-grams (sizes 3 to 6). Each n-gram is hashed into a fixed integer space using FNV-1a hash functions.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Dimension Projection"}],"type":"strong"},{"text":": Hashes are projected onto a ","type":"text"},{"code":"D","type":"codeVoice"},{"text":"-dimensional vector space (e.g., ","type":"text"},{"code":"D = 128","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"D = 256","type":"codeVoice"},{"text":") with deterministic sign flips to prevent feature collision bias.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Unit L2 Normalization"}],"type":"strong"},{"text":": The resulting dense vector is projected onto the unit hypersphere:","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"v_norm = v \/ ||v||_2 = v \/ sqrt(Σ v_i²)","type":"codeVoice"}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Because all embeddings have ","type":"text"},{"code":"||v||_2 = 1.0","type":"codeVoice"},{"text":", the ","type":"text"},{"type":"strong","inlineContent":[{"text":"Cosine Similarity","type":"text"}]},{"text":" between two embeddings is equivalent to their direct ","type":"text"},{"type":"strong","inlineContent":[{"text":"Dot Product","type":"text"}]},{"text":", allowing single-instruction vector evaluation via Apple Accelerate ","type":"text"},{"code":"vDSP_dotprD","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"CosineSimilarity(u, v) = u · v","type":"codeVoice"}]}],"type":"aside","style":"note"},{"level":2,"text":"2. Generating Embeddings","anchor":"2-Generating-Embeddings","type":"heading"},{"syntax":"swift","code":["import SwiftNLP","","\/\/ Initialize a 128-dimensional local embedding engine","let engine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Generate embedding for a single text snippet","let vector = engine.embed(\"Apple Silicon M3 Max neural network processing\")","print(\"Vector dimension: \\(vector.count)\") \/\/ 128","","\/\/ Batch embedding generation","let documents = [","    \"High-performance computing on macOS\",","    \"Relational database wire protocol drivers\",","    \"Deep convolutional neural networks for vision\"","]","let batchEmbeddings = engine.embedBatch(documents)"],"type":"codeListing"},{"level":2,"text":"3. Integration with SwiftCluster.VectorStore","anchor":"3-Integration-with-SwiftClusterVectorStore","type":"heading"},{"syntax":"swift","code":["import SwiftCluster","","let store = VectorStore(metric: .cosineSimilarity)","","for (idx, doc) in documents.enumerated() {","    let vec = engine.embed(doc)","    store.add(id: \"doc_\\(idx)\", vector: vec, metadata: [\"text\": doc])","}","","\/\/ Perform instant semantic similarity search","let query = engine.embed(\"Mac hardware acceleration\")","let topHits = store.search(query: query, topK: 1)","print(\"Top match: \\(topHits.first?.metadata[\"text\"] ?? \"\")\")"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","url":"\/documentation\/swiftnlp\/localembeddingengine","kind":"symbol","role":"symbol","title":"LocalEmbeddingEngine","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LocalEmbeddingEngine","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"LocalEmbeddingEngine","kind":"identifier"}],"abstract":[{"text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon.","type":"text"}]},"doc://SwiftNLP/documentation/SwiftNLP":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"role":"collection","kind":"symbol","type":"topic","title":"SwiftNLP","url":"\/documentation\/swiftnlp"}}}