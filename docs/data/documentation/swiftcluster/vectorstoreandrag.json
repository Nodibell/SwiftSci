{"metadata":{"role":"collectionGroup","title":"In-Memory VectorStore & On-Device RAG","modules":[{"name":"SwiftCluster"}],"roleHeading":"API Collection"},"topicSections":[{"anchor":"Vector-Store-Types","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"],"title":"Vector Store Types"}],"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"],"generated":true,"title":"Guides & Tutorials"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"variants":[{"paths":["\/documentation\/swiftcluster\/vectorstoreandrag"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Vector databases are essential for modern semantic search and AI agent knowledge retrieval. ","type":"text"},{"code":"SwiftCluster","type":"codeVoice"},{"text":" provides ","type":"text"},{"code":"VectorStore","type":"codeVoice"},{"text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations (","type":"text"},{"code":"vDSP_dotprD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_svesqD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_distancesqD","type":"codeVoice"},{"text":").","type":"text"}]},{"level":2,"text":"1. Creating a VectorStore","type":"heading","anchor":"1-Creating-a-VectorStore"},{"code":["import SwiftCluster","import SwiftNLP","","\/\/ Initialize vector store with Cosine Similarity","let store = VectorStore(metric: .cosineSimilarity)","","\/\/ Generate dense text embeddings","let engine = LocalEmbeddingEngine(dimension: 128)","","let articles = [","    (id: \"art_1\", title: \"Apple Silicon Architecture\", text: \"Unified memory and neural engine overview\"),","    (id: \"art_2\", title: \"Swift Strict Concurrency\", text: \"Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"2. Top-K Semantic Search","type":"heading","anchor":"2-Top-K-Semantic-Search"},{"code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"3-Supported-Metrics","level":2,"text":"3. Supported Metrics","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".cosineSimilarity"}]},{"type":"text","text":": Ideal for normalized text embeddings (returns "},{"type":"codeVoice","code":"[-1.0, 1.0]"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".dotProduct"}]},{"type":"text","text":": Direct inner product for unnormalized projections."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".euclideanDistance"}]},{"type":"text","text":": Geometric L2 distance for spatial clustering."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","references":{"doc://SwiftCluster/documentation/SwiftCluster/VectorStore":{"title":"VectorStore","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","url":"\/documentation\/swiftcluster\/vectorstore","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorStore","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"VectorStore"}],"abstract":[{"type":"text","text":"An in-memory vector database and similarity search index optimized for Apple Silicon."}],"kind":"symbol"},"doc://SwiftCluster/documentation/SwiftCluster/VectorSearchResult":{"title":"VectorSearchResult","url":"\/documentation\/swiftcluster\/vectorsearchresult","abstract":[{"type":"text","text":"Represents a single nearest-neighbor match result from a vector search query."}],"kind":"symbol","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","role":"symbol","navigatorTitle":[{"text":"VectorSearchResult","kind":"identifier"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VectorSearchResult"}]},"doc://SwiftCluster/documentation/SwiftCluster/ClusteringAndOutliers":{"url":"\/documentation\/swiftcluster\/clusteringandoutliers","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","type":"topic","role":"article","abstract":[{"type":"text","text":"High-performance clustering and density-based anomaly detection powered by "},{"type":"codeVoice","code":"KDTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"DBSCAN"},{"type":"text","text":", "},{"type":"codeVoice","code":"