{"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Sparse Data Types","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"],"anchor":"Sparse-Data-Types"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x."}]},{"type":"heading","level":2,"anchor":"Storage-Formats","text":"Storage Formats"},{"type":"heading","level":3,"anchor":"Compressed-Sparse-Row-CSR","text":"Compressed Sparse Row (CSR)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stores non-zero values row-by-row:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"values"},{"text":": Non-zero numerical entries.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"colIndices"},{"text":": Column indices corresponding to each entry in ","type":"text"},{"type":"codeVoice","code":"values"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"rowPointers"},{"text":": Offsets into ","type":"text"},{"type":"codeVoice","code":"values"},{"text":" marking where each row begins (length: ","type":"text"},{"type":"codeVoice","code":"rowCount + 1"},{"text":").","type":"text"}]}]}]},{"type":"codeListing","code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"],"syntax":null},{"type":"heading","level":3,"anchor":"Compressed-Sparse-Column-CSC","text":"Compressed Sparse Column (CSC)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication."}]},{"type":"heading","level":2,"anchor":"Apple-Accelerate-Sparse-BLAS","text":"Apple Accelerate Sparse BLAS"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_matrix_create_double"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_insert_row_double"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_commit"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_matrix_vector_product_dense_double"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput."}]},{"type":"heading","level":2,"anchor":"Example-Usage","text":"Example Usage"},{"type":"codeListing","code":["import SwiftPreprocessing","","\/\/ 1. Create a sparse matrix from a dense array","let dense: [[Double]] = [","    [1.0, 0.0, 0.0],","    [0.0, 2.0, 0.0],","    [0.0, 0.0, 3.0]","]","let sparse = SparseMatrix(dense: dense, format: .csr)","print(\"Sparsity: \\(sparse.sparsity)\") \/\/ ~ 0.667","","\/\/ 2. Accelerated matrix-vector product","let x = [1.0, 2.0, 3.0]","let y = try sparse.multiply(vector: x)","print(y) \/\/ [1.0, 4.0, 9.0]","","\/\/ 3. Matrix Transpose & CSC conversion","let csc = sparse.toCSC()","let transposed = sparse.transpose()"],"syntax":"swift"}]}],"metadata":{"role":"collectionGroup","title":"Memory-Efficient Sparse Matrix Representations","roleHeading":"API Collection","modules":[{"name":"SwiftPreprocessing"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"]}],"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"],"anchor":"Guides--Tutorials"}],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats."}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"sections":[],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseMatrix":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparseMatrix"}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SparseMatrix"}],"title":"SparseMatrix","abstract":[{"type":"text","text":"Memory-efficient sparse matrix storage implementing Compressed Sparse Row (CSR) and Column (CSC) formats."}],"kind":"symbol","url":"\/documentation\/swiftpreprocessing\/sparsematrix"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessin