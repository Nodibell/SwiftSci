{"kind":"article","metadata":{"modules":[{"name":"SwiftDataFrame"}],"roleHeading":"API Collection","title":"High-Performance GroupBy & Vectorized Aggregations","role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"anchor":"Grouping-APIs","title":"Grouping APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory."}],"type":"paragraph"},{"level":2,"text":"1. Basic GroupBy Aggregation","anchor":"1-Basic-GroupBy-Aggregation","type":"heading"},{"syntax":"swift","code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"],"type":"codeListing"},{"level":2,"text":"2. Multi-Column Grouping","anchor":"2-Multi-Column-Grouping","type":"heading"},{"inlineContent":[{"text":"You can group by multiple categorical dimensions simultaneously:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"],"type":"codeListing"},{"level":2,"text":"3. Performance & Memory Efficiency","anchor":"3-Performance--Memory-Efficiency","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Single-Pass Hash Accumulation","type":"text"}],"type":"strong"},{"text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"vDSP Vector Reductions"}],"type":"strong"},{"text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines (","type":"text"},{"code":"vDSP_sveD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_meanvD","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"abstract":[{"text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}],"title":"SwiftDataFrame","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","role":"collection","url":"\/documentation\/swiftdataframe","type":"topic"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"url":"\/documentation\/swiftdataframe\/dataframe\/groupby(_:)","abstract":[{"text":"Returns a ","type":"text"},{"code":"GroupedDat