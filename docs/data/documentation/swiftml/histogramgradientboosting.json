{"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","interfaceLanguage":"swift"},"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftML"}],"title":"Fast Tabular Learning with Histogram Gradient Boosting","role":"collectionGroup"},"topicSections":[{"title":"Estimators","anchor":"Estimators","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode"]}],"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedClassification","doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLInference","doc:\/\/SwiftML\/documentation\/SwiftML\/BoundedInference","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","doc:\/\/SwiftML\/documentation\/SwiftML\/ReusableCPUPrediction"],"generated":true}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Discretize continuous feature distributions into up to 256 compact bins ("},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":") so tree-node split gain scans take $O(K \\cdot p)$ time over $K \\le 256$ bins after an $O(N_{\\text{node}} \\cdot p)$ histogram accumulation pass."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Traditional gradient boosted decision trees (GBDT) evaluate continuous threshold candidates by sorting or scanning exact values across all samples at every tree node. When datasets grow large, sorting becomes a major performance bottleneck.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"HistGradientBoostingClassifier","type":"codeVoice"},{"type":"text","text":" and "},{"code":"HistGradientBoostingRegressor","type":"codeVoice"},{"type":"text","text":" implement histogram-based split optimization (inspired by LightGBM and scikit-learn’s "},{"code":"HistGradientBoostingClassifier","type":"codeVoice"},{"type":"text","text":"). Continuous feature columns are pre-binned into at most 256 integer bins ("},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"anchor":"Algorithmic-Architecture","level":2,"type":"heading","text":"Algorithmic Architecture"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Pre-Binning (Quantization)","type":"text"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"Feature quantiles are evaluated once before boosting begins, establishing up to 256 discrete bins per feature column. All feature values are mapped to compact ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":" memory arrays.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"One-Pass Histogram Accumulation","type":"text"}]},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"For any internal tree node, first-order negative gradients (g_i) and second-order Hessians (h_i) are accumulated into flat 256-bin histograms in an (O(N_{\\text{node}} \\cdot p)) linear pass over the node’s samples:","type":"text"},{"text":" ","type":"text"},{"text":"$$G[k] = \\sum_{i: b_i = k} g_i, \\quad H[k] = \\sum_{i: b_i = k} h_i$$","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Histogram-Bin Split Scan"}]},{"type":"text","text":":"},{"text":" ","type":"text"},{"text":"Once histograms are built, evaluating all candidate thresholds scans only the (K \\le 256) populated bins per feature ((O(K \\cdot p))), rather than re-sorting (N_{\\text{node}}) continuous values:","type":"text"},{"text":" ","type":"text"},{"text":"$$\\text{Gain} = \\frac{1}{2} \\left[ \\frac{G_L^2}{H_L + \\lambda} + \\frac{G_R^2}{H_R + \\lambda} - \\frac{G_{\\text{tot}}^2}{H_{\\text{tot}} + \\lambda} \\right]$$","type":"text"}]}]}]},{"type":"codeListing","code":["Continuous Floats [0.14, 0.92, -0.45] ──► Pre-Binning ──► UInt8 Bins [32, 215, 12]","                                                                  │  O(N_node · p) build","                                                                  ▼","Node Split Scan: O(K · p), K <= 256 ◄─── Accumulated Histograms G[k], H[k]"],"syntax":null},{"type":"heading","anchor":"Example-Usage","level":2,"text":"Example Usage"},{"type":"codeListing","code":["import SwiftML","","let clf = try HistGradientBoostingClassifier(","    nEstimators: 50,","    learningRate: 0.1,","    maxDepth: 6,","    maxBins: 256,","    minSamplesLeaf: 10",")","","try await clf.fit(features: X_train, targets: y_train)","let predictions = try await clf.predict(features: X_test)","let probabilities = try await clf.predictProbability(features: X_test)"],"syntax":"swift"}]}],"kind":"article","variants":[{"paths":["\/documentation\/swiftml\/histogramgradientboosting"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftML/documentation/SwiftML/PreparedRegression":{"role":"article","abstract":[{"type":"text","text":"Fit and predict from compact numeric columns without constructing nested row arrays in the StandardScaler and LinearRegression path."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","type":"topic","kind":"article","url":"\/documentation\/swiftml\/preparedregression","title":"Prepared regression"},"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"kind":"article","abstract":[{"text":"Train classification models using LogisticRegression, DecisionTreeClassifier, RandomForestClassifier, and MLPClassifier.","type":"text"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","title":"Supervised Classification Models","url":"\/documentation\/swiftml\/supervisedclassifiers","type":"topic","role":"article"},"doc://SwiftML/documentation/SwiftML":{"role":"collection","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","url":"\/documentation\/swiftml","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"kind":"symbol","title":"SwiftML"},"doc://SwiftML/documentation/SwiftML/MLOpsExport":{"kind":"article","abstract":[{"type":"text","text":"Export trained SwiftSci estimators to native Apple Core ML ("},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":") and cross-platform ONNX ("},{"type":"codeVoice","code":".onnx"},{"type":"text","text":") binary artifacts for production deployment."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","title":"Exporting Models to Core ML and ONNX","url":"\/documentation\/swiftml\/mlopsexport","type":"topic","role":"collectionGroup"},"doc://SwiftML/documentation/SwiftML/CoreMLInference":{"role":"article","abstract":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLPredictor","isActive":true,"type":"reference"},{"text":" to run a compiled Core ML regression, vector, or matrix model on","type":"text"},{"text":" ","type":"text"},{"code":"PreparedNumericBatch","type":"codeVoice"},{"text":". The predictor matches named scalar features or packs bounded batches","type":"text"},{"text":" ","type":"text"},{"text":"for a vector input. Results retain the input’s row order and source indices.","type":"text"}],"identifier":"doc:\/\/SwiftML\/documentation