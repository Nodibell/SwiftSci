{"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"],"anchor":"Grouping-APIs","title":"Grouping APIs"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"]}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"metadata":{"modules":[{"name":"SwiftDataFrame"}],"roleHeading":"API Collection","title":"High-Performance GroupBy & Vectorized Aggregations","role":"collectionGroup"},"abstract":[{"text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame.","type":"text"}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory."}],"type":"paragraph"},{"text":"1. Basic GroupBy Aggregation","level":2,"type":"heading","anchor":"1-Basic-GroupBy-Aggregation"},{"code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"],"syntax":"swift","type":"codeListing"},{"text":"2. Multi-Column Grouping","level":2,"type":"heading","anchor":"2-Multi-Column-Grouping"},{"inlineContent":[{"type":"text","text":"You can group by multiple categorical dimensions simultaneously:"}],"type":"paragraph"},{"code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"],"syntax":"swift","type":"codeListing"},{"text":"3. Performance & Memory Efficiency","level":2,"type":"heading","anchor":"3-Performance--Memory-Efficiency"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Single-Pass Hash Accumulation","type":"text"}]},{"type":"text","text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"vDSP Vector Reductions"}]},{"type":"text","text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines ("},{"code":"vDSP_sveD","type":"codeVoice"},{"type":"text","text":", "},{"code":"vDSP_meanvD","type":"codeVoice"},{"type":"text","text":")."}]}]}],"type":"unorderedList"}]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"url":"\/documentation\/swiftdataframe","type":"topic","role":"collection","title":"SwiftDataFrame","abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)","kind":"symbol","title":"groupBy(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupBy","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"...) -> ","kind":"text"},{"preciseIdentifier":"s:14SwiftDataFrame07GroupedbC0V","text":"GroupedDataFrame","kind":"typeIdentifier"}],"role":"symbol","url":"\/documentation\/swiftdataframe\/dataframe\/groupby(_:)","abstract":[{"type":"text","text":"Returns a "},{"type":"codeVoice","code":"GroupedDataFrame"},{"type":"text","text":" for aggregation."}],"type":"topic"}}}