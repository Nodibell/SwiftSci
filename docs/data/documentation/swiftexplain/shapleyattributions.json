ce","code":"FlatTreeNode.cover"},{"type":"text","text":") on leaves when all reachable leaves provide finite positive "},{"type":"codeVoice","code":"cover"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"falling back gracefully to "},{"isActive":true,"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeNodeWeighting\/uniformLeaf","type":"reference"},{"text":" otherwise (e.g., for legacy ","type":"text"},{"code":"<= 3.13.3","type":"codeVoice"},{"text":" serialized models).","type":"text"}],"title":"TreeNodeWeighting.empiricalCover","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"text":"empiricalCover","kind":"identifier"}],"type":"topic"}}}