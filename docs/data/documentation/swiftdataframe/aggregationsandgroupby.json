{"abstract":[{"text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame.","type":"text"}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftDataFrame"}],"roleHeading":"API Collection","title":"High-Performance GroupBy & Vectorized Aggregations"},"topicSections":[{"anchor":"Grouping-APIs","title":"Grouping APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory.","type":"text"}]},{"text":"1. Basic GroupBy Aggregation","type":"heading","level":2,"anchor":"1-Basic-GroupBy-Aggregation"},{"code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"],"type":"codeListing","syntax":"swift"},{"text":"2. Multi-Column Grouping","type":"heading","level":2,"anchor":"2-Multi-Column-Grouping"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can group by multiple categorical dimensions simultaneously:"}]},{"code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"],"type":"codeListing","syntax":"swift"},{"text":"3. Performance & Memory Efficiency","type":"heading","level":2,"anchor":"3-Performance--Memory-Efficiency"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Single-Pass Hash Accumulation"}],"type":"strong"},{"text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"vDSP Vector Reductions"}],"type":"strong"},{"type":"text","text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines ("},{"type":"codeVoice","code":"vDSP_sveD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_meanvD"},{"type":"text","text":")."}]}]}]}]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupBy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"...) -> ","kind":"text"},{"text":"GroupedDataFrame","kind":"typeIdentifier","preciseIdentifier":"s:14SwiftDataFrame07GroupedbC0V"}],"type":"topic","title":"groupBy(_:)","url":"\/documentation\/swiftdataframe\/dataframe\/groupby(_:)","identifier":"doc:\