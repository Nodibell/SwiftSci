{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition"},"sections":[],"abstract":[{"text":"Model trends, seasonality, volatility, and dynamic state transitions using ","type":"text"},{"type":"codeVoice","code":"ExponentialSmoothing"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NelderMead"},{"text":", ","type":"text"},{"type":"codeVoice","code":"KalmanFilter"},{"text":", ","type":"text"},{"type":"codeVoice","code":"GARCHModel"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"TimeSeriesDecomposition"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Temporal data analysis requires separating underlying long-term trends, periodic seasonal patterns, and random innovations. ","type":"text"},{"code":"SwiftForecast","type":"codeVoice"},{"text":" provides hardware-accelerated time-series models leveraging Apple Accelerate FFT convolution and LAPACK linear solvers.","type":"text"}]},{"type":"thematicBreak"},{"anchor":"1-Holt-Winters-Exponential-Smoothing--Nelder-Mead-Optimization","text":"1. Holt-Winters Exponential Smoothing & Nelder-Mead Optimization","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"ExponentialSmoothing","type":"codeVoice"},{"text":" models level (","type":"text"},{"code":"α","type":"codeVoice"},{"text":"), trend (","type":"text"},{"code":"β","type":"codeVoice"},{"text":"), and seasonal (","type":"text"},{"code":"γ","type":"codeVoice"},{"text":") components with additive or multiplicative adjustments:","type":"text"}]},{"style":"note","name":"Note","content":[{"inlineContent":[{"inlineContent":[{"text":"Additive Formulation:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"ŷ_{t+h|t} = ℓ_t + h · b_t + s_{t+h-m(k+1)}","type":"codeVoice"}],"type":"paragraph"}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"Parameters ","type":"text"},{"code":"α, β, γ","type":"codeVoice"},{"text":" are automatically optimized using the ","type":"text"},{"inlineContent":[{"text":"Nelder-Mead simplex optimizer","type":"text"}],"type":"strong"},{"text":" minimizing Mean Squared Error (MSE):","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftForecast","","\/\/ 1. Synthetic monthly seasonal dataset (36 observations, 3 years)","let series = (0..<36).map { t in","    let trend = 10.0 + Double(t) * 0.5","    let seasonal = sin(Double(t % 12) * 2.0 * Double.pi \/ 12.0) * 3.0","    return trend + seasonal + Double.random(in: -0.2...0.2)","}","","\/\/ 2. Configure Triple Exponential Smoothing (Holt-Winters)","let model = ExponentialSmoothing(","    trend: .additive,","    seasonal: .additive,","    seasonalPeriods: 12",")","","\/\/ 3. Fit parameters via continuous Nelder-Mead Simplex search","try model.fit(series: series)","","if let alpha = model.alpha, let beta = model.beta, let gamma = model.gamma {","    print(\"Optimized Parameters: alpha=\\(String(format: \"%.3f\", alpha)), beta=\\(String(format: \"%.3f\", beta)), gamma=\\(String(format: \"%.3f\", gamma))\")","}","","\/\/ 4. Forecast future periods","let forecast = try model.forecast(steps: 12)","print(\"12-Month Out-of-Sample Forecast: \\(forecast)\")"]},{"type":"thematicBreak"},{"anchor":"2-High-Performance-1D-Kalman-Filter-LAPACK-dgesv","text":"2. High-Performance 1D Kalman Filter (LAPACK `dgesv`)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"KalmanFilter","type":"codeVoice"},{"text":" estimates the hidden state vector of a linear dynamic system over time from noisy observations. The implementation uses contiguous 1D flat buffers with Apple Accelerate LAPACK ","type":"text"},{"code":"dgesv","type":"codeVoice"},{"text":" matrix inversions:","type":"text"}]},{"style":"note","name":"Note","content":[{"inlineContent":[{"inlineContent":[{"text":"State Prediction:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"x_{k|k-1} = F_k · x_{k-1|k-1} + B_k · u_k","type":"codeVoice"},{"text":"","type":"text"},{"text":"\n","type":"text"},{"inlineContent":[{"text":"Covariance Prediction:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"P_{k|k-1} = F_k · P_{k-1|k-1} · F_k^T + Q_k","type":"codeVoice"},{"text":"","type":"text"},{"text":"\n","type":"text"},{"inlineContent":[{"text":"Kalman Gain:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"K_k = P_{k|k-1} · H_k^T · (H_k · P_{k|k-1} · H_k^T + R_k)^{-1}","type":"codeVoice"}],"type":"paragraph"}],"type":"aside"},{"type":"codeListing","syntax":"swift","code":["import SwiftForecast","","\/\/ 1. Configure 2D state system: [position, velocity] with 1D observation [position]","let stateDim = 2","let obsDim = 1","","\/\/ State Transition Matrix F: position += dt * velocity","let F: [Double] = [","    1.0, 1.0,  \/\/ row 0: pos = 1.0*pos + 1.0*vel","    0.0, 1.0   \/\/ row 1: vel = 0.0*pos + 1.0*vel","]","","\/\/ Observation Matrix H: we measure position","let H: [Double] = [1.0, 0.0]","","\/\/ Process Noise Q and Measurement Noise R","let Q: [Double] = [","    0.01, 0.0,","    0.0,  0.01","]","let R: [Double] = [0.1]","","\/\/ Initial State and Covariance","let x0: [Double] = [0.0, 1.0]","let P0: [Double] = [","    1.0, 0.0,","    0.0, 1.0","]","","var kf = try KalmanFilter(","    stateDim: stateDim,","    obsDim: obsDim,","    transitionMatrix: F,","    observationMatrix: H,","    processNoise: Q,","    measurementNoise: R,","    initialState: x0,","    initialCovariance: P0",")","","\/\/ 2. Track real-time noisy trajectory","let noisyMeasurements: [[Double]] = [[0.95], [2.05], [2.98], [4.12], [5.01]]","","print(\"=== Kalman Filtering Updates ===\")","for (step, z) in noisyMeasurements.enumerated() {","    try kf.predict()","    try kf.update(observation: z)","    ","    let state = kf.state","    print(\"Step \\(step + 1): Position=\\(String(format: \"%.3f\", state[0])), Velocity=\\(String(format: \"%.3f\", state[1]))\")","}"]},{"type":"thematicBreak"},{"anchor":"3-Classical-Seasonal-Decomposition-STL","text":"3. Classical Seasonal Decomposition (STL)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Separate series into Trend, Seasonal, and Residual components:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let decomp = TimeSeriesDecomposition.decompose(series: series, period: 12, type: .additive)","","print(\"Extracted Trend Component count: \\(decomp.trend.compactMap { $0 }.count)\")","print(\"Seasonal Component Cycle: \\(decomp.seasonal.prefix(12))\")"]}]}],"variants":[{"paths":["\/documentation\/swiftforecast\/smoothinganddecomposition"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"],"anchor":"Guides--Tutorials","generated":true}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Article","title":"Time Series Forecasting, Smoothing & Kalman Filtering","modules":[{"name":"SwiftForecast"}],"role":"article"},"references":{"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"abstract":[{"text":"Koopman Operator time-series forecasting and dynamical system modeling actor.","type":"text"},{"text":" ","type":"text"},{"text":"Uses Extended Dynamic Mode Decomposition (EDMD) to approximate non-linear dynamics","type":"text"},{"text":" ","type":"text"},{"text":"via linear operators in lifted observable feature spaces.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"KoopmanOperator"}],"kind":"symbol","title":"KoopmanOperator","url":"\/documentation\/swiftforecast\/koopmanoperator","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KoopmanOperator"}]},"doc://SwiftForecast/documentation/SwiftForecast":{"url":"\/documentation\/swiftforecast","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast","abstract":[{"text":"Time Series & Volatility Forecasting Models.","type":"text"}],"role":"collection","title":"SwiftForecast","type":"topic","kind":"symbol"},"doc://SwiftForecast/documentation/SwiftForecast/ArimaAndSarima":{"abstract":[{"text":"Forecast univariate time series using Autoregressive Integrated Moving Average (ARIMA) and Seasonal ARIMA (SARIMA).","type":"text"}],"kind":"article","title":"ARIMA & SARIMA Time Series Models","url":"\/documentation\/swiftforecast\/arimaandsarima","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","type":"topic","role":"article"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAParallel":{"abstract":[{"text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency.","type":"text"}],"kind":"article","title":"Concurrent Order Selection with AutoARIMA","url":"\/documentation\/swiftforecast\/autoarimaparallel","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","type":"topic","role":"collectionGroup"}}}