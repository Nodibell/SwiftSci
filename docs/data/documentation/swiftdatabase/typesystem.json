{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" module bridges the gap between relational SQL storage engines and Swift’s type-safe, actor-isolated data ecosystem. Traditional database client libraries often convert SQL fields to intermediate strings or untyped objects, imposing significant heap allocation overhead and potential loss of numeric precision."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"AnySendableValue"},{"type":"text","text":" provides a unified, zero-copy, enum-based abstraction covering primary relational types:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"64-bit IEEE 754 floating point numbers (","type":"text"},{"code":".double","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Standard host-width integers (","type":"text"},{"code":".int","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Explicit 64-bit signed integers (","type":"text"},{"code":".int64","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"UTF-8 text strings (","type":"text"},{"code":".string","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Boolean flags (","type":"text"},{"code":".bool","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"High-precision timestamps (","type":"text"},{"code":".date","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Raw byte buffers ("},{"type":"codeVoice","code":".data"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"