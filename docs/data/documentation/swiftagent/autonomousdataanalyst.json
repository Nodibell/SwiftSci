{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftAgent"},{"text":" implements an agentic reasoning loop based on the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"ReAct (Reason + Act)"}]},{"text":" paradigm. The agent iteratively reasons about a user query, selects analytical tools via fuzzy matching, inspects sandboxed observations, and returns structured data insights.","type":"text"}]},{"type":"codeListing","code":["                      User Prompt","                           │","                           ▼","          ┌──────────────────────────────────┐","     ┌───►│ Thought: Analyze missing values  │","     │    └────────────────┬─────────────────┘","     │                     ▼","     │    ┌──────────────────────────────────┐","     │    │ Action: Run 'data_summary' tool  │","     │    └────────────────┬─────────────────┘","     │                     ▼","     │    ┌──────────────────────────────────┐","ReAct│    │ Fuzzy Tool Resolution            │","Loop │    │ (handles typos\/case\/spacing)     │","     │    └────────────────┬─────────────────┘","     │                     ▼","     │    ┌──────────────────────────────────┐","     │    │ Observation: 120 rows, 4 columns │","     │    └────────────────┬─────────────────┘","     │                     │","     └─────────────────────┘ (Repeat until final answer)","                           │","                           ▼","                     Final Answer"],"syntax":null},{"type":"thematicBreak"},{"type":"heading","text":"1. Running an Autonomous ReAct Agent","level":2,"anchor":"1-Running-an-Autonomous-ReAct-Agent"},{"type":"paragraph","inlineContent":[{"text":"Configure a ","type":"text"},{"type":"codeVoice","code":"ReActAgent"},{"text":" with custom tools and an LLM generation closure:","type":"text"}]},{"type":"codeListing","code":["import Foundation","import SwiftAgent","import SwiftDataFrame","","\/\/ 1. Prepare sample dataset","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"department\", values: [\"Engineering\", \"Sales\", \"Engineering\", \"Marketing\"]),","    TypedColumn<Double>(name: \"salary\", values: [120000.0, 95000.0, 135000.0, 85000.0])","])","","\/\/ 2. Define analytical tools","let summaryTool = CustomAgentTool(","    name: \"dataset_summary\",","    description: \"Returns row count and column data types of the DataFrame.\"",") { _ in","    return \"DataFrame has \\(df.shape.rows) rows and \\(df.shape.columns) columns: [department: String, salary: Double]\"","}","","\/\/ 3. Mock LLM reasoning response closure","let llmModel: @Sendable (String) async throws -> String = { prompt in","    if prompt.contains(\"Action:\") {","        return \"Thought: I need to inspect the dataset summary.\\nAction: dataset_summary\\nAction Input: {}\\n\"","    } else {","        return \"Thought: I have the information.\\nFinal Answer: The dataset contains 4 employee records across Engineering, Sales, and Marketing.\"","    }","}","","\/\/ 4. Initialize and execute the ReAct Agent","let agent = ReActAgent(","    tools: [summaryTool],","    llm: llmModel,","    maxSteps: 5",")","","let trajectory = try await agent.run(question: \"How many employees are in the dataset?\")","","print(\"=== Agent Trajectory Completed ===\")","print(\"Final Answer: \\(trajectory.finalAnswer)\")","print(\"Total Steps Executed: \\(trajectory.steps.count)\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","text":"2. Sandboxed Command Interpretation (`SwiftAgentEvaluator`)","level":2,"anchor":"2-Sandboxed-Command-Interpretation-SwiftAgentEvaluator"},{"type":"paragraph","inlineContent":[{"text":"Safely evaluate structured AST commands without arbitrary code execution vulnerabilities:","type":"text"}]},{"type":"codeListing","code":["import SwiftAgent","","let evaluator = SwiftAgentEvaluator(dataFrame: df)","","\/\/ 1. Parse and execute pipeline commands","let filtered = try evaluator.execute(\"filter salary > 100000\")","print(\"Filtered count: \\(filtered.shape.rows) employees with salary > $100k.\")","","\/\/ 2. GroupBy aggregation","let grouped = try evaluator.execute(\"groupby department\")","print(\"Department groupings: \\(grouped.shape.rows) rows.\")"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"abstract":[{"type":"text","text":"Build autonomous, sandboxed AI agents that analyze "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" tables, execute statistical aggregations, and resolve tools using fuzzy matching."}],"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AutonomousDataAnalyst","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"SwiftAgent"}],"roleHeading":"Article","role":"article","title":"Autonomous Data Analysis Agents & ReAct Reasoning Loops"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/autonomousdataanalyst"]}],"kind":"article","references":{"doc://SwiftAgent/documentation/SwiftAgent":{"title":"SwiftAgent","type":"topic","url":"\/documentation\/swiftagent","kind":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","role":"collection","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}]}}}