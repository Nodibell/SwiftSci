{"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"type":"codeVoice","code":"NaturalLanguage"},{"type":"text","text":" framework."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials"}],"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization"},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"metadata":{"modules":[{"name":"SwiftNLP"}],"roleHeading":"Article","title":"Text Normalization, Tokenization & Linguistic Tagging","role":"article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}],"type":"paragraph"},{"type":"heading","anchor":"1-Multi-lingual-Word--Sentence-Tokenization","level":3,"text":"1. Multi-lingual Word & Sentence Tokenization"},{"syntax":"swift","type":"codeListing","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"]},{"type":"heading","anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","