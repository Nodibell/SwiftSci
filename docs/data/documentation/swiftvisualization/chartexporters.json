{"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftVisualization\/documentation\/SwiftVisualization"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"code":"SwiftVisualization","type":"codeVoice"},{"text":" provides two complementary visualization engines:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Native SwiftUI Engine ("},{"type":"codeVoice","code":"SwiftSciChartView"},{"type":"text","text":")"}],"type":"strong"},{"text":": Zero-dependency ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" SwiftUI view rendering line charts, bar charts, scatter plots, histograms, and 2D correlation heatmaps on a high-performance hardware-accelerated ","type":"text"},{"type":"codeVoice","code":"Canvas"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Interactive HTML Exporter (","type":"text"},{"code":"ChartExporter","type":"codeVoice"},{"text":")","type":"text"}],"type":"strong"},{"text":": Standalone browser-ready HTML diagnostic reports (ROC Curves with trapezoidal Area Under Curve \/ AUC computation, Feature Importances, Confusion Matrices).","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"text":"1. Native SwiftUI Charting (`SwiftSciChartView`)","anchor":"1-Native-SwiftUI-Charting-SwiftSciChartView","type":"heading","level":2},{"inlineContent":[{"text":"Embed responsive, animated charts in iOS and macOS SwiftUI user interfaces:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import SwiftVisualization","","struct ModelDiagnosticsView: View {","    let lossHistory: [Double] = [0.85, 0.62, 0.45, 0.38, 0.29, 0.22, 0.18, 0.15]","    let epochLabels: [String] = (1...8).map { \"Ep \\($0)\" }","    ","    var body: some View {","        VStack(alignment: .leading, spacing: 16) {","            Text(\"Training Loss Convergence\")","                .font(.headline)","            ","            \/\/ 1. Line Chart with custom options","            SwiftSciChartView(","                type: .line,","                data: lossHistory,","                labels: epochLabels,","                options: ChartOptions(","                    accentColor: .blue,","                    showAxes: true,","                    lineWidth: 3.0,","                    customYAxisLabel: \"Loss (Cross-Entropy)\"","                )","            )","            .frame(height: 250)","            .padding()","            .background(Color(.windowBackgroundColor).opacity(0.5))","            .cornerRadius(12)","        }","        .padding()","    }","}"]},{"type":"thematicBreak"},{"type":"heading","text":"2. 2D Correlation Heatmaps in SwiftUI","anchor":"2-2D-Correlation-Heatmaps-in-SwiftUI","level":2},{"inlineContent":[{"type":"text","text":"Render 2D covariance and correlation matrices with automatic color gradients:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import SwiftVisualization","","struct CorrelationMatrixView: View {","    \/\/ 3x3 Correlation Grid","    let matrix2D: [[Double]] = [","        [ 1.00,  0.82, -0.45],","        [ 0.82,  1.00, -0.30],","        [-0.45, -0.30,  1.00]","    ]","    let featureNames = [\"Revenue\", \"Profit\", \"Expenses\"]","    ","    var body: some View {","        SwiftSciChartView(","            type: .heatmap2D(matrix2D),","            data: [],","            labels: featureNames,","            options: ChartOptions(showAxes: true)","        )","        .frame(width: 320, height: 320)","    }","}"]},{"type":"thematicBreak"},{"type":"heading","text":"3. Interactive Plotly HTML Reports with AUC","anchor":"3-Interactive-Plotly-HTML-Reports-with-AUC","level":2},{"inlineContent":[{"type":"text","text":"Generate standalone HTML diagnostics viewable in any modern browser:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftVisualization","","\/\/ 1. Export ROC Curve with exact trapezoidal AUC computation","let yTrue = [0, 0, 1, 1, 0, 1]","let yScores = [0.1, 0.35, 0.8, 0.92, 0.2, 0.75]","","let rocHTML = ChartExporter.plotROCCurve(yScores: yScores, yTrue: yTrue)","let outputURL = URL(fileURLWithPath: \"roc_curve_report.html\")","try rocHTML.write(to: outputURL, atomically: true, encoding: .utf8)","","print(\"Saved interactive ROC report with trapezoidal AUC title.\")","","\/\/ 2. Export Feature Importance bar chart","let featureImportances = [\"age\": 0.35, \"income\": 0.45, \"education\": 0.20]","let featHTML = ChartExporter.plotFeatureImportances(featureImportances)"]}]}],"sections":[],"abstract":[{"text":"Render charts with zero external dependencies using ","type":"text"},{"type":"codeVoice","code":"SwiftSciChartView"},{"text":" in SwiftUI, or export interactive HTML reports with ","type":"text"},{"type":"codeVoice","code":"ChartExporter"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/swiftvisualization\/chartexporters"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Native SwiftUI Charting & Interactive Plotly Exporters","modules":[{"name":"SwiftVisualization"}],"role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftVisualization\/documentation\/SwiftVisualization\/ChartExporters"},"references":{"doc://SwiftVisualization/documentation/SwiftVisualization":{"kind":"symbol","type":"topic","role":"collection","title":"SwiftVisualization","identifier":"doc:\/\/SwiftVisualization\/documentation\/SwiftVisualization","url":"\/documentation\/swiftvisualization","abstract":[{"type":"text","text":"Standalone Interactive HTML Chart Exporters."}]}}}