{"identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"SwiftDatabase"}],"roleHeading":"Article","role":"article","title":"Relational Database Drivers & Zero-Copy SQL Ingestion"},"abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"]}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"code":"SwiftDatabase","type":"codeVoice"},{"type":"text","text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 "},{"code":"public actor","type":"codeVoice"},{"type":"text","text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model","level":2,"text":"🔒 Driver Architecture & Concurrency Model","type":"heading"},{"code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"],"syntax":null,"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Actor Isolation:","type":"text"}],"type":"strong"},{"type":"text","text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Streaming ","type":"text"},{"type":"codeVoice","code":"recv"},{"text":" Buffer:","type":"text"}],"type":"strong"},{"type":"text","text":" Network drivers use a 64KB receive buffer reading continuously until "},{"code":"ReadyForQuery ('Z')","type":"codeVoice"},{"type":"text","text":" is received."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Authentication:","type":"text"}],"type":"strong"},{"type":"text","text":" Built-in support for Cleartext and MD5 password authentication via "},{"code":"CommonCrypto","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"anchor":"1-Querying-SQLite-Databases--C-Pointer-Lifecycle-Safety","level":2,"text":"1. Querying SQLite Databases & C-Pointer Lifecycle Safety","type":"heading"},{"inlineContent":[{"code":"SQLiteConnection","type":"codeVoice"},{"type":"text","text":" executes SQL statements through native "},{"code":"sqlite3_prepare_v2","type":"codeVoice"},{"type":"text","text":" and directly streams result rows into columnar "},{"code":"TypedColumn","type":"codeVoice"},{"type":"text","text":" buffers with full C-pointer lifecycle safety:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Statement Finalization:","type":"text"}],"type":"strong"},{"type":"text","text":" All prepared statements are guaranteed to be finalized via "},{"code":"defer { if let stmt { sqlite3_finalize(stmt) } }","type":"codeVoice"},{"type":"text","text":", preventing statement pointer leaks during both normal termination and thrown query errors."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Resource Cleanup:","type":"text"}],"type":"strong"},{"type":"text","text":" In-memory or file-backed database handles are automatically closed via "},{"code":"sqlite3_close_v2","type":"codeVoice"},{"type":"text","text":" upon deallocation. Callers may also invoke "},{"code":"await sqlite.close()","type":"codeVoice"},{"type":"text","text":" to immediately release operating system locks and memory."}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = SQLiteConnection(databasePath: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)","","\/\/ 3. Explicitly release SQLite database handle when done","await sqlite.close()"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol","level":2,"text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","type":"heading"},{"inlineContent":[{"type":"text","text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries ("},{"code":"libpq","type":"codeVoice"},{"type":"text","text":"):"}],"type":"paragraph"},{"code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    user: \"postgres\",","    password: \"secure_password\",","    sslMode: .disable",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"anchor":"3-High-Throughput-Bulk-Writeback-toSQL","level":2,"text":"3. High-Throughput Bulk Writeback (`toSQL`)","type":"heading"},{"inlineContent":[{"type":"text","text":"Bulk export in-memory "},{"code":"DataFrame","type":"codeVoice"},{"type":"text","text":" objects back into database tables with configurable append, replace, or fail-if-exists modes:"}],"type":"paragraph"},{"code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append, .replace, or .failIfExists","    batchSize: 500",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"],"syntax":"swift","type":"codeListing"}]}],"kind":"article","variants":[{"paths":["\/documentation\/swiftdatabase\/databaseconnectors"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","abstract":[{"type":"text","text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback."}],"type":"topic","url":"\/documentation\/swiftdatabase\/highthroughputingestion","role":"collectionGroup","title":"Bulk SQL Ingestion & Database Wire Protocols","kind":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase":{"role":"collection","title":"SwiftDatabase","type":"topic","abstract":[{"text":"Relational Database Connectors to DataFrames.","type":"text"}],"url":"\/documentation\/swiftdatabase","kind":"symbol","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"},"doc://SwiftDatabase/documentation/SwiftDatabase/SecurityAndPerformance":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","abstract":[{"type":"text","text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL."}],"type":"topic","url":"\/documentation\/swiftdatabase\/securityandperformance","role":"collectionGroup","title":"Security & Performance in SwiftDatabase","kind":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","title":"Database Type System & Value Representation","role":"collectionGroup","type":"topic","url":"\/documentation\/swiftdatabase\/typesystem","abstract":[{"text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions.","type":"text"}],"kind":"article"}}}