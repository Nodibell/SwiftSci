{"abstract":[{"type":"text","text":"Navigate semantic relationships, compute synset distances, and explore English hypernym\/hyponym trees."}],"topicSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNet","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/Synset","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS"],"title":"WordNet Types","anchor":"WordNet-Types"}],"sections":[],"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftNLP"}],"title":"WordNet Semantic Hierarchy & Lexical Graphs","roleHeading":"API Collection"},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/swiftnlp\/wordnetandlexicalgraphs"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNetAndLexicalGraphs","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"WordNet","type":"codeVoice"},{"text":" is a large lexical database of English where nouns, verbs, adjectives, and adverbs are organized into sets of cognitive synonyms called ","type":"text"},{"inlineContent":[{"text":"Synsets","type":"text"}],"type":"strong"},{"text":", interlinked by conceptual-semantic and lexical relations.","type":"text"}]},{"type":"heading","level":2,"text":"1. Looking Up Synsets & Definitions","anchor":"1-Looking-Up-Synsets--Definitions"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","let wordnet = WordNet.shared","","\/\/ Look up all noun synsets for \"bank\"","let synsets = wordnet.synsets(for: \"bank\", pos: .noun)","for s in synsets {","    print(\"ID: \\(s.id), Definition: \\(s.definition)\")","}"]},{"type":"heading","level":2,"text":"2. Semantic Similarity Metrics","anchor":"2-Semantic-Similarity-Metrics"},{"type":"paragraph","inlineContent":[{"text":"SwiftSci implements standard lexical similarity algorithms:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Path Similarity","type":"text"}],"type":"strong"},{"type":"text","text":": Shortest path distance in the hypernym taxonomy:"}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sim_path(s1, s2) = 1 \/ (1 + distance(s1, s2))"}],"type":"paragraph"}],"name":"Note"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Wu-Palmer Similarity (WUP)","type":"text"}],"type":"strong"},{"type":"text","text":": Measures depth of least common subsumer (LCS) relative to synset depths:"}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sim_wup(s1, s2) = (2 · depth(LCS)) \/ (depth(s1) + depth(s2))"}],"type":"paragraph"}],"name":"Note"}]}]},{"type":"codeListing","syntax":"swift","code":["let dog = wordnet.synset(\"dog.n.01\")!","let cat = wordnet.synset(\"cat.n.01\")!","","let pathSim = wordnet.pathSimilarity(dog, cat)","let wupSim = wordnet.wuPalmerSimilarity(dog, cat)","","print(\"Path Similarity: \\(pathSim), Wu-Palmer: \\(wupSim)\")"]}]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/POS":{"abstract":[{"text":"Part of Speech categories in WordNet.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"POS"}],"navigatorTitle":[{"kind":"identifier","text":"POS"}],"url":"\/documentation\/swiftnlp\/pos","kind":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS","title":"POS"},"doc://SwiftNLP/documentation/SwiftNLP/WordNet":{"abstract":[{"text":"Native WordNet semantic database quer