{"topicSections":[{"title":"Estimators","anchor":"Estimators","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Traditional gradient boosted decision trees (GBDT) sort continuous feature values across all samples at every internal tree node to find optimal split thresholds. When datasets grow to millions of rows, sorting becomes the primary performance bottleneck."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"HistGradientBoostingClassifier"},{"type":"text","text":" and "},{"type":"codeVoice","code":"HistGradientBoostingRegressor"},{"type":"text","text":" implement histogram-based split optimization (inspired by LightGBM and scikit-learn’s "},{"type":"codeVoice","code":"HistGradientBoostingClassifier"},{"type":"text","text":"). Continuous feature columns are discretized into at most 256 integer bins ("},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":")."}],"type":"paragraph"},{"level":2,"text":"Algorithmic Architecture","type":"heading","anchor":"Algorithmic-Architecture"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Pre-Binning (Quantization)"}]},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"Feature quantiles are evaluated once before boosting begins, establishing up to 256 discrete bins per feature column. All feature values are mapped to compact "},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":" memory arrays."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"One-Pass Histogram Accumulation"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"For any internal tree node, first-order negative gradients (g_i) and second-order Hessians (h_i) are accumulated into a flat 256-bin histogram in a single linear pass over the node’s samples:","type":"text"},{"text":" ","type":"text"},{"text":"$$G[k] = \\sum_{i: b_i = k} g_i, \\quad H[k] = \\sum_{i: b_i = k} h_i$$","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Constant-Time Split Finding"}]},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"Evaluating all split candidates requires iterating over (K \\le 256) bins, regardless of how many millions of samples reside in the node:"},{"type":"text","text":" "},{"type":"text","text":"$$\\text{Gain} = \\frac{1}{2} \\left[ \\frac{G_L^2}{H_L + \\lambda} + \\frac{G_R^2}{H_R + \\lambda} - \\frac{G_{\\text{tot}}^2}{H_{\\text{tot}} + \\lambda} \\right]$$"}],"type":"paragraph"}]}],"type":"orderedList"},{"code":["Continuous Floats [0.14, 0.92, -0.45] ──► Quantization ──► UInt8 Bins [32, 215, 12]","                                                                  │","                                                                  ▼","Node Split Search: O(256) Bin Scan ◄─── Accumulated Histograms G[k], H[k]"],"type":"codeListing","syntax":null},{"text":"Example Usage","anchor":"Example-Usage","type":"heading","level":2},{"code":["import SwiftML","","let clf = try HistGradientBoostingClassifier(","    nEstimators: 50,","    learningRate: 0.1,","    maxDepth: 6,","    maxBins: 256,","    minSamplesLeaf: 10",")","","try await clf.fit(features: X_train, targets: y_train)","let predictions = try await clf.predict(features: X_test)","let probabilities = try await clf.predictProbability(features: X_test)"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/histogramgradientboosting"]}],"abstract":[{"type":"text","text":"Discretize continuous feature distributions into 256 compact bins to accelerate decision tree split evaluations from (O(N \\log N)) to (O(K))."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting"},"kind":"article","metadata":{"modules":[{"name":"SwiftML"}],"roleHeading":"API Collection","title":"Fast Tabular Learning with Histogram Gradient Boosting","role":"collectionGroup"},"references":{"doc://SwiftML/documentation/SwiftML/SupervisedRegressors":{"abstract":[{"type":"text","text":"Perform continuous target predictions using LinearRegression (exact OLS), DecisionTreeRegressor, and GradientBoostedTreesRegressor."}],"url":"\/documentation\/swiftml\/supervisedregressors","role":"article","title":"Supervised Regression Models","kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","type":"topic"},"doc://SwiftML/documentation/SwiftML/ReproducibilityAndPRNG":{"title":"Reproducibility, Determinism & High-Quality PRNG","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","kind":"article","url":"\/documentation\/swiftml\/reproducibilityandprng"},"doc://SwiftML/documentation/SwiftML":{"title":"SwiftML","url":"\/documentation\/swiftml","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"role":"collection","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML"},"doc://SwiftML/documentation/SwiftML/HistTreeNode":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistTreeNode","kind":"identifier"}],"url":"\/documentation\/swiftml\/histtreenode","title":"HistTreeNode","abstract":[{"text":"A node in a histogram-binned decision tree.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"HistTreeNode","kind":"identifier"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode","role":"symbol","kind":"symbol"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingRegressor":{"role":"symbol","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","kind":"symbol","type":"topic","abstract":[{"text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular regression.","type":"text"}],"url":"\/documentation\/swiftml\/histgradientboostingregressor","title":"HistGradientBoostingRegressor","navigatorTitle":[{"text":"HistGradientBoostingRegressor","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistGradientBoostingRegressor","kind":"identifier"}]},"doc://SwiftML/documentation/SwiftML/MLOpsExport":{"role":"collectionGroup","abstract":[{"type":"text","text":"Export trained SwiftSci estimators to native Apple Core ML ("},{"code":".mlmodel","type":"codeVoice"},{"type":"text","text":") and cross-platform ONNX ("},{"code":".onnx","type":"codeVoice"},{"type":"text","text":") binary artifacts for production deployment."}],"url":"\/documentation\/swiftml\/mlopsexport","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","kind":"article","title":"Exporting Models to Core ML and ONNX"},"doc://SwiftML/documentation/SwiftML/EnsembleLearning":{"title":"Ensemble Learning: Random Forests & Gradient Boosted Trees","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","kind":"article","url":"\/documentation\/swiftml\/ensemblelearning"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingClassifier":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistGradientBoostingClassifier","kind":"identifier"}],"url":"\/documentation\/swiftml\/histgradientboostingclassifier","title":"HistGradientBoostingClassifier","abstract":[{"text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular classification.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"HistGradientBoostingClassifier","kind":"identifier"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","role":"symbol","kind":"symbol"},"doc://SwiftML/documentation/SwiftML/EarlyStoppingCallbacks":{"abstract":[{"type":"text","text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting."}],"url":"\/documentation\/swiftml\/earlystoppingcallbacks","role":"collectionGroup","title":"Early Stopping & Generalization Control","kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","type":"topic"},"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"title":"Supervised Classification Models","role":"article","type":"topic","abstract":[{"text":"Train classification models using LogisticRegression, DecisionTreeClassifier, RandomForestClassifier, and MLPClassifier.","type":"text"}],"kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","url":"\/documentation\/swiftml\/supervisedclassifiers"}}}