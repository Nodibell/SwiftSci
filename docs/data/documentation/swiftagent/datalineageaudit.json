{"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"text":" automatically generates an immutable audit trail of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","type":"reference"},{"text":" entries for each command evaluated.","type":"text"}]},{"type":"heading","text":"LineageRecord Structure","anchor":"LineageRecord-Structure","level":2},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","type":"reference"},{"text":" contains:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stepIndex"},{"text":": Sequential index of the step within the agent trajectory.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"operation"},{"text":": The normalized DSL command executed (e.g., ","type":"text"},{"type":"codeVoice","code":"filter(age)"},{"text":", ","type":"text"},{"type":"codeVoice","code":"groupBy(category,mean)"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"inputRows"},{"text":": Dataset row count immediately prior to transformation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"outputRows"},{"text":": Dataset row count produced by the transformation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"},{"text":": The exact timestamp of execution.","type":"text"}]}]}]},{"type":"heading","text":"Example: Accessing Audit Trails","anchor":"Example-Accessing-Audit-Trails","level":2},{"type":"codeListing","code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/datalineageaudit"]}],"sections":[],"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit","interfaceLanguage":"swift"},"metadata":{"title":"Data Lineage & Transformation Audit Trails","modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","role":"collectionGroup"},"abstract":[{"type":"text","text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Audit-Types","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"title":"Audit Types"}],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","title":"SwiftAgent","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"url":"\/documentation\/swiftagent","role":"collection