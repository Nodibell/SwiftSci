{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"},"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftCluster"}],"role":"collectionGroup","title":"In-Memory VectorStore & On-Device RAG"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vector databases are essential for modern semantic search and AI agent knowledge retrieval. "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"VectorStore"},{"type":"text","text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations ("},{"type":"codeVoice","code":"vDSP_dotprD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_svesqD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_distancesqD"},{"type":"text","text":")."}]},{"text":"1. Creating a VectorStore","type":"heading","level":2,"anchor":"1-Creating-a-VectorStore"},{"type":"codeListing","code":["import SwiftCluster","import SwiftNLP","","\/\/ Initialize vector store with Cosine Similarity","let store = VectorStore(metric: .cosineSimilarity)","","\/\/ Generate dense text embeddings","let engine = LocalEmbeddingEngine(dimension: 128)","","let articles = [","    (id: \"art_1\", title: \"Apple Silicon Architecture\", text: \"Unified memory and neural engine overview\"),","    (id: \"art_2\", title: \"Swift Strict Concurrency\", text: \"Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"],"syntax":"swift"},{"text":"2. Top-K Semantic Search","type":"heading","level":2,"anchor":"2-Top-K-Semantic-Search"},{"type":"codeListing","code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"],"syntax":"swift"},{"text":"3. Supported Metrics","type":"heading","level":2,"anchor":"3-Supported-Metrics"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".cosineSimilarity","type":"codeVoice"}],"type":"strong"},{"text":": Ideal for normalized text embeddings (returns $[-1.0, 1.0]$).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".dotProduct","type":"codeVoice"}],"type":"strong"},{"text":": Direct inner product for unnormalized projections.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}],"type":"strong"},{"text":": Geometric $L_2$ distance for spatial clustering.","type":"text"}]}]}]}]}],"abstract":[{"text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftcluster\/vectorstoreandrag"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","topicSections":[{"anchor":"Vector-Store-Types","title":"Vector Store Types","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"]}],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"references":{"doc://SwiftCluster/documentation/SwiftCluster/VectorMetric":{"kind":"symbol","title":"VectorMetric","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","type":"topic","abstract":[{"text":"Distance or similarity metrics supported by ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore"},{"text":".","type":"text"}],"url":"\/documentation\/swiftcluster\/vectormetric","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"VectorMetric","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"VectorMetric"}]},"doc://SwiftCluster/documentation/SwiftCluster/VectorStore":{"abstract":[{"text":"An in-memory vector database and similarity search index optimized for Apple Silicon.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"VectorStore"}],"url":"\/documentation\/swiftcluster\/vectorstore","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","role":"symbol","title":"VectorStore","navigatorTitle":[{"text":"VectorStore","kind":"identifier"}]},"doc://SwiftCluster/documentation/SwiftCluster/VectorSearchResult":{"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","kind":"symbol","abstract":[{"text":"Represents a single nearest-neighbor match result from a vector search query.","type":"text"}],"title":"VectorSearchResult","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorSearchResult","kind":"identifier"}],"navigatorTitle":[{"text":"VectorSearchResult","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swiftcluster\/vectorsearchresult"},"doc://SwiftCluster/documentation/SwiftCluster":{"kind":"symbol","title":"SwiftCluster","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster","abstract":[{"type":"text","text":"PCA Dimensionality Reduction & Unsupervised Clustering."}],"url":"\/documentation\/swiftcluster","type":"topic","role":"collection"}}}