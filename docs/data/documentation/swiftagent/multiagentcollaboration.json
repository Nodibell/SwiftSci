{"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentOrchestrator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessageBus","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessage","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolCall","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolResult","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SpecializedAgent"],"title":"Multi-Agent Coordination","anchor":"Multi-Agent-Coordination"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgenticReplAndRAG"],"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/multiagentcollaboration"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Complex analytical and reasoning workflows are frequently error-prone when performed by a single monolithic model. Decomposing problems into specialized roles—such as ","type":"text"},{"inlineContent":[{"text":"Planner","type":"text"}],"type":"strong"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"Analyst"}],"type":"strong"},{"text":", and ","type":"text"},{"inlineContent":[{"type":"text","text":"Critic"}],"type":"strong"},{"text":"—drastically improves reasoning accuracy, reduces hallucinations, and permits parallelized tool execution.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"SwiftAgent","type":"codeVoice"},{"text":" provides ","type":"text"},{"code":"MultiAgentOrchestrator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AgentMessageBus","type":"codeVoice"},{"text":", a reactive multi-agent framework built on Swift’s structured concurrency primitives (","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"withTaskGroup","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"level":2,"text":"Architectural Topology","anchor":"Architectural-Topology","type":"heading"},{"syntax":null,"code":["                         ┌───────────────────────┐","                         │   User \/ Prompt Task  │","                         └───────────┬───────────┘","                                     │","                                     ▼","                       ┌───────────────────────────┐","                       │      AgentMessageBus      │","                       │       (AsyncStream)       │","                       └─────────────┬─────────────┘","                                     │ Broadcasts","         ┌───────────────────────────┼───────────────────────────┐","         ▼                           ▼                           ▼","┌──────────────────┐       ┌──────────────────┐       ┌──────────────────┐","│     Planner      │       │     Analyst      │       │      Critic      │","│ Decomposes steps │       │ Queries & Models │       │ Validates logic  │","└────────┬─────────┘       └────────┬─────────┘       └────────┬─────────┘","         │                          │                          │","         └──────────────────────────┼──────────────────────────┘","                                    │ Parallel Tool Calls","                                    ▼","                     ┌─────────────────────────────┐","                     │ MultiAgentOrchestrator      │","                     │ withTaskGroup Tool Executor │","                     └──────────────┬──────────────┘","                                    │","               ┌────────────────────┴────────────────────┐","               ▼                                         ▼","      DataFrame Query Tool                      Statistical Model Tool"],"type":"codeListing"},{"anchor":"Parallel-Tool-Calling","text":"Parallel Tool Calling","type":"heading","level":2},{"inlineContent":[{"text":"When an agent requests multiple tool executions in a single reasoning step (e.g. computing standard deviations across three columns concurrently), ","type":"text"},{"code":"MultiAgentOrchestrator.executeToolsInParallel(_:)","type":"codeVoice"},{"text":" executes them simultaneously across available CPU cores using ","type":"text"},{"code":"withTaskGroup","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This reduces total latency from $\\sum_{i=1}^M T_i$ to $\\max_{i} T_i$."}],"type":"paragraph"},{"anchor":"Example-Usage","text":"Example Usage","type":"heading","level":2},{"code":["import SwiftAgent","import SwiftDataFrame","","\/\/ 1. Initialize orchestrator and message bus","let orchestrator = MultiAgentOrchestrator(maxRounds: 5)","","\/\/ 2. Register specialized agents","orchestrator.registerAgent(PlannerAgent())","orchestrator.registerAgent(DataAnalystAgent())","orchestrator.registerAgent(CriticAgent())","","\/\/ 3. Register tools","orchestrator.registerTool(DataFrameAgentTool(dataframe: salesData))","","\/\/ 4. Run collaborative execution","let solution = try await orchestrator.run(","    taskPrompt: \"Identify top 3 departments by salary variance and critique findings.\"",")","print(\"Consensus Answer: \\(solution)\")"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"type":"text","text":"Orchestrate teams of specialized autonomous agents over an asynchronous message bus with concurrent parallel tool calling."}],"kind":"article","metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Multi-Agent Coordination & Protocols","modules":[{"name":"SwiftAgent"}]},"references":{"doc://SwiftAgent/documentation/SwiftAgent/AgentToolResult":{"title":"AgentToolResult