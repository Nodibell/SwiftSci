{"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"kind":"article","metadata":{"title":"Text Normalization, Tokenization & Linguistic Tagging","role":"article","modules":[{"name":"SwiftNLP"}],"roleHeading":"Article"},"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"type":"codeVoice","code":"NaturalLanguage"},{"type":"text","text":" framework."}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","type":"heading","text":"1. Multi-lingual Word & Sentence Tokenization"},{"syntax":"swift","type":"codeListing","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"]},{"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","text":"2. POS Tagging, Lemmatization & Entity Extraction","level":3,"type":"heading"},{"syntax":"swift","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"type":"codeListing"},{"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","text":"3. Sentiment Analysis (VADER & NLSentiment)","level":3,"type":"heading"},{"syntax":"swift","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"type":"codeListing"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"type":"topic","kind":"symbol","title":"SwiftNLP","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"role":"collection","url":"\/documentation\/swiftnlp","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP"},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"type":"topic","kind":"article","title":"Text Feature Vectorization, Sparse TF-IDF & Local Embeddings","abstract":[{"text":"Convert text corpora into numerical and sparse feature matrices using ","type":"text"},{"type":"codeVoice","code":"TFIDFVectorizer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"CountVectorizer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"HashingVectorizer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SparseVector"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"text":".","type":"text"}],"role":"article","url":"\/documentation\/swiftnlp\/vectorizationandembeddings","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"}}}