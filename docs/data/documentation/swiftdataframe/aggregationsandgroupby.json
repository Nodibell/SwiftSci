{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame."}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"topicSections":[{"anchor":"Grouping-APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"],"title":"Grouping APIs"}],"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"sections":[],"kind":"article","metadata":{"modules":[{"name":"SwiftDataFrame"}],"role":"collectionGroup","roleHeading":"API Collection","title":"High-Performance GroupBy & Vectorized Aggregations"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory.","type":"text"}]},{"type":"heading","text":"1. Basic GroupBy Aggregation","level":2,"anchor":"1-Basic-GroupBy-Aggregation"},{"type":"codeListing","syntax":"swift","code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"]},{"type":"heading","text":"2. Multi-Column Grouping","level":2,"anchor":"2-Multi-Column-Grouping"},{"type":"paragraph","inlineContent":[{"text":"You can group by multiple categorical dimensions simultaneously:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"]},{"type":"heading","text":"3. Performance & Memory Efficiency","level":2,"anchor":"3-Performance--Memory-Efficiency"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Single-Pass Hash Accumulation","type":"text"}]},{"type":"text","text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"vDSP Vector Reductions"}]},{"type":"text","text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines ("},{"type":"codeVoice","code":"vDSP_sveD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_meanvD"},{"type":"text","text":")."}]}]}]}],"kind":"content"}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"url":"\/documentation\/swiftdataframe","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}],"kind":"symbol","title":"SwiftDataFrame","type":"topic","role":"collection","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)","title":"groupBy(_:)","abstract":[{"text":"Returns a ","type":"text"},{"code":"GroupedDataFrame","type":"codeVoice"},{"text":" for aggregation.","type":"text"}],"type":"topic","url":"\/documentation\/swiftdataframe\/dataframe\/groupby(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupBy"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"...) -> "},{"kind":"typeIdentifier","text":"GroupedDataFrame","preciseIdentifier":"s:14SwiftDataFrame07GroupedbC0V"}]}}}