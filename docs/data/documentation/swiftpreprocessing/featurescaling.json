{"variants":[{"paths":["\/documentation\/swiftpreprocessing\/featurescaling"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Feature Scaling, Normalization & Flat 1D Memory","modules":[{"name":"SwiftPreprocessing"}],"roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature scaling is crucial for gradient-based estimators (Neural Networks, Logistic Regression) and distance-based estimators (KNN, DBSCAN, SVM). Without scaling, features with large numeric scales disproportionately dominate distance calculations and gradient updates."}]},{"type":"thematicBreak"},{"text":"⚡ Flat 1D Memory Layout & Hardware Vectorization","level":2,"type":"heading","anchor":"%E2%9A%A1-Flat-1D-Memory-Layout--Hardware-Vectorization"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftPreprocessing"},{"type":"text","text":" operates on contiguous 1D row-major flat buffers "},{"type":"codeVoice","code":"[Double]"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"[Float]"},{"type":"text","text":") with stride indexing "},{"type":"codeVoice","code":"index = row * cols + col"},{"type":"text","text":":"}]},{"syntax":null,"type":"codeListing","code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All arithmetic operations ("},{"type":"codeVoice","code":"vDSP_vsubD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_vsdivD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP.sort"},{"type":"text","text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections."}]},{"type":"thematicBreak"},{"text":"1. `StandardScaler` (Z-Score Standardization)","level":2,"type":"heading","anchor":"1-StandardScaler-Z-Score-Standardization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforms features to have zero mean ("},{"type":"codeVoice","code":"μ = 0"},{"type":"text","text":") and unit variance ("},{"type":"codeVoice","code":"σ² = 1"},{"type":"text","text":"):"}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"z = (x - μ) \/ σ"}]}],"type":"aside","style":"note"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"]},{"type":"thematicBreak"},{"text":"2. `MinMaxScaler` (Bounded Range Scaling)","level":2,"type":"heading","anchor":"2-MinMaxScaler-Bounded-Range-Scaling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Linearly transforms features into a bounded range "},{"type":"codeVoice","code":"[a, b]"},{"type":"text","text":" (defaults to "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":"):"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)","type":"codeVoice"}]}],"type":"aside","name":"Note","style":"note"},{"code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"3-RobustScaler-Median--IQR-Scaling","type":"heading","level":2,"text":"3. `RobustScaler` (Median & IQR Scaling)"},{"type":"paragraph","inlineContent":[{"text":"When datasets contain extreme outliers, mean and standard deviation are distorted. ","type":"text"},{"code":"RobustScaler","type":"codeVoice"},{"text":" scales features using the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Median"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"Interquartile Range (IQR = Q3 - Q1)"}]},{"type":"text","text":":"}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"x' = (x - Median) \/ IQR"}]}]},{"code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling","type":"heading","level":2,"text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Scales each sample independently to have unit L1, L2, or Max norm:"}]},{"code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Memory & Performance Tip:"}]},{"text":" ","type":"text"},{"type":"text","text":"Use "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput."}]}],"name":"Note","type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"sections":[],"abstract":[{"text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using ","type":"text"},{"type":"codeVoice","code":"StandardScaler"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MinMaxScaler"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RobustScaler"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"Normalizer"},{"text":" powered by Apple Accelerate ","type":"text"},{"type":"codeVoice","code":"vDSP"},{"text":".","type":"text"}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"role":"collection","type":"topic","title":"SwiftPreprocessing","abstract":[{"text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines.","type":"text"}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","url":"\/documentation\/swiftpreprocessing","kind":"symbol"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseDataStructures":{"title":"Memory-Efficient Sparse Matrix Representations","abstract":[{"text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/swiftpreprocessing\/sparsedatastructures","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","role":"collectionGroup"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"role":"article","type":"topic","title":"Categorical Encoding & Imputation","abstract":[{"text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer.","type":"text"}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","url":"\/documentation\/swiftpreprocessing\/encodersandimputers","kind":"article"}}}