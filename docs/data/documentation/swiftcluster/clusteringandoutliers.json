{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Clustering and outlier detection algorithms often suffer from quadratic distance computation bottlenecks ("},{"code":"O(N²)","type":"codeVoice"},{"type":"text","text":"). "},{"code":"SwiftCluster","type":"codeVoice"},{"type":"text","text":" employs a balanced "},{"inlineContent":[{"text":"KD-Tree spatial index","type":"text"}],"type":"strong"},{"type":"text","text":" reducing neighbor queries to "},{"type":"codeVoice","code":"O(N · log N)"},{"type":"text","text":", enabling instant processing of large spatial datasets."}]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"%E2%9A%A1-Spatial-Indexing-KD-Tree-vs-Brute-Force","text":"⚡ Spatial Indexing: KD-Tree vs Brute-Force"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Dataset Size (N)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Brute-Force DBSCAN ("},{"type":"codeVoice","code":"O(N²)"},{"text":" Distance Matrix)","type":"text"}]}],[{"inlineContent":[{"text":"SwiftCluster KD-Tree DBSCAN (","type":"text"},{"code":"O(N · log N)","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Speedup","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"1,000 points","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"42 ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.8 ms"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"23.3× faster"}]}]}]],[[{"inlineContent":[{"inlineContent":[{"text":"10,000 points","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"4,250 ms (4.25 s)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"28 ms"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"151.7× faster"}]}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"100,000 points","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Out of Memory (100k × 100k matrix = 80 GB RAM)","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"380 ms (0.38 s)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"∞ (Memory Safe)","type":"text"}]}]}]]],"header":"row","type":"table","alignments":["left","left","left","left"]},{"type":"thematicBreak"},{"type":"heading","anchor":"1-Density-Based-Clustering-DBSCAN","level":2,"text":"1. Density-Based Clustering (`DBSCAN`)"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DBSCAN"},{"text":" discovers clusters of arbitrary shapes and isolates noise points without requiring a pre-specified cluster count ","type":"text"},{"type":"codeVoice","code":"K"},{"text":".","type":"text"}]},{"type":"codeListing","code":["import Foundation","import SwiftCluster","","\/\/ 1. Generate multi-cluster 2D coordinates","let cluster1 = (0..<100).map { _ in [Double.random(in: 0...2), Double.random(in: 0...2)] }","let cluster2 = (0..<100).map { _ in [Double.random(in: 10...12), Double.random(in: 10...12)] }","let noise = [[5.0, 5.0], [8.0, 2.0]]","let points = cluster1 + cluster2 + noise","","\/\/ 2. Initialize DBSCAN with spatial neighborhood epsilon and minPoints","let dbscan = DBSCAN(eps: 1.5, minSamples: 5)","let labels = dbscan.fit(points)","","\/\/ -1 indicates noise \/ outlier points, 0, 1, ... indicate cluster IDs","let clusterCount = Set(labels.filter { $0 >= 0 }).count","let noiseCount = labels.filter { $0 == -1 }.count","","print(\"DBSCAN identified \\(clusterCount) clusters and \\(noiseCount) noise outliers.\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","text":"2. K-Means++ Clustering (`KMeans`)","anchor":"2-K-Means++-Clustering-KMeans","level":2},{"inlineContent":[{"type":"text","text":"Fast centroid-based clustering using D² weighted probabilistic initialization for accelerated convergence:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftCluster","","let kmeans = KMeans(nClusters: 3, maxIterations: 100, tolerance: 1e-4, randomSeed: 42)","try await kmeans.fit(features: points)","","let centroids = await kmeans.centroids","print(\"Learned Centroids: \\(centroids)\")","","let clusterAssignments = try await kmeans.predict(features: points)","let inertia = try await kmeans.inertia(features: points)","print(\"Within-Cluster Sum of Squares (Inertia): \\(String(format: \"%.2f\", inertia))\")"]},{"type":"thematicBreak"},{"level":2,"text":"3. Density-Based Outlier Detection (`LocalOutlierFactor`)","anchor":"3-Density-Based-Outlier-Detection-LocalOutlierFactor","type":"heading"},{"inlineContent":[{"code":"LocalOutlierFactor","type":"codeVoice"},{"type":"text","text":" measures local density deviation of an observation relative to its K-nearest neighbors:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftCluster","","let lof = LocalOutlierFactor(nNeighbors: 15, maxSamples: 5000)","let outlierLabels = try lof.fitPredict(points)","","\/\/ -1 indicates local density anomaly, +1 indicates inlier","let anomalies = outlierLabels.enumerated().filter { $0.element == -1 }.map { $0.offset }","print(\"LOF detected anomalies at indices: \\(anomalies)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"4. Isolation Forest for High-Dimensional Anomaly Detection","anchor":"4-Isolation-Forest-for-High-Dimensional-Anomaly-Detection","type":"heading"},{"inlineContent":[{"code":"IsolationForest","type":"codeVoice"},{"text":" recursively partitions feature subspaces using random split hyperplanes. Anomalies require significantly fewer splits to isolate:","type":"text"}],"type":"paragraph"},{"code":["import SwiftCluster","","let isoForest = IsolationForest(nEstimators: 100, maxSamples: 256, contamination: 0.05, randomSeed: 42)","try await isoForest.fit(features: points)","","let anomalyScores = try await isoForest.decisionFunction(features: points)","let predictions = try await isoForest.predict(features: points)","","print(\"Isolation Forest predictions ready for \\(predictions.count) observations.\")"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers"},"variants":[{"paths":["\/documentation\/swiftcluster\/clusteringandoutliers"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Spatial Indexing, Clustering & Outlier Detection","modules":[{"name":"SwiftCluster"}],"role":"article"},"abstract":[{"text":"High-performance clustering and density-based anomaly detection powered by ","type":"text"},{"code":"KDTree","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"DBSCAN"},{"text":", ","type":"text"},{"type":"codeVoice","code":"KMeans"},{"text":", ","type":"text"},{"type":"codeVoice","code":"LocalOutlierFactor"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"IsolationForest"},{"text":".","type":"text"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"],"generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://SwiftCluster/documentation/SwiftCluster/HNSWVectorSearch":{"kind":"article","url":"\/documentation\/swiftcluster\/hnswvectorsearch","role":"collectionGroup","type":"topic","abstract":[{"text":"Scale approximate nearest neighbor (ANN) retrieval logarithmically using Hierarchical Navigable Small World graphs.","type":"text"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch","title":"High-Dimensional Vector Search with HNSW"},"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"abstract":[{"type":"text","text":"Reduce feature dimensionality using SVD-based PCA with automatic CPU and UMA GPU routing."}],"url":"\/documentation\/swiftcluster\/dimensionalityreduction","kind":"article","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","type":"topic","role":"article","title":"Principal Component Analysis (PCA)"},"doc://SwiftCluster/documentation/SwiftCluster/VectorStoreAndRAG":{"kind":"article","url":"\/documentation\/swiftcluster\/vectorstoreandrag","role":"collectionGroup","type":"topic","abstract":[{"text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate.","type":"text"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","title":"In-Memory VectorStore & On-Device RAG"},"doc://SwiftCluster/documentation/SwiftCluster":{"kind":"symbol","abstract":[{"type":"text","text":"PCA Dimensionality Reduction & Unsupervised Clustering."}],"url":"\/documentation\/swiftcluster","role":"collection","title":"SwiftCluster","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster"}}}