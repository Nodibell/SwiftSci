{"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"generated":true,"title":"Guides & Tutorials"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"text":" provides high-throughput binary weight parsers that map model weights directly into unified memory (UMA) without intermediate memory allocations, paired with a robust token sampling pipeline operating strictly on unnormalized logits.","type":"text"}]},{"type":"thematicBreak"},{"anchor":"1-GGUF-Zero-Copy-Weight-Parsing","level":2,"type":"heading","text":"1. GGUF Zero-Copy Weight Parsing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"GGUFParser"},{"text":" decodes GGUF header metadata and extracts tensor blocks into semantic ","type":"text"},{"type":"codeVoice","code":"QuantizedTensor"},{"type":"text","text":" representations without eager dequantization into full floating-point arrays:"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftLLM","","let modelURL = URL(fileURLWithPath: \"models\/llama-3-8b-instruct.Q4_0.gguf\")","","\/\/ 1. Parse GGUF weights into QuantizedTensor map","let weights: [String: QuantizedTensor] = try GGUFParser.parse(url: modelURL)","","\/\/ 2. Inspect parsed tensor metadata","if let attnWeight = weights[\"blk.0.attn_q.weight\"] {","    print(\"Tensor name: \\(attnWeight.name)\")","    print(\"Shape: \\(attnWeight.shape)\")","    print(\"Scheme: \\(String(describing: attnWeight.scheme))\") \/\/ .q4_0","    print(\"Block Size: \\(attnWeight.layoutMetadata.blockSize)\") \/\/ 32","}","","\/\/ 3. Extract separated packed weight and scale buffers for Metal GEMV","if let (packedWeights, scales) = weights[\"blk.0.attn_q.weight\"]?.extractSeparatedBuffers() {","    print(\"Extracted \\(packedWeights.count) weight bytes and \\(scales.count) scale bytes.\")","}"]},{"type":"thematicBreak"},{"text":"2. SafeTensors Zero-Copy Weight Parsing","anchor":"2-SafeTensors-Zero-Copy-Weight-Parsing","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SafeTensorsParser"},{"type":"text","text":" parses JSON header descriptors and maps FP16\/FP32\/BF16 tensor payloads directly into "},{"type":"codeVoice","code":"MLXArray"},{"type":"text","text":" instances:"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftLLM","import MLX","","let safeURL = URL(fileURLWithPath: \"models\/model.safetensors\")","","\/\/ Parse SafeTensors into native MLX tensor dictionary","let tensors: [String: MLXArray] = try SafeTensorsParser.parse(url: safeURL)","","for (tensorName, array) in tensors {","    print(\"Loaded tensor '\\(tensorName)': shape=\\(array.shape), dtype=\\(array.dtype)\")","}"]},{"type":"thematicBreak"},{"text":"3. Token Sampling with SamplingConfiguration","anchor":"3-Token-Sampling-with-SamplingConfiguration","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"After computing next-token logits from "},{"type":"codeVoice","code":"TransformerDecoder.forward"},{"type":"text","text":", token selection is governed by "},{"type":"codeVoice","code":"SamplingConfiguration"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftLLM","import MLX","","\/\/ 1. Define generation parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","let pastTokens = [128000, 791, 7453, 374]","let nextLogits: MLXArray = ... \/\/ Shape [vocab_size] from decoder.forward","","\/\/ 2. Sample next token ID applying penalty, temperature, top-k, and top-p","let nextToken = Sampler.sample(","    logits: nextLogits,","    config: sampling,","    pastTokens: pastTokens",")","","print(\"Sampled next token ID: \\(nextToken)\")"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[!TIP]"},{"type":"text","text":" "},{"type":"text","text":"For detailed mathematical formulations of repetition penalty, temperature scaling, top-k truncation, and nucleus (top-p) masking, see "},{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","type":"reference","isActive":true},{"type":"text","text":"."}]}],"type":"aside","style":"note","name":"Note"},{"type":"thematicBreak"}]}],"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftLLM"}],"title":"GGUF\/SafeTensors Parsing & Sampling"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/weightparsingandsampling"]}],"abstract":[{"text":"Parse GGUF and SafeTensors model weights zero-copy into Apple Silicon unified memory and sample tokens with fine-grained logits controls.","type":"text"}],"sections":[],"identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/GGUFParser","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SafeTensorsParser","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedTensor","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedLayoutMetadata"],"anchor":"Weight-Parsers--Representations","title":"Weight Parsers & Representations"},{"anchor":"Sampling--Decoding","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\