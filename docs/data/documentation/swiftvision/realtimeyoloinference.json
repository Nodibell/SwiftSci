{"metadata":{"role":"article","modules":[{"name":"SwiftVision"}],"roleHeading":"Article","title":"Real-Time YOLOv8 Object Detection & Hardware Acceleration"},"hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"abstract":[{"type":"text","text":"Execute real-time anchor-free object detection on Apple Silicon GPU and Neural Engine using "},{"type":"codeVoice","code":"YOLOv8Detector"},{"type":"text","text":", "},{"type":"codeVoice","code":"YOLOPreprocessor"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ImageDataset"},{"type":"text","text":"."}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftvision\/realtimeyoloinference"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/RealTimeYOLOInference"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftVision","type":"codeVoice"},{"type":"text","text":" implements the full "},{"inlineContent":[{"text":"YOLOv8","type":"text"}],"type":"strong"},{"type":"text","text":" deep learning architecture in native Swift and MLX. The pipeline combines Apple Accelerate "},{"code":"vImageScale_PlanarF","type":"codeVoice"},{"type":"text","text":" for bilinear letterbox scaling, deep CSPDarknet backbone evaluation, decoupled PANet feature pyramid routing, and anchorless box decoding with Non-Maximum Suppression (NMS)."}]},{"type":"codeListing","syntax":null,"code":["Input Image (RGB \/ File \/ CVPixelBuffer)","               │","               ▼","┌────────────────────────────────────────┐","│ Apple Accelerate vImage Letterbox      │ ───► Resizes to 640x640 with (114, 114, 114) padding","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOBackbone (CSPDarknet + SPPF)       │ ───► P3, P4, P5 multi-scale feature maps","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLONeck (PANet Feature Pyramid)       │ ───► Top-down & bottom-up cross-scale fusion","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOHead (Decoupled Class & Box DFL)   │ ───► 8,400 raw candidate anchor predictions","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ Vectorized Non-Maximum Suppression     │ ───► Final BoundingBoxes with class IDs & confidences","└────────────────────────────────────────┘"]},{"type":"thematicBreak"},{"level":2,"anchor":"1-Loading-Weights-and-Executing-Detection","type":"heading","text":"1. Loading Weights and Executing Detection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Load pre-trained "},{"code":".onnx","type":"codeVoice"},{"type":"text","text":" or "},{"code":".safetensors","type":"codeVoice"},{"type":"text","text":" model weights and detect objects:"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftVision","","\/\/ 1. Initialize YOLOv8 detector from model weights file","let modelURL = URL(fileURLWithPath: \"yolov8n.onnx\")","let detector = try YOLOv8Detector(weightsURL: modelURL)","","\/\/ 2. Perform object detection on an image file","let imageURL = URL(fileURLWithPath: \"street_scene.jpg\")","let detections = try await detector.detect(","    imageURL: imageURL,","    confidenceThreshold: 0.4,","    iouThreshold: 0.45",")","","print(\"=== YOLOv8 Detection Results ===\")","for box in detections {","    let rect = box.rect","    print(\"Class: '\\(box.className)' (ID: \\(box.classId)) | Confidence: \\(String(format: \"%.2f%%\", box.confidence * 100)) | Box: [x=\\(rect.minX), y=\\(rect.minY), w=\\(rect.width), h=\\(rect.height)]\")","}"]},{"type":"thematicBreak"},{"level":2,"anchor":"2-Hardware-Accelerated-Letterbox-Preprocessing-vImage","type":"heading","text":"2. Hardware-Accelerated Letterbox Preprocessing (`vImage`)"},{"type":"paragraph","inlineContent":[{"code":"YOLOPreprocessor","type":"codeVoice"},{"type":"text","text":" uses Apple Accelerate’s "},{"code":"vImageScale_PlanarF","type":"codeVoice"},{"type":"text","text":" with "},{"code":"kvImageHighQualityResampling","type":"codeVoice"},{"type":"text","text":", performing aspect-ratio preserving downsampling directly in hardware:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftVision","","\/\/ Preprocess raw image buffer into normalized Float32 planar tensor","let inputImage = URL(fileURLWithPath: \"input_1920x1080.jpg\")","let (tensorBuffer, scaleFactor, padX, padY) = try YOLOPreprocessor.preprocess(","    imageURL: inputImage,","    targetSize: (width: 640, height: 640)",")","","print(\"Preprocessed tensor count: \\(tensorBuffer.count) Float elements.\")","print(\"Scale Factor: \\(scaleFactor), Padding: (\\(padX), \\(padY))\")"]},{"type":"thematicBreak"},{"level":2,"anchor":"3-Training--Batching-Image-Datasets","type":"heading","text":"3. Training & Batching Image Datasets"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Load and normalize computer vision datasets in compact "},{"code":"Float32","type":"codeVoice"},{"type":"text","text":" tensors:"}]},{"type":"codeListing","syntax":"swift","code":["let dataset = try ImageDataset(","    directoryURL: URL(fileURLWithPath: \"coco_val2017\/\"),","    targetSize: (width: 256, height: 256),","    normalize: true",")","","print(\"Loaded \\(dataset.count) images. Memory per image: \\(dataset.data.count * 4 \/ 1024) KB.\")"]}]}],"references":{"doc://SwiftVision/documentation/SwiftVision":{"type":"topic","abstract":[{"type":"text","text":"Computer Vision Neural Inference, Object Detection & Image Datasets."}],"kind":"symbol","title":"SwiftVision","url":"\/documentation\/swiftvision","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision","role":"collection"}}}