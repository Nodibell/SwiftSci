{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" module bridges the gap between relational SQL storage engines and Swift’s type-safe, actor-isolated data ecosystem. Traditional database client libraries often convert SQL fields to intermediate strings or untyped objects, imposing significant heap allocation overhead and potential loss of numeric precision."}]},{"inlineContent":[{"type":"codeVoice","code":"AnySendableValue"},{"type":"text","text":" provides a unified, zero-copy, enum-based abstraction covering primary relational types:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"64-bit IEEE 754 floating point numbers ("},{"type":"codeVoice","code":".double"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Standard host-width integers ("},{"type":"codeVoice","code":".int"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Explicit 64-bit signed integers (","type":"text"},{"code":".int64","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"UTF-8 text strings ("},{"type":"codeVoice","code":".string"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Boolean flags ("},{"type":"codeVoice","code":".bool"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"High-precision timestamps ("},{"type":"codeVoice","code":".date"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Raw byte buffers ("},{"type":"codeVoice","code":".data"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inl