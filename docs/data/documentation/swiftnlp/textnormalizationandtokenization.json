{"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"title":"Guides & Tutorials"}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}],"type":"paragraph"},{"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","type":"heading","level":3,"text":"1. Multi-lingual Word & Sentence Tokenization"},{"code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"type":"codeListing","syntax":"swift"},{"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","type":"heading","level":3,"text":"2. POS Tagging, Lemmatization & Entity Extraction"},{"code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"type":"codeListing","syntax":"swift"},{"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","type":"heading","level":3,"text":"3. Sentiment Analysis (VADER & NLSentiment)"},{"code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization"},"sections":[],"metadata":{"title":"Text Normalization, Tokenization & Linguistic Tagging","modules":[{"name":"SwiftNLP"}],"roleHeading":"Article","role":"article"},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"code":"NaturalLanguage","type":"codeVoice"},{"type":"text","text":" framework."}],"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"kind":"symbol","type":"topic","title":"SwiftNLP","role":"collection","url":"\/documentation\/swiftnlp","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP"},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"title":"Text Feature Vectorization, Embeddings & Naive Bayes Classification","url":"\/documentation\/swiftnlp\/vectorizationandembeddings","kind":"article","abstract":[{"text":"Convert text corpora into numerical feature matrices using ","type":"text"},{"code":"CountVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HashingVectorizer","t