{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}]},{"level":3,"type":"heading","text":"1. Multi-lingual Word & Sentence Tokenization","anchor":"1-Multi-lingual-Word--Sentence-Tokenization"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"]},{"level":3,"type":"heading","text":"2. POS Tagging, Lemmatization & Entity Extraction","anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction"},{"type":"codeListing","syntax":"swift","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"]},{"level":3,"type":"heading","text":"3. Sentiment Analysis (VADER & NLSentiment)","anchor":"3-Sentiment-Analysis-VADER--NLSentiment"},{"type":"codeListing","syntax":"swift","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftNLP"}],"title":"Text Normalization, Tokenization & Linguistic Tagging","role":"article"},"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"type":"codeVoice","code":"NaturalLanguage"},{"type":"text","text":" framework."}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ChatAPI","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LlamaTokenizer"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials","generated":true}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/LlamaTokenizer":{"kind":"article","url":"\/documentation\/swiftnlp\/llamatokenizer","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LlamaTokenizer","role":"article","abstract":[{"type":"codeVoice","code":"BPETokenizer(llama3TokenizerJSON:)"},{"text":" loads the byte-level BPE pipeline used by the pinned Llama 3.2 1B Instruct checkpoint.","type":"text"}],"type":"topic","title":"Llama checkpoint tokenization"},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"kind":"article","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","role":"article","url