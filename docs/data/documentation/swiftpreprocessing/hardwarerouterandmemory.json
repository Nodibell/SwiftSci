{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple Silicon features a "},{"type":"strong","inlineContent":[{"text":"Unified Memory Architecture (UMA)","type":"text"}]},{"text":" where the CPU, GPU, and Apple Neural Engine (ANE) share a single high-bandwidth memory pool. ","type":"text"},{"type":"codeVoice","code":"SwiftPreprocessing"},{"text":" provides intelligent hardware routing and memory reservation primitives to prevent GPU saturation and avoid data copying.","type":"text"}]},{"type":"heading","level":2,"text":"1. The Hardware Router","anchor":"1-The-Hardware-Router"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"HardwareRouter"},{"text":" assesses tensor dimensions and operation complexity to select the optimal computing engine:","type":"text"}]},{"type":"codeListing","syntax":"mermaid","code":["graph TD","    Op[Compute Operation] --> Router{HardwareRouter}","    Router -->|Small \/ Vector < 50k| CPU[Accelerate \/ AMX \/ NEON]","    Router -->|Large Matrix \/ Autodiff| GPU[MLX Metal GPU]","    Router -->|Static Inference| ANE[Core ML Engine]"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Small Vectors (","type":"text"},{"type":"codeVoice","code":"N < 50,000"},{"text":")","type":"text"}],"type":"strong"},{"type":"text","text":": Routed to CPU Accelerate (vDSP\/BLAS\/LAPACK) to eliminate GPU kernel dispatch latency."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Large Tensors & Deep Learning","type":"text"}]},{"type":"text","text":": Routed to MLX Metal GPU for massive parallel throughput."}]}]}]},{"type":"heading","level":2,"text":"2. WiredMemoryManager & Ticket System","anchor":"2-WiredMemoryManager--Ticket-System"},{"inlineContent":[{"type":"text","text":"To prevent out-of-memory (OOM) conditions during concurrent analytical workloads, "},{"type":"codeVoice","code":"WiredMemoryManager"},{"type":"text","text":" implements an asynchronous FIFO reservation system:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftPreprocessing","","\/\/ Acquire a GPU execution slot","let ticket = try await WiredMemoryManager.shared.reserveMemory(estimatedBytes: 64 * 1024 * 1024)","","\/\/ Execute heavy MLX operations","\/\/ ...","","\/\/ Automatically flushes GPU caches upon completion","await ticket.release()"]}],"kind":"content"}],"kind":"article","metadata":{"title":"Hardware Routing & Unified Memory Governance","role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftPreprocessing"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouterAndMemory"},"topicSections":[{"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket"],"title":"Memory & Routing APIs","anchor":"Memory--Routing-APIs"}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"sections":[],"abstract":[{"text":"Understand how SwiftSci automatically routes workloads between CPU (Accelerate\/AMX\/NEON) and Metal GPU (MLX) with strict concurrency safety.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftpreprocessing\/hardwarerouterandmemory"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"type":"topic","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","abstract":[{"text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines.","type":"text"}],"url":"\/documentation\/swiftpreprocessing","title":"SwiftPreprocessing","kind":"symbol","role":"collection"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryManager":{"title":"WiredMemoryManager","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"WiredMemoryManager"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"WiredMemoryManager"}],"abstract":[{"type":"text","text":"Actor-based manager that controls concurrent allocations and tasks in Apple Silicon Unified Memory."}],"url":"\/documentation\/swiftpreprocessing\/wiredmemorymanager","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","kind":"symbol"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryTicket":{"abstract":[{"type":"text","text":"A ticket representing a reservation of memory and a concurrency slot."}],"navigatorTitle":[{"kind":"identifier","text":"WiredMemoryTicket"}],"url":"\/documentation\/swiftpreprocessing\/wiredmemoryticket","title":"WiredMemoryTicket","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"WiredMemoryTicket"}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/HardwareRouter":{"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"HardwareRouter"}],"type":"topic","url":"\/documentation\/swiftpreprocessing\/hardwarerouter","title":"HardwareRouter","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","kind":"symbol","role":"symbol","abstract":[{"text":"Serializes device selection and MLX default-device changes (global MLX state).","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"HardwareRouter"}]}}}