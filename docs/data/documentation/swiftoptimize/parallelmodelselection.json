                      │","       └──────────────────┬──────────────────┘","                          ▼","            withThrowingTaskGroup Aggregator","                          ▼","         Cross-Validation Average Leaderboard"],"type":"codeListing"},{"type":"heading","anchor":"Cooperative-Cancellation--Bounded-Budgets","level":3,"text":"Cooperative Cancellation & Bounded Budgets"},{"type":"paragraph","inlineContent":[{"text":"When training under a time budget (such as ","type":"text"},{"type":"codeVoice","code":"AutoML(timeBudgetSeconds:)"},{"type":"text","text":"), tasks run inside a managed scope. If the time budget expires or a fatal error occurs in a critical pipeline step, child tasks cooperatively respect task cancellation without leaking threads or memory."}]},{"text":"Deterministic Class Ordering","anchor":"Deterministic-Class-Ordering","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"OneVsRestClassifier","type":"codeVoice"},{"type":"text","text":", binary classification estimators are dispatched concurrently to maximize throughput across cores. Results are tagged with their class index "},{"code":"(c, est)","type":"codeVoice"},{"text":" and sorted prior to storage, ensuring 100% deterministic prediction ordering across runs.","type":"text"}]},{"type":"heading","level":2,"anchor":"Example-Usage","text":"Example Usage"},{"type":"codeListing","code":["import SwiftOptimize","import SwiftML","","\/\/ 1. Concurrent AutoML search across DecisionTree, RandomForest, and MLP","let automl = AutoML(timeBudgetSeconds: 30.0)","let report = try await automl.fit(features: X, targets: y)","print(\"Winning Model: \\(report.bestModel)\")","","\/\/ 2. Parallel One-Vs-Rest classification","let ovr = OneVsRestClassifier(numClasses: 5)","try await ovr.fit(features: X, targets: y)","let predictions = try await ovr.predict(features: X_test)"],"syntax":"swift"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url"