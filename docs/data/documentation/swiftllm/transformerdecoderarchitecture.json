{"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/transformerdecoderarchitecture"]}],"metadata":{"modules":[{"name":"SwiftLLM"}],"role":"article","title":"Transformer Architecture & LLM Inference Guide","roleHeading":"Article"},"kind":"article","abstract":[{"type":"text","text":"High-throughput, on-device causal language model execution on Apple Silicon Unified Memory Architecture using "},{"code":"TransformerDecoder","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PagedKVCache"},{"type":"text","text":", "},{"code":"GGUFParser","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SafeTensorsParser","type":"codeVoice"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Architecture Overview","anchor":"Architecture-Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" implements the modern Llama-3 \/ Mistral autoregressive causal decoder architecture natively in pure Swift and MLX:"}],"type":"paragraph"},{"syntax":null,"code":["                          ┌────────────────────────┐","                          │    Input Token IDs     │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │   Token Embeddings     │","                          └───────────┬────────────┘","                                      ▼","                      ┌────────────────────────────────┐","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │ Multi-Head Attention + RoPE│ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │      SwiGLU FFN (SiLU)     │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │ └─────────────┬──────────────┘ │ x N Layers","                      └───────────────┼────────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │     Final RMSNorm      │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │  LM Head (Logits)      │","                          └────────────────────────┘"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"1. Core Architectural Components","anchor":"1-Core-Architectural-Components","type":"heading"},{"type":"heading","anchor":"RoPE-Rotary-Position-Embedding-with-Dynamic-Offset","text":"RoPE (Rotary Position Embedding) with Dynamic Offset","level":3},{"inlineContent":[{"text":"Applies 2D rotation to Query and Key projections based on position index $m$:","type":"text"},{"text":" ","type":"text"},{"text":"$$Q_{\\text{rot}} = \\text{RoPE}(Q, m), \\quad K_{\\text{rot}} = \\text{RoPE}(K, m)$$","type":"text"},{"text":" ","type":"text"},{"text":"During incremental autoregressive decoding, ","type":"text"},{"code":"RoPEEmbedding","type":"codeVoice"},{"text":" dynamically incorporates ","type":"text"},{"code":"positionOffset","type":"codeVoice"},{"text":" (corresponding to the number of prior cached tokens), ensuring correct relative attention geometry across arbitrary context lengths without learned position embeddings.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Two-Stage-KV-Cache-Generation-Prefill-+-Decode","text":"Two-Stage KV-Cache Generation (Prefill + Decode)","type":"heading"},{"inlineContent":[{"text":"Generation executes in two distinct stages:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Prefill Pass"}],"type":"strong"},{"text":": Evaluates the entire prompt sequence $[0 ..< N]$ in parallel, writing Key and Value projections into ","type":"text"},{"code":"KVCache","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Incremental Decode Steps"}],"type":"strong"},{"text":": Processes only the single newest token $[N+1]$ at each step. The new Query vector performs dot-product attention against all cached Key and Value vectors ($Q_{N+1} \\cdot K_{\\text{accumulated}}^T$), eliminating redundant $O(N^2)$ prompt recomputation.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"anchor":"SwiGLU-Feed-Forward-Network","text":"SwiGLU Feed-Forward Network","type":"heading"},{"inlineContent":[{"text":"Replaces legacy ReLU\/GELU activations with Swish-Gated Linear Units (Llama-style):","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiGLU(x) = (SiLU(x · W_gate) ⊙ (x · W_up)) · W_down"}],"type":"paragraph"}]},{"text":"Paged KV-Cache","anchor":"Paged-KV-Cache","type":"heading","level":3},{"inlineContent":[{"text":"Manages attention Key-Value projection states in fixed-size contiguous memory pages (vLLM architecture), eliminating RAM fragmentation during dynamic multi-turn autoregressive decoding.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"2. Parsing Weight Formats (SafeTensors & GGUF)","anchor":"2-Parsing-Weight-Formats-SafeTensors--GGUF","type":"heading","level":2},{"inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"text":" includes strict parsers for both HuggingFace ","type":"text"},{"code":".safetensors","type":"codeVoice"},{"text":" headers and ","type":"text"},{"code":"GGUF","type":"codeVoice"},{"text":" quantized binary models:","type":"text"}],"type":"paragraph"},{"code":["import Foundation","import SwiftLLM","","\/\/ 1. Parse SafeTensors weight metadata","let safeTensorsURL = URL(fileURLWithPath: \"model.safetensors\")","let (tensors, metadata) = try SafeTensorsParser.parse(fileURL: safeTensorsURL)","","print(\"Found \\(tensors.count) tensor layers in SafeTensors archive.\")","for (tensorName, info) in tensors.prefix(5) {","    print(\"Layer '\\(tensorName)': dtype=\\(info.dtype), shape=\\(info.shape)\")","}","","\/\/ 2. Parse GGUF Quantized Binary Archive (Zero-Copy)","let ggufURL = URL(fileURLWithPath: \"llama-3-8b.Q4_K_M.gguf\")","let ggufModel = try GGUFParser.parse(fileURL: ggufURL)","print(\"Loaded GGUF Model with \\(ggufModel.tensors.count) quantized tensors.\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"text":"3. End-to-End Decoder Configuration & Two-Stage Inference","anchor":"3-End-to-End-Decoder-Configuration--Two-Stage-Inference","type":"heading","level":2},{"inlineContent":[{"text":"Construct a ","type":"text"},{"code":"TransformerDecoder","type":"codeVoice"},{"text":" and perform two-stage cached generation:","type":"text"}],"type":"paragraph"},{"code":["import SwiftLLM","","\/\/ 1. Initialize TransformerDecoder with Llama-3-8B configuration","let config = LLMConfig.llama3_8B","let decoder = TransformerDecoder(config: config)","let cache = KVCache(config: config)","","let promptTokens: [Int] = [128000, 791, 7453, 374] \/\/ Tokenized input","var generatedTokens = promptTokens","let maxNewTokens = 50","","\/\/ 2. Stage 1: Prefill prompt tokens into KV-cache","_ = try decoder.forward(tokens: promptTokens, cache: cache, isPrefill: true)","","\/\/ 3. Configure sampling options","let sampling = SamplingConfiguration(temperature: 0.7, topK: 40, topP: 0.9, repetitionPenalty: 1.1)","","\/\/ 4. Stage 2: Incremental single-token decoding loop","var currentToken = promptTokens.last!","for _ in 0..<maxNewTokens {","    let logits = try decoder.forward(tokens: [currentToken], cache: cache, isPrefill: false)","    let nextToken = Sampler.sample(logits: logits, config: sampling, history: generatedTokens)","    ","    generatedTokens.append(nextToken)","    currentToken = nextToken","    if nextToken == 128001 || nextToken == 128009 { \/\/ EOS tokens","        break","    }","}","","print(\"Generated sequence length: \\(generatedTokens.count) tokens.\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"text":"4. Structured JSON Grammar Decoding","anchor":"4-Structured-JSON-Grammar-Decoding","type":"heading","level":2},{"inlineContent":[{"text":"Enforce strict output conformance to Swift ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" schemas using ","type":"text"},{"code":"JSONGrammarDecoder","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import SwiftLLM","","struct SentimentResponse: Codable {","    let label: String","    let confidence: Double","}","","let grammarDecoder = JSONGrammarDecoder(schema: SentimentResponse.self)","let constrainedTokens = try grammarDecoder.constrainSampling(logits: logits, validTokens: vocabulary)"],"syntax":"swift","type":"codeListing"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture"},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"role":"article","kind":"article","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","title":"GGUF\/SafeTensors Parsing & Sampling","type":"topic","url":"\/documentation\/swiftllm\/weightparsingandsampling","abstract":[{"type":"text","text":"Parse GGUF and SafeTensors model weights zero-copy and sample tokens using Temperature and Top-K sampling."}]},"doc://SwiftLLM/documentation/SwiftLLM/MetalShadersQuantization":{"type":"topic","kind":"article","abstract":[{"text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU.","type":"text"}],"url":"\/documentation\/swiftllm\/metalshadersquantization","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization","title":"Native Metal MSL Shaders for Quantized LLMs","role":"collectionGroup"},"doc://SwiftLLM/documentation/SwiftLLM":{"role":"collection","url":"\/documentation\/swiftllm","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","type":"topic","kind":"symbol","title":"SwiftLLM","abstract":[{"type":"text","text":"Local Causal Transformer Decoder & Weight Parsers."}]}}}