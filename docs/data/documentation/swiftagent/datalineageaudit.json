{"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation."}],"type":"paragraph"},{"inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"type":"text","text":" automatically generates an immutable audit trail of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord"},{"type":"text","text":" entries for each command evaluated."}],"type":"paragraph"},{"text":"LineageRecord Structure","anchor":"LineageRecord-Structure","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord"},{"type":"text","text":" contains:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stepIndex"},{"text":": Sequential index of the step within the agent trajectory.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"operation","type":"codeVoice"},{"text":": The normalized DSL command executed (e.g., ","type":"text"},{"code":"filter(age)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"groupBy(category,mean)","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"inputRows","type":"codeVoice"},{"text":": Dataset row count immediately prior to transformation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"outputRows"},{"type":"text","text":": Dataset row count produced by the transformation."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"timestamp"},{"type":"text","text":": The exact timestamp of execution."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Example: Accessing Audit Trails","level":2,"anchor":"Example-Accessing-Audit-Trails"},{"type":"codeListing","code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents.","type":"text"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Data Lineage & Transformation Audit Trails","modules":[{"name":"SwiftAgent"}]},"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Audit-Types","title":"Audit Types"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/datalineageaudit"]}],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"title":"SwiftAgent","kind":"symbol","url":"\/documentation\/swiftagent","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","type":"topic","role":"collection"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"type":"topic","url":"\/documentation\/swiftagent\/swiftagentevaluator","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"SwiftAgentEvaluator","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiftAgentEvaluator","kind":"identifier"}],"title":"SwiftAgentEvaluator","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"},"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"navigatorTitle":[{"kind":"identifier","text":"LineageRecord"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LineageRecord","kind":"identifier"}],"abstract":[{"text":"Represents an immutable audit trail entry recording a discrete data transformation step.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","type":"topic","url":"\/documentation\/swiftagent\/lineagerecord","kind":"symbol","title":"LineageRecord"}}}