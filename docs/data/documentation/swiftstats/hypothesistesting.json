{"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiftStats"},{"text":" supports complete inferential statistics with exact p-value and confidence interval calculations.","type":"text"}],"type":"paragraph"},{"anchor":"1-Two-Sample-Students-t-Test","text":"1. Two-Sample Student’s t-Test","level":3,"type":"heading"},{"code":["import SwiftStats","","let groupA: [Double] = [12.1, 14.3, 11.8, 13.5, 15.0]","let groupB: [Double] = [9.8, 10.5, 11.2, 10.1, 9.4]","","let result = Stats.ttest(groupA, groupB)","print(\"t-statistic: \\(result.statistic), p-value: \\(result.pValue)\")","if result.isSignificant {","    print(\"Statistically significant difference (p < 0.05)\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"2-One-Way-ANOVA","text":"2. One-Way ANOVA","level":3,"type":"heading"},{"code":["let samples: [[Double]] = [groupA, groupB, [8.5, 9.0, 8.8]]","let anova = Stats.anova(samples)","print(\"F-statistic: \\(anova.statistic), p-value: \\(anova.pValue)\")"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Perform Student’s t-tests, paired t-tests, Chi-Square independence tests, and Analysis of Variance (ANOVA).","type":"text"}],"identifier":{"url":"doc:\/\/SwiftStats\/documentation\/SwiftStats\/HypothesisTesting","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftStats\/documentation\/SwiftStats\/DescriptiveStatistics","doc:\/\/SwiftStats\/documentation\/SwiftStats\/ChoosingDotProductAccuracy","doc:\/\/SwiftStats\/documentation\/SwiftStats\/DecimalANOVA"],"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"metadata":{"title":"Hypothesis Testing & ANOVA","modules":[{"name":"SwiftStats"}],"roleHeading":"Article","role":"article"},"variants":[{"paths":["\/documentation\/swiftstats\/hypothesistesting"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"p