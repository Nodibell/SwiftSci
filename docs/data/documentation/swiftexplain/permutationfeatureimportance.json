{"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Diagnostic Tools","anchor":"Diagnostic-Tools","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationImportance"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"abstract":[{"type":"text","text":"Measure true feature importance by evaluating loss degradation after shuffling feature columns."}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Permutation Feature Importance","type":"text"}]},{"type":"text","text":" measures how much a trained model’s error increases when a single feature column is randomly shuffled, breaking the relationship between that feature and the target outcome."}]},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Importance Metric:"}]},{"text":" ","type":"text"},{"code":"Importance(f_j) = Loss(X_shuffled(j), y) - Loss(X, y)","type":"codeVoice"}],"type":"paragraph"}]},{"anchor":"1-Computing-Permutation-Importance","type":"heading","text":"1. Computing Permutation Importance","level":2},{"code":["import SwiftExplain","import SwiftML","","let importance = try await PermutationImportance.compute(","    model: trainedModel,","    features: X_val,","    targets: y_val,","    metric: .meanSquaredError,","    nRepeats: 10",")","","for (idx, score) in importance.enumerated() {","    print(\"Feature \\(idx): Mean drop = \\(score.mean), Std = \\(score.std)\")","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftexplain\/permutationfeatureimportance"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"collectionGroup","title":"Permutation Feature Importance & Model Diagnostics","modules":[{"name":"SwiftExplain"}],"roleHeading":"AP