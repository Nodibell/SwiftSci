 & Weight Parsers.","type":"text"}],"role":"collection","title":"SwiftLLM","url":"\/documentation\/swiftllm","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","type":"topic"},"doc://SwiftLLM/documentation/SwiftLLM/GGUFParser":{"url":"\/documentation\/swiftllm\/ggufparser","role":"symbol","navigatorTitle":[{"text":"GGUFParser","kind":"identifier"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/GGUFParser","abstract":[{"type":"text","text":"Parser for the GGUF (GGML Unified Format) file format."},{"text":" ","type":"text"},{"text":"Decodes the metadata headers and maps the binary tensor blocks directly into MLXArrays.","type":"text"}],"type":"topic","title":"GGUFParser","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"GGUFParser","kind":"identifier"}]}}}