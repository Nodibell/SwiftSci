{"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"type":"codeVoice","code":"NaturalLanguage"},{"text":" framework.","type":"text"}],"metadata":{"role":"article","modules":[{"name":"SwiftNLP"}],"roleHeading":"Article","title":"Text Normalization, Tokenization & Linguistic Tagging"},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}],"type":"paragraph"},{"type":"heading","level":3,"text":"1. Multi-lingual Word & Sentence Tokenization","anchor":"1-Multi-lingual-Word--Sentence-Tokenization"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"]},{"text":"2. POS Tagging, Lemmatization & Entity Extraction","anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"]},{"text":"3. Sentiment Analysis (VADER & NLSentiment)","anchor":"3-Sentiment-Analysis-VADER--NLSentiment","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"]}]}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","generated":true,"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ChatAPI","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LlamaTokenizer"]}],"sections":[],"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"role":"collection","kind":"symbol","url":"\/documentation\/swiftnlp","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","title":"SwiftNLP","type":"topic"},"doc://SwiftNLP/documentation/SwiftNLP/LlamaTokenizer":{"kind":"article","role":"article","title":"Llama checkpoint tokenization","abstract":[{"type":"codeVoice","code":"BPETokenizer(llama3TokenizerJSON:)"},{"type":"text","text":" loads the byte-level BPE pipeline used by the pinned Llama 3.2 1B Instruct checkpo