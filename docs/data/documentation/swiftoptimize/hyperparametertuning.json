{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/HyperparameterTuning"},"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","generated":true,"identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection"]}],"abstract":[{"type":"text","text":"Automate model exploration and parameter optimization with "},{"type":"codeVoice","code":"GridSearchCV"},{"type":"text","text":", "},{"type":"codeVoice","code":"RandomizedSearchCV"},{"type":"text","text":", and the intelligent "},{"type":"codeVoice","code":"AutoML"},{"type":"text","text":" model selector."}],"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftoptimize\/hyperparametertuning"]}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Finding the optimal combination of hyperparameters is critical for maximizing generalization accuracy. ","type":"text"},{"code":"SwiftOptimize","type":"codeVoice"},{"text":" provides exhaustive grid search, randomized sampling for high-dimensional parameter spaces, and end-to-end ","type":"text"},{"code":"AutoML","type":"codeVoice"},{"text":" selection across multiple model families.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","text":"1. AutoML — Automated Model Selection","level":2,"anchor":"1-AutoML-Automated-Model-Selection"},{"type":"paragraph","inlineContent":[{"code":"AutoML","type":"codeVoice"},{"text":" cross-validates a fixed set of baseline architectures (Logistic\/Linear Regression, Decision Tree, Random Forest, MLP) and ranks them by the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"mean per-fold"}]},{"text":" score: macro F1 for classification, R² for regression. Classification uses ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/StratifiedKFold","type":"reference","isActive":true},{"text":"; regression uses shuffled ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/KFold","type":"reference","isActive":true},{"text":". All metrics come from ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/EvaluationHarness","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"codeListing","code":["import Foundation","import SwiftOptimize","import SwiftML","","\/\/ 1. Synthetic classification dataset","let N = 120","let D = 4","let X = (0..<N).map { i in","    (0..<D).map { d in Double(i * D + d) * 0.05 + sin(Double(i + d)) }","}","let y = (0..<N).map { i in Double(i % 2) }","","\/\/ 2. Configure AutoML with 3-fold stratified cross-validation","let autoML = AutoML(","    timeBudgetSeconds: 30,","    taskType: .classification,","    nFolds: 3,","    seed: 42",")","","\/\/ 3. Run model selection","let report = try await autoML.fit(features: X, targets: y)","","print(\"Best model: \\(await autoML.bestModelName ?? \"-\")\")","print(\"CV macro F1: \\(report.metrics[\"cv_score\"]!) ± \\(report.metrics[\"cv_std\"]!)\")","","for entry in await autoML.leaderboard {","    print(entry.displayName, entry.meanScore, entry.foldScores)","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Task type:"}],"type":"strong"},{"text":" ","type":"text"},{"code":".auto","type":"codeVoice"},{"text":" (default) classifies integer targets with ≤ 10 distinct values, treats non-integer or high-cardinality targets as regression, and throws ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLError\/ambiguousTaskType(uniqueValues:sampleCount:)","type":"reference","isActive":true},{"text":" in between. Pass ","type":"text"},{"code":"taskType","type":"codeVoice"},{"text":" explicitly in that case.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Time budget:"}],"type":"strong"},{"text":" soft. It is checked before each candidate and fold; a running fit is not interrupted, and the first candidate always completes.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Search:"}],"type":"strong"},{"text":" only ","type":"text"},{"code":".modelSelection","type":"codeVoice"},{"text":" is available. To tune hyperparameters of a single estimator, use ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/GridSearchCV","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/RandomizedSearchCV","type":"reference","isActive":true},{"text":" below.","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"type":"heading","text":"2. Exhaustive Grid Search (`GridSearchCV`)","level":2,"anchor":"2-Exhaustive-Grid-Search-GridSearchCV"},{"type":"paragraph","inlineContent":[{"code":"GridSearchCV","type":"codeVoice"},{"text":" exhaustively tests all Cartesian combinations of hyperparameter discrete values.","type":"text"}]},{"type":"codeListing","code":["import SwiftOptimize","import SwiftML","","\/\/ Define hyperparameter search grid for DecisionTreeClassifier","let paramGrid: [String: [Any]] = [","    \"maxDepth\": [3, 5, 8],","    \"minSamplesSplit\": [2, 5, 10],","    \"criterion\": [\"gini\", \"entropy\"]","]","","let gridSearch = GridSearchCV(","    estimator: DecisionTreeClassifier(maxDepth: 3),","    paramGrid: paramGrid,","    cv: 5,","    scoring: .accuracy",")","","try await gridSearch.fit(features: X, targets: y)","","if let bestParams = gridSearch.bestParams {","    print(\"Optimal Depth: \\(bestParams[\"maxDepth\"] ?? \"default\")\")","    print(\"Peak CV Accuracy: \\(String(format: \"%.4f\", gridSearch.bestScore ?? 0.0))\")","}"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","text":"3. Randomized Search (`RandomizedSearchCV`)","level":2,"anchor":"3-Randomized-Search-RandomizedSearchCV"},{"type":"paragraph","inlineContent":[{"text":"When searching through large continuous or discrete combinatorial spaces, ","type":"text"},{"code":"RandomizedSearchCV","type":"codeVoice"},{"text":" samples $N$ random configurations, finding near-optimal solutions in a fraction of the compute time.","type":"text"}]},{"type":"codeListing","code":["import SwiftOptimize","import SwiftML","","let distributions: [String: [Any]] = [","    \"learningRate\": [0.001, 0.005, 0.01, 0.05, 0.1],","    \"epochs\": [100, 200, 500, 1000],","    \"l2Penalty\": [0.0, 0.0001, 0.001, 0.01]","]","","let randomSearch = RandomizedSearchCV(","    estimator: LogisticRegression(learningRate: 0.01),","    paramDistributions: distributions,","    nIter: 20,","    cv: 3,","    randomSeed: 42",")","","try await randomSearch.fit(features: X, targets: y)","print(\"Top Configuration Score: \\(randomSearch.bestScore ?? 0.0)\")"],"syntax":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftOptimize"}],"role":"article","title":"Hyperparameter Tuning & AutoML Engine"},"references":{"doc://SwiftOptimize/documentation/SwiftOptimize/EvaluationHarness":{"type":"topic","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/EvaluationHarness","navigatorTitle":[{"kind":"identifier","text":"EvaluationHarness"}],"abstract":[{"text":"Unified Classifier & Regressor Evaluation Metrics Harness (G-019).","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EvaluationHarness"}],"title":"EvaluationHarness","url":"\/documentation\/swiftoptimize\/e