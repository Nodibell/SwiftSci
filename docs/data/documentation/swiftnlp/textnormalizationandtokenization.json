{"kind":"article","metadata":{"title":"Text Normalization, Tokenization & Linguistic Tagging","modules":[{"name":"SwiftNLP"}],"role":"article","roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"code":"NaturalLanguage","type":"codeVoice"},{"type":"text","text":" framework."}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ChatAPI","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LlamaTokenizer"],"generated":true,"title":"Guides & Tutorials"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies.","type":"text"}],"type":"paragraph"},{"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","text":"1. Multi-lingual Word & Sentence Tokenization","level":3,"type":"heading"},{"code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"syntax":"swift","type":"codeListing"},{"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","text":"2. POS Tagging, Lemmatization & Entity Extraction","level":3,"type":"heading"},{"code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"syntax":"swift","type":"codeListing"},{"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","text":"3. Sentiment Analysis (VADER & NLSentiment)","level":3,"type":"heading"},{"code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"role":"article","title":"Text Feature Vectorization, Sparse TF-IDF & Local Embeddings","kind":"article","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","url":"\/documentation\/swiftnlp\/vectorizationandembeddings","abstract":[{"text":"Convert text corpora into numerical and sparse feature matrices using ","type":"text"},{"type":"codeVoice","code":"TFIDFVectorizer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"CountVectorizer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"HashingVectorizer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SparseVector"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"text":".","type":"text"}]},"doc://SwiftNLP/documentation/SwiftNLP/LlamaTokenizer":{"role":"article","type":"topic","url":"\/documentation\/swiftnlp\/llamatokenizer","kind":"article","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LlamaTokenizer","title":"Llama checkpoint tokenization","abstract":[{"code":"BPETokenizer(llama3TokenizerJSON:)","type":"codeVoice"},{"type":"text","text":" loads the byte-level BPE pipeline used by the pinned Llama 3.2 1B Instruct checkpoint."}]},"doc://SwiftNLP/documentation/SwiftNLP":{"type":"topic","title":"SwiftNLP","url":"\/documentation\/swiftnlp","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","kind":"symbol","role":"collection"},"doc://SwiftNLP/documentation/SwiftNLP/ChatAPI":{"role":"collectionGroup","title":"Chat Templates & Multi-Turn Conversations","abstract":[{"text":"Format structured multi-turn dialogue into model-specific prompts for Llama-3, ChatML, and Mistral architectures.","type":"text"}],"type":"topic","url":"\/documentation\/swiftnlp\/chatapi","kind":"article","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ChatAPI"}}}