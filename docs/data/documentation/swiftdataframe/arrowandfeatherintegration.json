{"variants":[{"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftDataFrame","type":"codeVoice"},{"type":"text","text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties."}]},{"text":"1. Arrow Memory Layout & Bitmaps","type":"heading","level":2,"anchor":"1-Arrow-Memory-Layout--Bitmaps"},{"inlineContent":[{"text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:","type":"text"}],"type":"paragraph"},{"code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"],"syntax":null,"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Validity Bitmaps","type":"text"}]},{"text":": Each bit represents the presence (1) or absence (0) of a value at that index.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"SIMD Null Filtering","type":"text"}]},{"text":": Vectorized operations skip null evaluations using SIMD bitmasks (","type":"text"},{"type":"codeVoice","code":"vDSP_vcmprsD"},{"text":"), allowing full CPU register utilization.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"2. Feather File Format (Arrow IPC)","anchor":"2-Feather-File-Format-Arrow-IPC"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:"}]},{"code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"3. Lazy Feather Streaming","anchor":"3-Lazy-Feather-Streaming"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For large datasets, SwiftDataFrame supports streaming chunked reads:"}]},{"code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"metadata":{"title":"Apache Arrow & Feather Zero-Copy Integration","role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftDataFrame"}]},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"abstract":[{"text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization.","type":"text"}],"topicSections":[{"title":"Arrow Classes & Readers","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"],"anchor":"Arrow-Classes--Readers"}],"kind":"article","references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"type":"topic","url":"\/documentation\/swiftdataframe\/featherreader","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","navigatorTitle":[{"kind":"identifier","text":"FeatherReader"}],"title":"FeatherReader","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherReader"}],"abstract":[{"type":"text","text":"Reader for Feather \/ Apache Arrow IPC binary file format."}],"kind":"symbol"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"TypedColumn","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A strongly-typed column backed by a contiguous Swift array."},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" elements represent null \/ missing values.","type":"text"}],"navigatorTitle":[{"text":"TypedColumn","kind":"identifier"}],"title":"TypedColumn","url":"\/documentation\/swiftdataframe\/typedcolumn","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"type":"topic","title":"SwiftDataFrame","url":"\/documentation\/swiftdataframe","kind":"symbol","role":"collection","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"type":"topic","abstract":[{"type":"text","text":"Writer for Feather \/ Apache Arrow IPC binary file format."}],"title":"FeatherWriter","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherWriter"}],"url":"\/documentation\/swiftdataframe\/featherwriter","navigatorTitle":[{"kind":"identifier","text":"FeatherWriter"}],"kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","role":"symbol"}}}