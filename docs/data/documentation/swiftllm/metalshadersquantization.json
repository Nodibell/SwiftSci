{"topicSections":[{"anchor":"Quantization--Metal-Execution","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedTensor","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedLayoutMetadata","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedLinear","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizationScheme","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalQuantizedEngine","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalQuantizedError"],"title":"Quantization & Metal Execution"}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling"],"title":"Guides & Tutorials","generated":true}],"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/swiftllm\/metalshadersquantization"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU.","type":"text"}],"metadata":{"role":"collectionGroup","title":"Native Metal MSL Shaders for Quantized LLMs","modules":[{"name":"SwiftLLM"}],"roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Large language models like Llama 3, Mistral, and DeepSeek require massive memory bandwidth. Weight-only quantization (such as GGUF Q4_0 and Q8_0) compresses 16-bit floating-point weights into 4-bit or 8-bit integer blocks with group scaling factors, reducing memory footprint by 50% to 75%."}]},{"inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"type":"text","text":" implements native Metal Shading Language (MSL) SIMD kernels executing hardware dequantization and GEMV \/ GEMM transformations directly on Apple Silicon GPUs without intermediate CPU memory allocations."}],"type":"paragraph"},{"text":"Architecture","anchor":"Architecture","level":2,"type":"heading"},{"type":"codeListing","code":["Packed Quantized Weights [Q4_0 \/ Q8_0]   Scale Factors [FP16]   Input Activations [FP32]","                 │                               │                        │","                 └───────────────────────┬───────┴────────────────────────┘","                                         ▼","                   Metal Compute Command Encoder","                                         │","                 ┌───────────────────────┴───────────────────────┐","                 ▼                                               ▼","     MSL Kernel: gemv_q4_0                           MSL Kernel: gemv_q8_0","   - Unpack 4-bit nibbles (w - 8)                  - Load signed 8-bit integers","   - Multiply by group FP16 scale                  - Multiply by group FP16 scale","   - Accumulate with input vector                  - Accumulate with input vector","                 │                                               │","                 └───────────────────────┬───────────────────────┘","                                         ▼","                            Output Activation Vector","                               (Unified Memory)"],"syntax":null},{"anchor":"SIMD-Group-Matrix-Multiplication","level":2,"type":"heading","text":"SIMD-Group Matrix Multiplication"},{"type":"paragraph","inlineContent":[{"text":"On Apple Silicon (M-series GPUs), threads within a 32-thread SIMD-group collaborate on 8x8 matrix tiles using ","type":"text"},{"code":"metal_simdgroup_matrix","type":"codeVoice"},{"text":". This eliminates thread divergence and ensures maximal utilization of the GPU arithmetic units:","type":"text"}]},{"type":"codeListing","code":["#include <metal_stdlib>","#include <metal_simdgroup_matrix>","","using namespace metal;","","kernel void gemm_simdgroup_q4_0(","    device const half* A               [[buffer(0)]],","    device const half* B               [[buffer(1)]],","    device half* C                     [[buffer(2)]],","    constant uint& M                   [[buffer(3)]],","    constant uint& N                   [[buffer(4)]],","    constant uint& K                   [[buffer(5)]],","    uint2 threadgroup_position_in_grid [[threadgroup_position_in_grid]],","    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]]",") {","    simdgroup_matrix<half, 8, 8> acc;","    acc = make_filled_simdgroup_matrix<half, 8, 8>(0.0h);","    \/\/ Accumulate across inner K dimension...","}"],"syntax":"metal"},{"anchor":"Swift-API-Integration-From-QuantizedTensor-to-Metal-GEMV","level":2,"type":"heading","text":"Swift API Integration: From QuantizedTensor to Metal GEMV"},{"type":"paragraph","inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"text":" unifies parsed weight storage and GPU execution through a zero-copy pipeline:","type":"text"}]},{"inlineContent":[{"type":"text","text":"$$\\text{GGUF File} \\xrightarrow{\\text{GGUFParser}} \\text{QuantizedTensor} \\xrightarrow{\\text{extractSeparatedBuffers}} \\text{QuantizedLinear.forwardMetal} \\xrightarrow{\\text{MSL SIMD}} \\text{Output Activation}$$"}],"type":"paragraph"},{"text":"1. Extracting Separated Buffers from QuantizedTensor","anchor":"1-Extracting-Separated-Buffers-from-QuantizedTensor","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"QuantizedTensor"},{"type":"text","text":" preserves the raw binary layout (e.g. 18-byte Q4_0 blocks) with "},{"code":"QuantizedLayoutMetadata","type":"codeVoice"},{"type":"text","text":", allowing separation of packed weights and scale factors:"}],"type":"paragraph"},{"code":["import Foundation","import SwiftLLM","","\/\/ 1. Load tensor from parsed GGUF dictionary","guard let tensor = parsedWeights[\"blk.0.attn_q.weight\"],","      let buffers = tensor.extractSeparatedBuffers() else {","    fatalError(\"Failed to extract quantized buffers\")","}","","let packedWeights: Data = buffers.weights","let packedScales: Data = buffers.scales"],"syntax":"swift","type":"codeListing"},{"text":"2. Direct Metal Kernel Execution via QuantizedLinear","anchor":"2-Direct-Metal-Kernel-Execution-via-QuantizedLinear","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"code":"QuantizedLinear","type":"codeVoice"},{"text":" encapsulates both MLX-accelerated layer evaluations and native Metal MSL shader execution (","type":"text"},{"code":"gemv_q4_0","type":"codeVoice"},{"text":", ","type":"text"},{"code":"gemv_q8_0","type":"codeVoice"},{"type":"text","text":"):"}]},{"code":["\/\/ 2. Initialize layer geometry and scheme","let linear = QuantizedLinear(","    inFeatures: 4096,","    outFeatures: 4096,","    scheme: .q4_0,","    weight: tensor.dequantizeToFloat(), \/\/ MLXArray fallback\/graph evaluation","    scales: MLXArray(0.0)",")","","\/\/ 3. Direct Metal GEMV execution without CPU round-trips or allocations","let outputActivations: [Float] = try linear.forwardMetal(","    inVector: inputActivations,","    rawWeights: packedWeights,","    rawScalesData: packedScales",")"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"forwardMetal","type":"codeVoice"},{"type":"text","text":" runs packed Q4_0\/Q8_0 Metal MSL kernels directly on packed bytes. Invoking "},{"code":"QuantizedLinear","type":"codeVoice"},{"type":"text","text":" via "},{"type":"codeVoice","code":"callAsFunction"},{"type":"text","text":" or "},{"type":"codeVoice","code":"TransformerDecoder.loadWeights(_: [String: QuantizedTensor])"},{"type":"text","text":" executes the Float32 "},{"type":"codeVoice","code":"MLXArray"},{"type":"text","text":" dequantized fallback; full-model packed 4-bit\/8-bit execution in "},{"type":"codeVoice","code":"TransformerDecoder"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"loadWeights(_: [String: MLXArray])"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"loadQuantizedWeights(_:)"},{"type":"text","text":" backed by "},{"code":"MLXNN.QuantizedLinear","type":"codeVoice"},{"type":"text","text":"."}]}],"type":"aside"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization","interfaceLanguage":"swift"},"references":{"doc://SwiftLLM/documentation/SwiftLLM/QuantizedLayoutMetadata":{"type":"topic","abstract":[{"text":"Scheme-specific layout metadata for quantized tensors.","type":"text"}],"url":"\/documentation\/swiftllm\/quantizedlayoutmetadata","title":"QuantizedLayoutMetadata","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedLayoutMetadata","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"QuantizedLayoutMetadata","kind":"identifier"}],"navigatorTitle":[{"text":"QuantizedLayoutMetadata","kind":"identifier"}]},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoderArchitecture":{"title":"Transformer Architecture & LLM Inference Guide","abstract":[{"text":"High-throughput, on-device causal language model execution on Apple Silicon Unified Memory Architecture using ","type":"text"},{"type":"codeVoice","code":"TransformerDecoder"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PagedKVCache"},{"text":", ","type":"text"},{"type":"codeVoice","code":"GGUFParser"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SafeTensorsParser"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","url":"\/documentation\/swiftllm\/transformerdecoderarchitecture","type":"topic","kind":"article","role":"article"},"doc://SwiftLLM/documentation/SwiftLLM/QuantizedLinear":{"abstr