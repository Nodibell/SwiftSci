{"kind":"article","abstract":[{"text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftnlp\/denselocalembeddings"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"],"title":"Embedding APIs","anchor":"Embedding-APIs"}],"sections":[],"metadata":{"modules":[{"name":"SwiftNLP"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Dense Local Text Embeddings with Accelerate"},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Modern Retrieval-Augmented Generation (RAG) and semantic search systems require dense vector representations of text. Traditional approaches depend on remote APIs (e.g. OpenAI) or large multi-gigabyte models that exhaust memory. ","type":"text"},{"type":"codeVoice","code":"SwiftNLP"},{"text":" introduces ","type":"text"},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"text":", a subword N-gram character hashing projection engine that produces deterministic, unit-normalized dense embeddings in sub-millisecond execution times.","type":"text"}],"type":"paragraph"},{"text":"1. Algorithmic Foundation","level":2,"anchor":"1-Algorithmic-Foundation","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"text":" operates through a three-stage mathematical pipeline:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Subword N-gram Hashing"}]},{"type":"text","text":": Text is tokenized into word and character n-grams (sizes 3 to 6). Each n-gram is hashed into a fixed integer space using FNV-1a hash functions."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Dimension Projection","type":"text"}],"type":"strong"},{"type":"text","text":": Hashes are projected onto a "},{"code":"D","type":"codeVoice"},{"type":"text","text":"-dimensional vector space (e.g., "},{"code":"D = 128","type":"codeVoice"},{"type":"text","text":" or "},{"code":"D = 256","type":"codeVoice"},{"type":"text","text":") with deterministic sign flips to prevent feature collision bias."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Unit L2 Normalization","type":"text"}],"type":"strong"},{"type":"text","text":": The resulting dense vector is projected onto the unit hypersphere:"}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"v_norm = v \/ ||v||_2 = v \/ sqrt(Σ v_i²)","type":"codeVoice"}],"type":"paragraph"}],"name":"Note"}]}]},{"inlineContent":[{"text":"Because all embeddings have ","type":"text"},{"type":"codeVoice","code":"||v||_2 = 1.0"},{"text":", the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Cosine Similarity"}]},{"text":" between two embeddings is equivalent to their direct ","type":"text"},{"inlineContent":[{"text":"Dot Product","type":"text"}],"type":"strong"},{"type":"text","text":", allowing single-instruction vector evaluation via Apple Accelerate "},{"code":"vDSP_dotprD","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"CosineSimilarity(u, v) = u · v","type":"codeVoice"}],"type":"paragraph"}]},{"text":"2. Generating Embeddings","level":2,"anchor":"2-Generating-Embeddings","type":"heading"},{"syntax":"swift","type":"codeListing","code":["import SwiftNLP","","\/\/ Initialize a 128-dimensional local embedding engine","let engine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Generate embedding for a single text snippet","let vector = engine.embed(\"Apple Silicon M3 Max neural network processing\")","print(\"Vector dimension: \\(vector.count)\") \/\/ 128","","\/\/ Batch embedding generation","let documents = [","    \"High-performance computing on macOS\",","    \"Relational database wire protocol drivers\",","    \"Deep convolutional neural networks for vision\"","]","let batchEmbeddings = engine.embedBatch(documents)"]},{"text":"3. Integration with SwiftCluster.VectorStore","level":2,"anchor":"3-Integration-with-SwiftClusterVectorStore","type":"heading"},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","let store = VectorStore(metric: .cosineSimilarity)","","for (idx, doc) in documents.enumerated() {","    let vec = engine.embed(doc)","    store.add(id: \"doc_\\(idx)\", vector: vec, metadata: [\"text\": doc])","}","","\/\/ Perform instant semantic similarity search","let query = engine.embed(\"Mac hardware acceleration\")","let topHits = store.search(query: query, topK: 1)","print(\"Top match: \\(topHits.first?.metadata[\"text\"] ?? \"\")\")"]}]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"type":"topic","kind":"symbol","title":"SwiftNLP","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"role":"collection","url":"\/documentation\/swiftnlp","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP"},"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"abstract":[{"text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LocalEmbeddingEngine","kind":"identifier"}],"navigatorTitle":[{"text":"LocalEmbeddingEngine","kind":"identifier"}],"url":"\/documentation\/swiftnlp\/localembeddingengine","kind":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","title":"LocalEmbeddingEngine"}}}