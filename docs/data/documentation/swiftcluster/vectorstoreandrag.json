{"sections":[],"kind":"article","identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate."}],"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"],"generated":true,"anchor":"Guides--Tutorials"}],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vector databases are essential for modern semantic search, AI agent memory, and Retrieval-Augmented Generation (RAG). "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"VectorStore"},{"type":"text","text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations ("},{"type":"codeVoice","code":"vDSP_dotprD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_svesqD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_distancesqD"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For datasets up to 100,000 vectors, in-memory linear scans accelerated by Apple Silicon unified memory and NEON SIMD registers deliver sub-millisecond retrieval without the complexity, disk overhead, or C++ dependencies of external databases like Chroma or FAISS."}]},{"syntax":"mermaid","type":"codeListing","code":["graph LR","    Doc[Document \/ Text Chunk] --> Embed[SentenceEmbeddingProvider]","    Embed --> Vec[Dense Vector R^D]","    Vec --> Store[VectorStore In-Memory Index]","    Query[User Query] --> EmbedQuery[SentenceEmbeddingProvider]","    EmbedQuery --> QVec[Query Vector]","    QVec --> Search[Accelerate SIMD Top-K Search]","    Store --> Search","    Search --> Hits[Top-K Ranked Results + Metadata]"]},{"type":"thematicBreak"},{"type":"heading","anchor":"1-Supported-Distance--Similarity-Metrics","level":2,"text":"1. Supported Distance & Similarity Metrics"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VectorStore"},{"type":"text","text":" supports three fundamental metric spaces via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"},{"type":"text","text":":"}]},{"header":"row","type":"table","alignments":["left","left","center","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Metric","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enum Case"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Range"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ideal Use Case"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Cosine Similarity","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".cosineSimilarity"}]}],[{"type":"paragraph","inlineContent":[{"code":"[-1.0, 1.0]","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Normalized or unnormalized text embeddings. Evaluates semantic angular closeness regardless of vector magnitude."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Dot Product","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"code":".dotProduct","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"(-inf, inf)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Pre-normalized unit vectors ($|v|_2 = 1.0$), maximizing execution speed via direct single-pass multiply-accumulate.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Euclidean Distance"}]}]}],[{"type":"paragraph","inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"[0.0, inf)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Spatial clustering, image feature prints, physical embeddings. Lower values indicate closer proximity.","type":"text"}]}]]]},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","\/\/ Initialize with cosine similarity (default)","let store = VectorStore(metric: .cosineSimilarity)"]},{"type":"thematicBreak"},{"type":"heading","anchor":"2-Ingesting-Vectors--Metadata","level":2,"text":"2. Ingesting Vectors & Metadata"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each item in the index is encapsulated in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorEntry"},{"type":"text","text":", storing a unique identifier, the dense numerical vector, and arbitrary string key-value metadata (such as document titles, URLs, timestamps, or raw text content)."}]},{"type":"heading","anchor":"Single-Entry-Ingestion","level":3,"text":"Single Entry Ingestion"},{"syntax":"swift","type":"codeListing","code":["store.add(","    id: \"doc_101\",","    vector: [0.12, 0.85, -0.44, 0.31],","    metadata: [","        \"title\": \"Apple Silicon Architecture\",","        \"author\": \"Engineering Team\",","        \"category\": \"hardware\"","    ]",")"]},{"type":"heading","anchor":"High-Throughput-Batch-Ingestion","level":3,"text":"High-Throughput Batch Ingestion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When ingesting thousands of document chunks, use "},{"type":"codeVoice","code":"addBatch(entries:)"},{"type":"text","text":" to minimize locking overhead:"}]},{"syntax":"swift","type":"codeListing","code":["let entries = chunks.enumerated().map { idx, chunk in","    VectorEntry(","        id: \"chunk_\\(idx)\",","        vector: embeddings[idx],","        metadata: [\"text\": chunk.text, \"doc_id\": chunk.documentId]","    )","}","","store.addBatch(entries: entries)","print(\"Indexed \\(store.count) vectors into VectorStore.\")"]},{"type":"thematicBreak"},{"type":"heading","anchor":"3-Top-K-Semantic-Similarity-Search","level":2,"text":"3. Top-K Semantic Similarity Search"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"search(query:topK:)"},{"type":"text","text":" to retrieve the most relevant vectors. The search uses a bounded collection pattern that avoids sorting the entire dataset, maintaining peak performance even as the collection grows."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Query with a high-dimensional vector","let queryVector: [Double] = [0.10, 0.82, -0.40, 0.29]","","\/\/ Retrieve Top-3 nearest neighbors","let results: [VectorSearchResult] = store.search(query: queryVector, topK: 3)","","for match in results {","    print(\"Match ID: \\(match.id)\")","    print(\"Similarity Score: \\(String(format: \"%.4f\", match.score))\")","    print(\"Document Title: \\(match.metadata[\"title\"] ?? \"Unknown\")\")","    print(\"---\")","}"]},{"type":"heading","anchor":"Relevance-Threshold-Filtering","level":3,"text":"Relevance Threshold Filtering"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In production RAG workflows, avoid hallucination by filtering out retrieved items that fall below a minimum semantic similarity threshold:"}]},{"syntax":"swift","type":"codeListing","code":["let minimumRelevanceThreshold = 0.70","let relevantHits = results.filter { $0.score >= minimumRelevanceThreshold }","","guard !relevantHits.isEmpty else {","    print(\"No relevant context found above threshold.\")","    return","}"]},{"type":"thematicBreak"},{"type":"heading","anchor":"4-Index-Lifecycle--Thread-Safety","level":2,"text":"4. Index Lifecycle & Thread Safety"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VectorStore"},{"type":"text","text":" is thread-safe ("},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":") and guarded by internal "},{"type":"codeVoice","code":"NSLock"},{"type":"text","text":" synchronization, making it safe to query and update concurrently across Swift "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" groups and actors."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Check existence","let exists = store.contains(id: \"doc_101\")","","\/\/ Retrieve raw vector entry","if let entry = store.get(id: \"doc_101\") {","    print(\"Retrieved dimension: \\(entry.vector.count)\")","}","","\/\/ Remove obsolete documents","let wasRemoved = store.remove(id: \"doc_101\")","","\/\/ Purge index","store.clear()"]},{"type":"thematicBreak"},{"type":"heading","anchor":"5-Scaling-to-Large-Collections-with-HNSW","level":2,"text":"5. Scaling to Large Collections with HNSW"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When vector collections grow beyond 100,000 items, linear scans ($O(N)$) may exceed interactive latency budgets. "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex"},{"type":"text","text":" (Hierarchical Navigable Small World), an approximate nearest neighbor graph offering $O(\\log N)$ search latency."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Initialize an HNSW graph index","let hnsw = HNSWIndex(","    metric: .cosineSimilarity,","    M: 16,               \/\/ Number of bi-directional links per node","    efConstruction: 200, \/\/ Search depth during index construction","    efSearch: 50         \/\/ Search depth during query time",")","","\/\/ Ingest into HNSW graph","for entry in entries {","    await hnsw.add(id: entry.id, vector: entry.vector, metadata: entry.metadata)","}","","\/\/ Sub-millisecond ANN search across 500,000 vectors","let annResults = await hnsw.search(query: queryVector, topK: 5)"]},{"type":"thematicBreak"},{"type":"heading","anchor":"6-Persistence--Serialization","level":2,"text":"6. Persistence & Serialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorEntry"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult"},{"type":"text","text":" conform to "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", an entire vector store can be saved to disk as compressed JSON or binary Property List, and restored at application launch:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Export vector store entries to JSON Data","func exportStore(store: VectorStore) throws -> Data {","    \/\/ Collect all entries (or maintain a list during ingestion)","    let encoder = JSONEncoder()","    return try encoder.encode(entries)","}","","\/\/ Restore store from disk","func importStore(from data: Data) throws -> VectorStore {","    let decoder = JSONDecoder()","    let loadedEntries = try decoder.decode([VectorEntry].self, from: data)","    let store = VectorStore(metric: .cosineSimilarity)","    store.addBatch(entries: loadedEntries)","    return store","}"]},{"type":"thematicBreak"},{"type":"heading","anchor":"7-Complete-On-Device-Semantic-Search-Example","level":2,"text":"7. Complete On-Device Semantic Search Example"},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","import SwiftNLP","","\/\/ 1. Initialize sentence embedding provider and vector store","let embeddingEngine = try AppleSentenceEmbeddingEngine(language: .english)","let vectorStore = VectorStore(metric: .cosineSimilarity)","","\/\/ 2. Sample documents to index","let corpus = [","    \"SwiftSci utilizes Apple Accelerate SIMD kernels for linear algebra.\",","    \"MLX provides unified memory GPU tensor computation on macOS.\",","    \"Autoregressive LLM decoders leverage KV-caches to optimize throughput.\",","    \"Pandas-like DataFrame operations in Swift support typed column queries.\"","]","","\/\/ 3. Vectorize and ingest corpus","for (idx, text) in corpus.enumerated() {","    let vector = try embeddingEngine.embed(text)","    vectorStore.add(","        id: \"doc_\\(idx)\",","        vector: vector,","        metadata: [\"content\": text]","    )","}","","\/\/ 4. Query vector store","let query = \"How does SwiftSci accelerate vector operations?\"","let queryVector = try embeddingEngine.embed(query)","let topMatches = vectorStore.search(query: queryVector, topK: 1)","","if let bestMatch = topMatches.first {","    print(\"Top match (Score: \\(bestMatch.score)):\")","    print(bestMatch.metadata[\"content\"] ?? \"\")","}"]},{"type":"thematicBreak"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcluster\/vectorstoreandrag"]}],"topicSections":[{"title":"Vector Store Types","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorEntry","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex"],"anchor":"Vector-Store-Types"}],"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftCluster"}],"role":"collectionGroup","title":"In-Memory VectorStore & On-Device RAG"},"references":{"doc://SwiftCluster/documentation/SwiftCluster/HNSWIndex":{"role":"symbol","abstract":[{"type":"text","text":"A hierarchical navigable small world graph index for sub-millisecond approximate nearest neighbor search."}],"title":"HNSWIndex","kind":"symbol","navigatorTitle":[{"text":"HNSWIndex","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HNSWIndex","kind":"identifier"}],"url":"\/documentation\/swiftcluster\/hnswindex","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex","type":"topic"},"doc://SwiftCluster/documentation/SwiftCluster/HNSWVectorSearch":{"abstract":[{"type":"text","text":"Scale approximate nearest neighbor (ANN) retrieval using Hierarchical Navigable Small World graphs with empirical logarithmic query scaling under navigable graph structure."}],"kind":"article","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch","role":"collectionGroup","url":"\/documentation\/swiftcluster\/hnswvectorsearch","title":"High-Dimensional Vector Search with HNSW"},"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"abstract":[{"type":"text","text":"Reduce high-dimensional feature spaces, uncover latent structures, and visualize complex datasets using PCA, Randomized SVD, and t-SNE."}],"kind":"article","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","type":"topic","role":"collectionGroup","url":"\/documentation\/swiftcluster\/dimensionalityreduction","title":"Dimensionality Reduction & Manifold Learning"},"doc://SwiftCluster/documentation/SwiftCluster/VectorSearchResult":{"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","abstract":[{"type":"text","text":"Represents a single nearest-neighbor match result from a vector search query."}],"type":"topic","kind":"symbol","role":"symbol","title":"VectorSearchResult","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"VectorSearchResult"}],"navigatorTitle":[{"text":"VectorSearchResult","kind":"identifier"}],"url":"\/documentation\/swiftcluster\/v