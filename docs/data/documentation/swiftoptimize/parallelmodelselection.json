{"sections":[],"topicSections":[{"title":"Optimization & Search","anchor":"Optimization--Search","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoML","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLStrategy","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationResult"]}],"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"metadata":{"roleHeading":"API Collection","title":"Concurrent Model Selection & Cross-Validation","modules":[{"name":"SwiftOptimize"}],"role":"collectionGroup"},"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/HyperparameterTuning"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftoptimize\/parallelmodelselection"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","identifier":{"url":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency "},{"type":"codeVoice","code":"TaskGroup"},{"type":"text","text":" primitives."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Cross-validation and multi-class classification workflows are embarrassingly parallel: each fold split and one-vs-rest binary sub-problem operates on independent slices of tabular data."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"SwiftOptimize"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SwiftML"},{"type":"text","text":" leverage structured Swift Concurrency ("},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"type":"text","text":") to dispatch multiple fold and class estimators concurrently."}],"type":"paragraph"},{"text":"Structured Concurrency Pipeline","level":2,"type":"heading","anchor":"Structured-Concurrency-Pipeline"},{"syntax":null,"type":"codeListing","code":["           Input Dataset [Features, Targets]","                          │","       ┌──────────────────┴──────────────────┐","       ▼                                     ▼"," Fold 1 Split (Task 1)                 Fold 2 Split (Task 2)","   ├─ Fit Candidate                      ├─ Fit Candidate","   └─ Compute Metric                     └─ Compute Metric","       │                                     │","       └──────────────────┬──────────────────┘","                          ▼","            withThrowingTaskGroup Aggregator","                          ▼","         Cross-Validation Average Leaderboard"]},{"text":"Cooperative Cancellation & Bounded Budgets","level":3,"type":"heading","anchor":"Cooperative-Cancellation--Bounded-Budgets"},{"inlineContent":[{"type":"text","text":"When training under a time budget (such as "},{"code":"AutoML(timeBudgetSeconds:)","type":"codeVoice"},{"type":"text","text":"), tasks run inside a managed scope. If the time budget expires or a fatal error occurs in a critical pipeline step, child tasks cooperatively respect task cancellation without leaking threads or memory."}],"type":"paragraph"},{"text":"Deterministic Class Ordering","anchor":"Deterministic-Class-Ordering","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"OneVsRestClassifier","type":"codeVoice"},{"text":", binary classification estimators are dispatched concurrently to maximize throughput across cores. Results are tagged with their class index ","type":"text"},{"code":"(c, est)","type":"codeVoice"},{"text":" and sorted prior to storage, ensuring 100% deterministic prediction ordering across runs.","type":"text"}]},{"text":"Example Usage","type":"heading","level":2,"anchor":"Example-Usage"},{"code":["import SwiftOptimize","import SwiftML","","\/\/ 1. Concurrent AutoML search across DecisionTree, RandomForest, and MLP","let automl = AutoML(timeBudgetSeconds: 30.0)","let report = try await automl.fit(features: X, targets: y)","print(\"Winning Model: \\(report.bestModel)\")","","\/\/ 2. Parallel One-Vs-Rest classification","let ovr = OneVsRestClassifier(numClasses: 5)","try await ovr.fit(features: X, targets: y)","let predictions = try await ovr.predict(features: X_test)"],"syntax":"swift","type":"codeListing"}]}],"references":{"doc://SwiftOptimize/documentation/SwiftOptimize/AutoMLStrategy":{"url":"\/documentation\/swiftoptimize\/automlstrategy","abstract":[{"type":"text","text":"AutoML hyperparameter optimization strategy."}],"role":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLStrategy","title":"AutoMLStrategy","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoMLStrategy"}],"navigatorTitle":[{"kind":"identifier","text":"AutoMLStrategy"}]},"doc://SwiftOptimize/documentation/SwiftOptimize":{"role":"collection","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize","title":"SwiftOptimize","type":"topic","abstract":[{"text":"AutoML, Cross-Validation Folds & Hyperparameter Tuning.","type":"text"}],"url":"\/documentation\/swiftoptimize","kind":"symbol"},"doc://SwiftOptimize/documentation/SwiftOptimize/CrossValidationResult":{"url":"\/documentation\/swiftoptimize\/crossvalidationresult","type":"topic","navigatorTitle":[{"text":"CrossValidationResult","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationResult","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CrossValidationResult","kind":"identifier"}],"title":"CrossValidationResult","role":"symbol","abstract":[{"text":"Represents cross validation result.","type":"text"}