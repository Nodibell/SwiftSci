text":"SwiftSci implements standard lexical similarity algorithms:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Path Similarity"}]},{"type":"text","text":": Shortest path distance in the hypernym taxonomy:"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"$$\\text{Sim}_{\\text{path}}(s_1, s_2) = \\frac{1}{1 + \\text{distance}(s_1, s_2)}$$","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wu-Palmer Similarity (WUP)"}]},{"type":"text","text":": Measures depth of least common subsumer (LCS) relative to synset depths:"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"$$\\text{Sim}_{\\text{wup}}(s_1, s_2) = \\frac{2 \\cdot \\text{depth}(\\text{LCS})}{\\text{depth}(s_1) + \\text{depth}(s_2)}$$","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let dog = wordnet.synset(\"dog.n.01\")!","let cat = wordnet.synset(\"cat.n.01\")!","","let pathSim = wordnet.pathSimilarity(dog, cat)","let wupSim = wordnet.wuPalmerSimilarity(dog, cat)","","print(\"Path Similarity: \\(pathSim), Wu-Palmer: \\(wupSim)\")"]}]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/POS":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS","type":"topic","navigatorTitle":[{"kind":"identifier","text":"POS"}],"abstract":[{"type":"text","text":"Part of Speech categories in WordNet."}],"role":"symbol","title":"POS","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"POS"}],"url":"\/documentation\/swiftnlp\/pos","kind":"symbol"},"doc://SwiftNLP/documentation/SwiftNLP":{"abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","role":"collection","kind":"symbol","url":"\/documentati