{"sections":[],"identifier":{"url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","interfaceLanguage":"swift"},"metadata":{"title":"Concurrent Order Selection with AutoARIMA","modules":[{"name":"SwiftForecast"}],"roleHeading":"API Collection","role":"collectionGroup"},"abstract":[{"type":"text","text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency."}],"topicSections":[{"title":"Automated Time Series","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMACriterion"],"anchor":"Automated-Time-Series"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftforecast\/autoarimaparallel"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"],"generated":true,"anchor":"Guides--Tutorials"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Manually diagnosing autocorrelation functions (ACF) and partial autocorrelation functions (PACF) to select ARIMA orders is time-consuming and error-prone. Standard automated packages like R’s "},{"code":"forecast::auto.arima","type":"codeVoice"},{"type":"text","text":" or Python’s "},{"code":"pmdarima","type":"codeVoice"},{"type":"text","text":" search across candidate orders sequentially."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AutoARIMA"},{"text":" evaluates the entire hyperparameter lattice simultaneously across all CPU cores on Apple Silicon using structured Swift Concurrency (","type":"text"},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"text":").","type":"text"}]},{"type":"heading","level":2,"text":"Grid Search Architecture","anchor":"Grid-Search-Architecture"},{"type":"codeListing","syntax":null,"code":["           Observed Time Series [y_1, y_2, ..., y_N]","                               │","       ┌───────────────────────┼───────────────────────┐","       ▼                       ▼                       ▼","ARIMA(1, 1, 0)          ARIMA(2, 1, 1)          ARIMA(0, 1, 2)","Task 1                  Task 2                  Task 3","   │                       │                       │","   ├─ Hannan-Rissanen      ├─ Hannan-Rissanen      ├─ Hannan-Rissanen","   └─ Compute AIC\/BIC      └─ Compute AIC\/BIC      └─ Compute AIC\/BIC","       │                       │                       │","       └───────────────────────┼───────────────────────┘","                               ▼","                withThrowingTaskGroup Collector","                               │","                               ▼","                 Sorted Leaderboard & Best Model"]},{"type":"heading","level":3,"text":"Information Criteria","anchor":"Information-Criteria"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"AIC (Akaike Information Criterion)","type":"text"}],"type":"strong"},{"type":"text","text":": Penalizes model complexity while rewarding likelihood:"},{"type":"text","text":" "},{"type":"text","text":"$$\\text{AIC} = 2k - 2\\ln(L)$$"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"BIC (Bayesian Information Criterion)","type":"text"}]},{"text":": Imposes a stronger penalty proportional to sample size:","type":"text"},{"text":" ","type":"text"},{"text":"$$\\text{BIC} = k\\ln(N) - 2\\ln(L)$$","type":"text"}]}]}]},{"type":"heading","anchor":"Example-Usage","text":"Example Usage","level":2},{"syntax":"swift","code":["import SwiftForecast","","\/\/ 1. Initialize AutoARIMA with bounded search ranges","let autoArima = AutoARIMA(","    maxP: 3,","    maxD: 2,","    maxQ: 3,","    criterion: .aic",")","","\/\/ 2. Concurrently fit candidates across all cores","let result = try await autoArima.fit(series: historicalPrices)","print(\"Optimal Order: \\(autoArima.bestOrder!) with AIC: \\(autoArima.bestScore!)\")","","\/\/ 3. Generate multi-step forecasts","let forecast = try await autoArima.forecast(horizon: 12)","print(\"Forecasted points: \\(forecast.forecast.predictions)\")"],"type":"codeListing"},{"type":"heading","anchor":"Stability--Convergence-Guarantees","text":"Stability & Convergence Guarantees","level":2},{"type":"heading","anchor":"Zero-Variance-Degenerate-Inputs","text":"Zero-Variance Degenerate Inputs","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If an input series is constant or exhibits zero numerical variance ($\\text{var} < 10^{-12}$), standard likelihood optimization can diverge or enter infinite loops. "},{"type":"codeVoice","code":"AutoARIMA"},{"type":"text","text":" detects zero variance upfront, immediately fitting an exact ARIMA(0, 0, 0) constant model:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Avoids matrix singularities in the Hannan-Rissanen and Yule-Walker algorithms.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Guarantees instant return without stalling the task group.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Fixed-Iteration-Bound","text":"Fixed Iteration Bound","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"All internal parameter search loops are strictly bounded by a "},{"type":"codeVoice","code":"maxIterations = 500"},{"type":"text","text":" ceiling, ensuring that optimization cannot exceed the configured iteration bound in deterministic time across parallel worker threads."}]}]}],"references":{"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAOrder":{"abstract":[{"type":"text","text":"A structure identifying the selected ARIMA \/ SARIMA order."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","role":"symbol","url":"\/documentation\/swiftforecast\/autoarimaorder","title":"AutoARIMAOrder","navigatorTitle":[{"text":"AutoARIMAOrder","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoARIMAOrder","kind":"identifier"}]},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMA":{"title":"AutoARIMA","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoARIMA"}],"abstract":[{"text":"Automated hyperparameter grid search for ARIMA and SARIMA time-series models.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","url":"\/documentation\/swiftforecast\/autoarima","navigatorTitle":[{"kind":"identifier","text":"AutoARIMA"}]},"doc://SwiftForecast/documentation/SwiftForecast/SmoothingAndDecomposition":{"url":"\/documentation\/swiftforecast\/smoothinganddecomposition","title":"Time Series Forecasting, Smoothing & Kalman Filtering","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","abstract":[{"text":"Model trends, seasonality, volatility, and dynamic state transitions using ","type":"text"},{"code":"ExponentialSmoothing","type":"codeVoice"},{"type":"text","text":", "},{"code":"NelderMead","type":"codeVoice"},{"text":", ","type":"text"},{"code":"KalmanFilter","type":"codeVoice"},{"text":", ","type":"text"},{"code":"GARCHModel","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"TimeSeriesDecomposition"},{"type":"text","text":"."}],"kind":"article","type":"topic","role":"article"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMACriterion":{"url":"\/documentation\/swiftforecast\/autoarimacriterion","title":"AutoARIMACriterion","abstract":[{"text":"Information criterion utilized for model selection in ","type":"text"},{"code":"AutoARIMA","type":"codeVoice"},{"text":".","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"AutoARIMACriterion"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMACriterion","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoARIMACriterion","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://SwiftForecast/documentation/SwiftForecast/ArimaAndSarima":{"title":"ARIMA & SARIMA Time Series Models","url":"\/documentation\/swiftforecast\/arimaandsarima","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","type":"topic","abstract":[{"text":"Forecast univariate time series with trends and periodic seasonalities using Autoregressive Integrated Moving Average (ARIMA), Seasonal ARIMA (SARIMA), and Automated Order Selection (AutoARIMA).","type":"text"}],"role":"collectionGroup","kind":"article"},"doc://SwiftForecast/documentation/SwiftForecast":{"kind":"symbol","title":"SwiftForecast","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast","url":"\/documentation\/swiftforecast","abstract":[{"text":"Time Series & Volatility Forecasting Models.","type":"text"}],"type":"topic","role":"collection"},"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"title":"KoopmanOperator","url":"\/documentation\/swiftforecast\/koopmanoperator","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KoopmanOperator","kind":"identifier"}],"type":"topic","abstract":[{"text":"Koopman Operator time-series forecasting and dynamical system modeling actor.","type":"text"},{"text":" 