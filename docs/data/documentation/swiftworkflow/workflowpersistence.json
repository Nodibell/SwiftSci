{"sections":[],"kind":"article","metadata":{"modules":[{"name":"SwiftWorkflow"}],"roleHeading":"Article","role":"article","title":"Deploying and Persisting Scientific Workflows"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In production scientific machine learning systems, data leakage between training and evaluation phases is one of the most common causes of overly optimistic validation metrics. "},{"type":"codeVoice","code":"SwiftWorkflow"},{"type":"text","text":" eliminates leakage by enforcing structural invariants at the API level:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Explicit Supervised Batch Splitting"}],"type":"strong"},{"text":": Workflows accept ","type":"text"},{"code":"PreparedSupervisedBatch","type":"codeVoice"},{"text":" instances where row selection explicitly tracks ","type":"text"},{"code":"originalRowIndices","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Immutable Stages"}],"type":"strong"},{"text":": Once trained, a workflow exposes no mutable hyperparameters or refitting paths.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Atomic Schema Validation"}],"type":"strong"},{"text":": When loading from JSON, dimensions and feature names are checked against the artifact header before initializing models.","type":"text"}]}]}],"type":"orderedList"},{"anchor":"End-to-End-Persistence-Pattern","level":3,"type":"heading","text":"End-to-End Persistence Pattern"},{"syntax":"swift","code":["import Foundation","import SwiftDataFrame","import SwiftWorkflow","","\/\/ Train workflow on designated training rows","let workflow = try await PCAClassificationWorkflow.train(","    training: trainingBatch,","    components: 2,","    learningRate: 0.125,","    epochs: 64",")","","\/\/ Serialize fitted stages to JSON artifact","let artifactURL = URL(fileURLWithPath: \"PCAWorkflow.json\")","try workflow.save(to: artifactURL)","","\/\/ Reload across independent processes with verified dimensions","let reloaded = try PCAClassificationWorkflow.load(from: artifactURL)","let predictions = try await reloaded.predict(unlabeledBatch)"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Learn how to safely persist, reload, and evaluate end-to-end machine learning workflows across processes."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftworkflow\/workflowpersistence"]}],"hierarchy":{"paths":[["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow"]]},"references":{"doc://SwiftWorkflow/documentation/SwiftWorkflow":{"role":"collection","type":"topic","kind":"symbol","url":"\/documentation\/swiftworkflow","abstract":[{"type":"text","text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization."}],"identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow","title":"SwiftWorkflow"}}}