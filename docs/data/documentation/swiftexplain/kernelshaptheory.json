{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory"},"abstract":[{"type":"text","text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model."}],"topicSections":[{"title":"SHAP Explainer APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"anchor":"SHAP-Explainer-APIs"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/kernelshaptheory"]}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Game-Theoretic Interpretability with Kernel SHAP","modules":[{"name":"SwiftExplain"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"SHAP (SHapley Additive exPlanations)"}],"type":"strong"},{"type":"text","text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory."}]},{"type":"heading","anchor":"1-The-Four-Shapley-Axioms","text":"1. The Four Shapley Axioms","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Efficiency","type":"text"}]},{"text":": Feature attributions sum up to the difference between model prediction ","type":"text"},{"type":"codeVoice","code":"f(x)"},{"text":" and expected background prediction ","type":"text"},{"type":"codeVoice","code":"E[f(X)]"},{"text":":","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}]}],"type":"aside","style":"note"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Symmetry","type":"text"}]},{"text":": If two features contribute equally to all possible feature subsets, their attributions are equal.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Dummy (Null Player)","type":"text"}]},{"text":": A feature that does not change the model prediction for any coalition receives an attribution of zero (","type":"text"},{"type":"codeVoice","code":"φ_i = 0"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Additivity","type":"text"}]},{"text":": For ensemble models ","type":"text"},{"type":"codeVoice","code":"f = f1 + f2"},{"text":", attributions satisfy ","type":"text"},{"type":"codeVoice","code":"φ_i(f) = φ_i(f1) + φ_i(f2)"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"2-Explaining-Predictions-in-SwiftSci","text":"2. Explaining Predictions in SwiftSci","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"]}]}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"url":"\/documentation\/swiftexplain","kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}],"title":"SwiftExplain","type":"topic","role":"collection"},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KernelSHAP"}],"navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","type":"topic","abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}],"role":"symbol","title":"KernelSHAP","url":"\/documentation\/swiftexplain\/kernelshap"}}}