 controller providing intelligent model selection","type":"text"},{"text":" ","type":"text"},{"text":"and automated cross-validation benchmarking under time constraints.","type":"text"}],"kind":"symbol","title":"AutoML","url":"\/documentation\/swiftoptimize\/automl","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoML"}],"navigatorTitle":[{"kind":"identifier","text":"AutoML"}],"role":"symbol"},"doc://SwiftOptimize/documentation/SwiftOptimize/CrossValidationFolds":{"type":"topic","kind":"article","title":"Cross-Validation Strategies","abstract":[{"text":"Evaluate model stability and generalization performance across dataset splits using ","type":"text"},{"code":"KFold","type":"codeVoice"},{"text":", ","type":"text"},{"code":"StratifiedKFold","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"TimeSeriesSplit"},{"text":".","type":"text"}],"role":"article","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","url":"\/documentation\/swiftoptimize\/crossvalidationfolds"},"doc://SwiftOptimize/documentation/SwiftOptimize":{"url":"\/documentation\/swiftoptimize","abstract":[{"type":"text","text":"AutoML, Cross-Validation Folds & Hyperparameter Tuning."}],"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize","title":"SwiftOptimize","role":"collection","kind":"symbol","type":"topic"},"doc://SwiftOptimize/documentation/SwiftOptimize/AutoMLStrategy":{"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoMLStrategy","kind":"identifier"}],"navigatorTitle":[{"text":"AutoMLStrategy","kind":"identifier"}],"title":"AutoMLStrategy","abstract":[{"type":"text","text":"AutoML hyperparameter optimization strategy."}],"url":"\/documentation\/swiftoptimize\/automlstrategy","kind":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLStrategy","type":"topic"}}}