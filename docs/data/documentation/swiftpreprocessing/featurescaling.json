{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Feature scaling is crucial for gradient-based estimators (Neural Networks, Logistic Regression) and distance-based estimators (KNN, DBSCAN, SVM). Without scaling, features with large numeric scales disproportionately dominate distance calculations and gradient updates.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"text":"⚡ Flat 1D Memory Layout & Hardware Vectorization","anchor":"%E2%9A%A1-Flat-1D-Memory-Layout--Hardware-Vectorization","type":"heading"},{"inlineContent":[{"code":"SwiftPreprocessing","type":"codeVoice"},{"text":" operates on contiguous 1D row-major flat buffers ","type":"text"},{"code":"[Double]","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"[Float]","type":"codeVoice"},{"text":") with stride indexing ","type":"text"},{"code":"index = row * cols + col","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"],"type":"codeListing"},{"inlineContent":[{"text":"All arithmetic operations (","type":"text"},{"code":"vDSP_vsubD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_vsdivD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP.sort","type":"codeVoice"},{"text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"text":"1. `StandardScaler` (Z-Score Standardization)","anchor":"1-StandardScaler-Z-Score-Standardization","type":"heading"},{"inlineContent":[{"text":"Transforms features to have zero mean (","type":"text"},{"code":"μ = 0","type":"codeVoice"},{"text":") and unit variance (","type":"text"},{"code":"σ² = 1","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"z = (x - μ) \/ σ"}],"type":"paragraph"}],"type":"aside"},{"syntax":"swift","code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"text":"2. `MinMaxScaler` (Bounded Range Scaling)","anchor":"2-MinMaxScaler-Bounded-Range-Scaling","level":2,"type":"heading"},{"inlineContent":[{"text":"Linearly transforms features into a bounded range ","type":"text"},{"code":"[a, b]","type":"codeVoice"},{"text":" (defaults to ","type":"text"},{"type":"codeVoice","code":"[0, 1]"},{"text":"):","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)","type":"codeVoice"}]}],"name":"Note","type":"aside","style":"note"},{"syntax":"swift","type":"codeListing","code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"]},{"type":"thematicBreak"},{"level":2,"text":"3. `RobustScaler` (Median & IQR Scaling)","anchor":"3-RobustScaler-Median--IQR-Scaling","type":"heading"},{"inlineContent":[{"type":"text","text":"When datasets contain extreme outliers, mean and standard deviation are distorted. "},{"type":"codeVoice","code":"RobustScaler"},{"type":"text","text":" scales features using the "},{"type":"strong","inlineContent":[{"text":"Median","type":"text"}]},{"text":" and ","type":"text"},{"inlineContent":[{"text":"Interquartile Range (IQR = Q3 - Q1)","type":"text"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"x' = (x - Median) \/ IQR"}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)","anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling","type":"heading"},{"inlineContent":[{"text":"Scales each sample independently to have unit L1, L2, or Max norm:","type":"text"}],"type":"paragraph"},{"code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"],"syntax":"swift","type":"codeListing"},{"name":"Note","style":"note","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Memory & Performance Tip:"}],"type":"strong"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Float"},{"text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput.","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling"},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"variants":[{"paths":["\/documentation\/swiftpreprocessing\/featurescaling"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using ","type":"text"},{"code":"StandardScaler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MinMaxScaler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RobustScaler","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Normalizer","type":"codeVoice"},{"text":" powered by Apple Accelerate ","type":"text"},{"type":"codeVoice","code":"vDSP"},{"text":".","type":"text"}],"kind":"article","metadata":{"title":"Feature Scaling, Normalization & Flat 1D Memory","modules":[{"name":"SwiftPreprocessing"}],"role":"article","roleHeading":"Article"},"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"],"generated":true,"title":"Guides & Tutorials"}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseDataStructures":{"url":"\/documentation\/swiftpreprocessing\/sparsedatastructures","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","title":"Memory-Efficient Sparse Matrix Representations","abstract":[{"type":"text","text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats."}],"type":"topic","kind":"article","role":"collectionGroup"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"abstract":[{"text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer.","type":"text"}],"role":"article","title":"Categorical Encoding & Imputation","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","url":"\/documentation\/swiftpreprocessing\/encodersandimputers","type":"topic","kind":"article"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"abstract":[{"text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines.","type":"text"}],"role":"collection","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","title":"SwiftPreprocessing","url":"\/documentation\/swiftpreprocessing","type":"topic","kind":"symbol"}}}