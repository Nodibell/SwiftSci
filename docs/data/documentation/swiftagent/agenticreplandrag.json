{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Safe Swift REPL & RAG Context Generator"},"kind":"article","abstract":[{"type":"text","text":"Execute dynamic Swift expressions in a sandboxed evaluation engine, trace immutable lineage audit trails, and summarize tabular DataFrame context for local LLM agents."}],"topicSections":[{"title":"Agent Components","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentError","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentCommand"],"anchor":"Agent-Components"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/agenticreplandrag"]}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgenticReplAndRAG","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Autonomous AI data analyst agents require two core capabilities when interacting with private local data:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sandboxed Code & Command Execution"}]},{"type":"text","text":": Safely filtering, grouping, projecting, and transforming tabular datasets without executing arbitrary unvetted shell scripts or system processes."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Token-Efficient Context Summarization","type":"text"}],"type":"strong"},{"type":"text","text":": Compressing high-dimensional tables into structured, dense Markdown schema summaries that fit comfortably within LLM context windows."}],"type":"paragraph"}]}]},{"inlineContent":[{"code":"SwiftAgent","type":"codeVoice"},{"type":"text","text":" provides "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator"},{"type":"text","text":" to bridge on-device large language models ("},{"code":"SwiftLLM","type":"codeVoice"},{"text":") with the native performance of ","type":"text"},{"identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"mermaid","type":"codeListing","code":["graph TD","    UserQuery[User Analytics Query] --> LLM[Local LLM Agent \/ ReAct Engine]","    DF[(SwiftDataFrame In-Memory Table)] --> RAGGen[RAGContextGenerator]","    RAGGen --> PromptCtx[Markdown Dataset Profile]","    PromptCtx --> LLM","    LLM --> DSLCommand[Generated DSL Command e.g. 'filter age > 30']","    DSLCommand --> Evaluator[SwiftAgentEvaluator Actor]","    DF --> Evaluator","    Evaluator --> TransformedDF[Transformed DataFrame Output]","    Evaluator --> LineageRecord[Lineage Record Audit Trail]","    TransformedDF --> LLMResponse[Agent Synthesizes Final Answer]"]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"1-Sandboxed-REPL--DSL-Command-Evaluation","text":"1. Sandboxed REPL & DSL Command Evaluation"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"},{"type":"text","text":" is an actor-isolated engine that parses and executes high-level DSL commands on a "},{"code":"DataFrame","type":"codeVoice"},{"type":"text","text":". Unlike raw interpreter bridges, it evaluates operations through a strongly typed AST (Abstract Syntax Tree), ensuring that memory safety, thread isolation, and data invariants are strictly preserved."}],"type":"paragraph"},{"type":"heading","text":"Supported DSL Operations","level":3,"anchor":"Supported-DSL-Operations"},{"type":"table","alignments":["left","left","left","left"],"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Command Pattern"}]}],[{"type":"paragraph","inlineContent":[{"text":"Example Expression","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"AST Case","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Filter","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"filter Age > 30.0\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".filter(column, condition)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Evaluates scalar thresholds ("},{"code":">","type":"codeVoice"},{"type":"text","text":", "},{"code":"<","type":"codeVoice"},{"text":", ","type":"text"},{"code":">=","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"<="},{"text":", ","type":"text"},{"type":"codeVoice","code":"=="},{"type":"text","text":", "},{"code":"!=","type":"codeVoice"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Select"}]}]}],[{"type":"paragraph","inlineContent":[{"code":"\"select Product, Price\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".select(columns)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Projects specific column subsets."}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"GroupBy"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"groupby Category mean Price\""}]}],[{"type":"paragraph","inlineContent":[{"code":".groupBy(column, agg, target)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Computes aggregations (","type":"text"},{"code":"mean","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"min","type":"codeVoice"},{"text":", ","type":"text"},{"code":"max","type":"codeVoice"},{"text":", ","type":"text"},{"code":"count","type":"codeVoice"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sample"}]}]}],[{"type":"paragraph","inlineContent":[{"code":"\"sample 50\"","type":"codeVoice"}]}],[{"inlineContent":[{"type":"codeVoice","code":".sample(n)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Randomly samples rows deterministically."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Head \/ Tail","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"\"head 10\""},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"\"tail 5\""}],"type":"paragraph"}],[{"inlineContent":[{"code":".head(n)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".tail(n)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Slices initial or trailing records.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Null Handling","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"code":"\"dropNulls\"","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"\"fillNulls Fare 0.0\"","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":".dropNulls","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".fillNulls","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cleans or imputes missing scalar entries."}],"type":"paragraph"}]]]},{"type":"heading","anchor":"Execution-Example","level":3,"text":"Execution Example"},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftDataFrame","import SwiftAgent","","\/\/ 1. Initialize DataFrame","let rawDF = DataFrame(columns: [","    TypedColumn(name: \"Department\", values: [\"Sales\", \"Engineering\", \"Sales\", \"Support\", \"Engineering\"]),","    TypedColumn(name: \"Salary\", values: [75000.0, 120000.0, 82000.0, 58000.0, 135000.0]),","    TypedColumn(name: \"TenureYears\", values: [3, 5, 4, 1, 7])","])","","\/\/ 2. Initialize actor evaluator","let evaluator = SwiftAgentEvaluator()","","\/\/ 3. Execute sandboxed transformations","let highEarners = try await evaluator.evaluate(","    command: \"filter Salary >= 80000.0\",","    on: rawDF",")","","let departmentSummary = try await evaluator.evaluate(","    command: \"groupby Department mean Salary\",","    on: highEarners",")","","print(departmentSummary.summary())"]},{"type":"thematicBreak"},{"type":"heading","anchor":"2-Lineage-Tracking--Immutable-Audit-Trails","level":2,"text":"2. Lineage Tracking & Immutable Audit Trails"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When autonomous agents transform datasets over iterative multi-turn dialogues, tracking the provenance and step-by-step delta of the data is critical for compliance and verification."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"},{"text":" automatically captures each successful transformation as an immutable ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Inspect the execution trajectory","let auditTrail = await evaluator.lineage","","for record in auditTrail {","    print(\"\"\"","    [Step \\(record.stepIndex)] \\(record.operation)","      • Rows: \\(record.inputRows) -> \\(record.outputRows)","      • Executed At: \\(record.timestamp)","    \"\"\")","}","","\/\/ Reset trajectory between separate user tasks","await evaluator.clearLineage()"]},{"type":"thematicBreak"},{"type":"heading","anchor":"3-Tabular-RAG-Context-Summarization","level":2,"text":"3. Tabular RAG Context Summarization"},{"type":"paragraph","inlineContent":[{"text":"Large datasets cannot be pasted verbatim into an LLM context window without incurring prohibitive attention computation and context exhaustion. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator","type":"reference"},{"text":" extracts metadata, column typings, and dimensional boundaries to produce token-efficient Markdown profiles for prompt injection:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let contextGen = RAGContextGenerator()","let markdownProfile = contextGen.generateSummary(df: rawDF, name: \"EmployeePayroll\")","","print(markdownProfile)","\/\/ Output:","\/\/ ## EmployeePayroll Profile","\/\/ - Rows: 5, Columns: 3","\/\/ - Columns: Department, Salary, TenureYears"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject this profile directly into your system prompt so the language model understands available columns and schema constraints before generating transformation instructions."}]},{"type":"thematicBreak"},{"anchor":"4-End-to-End-LLM-Function-Calling--ReAct-Integration","level":2,"type":"heading","text":"4. End-to-End LLM Function Calling & ReAct Integration"},{"inlineContent":[{"type":"text","text":"Combine "},{"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","isActive":true},{"type":"text","text":", and "},{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" to construct an autonomous tabular analyst:"}],"type":"paragraph"},{"code":["import SwiftAgent","import SwiftDataFrame","","public struct TabularAnalystTool: Sendable {","    private let evaluator: SwiftAgentEvaluator","    private var currentDataFrame: DataFrame","","    public init(df: DataFrame) {","        self.evaluator = SwiftAgentEvaluator()","        self.currentDataFrame = df","    }","","    \/\/\/ Tool invocation callback conforming to ReActAgent tool schema","    public mutating func execute(command: String) async throws -> String {","        let transformed = try await evaluator.evaluate(command: command, on: currentDataFrame)","        self.currentDataFrame = transformed","        return \"Command succeeded. Result dimensions: \\(transformed.rowCount) rows x \\(transformed.columnNames.count) columns.\"","    }","","    public func datasetContext() -> String {","        RAGContextGenerator().generateSummary(df: currentDataFrame, name: \"ActiveWorkspace\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"5-Safe-Error-Handling--Guardrails","level":2,"type":"heading","text":"5. Safe Error Handling & Guardrails"},{"inlineContent":[{"type":"text","text":"The evaluation sandbox rejects unparseable strings, missing columns, or type mismatches early, throwing structured "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentError"},{"type":"text","text":" instances:"}],"type":"paragraph"},{"code":["do {","    let result = try await evaluator.evaluate(command: \"filter NonExistentCol > 10\", on: rawDF)","} catch let AgentError.unparseable(cmd) {","    print(\"Agent emitted an invalid DSL syntax: \\(cmd)\")","} catch let AgentError.executionFailed(reason) {","    print(\"Execution rejected: \\(reason)\")","} catch {","    print(\"Unexpected error: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"}],"kind":"content"}],"sections":[],"references":{"https://nodibell.github.io/SwiftSci/documentation/swiftdataframe/":{"titleInlineContent":[{"code":"SwiftDataFrame","type":"codeVoice"}],"title":"SwiftDataFrame","url":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","identifier":"https:\/\/nodibell.github.io\/SwiftSci\/documentation\/swiftdataframe\/","type":"link"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"text":"SwiftAgentEvaluator","kind":"identifier"}],"navigatorTitle":[{"text":"SwiftAgentEvaluator","kind":"identifier"}],"url":"\/documentation\/swiftagent\/swiftagentevaluator","type":"topic","kind":"symbol","title":"SwiftAgentEvaluator","role":"symbol","abstract":[{"text":"Agentic Swift Execution Sandbox Evaluator.","type":"text"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"},"doc://SwiftAgent/documentation/SwiftAgent/RAGContextGenerator":{"url":"\/documentation\/swiftagent\/ragcontextgenerator","role":"symbol","type":"topic","navigatorTitle":[{"text":"RAGContextGenerator","kind":"identifier"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RAGContextGenerator"}],"kind":"symbol","title":"RAGContextGenerator","abstract":[{"text":"RAG Context summary generator for dataframes.","type":"text"}]},"doc://SwiftAgent/documentation/SwiftAgent/AgentError":{"type":"topic","title":"AgentError","navigatorTitle":[{"text":"AgentError","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentError","url":"\/documentation\/swiftagent\/agenterror","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"AgentError"}],"role":"symbol","abstract":[{"type":"text","text":"Errors thrown by SwiftAgent evaluation sandbox."}]},"doc://SwiftAgent/documentation/SwiftAgent/AgentCommand":{"navigatorTitle":[{"text":"AgentCommand","kind":"identifier"}],"abstract":[{"type":"text","text":"Structured Agent AST representation for sandboxed execution."}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentCommand","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AgentCommand","kind":"identifier"}],"title":"AgentCommand","url":"\/documentation\/swiftagent\/agentcommand","kind":"symbol"},"doc://SwiftAgent/documentation/SwiftAgent":{"role":"collection","title":"SwiftAgent","url":"\/documentation\/swiftagent","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent"},"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"navigatorTitle":[{"text":"LineageRecord","kind":"identifier"}],"url":"\/documentation\/swiftagent\/lineagerecord","kind":"symbol","abstract":[{"text":"Represents an immutable audit trail entry recording a discrete data transformation step.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"LineageRecord","kind":"identifier"}],"type":"topic","title":"LineageRecord"},"doc://SwiftAgent/documentation/SwiftAgent/MultiAgentCollaboration":{"title":"Multi-Agent Coordination & Protocols","role":"collectionGroup","kind":"article","url":"\/documentation\/swiftagent\/multiagentcollaboration","abstract":[{"type":"text","text":"Orchestrate teams of specialized autonomous agents over an asynchronous message bus with concurrent parallel tool calling."}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration","type":"topic"}}}