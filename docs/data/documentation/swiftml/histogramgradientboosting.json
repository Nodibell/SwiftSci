,"abstract":[{"type":"text","text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism."}]},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingClassifier":{"role":"symbol","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","url":"\/documentation\/swiftml\/histgradientboostingclassifier","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"text":"HistGradientBoostingClassifier","kind":"identifier"}],"abstract":[{"text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular classification.","type":"text"}],"navigatorTitle":[{"text":"HistGradientBoostingClassifier","kind":"identifier"}],"title":"HistGradientBoostingClassifier","kind":"symbol"},"doc://SwiftML/documentation/SwiftML/BoundedInference":{"role":"article","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/BoundedInference","kind":"article","abstract":[{"text":"Use ","type":"text"},{"code":"CoreMLBatchPipeline.run","type":"codeVoice"},{"text":" to pull batches through fitted preprocessing and a fixed-shape Core ML model. The pipeline holds capacity until each result consumer returns.","type":"text"}],"title":"Run bounded batch inference","url":"\/documentation\/swiftml\/boundedinference"},"doc://SwiftML/documentation/SwiftML/HistTreeNode":{"url":"\/documentation\/swiftml\/histtreenode","abstract":[{"text":"A node in a histogram-binned decision tree.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode","title":"HistTreeNode","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"HistTreeNode"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistTreeNode"}]}}}