{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents."}],"variants":[{"paths":["\/documentation\/swiftagent\/datalineageaudit"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftAgent"}],"title":"Data Lineage & Transformation Audit Trails"},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"topicSections":[{"anchor":"Audit-Types","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"title":"Audit Types"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"text":" automatically generates an immutable audit trail of ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true,"type":"reference"},{"text":" entries for each command evaluated.","type":"text"}]},{"level":2,"type":"heading","text":"LineageRecord Structure","anchor":"LineageRecord-Structure"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true,"type":"reference"},{"text":" contains:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"stepIndex","type":"codeVoice"},{"text":": Sequential index of the step within the agent trajectory.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"operation","type":"codeVoice"},{"text":": The normalized DSL command executed (e.g., ","type":"text"},{"code":"filter(age)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"groupBy(category,mean)","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"inputRows","type":"codeVoice"},{"text":": Dataset row count immediately prior to transformation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"outputRows","type":"codeVoice"},{"text":": Dataset row count produced by the transformation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"timestamp","type":"codeVoice"},{"text":": The exact timestamp of execution.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Example: Accessing Audit Trails","anchor":"Example-Accessing-Audit-Trails"},{"code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"url":"\/documentation\/swiftagent","abstract":[{"text":"Agentic REPL Execution Sandbox & RAG Summary Engine.","type":"text"}],"role":"collection","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","type":"topic","kind":"symbol","title":"SwiftAgent"},"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"type":"topic","kind":"symbol","abstract":[{"text":"Represents an immutable audit trail entry recording a discrete data transformation step.","type":"text"}],"url":"\/documentation\/swiftagent\/lineagerecord","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"LineageRecord","kind":"identifier"}],"title":"LineageRecord","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","navigatorTitle":[{"kind":"identifier","text":"LineageRecord"}],"role":"symbol"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"type":"topic","url":"\/documentation\/swiftagent\/swiftagentevaluator","abstract":[{"text":"Agentic Swift Execution Sandbox Evaluator.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiftAgentEvaluator"}],"title":"SwiftAgentEvaluator","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","navigatorTitle":[{"text":"SwiftAgentEvaluator","kind":"identifier"}],"role":"symbol"}}}