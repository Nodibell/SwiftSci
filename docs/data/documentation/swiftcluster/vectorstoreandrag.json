on Architecture\", text: \"Unified memory and neural engine overview\"),","    (id: \"art_2\", title: \"Swift Strict Concurrency\", text: \"Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"]},{"text":"2. Top-K Semantic Search","type":"heading","anchor":"2-Top-K-Semantic-Search","level":2},{"type":"codeListing","syntax":"swift","code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"]},{"text":"3. Supported Metrics","type":"heading","anchor":"3-Supported-Metrics","level":2},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".cosineSimilarity","type":"codeVoice"}],"type":"strong"},{"text":": Ideal for normalized text embeddings (returns ","type":"text"},{"code":"[-1.0, 1.0]","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".dotProduct","type":"codeVoice"}],"type":"strong"},{"text":": Direct inner product for unnormalized projections.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}],"type":"strong"},{"text":": Geometric L2 distance for spatial clustering.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"sections":[],"kind":"article","a