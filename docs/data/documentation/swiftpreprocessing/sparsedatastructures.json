{"variants":[{"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. ","type":"text"},{"type":"codeVoice","code":"SparseMatrix"},{"text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x.","type":"text"}]},{"text":"Storage Formats","level":2,"anchor":"Storage-Formats","type":"heading"},{"text":"Compressed Sparse Row (CSR)","level":3,"type":"heading","anchor":"Compressed-Sparse-Row-CSR"},{"inlineContent":[{"text":"Stores non-zero values row-by-row:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"values"},{"type":"text","text":": Non-zero numerical entries."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"colIndices"},{"type":"text","text":": Column indices corresponding to each entry in "},{"type":"codeVoice","code":"values"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"rowPointers"},{"type":"text","text":": Offsets into "},{"type":"codeVoice","code":"values"},{"type":"text","text":" marking where each row begins (length: "},{"type":"codeVoice","code":"rowCount + 1"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"],"type":"codeListing","syntax":null},{"text":"Compressed Sparse Column (CSC)","level":3,"anchor":"Compressed-Sparse-Column-CSC","type":"heading"},{"inlineContent":[{"type":"text","text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication."}],"type":"paragraph"},{"text":"Apple Accelerate Sparse BLAS","level":2,"anchor":"Apple-Accelerate-Sparse-BLAS","type":"heading"},{"inlineContent":[{"type":"text","text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"sparse_matrix_create_double","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"sparse_insert_row_double","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_commit"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_matrix_vector_product_dense_double"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput."}],"type":"paragraph"},{"text":"Example Usage","level":2,"anchor":"Example-Usage","type":"heading"},{"code":["import SwiftPreprocessing","","\/\/ 1. Create a sparse matrix from a dense array","let dense: [[Double]] = [","    [1.0, 0.0, 0.0],","    [0.0, 2.0, 0.0],","    [0.0, 0.0, 3.0]","]","let sparse = SparseMatrix(dense: dense, format: .csr)","print(\"Sparsity: \\(sparse.sparsity)\") \/\/ ~ 0.667","","\/\/ 2. Accelerated matrix-vector product","let x = [1.0, 2.0, 3.0]","let y = try sparse.multiply(vector: x)","print(y) \/\/ [1.0, 4.0, 9.0]","","\/\/ 3. Matrix Transpose & CSC conversion","let csc = sparse.toCSC()","let transposed = sparse.transpose()"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"type":"text","text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats."}],"topicSections":[{"anchor":"Sparse-Data-Types","title":"Sparse Data Types","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"]}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","interfaceLanguage":"swift"},"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftPreprocessing"}],"title":"Memory-Efficient Sparse Matrix Representations","role":"collectionGroup"},"kind":"article","seeAlsoSections":[{"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"]}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseFormat":{"navigatorTitle":[{"kind":"identifier","text":"SparseFormat"}],"url":"\/documentation\/swiftpreprocessing\/sparseformat","type":"topic","kind":"symbol","abstract":[{"text":"Storage format for compressed sparse matrix structures.","type":"text"}],"role":"symbol","title":"SparseFormat","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparseFormat"}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseMatrix":{"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","role":"symbol","title":"SparseMatrix","abstract":[{"text":"Memory-efficient sparse matrix storage implementing Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparseMatrix"}],"navigatorTitle":[{"kind":"identifier","text":"SparseMatrix"}],"type":"topic","kind":"symbol","url":"\/documentation\/swiftpreprocessing\/sparsematrix"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"title":"SwiftPreprocessing","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","type":"topic","role":"collection","kind":"symbol","abstract":[{"text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines.","type":"text"}],"url":"\/documentation\/swiftpreprocessing"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/FeatureScaling":{"title":"Feature Scaling, Normalization & Flat 1D Memory","type":"topic","role":"article","abstract":[{"type":"text","text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using "},{"code":"StandardScaler","type":"codeVoice"},{"type":"text","text":", "},{"code":"MinMaxScaler","type":"codeVoice"},{"type":"text","text":", "},{"code":"RobustScaler","type":"codeVoice"},{"type":"text","text":", and "},{"code":"Normalizer","type":"codeVoice"},{"type":"text","text":" powered by Apple Accelerate "},{"code":"vDSP","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiftpreprocessing\/featurescaling","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","kind":"article"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"type":"topic","title":"Categorical Encoding & Imputation","role":"article","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","kind":"article","url":"\/docu