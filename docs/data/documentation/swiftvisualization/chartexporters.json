{"hierarchy":{"paths":[["doc:\/\/SwiftVisualization\/documentation\/SwiftVisualization"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftVisualization"},{"text":" provides two complementary visualization engines:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Native SwiftUI Engine (","type":"text"},{"code":"SwiftSciChartView","type":"codeVoice"},{"text":")","type":"text"}]},{"type":"text","text":": Zero-dependency "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" SwiftUI view rendering line charts, bar charts, scatter plots, histograms, and 2D correlation heatmaps on a high-performance hardware-accelerated "},{"code":"Canvas","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Interactive HTML Exporter (","type":"text"},{"type":"codeVoice","code":"ChartExporter"},{"text":")","type":"text"}],"type":"strong"},{"text":": Standalone browser-ready HTML diagnostic reports (ROC Curves with trapezoidal Area Under Curve \/ AUC computation, Feature Importances, Confusion Matrices).","type":"text"}]}]}],"type":"orderedList"},{"type":"thematicBreak"},{"anchor":"1-Native-SwiftUI-Charting-SwiftSciChartView","text":"1. Native SwiftUI Charting (`SwiftSciChartView`)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Embed responsive, animated charts in iOS and macOS SwiftUI user interfaces:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import SwiftVisualization","","struct ModelDiagnosticsView: View {","    let lossHistory: [Double] = [0.85, 0.62, 0.45, 0.38, 0.29, 0.22, 0.18, 0.15]","    let epochLabels: [String] = (1...8).map { \"Ep \\($0)\" }","    ","    var body: some View {","        VStack(alignment: .leading, spacing: 16) {","            Text(\"Training Loss Convergence\")","                .font(.headline)","            ","            \/\/ 1. Line Chart with custom options","            SwiftSciChartView(","                type: .line,","                data: lossHistory,","                labels: epochLabels,","                options: ChartOptions(","                    accentColor: .blue,","                    showAxes: true,","                    lineWidth: 3.0,","                    customYAxisLabel: \"Loss (Cross-Entropy)\"","                )","            )","            .frame(height: 250)","            .padding()","            .background(Color(.windowBackgroundColor).opacity(0.5))","            .cornerRadius(12)","        }","        .padding()","    }","}"]},{"type":"thematicBreak"},{"anchor":"2-2D-Correlation-Heatmaps-in-SwiftUI","text":"2. 2D Correlation Heatmaps in SwiftUI","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Render 2D covariance and correlation matrices with automatic color gradients:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftUI","import SwiftVisualization","","struct CorrelationMatrixView: View {","    \/\/ 3x3 Correlation Grid","    let matrix2D: [[Double]] = [","        [ 1.00,  0.82, -0.45],","        [ 0.82,  1.00, -0.30],","        [-0.45, -0.30,  1.00]","    ]","    let featureNames = [\"Revenue\", \"Profit\", \"Expenses\"]","    ","    var body: some View {","        SwiftSciChartView(","            type: .heatmap2D(matrix2D),","            data: [],","            labels: featureNames,","            options: ChartOptions(showAxes: true)","        )","        .frame(width: 320, height: 320)","    }","}"]},{"type":"thematicBreak"},{"anchor":"3-Interactive-Plotly-HTML-Reports-with-AUC","text":"3. Interactive Plotly HTML Reports with AUC","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generate standalone HTML diagnostics viewable in any modern browser:"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftVisualization","","\/\/ 1. Export ROC Curve with exact trapezoidal AUC computation","let yTrue = [0, 0, 1, 1, 0, 1]","let yScores = [0.1, 0.35, 0.8, 0.92, 0.2, 0.75]","","let rocHTML = ChartExporter.plotROCCurve(yScores: yScores, yTrue: yTrue)","let outputURL = URL(fileURLWithPath: \"roc_curve_report.html\")","try rocHTML.write(to: outputURL, atomically: true, encoding: .utf8)","","print(\"Saved interactive ROC report with trapezoidal AUC title.\")","","\/\/ 2. Export Feature Importance bar chart","let featureImportances = [\"age\": 0.35, \"income\": 0.45, \"education\": 0.20]","let featHTML = ChartExporter.plotFeatureImportances(featureImportances)"]}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"SwiftVisualization"}],"title":"Native SwiftUI Charting & Interactive Plotly Exporters"},"identifier":{"url":"doc:\/\/SwiftVisualization\/documentation\/SwiftVisualization\/ChartExporters","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftvisualization\/chartexporters"]}],"abstract":[{"text":"Render charts with zero external dependencies using ","type":"text"},{"type":"codeVoice","code":"SwiftSciChartView"},{"text":" in SwiftUI, or export interactive HTML reports with ","type":"text"},{"type":"codeVoice","code":"ChartExporter"},{"text":".","type":"text"}],"kind":"article","references":{"doc://SwiftVisualization/documentation/SwiftVisualization":{"url":"\/documentation\/swiftvisualization","kind":"symbol","title":"SwiftVisualization","type":"topic","identifier":"doc:\/\/SwiftVisualization\/documentation\/SwiftVisualization","role":"collection","abstract":[{"type":"text","text":"Standalone Interactive HTML Chart Exporters."}]}}}