{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"kind":"article","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"SwiftNLP"}],"roleHeading":"Article","role":"article","title":"Text Normalization, Tokenization & Linguistic Tagging"},"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"type":"codeVoice","code":"NaturalLanguage"},{"text":" framework.","type":"text"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"1. Multi-lingual Word & Sentence Tokenization","anchor":"1-Multi-lingual-Word--Sentence-Tokenization"},{"code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","text":"2. POS Tagging, Lemmatization & Entity Extraction","anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction"},{"type":"codeListing","syntax":"swift","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"]},{"type":"heading","level":3,"text":"3. Sentiment Analysis (VADER & NLSentiment)","anchor":"3-Sentiment-Analysis-VADER--NLSentiment"},{"type":"codeListing","syntax":"swift","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization"},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ChatAPI"],"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"role":"article","abstract":[{"text":"Convert text corpora into numerical and sparse feature matrices using ","type":"text"},{"code":"TFIDFVectorizer","type":"codeVoice"},{"type":"text","text":", "},{"code":"CountVectorizer","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"HashingVectorizer"},{"type":"text","text":", "},{"type":"codeVoice","code":"SparseVector"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"text":".","type":"text"}],"kind":"article","title":"Text Feature Vectorization, Sparse TF-IDF & Local Embeddings","url":"\/documentation\/swiftnlp\/vectorizationandem