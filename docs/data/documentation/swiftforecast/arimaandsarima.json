{"sections":[],"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"],"generated":true,"anchor":"Guides--Tutorials"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Time series observations often display temporal autocorrelation, stochastic drift, and repetitive seasonal cycles. ","type":"text"},{"code":"SwiftForecast","type":"codeVoice"},{"type":"text","text":" provides high-performance, actor-isolated statistical models optimized with Apple Accelerate SIMD linear algebra:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Models non-seasonal series using $(p, d, q)$ specifications with vectorized two-stage Hannan-Rissanen conditional least-squares parameter estimation (","type":"text"},{"code":"aic()","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"bic()","type":"codeVoice"},{"text":" evaluate the Gaussian residual-MSE criterion from conditional OLS residuals, rather than exact state-space MLE).","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel"}],"type":"strong"},{"text":": Extends ARIMA to capture multiplicative seasonal cycles $(p, d, q) \\times (P, D, Q)_s$ via polynomial cross-term refinement.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA"}],"type":"strong"},{"text":": Performs parallelized grid search over potential order permutations, selecting optimal configurations via AIC or BIC criteria.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"syntax":"mermaid","type":"codeListing","code":["graph TD","    RawSeries[Raw Time Series Y_t] --> StationarityCheck{Requires Differencing?}","    StationarityCheck -->|Yes| Diff[Differencing: d order \/ Seasonal D order]","    StationarityCheck -->|No| ModelChoice{Model Selection}","    Diff --> ModelChoice","    ModelChoice -->|Manual Specification| FitARIMA[ARIMAModel \/ SARIMAModel]","    ModelChoice -->|Automated Grid Search| Auto[AutoARIMA Task Group]","    Auto --> BestOrder[Optimal Order via AIC\/BIC]","    BestOrder --> FitARIMA","    FitARIMA --> ForecastResult[ARIMAResult: Point Forecasts + Confidence Intervals]","    ForecastResult --> WAPE[WAPE \/ sMAPE Evaluation]"]},{"type":"thematicBreak"},{"type":"heading","text":"1. Non-Seasonal ARIMA Modeling","anchor":"1-Non-Seasonal-ARIMA-Modeling","level":2},{"inlineContent":[{"type":"text","text":"An $\\text{ARIMA}(p, d, q)$ model combines:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"$p$ (Autoregressive Order)"}],"type":"strong"},{"text":": Dependence on preceding $p$ lagged values.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"$d$ (Differencing Order)","type":"text"}]},{"type":"text","text":": Degree of differencing required to achieve weak stationarity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"$q$ (Moving Average Order)","type":"text"}],"type":"strong"},{"type":"text","text":": Dependence on preceding $q$ white-noise forecast errors."}]}]}],"type":"unorderedList"},{"text":"Fitting and Multi-Step Forecasting","anchor":"Fitting-and-Multi-Step-Forecasting","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["import SwiftForecast","","\/\/ 1. Initialize historical series (e.g., monthly sales)","let monthlySales: [Double] = [","    112, 118, 132, 129, 121, 135, 148, 148, 136, 119, 104, 118,","    115, 126, 141, 135, 125, 149, 170, 170, 158, 133, 114, 140","]","","\/\/ 2. Initialize actor-isolated ARIMA(1, 1, 1) model","let arima = try ARIMAModel(p: 1, d: 1, q: 1)","","\/\/ 3. Fit parameters via Hannan-Rissanen conditional least-squares","try await arima.fit(series: monthlySales)","","\/\/ 4. Generate out-of-sample forecast for next 6 horizons","let result = try await arima.forecast(horizon: 6)","","print(\"Point Forecasts: \\(result.pointForecasts)\")","if let lower = result.lowerConfidenceInterval, let upper = result.upperConfidenceInterval {","    for i in 0..<result.pointForecasts.count {","        print(\"t+\\(i + 1): \\(String(format: \"%.1f\", result.pointForecasts[i])) [95% CI: \\(String(format: \"%.1f\", lower[i])) – \\(String(format: \"%.1f\", upper[i]))]\")","    }","}"]},{"type":"thematicBreak"},{"type":"heading","text":"2. Seasonal SARIMA Modeling","anchor":"2-Seasonal-SARIMA-Modeling","level":2},{"inlineContent":[{"type":"text","text":"When data exhibits recurring seasonal patterns (such as quarterly retail spikes or 24-hour diurnal rhythms), standard non-seasonal differencing is insufficient."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","isActive":true},{"type":"text","text":" incorporates multiplicative seasonal operators:"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"$$(p, d, q) \\times (P, D, Q)_s$$","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"where:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"$s$","type":"text"}],"type":"strong"},{"type":"text","text":": Seasonal period length ($s=4$ for quarterly, $s=12$ for monthly, $s=7$ for daily data)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"$P, D, Q$"}],"type":"strong"},{"text":": Seasonal autoregressive, seasonal differencing, and seasonal moving-average orders.","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["import SwiftForecast","","\/\/ Initialize SARIMA(1, 1, 1) x (1, 1, 0)_12 for monthly seasonal data","let sarima = try SARIMAModel(","    p: 1, d: 1, q: 1,","    P: 1, D: 1, Q: 0,","    s: 12",")","","try await sarima.fit(series: monthlySales)","","\/\/ Forecast 12 months ahead","let seasonalForecast = try await sarima.forecast(horizon: 12)","print(\"12-Month Ahead Forecast: \\(seasonalForecast.pointForecasts)\")"]},{"type":"heading","text":"Fitted Values and Residual Alignment","anchor":"Fitted-Values-and-Residual-Alignment","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel"},{"text":" expose original-scale in-sample predictions via ","type":"text"},{"type":"codeVoice","code":"fittedValues"},{"type":"text","text":" ("},{"type":"codeVoice","code":"fittedValues.count == series.count"},{"type":"text","text":") and innovation residuals via "},{"type":"codeVoice","code":"residuals"},{"type":"text","text":" ("},{"type":"codeVoice","code":"residuals.count == series.count - (d + D * s)"},{"type":"text","text":"):"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Warmup indices (","type":"text"},{"code":"0..<(d + D * s)","type":"codeVoice"},{"text":")","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"fittedValues[t]"},{"text":" preserves the initial observed value ","type":"text"},{"type":"codeVoice","code":"series[t]"},{"text":" because full differencing history is unavailable before ","type":"text"},{"type":"codeVoice","code":"t = d + D * s"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Post-warmup indices ("},{"code":"(d + D * s)..<series.count","type":"codeVoice"},{"type":"text","text":")"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"fittedValues[t]"},{"text":" equals the ","type":"text"},{"inlineContent":[{"text":"closed-loop one-step-ahead in-sample prediction","type":"text"}],"type":"strong"},{"type":"text","text":" on the original scale computed using observed values up to "},{"type":"codeVoice","code":"t - 1"},{"type":"text","text":", so "},{"type":"codeVoice","code":"series[t] - fittedValues[t] == residuals[t - (d + D * s)]"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"type":"heading","text":"3. Automated Order Selection (`AutoARIMA`)","anchor":"3-Automated-Order-Selection-AutoARIMA","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Determining optimal $(p, d, q)$ and $(P, D, Q)_s$ orders manually through autocorrelation (ACF) and partial autocorrelation (PACF) plots can be labor-intensive. "},{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","isActive":true,"type":"reference"},{"type":"text","text":" evaluates an exhaustive or bounded grid concurrently across Apple Silicon CPU cores, penalizing complexity with AIC or BIC:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftForecast","","\/\/ Initialize automated grid search engine","let autoArima = AutoARIMA(","    maxP: 3,","    maxD: 2,","    maxQ: 3,","    seasonal: true,","    seasonalPeriod: 12,","    criterion: .aic",")","","\/\/ Search across candidate permutations","let searchResult = try await autoArima.fit(series: monthlySales)","","print(\"Selected Optimal Order: \\(searchResult.bestOrder)\")","\/\/ Example: SARIMA(1, 1, 1)(0, 1, 1)[12]","print(\"Optimal AIC Score: \\(searchResult.bestScore)\")","","\/\/ Forecast directly using the winning model","let bestForecast = try await searchResult.forecast(horizon: 6)","print(\"Best Forecast: \\(bestForecast.pointForecasts)\")"]},{"type":"thematicBreak"},{"type":"heading","text":"4. Forecasting Accuracy with `TimeSeriesMetrics`","anchor":"4-Forecasting-Accuracy-with-TimeSeriesMetrics","level":2},{"inlineContent":[{"type":"text","text":"Validate predictions against holdout test folds using standard metric evaluators, including Weighted Absolute Percentage Error (WAPE):"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftForecast","","let actuals: [Double] = [150.0, 162.0, 180.0, 175.0, 160.0, 142.0]","let predictions = result.pointForecasts","","let wapeError = TimeSeriesMetrics.wape(actual: actuals, forecast: predictions)","let smapeError = TimeSeriesMetrics.smape(actual: actuals, forecast: predictions)","let rmseError = TimeSeriesMetrics.rmse(actual: actuals, forecast: predictions)","","print(\"WAPE: \\(String(format: \"%.2f%%\", wapeError * 100))\")","print(\"sMAPE: \\(String(format: \"%.2f%%\", smapeError * 100))\")","print(\"RMSE: \\(String(format: \"%.2f\", rmseError))\")"]},{"type":"thematicBreak"}],"kind":"content"}],"topicSections":[{"title":"Forecasting Models","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/TimeSeriesMetrics"],"anchor":"Forecasting-Models"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"variants":[{"paths":["\/documentation\/swiftforecast\/arimaandsarima"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftForecast"}],"title":"ARIMA & SARIMA Time Series Models","roleHeading":"API Collection","role":"collectionGroup"},"kind":"article","abstract":[{"text":"Forecast univariate time series with trends and periodic seasonalities using Autoregressive Integrated Moving Average (ARIMA), Seasonal ARIMA (SARIMA), and Automated Order Selection (AutoARIMA).","type":"text"}],"references":{"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAParallel":{"type":"topic","url":"\/documentation\/swiftforecast\/autoarimaparallel","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","kind":"article","role":"collectionGroup","title":"Concurrent Order Selection with AutoARIMA","abstract":[{"type":"text","text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency."}]},"doc://SwiftForecast/documentation/SwiftForecast/SmoothingAndDecomposition":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Model trends, seasonality, volatility, and dynamic state transitions using "},{"type":"codeVoice","code":"ExponentialSmoothing"},{"type":"text","text":", "},{"type":"codeVoice","code":"NelderMead"},{"type":"text","text":", "},{"type":"codeVoice","code":"KalmanFilter"},{"type":"text","text":", "},{"type":"codeVoice","code":"GARCHModel"},{"type":"text","text":", and "},{"type":"codeVoice","code":"TimeSeriesDecomposition"},{"type":"text","text":"."}],"title":"Time Series Forecasting, Smoothing & Kalman Filtering","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","url":"\/documentation\/swiftforecast\/smoothinganddecomposition","role":"article"},"doc://SwiftForecast/documentation/SwiftForecast":{"type":"topic","kind":"symbol","url":"\/documentation\/swiftforecast","role":"collection","title":"SwiftForecast","abstract":[{"text":"Time Series & Volatility Forecasting Models.","type":"text"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast"},"doc://SwiftForecast/documentation/SwiftForecast/ARIMAModel":{"type":"topic","url":"\/documentation\/swiftforecast\/arimamodel","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ARIMAModel"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","kind":"symbol","role":"symbol","title":"ARIMAModel","navigatorTitle":[{"kind":"identifier","text":"ARIMAModel"}],"abstract":[{"type":"text","text":"AutoRegressive Integrated Moving Average (ARIMA) time-series forecasting model actor."}]},"doc://SwiftForecast/documentation/SwiftForecast/SARIMAModel":{"url":"\/documentation\/swiftforecast\/sarimamodel","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SARIMAModel"}],"type":"topic","title":"SARIMAModel","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SARIMAModel"}],"abstract":[{"type":"text","text":"Seasonal AutoRegressive Integrated Moving Average (SARIMA) time-series forecasting model actor."}]},"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KoopmanOperator","kind":"identifier"}],"navigatorTitle":[{"text":"KoopmanOperator","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Koopman Operator time-series forecasting and dynamical system modeling actor."},{"type":"text","text":" "},{"type":"text","text":"Uses Extended Dynamic Mode Decomposition (EDMD) to approximate non-linear dynamics"},{"type":"text","text":" "},{"type":"text","text":"via linear operators in lifted observable feature spaces."}],"title":"KoopmanOperator","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator","url":"\/documentation\/swiftforecast\/koopmanoperator","role":"symbol"},"doc://SwiftForecast/documentation/SwiftForecast/TimeSeriesMetrics":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimeSeriesMetrics","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"TimeSeriesMetrics","kind":"identifier"}],"url":"\/documentation\/swiftforecast\/timeseriesmetrics","role":"symbol","title":"TimeSeriesMetrics","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/TimeSeriesMetrics","abstract":[{"type":"text","text":"Canonical evaluation metrics for time-series forecasting and out-of-sample validation (G-020)."}]},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMA":{"url":"\/documentation\/swiftforecast\/autoarima","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoARIMA","kind":"identifier"}],"type":"topic","title":"AutoARIMA","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AutoARIMA"}],"abstract":[{"type":"text","text":"Automated hyperparameter grid search for ARIMA and SARIMA time-series models."}]},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAOrder":{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","abstract":[{"type":"text","text":"A structure identifying the selected ARIMA \/ SARIMA order."}],"kind":"symbol","title":"AutoARIMAOrder","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoARIMAOrder","kind":"identifier"}],"navigatorTitle":[{"text":"AutoARIMAOrder","kind":"identifier"}],"type":"topic","url":"\/documentation\/swiftforecast\/autoarimaorder","role":"symbol"}}}