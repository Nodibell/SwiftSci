{"abstract":[{"type":"text","text":"Orchestrate teams of specialized autonomous agents over an asynchronous message bus with concurrent parallel tool calling."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/multiagentcollaboration"]}],"kind":"article","seeAlsoSections":[{"anchor":"Guides--Tutorials","generated":true,"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgenticReplAndRAG"],"title":"Guides & Tutorials"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftAgent"}],"title":"Multi-Agent Coordination & Protocols"},"topicSections":[{"title":"Multi-Agent Coordination","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentOrchestrator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessageBus","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessage","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolCall","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolResult","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SpecializedAgent"],"anchor":"Multi-Agent-Coordination"}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Complex analytical and reasoning workflows are frequently error-prone when performed by a single monolithic model. Decomposing problems into specialized roles—such as "},{"inlineContent":[{"text":"Planner","type":"text"}],"type":"strong"},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"type":"text","text":"Analyst"}]},{"type":"text","text":", and "},{"type":"strong","inlineContent":[{"type":"text","text":"Critic"}]},{"type":"text","text":"—dra