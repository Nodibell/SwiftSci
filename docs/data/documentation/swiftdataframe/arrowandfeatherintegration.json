{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"SwiftDataFrame"}],"title":"Apache Arrow & Feather Zero-Copy Integration","role":"collectionGroup","roleHeading":"API Collection"},"abstract":[{"text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"],"anchor":"Arrow-Classes--Readers","title":"Arrow Classes & Readers"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftDataFrame"},{"text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties.","type":"text"}]},{"text":"1. Arrow Memory Layout & Bitmaps","level":2,"anchor":"1-Arrow-Memory-Layout--Bitmaps","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:","type":"text"}]},{"syntax":null,"code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Validity Bitmaps","type":"text"}],"type":"strong"},{"text":": Each bit represents the presence (1) or absence (0) of a value at that index.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"SIMD Null Filtering","type":"text"}],"type":"strong"},{"text":": Vectorized operations skip null evaluations using SIMD bitmasks (","type":"text"},{"code":"vDSP_vcmprsD","type":"codeVoice"},{"text":"), allowing full CPU register utilization.","type":"text"}]}]}],"type":"unorderedList"},{"text":"2. Feather File Format (Arrow IPC)","level":2,"anchor":"2-Feather-File-Format-Arrow-IPC","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:","type":"text"}]},{"syntax":"swift","code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"type":"codeListing"},{"text":"3. Lazy Feather Streaming","level":2,"anchor":"3-Lazy-Feather-Streaming","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For large datasets, SwiftDataFrame supports streaming chunked reads:","type":"text"}]},{"syntax":"swift","code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"type":"topic","title":"FeatherWriter","url":"\/documentation\/swiftdataframe\/featherwriter","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeatherWriter","kind":"identifier"}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","abstract":[{"type":"text","text":"Writer for Feather \/ Apache Arrow IPC binary file format."}],"role":"symbol","navigatorTitle":[{"text":"FeatherWriter","kind":"identifier"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"TypedColumn","kind":"identifier"}],"type":"topic","abstract":[{"text":"A strongly-typed column backed by a contiguous Swift array.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" elements represent null \/ missing values.","type":"text"}],"url":"\/documentation\/swiftdataframe\/typedcolumn","title":"TypedColumn","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypedColumn","kind":"identifier"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"title":"FeatherReader","type":"topic","url":"\/documentation\/swiftdataframe\/featherreader","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeatherReader","kind":"identifier"}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","abstract":[{"text":"Reader for Feather \/ Apache Arrow IPC binary file format.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"FeatherReader","kind":"identifier"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","type":"topic","role":"collection","title":"SwiftDataFrame","url":"\/documentation\/swiftdataframe","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}],"kind":"symbol"}}}