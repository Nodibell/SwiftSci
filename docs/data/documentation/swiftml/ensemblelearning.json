{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning"},"abstract":[{"text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/ensemblelearning"]}],"metadata":{"title":"Ensemble Learning: Random Forests & Gradient Boosted Trees","modules":[{"name":"SwiftML"}],"roleHeading":"API Collection","role":"collectionGroup"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestClassifier","doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestRegressor"],"title":"Tree Estimators","anchor":"Tree-Estimators"}],"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Ensemble methods combine multiple base estimators to improve generalization and reduce variance. ","type":"text"},{"code":"SwiftML","type":"codeVoice"},{"text":" implements both ","type":"text"},{"inlineContent":[{"text":"Random Forests","type":"text"}],"type":"strong"},{"text":" (bagging) and ","type":"text"},{"inlineContent":[{"text":"Gradient Boosted Decision Trees","type":"text"}],"type":"strong"},{"text":" (boosting) with high-performance tree split search.","type":"text"}]},{"text":"1. Random Forest Classification & Regression","type":"heading","anchor":"1-Random-Forest-Classification--Regression","level":2},{"type":"paragraph","inlineContent":[{"code":"RandomForestClassifier","type":"codeVoice"},{"text":" trains an ensemble of randomized decision trees using bootstrap aggregation (bagging) and random feature subsets:","type":"text"}]},{"code":["import SwiftML","","let rf = try RandomForestClassifier(","    nEstimators: 100,","    maxDepth: 10,","    minSamplesSplit: 2,","    criterion: .gini",")","","try await rf.fit(features: X_train, targets: y_train)","let predictions = try await rf.predict(features: X_test)","let probabilities = try await rf.predictProba(features: X_test)"],"type":"codeListing","syntax":"swift"},{"text":"2. Gradient Boosted Decision Trees (GBDT)","type":"heading","anchor":"2-Gradient-Boosted-Decision-Trees-GBDT","level":2},{"type":"paragraph","inlineContent":[{"code":"GradientBoostingClassifier","type":"codeVoice"},{"text":" sequentially trains decision trees to minimize pseudo-residuals using gradient descent in function space:","type":"text"}]},{"code":["let gbdt = try GradientBoostingClassifier(","    nEstimators: 50,","    learningRate: 0.1,","    maxDepth: 5",")","","try await gbdt.fit(features: X_train, targets: y_train)"],"type":"codeListing","syntax":"swift"},{"text":"3. Feature Importance Extraction","type":"heading","anchor":"3-Feature-Importance-Extraction","level":2},{"type":"paragraph","inlineContent":[{"text":"Both tree models compute Gini\/MSE feature importances directly:","type":"text"}]},{"code":["let importances = rf.featureImportances","print(\"Feature importances: \\(importances)\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"references":{"doc://SwiftML/documentation/SwiftML":{"url":"\/documentation\/swiftml","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","role":"collection","title":"SwiftML","kind":"symbol","type":"topic"},"doc://SwiftML/documentation/SwiftML/RandomForestClassifier":{"url":"\/documentation\/swiftml\/randomforestclassifier","role":"symbol","navigatorTitle":[{"text":"RandomForestClassifier","kind":"identifier"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestClassifier","abstract":[{"type":"text","text":"Actor-isolated Random Forest Classifier."},{"type":"text","text":" "},{"type":"text"