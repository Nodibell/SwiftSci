{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftAgent"},{"text":" provides an agentic reasoning and execution framework tailored for analytical workloads. By combining a ","type":"text"},{"type":"strong","inlineContent":[{"text":"ReAct (Reason + Act)","type":"text"}]},{"text":" loop with a secure, sandboxed command interpreter, agents can autonomously explore datasets without risking arbitrary code execution.","type":"text"}]},{"type":"codeListing","code":["sequenceDiagram","    User->>Agent: \"What is the average fare for first-class passengers?\"","    loop ReAct Loop","        Agent->>Evaluator: filter(column: \"pclass\", op: .equals(1))","        Evaluator-->>Agent: Filtered DataFrame (216 rows)","        Agent->>Evaluator: aggregate(column: \"fare\", metric: .mean)","        Evaluator-->>Agent: 84.15","    end","    Agent-->>User: \"The average fare for first-class passengers is $84.15.\""],"syntax":"mermaid"},{"type":"heading","text":"1. Running an Autonomous Agent Query","anchor":"1-Running-an-Autonomous-Agent-Query","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftAgent","import SwiftDataFrame","","var df = try DataFrame.fromCSV(url: URL(fileURLWithPath: \"titanic.csv\"))","let agent = AgentEvaluator(dataFrame: df)","","\/\/ Execute structured agent commands","let resultDF = try agent.execute(\"filter pclass == 1 | groupby survived | mean fare\")","resultDF.debugPrint()"]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AutonomousDataAnalyst","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"topicSections":[{"title":"Agent Components","anchor":"Agent-Components","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","doc:\/\/SwiftAgent\/docume