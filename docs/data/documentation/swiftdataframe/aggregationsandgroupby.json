{"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. ","type":"text"},{"type":"codeVoice","code":"SwiftDataFrame"},{"text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory.","type":"text"}],"type":"paragraph"},{"text":"1. Basic GroupBy Aggregation","anchor":"1-Basic-GroupBy-Aggregation","level":2,"type":"heading"},{"code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"],"syntax":"swift","type":"codeListing"},{"text":"2. Multi-Column Grouping","anchor":"2-Multi-Column-Grouping","level":2,"type":"heading"},{"inlineContent":[{"text":"You can group by multiple categorical dimensions simultaneously:","type":"text"}],"type":"paragraph"},{"code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"],"syntax":"swift","type":"codeListing"},{"text":"3. Performance & Memory Efficiency","anchor":"3-Performance--Memory-Efficiency","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Single-Pass Hash Accumulation","type":"text"}]},{"text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"vDSP Vector Reductions","type":"text"}]},{"text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines (","type":"text"},{"type":"codeVoice","code":"vDSP_sveD"},{"text":", ","type":"text"},{"type":"codeVoice","code":"vDSP_meanvD"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"]}],"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"abstract":[{"text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame.","type":"text"}],"kind":"article","topicSections":[{"anchor":"Grouping-APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"],"title":"Grouping APIs"}],"metadata":{"title":"High-Performance GroupBy & Vectorized Aggregations","role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftDataFrame"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"type":"topic","title":"SwiftDataFrame","url":"\/documentation\/swiftdataframe","kind":"symbol","role":"collection","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"title":"groupBy(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupBy"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"...) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:14SwiftDataFrame07GroupedbC0V","text":"GroupedDataFrame"}],"abstract":[{"type":"text","text":"Returns a "},{"type":"codeVoice","code":"GroupedDataFrame"},{"type":"text","text":" for aggregation."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)","url":"\/documentation\/swiftdataframe\/dataframe\/groupby(_:)","role":"symbol"}}}