{"kind":"article","primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WordNet"},{"type":"text","text":" is a large lexical database of English where nouns, verbs, adjectives, and adverbs are organized into sets of cognitive synonyms called "},{"inlineContent":[{"type":"text","text":"Synsets"}],"type":"strong"},{"type":"text","text":", interlinked by conceptual-semantic and lexical relations."}]},{"type":"heading","anchor":"1-Looking-Up-Synsets--Definitions","text":"1. Looking Up Synsets & Definitions","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","let wordnet = WordNet.shared","","\/\/ Look up all noun synsets for \"bank\"","let synsets = wordnet.synsets(for: \"bank\", pos: .noun)","for s in synsets {","    print(\"ID: \\(s.id), Definition: \\(s.definition)\")","}"]},{"type":"heading","anchor":"2-Semantic-Similarity-Metrics","text":"2. Semantic Similarity Metrics","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftSci implements standard lexical similarity algorithms:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Path Similarity"}]},{"text":": Shortest path distance in the hypernym taxonomy:","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Sim_path(s1, s2) = 1 \/ (1 + distance(s1, s2))"}]}],"name":"Note"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wu-Palmer Similarity (WUP)"}]},{"text":": Measures depth of least common subsumer (LCS) relative to synset depths:","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Sim_wup(s1, s2) = (2 · depth(LCS)) \/ (depth(s1) + depth(s2))"}]}],"name":"Note"}]}]},{"type":"codeListing","syntax":"swift","code":["let dog = wordnet.synset(\"dog.n.01\")!","let cat = wordnet.synset(\"cat.n.01\")!","","let pathSim = wordnet.pathSimilarity(dog, cat)","let wupSim = wordnet.wuPalmerSimilarity(dog, cat)","","print(\"Path Similarity: \\(pathSim), Wu-Palmer: \\(wupSim)\")"]}],"kind":"content"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"WordNet Semantic Hierarchy & Lexical Graphs","modules":[{"name":"SwiftNLP"}]},"topicSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNet","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/Synset","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS"],"title":"WordNet Types","anchor":"WordNet-Types"}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"abstract":[{"type":"text","text":"Navigate semantic relationships, compute synset distances, and explore English hypernym\/hyponym trees."}],"variants":[{"paths":["\/documentation\/swiftnlp\/wordnetandlexicalgraphs"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNetAndLexicalGraphs","interfaceLanguage":"swift"},"sections":[],"references":{"doc://SwiftNLP/documentation/SwiftNLP/Synset":{"abstract":[{"type":"text","text":"Represents a WordNet Synset (Syntactic\/Semantic Set of Synonym Concepts)."}],"url":"\/documentation\/swiftnlp\/synset","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/Synset","navigatorTitle":[{"kind":"identifier","text":"Synset"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Synset"}],"title":"Synset"},"doc://SwiftNLP/documentation/SwiftNLP":{"type":"topic","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"kind":"symbol","role":"collection","title":"SwiftNLP","url":"\/documentation\/swiftnlp","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP"},"doc://SwiftNLP/documentation/SwiftNLP/POS":{"abstract":[{"type":"text","text":"Part of Speech categories in WordNet."}],"url":"\/documentation\/swiftnlp\/pos","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS","navigatorTitle":[{"text":"POS","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"POS","kind":"identifier"}],"title":"POS"},"doc://SwiftNLP/documentation/SwiftNLP/WordNet":{"abstract":[{"type":"text","text":"Native WordNet semantic database query engine and concept similarity computer."}],"url":"\/documentation\/swiftnlp\/wordnet","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNet","navigatorTitle":[{"kind":"identifier","text":"WordNet"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WordNet"}],"title":"WordNet"}}}