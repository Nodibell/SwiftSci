{"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"anchor":"Guides--Tutorials","generated":true,"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"title":"Guides & Tutorials"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"During autoregressive language generation, logits from the transformer output layer are converted into probability distributions over the vocabulary. "},{"code":"SwiftLLM","type":"codeVoice"},{"type":"text","text":" executes sampling transformations strictly at the unnormalized logits level prior to softmax evaluation:"}]},{"inlineContent":[{"text":"$$\\text{Logits} \\xrightarrow{\\text{Repetition Penalty}} \\xrightarrow{\\text{Temperature}} \\xrightarrow{\\text{Top-K Mask (-inf)}} \\xrightarrow{\\text{Top-P Mask (-inf)}} \\xrightarrow{\\text{Softmax}} \\xrightarrow{\\text{Sample}}$$","type":"text"}],"type":"paragraph"},{"type":"heading","text":"1. Supported Sampling Methods","anchor":"1-Supported-Sampling-Methods","level":2},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mathematical Formulation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Semantics & Defaults"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Temperature (","type":"text"},{"code":"temperature","type":"codeVoice"},{"text":")","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"$z_i \\leftarrow z_i \/ T$"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Controls distribution entropy. "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" = identity; "},{"type":"codeVoice","code":"0.0"},{"type":"text","text":" = greedy deterministic argmax. Default: "},{"type":"codeVoice","code":"0.7"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Top-K (","type":"text"},{"code":"topK","type":"codeVoice"},{"text":")","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Masks all tokens outside top $K$ with $-\\infty$"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Eliminates low-probability tail tokens. "},{"type":"codeVoice","code":"0"},{"type":"text","text":" disables Top-K filtering. Default: "},{"type":"codeVoice","code":"40"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Top-P Nucleus (","type":"text"},{"code":"topP","type":"codeVoice"},{"text":")","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Retains cumulative probability $\\sum P(w_i) \\ge p$"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dynamically bounds candidates based on probability mass. "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" disables Top-P. Default: "},{"type":"codeVoice","code":"0.9"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Repetition Penalty (","type":"text"},{"code":"repetitionPenalty","type":"codeVoice"},{"text":")","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"$z_i \\leftarrow z_i > 0 \\ ? \\ z_i \/ \\theta : z_i \\cdot \\theta$"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Penalizes tokens previously emitted in generation history. "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" disables penalty. Default: "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":"."}]}]]],"alignments":["left","left","left"],"type":"table","header":"row"},{"anchor":"2-Configuration--Code-Example","type":"heading","level":2,"text":"2. Configuration & Code Example"},{"inlineContent":[{"type":"text","text":"Generation options are unified within "},{"type":"codeVoice","code":"SamplingConfiguration"},{"type":"text","text":", serving as the single source of truth inside "},{"type":"codeVoice","code":"LLMOptions"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiftLLM","","\/\/ 1. Define decoupled sampling parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","\/\/ 2. Configure model generation options","let options = LLMOptions(","    maxTokens: 128,","    stopTokens: [128001, 128009],","    sampling: sampling",")","","\/\/ 3. Stream generated tokens asynchronously","for try await token in model.generateStream(prompt: \"Explain rotary positional embeddings:\", options: options) {","    print(token, terminator: \"\")","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"sections":[],"topicSections":[{"anchor":"Sampling-Types","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions"],"title":"Sampling Types"}],"abstract":[{"type":"text","text":"Control autoregressive language generation with Temperature, Top-P Nucleus, Top-K, and Repetition Penalty."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/samplinganddecodingstrategies"]}],"metadata":{"title":"Token Sampling & Decoding Strategies","modules":[{"name":"SwiftLLM"}],"roleHeading":"API Collection","role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"],["doc:\/\/SwiftLLM