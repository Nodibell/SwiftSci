{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Ensemble methods combine multiple base estimators to improve generalization and reduce variance. ","type":"text"},{"type":"codeVoice","code":"SwiftML"},{"text":" implements both ","type":"text"},{"inlineContent":[{"text":"Random Forests","type":"text"}],"type":"strong"},{"text":" (bagging) and ","type":"text"},{"inlineContent":[{"text":"Gradient Boosted Decision Trees","type":"text"}],"type":"strong"},{"text":" (boosting) with high-performance tree split search.","type":"text"}]},{"text":"1. Random Forest Classification & Regression","level":2,"type":"heading","anchor":"1-Random-Forest-Classification--Regression"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RandomForestClassifier"},{"text":" trains an ensemble of randomized decision trees using bootstrap aggregation (bagging) and random feature subsets:","type":"text"}]},{"code":["import SwiftML","","let rf = try RandomForestClassifier(","    nEstimators: 100,","    maxDepth: 10,","    minSamplesSplit: 2,","    criterion: .gini",")","","try await rf.fit(features: X_train, targets: y_train)","let predictions = try await rf.predict(features: X_test)","let probabilities = try await rf.predictProba(features: X_test)"],"type":"codeListing","syntax":"swift"},{"text":"2. Gradient Boosted Decision Trees (GBDT)","level":2,"type":"heading","anchor":"2-Gradient-Boosted-Decision-Trees-GBDT"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GradientBoostingClassifier"},{"text":" sequentially trains decision trees to minimize pseudo-residuals using gradient descent in function space:","type":"text"}]},{"code":["let gbdt = try GradientBoostingClassifier(","    nEstimators: 50,","    learningRate: 0.1,","    maxDepth: 5",")","","try await gbdt.fit(features: X_train, targets: y_train)"],"type":"codeL