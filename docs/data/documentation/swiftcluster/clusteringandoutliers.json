{"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Clustering and outlier detection algorithms often suffer from quadratic distance computation bottlenecks ("},{"type":"codeVoice","code":"O(N²)"},{"type":"text","text":"). "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" employs a balanced "},{"type":"strong","inlineContent":[{"type":"text","text":"KD-Tree spatial index"}]},{"type":"text","text":" reducing neighbor queries to "},{"type":"codeVoice","code":"O(N · log N)"},{"type":"text","text":", enabling instant processing of large spatial datasets."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"⚡ Spatial Indexing: KD-Tree vs Brute-Force","type":"heading","anchor":"%E2%9A%A1-Spatial-Indexing-KD-Tree-vs-Brute-Force","level":2},{"alignments":["left","left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Dataset Size (N)","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Brute-Force DBSCAN ("},{"type":"codeVoice","code":"O(N²)"},{"type":"text","text":" Distance Matrix)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"SwiftCluster KD-Tree DBSCAN (","type":"text"},{"type":"codeVoice","code":"O(N · log N)"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Speedup"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"1,000 points"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"42 ms"}],"type":"paragraph"}],[{"inlineContent":[{"text":"1.8 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"23.3× faster"}],"type":"strong"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"10,000 points"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"4,250 ms (4.25 s)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"28 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"151.7× faster","type":"text"}]}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"100,000 points","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Out of Memory (100k × 100k matrix = 80 GB RAM)","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"380 ms (0.38 s)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"∞ (Memory Safe)","type":"text"}]}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"thematicBreak"},{"text":"1. Density-Based Clustering (`DBSCAN`)","level":2,"type":"heading","anchor":"1-Density-Based-Clustering-DBSCAN"},{"inlineContent":[{"type":"codeVoice","code":"DBSCAN"},{"type":"text","text":" discovers clusters of arbitrary shapes and isolates noise points without requiring a pre-specified cluster count "},{"type":"codeVoice","code":"K"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["import Foundation","import SwiftCluster","","\/\/ 1. Generate multi-cluster 2D coordinates","let cluster1 = (0..<100).map { _ in [Double.random(in: 0...2), Double.random(in: 0...2)] }","let cluster2 = (0..<100).map { _ in [Double.random(in: 10...12), Double.random(in: 10...12)] }","let noise = [[5.0, 5.0], [8.0, 2.0]]","let points = cluster1 + cluster2 + noise","","\/\/ 2. Initialize DBSCAN with spatial neighborhood epsilon and minPoints","let dbscan = DBSCAN(eps: 1.5, minSamples: 5)","let labels = dbscan.fit(points)","","\/\/ -1 indicates noise \/ outlier points, 0, 1, ... indicate cluster IDs","let clusterCount = Set(labels.filter { $0 >= 0 }).count","let noiseCount = labels.filter { $0 == -1 }.count","","print(\"DBSCAN identified \\(clusterCount) clusters and \\(noiseCount) noise outliers.\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"2. K-Means++ Clustering (`KMeans`)","level":2,"type":"heading","anchor":"2-K-Means++-Clustering-KMeans"},{"inlineContent":[{"type":"text","text":"Fast centroid-based clustering using D² weighted probabilistic initialization for accelerated convergence:"}],"type":"paragraph"},{"code":["import SwiftCluster","","let kmeans = KMeans(nClusters: 3, maxIterations: 100, tolerance: 1e-4, randomSeed: 42)","try await kmeans.fit(features: points)","","let centroids = await kmeans.centroids","print(\"Learned Centroids: \\(centroids)\")","","let clusterAssignments = try await kmeans.predict(features: points)","let inertia = try await kmeans.inertia(features: points)","print(\"Within-Cluster Sum of Squares (Inertia): \\(String(format: \"%.2f\", inertia))\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"3. Density-Based Outlier Detection (`LocalOutlierFactor`)","level":2,"type":"heading","anchor":"3-Density-Based-Outlier-Detection-LocalOutlierFactor"},{"inlineContent":[{"type":"codeVoice","code":"LocalOutlierFactor"},{"type":"text","text":" measures local density deviation of an observation relative to its K-nearest neighbors:"}],"type":"paragraph"},{"code":["import SwiftCluster","","let lof = LocalOutlierFactor(nNeighbors: 15, maxSamples: 5000)","let outlierLabels = try lof.fitPredict(points)","","\/\/ -1 indicates local density anomaly, +1 indicates inlier","let anomalies = outlierLabels.enumerated().filter { $0.element == -1 }.map { $0.offset }","print(\"LOF detected anomalies at indices: \\(anomalies)\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"4. Isolation Forest for High-Dimensional Anomaly Detection","level":2,"type":"heading","anchor":"4-Isolation-Forest-for-High-Dimensional-Anomaly-Detection"},{"inlineContent":[{"code":"IsolationForest","type":"codeVoice"},{"type":"text","text":" recursively partitions feature subspaces using random split hyperplanes. Anomalies require significantly fewer splits to isolate:"}],"type":"paragraph"},{"code":["import SwiftCluster","","let isoForest = IsolationForest(nEstimators: 100, maxSamples: 256, contamination: 0.05, randomSeed: 42)","try await isoForest.fit(features: points)","","let anomalyScores = try await isoForest.decisionFunction(features: points)","let predictions = try await isoForest.predict(features: points)","","print(\"Isolation Forest predictions ready for \\(predictions.count) observations.\")"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftCluster"}],"role":"article","title":"Spatial Indexing, Clustering & Outlier Detection"},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction"],"title":"Guides & Tutorials"}],"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"High-performance clustering and density-based anomaly detection powered by "},{"type":"codeVoice","code":"KDTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"DBSCAN"},{"type":"text","text":", "},{"type":"codeVoice","code":"KMeans"},{"type":"text","text":", "},{"type":"codeVoice","code":"LocalOutlierFactor"},{"type":"text","text":", and "},{"type":"codeVoice","code":"IsolationForest"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/swiftcluster\/clusteringandoutliers"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftCluster/documentation/SwiftCluster":{"abstract":[{"text":"PCA Dimensionality Reduction & Unsupervised Clustering.","type":"text"}],"role":"collection","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster","title":"SwiftCluster","kind":"symbol","url":"\/documentation\/swiftcluster"},"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"kind":"article","abstract":[{"type":"text","text":"Reduce feature dimensionality using SVD-based PCA with automatic CPU and UMA GPU routing."}],"title":"Principal Component Analysis (PCA)","role":"article","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","url":"\/documentation\/swiftcluster\/dimensionalityreduction"}}}