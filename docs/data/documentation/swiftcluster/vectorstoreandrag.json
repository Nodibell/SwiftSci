{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Vector databases are essential for modern semantic search and AI agent knowledge retrieval. ","type":"text"},{"code":"SwiftCluster","type":"codeVoice"},{"text":" provides ","type":"text"},{"code":"VectorStore","type":"codeVoice"},{"text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations (","type":"text"},{"code":"vDSP_dotprD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_svesqD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_distancesqD","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"level":2,"text":"1. Creating a VectorStore","type":"heading","anchor":"1-Creating-a-VectorStore"},{"code":["import SwiftCluster","import SwiftNLP","","\/\/ Initialize vector store with Cosine Similarity","let store = VectorStore(metric: .cosineSimilarity)","","\/\/ Generate dense text embeddings","let engine = LocalEmbeddingEngine(dimension: 128)","","let articles = [","    (id: \"art_1\", title: \"Apple Silicon Architecture\", text: \"Unified memory and neural engine overview\"),","    (id: \"art_2\", title: \"Swift Strict Concurrency\", text: \"Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"2. Top-K Semantic Search","type":"heading","anchor":"2-Top-K-Semantic-Search"},{"code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"3. Supported Metrics","type":"heading","anchor":"3-Supported-Metrics"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".cosineSimilarity","type":"codeVoice"}]},{"type":"text","text":": Ideal for normalized text embeddings (returns "},{"type":"codeVoice","code":"[-1.0, 1.0]"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".dotProduct","type":"codeVoice"}],"type":"strong"},{"text":": Direct inner product for unnormalized projections.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".euclideanDistance"}],"type":"strong"},{"type":"text","text":": Geometric L2 distance for spatial clustering."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcluster\/vectorstoreandrag"]}],"metadata":{"modules":[{"name":"SwiftCluster"}],"role":"collectionGroup","roleHeading":"API Collection","title":"In-Memory VectorStore & On-Device RAG"},"abstract":[{"type":"text","text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate."}],"kind":"article","topicSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"],"anchor":"Vector-Store-Types","title":"Vector Store Types"}],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/Dimensiona