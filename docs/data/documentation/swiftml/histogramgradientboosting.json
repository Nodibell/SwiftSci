 ML"},"doc://SwiftML/documentation/SwiftML/EnsembleLearning":{"kind":"article","role":"collectionGroup","abstract":[{"type":"text","text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism."}],"title":"Ensemble Learning: Random Forests & Gradient Boosted Trees","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","url":"\/documentation\/swiftml\/ensemblelearning"},"doc://SwiftML/documentation/SwiftML/HistTreeNode":{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode","url":"\/documentation\/swiftml\/histtreenode","type":"topic","abstract":[{"type":"text","text":"A node in a histogram-binned decision tree."}],"navigatorTitle":[{"kind":"identifier","text":"HistTreeNode"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistTreeNode"}],"kind":"symbol","title":"HistTreeNode"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingClassifier":{"url":"\/documentation\/swiftml\/histgradientboostingclassifier","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","type":"topic","abstract":[{"type":"text","text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular classification."}],"navigatorTitle":[{"text":"HistGradientBoostingClassifier","kind":"identifier"}],"role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistGradientBoostingClassifier","kind":"identifier"}],"kind":"symbol","title":"HistGradientBoostingClassifier"},"doc://SwiftML/documentation/SwiftML/PreparedRegression":{"title":"Prepared regression","url":"\/documentation\/swiftml\/preparedregression","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","role":"article","type":"topic","kind":"article","abstract":[{"text":"Fit and predict from compact numeric columns without constructing nested row arrays in 