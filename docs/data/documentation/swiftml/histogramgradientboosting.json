{"kind":"article","sections":[],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Traditional gradient boosted decision trees (GBDT) evaluate continuous threshold candidates by sorting or scanning exact values across all samples at every tree node. When datasets grow large, sorting becomes a major performance bottleneck.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"HistGradientBoostingClassifier","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"HistGradientBoostingRegressor","type":"codeVoice"},{"text":" implement histogram-based split optimization (inspired by LightGBM and scikit-learn’s ","type":"text"},{"code":"HistGradientBoostingClassifier","type":"codeVoice"},{"text":"). Continuous feature columns are pre-binned into at most 256 integer bins (","type":"text"},{"type":"codeVoice","code":"UInt8"},{"text":").","type":"text"}]},{"text":"Algorithmic Architecture","type":"heading","anchor":"Algorithmic-Architecture","level":2},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Pre-Binning (Quantization)","type":"text"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"Feature quantiles are evaluated once before boosting begins, establishing up to 256 discrete bins per feature column. All feature values are mapped to compact ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":" memory arrays.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"One-Pass Histogram Accumulation","type":"text"}]},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"For any internal tree node, first-order negative gradients (g_i) and second-order Hessians (h_i) are accumulated into flat 256-bin histograms in an (O(N_{\\text{node}} \\cdot p)) linear pass over the node’s samples:","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"$$G[k] = \\sum_{i: b_i = k} g_i, \\quad H[k] = \\sum_{i: b_i = k} h_i$$"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Histogram-Bin Split Scan","type":"text"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"Once histograms are built, evaluating all candidate thresholds scans only the (K \\le 256) populated bins per feature ((O(K \\cdot p))), rather than re-sorting (N_{\\text{node}}) continuous values:","type":"text"},{"text":" ","type":"text"},{"text":"$$\\text{Gain} = \\frac{1}{2} \\left[ \\frac{G_L^2}{H_L + \\lambda} + \\frac{G_R^2}{H_R + \\lambda} - \\frac{G_{\\text{tot}}^2}{H_{\\text{tot}} + \\lambda} \\right]$$","type":"text"}],"type":"paragraph"}]}]},{"code":["Continuous Floats [0.14, 0.92, -0.45] ──► Pre-Binning ──► UInt8 Bins [32, 215, 12]","                                                                  │  O(N_node · p) build","                                                                  ▼","Node Split Scan: O(K · p), K <= 256 ◄─── Accumulated Histograms G[k], H[k]"],"type":"codeListing","syntax":null},{"text":"Example Usage","type":"heading","anchor":"Example-Usage","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftML","","let clf = try HistGradientBoostingClassifier(","    nEstimators: 50,","    learningRate: 0.1,","    maxDepth: 6,","    maxBins: 256,","    minSamplesLeaf: 10",")","","try await clf.fit(features: X_train, targets: y_train)","let predictions = try await clf.predict(features: X_test)","let probabilities = try await clf.predictProbability(features: X_test)"]}],"kind":"content"}],"metadata":{"modules":[{"name":"SwiftML"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Fast Tabular Learning with Histogram Gradient Boosting"},"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","interfaceLanguage":"swift"},"abstract":[{"text":"Discretize continuous feature distributions into up to 256 compact bins (","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":") so tree-node split gain scans take $O(K \\cdot p)$ time over $K \\le 256$ bins after an $O(N_{\\text{node}} \\cdot p)$ histogram accumulation pass.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode"],"title":"Estimators","anchor":"Estimators"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedClassification","doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLInference","doc:\/\/SwiftML\/documentation\/SwiftML\/BoundedInference","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","doc:\/\/SwiftML\/documentation\/SwiftML\/ReusableCPUPrediction"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/histogramgradientboosting"]}],"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"references":{"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"role":"article","url":"\/documentation\/swiftml\/supervisedclassifiers","title":"Supervised Classification Models","abstract":[{"text":"Train classification models using LogisticRegression, DecisionTreeClassifier, RandomForestClassifier, and MLPClassifier.","type":"text"}],"kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","type":"topic"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingClassifier":{"abstract":[{"type":"text","text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular classification."}],"role":"symbol","url":"\/documentation\/swiftml\/histgradientboostingclassifier","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistGradientBoostingClassifier"}],"type":"topic","title":"HistGradientBoostingClassifier","navigatorTitle":[{"kind":"identifier","text":"HistGradientBoostingClassifier"}]},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingRegressor":{"kind":"symbol","type":"topic","abstract":[{"text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular regression.","type":"text"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","navigatorTitle":[{"kind":"identifier","text":"HistGradientBoostingRegressor"}],"title":"HistGradientBoostingRegressor","url":"\/documentation\/swiftml\/histgradientboostingregressor","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistGradientBoostingRegressor"}]},"doc://SwiftML/documentation/SwiftML/PreparedRegression":{"abstract":[{"text":"Fit and predict from compact numeric columns without constructing nested row arrays in the StandardScaler and LinearRegression path.","type":"text"}],"role":"article","url":"\/documentation\/swiftml\/preparedregression","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","kind":"article","type":"topic","title":"Prepared regression"},"doc://SwiftML/documentation/SwiftML/CoreMLPredictor":{"kind":"symbol","type":"topic","abstract":[{"text":"Runs compiled Core ML regression, vector, or fixed matrix models on prepared columns.","type":"text"}],"