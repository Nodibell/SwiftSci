{"variants":[{"paths":["\/documentation\/swiftvision\/realtimeyoloinference"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/RealTimeYOLOInference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"metadata":{"modules":[{"name":"SwiftVision"}],"role":"article","title":"Real-Time YOLOv8 Object Detection & Hardware Acceleration","roleHeading":"Article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","abstract":[{"type":"text","text":"Execute real-time anchor-free object detection on Apple Silicon GPU and Neural Engine using "},{"type":"codeVoice","code":"YOLOv8Detector"},{"type":"text","text":", "},{"type":"codeVoice","code":"YOLOPreprocessor"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ImageDataset"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftVision"},{"type":"text","text":" implements the full "},{"type":"strong","inlineContent":[{"type":"text","text":"YOLOv8"}]},{"type":"text","text":" deep learning architecture in native Swift and MLX. The pipeline combines Apple Accelerate "},{"type":"codeVoice","code":"vImageScale_PlanarF"},{"type":"text","text":" for bilinear letterbox scaling, deep CSPDarknet backbone evaluation, decoupled PANet feature pyramid routing, and anchorless box decoding with Non-Maximum Suppression (NMS)."}]},{"type":"codeListing","syntax":null,"code":["Input Image (RGB \/ File \/ CVPixelBuffer)","               │","               ▼","┌────────────────────────────────────────┐","│ Apple Accelerate vImage Letterbox      │ ───► Resizes to 640x640 with (114, 114, 114) padding","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOBackbone (CSPDarknet + SPPF)       │ ───► P3, P4, P5 multi-scale feature maps","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLONeck (PANet Feature Pyramid)       │ ───► Top-down & bottom-up cross-scale fusion","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOHead (Decoupled Class & Box DFL)   │ ───► 8,400 raw candidate anchor predictions","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ Vectorized Non-Maximum Suppression     │ ───► Final BoundingBoxes with class IDs & confidences","└────────────────────────────────────────┘"]},{"type":"thematicBreak"},{"type":"heading","anchor":"1-Loading-Weights-and-Executing-Detection","text":"1. Loading Weights and Executing Detection","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Load pre-trained "},{"type":"codeVoice","code":".onnx"},{"type":"text","text":" or "},{"type":"codeVoice","code":".safetensors"},{"type":"text","text":" model weights and detect objects:"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftVision","","\/\/ 1. Initialize YOLOv8 detector from model weights file","let modelURL = URL(fileURLWithPath: \"yolov8n.onnx\")","let detector = try YOLOv8Detector(weightsURL: modelURL)","","\/\/ 2. Perform object detection on an image file","let imageURL = URL(fileURLWithPath: \"street_scene.jpg\")","let detections = try await detector.detect(","    imageURL: imageURL,","    confidenceThreshold: 0.4,","    iouThreshold: 0.45",")","","print(\"=== YOLOv8 Detection Results ===\")","for box in detections {","    let rect = box.rect","    print(\"Class: '\\(box.className)' (ID: \\(box.classId)) | Confidence: \\(String(format: \"%.2f%%\", box.confidence * 100)) | Box: [x=\\(rect.minX), y=\\(rect.minY), w=\\(rect.width), h=\\(rect.height)]\")","}"]},{"type":"thematicBreak"},{"type":"heading","anchor":"2-Hardware-Accelerated-Letterbox-Preprocessing-vImage","text":"2. Hardware-Accelerated Letterbox Preprocessing (`vImage`)","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"YOLOPreprocessor"},{"type":"text","text":" uses Apple Accelerate’s "},{"code":"vImageScale_PlanarF","type":"codeVoice"},{"type":"text","text":" with "},{"code":"kvImageHighQualityResampling","type":"codeVoice"},{"type":"text","text":", performing aspect-ratio preserving downsampling directly in hardware:"}]},{"code":["import SwiftVision","","\/\/ Preprocess raw image buffer into normalized Float32 planar tensor","let inputImage = URL(fileURLWithPath: \"input_1920x1080.jpg\")","let (tensorBuffer, scaleFactor, padX, padY) = try YOLOPreprocessor.preprocess(","    imageURL: inputImage,","    targetSize: (width: 640, height: 640)",")","","print(\"Preprocessed tensor count: \\(tensorBuffer.count) Float elements.\")","print(\"Scale Factor: \\(scaleFactor), Padding: (\\(padX), \\(padY))\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"text":"3. Training & Batching Image Datasets","anchor":"3-Training--Batching-Image-Datasets","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Load and normalize computer vision datasets in compact "},{"code":"Float32","type":"codeVoice"},{"type":"text","text":" tensors:"}],"type":"paragraph"},{"code":["let dataset = try ImageDataset(","    directoryURL: URL(fileURLWithPath: \"coco_val2017\/\"),","    targetSize: (width: 256, height: 256),","    normalize: true",")","","print(\"Loaded \\(dataset.count) images. Memory per image: \\(dataset.data.count * 4 \/ 1024) KB.\")"],"syntax":"swift","type":"codeListing"}]}],"references":{"doc://SwiftVision/documentation/SwiftVision":{"url":"\/documentation\/swiftvision","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision","title":"SwiftVision","role":"collection","type":"topic","kind":"symbol","abstract":[{"text":"Computer Vision Neural Inference, Object Detection & Image Datasets.","type":"text"}]}}}