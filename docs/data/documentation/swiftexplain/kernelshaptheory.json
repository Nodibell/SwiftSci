{"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory","interfaceLanguage":"swift"},"metadata":{"title":"Game-Theoretic Interpretability with Kernel SHAP","roleHeading":"API Collection","modules":[{"name":"SwiftExplain"}],"role":"collectionGroup"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"SHAP (SHapley Additive exPlanations)"}],"type":"strong"},{"text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory.","type":"text"}]},{"level":2,"text":"1. The Four Shapley Axioms","type":"heading","anchor":"1-The-Four-Shapley-Axioms"},{"inlineContent":[{"text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Efficiency"}]},{"type":"text","text":": Feature attributions sum up to the difference between model prediction "},{"type":"codeVoice","code":"f(x)"},{"type":"text","text":" and expected background prediction "},{"code":"E[f(X)]","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Symmetry"}],"type":"strong"},{"text":": If two features contribute equally to all possible feature subsets, their attributions are equal.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Dummy (Null Player)","type":"text"}]},{"type":"text","text":": A feature that does not change the model prediction for any coalition receives an attribution of zero ("},{"type":"codeVoice","code":"φ_i = 0"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Additivity","type":"text"}],"type":"strong"},{"type":"text","text":": For ensemble models "},{"type":"codeVoice","code":"f = f1 + f2"},{"type":"text","text":", attributions satisfy "},{"code":"φ_i(f) = φ_i(f1) + φ_i(f2)","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"level":2,"text":"2. Explaining Predictions in SwiftSci","type":"heading","anchor":"2-Explaining-Predictions-in-SwiftSci"},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftexplain\/kernelshaptheory"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"kind":"article","sections":[],"abstract":[{"text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"anchor":"SHAP-Explainer-APIs","title":"SHAP Explainer APIs"}],"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KernelSHAP"}],"title":"KernelSHAP","type":"topic","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}],"kind":"symbol","url":"\/documentation\/swiftexplain\/kernelshap","abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}]},"doc://SwiftExplain/documentation/SwiftExplain":{"title":"SwiftExplain","kind":"symbol","url":"\/documentation\/swiftexplain","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"type":"topic","role":"collection"}}}