{"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AutonomousDataAnalyst","interfaceLanguage":"swift"},"sections":[],"metadata":{"title":"Autonomous Data Analysis Agents & ReAct Reasoning Loops","role":"article","roleHeading":"Article","modules":[{"name":"SwiftAgent"}]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"code":"SwiftAgent","type":"codeVoice"},{"text":" implements an agentic reasoning loop based on the ","type":"text"},{"inlineContent":[{"text":"ReAct (Reason + Act)","type":"text"}],"type":"strong"},{"text":" paradigm. The agent iteratively reasons about a user query, selects analytical tools via fuzzy matching, inspects sandboxed observations, and returns structured data insights.","type":"text"}],"type":"paragraph"},{"code":["                      User Prompt","                           │","                           ▼","          ┌──────────────────────────────────┐","     ┌───►│ Thought: Analyze missing values  │","     │    └────────────────┬─────────────────┘","     │                     ▼","     │    ┌──────────────────────────────────┐","     │    │ Action: Run 'data_summary' tool  │","     │    └────────────────┬─────────────────┘","     │                     ▼","     │    ┌──────────────────────────────────┐","ReAct│    │ Fuzzy Tool Resolution            │","Loop │    │ (handles typos\/case\/spacing)     │","     │    └────────────────┬─────────────────┘","     │                     ▼","     │    ┌──────────────────────────────────┐","     │    │ Observation: 120 rows, 4 columns │","     │    └────────────────┬─────────────────┘","     │                     │","     └─────────────────────┘ (Repeat until final answer)","                           │","                           ▼","                     Final Answer"],"syntax":null,"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"1-Running-an-Autonomous-ReAct-Agent","text":"1. Running an Autonomous ReAct Agent"},{"inlineContent":[{"text":"Configure a ","type":"text"},{"code":"ReActAgent","type":"codeVoice"},{"text":" with custom tools and an LLM generation closure:","type":"text"}],"type":"paragraph"},{"code":["import Foundation","import SwiftAgent","import SwiftDataFrame","","\/\/ 1. Prepare sample dataset","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"department\", values: [\"Engineering\", \"Sales\", \"Engineering\", \"Marketing\"]),","    TypedColumn<Double>(name: \"salary\", values: [120000.0, 95000.0, 135000.0, 85000.0])","])","","\/\/ 2. Define analytical tools","let summaryTool = CustomAgentTool(","    name: \"dataset_summary\",","    description: \"Returns row count and column data types of the DataFrame.\"",") { _ in","    return \"DataFrame has \\(df.shape.rows) rows and \\(df.shape.columns) columns: [department: String, salary: Double]\"","}","","\/\/ 3. Mock LLM reasoning response closure","let llmModel: @Sendable (String) async throws -> String = { prompt in","    if prompt.contains(\"Action:\") {","        return \"Thought: I need to inspect the dataset summary.\\nAction: dataset_summary\\nAction Input: {}\\n\"","    } else {","        return \"Thought: I have the information.\\nFinal Answer: The dataset contains 4 employee records across Engineering, Sales, and Marketing.\"","    }","}","","\/\/ 4. Initialize and execute the ReAct Agent","let agent = ReActAgent(","    tools: [summaryTool],","    llm: llmModel,","    maxSteps: 5",")","","let trajectory = try await agent.run(question: \"How many employees are in the dataset?\")","","print(\"=== Agent Trajectory Completed ===\")","print(\"Final Answer: \\(trajectory.finalAnswer)\")","print(\"Total Steps Executed: \\(trajectory.steps.count)\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"2. Sandboxed Command Interpretation (`SwiftAgentEvaluator`)","type":"heading","anchor":"2-Sandboxed-Command-Interpretation-SwiftAgentEvaluator","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Safely evaluate structured AST commands without arbitrary code execution vulnerabilities:"}]},{"code":["import SwiftAgent","","let evaluator = SwiftAgentEvaluator(dataFrame: df)","","\/\/ 1. Parse and execute pipeline commands","let filtered = try evaluator.execute(\"filter salary > 100000\")","print(\"Filtered count: \\(filtered.shape.rows) employees with salary > $100k.\")","","\/\/ 2. GroupBy aggregation","let grouped = try evaluator.execute(\"groupby department\")","print(\"Department groupings: \\(grouped.shape.rows) rows.\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"3. Tool Parameter Schema Validation & Error Resilience","type":"heading","anchor":"3-Tool-Parameter-Schema-Validation--Error-Resilience","level":2},{"text":"Defining Structured Tool Schemas","type":"heading","anchor":"Defining-Structured-Tool-Schemas","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tools implementing "},{"type":"codeVoice","code":"AgentTool"},{"type":"text","text":" define their expected parameters using "},{"type":"codeVoice","code":"AgentParameterSchema"},{"type":"text","text":":"}]},{"code":["import SwiftAgent","","let mathTool = CustomAgentTool(","    name: \"calculator\",","    description: \"Evaluates mathematical expressions.\",","    schema: AgentParameterSchema(","        properties: [","            \"expression\": AgentParameterProperty(","                type: \"string\",","                description: \"Arithmetic expression to evaluate (e.g. '2 + 2')\"","            )","        ],","        required: [\"expression\"]","    )",") { args in","    guard let expr = args[\"expression\"] else {","        throw AgentError.invalidInput(\"Missing 'expression'\")","    }","    return \"Result of \\(expr): 4\"","}"],"type":"codeListing","syntax":"swift"},{"text":"Self-Correction & Reasoning Loop Resilience","type":"heading","anchor":"Self-Correction--Reasoning-Loop-Resilience","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the language model generates malformed JSON syntax or omits mandatory parameters, "},{"type":"codeVoice","code":"ReActAgent"},{"type":"text","text":" validates the payload against "},{"type":"codeVoice","code":"AgentParameterSchema"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Instead of terminating the program or throwing unhandled errors, ","type":"text"},{"type":"codeVoice","code":"ReActAgent"},{"text":" captures ","type":"text"},{"type":"codeVoice","code":"SchemaValidationError"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The validation error description (e.g. "},{"type":"codeVoice","code":"\"Error: Malformed tool call: Missing required parameter 'expression'. Please correct the parameters and retry.\""},{"type":"text","text":") is captured as the tool’s "},{"type":"codeVoice","code":"observation"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This feedback is injected into the subsequent prompt step, empowering the LLM to autonomously correct its parameters and retry on the next reasoning turn."}]}]}]}]}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"abstract":[{"type":"text","text":"Build autonomous, sandboxed AI agents that analyze "},{"code":"SwiftDataFrame","type":"codeVoice"},{"type":"text","text":" tables, execute statistical aggregations, and resolve tools using fuzzy matching."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/autonomousdataanalyst"]}],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"kind":"symbol","role":"collection","url":"\/documentation\/swiftagent","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","abstract":[{"text":"Agentic REPL Execution Sandbox & RAG Summary Engine.","type":"text"}],"title":"SwiftAgent","type":"topic"}}}