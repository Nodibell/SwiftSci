{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In real-time computer vision models such as YOLO, post-processing can generate tens of thousands of candidate detections per frame. Standard bounding box objects with heap-allocated "},{"type":"codeVoice","code":"String"},{"type":"text","text":" class names induce significant ARC and memory allocation overhead."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftVision"},{"type":"text","text":" introduces "},{"type":"reference","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBoxSIMD","isActive":true},{"type":"text","text":":"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Zero-Heap Value Representation"}],"type":"strong"},{"type":"text","text":": Encapsulates bounding coordinates in hardware "},{"type":"codeVoice","code":"SIMD4<Float>"},{"type":"text","text":" registers and replaces strings with integer "},{"type":"codeVoice","code":"classId: Int32"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Accelerated Vector IoU"}],"type":"strong"},{"type":"text","text":": Computes intersection, union, and clamping entirely within SIMD registers without memory allocations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"High-Throughput NMS"}],"type":"strong"},{"type":"text","text":": Provides "},{"isActive":true,"identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/NonMaximumSuppression\/filter(boxes:iouThreshold:scoreThreshold:)-5ernf","type":"reference"},{"type":"text","text":" operating directly on SIMD bounding boxes."}]}]}]},{"text":"Usage Example","type":"heading","anchor":"Usage-Example","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftVision","","\/\/ Create candidates using SIMD coordinates:","let candidate = BoundingBoxSIMD(","    xMin: 12.5, yMin: 34.0,","    xMax: 150.0, yMax: 220.0,","    confidence: 0.92,","    classId: 0 \/\/ e.g. \"person\"",")","","\/\/ Filter detections with zero-heap NMS:","let detections = NonMaximumSuppression.filter(","    boxes: candidates,","    iouThreshold: 0.45,","    scoreThreshold: 0.25",")"]}],"kind":"content"}],"abstract":[{"text":"Hardware-accelerated zero-heap bounding box processing and Non-Maximum Suppression (NMS) for real-time vision pipelines.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftVision"}],"role":"collectionGroup","title":"Object Detection Optimizations & SIMD Bounding Boxes"},"identifier":{"url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/ObjectDetectionOptimizations","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftvision\/objectdetectionoptimizations"]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBoxSIMD","doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBox","doc:\/\/SwiftVision\/documentation\/SwiftVision\/NonMaximumSuppression"],"anchor":"Structures","title":"Structures"}],"references":{"doc://SwiftVision/documentation/SwiftVision/BoundingBox":{"type":"topic","abstract":[{"type":"text","text":"Bounding box representation for object detection."}],"kind":"symbol","role":"symbol","url":"\/documentation\/swiftvision\/boundingbox","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"BoundingBox"}],"identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBox","title":"BoundingBox","navigatorTitle":[{"kind":"identifier","text":"BoundingBox"}]},"doc://SwiftVision/