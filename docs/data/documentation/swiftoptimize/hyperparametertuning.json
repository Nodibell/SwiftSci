{"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Automate model exploration and parameter optimization with "},{"type":"codeVoice","code":"GridSearchCV"},{"type":"text","text":", "},{"type":"codeVoice","code":"RandomizedSearchCV"},{"type":"text","text":", and the intelligent "},{"type":"codeVoice","code":"AutoML"},{"type":"text","text":" model selector."}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Finding the optimal combination of hyperparameters is critical for maximizing generalization accuracy. "},{"type":"codeVoice","code":"SwiftOptimize"},{"type":"text","text":" provides exhaustive grid search, randomized sampling for high-dimensional parameter spaces, and end-to-end "},{"type":"codeVoice","code":"AutoML"},{"type":"text","text":" selection across multiple model families."}]},{"type":"thematicBreak"},{"type":"heading","anchor":"1-AutoML-Automated-Model--Parameter-Selection","text":"1. AutoML — Automated Model & Parameter Selection","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AutoML"},{"type":"text","text":" evaluates candidate model architectures (Decision Trees, Random Forests, Logistic Regression, Linear Regression, and Multi-Layer Perceptrons) using cross-validation, ranking candidates by performance metrics (F1-score for classification, R² for regression)."}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftOptimize","import SwiftML","","\/\/ 1. Synthetic classification dataset","let N = 120","let D = 4","let X = (0..<N).map { i in","    (0..<D).map { d in Double(i * D + d) * 0.05 + sin(Double(i + d)) }","}","let y = (0..<N).map { i in i % 2 }","","\/\/ 2. Configure AutoML with 3-fold cross validation","let autoML = AutoML(","    task: .classification,","    timeLimitSeconds: 30,","    cvFolds: 3,","    metric: \"f1\"",")","","\/\/ 3. Train and select the optimal estimator","let result = try await autoML.fit(features: X, targets: y)","","print(\"=== AutoML Optimization Results ===\")","print(\"Selected Best Model: \\(result.bestModelName)\")","print(\"Validation F1 Score: \\(String(format: \"%.4f\", result.bestScore))\")","print(\"Tuned Hyperparameters: \\(result.bestParameters)\")","","\/\/ 4. Run inference directly on new test samples","let newSample = [0.5, 1.2, 0.3, 0.8]","let testPrediction = try await result.bestEstimator.predict(features: [newSample])","print(\"Prediction: \\(testPrediction)\")"]},{"type":"thematicBreak"},{"type":"heading","anchor":"2-Exhaustive-Grid-Search-GridSearchCV","text":"2. Exhaustive Grid Search (`GridSearchCV`)","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GridSearchCV"},{"type":"text","text":" exhaustively tests all Cartesian combinations of hyperparameter discrete values."}]},{"type":"codeListing","syntax":"swift","code":["import SwiftOptimize","import SwiftML","","\/\/ Define hyperparameter search grid for DecisionTreeClassifier","let paramGrid: [String: [Any]] = [","    \"maxDepth\": [3, 5, 8],","    \"minSamplesSplit\": [2, 5, 10],","    \"criterion\": [\"gini\", \"entropy\"]","]","","let gridSearch = GridSearchCV(","    estimator: DecisionTreeClassifier(maxDepth: 3),","    paramGrid: paramGrid,","    cv: 5,","    scoring: .accuracy",")","","try await gridSearch.fit(features: X, targets: y)","","if let bestParams = gridSearch.bestParams {","    print(\"Optimal Depth: \\(bestParams[\"maxDepth\"] ?? \"default\")\")","    print(\"Peak CV Accuracy: \\(String(format: \"%.4f\", gridSearch.bestScore ?? 0.0))\")","}"]},{"type":"thematicBreak"},{"type":"heading","anchor":"3-Randomized-Search-RandomizedSearchCV","text":"3. Randomized Search (`RandomizedSearchCV`)","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When searching through large continuous or discrete combinatorial spaces, "},{"type":"codeVoice","code":"RandomizedSearchCV"},{"type":"text","text":" samples $N$ random configurations, finding near-optimal solutions in a fraction of the compute time."}]},{"type":"codeListing","syntax":"swift","code":["import SwiftOptimize","import SwiftML","","let distributions: [String: [Any]] = [","    \"learningRate\": [0.001, 0.005, 0.01, 0.05, 0.1],","    \"epochs\": [100, 200, 500, 1000],","    \"l2Penalty\": [0.0, 0.0001, 0.001, 0.01]","]","","let randomSearch = RandomizedSearchCV(","    estimator: LogisticRegression(learningRate: 0.01),","    paramDistributions: distributions,","    nIter: 20,","    cv: 3,","    randomSeed: 42",")","","try await randomSearch.fit(features: X, targets: y)","print(\"Top Configuration Score: \\(randomSearch.bestScore ?? 0.0)\")"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftoptimize\/hyperparametertuning"]}],"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection"]}],"sections":[],"metadata":{"modules":[{"name":"SwiftOptimize"}],"roleHeading":"Article","role":"article","title":"Hyperparameter Tuning & AutoML Engine"},"identifier":{"url":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/HyperparameterTuning","interfaceLanguage":"swift"},"references":{"doc://SwiftOptimize/documentation/SwiftOptimize/ParallelModelSelection":{"role":"collectionGroup","title":"Concurrent Model Selection & Cross-Validation","abstract":[{"type":"text","text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency "},{"type":"codeVoice","code":"TaskGroup"},{"type":"text","text":" primitives."}],"url":"\/documentation\/swiftoptimize\/parallelmodelselection","kind":"article","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection","type":"topic"},"doc://SwiftOptimize/documentation/SwiftOptimize/CrossValidationFolds":{"type":"topic","kind":"article","title":"Cross-Validation Strategies","abstract":[{"text":"Evaluate model stability and generalization performance across dataset splits using ","type":"text"},{"code":"KFold","type":"codeVoice"},{"text":", ","type":"text"},{"code":"StratifiedKFold","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"TimeSeriesSplit"},{"text":".","type":"text"}],"role":"article","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","url":"\/documentation\/swiftoptimize\/crossvalidationfolds"},"doc://SwiftOptimize/documentation/SwiftOptimize":{"url":"\/documentation\/swiftoptimize","abstract":[{"type":"text","text":"AutoML, Cross-Validation Folds & Hyperparameter Tuning."}],"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize","title":"SwiftOptimize","role":"collection","kind":"symbol","type":"topic"}}}