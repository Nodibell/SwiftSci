{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/modelinterpretability"]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Explainable Artificial Intelligence (XAI) bridges the gap between predictive accuracy and decision transparency. "},{"type":"codeVoice","code":"SwiftExplain"},{"type":"text","text":" provides exact Shapley mathematical decomposition for tree-based models, local linear surrogate modeling with LIME, and model-agnostic permutation metrics."}]},{"type":"thematicBreak"},{"type":"heading","text":"📊 Explainability Methods Comparison","anchor":"%F0%9F%93%8A-Explainability-Methods-Comparison","level":2},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported Models"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Algorithmic Complexity"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Scope"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Recommendation"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"TreeSHAP","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DecisionTreeClassifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"DecisionTreeRegressor"},{"type":"text","text":", "},{"type":"codeVoice","code":"RandomForestClassifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"RandomForestRegressor"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(T · 2^K · L)"},{"type":"text","text":" exact ("},{"type":"codeVoice","code":"K ≤ 12"},{"type":"text","text":"); "},{"type":"codeVoice","code":"O(T · S · K · L)"},{"type":"text","text":" seeded MC ("},{"type":"codeVoice","code":"K > 12"},{"type":"text","text":", "},{"type":"codeVoice","code":"S = 2048"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local & Global"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Exact for ","type":"text"},{"code":"K ≤ 12","type":"codeVoice"},{"text":" distinct split features","type":"text"}]},{"type":"text","text":" using path-dependent uniform leaf weights ("},{"type":"codeVoice","code":"1.0"},{"type":"text","text":"). Does not support "},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"type":"text","text":" or per-class probability attributions in "},{"type":"codeVoice","code":"v3.13.x"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"KernelSHAP","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any black-box model (MLP, SVM, Ensembles)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(S · D²)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Universal Shapley attribution using weighted coalition sampling."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"LIME","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any black-box model (MLP, Vision, NLP)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(S · D)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Fast local surrogate.","type":"text"}]},{"type":"text","text":" Fits an interpretable weighted linear model around perturbations."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"PermutationImportance","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any model"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(D · N)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Global"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fast global feature ranking by measuring validation loss degradation upon feature column shuffling."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"PartialDependencePlot","type":"codeVoice"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Any model","type":"text"}]}],[{"inlineContent":[{"code":"O(G · N)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Global","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Visualizes marginal effect of 1 or 2 features across an evaluation grid.","type":"text"}]}]]],"alignments":["left","left","left","left","left"]},{"type":"thematicBreak"},{"type":"heading","text":"1. Path-Dependent TreeSHAP for Decision Trees & Random Forests","anchor":"1-Path-Dependent-TreeSHAP-for-Decision-Trees--Random-Forests","level":2},{"type":"paragraph","inlineContent":[{"code":"TreeSHAP","type":"codeVoice"},{"type":"text","text":" evaluates path-dependent conditional expectations over each tree’s leaves using uniform leaf weights ("},{"code":"1.0","type":"codeVoice"},{"text":"). When a tree splits on ","type":"text"},{"code":"K ≤ TreeSHAP.maxExactFeatures","type":"codeVoice"},{"text":" (","type":"text"},{"code":"12","type":"codeVoice"},{"type":"text","text":") distinct features, "},{"code":"TreeSHAP","type":"codeVoice"},{"type":"text","text":" enumerates all "},{"code":"2^K","type":"codeVoice"},{"text":" coalitions in ","type":"text"},{"code":"O(2^K · L)","type":"codeVoice"},{"type":"text","text":" time to compute exact Shapley values; when "},{"code":"K > 12","type":"codeVoice"},{"text":", it switches to deterministic seeded Monte Carlo permutation sampling (","type":"text"},{"type":"codeVoice","code":"approximationSamples = 2048"},{"text":"):","type":"text"}]},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Known limitations in ","type":"text"},{"code":"v3.13.x","type":"codeVoice"},{"text":" (deferred to a future release):","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"G-035 ("},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"type":"text","text":")"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"TreeSHAP"},{"text":" does not provide a ","type":"text"},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"type":"text","text":" adapter in "},{"type":"codeVoice","code":"v3.13.x"},{"text":" (","type":"text"},{"type":"codeVoice","code":"explainDetailed(trees:)"},{"type":"text","text":" computes an unweighted "},{"type":"codeVoice","code":"1\/T"},{"type":"text","text":" ensemble average rather than "},{"type":"codeVoice","code":"initialPrediction + learningRate * sum_m T_m(x)"},{"type":"text","text":"). Use "},{"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","isActive":true},{"text":" or ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","isActive":true},{"type":"text","text":" for GBDT models."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"G-036 (Classification & Leaf Weights)","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"FlatTreeNode"},{"type":"text","text":" does not store training sample counts ("},{"type":"codeVoice","code":"cover"},{"type":"text","text":"), so "},{"type":"codeVoice","code":"TreeSHAP"},{"type":"text","text":" weights all leaves uniformly ("},{"type":"codeVoice","code":"1.0"},{"text":"); ","type":"text"},{"type":"codeVoice","code":"RandomForestClassifier"},{"text":" trees do not populate ","type":"text"},{"type":"codeVoice","code":"classDistribution"},{"type":"text","text":" on leaves, and "},{"code":"DecisionTreeClassifier.prune(alpha:)","type":"codeVoice"},{"text":" clears ","type":"text"},{"code":"classDistribution","type":"codeVoice"},{"text":" on collapsed nodes. Consequently, classifier ","type":"text"},{"code":"TreeSHAP","type":"codeVoice"},{"type":"text","text":" attributes the scalar "},{"code":"node.value","type":"codeVoice"},{"text":" label code rather than per-class ","type":"text"},{"code":"predictProbability","type":"codeVoice"},{"type":"text","text":" distributions."}]}]}],"type":"unorderedList"}]},{"code":["import Foundation","import SwiftML","import SwiftExplain","","\/\/ 1. Train a Random Forest Classifier","let X = [[1.0, 2.0], [2.0, 1.0], [5.0, 4.0], [6.0, 5.0]]","let y = [0, 0, 1, 1]","","let forest = try RandomForestClassifier(nEstimators: 10, maxDepth: 4)","try await forest.fit(features: X, labels: y)","","\/\/ 2. Explain prediction on a target instance","let treeSHAP = TreeSHAP()","let instance = [5.5, 4.2]","","let shapValues = await treeSHAP.explain(randomForest: forest, instance: instance)","","print(\"=== TreeSHAP Feature Attributions ===\")","for (featureIdx, attribution) in shapValues.enumerated() {","    print(\"Feature \\(featureIdx): Contribution = \\(String(format: \"%+.4f\", attribution))\")","}"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"type":"heading","text":"2. Local Interpretable Model-agnostic Explanations (`LIME`)","anchor":"2-Local-Interpretable-Model-agnostic-Explanations-LIME","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LIMEExplainer"},{"text":" perturbs the neighborhood of a target sample using Box-Muller Gaussian noise, weights samples by an exponential distance kernel, and fits a weighted Ridge regression surrogate model:","type":"text"}]},{"type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Black-box model closure","let modelClosure: @Sendable ([Double]) async -> Double = { x in","    \/\/ Non-linear complex interaction","    return 3.0 * x[0] + sin(x[1] * 2.0) - 1.5 * x[2] * x[2] + 4.0","}","","let instance = [1.5, 0.8, -0.4]","","let lime = LIMEExplainer(kernelWidth: 0.75, regularization: 0.1)","let explanation = await lime.explain(","    model: modelClosure,","    instance: instance,","    numSamples: 500",")","","print(\"=== LIME Local Surrogate Explanation ===\")","print(\"Local Prediction: \\(String(format: \"%.4f\", explanation.prediction))\")","print(\"Surrogate Intercept: \\(String(format: \"%.4f\", explanation.intercept))\")","print(\"Local Goodness-of-Fit (R²): \\(String(format: \"%.2f%%\", explanation.localR2 * 100))\")","","for (d, weight) in explanation.featureWeights.enumerated() {","    print(\"Feature [\\(d)] Local Slope: \\(String(format: \"%+.4f\", weight))\")","}"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","anchor":"3-Global-Permutation-Feature-Importance","level":2,"text":"3. Global Permutation Feature Importance"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Measure global model dependence by quantifying score drop when a single feature column is randomly permuted:"}]},{"type":"codeListing","code":["import SwiftExplain","","let perm = PermutationImportance()","let importances = try await perm.computeImportance(","    features: X,","    targets: y.map(Double.init)",") { matrix in","    try await forest.predict(features: matrix).map(Double.init)","}","","print(\"=== Global Feature Importance Ranking ===\")","for (feat, score) in importances.sorted(by: { $0.value > $1.value }) {","    print(\"\\(feat): Importance Score = \\(String(format: \"%.4f\", score))\")","}"],"syntax":"swift"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability"},"abstract":[{"type":"text","text":"Understand black-box machine learning predictions using "},{"type":"codeVoice","code":"TreeSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"KernelSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"LIMEExplainer"},{"type":"text","text":", "},{"type":"codeVoice","code":"PermutationImportance"},{"type":"text","text":", and "},{"type":"codeVoice","code":"PartialDependencePlot"},{"type":"text","text":"."}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"Model Interpretability & XAI Guide","roleHeading":"Article","modules":[{"name":"SwiftExplain"}]},"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"type":"topic","title":"SwiftExplain","url":"\/documentation\/swiftexplain","role":"collection","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}],"kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain"},"doc://SwiftExplain/documentation/SwiftExplain/ShapleyAttributions":{"type":"topic","title":"SHAP & LIME Model Interpretability","url":"\/documentation\/swiftexplain\/shapleyattributions","role":"collectionGroup","abstract":[{"text":"Explain machine learning model predictions with game-theoretic Shapley value attributions (TreeSHAP, KernelSHAP) and local linear surrogates (LIME).","type":"text"}],"kind":"article","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions"},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"type":"topic","title":"KernelSHAP","url":"\/documentation\/swiftexplain\/kernelshap","role":"symbol","abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}],"kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"KernelSHAP"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}]},"doc://SwiftExplain/documentation/SwiftExplain/LIMEExplainer":{"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"LIMEExplainer"}],"navigatorTitle":[{"kind":"identifier","text":"LIMEExplainer"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","abstract":[{"type":"text","text":"Local Interpretable Model-agnostic Explanations (LIME)."}],"role":"symbol","type":"topic","title":"LIMEExplainer","url":"\/documentation\/swiftexplain\/limeexplainer","kind":"symbol"}}}