{"abstract":[{"type":"text","text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"metadata":{"modules":[{"name":"SwiftDataFrame"}],"roleHeading":"API Collection","role":"collectionGroup","title":"High-Performance GroupBy & Vectorized Aggregations"},"kind":"article","topicSections":[{"identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"],"anchor":"Grouping-APIs","title":"Grouping APIs"}],"variants":[{"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. ","type":"text"},{"type":"codeVoice","code":"SwiftDataFrame"},{"text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory.","type":"text"}]},{"anchor":"1-Basic-GroupBy-Aggregation","level":2,"type":"heading","text":"1. Basic GroupBy Aggregation"},{"code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"],"type":"codeListing","syntax":"swift"},{"anchor":"2-Multi-Column-Grouping","level":2,"type":"heading","text":"2. Multi-Column Grouping"},{"type":"paragraph","inlineContent":[{"text":"You can group by multiple categorical dimensions simultaneously:","type":"text"}]},{"code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"],"type":"codeListing","syntax":"swift"},{"anchor":"3-Performance--Memory-Efficiency","level":2,"type":"heading","text":"3. Performance & Memory Efficiency"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Single-Pass Hash Accumulation"}],"type":"strong"},{"text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"vDSP Vector Reductions"}],"type":"strong"},{"text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines (","type":"text"},{"code":"vDSP_sveD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_meanvD","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}]}]}],"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"role":"symbol","title":"groupBy(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"groupBy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"...) -> ","kind":"text"},{"text":"GroupedDataFrame","preciseIdentifier":"s:14SwiftDataFrame07GroupedbC0V","kind":"typeIdentifier"}],"url":"\/documentation\/swiftdataframe\/dataframe\/groupby(_:)","type":"topic","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)","abstract":[{"type":"text","text":"Returns a "},{"type":"codeVoice","code":"GroupedDataFrame"},{"text":" for aggregation.","type":"text"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}],"title":"SwiftDataFrame","role":"collection","url":"\/documentation\/swiftdataframe","type":"topic","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","kind":"symbol"}}}