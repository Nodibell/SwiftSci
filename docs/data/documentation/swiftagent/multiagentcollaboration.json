{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/swiftagent\/multiagentcollaboration"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Multi-Agent Coordination & Protocols","modules":[{"name":"SwiftAgent"}],"role":"collectionGroup","roleHeading":"API Collection"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Complex analytical and reasoning workflows are frequently error-prone when performed by a single monolithic model. Decomposing problems into specialized roles—such as "},{"inlineContent":[{"type":"text","text":"Planner"}],"type":"strong"},{"type":"text","text":", "},{"inlineContent":[{"text":"Analyst","type":"text"}],"type":"strong"},{"type":"text","text":", and "},{"inlineContent":[{"type":"text","text":"Critic"}],"type":"strong"},{"type":"text","text":"—drastically improves reasoning accuracy, reduces hallucinations, and permits parallelized tool execution."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"SwiftAgent"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"MultiAgentOrchestrator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AgentMessageBus"},{"type":"text","text":", a reactive multi-agent framework built on Swift’s structured concurrency primitives ("},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" and "},{"type":"codeVoice","code":"withTaskGroup"},{"type":"text","text":")."}],"type":"paragraph"},{"text":"Architectural Topology","anchor":"Architectural-Topology","level":2,"type":"heading"},{"code":["                         ┌───────────────────────┐","                         │   User \/ Prompt Task  │","                         └───────────┬───────────┘","                                     │","                                     ▼","                       ┌───────────────────────────┐","                       │      AgentMessageBus      │","                       │       (AsyncStream)       │","                       └─────────────┬─────────────┘","                                     │ Broadcasts","         ┌───────────────────────────┼───────────────────────────┐","         ▼                           ▼                           ▼","┌──────────────────┐       ┌──────────────────┐       ┌──────────────────┐","│     Planner      │       │     Analyst      │       │      Critic      │","│ Decomposes steps │       │ Queries & Models │       │ Validates logic  │","└────────┬─────────┘       └────────┬─────────┘       └────────┬─────────┘","         │                          │                          │","         └──────────────────────────┼──────────────────────────┘","                                    │ Parallel Tool Calls","                                    ▼","                     ┌─────────────────────────────┐","                     │ MultiAgentOrchestrator      │","                     │ withTaskGroup Tool Executor │","                     └──────────────┬──────────────┘","                                    │","               ┌────────────────────┴────────────────────┐","               ▼                                         ▼","      DataFrame Query Tool                      Statistical Model Tool"],"syntax":null,"type":"codeListing"},{"text":"Parallel Tool Calling","anchor":"Parallel-Tool-Calling","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When an agent requests multiple tool executions in a single reasoning step (e.g. computing standard deviations across three columns concurrently), "},{"type":"codeVoice","code":"MultiAgentOrchestrator.executeToolsInParallel(_:)"},{"type":"text","text":" executes them simultaneously across available CPU cores using "},{"type":"codeVoice","code":"withTaskGroup"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"This reduces total latency from $\\sum_{i=1}^M T_i$ to $\\max_{i} T_i$.","type":"text"}],"type":"paragraph"},{"anchor":"Example-Usage","text":"Example Usage","type":"heading","level":2},{"syntax":"swift","code":["import SwiftAgent","import SwiftDataFrame","","\/\/ 1. Initialize orchestrator and message bus","let orchestrator = MultiAgentOrchestrator(maxRounds: 5)","","\/\/ 2. Register specialized agents","orchestrator.registerAgent(PlannerAgent())","orchestrator.registerAgent(DataAnalystAgent())","orchestrator.registerAgent(CriticAgent())","","\/\/ 3. Register tools","orchestrator.registerTool(DataFrameAgentTool(dataframe: salesData))","","\/\/ 4. Run collaborative execution","let solution = try await orchestrator.run(","    taskPrompt: \"Identify top 3 departments by salary variance and critique findings.\"",")","print(\"Consensus Answer: \\(solution)\")"],"type":"codeListing"}]}],"sections":[],"abstract":[{"type":"text","text":"Orchestrate teams of specialized autonomous agents over an asynchronous message bus with concurrent parallel tool calling."}],"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgenticReplAndRAG"],"generated":true}],"topicSections":[{"title":"Multi-Agent Coordination","anchor":"Multi-Agent-Coordination","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentOrchestrator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessageBus","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessage","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolCall","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolResult","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SpecializedAgent"]}],"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration","interfaceLanguage":"swift"},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"references":{"doc://SwiftAgent/documentation/SwiftAgent/AgentMessageBus":{"abstract":[{"type":"tex