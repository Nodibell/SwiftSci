{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Perform Student’s t-tests, paired t-tests, Chi-Square independence tests, and Analysis of Variance (ANOVA)."}],"hierarchy":{"paths":[["doc:\/\/SwiftStats\/documentation\/SwiftStats"]]},"identifier":{"url":"doc:\/\/SwiftStats\/documentation\/SwiftStats\/HypothesisTesting","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftStats\/documentation\/SwiftStats\/DescriptiveStatistics"],"generated":true,"anchor":"Guides--Tutorials"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiftStats","type":"codeVoice"},{"text":" supports complete inferential statistics with exact p-value and confidence interval calculations.","type":"text"}]},{"type":"heading","anchor":"1-Two-Sample-Students-t-Test","text":"1. Two-Sample Student’s t-Test","level":3},{"type":"codeListing","code":["import SwiftStats","","let groupA: [Double] = [12.1, 14.3, 11.8, 13.5, 15.0]","let groupB: [Double] = [9.8, 10.5, 11.2, 10.1, 9.4]","","let result = Stats.ttest(groupA, groupB)","print(\"t-statistic: \\(result.statistic), p-value: \\(result.pValue)\")","if result.isSignificant {","    print(\"Statistically significant difference (p < 0.05)\")","}"],"syntax":"swift"},{"type":"heading","anchor":"2-One-Way-ANOVA","text":"2. One-Way ANOVA","level":3},{"type":"codeListing","code":["let samples: [[Double]] = [groupA, groupB, [8.5, 9.0, 8.8]]","let anova = Stats.anova(samples)","print(\"F-statistic: \\(anova.statistic), p-value: \\(anova.pValue)\")"],"syntax":"swift"}]}],"kind":"article","metadata":{"role":"article","title":"Hypothesis Testing & ANOVA","modules":[{"name":"SwiftStats"}],"roleHeading":"Article"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftstats\/hypothesistesting"]}],"references":{"doc://