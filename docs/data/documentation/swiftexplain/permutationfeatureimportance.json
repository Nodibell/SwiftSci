{"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Permutation Feature Importance","type":"text"}]},{"type":"text","text":" measures how much a trained model’s error increases when a single feature column is randomly shuffled, breaking the relationship between that feature and the target outcome."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Importance Metric:"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Importance(f_j) = Loss(X_shuffled(j), y) - Loss(X, y)"}]}],"name":"Note"},{"type":"heading","text":"1. Computing Permutation Importance","anchor":"1-Computing-Permutation-Importance","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","import SwiftML","","let importance = try await PermutationImportance.compute(","    model: trainedModel,","    features: X_val,","    targets: y_val,","    metric: .meanSquaredError,","    nRepeats: 10",")","","for (idx, score) in importance.enumerated() {","    print(\"Feature \\(idx): Mean drop = \\(score.mean), Std = \\(score.std)\")","}"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftexplain\/permutationfeatureimportance"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationFeatureImportance"},"topicSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationImportance"],"anchor":"Diagnostic-Tools","title":"Diagnostic Tools"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"metadata":{"modules":[{"name":"SwiftExplain"}],"title":"Permutation Feature Importance & Model Diagnostics","roleHeading":"API Collection","role":"collectionGroup"},"schemaVersion":{"p