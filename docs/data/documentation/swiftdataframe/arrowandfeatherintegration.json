{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties."}]},{"type":"heading","level":2,"text":"1. Arrow Memory Layout & Bitmaps","anchor":"1-Arrow-Memory-Layout--Bitmaps"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:"}]},{"code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"],"type":"codeListing","syntax":null},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Validity Bitmaps"}]},{"type":"text","text":": Each bit represents the presence (1) or absence (0) of a value at that index."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SIMD Null Filtering"}]},{"type":"text","text":": Vectorized operations skip null evaluations using SIMD bitmasks ("},{"type":"codeVoice","code":"vDSP_vcmprsD"},{"type":"text","text":"), allowing full CPU register utilization."}]}]}]},{"type":"heading","level":2,"text":"2. Feather File Format (Arrow IPC)","anchor":"2-Feather-File-Format-Arrow-IPC"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:"}]},{"code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"3. Lazy Feather Streaming","anchor":"3-Lazy-Feather-Streaming"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For large datasets, SwiftDataFrame supports streaming chunked reads:"}]},{"code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"type":"codeListing","syntax":"swift"}]}],"kind":"article","abstract":[{"type":"text","text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization."}],"metadata":{"roleHeading":"API Collection","title":"Apache Arrow & Feather Zero-Copy Integration","modules":[{"name":"SwiftDataFrame"}],"role":"collectionGroup"},"topicSections":[{"title":"Arrow Classes & Readers","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"],"anchor":"Arrow-Classes--Readers"}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"kind":"symbol","title":"FeatherReader","url":"\/documentation\/swiftdataframe\/featherreader","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherReader"}],"abstract":[{"type":"text","text":"Reader for Feather \/ Apache Arrow IPC binary file format."}],"type":"topic","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","navigatorTitle":[{"kind":"identifier","text":"FeatherReader"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"role":"collection","type":"topic","url":"\/documentation\/swiftdataframe","abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}],"kind":"symbol","title":"SwiftDataFrame","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"url":"\/documentation\/swiftdataframe\/typedcolumn","role":"symbol","type":"topic","navigatorTitle":[{"text":"TypedColumn","kind":"identifier"}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypedColumn","kind":"identifier"}],"abstract":[{"text":"A strongly-typed column backed by a contiguous Swift array.","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" elements represent null \/ missing values.","type":"text"}],"title":"TypedColumn"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"kind":"symbol","title":"FeatherWriter","url":"\/documentation\/swiftdataframe\/featherwriter","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherWriter"}],"abstract":[{"type":"text","text":"Writer for Feather \/ Apache Arrow IPC binary file format."}],"type":"topic","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","navigatorTitle":[{"kind":"identifier","text":"FeatherWriter"}]}}}