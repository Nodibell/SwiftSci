{"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials","generated":true}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference"},"topicSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/PagedKVCache","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMConfig","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/RoPEEmbedding"],"anchor":"Core-Inference-Components","title":"Core Inference Components"},{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies"],"anchor":"Sampling--Decoding","title":"Sampling & Decoding"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" implements modern decoder-only causal transformer architectures (such as Llama 3, Mistral, and Gemma) leveraging MLX unified memory acceleration on Apple Silicon GPUs. Inference is divided into two distinct computational phases:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Prompt Prefill Phase (","type":"text"},{"code":"isPrefill: true","type":"codeVoice"},{"text":")","type":"text"}],"type":"strong"},{"text":": Processes all initial prompt tokens in parallel, computing attention matrices and populating the key-value cache across all transformer layers.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Incremental Decoding Phase (","type":"text"},{"code":"isPrefill: false","type":"codeVoice"},{"text":")","type":"text"}],"type":"strong"},{"text":": Processes a single token per step, computing query projections and attending over the accumulated key-value history ($O(N)$ attention over cached history, avoiding repeated full-sequence forward passes).","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"thematicBreak"},{"level":2,"text":"1. Two-Stage Generation Loop","anchor":"1-Two-Stage-Generation-Loop","type":"heading"},{"inlineContent":[{"type":"text","text":"The following complete example demonstrates configuring a model, prefilling the KV-cache, and executing an autoregressive generation loop:"}],"type":"paragraph"},{"code":["import Foundation","import SwiftLLM","import MLX","","\/\/ 1. Initialize configuration and decoder","let config = LLMConfig.llama3_8B","let decoder = TransformerDecoder(config: config)","let cache = KVCache(config: config)","","\/\/ Tokenized prompt sequence","let promptTokens: [Int] = [128000, 791, 7453, 374]","var generatedTokens = promptTokens","let maxNewTokens = 64","","\/\/ 2. Stage 1: Prefill prompt tokens into KV-cache","let promptLogits = try decoder.forward(","    tokens: promptTokens,","    cache: cache,","    isPrefill: true",")","","\/\/ 3. Configure sampling parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","\/\/ 4. Sample first generated token from prefill logits","var currentToken = Sampler.sample(","    logits: promptLogits,","    config: sampling,","    pastTokens: generatedTokens",")","generatedTokens.append(currentToken)","","\/\/ 5. Stage 2: Incremental single-token decoding loop","for _ in 1..<maxNewTokens {","    \/\/ Forward single token with isPrefill: false","    let stepLogits = try decoder.forward(","        tokens: [currentToken],","        cache: cache,","        isPrefill: false","    )","    ","    \/\/ Sample next token ID","    let nextToken = Sampler.sample(","        logits: stepLogits,","        config: sampling,","        pastTokens: generatedTokens","    )","    ","    generatedTokens.append(nextToken)","    currentToken = nextToken","    ","    \/\/ Check for EOS (End of Sequence) tokens","    if nextToken == 128001 || nextToken == 128009 {","        break","    }","}","","print(\"Generated total sequence: \\(generatedTokens.count) tokens.\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"level":2,"text":"2. Rotary Position Embeddings (RoPE) During Incremental Decoding","anchor":"2-Rotary-Position-Embeddings-RoPE-During-Incremental-Decoding","type":"heading"},{"inlineContent":[{"type":"text","text":"During single-token decoding ("},{"type":"codeVoice","code":"isPrefill: false"},{"type":"text","text":"), position frequencies must match the actual sequential position in the generated sequence rather than index "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"RoPEEmbedding"},{"type":"text","text":" tracks this via the "},{"type":"codeVoice","code":"positionOffset"},{"type":"text","text":" parameter:"}],"type":"paragraph"},{"code":["\/\/ Internal RoPE position calculation:","\/\/ position = positionOffset + tokenIndex","let rotatedQ = rope.apply(x: query, positionOffset: cache.currentLength)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"KVCache"},{"type":"text","text":" dynamically tracks "},{"type":"codeVoice","code":"currentLength"},{"type":"text","text":", positions increment faithfully from the end of the prefill boundary through every subsequent token generation step."}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"text":"3. High-Level Streaming API","anchor":"3-High-Level-Streaming-API","type":"heading"},{"inlineContent":[{"type":"text","text":"For streaming applications, "},{"type":"codeVoice","code":"LLMModel"},{"type":"text","text":" wraps the decoder and cache lifecycle into an asynchronous sequence:"}],"type":"paragraph"},{"code":["import SwiftLLM","","let options = LLMOptions(","    maxTokens: 128,","    sampling: SamplingConfiguration(temperature: 0.7, topK: 40, topP: 0.9)",")","","for try await token in model.generateStream(prompt: \"Explain rotary embeddings:\", options: options) {","    print(token, terminator: \"\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/swiftllm\/transformerdecoderinference"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftLLM"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Autoregressive Transformer Decoder Inference"},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"sections":[],"abstract":[{"text":"Execute two-stage autoregressive generation with full prompt prefill and incremental single-token decoding using Apple Silicon KV-caching.","type":"text"}],"references":{"doc://SwiftLLM/documentation/SwiftLLM/SamplingAndDecodingStrategies":{"url":"\/documentation\/swiftllm\/samplinganddecodingstrategies","type":"topic","role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"Control autoregressive language generation with Temperature, Top-P Nucleus, Top-K, and Repetition Penalty."}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","title":"Token Sampling & Decoding Strategies"},"doc://SwiftLLM/documentation/SwiftLLM/KVCache":{"kind":"symbol","url":"\/documentation\/swiftllm\/kvcache","type":"topic","title":"KVCache","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache","role":"symbol","navigatorTitle":[{"text":"KVCache","kind":"identifier"}],"abstract":[{"type":"text","text":"Key-Value cache storing previous Attention Keys and Values per layer for O(N) generation."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KVCache","kind":"identifier"}]},"doc://SwiftLLM/documentation/SwiftLLM/LLMConfig":{"title":"LLMConfig","abstract":[],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMConfig","url":"\/documentation\/swiftllm\/llmconfig","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LLMConfig"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LLMConfig"}]},"doc://SwiftLLM/documentation/SwiftLLM/LLMOptions":{"url":"\/documentation\/swiftllm\/llmoptions","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LLMOptions"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LLMOptions"}],"abstract":[{"text":"Options configuring generative text inference.","type":"text"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","title":"LLMOptions"},"doc://SwiftLLM/documentation/SwiftLLM/Sampler":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}],"type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","abstract":[{"text":"Generates next token predictions from logits using probabilistic sampling.","type":"text"}],"url":"\/documentation\/swiftllm\/sampler","navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"title":"Sampler","role":"symbol","kind":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM":{"kind":"symbol","url":"\/documentation\/swiftllm","type":"topic","title":"SwiftLLM","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","role":"collection","abstract":[{"type":"text","text":"Local Causal Transformer Decoder & Weight Parsers."}]},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoderArchitecture":{"abstract":[{"text":"High-throughput, on-device causal language model execution on Apple Silicon Unified Memory Architecture using ","type":"text"},{"code":"TransformerDecoder","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PagedKVCache","type":"codeVoice"},{"text":", ","type":"text"},{"code":"GGUFParser","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SafeTensorsParser","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","url":"\/documentation\/swiftllm\/transformerdecoderarchitecture","title":"Transformer Architecture & LLM Inference Guide","role":"article","kind":"article"},"doc://SwiftLLM/documentation/SwiftLLM/RoPEEmbedding":{"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RoPEEmbedding"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/RoPEEmbedding","type":"topic","abstract":[{"type":"text","text":"Rotary Positional Embedding (RoPE) applying frequency-based rotations to query and key tensors."}],"url":"\/documentation\/swiftllm\/ropeembedding","navigatorTitle":[{"text":"RoPEEmbedding","kind":"identifier"}],"title":"RoPEEmbedding","role":"symbol","kind":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/PagedKVCache":{"kind":"symbol","url":"\/documentation\/swiftllm\/pagedkvcache","type":"topic","title":"PagedKVCache","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/PagedKVCache","role":"symbol","navigatorTitle":[{"text":"PagedKVCache","kind":"identifier"}],"abstract":[{"type":"text","text":"A dynamic paged Key-Value attention cache allocator for high-throughput batch and stream inference."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PagedKVCache","kind":"identifier"}]},"doc://SwiftLLM/documentation/SwiftLLM/MetalShadersQuantization":{"url":"\/documentation\/swiftllm\/metalshadersquantization","type":"topic","role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU."}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization","title":"Native Metal MSL Shaders for Quantized LLMs"},"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"url":"\/documentation\/swiftllm\/weightparsingandsampling","type":"topic","role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"Parse GGUF and SafeTensors model weights zero-copy into Apple Silicon unified memory and sample tokens with fine-grained logits controls."}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","title":"GGUF\/SafeTensors Parsing & Sampling"},"doc://SwiftLLM/documentation/SwiftLLM/SamplingConfiguration":{"url":"\/documentation\/swiftllm\/samplingconfiguration","type":"topic","role":"symbol","navigatorTitle":[{"text":"SamplingConfiguration","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SamplingConfiguration","kind":"identifier"}],"abstract":[{"type":"text","text":"Fine-grained configuration of the generative token sampling pipeline."}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","title":"SamplingConfiguration"},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoder":{"kind":"symbol","url":"\/documentation\/swiftllm\/transformerdecoder","type":"topic","title":"TransformerDecoder","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","role":"symbol","navigatorTitle":[{"text":"TransformerDecoder","kind":"identifier"}],"abstract":[{"type":"text","text":"A full N-layer decoder-only Transformer."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransformerDecoder","kind":"identifier"}]}}}