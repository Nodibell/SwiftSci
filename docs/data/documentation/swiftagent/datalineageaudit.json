{"abstract":[{"type":"text","text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation."}],"type":"paragraph"},{"inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"type":"text","text":" automatically generates an immutable audit trail of "},{"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true},{"type":"text","text":" entries for each command evaluated."}],"type":"paragraph"},{"anchor":"LineageRecord-Structure","text":"LineageRecord Structure","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Each "},{"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true},{"type":"text","text":" contains:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"stepIndex"},{"type":"text","text":": Sequential index of the step within the agent trajectory."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"operation"},{"type":"text","text":": The normalized DSL command executed (e.g., "},{"type":"codeVoice","code":"filter(age)"},{"type":"text","text":", "},{"type":"codeVoice","code":"groupBy(category,mean)"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"inputRows"},{"type":"text","text":": Dataset row count immediately prior to transformation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"outputRows"},{"type":"text","text":": Dataset row count produced by the transformation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"timestamp"},{"type":"text","text":": The exact timestamp of execution."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Example-Accessing-Audit-Trails","text":"Example: Accessing Audit Trails","type":"heading","level":2},{"syntax":"swift","code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/datalineageaudit"]}],"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"title":"Audit Types","anchor":"Audit-Types"}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"metadata":{"role":"collectionGroup","roleHeading":"API Collection","title":"Data Lineage & Transformation Audit Trails","modules":[{"name":"SwiftAgent"}]},"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","title":"LineageRecord","navigatorTitle":[{"text":"LineageRecord","kind":"identifier"}],"url":"\/documentation\/swiftagent\/lineagerecord","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LineageRecord","kind":"identifier"}],"role":"symbol","kind":"symbol","abstract":[{"text":"Represents an immutable audit trail entry recording a discrete data transformation step.","type":"text"}],"type":"topic"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiftAgentEvaluator","kind":"identifier"}],"url":"\/documentation\/swiftagent\/swiftagentevaluator","navigatorTitle":[{"text":"SwiftAgentEvaluator","kind":"identifier"}],"abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"title":"SwiftAgentEvaluator","kind":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","role":"symbol","type":"topic"},"doc://SwiftAgent/documentation/SwiftAgent":{"kind":"symbol","url":"\/documentation\/swiftagent","title":"SwiftAgent","type":"topic","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","role":"collection","abstract":[{"text":"Agentic REPL Execution Sandbox & RAG Summary Engine.","type":"text"}]}}}