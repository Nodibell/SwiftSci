{"kind":"article","topicSections":[{"title":"Arrow Classes & Readers","anchor":"Arrow-Classes--Readers","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration"},"metadata":{"title":"Apache Arrow & Feather Zero-Copy Integration","modules":[{"name":"SwiftDataFrame"}],"roleHeading":"API Collection","role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"sections":[],"abstract":[{"text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties."}],"type":"paragraph"},{"type":"heading","level":2,"text":"1. Arrow Memory Layout & Bitmaps","anchor":"1-Arrow-Memory-Layout--Bitmaps"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:"}]},{"type":"codeListing","code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"],"syntax":null},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Validity Bitmaps","type":"text"}]},{"type":"text","text":": Each bit represents the presence (1) or absence (0) of a value at that index."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"SIMD Null Filtering"}],"type":"strong"},{"text":": Vectorized operations skip null evaluations using SIMD bitmasks (","type":"text"},{"type":"codeVoice","code":"vDSP_vcmprsD"},{"type":"text","text":"), allowing full CPU register utilization."}]}]}]},{"level":2,"anchor":"2-Feather-File-Format-Arrow-IPC","text":"2. Feather File Format (Arrow IPC)","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:"}]},{"type":"codeListing","code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"syntax":"swift"},{"type":"heading","level":2,"text":"3. Lazy Feather Streaming","anchor":"3-Lazy-Feather-Streaming"},{"type":"paragraph","inlineContent":[{"text":"For large datasets, SwiftDataFrame supports streaming chunked reads:","type":"text"}]},{"type":"codeListing","code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"TypedColumn","kind":"identifier"}],"title":"TypedColumn","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn","navigatorTitle":[{"kind":"identifier","text":"TypedColumn"}],"role":"symbol","url":"\/documentation\/swiftdataframe\/typedcolumn","abstract":[{"text":"A strongly-typed column backed by a contiguous Swift array.","type":"text"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"text":" elements represent null \/ missing values.","type":"text"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","url":"\/documentation\/swiftdataframe","role":"collection","title":"SwiftDataFrame"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"navigatorTitle":[{"kind":"identifier","text":"FeatherReader"}],"abstract":[{"type":"text","text":"Reader for Feather \/ Apache Arrow IPC binary file format."}],"url":"\/documentation\/swiftdataframe\/featherreader","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherReader"}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","title":"FeatherReader","kind":"symbol"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherWriter"}],"kind":"symbol","url":"\/documentation\/swiftdataframe\/featherwriter","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","role":"symbol","abstract":[{"type":"text","text":"Writer for Feather \/ Apache Arrow IPC binary file format."}],"navigatorTitle":[{"kind":"identifier","text":"FeatherWriter"}],"type":"topic","title":"FeatherWriter"}}}