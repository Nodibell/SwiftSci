{"sections":[],"abstract":[{"text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model.","type":"text"}],"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftExplain"}],"title":"Game-Theoretic Interpretability with Kernel SHAP","roleHeading":"API Collection"},"topicSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"anchor":"SHAP-Explainer-APIs","title":"SHAP Explainer APIs"}],"variants":[{"paths":["\/documentation\/swiftexplain\/kernelshaptheory"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}],"type":"strong"},{"type":"text","text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory."}]},{"anchor":"1-The-Four-Shapley-Axioms","type":"heading","text":"1. The Four Shapley Axioms","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Efficiency","type":"text"}],"type":"strong"},{"text":": Feature attributions sum up to the difference between model prediction ","type":"text"},{"type":"codeVoice","code":"f(x)"},{"text":" and expected background prediction ","type":"text"},{"type":"codeVoice","code":"E[f(X)]"},{"text":":","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}],"type":"paragraph"}],"name":"Note"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Symmetry"}],"type":"strong"},{"text":": If two features contribute equally to all possible feature subsets, their attributions are equal.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Dummy (Null Player)"}],"type":"strong"},{"text":": A feature that does not change the model prediction for any coalition receives an attribution of zero (","type":"text"},{"type":"codeVoice","code":"φ_i = 0"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Additivity"}],"type":"strong"},{"text":": For ensemble models ","type":"text"},{"type":"codeVoice","code":"f = f1 + f2"},{"text":", attributions satisfy ","type":"text"},{"type":"codeVoice","code":"φ_i(f) = φ_i(f1) + φ_i(f2)"},{"text":".","type":"text"}]}]}]},{"type":"heading","level":2,"text":"2. Explaining Predictions in SwiftSci","anchor":"2-Explaining-Predictions-in-SwiftSci"},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory"},"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}],"kind":"symbol","type":"topic","title":"KernelSHAP","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","url":"\/documentation\/swiftexplain\/kernelshap","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KernelSHAP","kind":"identifier"}],"navigatorTitle":[{"text":"KernelSHAP","kind":"identifier"}]},"doc://SwiftExplain/documentation/SwiftExplain":{"type":"topic","url":"\/documentation\/swiftexplain","title":"SwiftExplain","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}]}}}