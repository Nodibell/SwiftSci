ation\/swiftvision","kind":"symbol","role":"collection","type":"topic","title":"SwiftVision"},"doc://SwiftVision/documentation/SwiftVision/UNetOutConv":{"title":"UNetOutConv","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetOutConv","url":"\/documentation\/swiftvision\/unetoutconv","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UNetOutConv","kind":"identifier"}],"navigatorTitle":[{"text":"UNetOutConv","kind":"identifier"}],"abstract":[{"type":"text","text":"Final 1x1 Convolution Head mapping feature maps to segmentation class probability logits."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://SwiftVision/documentation/SwiftVision/UNetDoubleConv":{"title":"UNetDoubleConv","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetDoubleConv","url":"\/documentation\/swiftvision\/unetdoubleconv","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UNetDoubleConv","kind":"identifier"}],"navigatorTitle":[{"text":"UNetDoubleConv","kind":"identifier"}],"abstract":[{"type":"text","text":"Double 3x3 Convolution Block with Batch Normalization and ReLU\/SiLU activation."}],"kind":"symbol","type":"topic","role":"symbol"},"doc://SwiftVision/documentation/SwiftVision/UNetUp":{"url":"\/documentation\/swiftvision\/unetup","type":"topic","role":"symbol","navigatorTitle":[{"text":"UNetUp","kind":"identifier"}],"kind":"symbol","title":"UNetUp","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/UNetUp","abstract":[{"text":"Upsampling block: Bilinear\/Stride Upsample + Skip Connection Concatenation + DoubleConv.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UNetUp","kind":"identifier"}]}}}