{"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"anchor":"Guides--Tutorials"}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Architecture-Overview","level":2,"text":"Architecture Overview","type":"heading"},{"inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"text":" implements the modern Llama-3 \/ Mistral autoregressive causal decoder architecture natively in pure Swift and MLX:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["                          ┌────────────────────────┐","                          │    Input Token IDs     │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │   Token Embeddings     │","                          └───────────┬────────────┘","                                      ▼","                      ┌────────────────────────────────┐","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │ Multi-Head Attention + RoPE│ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │      SwiGLU FFN (SiLU)     │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │ └─────────────┬──────────────┘ │ x N Layers","                      └───────────────┼────────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │     Final RMSNorm      │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │  LM Head (Logits)      │","                          └────────────────────────┘"],"type":"codeListing"},{"type":"thematicBreak"},{"anchor":"1-Core-Architectural-Components","level":2,"text":"1. Core Architectural Components","type":"heading"},{"anchor":"RoPE-Rotary-Position-Embedding","level":3,"text":"RoPE (Rotary Position Embedding)","type":"heading"},{"inlineContent":[{"text":"Applies 2D rotation to query and key vectors based on absolute position index ","type":"text"},{"code":"m","type":"codeVoice"},{"text":", preserving relative token distance properties without learned position embeddings.","type":"text"}],"type":"paragraph"},{"anchor":"SwiGLU-Feed-Forward-Network","level":3,"text":"SwiGLU Feed-Forward Network","type":"heading"},{"inlineContent":[{"text":"Replaces legacy ReLU\/GELU activations with Swish-Gated Linear Units (Llama-style):","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiGLU(x) = (SiLU(x · W_gate) ⊙ (x · W_up)) · W_down"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Paged-KV-Cache","level":3,"text":"Paged KV-Cache","type":"heading"},{"inlineContent":[{"text":"Manages attention Key-Value projection states in fixed-size contiguous memory pages (vLLM architecture), eliminating RAM fragmentation during dynamic multi-turn autoregressive decoding.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"2-Parsing-Weight-Formats-SafeTensors--GGUF","level":2,"text":"2. Parsing Weight Formats (SafeTensors & GGUF)","type":"heading"},{"inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"text":" includes strict parsers for both HuggingFace ","type":"text"},{"code":".safetensors","type":"codeVoice"},{"text":" headers and ","type":"text"},{"code":"GGUF","type":"codeVoice"},{"text":" quantized binary models:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import SwiftLLM","","\/\/ 1. Parse SafeTensors weight metadata","let safeTensorsURL = URL(fileURLWithPath: \"model.safetensors\")","let (tensors, metadata) = try SafeTensorsParser.parse(fileURL: safeTensorsURL)","","print(\"Found \\(tensors.count) tensor layers in SafeTensors archive.\")","for (tensorName, info) in tensors.prefix(5) {","    print(\"Layer '\\(tensorName)': dtype=\\(info.dtype), shape=\\(info.shape)\")","}","","\/\/ 2. Parse GGUF Quantized Binary Archive","let ggufURL = URL(fileURLWithPath: \"llama-3-8b.Q4_K_M.gguf\")","let ggufModel = try GGUFParser.parse(fileURL: ggufURL)","print(\"Loaded GGUF Model with \\(ggufModel.tensors.count) quantized tensors.\")"],"type":"codeListing"},{"type":"thematicBreak"},{"anchor":"3-End-to-End-Decoder-Configuration--Inference","level":2,"text":"3. End-to-End Decoder Configuration & Inference","type":"heading"},{"inlineContent":[{"text":"Construct an N-layer ","type":"text"},{"code":"TransformerDecoder","type":"codeVoice"},{"text":" using standard presets (","type":"text"},{"code":"LLMConfig.llama3_8B","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"LLMConfig.custom","type":"codeVoice"},{"text":") and generate tokens:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftLLM","","\/\/ 1. Initialize TransformerDecoder with Llama-3-8B configuration","let config = LLMConfig.llama3_8B","let decoder = TransformerDecoder(config: config)","","\/\/ 2. Load model weights into memory","let weightsDictionary: [String: [Double]] = [:] \/\/ Populated from SafeTensors\/GGUF","try decoder.loadWeights(weightsDictionary)","","\/\/ 3. Configure sampling strategy","let sampler = TopKSampler(temperature: 0.7, topK: 40, topP: 0.9)","","\/\/ 4. Autoregressive token generation loop","let promptTokens: [Int] = [128000, 791, 7453, 374] \/\/ Tokenized input","var generatedTokens = promptTokens","let maxNewTokens = 50","","print(\"Generating output tokens...\")","for _ in 0..<maxNewTokens {","    let logits = try decoder.forward(tokens: generatedTokens)","    let nextToken = sampler.sample(logits: logits)","    ","    generatedTokens.append(nextToken)","    if nextToken == 128001 { \/\/ End of Sequence token (EOS)","        break","    }","}","","print(\"Generated sequence length: \\(generatedTokens.count) tokens.\")"],"type":"codeListing"},{"type":"thematicBreak"},{"anchor":"4-Structured-JSON-Grammar-Decoding","level":2,"text":"4. Structured JSON Grammar Decoding","type":"heading"},{"inlineContent":[{"text":"Enforce strict output conformance to Swift ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" schemas using ","type":"text"},{"code":"JSONGrammarDecoder","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftLLM","","struct SentimentResponse: Codable {","    let label: String","    let confidence: Double","}","","let grammarDecoder = JSONGrammarDecoder(schema: SentimentResponse.self)","let constrainedTokens = try grammarDecoder.constrainSampling(logits: logits, validTokens: vocabulary)"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"High-throughput, on-device causal language model execution on Apple Silicon Unified Memory Architecture using ","type":"text"},{"code":"TransformerDecoder","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PagedKVCache","type":"codeVoice"},{"text":", ","type":"text"},{"code":"GGUFParser","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SafeTensorsParser","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/transformerdecoderarchitecture"]}],"metadata":{"modules":[{"name":"SwiftLLM"}],"roleHeading":"Article","role":"article","title":"Transformer Architecture & LLM Inference Guide"},"references":{"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","abstract":[{"type":"text","text":"Parse GGUF and SafeTensors model weights zero-copy and sample tokens using Temperature and Top-K sampling."}],"title":"GGUF\/SafeTensors Parsing & Sampling","url":"\/documentation\/swiftllm\/weightparsingandsampling","kind":"article","type":"topic","role":"article"},"doc://SwiftLLM/documentation/SwiftLLM/MetalShadersQuantization":{"kind":"article","abstract":[{"text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU.","type":"text"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization","type":"topic","title":"Native Metal MSL Shaders for Quantized LLMs","url":"\/documentation\/swiftllm\/metalshadersquantization","role":"collectionGroup"},"doc://Sw