{"topicSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult"],"title":"Spatial Indexing","anchor":"Spatial-Indexing"}],"abstract":[{"text":"Scale approximate nearest neighbor (ANN) retrieval logarithmically using Hierarchical Navigable Small World graphs.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcluster\/hnswvectorsearch"]}],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"When vector collections expand beyond tens of thousands of items, exact (O(N)) linear scans become a major latency bottleneck for real-time recommendation and retrieval-augmented generation (RAG) systems.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"HNSWIndex"},{"type":"text","text":" actor provides a hierarchical graph-based spatial partitioning index with sub-millisecond query latency and logarithmic (O(\\log N)) search scaling."}],"type":"paragraph"},{"text":"Hierarchical Navigable Small World Architecture","anchor":"Hierarchical-Navigable-Small-World-Architecture","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"HNSW constructs a hierarchy of graph layers:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Top Layers (Sparse)"}],"type":"strong"},{"text":": Contain widely spaced long-range highway edges for rapid coarse geometric routing across distant clusters.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Intermediate Layers","type":"text"}],"type":"strong"},{"type":"text","text":": Progressively decrease edge length while increasing vertex density."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Bottom Layer (Layer 0, Dense)"}]},{"type":"text","text":": Contains all indexed vertices connected by dense short-range edges for high-accuracy localized nearest-neighbor refinement."}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["Layer 2 (Express):   [A] ───────────────────────────► [F]","                      │                                │","                      ▼                                ▼","Layer 1 (Regional):  [A] ──────────► [C] ────────────► [F]","                      │               │                │","                      ▼               ▼                ▼","Layer 0 (Base):      [A] ──► [B] ──► [C] ──► [D] ──► [E] ──► [F]"],"syntax":null,"type":"codeListing"},{"text":"Key Configuration Parameters","level":2,"anchor":"Key-Configuration-Parameters","type":"heading"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Parameter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Recommended Default","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Impact on Search Quality & Index Build Time"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"M","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"16"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Maximum outgoing connections per node. Higher values improve recall at the cost of higher memory and index construction time.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"efConstruction"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"200"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Size of dynamic candidate evaluation queue during insertion. Larger values produce higher-quality graph connectivity."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"efSearch"}],"type":"paragraph"}],[{"inlineContent":[{"code":"50","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Dynamic queue size during search traversal. Higher values increase search recall towards 100% exact match."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"metric"}],"type":"paragraph"}],[{"inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Choice of "},{"code":".euclideanDistance","type":"codeVoice"},{"type":"text","text":", "},{"code":".cosineSimilarity","type":"codeVoice"},{"type":"text","text":", or "},{"code":".dotProduct","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]]],"header":"row","alignments":["left","left","left"],"type":"table"},{"type":"heading","level":2,"text":"Example Usage","anchor":"Example-Usage"},{"type":"codeListing","code":["import SwiftCluster","","\/\/ 1. Initialize the actor-isolated index","let hnsw = HNSWIndex(metric: .cosineSimilarity, M: 16, efConstruction: 200, efSearch: 50)","","\/\/ 2. Add embeddings asynchronously","await hnsw.add(id: \"doc_news_1\", vector: [0.12, 0.94, -0.31], metadata: [\"category\": \"news\"])","await hnsw.add(id: \"doc_tech_2\", vector: [-0.85, 0.11, 0.52], metadata: [\"category\": \"technology\"])","","\/\/ 3. Query Top-K nearest neighbors","let queryEmbedding = [0.10, 0.90, -0.30]","let matches = await hnsw.search(query: queryEmbedding, topK: 5)","","for match in matches {","    print(\"Matched: \\(match.id) with score: \\(match.score)\")","}"],"syntax":"swift"},{"type":"heading","level":2,"text":"Thread Safety & Swift 6 Strict Concurrency","anchor":"Thread-Safety--Swift-6-Strict-Concurrency"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"HNSWIndex"},{"text":" is implemented as an isolated Swift ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":", guaranteeing thread safety and eliminating race conditions when multiple background tasks insert items or execute queries concurrently.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"metadata":{"title":"High-Dimensional Vector Search with HNSW","modules":[{"name":"SwiftCluster"}],"role":"collectionGroup","roleHeading":"API Collection"},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"type":"topic","abstract":[{"text":"Reduce feature dimensionality using SVD-based PCA with automatic CPU and UMA GPU routing.","type":"text"}],"title":"Principal Component Analysis (PCA)","url":"\/documentation\/swiftcluster\/dimensionalityreduction","role":"article","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","kind":"article"},"doc://SwiftCluster/documentation/SwiftCluster/VectorStore":{"url":"\/documentation\/swiftcluster\/vectorstore","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorStore","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"VectorStore"}],"title":"VectorStore","abstract":[{"text":"An in-memory vector database and similarity search index optimized for Apple Silicon.","type":"text"}]},"doc://SwiftCluster/documentation/SwiftCluster/HNSWIndex":{"navigatorTitle":[{"kind":"identifier","text":"HNSWIndex"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex","ur