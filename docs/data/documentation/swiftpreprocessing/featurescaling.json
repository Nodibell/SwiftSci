{"metadata":{"role":"article","roleHeading":"Article","title":"Feature Scaling, Normalization & Flat 1D Memory","modules":[{"name":"SwiftPreprocessing"}]},"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","interfaceLanguage":"swift"},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"abstract":[{"text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using ","type":"text"},{"type":"codeVoice","code":"StandardScaler"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MinMaxScaler"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RobustScaler"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"Normalizer"},{"text":" powered by Apple Accelerate ","type":"text"},{"type":"codeVoice","code":"vDSP"},{"text":".","type":"text"}],"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"Feature scaling is crucial for gradient-based estimators (Neural Networks, Logistic Regression) and distance-based estimators (KNN, DBSCAN, SVM). Without scaling, features with large numeric scales disproportionately dominate distance calculations and gradient updates.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"⚡ Flat 1D Memory Layout & Hardware Vectorization","type":"heading","anchor":"%E2%9A%A1-Flat-1D-Memory-Layout--Hardware-Vectorization","level":2},{"inlineContent":[{"code":"SwiftPreprocessing","type":"codeVoice"},{"text":" operates on contiguous 1D row-major flat buffers ","type":"text"},{"code":"[Double]","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"[Float]","type":"codeVoice"},{"text":") with stride indexing ","type":"text"},{"code":"index = row * cols + col","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"]},{"inlineContent":[{"text":"All arithmetic operations (","type":"text"},{"code":"vDSP_vsubD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_vsdivD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP.sort","type":"codeVoice"},{"text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"1. `StandardScaler` (Z-Score Standardization)","type":"heading","anchor":"1-StandardScaler-Z-Score-Standardization","level":2},{"inlineContent":[{"text":"Transforms features to have zero mean (","type":"text"},{"code":"μ = 0","type":"codeVoice"},{"text":") and unit variance (","type":"text"},{"code":"σ² = 1","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"z = (x - μ) \/ σ","type":"codeVoice"}],"type":"paragraph"}],"type":"aside"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"]},{"type":"thematicBreak"},{"text":"2. `MinMaxScaler` (Bounded Range Scaling)","type":"heading","anchor":"2-MinMaxScaler-Bounded-Range-Scaling","level":2},{"inlineContent":[{"text":"Linearly transforms features into a bounded range ","type":"text"},{"code":"[a, b]","type":"codeVoice"},{"text":" (defaults to ","type":"text"},{"code":"[0, 1]","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)","type":"codeVoice"}],"type":"paragraph"}],"type":"aside"},{"syntax":"swift","type":"codeListing","code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"]},{"type":"thematicBreak"},{"text":"3. `RobustScaler` (Median & IQR Scaling)","type":"heading","anchor":"3-RobustScaler-Median--IQR-Scaling","level":2},{"inlineContent":[{"text":"When datasets contain extreme outliers, mean and standard deviation are distorted. ","type":"text"},{"code":"RobustScaler","type":"codeVoice"},{"text":" scales features using the ","type":"text"},{"inlineContent":[{"text":"Median","type":"text"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"Interquartile Range (IQR = Q3 - Q1)","type":"text"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"x' = (x - Median) \/ IQR"}]}],"type":"aside"},{"type":"codeListing","code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling","text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)","level":2},{"type":"paragraph","inlineContent":[{"text":"Scales each sample independently to have unit L1, L2, or Max norm:","type":"text"}]},{"type":"codeListing","code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"],"syntax":"swift"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Memory & Performance Tip:","type":"text"}]},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput.","type":"text"}]}]}]}],"variants":[{"paths":["\/documentation\/swiftpreprocessing\/featurescaling"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"abstract":[{"type":"text","text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines."}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","role":"collection","title":"SwiftPreprocessing","url":"\/documentation\/swiftpreprocessing","type":"topic","kind":"symbol"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseDataStructures":{"type":"topic","abstract":[{"text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"title":"Memory-Efficient Sparse Matrix Representations","role":"collectionGroup","url":"\/documentation\/swiftpreprocessing\/sparsedatastructures","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","kind":"article"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"type":"topic","url":"\/documentation\/swiftpreprocessing\/encodersandimputers","abstract":[{"text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer.","type":"text"}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","title":"Categorical Encoding & Imputation","role":"article","kind":"article"}}}