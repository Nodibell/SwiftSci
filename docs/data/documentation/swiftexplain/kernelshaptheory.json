{"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"SHAP (SHapley Additive exPlanations)"}],"type":"strong"},{"type":"text","text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory."}],"type":"paragraph"},{"level":2,"anchor":"1-The-Four-Shapley-Axioms","type":"heading","text":"1. The Four Shapley Axioms"},{"inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Efficiency"}],"type":"strong"},{"text":": Feature attributions sum up to the difference between model prediction ","type":"text"},{"type":"codeVoice","code":"f(x)"},{"text":" and expected background prediction ","type":"text"},{"type":"codeVoice","code":"E[f(X)]"},{"text":":","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}],"type":"paragraph"}],"name":"Note"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Symmetry"}],"type":"strong"},{"text":": If two features contribute equally to all possible feature subsets, their attributions are equal.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Dummy (Null Player)"}],"type":"strong"},{"text":": A feature that does not change the model prediction for any coalition receives an attribution of zero (","type":"text"},{"type":"codeVoice","code":"φ_i = 0"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Additivity"}],"type":"strong"},{"text":": For ensemble models ","type":"text"},{"type":"codeVoice","code":"f = f1 + f2"},{"text":", attributions satisfy ","type":"text"},{"type":"codeVoice","code":"φ_i(f) = φ_i(f1) + φ_i(f2)"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"level":2,"anchor":"2-Explaining-Predictions-in-SwiftSci","type":"heading","text":"2. Explaining Predictions in SwiftSci"},{"code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/kernelshaptheory"]}],"metadata":{"modules":[{"name":"SwiftExplain"}],"title":"Game-Theoretic Interpretability with Kernel SHAP","roleHeading":"API Collection","role":"collectionGroup"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model."}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"topicSections":[{"title":"SHAP Explainer APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"anchor":"SHAP-Explainer-APIs"}],"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","kind":"symbol","type":"topic","url":"\/documentation\/swiftexplain","title":"SwiftExplain","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}],"role":"collection"},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"navigatorTitle":[{"text":"KernelSHAP","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KernelSHAP","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swiftexplain\/kernelshap","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"type":"topic","title":"KernelSHAP"}}}