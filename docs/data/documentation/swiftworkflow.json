{"kind":"symbol","metadata":{"title":"SwiftWorkflow","role":"collection","externalID":"SwiftWorkflow","modules":[{"name":"SwiftWorkflow"}],"symbolKind":"module","roleHeading":"Framework"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[[]]},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiftWorkflow","type":"codeVoice"},{"type":"text","text":" provides immutable, production-grade pipelines that compose missing-value imputation, feature scaling, dimensionality reduction, and classification into single deployable units."}]},{"type":"heading","text":"Key Capabilities","anchor":"Key-Capabilities","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fitted End-to-End Pipeline"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"PCAClassificationWorkflow"},{"type":"text","text":" integrating mean imputation, standard scaling, SVD-based PCA projection, and binary logistic regression."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Strict Row Provenance"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"Predictions"},{"type":"text","text":" preserving "},{"type":"codeVoice","code":"sourceRowIndices"},{"type":"text","text":" directly from the input "},{"type":"codeVoice","code":"PreparedSupervisedBatch"},{"type":"text","text":" or "},{"type":"codeVoice","code":"PreparedNumericBatch"},{"type":"text","text":" across non-contiguous batch selections."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Training-Only Fitting"}]},{"type":"text","text":": Fitted state is computed solely on the designated training batch, preventing data leakage from test or validation sets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Atomic JSON Serialization"}]},{"type":"text","text":": Lightweight, versioned JSON serialization ("},{"type":"codeVoice","code":"save(to:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"load(from:)"},{"type":"text","text":") enabling cross-process persistence and cold-start inference without retaining raw datasets."}]}]}]},{"type":"heading","text":"Example Usage","anchor":"Example-Usage","level":3},{"type":"codeListing","code":["import Foundation","import SwiftDataFrame","import SwiftWorkflow","","\/\/ 1. Prepare supervised numeric batch","let batch = try rawDF.prepareNumericBatch([\"signal\", \"companion\", \"noise\", \"target\"])","let supervised = try PreparedSupervisedBatch(batch, targetColumn: \"target\")","","\/\/ 2. Train workflow strictly on training partition","let trainingBatch = try supervised.selectingRows([0, 1, 2, 4, 5])","let workflow = try await PCAClassificationWorkflow.train(","    training: trainingBatch,","    components: 2,","    learningRate: 0.125,","    epochs: 64",")","","\/\/ 3. Atomically persist to disk","let fileURL = URL(fileURLWithPath: \"model.json\")","try workflow.save(to: fileURL)","","\/\/ 4. Reload and predict with zero test leakage","let loadedWorkflow = try PCAClassificationWorkflow.load(from: fileURL)","let predictions = try await loadedWorkflow.predict(heldOutBatch.features)"],"syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftworkflow"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow"},"abstract":[{"type":"text","text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization."}],"topicSections":[{"title":"Workflows","anchor":"Workflows","identifiers":["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/PCAClassificationWorkflow"]},{"title":"Articles","anchor":"Articles","identifiers":["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence"]}],"references":{"doc://SwiftWorkflow/documentation/SwiftWorkflow":{"title":"SwiftWorkflow","kind":"symbol","role":"collection","url":"\/documentation\/swiftworkflow","type":"topic","identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow","abstract":[{"type":"text","text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization."}]},"doc://SwiftWorkflow/documentation/SwiftWorkflow/PCAClassificationWorkflow":{"title":"PCAClassificationWorkflow","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"PCAClassificationWorkflow","kind":"identifier"}],"url":"\/documentation\/swiftworkflow\/pcaclassificationworkflow","type":"topic","identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/PCAClassificationWorkflow","abstract":[{"type":"text","text":"A fitted CPU mean-imputation, standardization, PCA and binary logistic workflow."},{"type":"text","text":" "},{"type":"text","text":"Published instances expose no mutable stages. Saving never refits or reads prediction data."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PCAClassificationWorkflow","kind":"identifier"}]},"doc://SwiftWorkflow/documentation/SwiftWorkflow/WorkflowPersistence":{"kind":"article","title":"Deploying and Persisting Scientific Workflows","role":"article","url":"\/documentation\/swiftworkflow\/workflowpersistence","type":"topic","identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence","abstract":[{"type":"text","text":"Learn how to safely persist, reload, and evaluate end-to-end machine learning workflows across processes."}]}}}