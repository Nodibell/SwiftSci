{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/kernelshaptheory"]}],"sections":[],"abstract":[{"text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"SwiftExplain"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Game-Theoretic Interpretability with Kernel SHAP"},"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"topicSections":[{"title":"SHAP Explainer APIs","anchor":"SHAP-Explainer-APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}],"type":"strong"},{"text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory.","type":"text"}],"type":"paragraph"},{"text":"1. The Four Shapley Axioms","type":"heading","anchor":"1-The-Four-Shapley-Axioms","level":2},{"inlineContent":[{"text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Efficiency"}]},{"text":": Feature attributions sum up to the difference between model prediction ","type":"text"},{"type":"codeVoice","code":"f(x)"},{"text":" and expected background prediction ","type":"text"},{"type":"codeVoice","code":"E[f(X)]"},{"text":":","type":"text"}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Symmetry"}]},{"text":": If two features contribute equally to all possible feature subsets, their attributions are equal.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dummy (Null Player)"}]},{"text":": A feature that does not change the model prediction for any coalition receives an attribution of zero (","type":"text"},{"type":"codeVoice","code":"φ_i = 0"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Additivity"}]},{"text":": For ensemble models ","type":"text"},{"type":"codeVoice","code":"f = f1 + f2"},{"text":", attributions satisfy ","type":"text"},{"type":"codeVoice","code":"φ_i(f) = φ_i(f1) + φ_i(f2)"},{"text":".","type":"text"}]}]}]},{"text":"2. Explaining Predictions in SwiftSci","type":"heading","anchor":"2-Explaining-Predictions-in-SwiftSci","level":2},{"type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"],"syntax":"swift"}]}],"kind":"article","references":{"doc://SwiftExplain/documentation/SwiftExplain":{"url":"\/documentation\/swiftexplain","title":"SwiftExplain","abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","kind":"symbol","role":"collection","type":"topic"},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","navigatorTitle":[{"text":"KernelSHAP","kind":"identifier"}],"title":"KernelSHAP","abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}],"url":"\/documentation\/swiftexplain\/kernelshap","role":"symbol","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KernelSHAP","kind":"identifier"}]}}}