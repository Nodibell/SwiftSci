{"abstract":[{"type":"text","text":"Export trained SwiftSci estimators to native Apple Core ML ("},{"code":".mlmodel","type":"codeVoice"},{"type":"text","text":") and cross-platform ONNX ("},{"type":"codeVoice","code":".onnx"},{"type":"text","text":") binary artifacts for production deployment."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"SwiftSci provides native, wire-format serialization engines for both Apple Core ML and ONNX without requiring external Python tooling or code generation steps. Models trained natively in Swift can be directly exported to binary artifacts compatible with Apple Neural Engine (ANE), Metal GPU, CPU, and ONNX Runtime.","type":"text"}]},{"type":"heading","level":2,"anchor":"1-Core-ML-Binary-Export-mlmodel","text":"1. Core ML Binary Export (`.mlmodel`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftSci implements binary Protocol Buffer serialization directly conforming to Apple’s "},{"type":"codeVoice","code":"Model.proto"},{"type":"text","text":" specification (v4)."}]},{"type":"heading","text":"Supported Estimators","anchor":"Supported-Estimators","level":3},{"alignments":["left","left","left"],"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Estimator"}]}],[{"type":"paragraph","inlineContent":[{"text":"Core ML Message","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Target Hardware","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"LinearRegression","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GLMRegressor"}]}],[{"inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"LogisticRegression"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"GLMClassifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"DecisionTreeClassifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TreeEnsembleClassifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"DecisionTreeRegressor","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TreeEnsembleRegressor","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"RandomForestClassifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TreeEnsembleClassifier","type":"codeVoice"},{"type":"text","text":" (multi-tree)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RandomForestRegressor"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeEnsembleRegressor"},{"type":"text","text":" (multi-tree)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]]]},{"text":"Using the `CoreMLExportable` Protocol","anchor":"Using-the-CoreMLExportable-Protocol","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All supported model types conform to the "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","isActive":true},{"type":"text","text":" protocol, providing asynchronous export methods:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftML","","\/\/ Train a Random Forest Classifier","let rf = try RandomForestClassifier(nEstimators: 50, maxDepth: 8)","try await rf.fit(features: X_train, targets: y_train)","","\/\/ Export directly to a .mlmodel file","let exportURL = URL(fileURLWithPath: \"\/path\/to\/RandomForest.mlmodel\")","try await rf.writeCoreML(","    to: exportURL,","    featureNames: [\"age\", \"income\", \"credit_score\"],","    outputName: \"approved\"",")"]},{"text":"Direct Serialization via `CoreMLExporter`","anchor":"Direct-Serialization-via-CoreMLExporter","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also use static methods on "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","isActive":true},{"type":"text","text":" to produce binary "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" payloads:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Export fitted linear regression","let modelData = CoreMLExporter.exportBinaryLinearModel(","    name: \"HousePricePredictor\",","    inputNames: [\"sqft\", \"bedrooms\", \"bathrooms\"],","    outputName: \"price\",","    weights: [250.0, 15000.0, 10000.0],","    bias: 50000.0",")","","try modelData.write(to: URL(fileURLWithPath: \"HousePricePredictor.mlmodel\"))"]},{"text":"Exporting Composite Pipelines & Modern .mlpackage","anchor":"Exporting-Composite-Pipelines--Modern-mlpackage","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftSci v3.3.0 supports exporting multi-stage composite pipelines and modern "},{"code":".mlpackage","type":"codeVoice"},{"type":"text","text":" directory bundles:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Export composite pipeline chaining preprocessing + classifier","let pipelineData = CoreMLExporter.exportBinaryPipelineClassifier(","    models: [scalerData, rfData],","    names: [\"Scaler\", \"RandomForestClassifier\"],","    inputNames: [\"age\", \"income\"],","    outputName: \"approved\"",")","","\/\/ Export directly into modern .mlpackage bundle format","try CoreMLExporter.writeMLPackage(","    modelData: pipelineData,","    to: URL(fileURLWithPath: \"\/path\/to\/MyPipeline.mlpackage\"),","    author: \"SwiftSci Developer\",","    description: \"End-to-end data science inference pipeline\"",")"]},{"text":"Loading in Client Applications","anchor":"Loading-in-Client-Applications","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Exported "},{"code":".mlmodel","type":"codeVoice"},{"type":"text","text":" and "},{"code":".mlpackage","type":"codeVoice"},{"type":"text","text":" files can be compiled and loaded dynamically using Apple’s "},{"code":"CoreML","type":"codeVoice"},{"type":"text","text":" framework:"}]},{"syntax":"swift","type":"codeListing","code":["import CoreML","","let compiledURL = try MLModel.compileModel(at: exportURL)","let mlModel = try MLModel(contentsOf: compiledURL)","","let inputDict: [String: Any] = [\"age\": 35.0, \"income\": 75000.0, \"credit_score\": 720.0]","let featureProvider = try MLDictionaryFeatureProvider(dictionary: inputDict)","let output = try mlModel.prediction(from: featureProvider)"]},{"text":"2. ONNX Binary Export (`.onnx`)","anchor":"2-ONNX-Binary-Export-onnx","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftSci provides native binary ONNX wire-format export via "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftML","","let onnxData = ONNXExporter.exportBinaryONNX(","    name: \"LinearONNX\",","    inputs: [\"features\"],","    output: \"prediction\",","    weights: [1.5, -2.0, 0.75],","    bias: 0.5",")","","try onnxData.write(to: URL(fileURLWithPath: \"model.onnx\"))"]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"Exporting Models to Core ML and ONNX","role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftML"}]},"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"kind":"article","seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides