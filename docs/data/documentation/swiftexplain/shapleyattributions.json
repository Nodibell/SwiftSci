{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/shapleyattributions"]}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Black-box machine learning models—such as deep neural networks, random forests, and gradient boosting trees—produce accurate predictions but obscure the individual feature contributions that drove a particular decision.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftExplain"},{"type":"text","text":" provides mathematically grounded, axiomatic interpretability algorithms:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","isActive":true}]},{"type":"text","text":": Path-dependent Shapley attributions for "},{"type":"codeVoice","code":"DecisionTreeClassifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"DecisionTreeRegressor"},{"type":"text","text":", "},{"type":"codeVoice","code":"RandomForestClassifier"},{"type":"text","text":", and "},{"type":"codeVoice","code":"RandomForestRegressor"},{"type":"text","text":". Solves trees with "},{"type":"codeVoice","code":"K <= TreeSHAP.maxExactFeatures"},{"text":" (","type":"text"},{"code":"12","type":"codeVoice"},{"text":") distinct split features exactly via $2^K$ coalition enumeration (","type":"text"},{"code":"O(2^K · L)","type":"codeVoice"},{"text":" per tree), and uses deterministic seeded Monte Carlo permutation sampling (","type":"text"},{"code":"approximationSamples = 2048","type":"codeVoice"},{"text":") with exact additive efficiency enforcement ($\\sum_i \\phi_i = f(x) - \\mathbb{E}[f(X)]$) for larger $K$.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Model-agnostic explainer solving constrained weighted linear regression against an empirical background dataset for any arbitrary asynchronous prediction function.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","isActive":true,"type":"reference"}]},{"text":": Local Interpretable Model-agnostic Explanations fitting ridge linear surrogate models around perturbed neighborhoods.","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"mermaid","code":["graph TD","    Model[Trained Model \/ Ensemble] --> ModelType{Model Architecture}","    ModelType -->|Tree Ensemble \/ Forest| Tree[TreeSHAP: Exact K<=12 \/ Seeded MC K>12]","    ModelType -->|Arbitrary Black-Box \/ Pipeline| Kernel[KernelSHAP: Empirical Regression]","    ModelType -->|Local Linear Surrogate| LIME[LIMEExplainer: Perturbation Neighborhood]","    Tree --> Attributions[Shapley Attributions: sum phi_i = f(x) - E(f)]","    Kernel --> Attributions","    LIME --> SurrogateWeights[Local Coefficients + R^2 Goodness of Fit]","    Attributions --> FeatureRanking[Feature Importance Ranking & Waterfall Breakdown]"]},{"type":"thematicBreak"},{"type":"heading","text":"1. Path-Dependent TreeSHAP for Tree Ensembles","anchor":"1-Path-Dependent-TreeSHAP-for-Tree-Ensembles","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","type":"reference","isActive":true},{"type":"text","text":" evaluates path-dependent conditional expectations over a tree’s internal sample weights (Lundberg et al., 2018; Nature Machine Intelligence):"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"When a tree splits on "},{"type":"codeVoice","code":"K <= TreeSHAP.maxExactFeatures"},{"type":"text","text":" ("},{"type":"codeVoice","code":"12"},{"type":"text","text":") distinct features, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP"},{"text":" enumerates all $2^K$ coalitions to return ","type":"text"},{"inlineContent":[{"type":"text","text":"exact"}],"type":"strong"},{"text":" path-dependent Shapley values (","type":"text"},{"type":"codeVoice","code":"O(2^K · L)"},{"type":"text","text":" per tree)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"K > 12","type":"codeVoice"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","type":"reference"},{"type":"text","text":" switches to deterministic Monte Carlo permutation sampling ("},{"code":"TreeSHAP.approximationSamples = 2048","type":"codeVoice"},{"type":"text","text":" with "},{"code":"permutationSeed","type":"codeVoice"},{"type":"text","text":"), renormalizing any efficiency discrepancy evenly across active features. Use "},{"code":"treeShap.isExact(tree:numFeatures:)","type":"codeVoice"},{"type":"text","text":" to inspect which regime a tree uses."}]}]}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Known limitations in "},{"type":"codeVoice","code":"v3.13.x"},{"type":"text","text":" (deferred to a future release):"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"G-035 (","type":"text"},{"code":"GradientBoostedTreesRegressor","type":"codeVoice"},{"text":")","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"TreeSHAP"},{"type":"text","text":" has no adapter for "},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"type":"text","text":" in "},{"code":"v3.13.x","type":"codeVoice"},{"text":" (","type":"text"},{"code":"explainDetailed(trees:)","type":"codeVoice"},{"text":" averages uniformly by ","type":"text"},{"type":"codeVoice","code":"1\/T"},{"type":"text","text":" rather than summing "},{"type":"codeVoice","code":"initialPrediction + learningRate * sum_m T_m(x)"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"G-036 (Classification & Leaf Weights)","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"code":"FlatTreeNode","type":"codeVoice"},{"type":"text","text":" does not store training sample "},{"code":"cover","type":"codeVoice"},{"type":"text","text":" (all leaves receive uniform "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" weight), "},{"code":"RandomForestClassifier","type":"codeVoice"},{"type":"text","text":" leaves do not persist "},{"code":"classDistribution","type":"codeVoice"},{"type":"text","text":", and "},{"code":"DecisionTreeClassifier.prune(alpha:)","type":"codeVoice"},{"type":"text","text":" clears "},{"code":"classDistribution","type":"codeVoice"},{"type":"text","text":" on pruned leaves. Classifier "},{"code":"TreeSHAP","type":"codeVoice"},{"type":"text","text":" attributes the scalar "},{"code":"node.value","type":"codeVoice"},{"type":"text","text":" label code rather than per-class "},{"code":"predictProbability","type":"codeVoice"},{"type":"text","text":" distributions."}]}]}]}],"style":"important"},{"type":"codeListing","syntax":"swift","code":["import SwiftML","import SwiftExplain","","\/\/ 1. Train a Random Forest model on feature data","let rf = RandomForestClassifier(nEstimators: 50, maxDepth: 6)","try await rf.fit(features: X_train, targets: y_train)","","\/\/ 2. Initialize TreeSHAP explainer","let treeShap = TreeSHAP()","","\/\/ 3. Compute exact Shapley attributions for an individual observation","let testInstance = X_test[0]","let shapValues = await treeShap.explain(randomForest: rf, instance: testInstance)","","\/\/ 4. Rank features by absolute impact on the decision","let featureNames = [\"Income\", \"DebtToIncome\", \"CreditScore\", \"EmploymentYears\", \"LoanAmount\"]","let ranked = zip(featureNames, shapValues).sorted { abs($0.1) > abs($1.1) }","","print(\"Feature attributions for instance:\")","for (name, phi) in ranked {","    let direction = phi >= 0 ? \"+\" : \"-\"","    print(\"  • \\(name): \\(direction)\\(String(format: \"%.4f\", abs(phi)))\")","}"]},{"text":"Concurrent Batch Explanations","anchor":"Concurrent-Batch-Explanations","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For dataset-wide interpretability or global summary plots, compute attributions concurrently across Apple Silicon CPU cores:"}]},{"type":"codeListing","code":["let flatTrees = await rf.flatTrees","let batchAttributions = await treeShap.explainBatch(","    trees: flatTrees,","    instances: X_test,","    numFeatures: featureNames.count",")","print(\"Computed SHAP matrix for \\(batchAttributions.count) instances.\")"],"syntax":"swift"},{"type":"thematicBreak"},{"text":"2. Model-Agnostic Explanations with `KernelSHAP`","anchor":"2-Model-Agnostic-Explanations-with-KernelSHAP","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When interpreting models without tree structures—such as support vector machines, neural decoders, or multi-stage pipelines—"},{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","type":"reference","isActive":true},{"type":"text","text":" estimates Shapley values through weighted linear regression over coalition permutations:"}],"type":"paragraph"},{"code":["import SwiftExplain","","\/\/ 1. Initialize KernelSHAP explainer actor","let kernelShap = KernelSHAP()","","\/\/ 2. Compute Shapley attributions using background baseline dataset","let attributions = await kernelShap.explain(","    model: { features in","        \/\/ Any asynchronous prediction function mapping [Double] -> Double","        return await myNeuralNetwork.predict(features)","    },","    instance: testInstance,","    background: backgroundSampleData,","    numCoalitions: 300",")","","print(\"KernelSHAP Attributions: \\(attributions)\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"3. Local Surrogate Explanations with LIME","anchor":"3-Local-Surrogate-Explanations-with-LIME","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","type":"reference","isActive":true},{"type":"text","text":" perturbs the target instance with Gaussian noise, queries the black-box model on the neighborhood, and trains an interpretable, locally-weighted ridge linear surrogate:"}],"type":"paragraph"},{"code":["import SwiftExplain","","let lime = LIMEExplainer(kernelWidth: 0.75, regularization: 1.0)","","let explanation = await lime.explain(","    model: { x in await complexPipeline.predictScore(x) },","    instance: testInstance,","    numSamples: 500",")","","print(\"Local Model Intercept: \\(explanation.intercept)\")","print(\"Local Surrogate Fidelity (R²): \\(String(format: \"%.3f\", explanation.localR2))\")","","for (idx, weight) in explanation.featureWeights.enumerated() {","    print(\"Feature \\(idx) Local Weight: \\(String(format: \"%.4f\", weight))\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"}],"kind":"content"}],"metadata":{"modules":[{"name":"SwiftExplain"}],"roleHeading":"API Collection","title":"SHAP & LIME Model Interpretability","role":"collectionGroup"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Explainability-Engines","title":"Explainability Engines","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAPExplanation","doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer"]}],"kind":"article","abstract":[{"text":"Explain machine learning model predictions with game-theoretic Shapley value attributions (TreeSHAP, KernelSHAP) and local linear surrogates (LIME).","type":"text"}],"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability"]}],"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}],"url":"\/documentation\/swiftexplain\/kernelshap","title":"KernelSHAP","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KernelSHAP"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"},"doc://SwiftExplain/documentation/SwiftExplain/TreeSHAP":{"type":"topic","navigatorTitle":[{"text":"TreeSHAP","kind":"identifier"}],"title":"TreeSHAP","url":"\/documentation\/swiftexplain\/treeshap","role":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeSHAP","kind":"identifier"}],"abstract":[{"text":"TreeSHAP (Tree Shapley Additive Explanations) for decision trees and random forests","type":"text"},{"text":" ","type":"text"},{"text":"(path-dependent formulation following Lundberg et al., 2018; Nature Machine Intelligence).","type":"text"}],"kind":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain/LIMEExplainer":{"abstract":[{"type":"text","text":"Local Interpretable Model-agnostic Explanations (LIME)."}],"role":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","url":"\/documentation\/swiftexplain\/limeexplainer","kind":"symbol","type":"topic","navigatorTitle":[{"text":"LIMEExplainer","kind":"identifier"}],"title":"LIMEExplainer","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"LIMEExplainer"}]},"doc://SwiftExplain/documentation/SwiftExplain/TreeSHAPExplanation":{"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"TreeSHAPExplanation","kind":"identifier"}],"abstract":[{"type":"text","text":"Explanation structure containing TreeSHAP attributions and baseline predictions"},{"type":"text","text":" "},{"type":"text","text":"(exact when "},{"type":"codeVoice","code":"K <= TreeSHAP.maxExactFeatures"},{"text":", seeded Monte Carlo permutation estimate otherwise).","type":"text"}],"type":"topic","kind":"symbol","title":"TreeSHAPExplanation","navigatorTitle":[{"text":"TreeSHAPExplanation","kind":"identifier"}],"url":"\/documentation\/swiftexplain\/treeshapexplanation","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAPExplanation","role":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain":{"type":"topic","role":"collection","kind":"symbol","abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"url":"\/documentation\/swiftexplain","title":"SwiftExplain","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain"},"doc://SwiftExplain/documentation/SwiftExplain/ModelInterpretability":{"role":"article","abstract":[{"text":"Understand black-box machine learning predictions using ","type":"text"},{"type":"codeVoice","code":"TreeSHAP"},{"text":", ","type":"text"},{"type":"codeVoice","code":"KernelSHAP"},{"text":", ","type":"text"},{"type":"codeVoice","code":"LIMEExplainer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PermutationImportance"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"PartialDependencePlot"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability","title":"Model Interpretability & XAI Guide","kind":"article","type":"topic","url":"\/documentation\/swiftexplain\/modelinterpretability"}}}