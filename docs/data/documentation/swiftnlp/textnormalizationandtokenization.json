{"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}],"type":"paragraph"},{"text":"1. Multi-lingual Word & Sentence Tokenization","level":3,"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","type":"heading"},{"code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"syntax":"swift","type":"codeListing"},{"text":"2. POS Tagging, Lemmatization & Entity Extraction","level":3,"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","type":"heading"},{"code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"syntax":"swift","type":"codeListing"},{"text":"3. Sentiment Analysis (VADER & NLSentiment)","level":3,"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","type":"heading"},{"code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftNLP"}],"role":"article","title":"Text Normalization, Tokenization & Linguistic Tagging"},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","sections":[],"abstract":[{"text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native ","type":"text"},{"code":"NaturalLanguage","type":"codeVoice"},{"text":" framework.","type":"text"}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"title":"Guides & Tutorials","generated":true}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"references":{"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"kind":"article","title":"Text Feature Vectorization, Embeddings & Naive Bayes Classification","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","url":"\/documentation\/swiftnlp\/vectorizationandembeddings","abstract":[{"text":"Convert text corpora into numerical feature matrices using ","type":"text"},{"type":"codeVoice","code":"CountVectorizer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"HashingVectorizer"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"TFIDFVectorizer"},{"text":", query ","type":"text"},{"type":"codeVoice","code":"WordEmbeddings"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppleNLEmbedding"},