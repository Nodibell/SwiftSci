{"hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"code":"SwiftVision","type":"codeVoice"},{"type":"text","text":" implements the full "},{"inlineContent":[{"type":"text","text":"YOLOv8"}],"type":"strong"},{"type":"text","text":" deep learning architecture in native Swift and MLX. The pipeline combines Apple Accelerate "},{"code":"vImageScale_PlanarF","type":"codeVoice"},{"type":"text","text":" for bilinear letterbox scaling, deep CSPDarknet backbone evaluation, decoupled PANet feature pyramid routing, and anchorless box decoding with Non-Maximum Suppression (NMS)."}],"type":"paragraph"},{"code":["Input Image (RGB \/ File \/ CVPixelBuffer)","               │","               ▼","┌────────────────────────────────────────┐","│ Apple Accelerate vImage Letterbox      │ ───► Resizes to 640x640 with (114, 114, 114) padding","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOBackbone (CSPDarknet + SPPF)       │ ───► P3, P4, P5 multi-scale feature maps","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLONeck (PANet Feature Pyramid)       │ ───► Top-down & bottom-up cross-scale fusion","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOHead (Decoupled Class & Box DFL)   │ ───► 8,400 raw candidate anchor predictions","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ Vectorized Non-Maximum Suppression     │ ───► Final BoundingBoxes with class IDs & confidences","└────────────────────────────────────────┘"],"type":"codeListing","syntax":null},{"type":"thematicBreak"},{"text":"1. Loading Weights and Executing Detection","anchor":"1-Loading-Weights-and-Executing-Detection","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Load pre-trained "},{"code":".onnx","type":"codeVoice"},{"type":"text","text":" or "},{"code":".safetensors","type":"codeVoice"},{"type":"text","text":" model weights and detect objects:"}],"type":"paragraph"},{"code":["import Foundation","import SwiftVision","","\/\/ 1. Initialize YOLOv8 detector from model weights file","let modelURL = URL(fileURLWithPath: \"yolov8n.onnx\")","let detector = try YOLOv8Detector(weightsURL: modelURL)","","\/\/ 2. Perform object detection on an image file","let imageURL = URL(fileURLWithPath: \"street_scene.jpg\")","let detections = try await detector.detect(","    imageURL: imageURL,","    confidenceThreshold: 0.4,","    iouThreshold: 0.45",")","","print(\"=== YOLOv8 Detection Results ===\")","for box in detections {","    let rect = box.rect","    print(\"Class: '\\(box.className)' (ID: \\(box.classId)) | Confidence: \\(String(format: \"%.2f%%\", box.confidence * 100)) | Box: [x=\\(rect.minX), y=\\(rect.minY), w=\\(rect.width), h=\\(rect.height)]\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"2. Hardware-Accelerated Letterbox Preprocessing (`vImage`)","anchor":"2-Hardware-Accelerated-Letterbox-Preprocessing-vImage","type":"heading","level":2},{"inlineContent":[{"code":"YOLOPreprocessor","type":"codeVoice"},{"type":"text","text":" uses Apple Accelerate’s "},{"code":"vImageScale_PlanarF","type":"codeVoice"},{"type":"text","text":" with "},{"code":"kvImageHighQualityResampling","type":"codeVoice"},{"type":"text","text":", performing aspect-ratio preserving downsampling directly in hardware:"}],"type":"paragraph"},{"code":["import SwiftVision","","\/\/ Preprocess raw image buffer into normalized Float32 planar tensor","let inputImage = URL(fileURLWithPath: \"input_1920x1080.jpg\")","let (tensorBuffer, scaleFactor, padX, padY) = try YOLOPreprocessor.preprocess(","    imageURL: inputImage,","    targetSize: (width: 640, height: 640)",")","","print(\"Preprocessed tensor count: \\(tensorBuffer.count) Float elements.\")","print(\"Scale Factor: \\(scaleFactor), Padding: (\\(padX), \\(padY))\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"3. Training & Batching Image Datasets","anchor":"3-Training--Batching-Image-Datasets","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Load and normalize computer vision datasets in compact "},{"code":"Float32","type":"codeVoice"},{"type":"text","text":" tensors:"}],"type":"paragraph"},{"code":["let dataset = try ImageDataset(","    directoryURL: URL(fileURLWithPath: \"coco_val2017\/\"),","    targetSize: (width: 256, height: 256),","    normalize: true",")","","print(\"Loaded \\(dataset.count) images. Memory per image: \\(dataset.data.count * 4 \/ 1024) KB.\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/RealTimeYOLOInference","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"SwiftVision"}],"role":"article","title":"Real-Time YOLOv8 Object Detection & Hardware Acceleration","roleHeading":"Article"},"kind":"article","abstract":[{"text":"Execute real-time anchor-free object detection on Apple Silicon GPU and Neural Engine using ","type":"text"},{"code":"YOLOv8Detector","type":"codeVoice"},{"text":", ","type":"text"},{"code":"YOLOPreprocessor","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"ImageDataset","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/swiftvision\/realtimeyoloinference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftVision/documentation/SwiftVision":{"role":"collection","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision","type":"topic","url":"\/documentation\/swiftvision","kind":"symbol","abstract":[{"text":"Computer Vision Neural Inference, Object Detection & Image Datasets.","type":"text"}],"title":"SwiftVision"}}}