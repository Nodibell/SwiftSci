{"topicSections":[{"title":"SHAP Explainer APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"anchor":"SHAP-Explainer-APIs"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/kernelshaptheory"]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}],"type":"strong"},{"type":"text","text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory."}],"type":"paragraph"},{"level":2,"text":"1. The Four Shapley Axioms","anchor":"1-The-Four-Shapley-Axioms","type":"heading"},{"inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Efficiency"}],"type":"strong"},{"type":"text","text":": Feature attributions sum up to the difference between model prediction "},{"type":"codeVoice","code":"f(x)"},{"type":"text","text":" and expected background prediction "},{"type":"codeVoice","code":"E[f(X)]"},{"type":"text","text":":"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Symmetry","type":"text"}],"type":"strong"},{"type":"text","text":": If two features contribute equally to all possible feature subsets, their attributions are equal."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Dummy (Null Player)"}],"type":"strong"},{"text":": A feature that does not change the model prediction for any coalition receives an attribution of zero (","type":"text"},{"code":"φ_i = 0","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Additivity"}]},{"text":": For ensemble models ","type":"text"},{"code":"f = f1 + f2","type":"codeVoice"},{"text":", attributions satisfy ","type":"text"},{"code":"φ_i(f) = φ_i(f1) + φ_i(f2)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"2-Explaining-Predictions-in-SwiftSci","level":2,"type":"heading","text":"2. Explaining Predictions in SwiftSci"},{"syntax":"swift","type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"]}],"kind":"content"}],"metadata":{"role":"collectionGroup","title":"Game-Theoretic Interpretability with Kernel SHAP","modules":[{"name":"SwiftExplain"}],"roleHeading":"API Collection"},"abstract":[{"text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory","interfaceLanguage":"swift"},"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"type":"topic","navigatorTitle":[{"text":"KernelSHAP","kind":"identifier"}],"title":"KernelSHAP","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KernelSHAP","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}],"url":"\/documentation\/swiftexplain\/kernelshap"},"doc://SwiftExplain/documentation/SwiftExplain":{"url":"\/documentation\/swiftexplain","type":"topic","kind":"symbol","title":"SwiftExplain","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","role":"collection"}}}