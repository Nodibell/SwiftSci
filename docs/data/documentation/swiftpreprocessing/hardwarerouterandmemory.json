{"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"Apple Silicon features a ","type":"text"},{"type":"strong","inlineContent":[{"text":"Unified Memory Architecture (UMA)","type":"text"}]},{"type":"text","text":" where the CPU, GPU, and Apple Neural Engine (ANE) share a single high-bandwidth memory pool. "},{"type":"codeVoice","code":"SwiftPreprocessing"},{"type":"text","text":" provides intelligent hardware routing and memory reservation primitives to prevent GPU saturation and avoid data copying."}],"type":"paragraph"},{"type":"heading","anchor":"1-The-Hardware-Router","text":"1. The Hardware Router","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"HardwareRouter"},{"type":"text","text":" assesses tensor dimensions and operation complexity to select the optimal computing engine:"}]},{"type":"codeListing","code":["graph TD","    Op[Compute Operation] --> Router{HardwareRouter}","    Router -->|Small \/ Vector < 50k| CPU[Accelerate \/ AMX \/ NEON]","    Router -->|Large Matrix \/ Autodiff| GPU[MLX Metal GPU]","    Router -->|Static Inference| ANE[Core ML Engine]"],"syntax":"mermaid"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Small Vectors ("},{"code":"N < 50,000","type":"codeVoice"},{"type":"text","text":")"}]},{"type":"text","text":": Routed to CPU Accelerate (vDSP\/BLAS\/LAPACK) to eliminate GPU kernel dispatch latency."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Large Tensors & Deep Learning"}],"type":"strong"},{"text":": Routed to MLX Metal GPU for massive parallel throughput.","type":"text"}]}]}]},{"type":"heading","anchor":"2-WiredMemoryManager--Ticket-System","text":"2. WiredMemoryManager & Ticket System","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To prevent out-of-memory (OOM) conditions during concurrent analytical workloads, "},{"type":"codeVoice","code":"WiredMemoryManager"},{"type":"text","text":" implements an asynchronous FIFO reservation system:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftPreprocessing","","\/\/ Acquire a GPU execution slot","let ticket = try await WiredMemoryManager.shared.reserveMemory(estimatedBytes: 64 * 1024 * 1024)","","\/\/ Execute heavy MLX operations","\/\/ ...","","\/\/ Automatically flushes GPU caches upon completion","await ticket.release()"]}],"kind":"content"}],"abstract":[{"type":"text","text":"Understand how SwiftSci automatically routes workloads between CPU (Accelerate\/AMX\/NEON) and Metal GPU (MLX) with strict concurrency safety."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouterAndMemory"},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/hardwarerouterandmemory"]}],"topicSections":[{"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket"],"title":"Memory & Routing APIs","anchor":"Memory--Routing-APIs"}],"sections":[],"kind":"article","metadata":{"role":"collectionGroup","roleHeading":"API Collection","title":"Hardware Routing & Unified Memory Governance","modules":[{"name":"SwiftPreprocessing"}]},"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/HardwareRouter":{"kind":"symbol","role":"symbol","url":"\/documentation\/swiftpreprocessing\/hardwarerouter","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"HardwareRouter"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"HardwareRouter"}],"title":"HardwareRouter","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","abstract":[{"type":"text","text":"Serializes device selection and MLX default-device changes (global MLX state)."}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryTicket":{"role":"symbol","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket","type":"topic","title":"WiredMemoryTicket","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"WiredMemoryTicket"}],"kind":"symbol","url":"\/documentation\/swiftpreprocessing\/wiredmemoryticket","abstract":[{"type":"text","text":"A ticket representing a reservation of memory and a concurrency slot."}],"navigatorTitle":[{"kind":"identifier","text":"WiredMemoryTicket"}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"abstract":[{"type":"text","text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines."}],"role":"collection","type":"topic","title":"SwiftPreprocessing","url":"\/documentation\/swiftpreprocessing","kind":"symbol","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryManager":{"abstract":[{"text":"Actor-based manager that controls concurrent allocations and tasks in Apple Silicon Unified Memory.","type":"text"}],"role":"symbol","type":"topic","title":"WiredMemoryManager","navigatorTitle":[{"text":"WiredMemoryManager","kind":"identifier"}],"url":"\/documentation\/swiftpreprocessing\/wiredmemorymanager","kind":"symbol","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"WiredMemoryManager"}]}}}