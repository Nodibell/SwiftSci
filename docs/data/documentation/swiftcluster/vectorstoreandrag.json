{"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Vector databases are essential for modern semantic search and AI agent knowledge retrieval. ","type":"text"},{"code":"SwiftCluster","type":"codeVoice"},{"text":" provides ","type":"text"},{"code":"VectorStore","type":"codeVoice"},{"text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations (","type":"text"},{"code":"vDSP_dotprD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_svesqD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_distancesqD","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"heading","text":"1. Creating a VectorStore","anchor":"1-Creating-a-VectorStore","level":2},{"type":"codeListing","code":["import SwiftCluster","import SwiftNLP","","\/\/ Initialize vector store with Cosine Similarity","let store = VectorStore(metric: .cosineSimilarity)","","\/\/ Generate dense text embeddings","let engine = LocalEmbeddingEngine(dimension: 128)","","let articles = [","    (id: \"art_1\", title: \"Apple Silicon Architecture\", text: \"Unified memory and neural engine overview\"),","    (id: \"art_2\", title: \"Swift Strict Concurrency\", text: \"Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"],"syntax":"swift"},{"type":"heading","text":"2. Top-K Semantic Search","anchor":"2-Top-K-Semantic-Search","level":2},{"type":"codeListing","code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"],"syntax":"swift"},{"type":"heading","text":"3. Supported Metrics","anchor":"3-Supported-Metrics","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".cosineSimilarity"}]},{"type":"text","text":": Ideal for normalized text embeddings (returns $[-1.0, 1.0]$)."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".dotProduct"}],"type":"strong"},{"text":": Direct inner product for unnormalized projections.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}]},{"type":"text","text":": Geometric $L_2$ distance for spatial clustering."}]}]}]}]}],"metadata":{"roleHeading":"API Collection","title":"In-Memory VectorStore & On-Device RAG","role":"collectionGroup","modules":[{"name":"SwiftCluster"}]},"kind":"article","abstract":[{"type":"text","text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate."}],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Vector Store Types","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"],"anchor":"Vector-Store-Types"}],"variants":[{"paths":["\/documentation\/swiftcluster\/vectorstoreandrag"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftCluster/documentation/SwiftCluster":{"role":"collection","title":"SwiftCluster","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"PCA Dimensionality Reduction & Unsupervised Clustering."}],"url":"\/documentation\/swiftcluster"},"doc://SwiftCluster/documentation/SwiftCluster/VectorStore":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorStore","kind":"identifier"}],"title":"VectorStore","type":"topic","navigatorTitle":[{"text":"VectorStore","kind":"identifier"}],"abstract":[{"text":"An in-memory vector database and similarity search index optimized for Apple Silicon.","type":"text"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","kind":"symbol","url":"\/documentation\/swiftcluster\/vectorstore","role":"symbol"},"doc://SwiftCluster/documentation/SwiftCluster/VectorMetric":{"navigatorTitle":[{"text":"VectorMetric","kind":"identifier"}],"type":"topic","url":"\/documentation\/swiftcluster\/vectormetric","title":"VectorMetric","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorMetric","kind":"identifier"}],"abstract":[{"text":"Distance or similarity metrics supported by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore"},{"text":".","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","role":"symbol"},"doc://SwiftCluster/documentation/SwiftCluster/VectorSearchResult":{"navigatorTitle":[{"text":"VectorSearchResult","kind":"identifier"}],"type":"topic","url":"\/documentation\/swiftcluster\/vectorsearchresult","title":"VectorSearchResult","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorSearchResult","kind":"identifier"}],"abstract":[{"type":"text","text":"Represents a single nearest-neighbor match result from a vector search query."}],"kind":"symbol","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","role":"symbol"}}}