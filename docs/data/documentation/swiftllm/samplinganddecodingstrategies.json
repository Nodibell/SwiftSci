{"sections":[],"abstract":[{"text":"Control autoregressive language generation with Temperature, Top-P Nucleus, Top-K, and Repetition Penalty.","type":"text"}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/samplinganddecodingstrategies"]}],"topicSections":[{"anchor":"Sampling-Types","title":"Sampling Types","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions"]}],"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"During autoregressive language generation, logits from the transformer output layer are converted into probability distributions over the vocabulary:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"$$P(w_i) = \\frac{\\exp(z_i \/ T)}{\\sum_j \\exp(z_j \/ T)}$$"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Where $T$ is the "},{"type":"strong","inlineContent":[{"text":"Temperature","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"1. Supported Sampling Methods","type":"heading","anchor":"1-Supported-Sampling-Methods"},{"rows":[[[{"inlineContent":[{"text":"Parameter","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Mathematical Formulation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Effect","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Temperature ($T$)"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Softmax scaling factor","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Lower = deterministic\/focused; Higher = creative\/diverse","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Top-K"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Truncate to top $K$ probabilities","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Eliminates low-probability tail tokens","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Top-P (Nucleus)"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Smallest set with $\\sum P(w) \\ge p$","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Dynamically adjusts pool size based on confidence","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Repetition Penalty"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"$z_i \\leftarrow z_i \/ \\theta$ if $w_i \\in \\text{history}$","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Penalizes tokens already generated in current context"}],"type":"paragraph"}]]],"alignments":["left","left","left"],"type":"table","header":"row"},{"level":2,"text":"2. Code Example","type":"heading","anchor":"2-Code-Example"},{"type":"codeListing","syntax":"swift","code":["import SwiftLLM","","let params = GenerationParameters(","    temperature: 0.7,","    topP: 0.9,","    topK: 40,","    repetitionPenalty: 1.1,","    maxTokens: 100",")","","let outputText = try await model.generate(prompt: \"Explain neural attention:\", parameters: params)"]}],"kind":"content"}],"metadata":{"modules":[{"name":"SwiftLLM"}],"roleHeading":"API Collection","title":"Token Sampling & Decoding Strategies","role":"collectionGroup"},"references":{"doc://SwiftLLM/documentation/SwiftLLM":{"abstract":[{"text":"Local Causal Transformer Decoder & Weight Parsers.","type":"text"}],"title":"SwiftLLM","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","url":"\/documentation\/swiftllm","role":"collection"},"doc://SwiftLLM/documentation/SwiftLLM/LLMOptions":{"title":"LLMOptions","abstract":[{"text":"Options configuring generative text inference.","type":"text"}],"type":"topic","url":"\/documentation\/swiftllm\/llmoptions","kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","navigatorTitle":[{"text":"LLMOptions","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LLMOptions","kind":"identifier"}]},"doc://SwiftLLM/documentation/SwiftLLM/Sampler":{"title":"Sampler","url":"\/documentation\/swiftllm\/sampler","abstract":[{"text":"Generates next token predictions from logits using probabilistic sampling.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"role":"symbol","type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler"}}}