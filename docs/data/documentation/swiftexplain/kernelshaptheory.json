{"metadata":{"title":"Game-Theoretic Interpretability with Kernel SHAP","modules":[{"name":"SwiftExplain"}],"role":"collectionGroup","roleHeading":"API Collection"},"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"SHAP Explainer APIs","anchor":"SHAP-Explainer-APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"]}],"abstract":[{"text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftexplain\/kernelshaptheory"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"sections":[],"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SHAP (SHapley Additive exPlanations)"}]},{"text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory.","type":"text"}]},{"text":"1. The Four Shapley Axioms","type":"heading","level":2,"anchor":"1-The-Four-Shapley-Axioms"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Efficiency","type":"text"}]},{"type":"text","text":": Feature attributions sum up to the difference between model prediction "},{"type":"codeVoice","code":"f(x)"},{"type":"text","text":" and expected background prediction "},{"type":"codeVoice","code":"E[f(X)]"},{"type":"text","text":":"}]},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"code":"Σ_i=1..M φ_i = f(x) - E[f(X)]","type":"codeVoice"}],"type":"paragraph"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Symmetry","type":"text"}]},{"type":"text","text":": If two features contribute equally to all possible feature subsets, their attributions are equal."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dummy (Null Player)"}]},{"type":"text","text":": A feature that does not change the model prediction for any coalition receives an attribution of zero ("},{"type":"codeVoice","code":"φ_i = 0"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Additivity","type":"text"}]},{"type":"text","text":": For ensemble models "},{"type":"codeVoice","code":"f = f1 + f2"},{"type":"text","text":", attributions satisfy "},{"type":"codeVoice","code":"φ_i(f) = φ_i(f1) + φ_i(f2)"},{"type":"text","text":"."}]}]}]},{"anchor":"2-Explaining-Predictions-in-SwiftSci","type":"heading","level":2,"text":"2. Explaining Predictions in SwiftSci"},{"type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"],"syntax":"swift"}],"kind":"content"}],"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"KernelSHAP"}],"role":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","url":"\/documentation\/swiftexplain\/kernelshap","type":"topic","title":"KernelSHAP","kind":"symbol","abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}]},"doc://SwiftExplain/documentation/SwiftExplain":{"type":"topic","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","url":"\/documentation\/swiftexplain","role":"collection","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}],"kind":"symbol","title":"SwiftExplain"}}}