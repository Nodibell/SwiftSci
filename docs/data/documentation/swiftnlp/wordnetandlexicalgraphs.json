{"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNetAndLexicalGraphs","interfaceLanguage":"swift"},"metadata":{"title":"WordNet Semantic Hierarchy & Lexical Graphs","modules":[{"name":"SwiftNLP"}],"role":"collectionGroup","roleHeading":"API Collection"},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WordNet"},{"type":"text","text":" is a large lexical database of English where nouns, verbs, adjectives, and adverbs are organized into sets of cognitive synonyms called "},{"type":"strong","inlineContent":[{"type":"text","text":"Synsets"}]},{"type":"text","text":", interlinked by conceptual-semantic and lexical relations."}]},{"type":"heading","level":2,"text":"1. Looking Up Synsets & Definitions","anchor":"1-Looking-Up-Synsets--Definitions"},{"code":["import SwiftNLP","","let wordnet = WordNet.shared","","\/\/ Look up all noun synsets for \"bank\"","let synsets = wordnet.synsets(for: \"bank\", pos: .noun)","for s in synsets {","    print(\"ID: \\(s.id), Definition: \\(s.definition)\")","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"2. Semantic Similarity Metrics","anchor":"2-Semantic-Similarity-Metrics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftSci implements standard lexical similarity algorithms:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Path Similarity","type":"text"}],"type":"strong"},{"text":": Shortest path distance in the hypernym taxonomy:","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"Sim_path(s1, s2) = 1 \/ (1 + distance(s1, s2))"}]}],"style":"note","name":"Note","type":"aside"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wu-Palmer Similarity (WUP)"}]},{"text":": Measures depth of least common subsumer (LCS) relative to synset depths:","type":"text"}]},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"code":"Sim_wup(s1, s2) = (2 · depth(LCS)) \/ (depth(s1) + depth(s2))","type":"codeVoice"}],"type":"paragraph"}],"name":"Note"}]}]},{"type":"codeListing","code":["let dog = wordnet.synset(\"dog.n.01\")!","let cat = wordnet.synset(\"cat.n.01\")!","","let pathSim = wordnet.pathSimilarity(dog, cat)","let wupSim = wordnet.wuPalmerSimilarity(dog, cat)","","print(\"Path Similarity: \\(pathSim), Wu-Palmer: \\(wupSim)\")"],"syntax":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Navigate semantic relationships, compute synset distances, and explore English hypernym\/hyponym trees."}],"topicSections":[{"title":"WordNet Types","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNet","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/Synset","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS"],"anchor":"WordNet-Types"}],"variants":[{"paths":["\/documentation\/swiftnlp\/wordnetandlexicalgraphs"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/Synset":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Synset"}],"navigatorTitle":[{"kind":"identifier","text":"Synset"}],"kind":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/Synset","role":"symbol","url":"\/documentation\/swiftnlp\/synset","title":"Synset","abstract":[{"type":"text","text":"Represents a WordNet Synset (Syntactic\/Semantic Set of Synonym Concepts)."}],"type":"topic"},"doc://SwiftNLP/documentation/SwiftNLP/POS":{"iden