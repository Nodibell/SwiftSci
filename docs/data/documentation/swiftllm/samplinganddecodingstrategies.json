{"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"abstract":[{"text":"Control autoregressive language generation with Temperature, Top-P Nucleus, Top-K, and Repetition Penalty.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"During autoregressive language generation, logits from the transformer output layer are converted into probability distributions over the vocabulary. "},{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" executes sampling transformations strictly at the unnormalized logits level prior to softmax evaluation:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"$$\\text{Logits} \\xrightarrow{\\text{Repetition Penalty}} \\xrightarrow{\\text{Temperature}} \\xrightarrow{\\text{Top-K Mask (-inf)}} \\xrightarrow{\\text{Top-P Mask (-inf)}} \\xrightarrow{\\text{Softmax}} \\xrightarrow{\\text{Sample}}$$"}]},{"text":"1. Supported Sampling Methods","type":"heading","anchor":"1-Supported-Sampling-Methods","level":2},{"header":"row","type":"table","alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mathematical Formulation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Semantics & Defaults"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Temperature (","type":"text"},{"code":"temperature","type":"codeVoice"},{"text":")","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"$z_i \\leftarrow z_i \/ T$"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Controls distribution entropy. "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" = identity; "},{"code":"0.0","type":"codeVoice"},{"type":"text","text":" = greedy deterministic argmax. Default: "},{"code":"0.7","type":"codeVoice"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Top-K (","type":"text"},{"code":"topK","type":"codeVoice"},{"text":")","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Masks all tokens outside top $K$ with $-\\infty$"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Eliminates low-probability tail tokens. "},{"code":"0","type":"codeVoice"},{"type":"text","text":" disables Top-K filtering. Default: "},{"code":"40","type":"codeVoice"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Top-P Nucleus (","type":"text"},{"code":"topP","type":"codeVoice"},{"text":")","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Retains cumulative probability $\\sum P(w_i) \\ge p$"}]}],[{"type":"paragraph","inlineContent":[{"text":"Dynamically bounds candidates based on probability mass. ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" disables Top-P. Default: ","type":"text"},{"code":"0.9","type":"codeVoice"},{"text":".","type":"text"}]}]],[[{"inlineContent":[{"inlineContent":[{"text":"Repetition Penalty (","type":"text"},{"code":"repetitionPenalty","type":"codeVoice"},{"text":")","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"$z_i \\leftarrow z_i > 0 \\ ? \\ z_i \/ \\theta : z_i \\cdot \\theta$","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Penalizes tokens previously emitted in generation history. ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" disables penalty. Default: ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]]]},{"anchor":"2-Configuration--Code-Example","text":"2. Configuration & Code Example","level":2,"type":"heading"},{"inlineContent":[{"text":"Generation options are unified within ","type":"text"},{"code":"SamplingConfiguration","type":"codeVoice"},{"text":", serving as the single source of truth inside ","type":"text"},{"code":"LLMOptions","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import SwiftLLM","","\/\/ 1. Define decoupled sampling parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","\/\/ 2. Configure model generation options","let options = LLMOptions(","    maxTokens: 128,","    stopTokens: [128001, 128009],","    sampling: sampling",")","","\/\/ 3. Stream generated tokens asynchronously","for try await token in model.generateStream(prompt: \"Explain rotary positional embeddings:\", options: options) {","    print(token, terminator: \"\")","}"],"syntax":"swift","type":"codeListing"}]}],"kind":"article","sections":[],"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftLLM"}],"title":"Token Sampling & Decoding Strategies"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/samplinganddecodingstrategies"]}],"identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions"],"title":"Sampling Types","anchor":"Sampling-Types"}],"references":{"doc://SwiftLLM/documentation/SwiftLLM/LLMOptions":{"kind":"symbol","url":"\/documentation\/swiftllm\/llmoptions","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"LLMOptions"}],"title":"LLMOptions","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Options configuring generative text inference."}],"navigatorTitle":[{"kind":"identifier","text":"LLMOptions"}]},"doc://SwiftLLM/documentation/SwiftLLM/SamplingConfiguration":{"role":"symbol","navigatorTitle":[{"text":"SamplingConfiguration","kind":"identifier"}],"url":"\/documentation\/swiftllm\/samplingconfiguration","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SamplingConfiguration"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","title":"SamplingConfiguration","abstract":[{"type":"text","text":"Fine-grained configuration of the generative token sampling pipeline."}]},"doc://SwiftLLM/documentation/SwiftLLM/Sampler":{"kind":"symbol","type":"topic","title":"Sampler","url":"\/documentation\/swiftllm\/sampler","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","abstract":[{"type":"text","text":"Generates next token predictions from logits using probabilistic sampling."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sampler","kind":"identifier"}],"navigatorTitle":[{"text":"Sampler","kind":"identifier"}],"role":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM":{"role":"collection","url":"\/documentation\/swiftllm","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","type":"topic","kind":"symbol","title":"SwiftLLM","abstract":[{"type":"text","text":"Local Causal Transformer Decoder & Weight Parsers."}]}}}