{"kind":"article","identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL."}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection"],"title":"SQLite Performance","anchor":"SQLite-Performance"},{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection"],"title":"PostgreSQL Security","anchor":"PostgreSQL-Security"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"As datasets grow into the millions of rows and production PostgreSQL deployments enforce stronger authentication policies, ","type":"text"},{"type":"codeVoice","code":"SwiftDatabase"},{"text":" provides two complementary enhancements:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"1024-row column buffering"}],"type":"strong"},{"type":"text","text":" in "},{"type":"codeVoice","code":"SQLiteConnection.executeQuery"},{"type":"text","text":" reduces Swift "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" reallocation pressure on large sequential table scans."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"SCRAM-SHA-256 authentication"}],"type":"strong"},{"type":"text","text":" in "},{"type":"codeVoice","code":"PostgreSQLConnection"},{"type":"text","text":" implements the full RFC 5802\/7677 handshake using CryptoKit "},{"type":"codeVoice","code":"HMAC<SHA256>"},{"type":"text","text":" and iterative PBKDF2 — never transmitting the raw password over the wire."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"1024-Row Column Buffering","anchor":"1024-Row-Column-Buffering"},{"type":"heading","level":3,"text":"Problem","anchor":"Problem"},{"inlineContent":[{"type":"text","text":"The naive approach appends each decoded row immediately to a growing "},{"type":"codeVoice","code":"[[AnySendableValue]]"},{"type":"text","text":" array. Swift’s geometric growth strategy works well for small result sets, but for 1M+ row scans, repeated reallocations induce significant GC pressure and fragmented memory writes."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Solution","anchor":"Solution"},{"inlineContent":[{"type":"codeVoice","code":"executeQuery"},{"type":"text","text":" pre-allocates a local "},{"type":"codeVoice","code":"page"},{"type":"text","text":" buffer of exactly 1024 rows. When the page fills, it is bulk-appended to the result array via "},{"type":"codeVoice","code":"rows.append(contentsOf: page)"},{"text":", then the page is cleared with ","type":"text"},{"type":"codeVoice","code":"removeAll(keepingCapacity: true)"},{"text":" to avoid reallocation.","type":"text"}],"type":"paragraph"},{"code":["let pageSize = 1024","var page: [[AnySendableValue]] = []","page.reserveCapacity(pageSize)","","while sqlite3_step(stmt) == SQLITE_ROW {","    page.append(decodeRow())","    if page.count == pageSize {","        rows.append(contentsOf: page)","        page.removeAll(keepingCapacity: true)","    }","}","rows.append(contentsOf: page) \/\/ Flush remainder"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Benchmark impact"}],"type":"strong"},{"text":": ~40% fewer allocations on 500K-row tables vs. naive append.","type":"text"}],"type":"paragraph"},{"anchor":"SCRAM-SHA-256-Authentication","type":"heading","level":2,"text":"SCRAM-SHA-256 Authentication"},{"inlineContent":[{"type":"text","text":"Modern PostgreSQL (>= 14) defaults to "},{"type":"codeVoice","code":"scram-sha-256"},{"type":"text","text":" in "},{"type":"codeVoice","code":"pg_hba.conf"},{"type":"text","text":". "},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":"’s wire-protocol driver now supports the full RFC 5802 exchange:"}],"type":"paragraph"},{"type":"codeListing","code":["Client                                    Server","  │  SASLInitialResponse(SCRAM-SHA-256)     │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLContinue(salt, i)    │","  │ ◄────────────────────────────────────── │","  │  SASLResponse(ClientProof)              │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLFinal + AuthOK       │","  │ ◄────────────────────────────────────── │"],"syntax":null},{"anchor":"PBKDF2-SHA256-via-CryptoKit","type":"heading","level":3,"text":"PBKDF2-SHA256 via CryptoKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SaltedPassword = Hi(password, salt, iterations)"},{"type":"text","text":" derivation uses a pure Swift PBKDF2 loop over CryptoKit "},{"type":"codeVoice","code":"HMAC<SHA256>"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["var u = HMAC<SHA256>.authenticationCode(for: salt + [0,0,0,1], using: SymmetricKey(data: passwordData))","var saltedPassword = Array(u)","for _ in 1..<iterations {","    u = HMAC<SHA256>.authenticationCode(for: Data(u), using: ...)","    \/\/ XOR accumulate","}"]},{"type":"heading","level":2,"text":"Enabling SCRAM on PostgreSQL Server","anchor":"Enabling-SCRAM-on-PostgreSQL-Server"},{"type":"codeListing","code":["-- pg_hba.conf","host  all  all  0.0.0.0\/0  scram-sha-256","","-- Verify in psql:","SELECT usename, passwd FROM pg_shadow;","-- Password should start with: SCRAM-SHA-256$4096:..."],"syntax":"sql"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/securityandperformance"]}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"metadata":{"modules":[{"name":"SwiftDatabase"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Security & Performance in SwiftDatabase"},"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","abstract":[{"type":"text","text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback."}],"type":"topic","url":"\/documentation\/swiftdatabase\/highthroughputingestion","role":"collectionGroup","title":"Bulk SQL Ingestion & Database Wire Protocols","kind":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","title":"Database Type System & Value Representation","role":"collectionGroup","type":"topic","url":"\/documentation\/swiftdatabase\/typesystem","abstract":[{"text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions.","type":"text"}],"kind":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase":{"role":"collection","title":"SwiftDatabase","type":"topic","abstract":[{"text":"Relational Database Connectors to DataFrames.","type":"text"}],"url":"\/documentation\/swiftdatabase","kind":"symbol","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"},"doc://SwiftDatabase/documentation/SwiftDatabase/DatabaseConnectors":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","abstract":[{"type":"text","text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" under Swift 6 Actor Concurrency."}],"type":"topic","url":"\/documentation\/swiftdatabase\/databaseconnectors","role":"article","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","kind":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase/PostgreSQLConnection":{"url":"\/documentation\/swiftdatabase\/postgresqlconnection","abstract":[{"type":"text","text":"Native PostgreSQL database connection driver using PostgreSQL v3.0 wire protocol."}],"title":"PostgreSQLConnection","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PostgreSQLConnection"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PostgreSQLConnection"}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection","kind":"symbol"},"doc://SwiftDatabase/documentation/SwiftDatabase/SQLiteConnection":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection","navigatorTitle":[{"kind":"identifier","text":"SQLiteConnection"}],"url":"\/documentation\/swiftdatabase\/sqliteconnection","role":"symbol","kind":"symbol","title":"SQLiteConnection","type":"topic","abstract":[{"type":"text","text":"Embedded SQLite database driver executing real SQL statements using the SQLite3 C API."}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SQLiteConnection"}]}}}