{"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"code":"NaturalLanguage","type":"codeVoice"},{"type":"text","text":" framework."}],"metadata":{"roleHeading":"Article","role":"article","title":"Text Normalization, Tokenization & Linguistic Tagging","modules":[{"name":"SwiftNLP"}]},"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ChatAPI"],"anchor":"Guides--Tutorials"}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}]},{"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","level":3,"type":"heading","text":"1. Multi-lingual Word & Sentence Tokenization"},{"code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"type":"codeListing","syntax":"swift"},{"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","level":3,"type":"heading","text":"2. POS Tagging, Lemmatization & Entity Extraction"},{"code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"type":"codeListing","syntax":"swift"},{"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","level":3,"type":"heading","text":"3. Sentiment Analysis (VADER & NLSentiment)"},{"code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"url":"\/documentation\/swiftnlp","title":"SwiftNLP","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","type":"topic","role":"collection","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"kind":"symbol"},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","abstract":[{"text":"Convert text corpora into numerical and sparse feature matrices using ","type":"text"},{"code":"TFIDFVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CountVectorizer","type":"code