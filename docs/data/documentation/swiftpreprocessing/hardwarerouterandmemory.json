{"metadata":{"role":"collectionGroup","title":"Hardware Routing & Unified Memory Governance","modules":[{"name":"SwiftPreprocessing"}],"roleHeading":"API Collection"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Apple Silicon features a ","type":"text"},{"inlineContent":[{"text":"Unified Memory Architecture (UMA)","type":"text"}],"type":"strong"},{"text":" where the CPU, GPU, and Apple Neural Engine (ANE) share a single high-bandwidth memory pool. ","type":"text"},{"type":"codeVoice","code":"SwiftPreprocessing"},{"text":" provides intelligent hardware routing and memory reservation primitives to prevent GPU saturation and avoid data copying.","type":"text"}],"type":"paragraph"},{"level":2,"text":"1. The Hardware Router","anchor":"1-The-Hardware-Router","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"HardwareRouter"},{"text":" assesses tensor dimensions and operation complexity to select the optimal computing engine:","type":"text"}],"type":"paragraph"},{"syntax":"mermaid","code":["graph TD","    Op[Compute Operation] --> Router{HardwareRouter}","    Router -->|Small \/ Vector < 50k| CPU[Accelerate \/ AMX \/ NEON]","    Router -->|Large Matrix \/ Autodiff| GPU[MLX Metal GPU]","    Router -->|Static Inference| ANE[Core ML Engine]"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Small Vectors ("},{"type":"codeVoice","code":"N < 50,000"},{"type":"text","text":")"}]},{"text":": Routed to CPU Accelerate (vDSP\/BLAS\/LAPACK) to eliminate GPU kernel dispatch latency.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Large Tensors & Deep Learning"}]},{"text":": Routed to MLX Metal GPU for massive parallel throughput.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"2. WiredMemoryManager & Ticket System","anchor":"2-WiredMemoryManager--Ticket-System","type":"heading"},{"inlineContent":[{"text":"To prevent out-of-memory (OOM) conditions during concurrent analytical workloads, ","type":"text"},{"type":"codeVoice","code":"WiredMemoryManager"},{"text":" implements an asynchronous FIFO reservation system:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftPreprocessing","","\/\/ Acquire a GPU execution slot","let ticket = try await WiredMemoryManager.shared.reserveMemory(estimatedBytes: 64 * 1024 * 1024)","","\/\/ Execute heavy MLX operations","\/\/ ...","","\/\/ Automatically flushes GPU caches upon completion","await ticket.release()"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouterAndMemory","interfaceLanguage":"swift"},"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"topicSections":[{"title":"Memory & Routing APIs","anchor":"Memory--Routing-APIs","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/hardwarerouterandmemory"]}],"abstract":[{"text":"Understand how SwiftSci automatically routes workloads between CPU (Accelerate\/AMX\/NEON) and Metal GPU (MLX) with strict concurrency safety.","type":"text"}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/HardwareRouter":{"kind":"symbol","abstract":[{"type":"text","text":"Serializes device selection and MLX default-device changes (global MLX state)."}],"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"ki