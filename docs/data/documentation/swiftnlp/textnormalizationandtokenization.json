{"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"type":"codeVoice","code":"NaturalLanguage"},{"type":"text","text":" framework."}],"metadata":{"roleHeading":"Article","title":"Text Normalization, Tokenization & Linguistic Tagging","modules":[{"name":"SwiftNLP"}],"role":"article"},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}]},{"type":"heading","level":3,"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","text":"1. Multi-lingual Word & Sentence Tokenization"},{"code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","text":"2. POS Tagging, Lemmatization & Entity Extraction"},{"code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","text":"3. Sentiment Analysis (VADER & NLSentiment)"},{"code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"type":"codeListing","syntax":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","title":"Text Feature Vectorization, Embeddings & Naive Bayes Classification","abstract":[{"text":"Convert text corpora into numerical feature matrices using ","type":"text"},{"code":"CountVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HashingVectorizer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"TFIDFVectorizer","type":"codeVoice"},{"text":", query ","type":"text"},{"code":"WordEmbeddings","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppleNLEmbedding","type":"codeVoice"},{"text":", and train Naive Bayes classifiers with ","type":"text"},{"code":"Tex