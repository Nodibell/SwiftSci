{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Dense Local Text Embeddings with Accelerate","role":"collectionGroup","modules":[{"name":"SwiftNLP"}],"roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"abstract":[{"type":"text","text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/denselocalembeddings"]}],"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modern Retrieval-Augmented Generation (RAG) and semantic search systems require dense vector representations of text. Traditional approaches depend on remote APIs (e.g. OpenAI) or large multi-gigabyte models that exhaust memory. "},{"type":"codeVoice","code":"SwiftNLP"},{"type":"text","text":" introduces "},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"type":"text","text":", a subword N-gram character hashing projection engine that produces deterministic, unit-normalized dense embeddings in sub-millisecond execution times."}]},{"anchor":"1-Algorithmic-Foundation","type":"heading","level":2,"text":"1. Algorithmic Foundation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"type":"text","text":" operates through a three-stage mathematical pipeline:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Subword N-gram Hashing"}],"type":"strong"},{"text":": Text is tokenized into word and character n-grams (sizes 3 to 6). Each n-gram is hashed into a fixed integer space using FNV-1a hash functions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Dimension Projection"}],"type":"strong"},{"text":": Hashes are projected onto a ","type":"text"},{"type":"codeVoice","code":"D"},{"text":"-dimensional vector space (e.g., ","type":"text"},{"type":"codeVoice","code":"D = 128"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"D = 256"},{"text":") with deterministic sign flips to prevent feature collision bias.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Unit L2 Normalization"}],"type":"strong"},{"text":": The resulting dense vector is projected onto the unit hypersphere:","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"code":"v_norm = v \/ ||v||_2 = v \/ sqrt(Σ v_i²)","type":"codeVoice"}],"type":"paragraph"}],"name":"Note"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because all embeddings have "},{"type":"codeVoice","code":"||v||_2 = 1.0"},{"type":"text","text":", the "},{"type":"strong","inlineContent":[{"type":"text","text":"Cosine Similarity"}]},{"type":"text","text":" between two embeddings is equivalent to their direct "},{"type":"strong","inlineContent":[{"type":"text","text":"Dot Product"}]},{"type":"text","text":", allowing single-instruction vector evaluation via Apple Accelerate "},{"type":"codeVoice","code":"vDSP_dotprD"},{"type":"text","text":":"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"CosineSimilarity(u, v) = u · v"}]}],"name":"Note","type":"aside","style":"note"},{"anchor":"2-Generating-Embeddings","type":"heading","level":2,"text":"2. Generating Embeddings"},{"code":["import SwiftNLP","","\/\/ Initialize a 128-dimensional local embedding engine","let engine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Generate embedding for a single text snippet","let vector = engine.embed(\"Apple Silicon M3 Max neural network processing\")","print(\"Vector dimension: \\(vector.count)\") \/\/ 128","","\/\/ Batch embedding generation","let documents = [","    \"High-performance computing on macOS\",","    \"Relational database wire protocol drivers\",","    \"Deep convolutional neural networks for vision\"","]","let batchEmbeddings = engine.embedBatch(documents)"],"type":"codeListing","syntax":"swift"},{"anchor":"3-Integration-with-SwiftClusterVectorStore","type":"heading","level":2,"text":"3. Integration with SwiftCluster.VectorStore"},{"code":["import SwiftCluster","","let store = VectorStore(metric: .cosineSimilarity)","","for (idx, doc) in documents.enumerated() {","    let vec = engine.embed(doc)","    store.add(id: \"doc_\\(idx)\", vector: vec, metadata: [\"text\": doc])","}","","\/\/ Perform instant semantic similarity search","let query = engine.embed(\"Mac hardware acceleration\")","let topHits = store.search(query: query, topK: 1)","print(\"Top match: \\(topHits.first?.metadata[\"text\"] ?? \"\")\")"],"type":"codeListing","syntax":"swift"}]}],"topicSections":[{"title":"Embedding APIs","anchor":"Embedding-APIs","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"abstract":[{"type":"text","text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon."}],"title":"LocalEmbeddingEngine","type":"topic","navigatorTitle":[{"kind":"identifier","text":"LocalEmbeddingEngine"}],"url":"\/documentation\/swiftnlp\/localembeddingengine","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LocalEmbeddingEngine"}]},"doc://SwiftNLP/documentation/SwiftNLP":{"url":"\/documentation\/swiftnlp","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","role":"collection","title":"SwiftNLP"}}}