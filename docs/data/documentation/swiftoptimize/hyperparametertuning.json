Accuracy: \\(String(format: \"%.4f\", gridSearch.bestScore ?? 0.0))\")","}"],"syntax":"swift"},{"type":"thematicBreak"},{"anchor":"3-Randomized-Search-RandomizedSearchCV","type":"heading","text":"3. Randomized Search (`RandomizedSearchCV`)","level":2},{"type":"paragraph","inlineContent":[{"text":"When searching through large continuous or discrete combinatorial spaces, ","type":"text"},{"code":"RandomizedSearchCV","type":"codeVoice"},{"text":" samples $N$ random configurations, finding near-optimal solutions in a fraction of the compute time.","type":"text"}]},{"type":"codeListing","code":["import SwiftOptimize","import SwiftML","","let distributions: [String: [Any]] = [","    \"learningRate\": [0.001, 0.005, 0.01, 0.05, 0.1],","    \"epochs\": [100, 200, 500, 1000],","    \"l2Penalty\": [0.0, 0.0001, 0.001, 0.01]","]","","let randomSearch = RandomizedSearchCV(","    estimator: LogisticRegression(learningRate: 0.01),","    paramDistributions: distributions,","    nIter: 20,","    cv: 3,","    randomSeed: 42",")","","try await randomSearch.fit(features: X, targets: y)","print(\"Top Configuration Score: \\(randomSearch.bestScore ?? 0.0)\")"],"syntax":"swift"}]}],"sections":[],"abstract":[{"text":"Automate model exploration and parameter optimization with ","type":"text"},{"code":"GridSearchCV","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RandomizedSearchCV","type":"codeVoice"},{"text":", and the intelligent ","type":"text"},{"code":"AutoML","type":"codeVoice"},{"text":" model selector.","type":"text"}],"references":{"doc://SwiftOptimize/documentation/SwiftOptimize/ParallelModelSelection":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection","type":"topic","title":"Concurrent Model Selection & Cross-Validation","url":"\/documentation\/swiftoptimize\/parallelmodelselection","abstract":[{"type":"text","text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency "},{"type":"codeVoice","code":"TaskGroup"},{"type":"text","text":" primitives."}]},"doc://SwiftOptimize/documentation/SwiftOptimize/CrossValidationFolds":{"kind":"article","role":"article","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","type":"topic","title":"Cross-Validation Strategies","url":"\/documentation\/swiftoptimize\/crossvalidationfolds","abstract":[{"text":"Evaluate model stability and generalization performance across dataset splits using ","type":"text"},{"code":"KFold","type":"codeVoice"},{"text":", ","type":"text"},{"code":"StratifiedKFold","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"TimeSeriesSplit","type":"codeVoice"},{"text":".","type":"text"}]},"doc://SwiftOptimize/documentation/SwiftOptimize":{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize","url":"\/documentation\/swiftoptimize","kind":"symbol","role":"collection","title":"SwiftOptimize","abstract":[{"type":"text","text":"AutoML, Cross-Validation Folds & Hyperparameter Tuning."}],"type":"topic"}}}