{"seeAlsoSections":[{"generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"],"anchor":"Guides--Tutorials"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"sections":[],"metadata":{"role":"article","title":"Spatial Indexing, Clustering & Outlier Detection","modules":[{"name":"SwiftCluster"}],"roleHeading":"Article"},"abstract":[{"text":"High-performance clustering and density-based anomaly detection powered by ","type":"text"},{"type":"codeVoice","code":"KDTree"},{"type":"text","text":", "},{"type":"codeVoice","code":"DBSCAN"},{"text":", ","type":"text"},{"type":"codeVoice","code":"KMeans"},{"text":", ","type":"text"},{"type":"codeVoice","code":"LocalOutlierFactor"},{"type":"text","text":", and "},{"type":"codeVoice","code":"IsolationForest"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/swiftcluster\/clusteringandoutliers"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Clustering and outlier detection algorithms often suffer from quadratic distance computation bottlenecks ("},{"code":"O(N²)","type":"codeVoice"},{"type":"text","text":"). "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" employs a balanced "},{"type":"strong","inlineContent":[{"text":"KD-Tree spatial index","type":"text"}]},{"type":"text","text":" reducing neighbor queries to "},{"type":"codeVoice","code":"O(N · log N)"},{"type":"text","text":", enabling instant processing of large spatial datasets."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"%E2%9A%A1-Spatial-Indexing-KD-Tree-vs-Brute-Force","type":"heading","level":2,"text":"⚡ Spatial Indexing: KD-Tree vs Brute-Force"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dataset Size (N)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Brute-Force DBSCAN ("},{"type":"codeVoice","code":"O(N²)"},{"type":"text","text":" Distance Matrix)"}]}],[{"inlineContent":[{"type":"text","text":"SwiftCluster KD-Tree DBSCAN ("},{"type":"codeVoice","code":"O(N · log N)"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Speedup","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"1,000 points"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"42 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"1.8 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"23.3× faster","type":"text"}],"type":"strong"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"10,000 points","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"4,250 ms (4.25 s)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"28 ms","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"151.7× faster","type":"text"}],"type":"strong"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"100,000 points","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"Out of Memory (100k × 100k matrix = 80 GB RAM)","type":"text"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"text":"380 ms (0.38 s)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"text":"∞ (Memory Safe)","type":"text"}],"type":"strong"}],"type":"paragraph"}]]],"alignments":["left","left","left","left"]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"1. Density-Based Clustering (`DBSCAN`)","anchor":"1-Density-Based-Clustering-DBSCAN"},{"inlineContent":[{"code":"DBSCAN","type":"codeVoice"},{"text":" discovers clusters of arbitrary shapes and isolates noise points without requiring a pre-specified cluster count ","type":"text"},{"code":"K","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftCluster","","\/\/ 1. Generate multi-cluster 2D coordinates","let cluster1 = (0..<100).map { _ in [Double.random(in: 0...2), Double.random(in: 0...2)] }","let cluster2 = (0..<100).map { _ in [Double.random(in: 10...12), Double.random(in: 10...12)] }","let noise = [[5.0, 5.0], [8.0, 2.0]]","let points = cluster1 + cluster2 + noise","","\/\/ 2. Initialize DBSCAN with spatial neighborhood epsilon and minPoints","let dbscan = DBSCAN(eps: 1.5, minSamples: 5)","let labels = dbscan.fit(points)","","\/\/ -1 indicates noise \/ outlier points, 0, 1, ... indicate cluster IDs","let clusterCount = Set(labels.filter { $0 >= 0 }).count","let noiseCount = labels.filter { $0 == -1 }.count","","print(\"DBSCAN identified \\(clusterCount) clusters and \\(noiseCount) noise outliers.\")"]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"2. K-Means++ Clustering (`KMeans`)","anchor":"2-K-Means++-Clustering-KMeans"},{"inlineContent":[{"text":"Fast centroid-based clustering using D² weighted probabilistic initialization for accelerated convergence:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","let kmeans = KMeans(nClusters: 3, maxIterations: 100, tolerance: 1e-4, seed: 42)","try await kmeans.fit(features: points)","","let centroids = await kmeans.getCentroids()","print(\"Learned Centroids: \\(centroids ?? [])\")","","let clusterAssignments = try await kmeans.predict(features: points)","let inertia = try await kmeans.inertia(features: points)","print(\"Within-Cluster Sum of Squares (Inertia): \\(String(format: \"%.2f\", inertia))\")"]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"3. Density-Based Outlier Detection (`LocalOutlierFactor`)","anchor":"3-Density-Based-Outlier-Detection-LocalOutlierFactor"},{"inlineContent":[{"code":"LocalOutlierFactor","type":"codeVoice"},{"text":" measures local density deviation of an observation relative to its K-nearest neighbors:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","let lof = LocalOutlierFactor(nNeighbors: 15, maxSamples: 5000)","let outlierLabels = try lof.fitPredict(points)","","\/\/ -1 indicates local density anomaly, +1 indicates inlier","let anomalies = outlierLabels.enumerated().filter { $0.element == -1 }.map { $0.offset }","print(\"LOF detected anomalies at indices: \\(anomalies)\")"]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"4. Isolation Forest for High-Dimensional Anomaly Detection","anchor":"4-Isolation-Forest-for-High-Dimensional-Anomaly-Detection"},{"inlineContent":[{"code":"IsolationForest","type":"codeVoice"},{"text":" recursively partitions feature subspaces using random split hyperplanes. Anomalies require significantly fewer splits to isolate:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","let isoForest = IsolationForest(nEstimators: 100, maxSamples: 256, contamination: 0.05, randomSeed: 42)","try await isoForest.fit(features: points)","","let anomalyScores = try await isoForest.decisionFunction(features: points)","let predictions = try await isoForest.predict(features: points)","","print(\"Isolation Forest predictions ready for \\(predictions.count) observations.\")"]}]}],"references":{"doc://SwiftCluster/documentation/SwiftCluster/VectorStoreAndRAG":{"kind":"article","abstract":[{"text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate.","type":"text"}],"role":"collectionGroup","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","url":"\/documentation\/swiftcluster\/vectorstoreandrag","title":"In-Memory VectorStore & On-Device RAG","type":"topic"},"doc://SwiftCluster/documentation/SwiftCluster":{"abstract":[{"type":"text","text":"PCA Dimensionality Reduction & Unsupervised Clustering."}],"url":"\/documentation\/swiftcluster","title":"SwiftCluster","role":"collection","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster","kind":"symbol"},"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"abstract":[{"type":"text","text":"Reduce high-dimensional feature spaces, uncover latent structures, and visualize complex datasets using PCA, Randomized SVD, and t-SNE."}],"url":"\/documentation\/swiftcluster\/dimensionalityreduction","title":"Dimensionality Reduction & Manifold Learning","role":"collectionGroup","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","kind":"article"},"doc://SwiftCluster/documentation/SwiftCluster/HNSWVectorSearch":{"kind":"article","abstract":[{"type":"text","text":"Scale approximate nearest neighbor (ANN) retrieval using Hierarchical Navigable Small World graphs with empirical logarithmic query scaling under navigable graph structure."}],"role":"collectionGroup","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch","url":"\/documentation\/swiftcluster\/hnswvectorsearch","type":"topic","title":"High-Dimensional Vector Search with HNSW"}}}