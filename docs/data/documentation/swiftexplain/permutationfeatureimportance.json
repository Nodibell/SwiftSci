{"kind":"article","abstract":[{"text":"Measure true feature importance by evaluating loss degradation after shuffling feature columns.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationFeatureImportance","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"SwiftExplain"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Permutation Feature Importance & Model Diagnostics"},"topicSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationImportance"],"anchor":"Diagnostic-Tools","title":"Diagnostic Tools"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Permutation Feature Importance","type":"text"}]},{"type":"text","text":" measures how much a trained model’s error increases when a single feature column is randomly shuffled, breaking the relationship between that feature and the target outcome."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Importance Metric:","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"Importance(f_j) = Loss(X_shuffled(j), y) - Loss(X, y)","type":"codeVoice"}]}],"type":"aside"},{"text":"1. Computing Permutation Importance","anchor":"1-Computing-Permutation-Importance","type":"heading","level":2},{"code":["import SwiftExplain","import SwiftML","","let importance = try await PermutationImportance.compute(","    model: trainedModel,","    features: X_val,","    targets: y_val,","    metric: .meanSquaredError,","    nRepeats: 10",")","","for (idx, score) in importance.enumerated() {","    print(\"Feature \\(idx): Mean drop = \\(score.mean), Std = \\(score.std)\")","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"schemaVersio