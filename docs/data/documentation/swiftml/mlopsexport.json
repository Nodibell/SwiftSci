{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"SwiftSci provides native, wire-format serialization engines for both Apple Core ML and ONNX without requiring external Python tooling or code generation steps. Models trained natively in Swift can be directly exported to binary artifacts compatible with Apple Neural Engine (ANE), Metal GPU, CPU, and ONNX Runtime."}],"type":"paragraph"},{"type":"heading","level":2,"text":"1. Core ML Binary Export (`.mlmodel`)","anchor":"1-Core-ML-Binary-Export-mlmodel"},{"inlineContent":[{"type":"text","text":"SwiftSci implements binary Protocol Buffer serialization directly conforming to Apple’s "},{"type":"codeVoice","code":"Model.proto"},{"type":"text","text":" specification (v4)."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Supported Estimators","anchor":"Supported-Estimators"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Estimator"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Core ML Message"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Target Hardware"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LinearRegression"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GLMRegressor"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LogisticRegression"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GLMClassifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DecisionTreeClassifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeEnsembleClassifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DecisionTreeRegressor"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeEnsembleRegressor"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RandomForestClassifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeEnsembleClassifier"},{"type":"text","text":" (multi-tree)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RandomForestRegressor"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeEnsembleRegressor"},{"type":"text","text":" (multi-tree)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]]],"header":"row","alignments":["left","left","left"]},{"type":"heading","level":3,"text":"Using the `CoreMLExportable` Protocol","anchor":"Using-the-CoreMLExportable-Protocol"},{"inlineContent":[{"type":"text","text":"All supported model types conform to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable"},{"type":"text","text":" protocol, providing asynchronous export methods:"}],"type":"paragraph"},{"code":["import SwiftML","","\/\/ Train a Random Forest Classifier","let rf = try RandomForestClassifier(nEstimators: 50, maxDepth: 8)","try await rf.fit(features: X_train, targets: y_train)","","\/\/ Export directly to a .mlmodel file","let exportURL = URL(fileURLWithPath: \"\/path\/to\/RandomForest.mlmodel\")","try await rf.writeCoreML(","    to: exportURL,","    featureNames: [\"age\", \"income\", \"credit_score\"],","    outputName: \"approved\"",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Direct Serialization via `CoreMLExporter`","anchor":"Direct-Serialization-via-CoreMLExporter"},{"inlineContent":[{"type":"text","text":"You can also use static methods on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter"},{"type":"text","text":" to produce binary "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" payloads:"}],"type":"paragraph"},{"code":["\/\/ Export fitted linear regression","let modelData = CoreMLExporter.exportBinaryLinearModel(","    name: \"HousePricePredictor\",","    inputNames: [\"sqft\", \"bedrooms\", \"bathrooms\"],","    outputName: \"price\",","    weights: [250.0, 15000.0, 10000.0],","    bias: 50000.0",")","","try modelData.write(to: URL(fileURLWithPath: \"HousePricePredictor.mlmodel\"))"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Exporting Composite Pipelines & Modern .mlpackage","anchor":"Exporting-Composite-Pipelines--Modern-mlpackage"},{"inlineContent":[{"type":"text","text":"SwiftSci v3.3.0 supports exporting multi-stage composite pipelines and modern "},{"type":"codeVoice","code":".mlpackage"},{"type":"text","text":" directory bundles:"}],"type":"paragraph"},{"code":["\/\/ Export composite pipeline chaining preprocessing + classifier","let pipelineData = CoreMLExporter.exportBinaryPipelineClassifier(","    models: [scalerData, rfData],","    names: [\"Scaler\", \"RandomForestClassifier\"],","    inputNames: [\"age\", \"income\"],","    outputName: \"approved\"",")","","\/\/ Export directly into modern .mlpackage bundle format","try CoreMLExporter.writeMLPackage(","    modelData: pipelineData,","    to: URL(fileURLWithPath: \"\/path\/to\/MyPipeline.mlpackage\"),","    author: \"SwiftSci Developer\",","    description: \"End-to-end data science inference pipeline\"",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Loading in Client Applications","anchor":"Loading-in-Client-Applications"},{"inlineContent":[{"type":"text","text":"Exported "},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":" and "},{"type":"codeVoice","code":".mlpackage"},{"type":"text","text":" files can be compiled and loaded dynamically using Apple’s "},{"type":"codeVoice","code":"CoreML"},{"type":"text","text":" framework:"}],"type":"paragraph"},{"code":["import CoreML","","let compiledURL = try MLModel.compileModel(at: exportURL)","let mlModel = try MLModel(contentsOf: compiledURL)","","let inputDict: [String: Any] = [\"age\": 35.0, \"income\": 75000.0, \"credit_score\": 720.0]","let featureProvider = try MLDictionaryFeatureProvider(dictionary: inputDict)","let output = try mlModel.prediction(from: featureProvider)"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"2. ONNX Binary Export (`.onnx`)","anchor":"2-ONNX-Binary-Export-onnx"},{"inlineContent":[{"type":"text","text":"SwiftSci provides native binary ONNX wire-format export via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiftML","","let onnxData = ONNXExporter.exportBinaryONNX(","    name: \"LinearONNX\",","    inputs: [\"features\"],","    output: \"prediction\",","    weights: [1.5, -2.0, 0.75],","    bias: 0.5",")","","try onnxData.write(to: URL(fileURLWithPath: \"model.onnx\"))"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"type":"text","text":"Export trained SwiftSci estimators to native Apple Core ML ("},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":") and cross-platform ONNX ("},{"type":"codeVoice","code":".onnx"},{"type":"text","text":") binary artifacts for production deployment."}],"variants":[{"paths":["\/documentation\/swiftml\/mlopsexport"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftML"}],"roleHeading":"API Collection","title":"Exporting Models to Core ML and ONNX","role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/SwiftML\/doc