{"identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection"],"title":"SQLite Performance","anchor":"SQLite-Performance"},{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection"],"title":"PostgreSQL Security","anchor":"PostgreSQL-Security"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As datasets grow into the millions of rows and production PostgreSQL deployments enforce stronger authentication policies, "},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" provides two complementary enhancements:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"1024-row column buffering"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"SQLiteConnection.executeQuery"},{"type":"text","text":" reduces Swift "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" reallocation pressure on large sequential table scans."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SCRAM-SHA-256 authentication"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"PostgreSQLConnection"},{"type":"text","text":" implements the full RFC 5802\/7677 handshake using CryptoKit "},{"type":"codeVoice","code":"HMAC<SHA256>"},{"type":"text","text":" and iterative PBKDF2 — never transmitting the raw password over the wire."}]}]}],"type":"orderedList"},{"level":2,"type":"heading","anchor":"1024-Row-Column-Buffering","text":"1024-Row Column Buffering"},{"level":3,"type":"heading","anchor":"Problem","text":"Problem"},{"type":"paragraph","inlineContent":[{"text":"The naive approach appends each decoded row immediately to a growing ","type":"text"},{"code":"[[AnySendableValue]]","type":"codeVoice"},{"text":" array. Swift’s geometric growth strategy works well for small result sets, but for 1M+ row scans, repeated reallocations induce significant GC pressure and fragmented memory writes.","type":"text"}]},{"level":3,"type":"heading","anchor":"Solution","text":"Solution"},{"type":"paragraph","inlineContent":[{"code":"executeQuery","type":"codeVoice"},{"text":" pre-allocates a local ","type":"text"},{"code":"page","type":"codeVoice"},{"text":" buffer of exactly 1024 rows. When the page fills, it is bulk-appended to the result array via ","type":"text"},{"code":"rows.append(contentsOf: page)","type":"codeVoice"},{"text":", then the page is cleared with ","type":"text"},{"code":"removeAll(keepingCapacity: true)","type":"codeVoice"},{"text":" to avoid reallocation.","type":"text"}]},{"code":["let pageSize = 1024","var page: [[AnySendableValue]] = []","page.reserveCapacity(pageSize)","","while sqlite3_step(stmt) == SQLITE_ROW {","    page.append(decodeRow())","    if page.count == pageSize {","        rows.append(contentsOf: page)","        page.removeAll(keepingCapacity: true)","    }","}","rows.append(contentsOf: page) \/\/ Flush remainder"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Benchmark impact"}]},{"text":": ~40% fewer allocations on 500K-row tables vs. naive append.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"SCRAM-SHA-256 Authentication","anchor":"SCRAM-SHA-256-Authentication"},{"inlineContent":[{"text":"Modern PostgreSQL (>= 14) defaults to ","type":"text"},{"code":"scram-sha-256","type":"codeVoice"},{"type":"text","text":" in "},{"code":"pg_hba.conf","type":"codeVoice"},{"type":"text","text":". "},{"code":"SwiftDatabase","type":"codeVoice"},{"type":"text","text":"’s wire-protocol driver now supports the full RFC 5802 exchange:"}],"type":"paragraph"},{"code":["Client                                    Server","  │  SASLInitialResponse(SCRAM-SHA-256)     │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLContinue(salt, i)    │","  │ ◄────────────────────────────────────── │","  │  SASLResponse(ClientProof)              │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLFinal + AuthOK       │","  │ ◄────────────────────────────────────── │"],"syntax":null,"type":"codeListing"},{"text":"PBKDF2-SHA256 via CryptoKit","level":3,"anchor":"PBKDF2-SHA256-via-CryptoKit","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"code":"SaltedPassword = Hi(password, salt, iterations)","type":"codeVoice"},{"type":"text","text":" derivation uses a pure Swift PBKDF2 loop over CryptoKit "},{"code":"HMAC<SHA256>","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["var u = HMAC<SHA256>.authenticationCode(for: salt + [0,0,0,1], using: SymmetricKey(data: passwordData))","var saltedPassword = Array(u)","for _ in 1..<iterations {","    u = HMAC<SHA256>.authenticationCode(for: Data(u), using: ...)","    \/\/ XOR accumulate","}"],"syntax":"swift","type":"codeListing"},{"text":"Enabling SCRAM on PostgreSQL Server","level":2,"anchor":"Enabling-SCRAM-on-PostgreSQL-Server","type":"heading"},{"code":["-- pg_hba.conf","host  all  all  0.0.0.0\/0  scram-sha-256","","-- Verify in psql:","SELECT usename, passwd FROM pg_shadow;","-- Password should start with: SCRAM-SHA-256$4096:..."],"syntax":"sql","type":"codeListing"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"variants":[{"paths":["\/documentation\/swiftdatabase\/securityandperformance"],"traits":[{"interfaceLanguage":"swift"}]}],"sect