{"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"When vector collections expand beyond tens of thousands of items, exact (O(N)) linear scans become a major latency bottleneck for real-time recommendation and retrieval-augmented generation (RAG) systems."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"HNSWIndex"},{"text":" actor provides a hierarchical graph-based spatial partitioning index with sub-millisecond query latency and logarithmic (O(\\log N)) search scaling.","type":"text"}],"type":"paragraph"},{"anchor":"Hierarchical-Navigable-Small-World-Architecture","type":"heading","level":2,"text":"Hierarchical Navigable Small World Architecture"},{"inlineContent":[{"type":"text","text":"HNSW constructs a hierarchy of graph layers:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Top Layers (Sparse)"}],"type":"strong"},{"type":"text","text":": Contain widely spaced long-range highway edges for rapid coarse geometric routing across distant clusters."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Intermediate Layers","type":"text"}]},{"text":": Progressively decrease edge length while increasing vertex density.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Bottom Layer (Layer 0, Dense)"}],"type":"strong"},{"type":"text","text":": Contains all indexed vertices connected by dense short-range edges for high-accuracy localized nearest-neighbor refinement."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","syntax":null,"code":["Layer 2 (Express):   [A] ───────────────────────────► [F]","                      │                                │","                      ▼                                ▼","Layer 1 (Regional):  [A] ──────────► [C] ────────────► [F]","                      │               │                │","                      ▼               ▼                ▼","Layer 0 (Base):      [A] ──► [B] ──► [C] ──► [D] ──► [E] ──► [F]"]},{"anchor":"Key-Configuration-Parameters","level":2,"text":"Key Configuration Parameters","type":"heading"},{"header":"row","alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Recommended Default"}]}],[{"inlineContent":[{"text":"Impact on Search Quality & Index Build Time","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"M"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"16"}]}],[{"inlineContent":[{"type":"text","text":"Maximum outgoing connections per node. Higher values improve recall at the cost of higher memory and index construction time."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"efConstruction"}],"type":"paragraph"}],[{"inlineContent":[{"code":"200","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Size of dynamic candidate evaluation queue during insertion. Larger values produce higher-quality graph connectivity."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"efSearch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"50"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Dynamic queue size during search traversal. Higher values increase search recall towards 100% exact match.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"metric","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".euclideanDistance"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Choice of ","type":"text"},{"type":"codeVoice","code":".euclideanDistance"},{"text":", ","type":"text"},{"type":"codeVoice","code":".cosineSimilarity"},{"text":", or ","type":"text"},{"type":"codeVoice","code":".dotProduct"},{"text":".","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"level":2,"text":"Example Usage","type":"heading","anchor":"Example-Usage"},{"syntax":"swift","code":["import SwiftCluster","","\/\/ 1. Initialize the actor-isolated index","let hnsw = HNSWIndex(metric: .cosineSimilarity, M: 16, efConstruction: 200, efSearch: 50)","","\/\/ 2. Add embeddings asynchronously","await hnsw.add(id: \"doc_news_1\", vector: [0.12, 0.94, -0.31], metadata: [\"category\": \"news\"])","await hnsw.add(id: \"doc_tech_2\", vector: [-0.85, 0.11, 0.52], metadata: [\"category\": \"technology\"])","","\/\/ 3. Query Top-K nearest neighbors","let queryEmbedding = [0.10, 0.90, -0.30]","let matches = await hnsw.search(query: queryEmbedding, topK: 5)","","for match in matches {","    print(\"Matched: \\(match.id) with score: \\(match.score)\")","}"],"type":"codeListing"},{"level":2,"text":"Thread Safety & Swift 6 Strict Concurrency","type":"heading","anchor":"Thread-Safety--Swift-6-Strict-Concurrency"},{"inlineContent":[{"type":"codeVoice","code":"HNSWIndex"},{"type":"text","text":" is implemented as an isolated Swift "},{"type":"codeVoice","code":"actor"},{"type":"text","text":", guaranteeing thread safety and eliminating race conditions when multiple background tasks insert items or execute queries concurrently."}],"type":"paragraph"}]}],"kind":"article","seeAlsoSections":[{"anchor":"Guides--Tutorials","generated":true,"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"],"title":"Guides & Tutorials"}],"topi