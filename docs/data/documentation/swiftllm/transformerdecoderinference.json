{"topicSections":[{"anchor":"Core-Inference-Components","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/PagedKVCache","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMConfig","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/RoPEEmbedding"],"title":"Core Inference Components"},{"anchor":"Sampling--Decoding","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies"],"title":"Sampling & Decoding"}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"title":"Guides & Tutorials","generated":true}],"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/transformerdecoderinference"]}],"abstract":[{"text":"Execute two-stage autoregressive generation with full prompt prefill and incremental single-token decoding using Apple Silicon KV-caching.","type":"text"}],"metadata":{"title":"Autoregressive Transformer Decoder Inference","role":"collectionGroup","modules":[{"name":"SwiftLLM"}],"roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"text":" implements modern decoder-only causal transformer architectures (such as Llama 3, Mistral, and Gemma) leveraging MLX unified memory acceleration on Apple Silicon GPUs. Inference is divided into two distinct computational phases:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Prompt Prefill Phase ("},{"code":"isPrefill: true","type":"codeVoice"},{"type":"text","text":")"}]},{"type":"text","text":": Processes all initial prompt tokens in parallel, computing attention matrices and populating the key-value cache across all transformer layers."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Incremental Decoding Phase (","type":"text"},{"code":"isPrefill: false","type":"codeVoice"},{"text":")","type":"text"}]},{"text":": Processes a single token per step, computing query projections and attending over the accumulated key-value history ($O(N)$ attention over cached history, avoiding repeated full-sequence forward passes).","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"text":"1. Two-Stage Generation Loop","anchor":"1-Two-Stage-Generation-Loop","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The following complete example demonstrates configuring a model, prefilling the KV-cache, and executing an autoregressive generation loop:"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import SwiftLLM","import MLX","","\/\/ 1. Initialize configuration and decoder","let config = LLMConfig.llama3_8B","let decoder = TransformerDecoder(config: config)","let cache = KVCache(config: config)","","\/\/ Tokenized prompt sequence","let promptTokens: [Int] = [128000, 791, 7453, 374]","var generatedTokens = promptTokens","let maxNewTokens = 64","","\/\/ 2. Stage 1: Prefill prompt tokens into KV-cache","let promptLogits = try decoder.forward(","    tokens: promptTokens,","    cache: cache,","    isPrefill: true",")","","\/\/ 3. Configure sampling parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","\/\/ 4. Sample first generated token from prefill logits","var currentToken = Sampler.sample(","    logits: promptLogits,","    config: sampling,","    pastTokens: generatedTokens",")","generatedTokens.append(currentToken)","","\/\/ 5. Stage 2: Incremental single-token decoding loop","for _ in 1..<maxNewTokens {","    \/\/ Forward single token with isPrefill: false","    let stepLogits = try decoder.forward(","        tokens: [currentToken],","        cache: cache,","        isPrefill: false","    )","    ","    \/\/ Sample next token ID","    let nextToken = Sampler.sample(","        logits: stepLogits,","        config: sampling,","        pastTokens: generatedTokens","    )","    ","    generatedTokens.append(nextToken)","    currentToken = nextToken","    ","    \/\/ Check for EOS (End of Sequence) tokens","    if nextToken == 128001 || nextToken == 128009 {","        break","    }","}","","print(\"Generated total sequence: \\(generatedTokens.count) tokens.\")"],"type":"codeListing"},{"type":"thematicBreak"},{"text":"2. Rotary Position Embeddings (RoPE) During Incremental Decoding","anchor":"2-Rotary-Position-Embeddings-RoPE-During-Incremental-Decoding","type":"heading","level":2},{"inlineContent":[{"text":"During single-token decoding (","type":"text"},{"code":"isPrefill: false","type":"codeVoice"},{"text":"), position frequencies must match the actual sequential position in the generated sequence rather than index ","type":"text"},{"code":"0","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"RoPEEmbedding"},{"type":"text","text":" tracks this via the "},{"type":"codeVoice","code":"positionOffset"},{"type":"text","text":" parameter:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Internal RoPE position calculation:","\/\/ position = positionOffset + tokenIndex","let rotatedQ = rope.apply(x: query, positionOffset: cache.currentLength)"],"type":"codeListing"},{"inlineContent":[{"text":"Because ","type":"text"},{"code":"KVCache","type":"codeVoice"},{"text":" dynamically tracks ","type":"text"},{"code":"currentLength","type":"codeVoice"},{"type":"text","text":", positions increment faithfully from the end of the prefill boundary through every subsequent token generation step."}],"type":"paragraph"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"3. High-Level Streaming API","anchor":"3-High-Level-Streaming-API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For streaming applications, "},{"type":"codeVoice","code":"LLMModel"},{"type":"text","text":" wraps the decoder and cache lifecycle into an asynchronous sequence:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftLLM","","let options = LLMOptions(","    maxTokens: 128,","    sampling: SamplingConfiguration(temperature: 0.7, topK: 40, topP: 0.9)",")","","for try await token in model.generateStream(prompt: \"Explain rotary embeddings:\", options: options) {","    print(token, terminator: \"\")","}"]},{"type":"thematicBreak"}]}],"identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","interfaceLanguage":"swift"},"references":{"doc://SwiftLLM/documentation/SwiftLLM/PagedKVCache":{"type":"topic","title":"PagedKVCache","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PagedKVCache"}],"role":"symbol","url":"\/documentation\/swiftllm\/pagedkvcache","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PagedKVCache"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/PagedKVCache","abstract":[{"type":"text","text":"A dynamic paged Key-Value attention cache allocator for high-throughput batch and stream inference."}]},"doc://SwiftLLM/documentation/SwiftLLM/SamplingAndDecodingStrategies":{"title":"Token Sampling & Decoding Strategies","url":"\/documentation\/swiftllm\/samplinganddecodingstrategies","kind":"article","abstract":[{"type":"text","text":"Control autoregressive language generation with Temperature, Top-P Nucleus, Top-K, and Repetition Penalty."}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","role":"collectionGroup","type":"topic"},"doc://SwiftLLM/documentation/SwiftLLM":{"title":"SwiftLLM","url":"\/documentation\/swiftllm","kind":"symbol","abstract":[{"type":"text","text":"Local Causal Transformer Decoder & Weight Parsers."}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","role":"collection","type":"topic"},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoder":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TransformerDecoder"}],"navigatorTitle":[{"kind":"identifier","text":"TransformerDecoder"}],"title":"TransformerDecoder","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A full N-layer decoder-only Transformer."}],"role":"symbol","url":"\/documentation\/swiftllm\/transformerdecoder","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder"},"doc://SwiftLLM/documentation/SwiftLLM/MetalShadersQuantization":{"title":"Native Metal MSL Shaders for Quantized LLMs","url":"\/documentation\/swiftllm\/metalshadersquantization","kind":"article","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization","abstract":[{"type":"text","text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU."}],"role":"collectionGroup","type":"topic"},"doc://SwiftLLM/documentation/SwiftLLM/LLMOptions":{"role":"symbol","navigatorTitle":[{"text":"LLMOptions","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","kind":"symbol","title":"LLMOptions","u