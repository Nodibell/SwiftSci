{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Apple Silicon features a ","type":"text"},{"type":"strong","inlineContent":[{"text":"Unified Memory Architecture (UMA)","type":"text"}]},{"text":" where the CPU, GPU, and Apple Neural Engine (ANE) share a single high-bandwidth memory pool. ","type":"text"},{"type":"codeVoice","code":"SwiftPreprocessing"},{"text":" provides intelligent hardware routing and memory reservation primitives to prevent GPU saturation and avoid data copying.","type":"text"}]},{"text":"1. The Hardware Router","type":"heading","level":2,"anchor":"1-The-Hardware-Router"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"HardwareRouter","type":"codeVoice"},{"text":" assesses tensor dimensions and operation complexity to select the optimal computing engine:","type":"text"}]},{"type":"codeListing","syntax":"mermaid","code":["graph TD","    Op[Compute Operation] --> Router{HardwareRouter}","    Router -->|Small \/ Vector < 50k| CPU[Accelerate \/ AMX \/ NEON]","    Router -->|Large Matrix \/ Autodiff| GPU[MLX Metal GPU]","    Router -->|Static Inference| ANE[Core ML Engine]"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Small Vectors (","type":"text"},{"code":"N < 50,000","type":"codeVoice"},{"text":")","type":"text"}],"type":"strong"},{"type":"text","text":": Routed to CPU Accelerate (vDSP\/BLAS\/LAPACK) to eliminate GPU kernel dispatch latency."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Large Tensors & Deep Learning","type":"text"}]},{"text":": Routed to MLX Metal GPU for massive parallel throughput.","type":"text"}]}]}]},{"text":"2. WiredMemoryManager & Ticket System","anchor":"2-WiredMemoryManager--Ticket-System","level":2,"type":"heading"},{"inlineContent":[{"text":"To p