{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Manually diagnosing autocorrelation functions (ACF) and partial autocorrelation functions (PACF) to select ARIMA orders is time-consuming and error-prone. Standard automated packages like R’s ","type":"text"},{"code":"forecast::auto.arima","type":"codeVoice"},{"text":" or Python’s ","type":"text"},{"code":"pmdarima","type":"codeVoice"},{"text":" search across candidate orders sequentially.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"AutoARIMA","type":"codeVoice"},{"text":" evaluates the entire hyperparameter lattice simultaneously across all CPU cores on Apple Silicon using structured Swift Concurrency (","type":"text"},{"code":"withThrowingTaskGroup","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"heading","text":"Grid Search Architecture","level":2,"anchor":"Grid-Search-Architecture"},{"type":"codeListing","syntax":null,"code":["           Observed Time Series [y_1, y_2, ..., y_N]","                               │","       ┌───────────────────────┼───────────────────────┐","       ▼                       ▼                       ▼","ARIMA(1, 1, 0)          ARIMA(2, 1, 1)          ARIMA(0, 1, 2)","Task 1                  Task 2                  Task 3","   │                       │                       │","   ├─ Hannan-Rissanen      ├─ Hannan-Rissanen      ├─ Hannan-Rissanen","   └─ Compute AIC\/BIC      └─ Compute AIC\/BIC      └─ Compute AIC\/BIC","       │                       │                       │","       └───────────────────────┼───────────────────────┘","                               ▼","                withThrowingTaskGroup Collector","                               │","                               ▼","                 Sorted Leaderboard & Best Model"]},{"type":"heading","text":"Information Criteria","level":3,"anchor":"Information-Criteria"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"AIC (Akaike Information Criterion)","type":"text"}]},{"text":": Penalizes model complexity while rewarding likelihood:","type":"text"},{"text":" ","type":"text"},{"text":"$$\\text{AIC} = 2k - 2\\ln(L)$$","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"BIC (Bayesian Information Criterion)","type":"text"}]},{"text":": Imposes a stronger penalty proportional to sample size:","type":"text"},{"text":" ","type":"text"},{"text":"$$\\text{BIC} = k\\ln(N) - 2\\ln(L)$$","type":"text"}]}]}]},{"type":"heading","text":"Example Usage","level":2,"anchor":"Example-Usage"},{"type":"codeListing","syntax":"swift","code":["import SwiftForecast","","\/\/ 1. Initialize AutoARIMA with bounded search ranges","let autoArima = AutoARIMA(","    maxP: 3,","    maxD: 2,","    maxQ: 3,","    criterion: .aic",")","","\/\/ 2. Concurrently fit candidates across all cores","let result = try await autoArima.fit(series: historicalPrices)","print(\"Optimal Order: \\(autoArima.bestOrder!) with AIC: \\(autoArima.bestScore!)\")","","\/\/ 3. Generate multi-step forecasts","let forecast = try await autoArima.forecast(horizon: 12)","print(\"Forecasted points: \\(forecast.forecast.predictions)\")"]}]}],"seeAlsoSections":[{"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"topicSections":[{"title":"Automated Time Series","anchor":"Automated-Time-Series","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMACriterion"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftforecast\/autoarimaparallel"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel"},"metadata":{"modules":[{"name":"SwiftForecast"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Concurrent Order Selection with AutoARIMA"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency."}],"sections":[],"references":{"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMA":{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoARIMA"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Automated hyperparameter grid search for ARIMA and SARIMA time-series models."}],"title":"AutoARIMA","url":"\/documentation\/swiftforecast\/autoarima","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AutoARIMA"}]},"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"type":"topic","url":"\/documentation\/swiftforecast\/koopmanoperator","navigatorTitle":[{"kind":"identifier","text":"KoopmanOperator"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KoopmanOperator"}],"abstract":[{"text":"Koopman Operator time-series forecasting and dynamical system modeling actor.","type":"text"},{"text":" ","type":"text"},{"text":"Uses Extended Dynamic Mode Decomposition (EDMD) to approximate non-linear dynamics","type":"text"},{"text":" ","type":"text"},{"text":"via linear operators in lifted observable feature spaces.","type":"text"}],"ti