{"topicSections":[{"anchor":"Vector-Store-Types","title":"Vector Store Types","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"]}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","title":"Guides & Tutorials","generated":true,"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"]}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"},"sections":[],"abstract":[{"text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Vector databases are essential for modern semantic search and AI agent knowledge retrieval. "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"VectorStore"},{"type":"text","text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations ("},{"type":"codeVoice","code":"vDSP_dotprD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_svesqD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_distancesqD"},{"type":"text","text":")."}],"type":"paragraph"},{"text":"1. Creating a VectorStore","anchor":"1-Creating-a-VectorStore","level":2,"type":"heading"},{"syntax":"swift","code":["import SwiftCluster","import SwiftNLP","","\/\/ Initialize vector store with Cosine Similarity","let store = VectorStore(metric: .cosineSimilarity)","","\/\/ Generate dense text embeddings","let engine = LocalEmbeddingEngine(dimension: 128)","","let articles = [","    (id: \"art_1\", title: \"Apple Silicon Architecture\", text: \"Unified memory and neural engine overview\"),","    (id: \"art_2\", title: \"Swift Strict Concurrency\", text: \"Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"],"type":"codeListing"},{"text":"2. Top-K Semantic Search","anchor":"2-Top-K-Semantic-Search","level":2,"type":"heading"},{"syntax":"swift","code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"],"type":"codeListing"},{"text":"3. Supported Metrics","anchor":"3-Supported-Metrics","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".cosineSimilarity"}]},{"type":"text","text":": Ideal for normalized text embeddings (returns "},{"type":"codeVoice","code":"[-1.0, 1.0]"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".dotProduct","type":"codeVoice"}]},{"text":": Direct inner product for unnormalized projections.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}]},{"type":"text","text":": Geometric L2 distance for spatial clustering."}]}]}],"type":"unorde