{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"collectionGroup","title":"Autoregressive Transformer Decoder Architecture","modules":[{"name":"SwiftLLM"}],"roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"sections":[],"abstract":[{"type":"text","text":"Explore the low-level mechanics of Metal GPU-accelerated transformer decoders and KV-Caching in SwiftLLM."}],"kind":"article","topicSections":[{"title":"LLM Components","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache"],"anchor":"LLM-Components"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" implements modern decoder-only generative transformer models (such as Llama, Qwen, and Gemma) leveraging MLX Metal acceleration on Apple Silicon unified memory."}],"type":"paragraph"},{"anchor":"1-Key-Architectural-Blocks","type":"heading","text":"1. Key Architectural Blocks","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Rotary Position Embedding (RoPE)"}],"type":"strong"},{"text":": Encodes positional information by rotating query and key vectors in 2D planes, preserving relative distance relationships.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"RMSNorm"}],"type":"strong"},{"text":": Root Mean Square Layer Normalization provides training stability with reduced computational overhead compared to LayerNorm.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"SwiGLU Activation"}],"type":"strong"},{"text":": Gated linear unit activation ","type":"text"},{"code":"SwiGLU(x) = Swish(x · W_1) ⊙ (x · W_2)","type":"codeVoice"},{"text":" for enhanced non-linear representation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Paged KV-Cache"}],"type":"strong"},{"text":": Stores precomputed Key and Value projection matrices across generation steps, eliminating ","type":"text"},{"code":"O(N²)","type":"codeVoice"},{"text":" recomputation.","type":"text"}],"type":"paragraph"}]}]},{"text":"2. Generating Tokens","type":"heading","anchor":"2-Generating-Tokens","level":2},{"code":["import SwiftLLM","","\/\/ Load model weights and tokenizer","let config = LLMConfiguration(","    vocabSize: 32000,","    hiddenDimension: 4096,","    numLayers: 32,","    numHeads: 32,","    contextLength: 4096",")","","let model = TransformerDecoder(configuration: config)","","\/\/ Stream autoregressive tokens","for try await token in model.generateStream(prompt: \"The future of scientific computing\", maxTokens: 50) {","    print(token, terminator: \"\")","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/transformerdecoderinference"]}],"references":{"doc://SwiftLLM/documentation/SwiftLLM":{"role":"collection","abstract":[{"text":"Local Causal Transformer Decoder & Weight Parsers.","type":"text"}],"url":"\/documentation\/swiftllm","type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","title":"SwiftLLM","kind":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoder":{"role":"symbol","abstract":[{"text":"A full N-layer decoder-only Transformer.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"TransformerDecoder"}],"url":"\/documentation\/swiftllm\/transformerdecoder","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"TransformerDecoder"}],"identifier":"doc:\/