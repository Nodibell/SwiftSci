{"variants":[{"paths":["\/documentation\/swiftml\/earlystoppingcallbacks"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Iterative estimators like multi-layer perceptrons ("},{"type":"codeVoice","code":"MLPClassifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"MLPRegressor"},{"type":"text","text":") and gradient boosted decision trees ("},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"type":"text","text":") improve their training loss over successive iterations. However, after sufficient capacity has been fit, additional epochs frequently lead to overfitting on training noise and deteriorating generalization on unseen data."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"EarlyStopping"},{"type":"text","text":" provides a decoupled, value-type training callback that monitors validation loss or performance metrics across successive epochs, halting training and optionally restoring optimal model weights."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Mechanics & State Machine","anchor":"Mechanics--State-Machine"},{"type":"codeListing","syntax":null,"code":["Epoch Evaluation (Score S_t)","            │","            ▼"," Is (Best - S_t) > minDelta?","   ├── YES ──► Reset wait = 0, update bestScore = S_t, checkpoint weights","   └── NO  ──► Increment wait = wait + 1","                 │","            Is wait >= patience?","              ├── YES ──► shouldStop = true, restore best checkpoint weights","              └── NO  ──► Continue training"]},{"type":"heading","level":3,"anchor":"Configuration-Parameters","text":"Configuration Parameters"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"patience","type":"codeVoice"},{"text":": Number of consecutive non-improving evaluations tolerated before triggering an early halt.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"minDelta"},{"type":"text","text":": Minimum absolute improvement required to qualify as progress."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"direction"},{"type":"text","text":": "},{"type":"codeVoice","code":".minimize"},{"type":"text","text":" for loss functions (cross-entropy, MSE) or "},{"type":"codeVoice","code":".maximize"},{"type":"text","text":" for scoring metrics (accuracy, R2, AUC)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"restoreBestWeights"},{"type":"text","text":": When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", automatically restores the model parameters from the epoch that achieved "},{"type":"codeVoice","code":"bestScore"},{"type":"text","text":", avoiding overfit tail iterations."}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Example-Usage","text":"Example Usage"},{"code":["import SwiftML","","\/\/ 1. Configure early stopping callback","let es = EarlyStopping(","    patience: 5,","    minDelta: 1e-4,","    direction: .minimize,","    restoreBestWeights: true",")","","\/\/ 2. Fit MLP with validation monitoring","let mlp = MLPClassifier(hiddenLayerSizes: [32, 16], maxIter: 200)","try await mlp.fit(","    features: X_train,","    targets: y_train,","    validationFeatures: X_val,","    validationTargets: y_val,","    earlyStopping: es",")"],"syntax":"swift","type":"codeListing"}]}],"sections":[],"metadata":{"modules":[{"name":"SwiftML"}],"role":"collectionGroup","title":"Early Stopping & Generalization Control","roleHeading":"API Collection"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks"},"kind":"article","abstract":[{"type":"text","text":"Halt iterative training dyna