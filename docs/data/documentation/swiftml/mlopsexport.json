at support exporting a trained model"},{"type":"text","text":" "},{"type":"text","text":"as a binary Apple Core ML "},{"code":".mlmodel","type":"codeVoice"},{"type":"text","text":" artifact."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreMLExportable","kind":"identifier"}],"navigatorTitle":[{"text":"CoreMLExportable","kind":"identifier"}]},"doc://SwiftML/documentation/SwiftML/ONNXExporter":{"url":"\/documentation\/swiftml\/onnxexporter","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ONNXExporter","kind":"identifier"}],"navigatorTitle":[{"text":"ONNXExporter","kind":"identifier"}],"abstract":[{"text":"Exporter for serializing SwiftML models into ONNX model graph specification JSON format.","type":"text"},{"text":" ","type":"text"},{"text":"Note: Produces a JSON representation of the ONNX graph, not a binary .onnx file.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter","title":"ONNXExporter","type":"topic"},"doc://SwiftML/documentation/SwiftML/HistogramGradientBoosting":{"title":"Fast Tabular Learning with Histogram Gradient Boosting","url":"\/documentation\/swiftml\/histogramgradientboosting","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","role":"collectionGroup","abstract":[{"type":"text","text":"Discretize continuous feature distributions into 256 compact bins to accelerate decision tree split evaluations from (O(N \\log N)) to (O(K))."}],"kind":"article","type":"topic"},"doc://SwiftML/documentation/SwiftML/PreparedRegression":{"title":"Prepared regression","url":"\/documentation\/swiftml\/preparedregression","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","role":"article","type":"topic","kind":"article","abstract":[{"text":"Fit and predict from compact numeric columns without constructing nested row arrays in the StandardScaler and LinearRegression path.","