{"metadata":{"modules":[{"name":"SwiftML"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Early Stopping & Generalization Control"},"abstract":[{"text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting.","type":"text"}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Iterative estimators like multi-layer perceptrons (","type":"text"},{"code":"MLPClassifier","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MLPRegressor","type":"codeVoice"},{"text":") and gradient boosted decision trees (","type":"text"},{"code":"GradientBoostedTreesRegressor","type":"codeVoice"},{"text":") improve their training loss over successive iterations. However, after sufficient capacity has been fit, additional epochs frequently lead to overfitting on training noise and deteriorating generalization on unseen data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"EarlyStopping","type":"codeVoice"},{"text":" provides a decoupled, value-type training callback that monitors validation loss or performance metrics across successive epochs, halting training and optionally restoring optimal model weights.","type":"text"}]},{"type":"heading","anchor":"Mechanics--State-Machine","level":2,"text":"Mechanics & State Machine"},{"type":"codeListing","syntax":null,"code":["Epoch Evaluation (Score S_t)","            │","            ▼"," Is (Best - S_t) > minDelta?","   ├── YES ──► Reset wait = 0, update bestScore = S_t, checkpoint weights","   └── NO  ──► Increment wait = wait + 1","                 │","            Is wait >= patience?","              ├── YES ──► shouldStop = true, restore best checkpoint weights","              └── NO  ──► Continue training"]},{"type":"heading","anchor":"Configuration-Parameters","level":3,"text":"Configuration Parameters"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"patience","type":"codeVoice"},{"text":": Number of consecutive non-improving evaluations tolerated before triggering an early halt.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"minDelta","type":"codeVoice"},{"text":": Minimum absolute improvement required to qualify as progress.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"direction","type":"codeVoice"},{"text":": ","type":"text"},{"code":".minimize","type":"codeVoice"},{"text":" for loss functions (cross-entropy, MSE) or ","type":"text"},{"code":".maximize","type":"codeVoice"},{"text":" for scoring metrics (accuracy, R2, AUC).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"restoreBestWeights","type":"codeVoice"},{"text":": When ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", automatically restores the model parameters from the epoch that achieved ","type":"text"},{"code":"bestScore","type":"codeVoice"},{"text":", avoiding overfit tail iterations.","type":"text"}]}]}]},{"type":"heading","anchor":"Example-Usage","level":2,"text":"Example Usage"},{"type":"codeListing","syntax":"swift","code":["import SwiftML","","\/\/ 1. Configure early stopping callback","let es = EarlyStopping(","    patience: 5,","    minDelta: 1e-4,","    direction: .minimize,","    restoreBestWeights: true",")","","\/\/ 2. Fit MLP with validation monitoring","let mlp = MLPClassifier(hiddenLayerSizes: [32, 16], maxIter: 200)","try await mlp.fit(","    features: X_train,","    targets: y_train,","    validationFeatures: X_val,","    validationTargets: y_val,","    earlyStopping: es",")"]}],"kind":"content"}],"topicSections":[{"anchor":"Training-Callbacks","title":"Training Callbacks","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStopping","doc:\/\/SwiftML\/documentation\/SwiftML\/MetricDirection"]}],"seeAlsoSections":[{"a