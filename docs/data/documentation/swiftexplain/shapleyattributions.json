{"kind":"article","topicSections":[{"title":"Explainability Engines","anchor":"Explainability-Engines","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAPExplanation","doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer"]}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Black-box machine learning models—such as deep neural networks, random forests, and gradient boosting trees—produce accurate predictions but obscure the individual feature contributions that drove a particular decision."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftExplain"},{"type":"text","text":" provides mathematically grounded, axiomatic interpretability algorithms:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","isActive":true}],"type":"strong"},{"text":": Path-dependent Shapley attributions for ","type":"text"},{"type":"codeVoice","code":"DecisionTreeClassifier"},{"text":", ","type":"text"},{"type":"codeVoice","code":"DecisionTreeRegressor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RandomForestClassifier"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"RandomForestRegressor"},{"text":". Solves trees with ","type":"text"},{"code":"K <= TreeSHAP.maxExactFeatures","type":"codeVoice"},{"text":" (","type":"text"},{"code":"12","type":"codeVoice"},{"text":") distinct split features exactly via $2^K$ coalition enumeration (","type":"text"},{"code":"O(2^K · L)","type":"codeVoice"},{"text":" per tree), and uses deterministic seeded Monte Carlo permutation sampling (","type":"text"},{"code":"approximationSamples = 2048","type":"codeVoice"},{"text":") with exact additive efficiency enforcement ($\\sum_i \\phi_i = f(x) - \\mathbb{E}[f(X)]$) for larger $K$.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","isActive":true}],"type":"strong"},{"text":": Model-agnostic explainer solving constrained weighted linear regression against an empirical background dataset for any arbitrary asynchronous prediction function.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","isActive":true}],"type":"strong"},{"text":": Local Interpretable Model-agnostic Explanations fitting ridge linear surrogate models around perturbed neighborhoods.","type":"text"}]}]}],"type":"orderedList"},{"type":"codeListing","code":["graph TD","    Model[Trained Model \/ Ensemble] --> ModelType{Model Architecture}","    ModelType -->|Tree Ensemble \/ Forest| Tree[TreeSHAP: Exact K<=12 \/ Seeded MC K>12]","    ModelType -->|Arbitrary Black-Box \/ Pipeline| Kernel[KernelSHAP: Empirical Regression]","    ModelType -->|Local Linear Surrogate| LIME[LIMEExplainer: Perturbation Neighborhood]","    Tree --> Attributions[Shapley Attributions: sum phi_i = f(x) - E(f)]","    Kernel --> Attributions","    LIME --> SurrogateWeights[Local Coefficients + R^2 Goodness of Fit]","    Attributions --> FeatureRanking[Feature Importance Ranking & Waterfall Breakdown]"],"syntax":"mermaid"},{"type":"thematicBreak"},{"type":"heading","anchor":"1-Path-Dependent-TreeSHAP-for-Tree-Ensembles","level":2,"text":"1. Path-Dependent TreeSHAP for Tree Ensembles"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP"},{"type":"text","text":" evaluates path-dependent conditional expectations over a tree’s internal sample weights (Lundberg et al., 2018; Nature Machine Intelligence):"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"When a tree splits on ","type":"text"},{"type":"codeVoice","code":"K <= TreeSHAP.maxExactFeatures"},{"type":"text","text":" ("},{"type":"codeVoice","code":"12"},{"type":"text","text":") distinct features, "},{"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","isActive":true},{"type":"text","text":" enumerates all $2^K$ coalitions to return "},{"type":"strong","inlineContent":[{"text":"exact","type":"text"}]},{"text":" path-dependent Shapley values (","type":"text"},{"code":"O(2^K · L)","type":"codeVoice"},{"text":" per tree).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"K > 12","type":"codeVoice"},{"text":", ","type":"text"},{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","isActive":true,"type":"reference"},{"text":" switches to deterministic Monte Carlo permutation sampling (","type":"text"},{"code":"TreeSHAP.approximationSamples = 2048","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"permutationSeed","type":"codeVoice"},{"text":"), renormalizing any efficiency discrepancy evenly across active features. Use ","type":"text"},{"code":"treeShap.isExact(tree:numFeatures:)","type":"codeVoice"},{"text":" to inspect which regime a tree uses.","type":"text"}]}]}],"type":"unorderedList"},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Known limitations in "},{"type":"codeVoice","code":"v3.13.x"},{"type":"text","text":" (deferred to a future release):"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"G-035 (","type":"text"},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"text":")","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"TreeSHAP","type":"codeVoice"},{"text":" has no adapter for ","type":"text"},{"code":"GradientBoostedTreesRegressor","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"v3.13.x","type":"codeVoice"},{"text":" (","type":"text"},{"code":"explainDetailed(trees:)","type":"codeVoice"},{"text":" averages uniformly by ","type":"text"},{"code":"1\/T","type":"codeVoice"},{"text":" rather than summing ","type":"text"},{"code":"initialPrediction + learningRate * sum_m T_m(x)","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"G-036 (Classification & Leaf Weights)","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"FlatTreeNode","type":"codeVoice"},{"text":" does not store training sample ","type":"text"},{"code":"cover","type":"codeVoice"},{"text":" (all leaves receive uniform ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" weight), ","type":"text"},{"code":"RandomForestClassifier","type":"codeVoice"},{"text":" leaves do not persist ","type":"text"},{"code":"classDistribution","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"DecisionTreeClassifier.prune(alpha:)","type":"codeVoice"},{"text":" clears ","type":"text"},{"code":"classDistribution","type":"codeVoice"},{"text":" on pruned leaves. Classifier ","type":"text"},{"code":"TreeSHAP","type":"codeVoice"},{"text":" attributes the scalar ","type":"text"},{"code":"node.value","type":"codeVoice"},{"text":" label code rather than per-class ","type":"text"},{"code":"predictProbability","type":"codeVoice"},{"text":" distributions.","type":"text"}]}]}],"type":"unorderedList"}],"style":"important"},{"type":"codeListing","syntax":"swift","code":["import SwiftML","import SwiftExplain","","\/\/ 1. Train a Random Forest model on feature data","let rf = RandomForestClassifier(nEstimators: 50, maxDepth: 6)","try await rf.fit(features: X_train, targets: y_train)","","\/\/ 2. Initialize TreeSHAP explainer","let treeShap = TreeSHAP()","","\/\/ 3. Compute exact Shapley attributions for an individual observation","let testInstance = X_test[0]","let shapValues = await treeShap.explain(randomForest: rf, instance: testInstance)","","\/\/ 4. Rank features by absolute impact on the decision","let featureNames = [\"Income\", \"DebtToIncome\", \"CreditScore\", \"EmploymentYears\", \"LoanAmount\"]","let ranked = zip(featureNames, shapValues).sorted { abs($0.1) > abs($1.1) }","","print(\"Feature attributions for instance:\")","for (name, phi) in ranked {","    let direction = phi >= 0 ? \"+\" : \"-\"","    print(\"  • \\(name): \\(direction)\\(String(format: \"%.4f\", abs(phi)))\")","}"]},{"type":"heading","text":"Concurrent Batch Explanations","anchor":"Concurrent-Batch-Explanations","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For dataset-wide interpretability or global summary plots, compute attributions concurrently across Apple Silicon CPU cores:"}]},{"type":"codeListing","syntax":"swift","code":["let flatTrees = await rf.flatTrees","let batchAttributions = await treeShap.explainBatch(","    trees: flatTrees,","    instances: X_test,","    numFeatures: featureNames.count",")","print(\"Computed SHAP matrix for \\(batchAttributions.count) instances.\")"]},{"type":"thematicBreak"},{"type":"heading","text":"2. Model-Agnostic Explanations with `KernelSHAP`","anchor":"2-Model-Agnostic-Explanations-with-KernelSHAP","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When interpreting models without tree structures—such as support vector machines, neural decoders, or multi-stage pipelines—"},{"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","isActive":true},{"type":"text","text":" estimates Shapley values through weighted linear regression over coalition permutations:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","","\/\/ 1. Initialize KernelSHAP explainer actor","let kernelShap = KernelSHAP()","","\/\/ 2. Compute Shapley attributions using background baseline dataset","let attributions = await kernelShap.explain(","    model: { features in","        \/\/ Any asynchronous prediction function mapping [Double] -> Double","        return await myNeuralNetwork.predict(features)","    },","    instance: testInstance,","    background: backgroundSampleData,","    numCoalitions: 300",")","","print(\"KernelSHAP Attributions: \\(attributions)\")"]},{"type":"thematicBreak"},{"type":"heading","text":"3. Local Surrogate Explanations with LIME","anchor":"3-Local-Surrogate-Explanations-with-LIME","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","isActive":true},{"type":"text","text":" perturbs the target instance with Gaussian noise, queries the black-box model on the neighborhood, and trains an interpretable, locally-weighted ridge linear surrogate:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","","let lime = LIMEExplainer(kernelWidth: 0.75, regularization: 1.0)","","let explanation = await lime.explain(","    model: { x in await complexPipeline.predictScore(x) },","    instance: testInstance,","    numSamples: 500",")","","print(\"Local Model Intercept: \\(explanation.intercept)\")","print(\"Local Surrogate Fidelity (R²): \\(String(format: \"%.3f\", explanation.localR2))\")","","for (idx, weight) in explanation.featureWeights.enumerated() {","    print(\"Feature \\(idx) Local Weight: \\(String(format: \"%.4f\", weight))\")","}"]},{"type":"thematicBreak"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/shapleyattributions"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions"},"abstract":[{"text":"Explain machine learning model predictions with game-theoretic Shapley value attributions (TreeSHAP, KernelSHAP) and local linear surrogates (LIME).","type":"text"}],"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability"],"generated":true}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"SHAP & LIME Model Interpretability","roleHeading":"API Collection","modules":[{"name":"SwiftExplain"}],"role":"collectionGroup"},"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"type":"topic","title":"SwiftExplain","url":"\/documentation\/swiftexplain","role":"collection","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}],"kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain"},"doc://SwiftExplain/documentation/SwiftExplain/ModelInterpretability":{"type":"topic","title":"Model Interpretability & XAI Guide","url":"\/documentation\/swiftexplain\/modelinterpretability","role":"article","abstract":[{"text":"Understand black-box machine learning predictions using ","type":"text"},{"type":"codeVoice","code":"TreeSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"KernelSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"LIMEExplainer"},{"type":"text","text":", "},{"code":"PermutationImportance","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"PartialDependencePlot","type":"codeVoice"},{"text":".","type":"text"}],"kind":"article","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability"},"doc://SwiftExplain/documentation/SwiftExplain/TreeSHAP":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TreeSHAP"}],"navigatorTitle":[{"kind":"identifier","text":"TreeSHAP"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","abstract":[{"type":"text","text":"TreeSHAP (Tree Shapley Additive Explanations) for decision trees and random forests"},{"type":"text","text":" "},{"type":"text","text":"(path-dependent formulation following Lundberg et al., 2018; Nature Machine Intelligence)."}],"role":"symbol","title":"TreeSHAP","type":"topic","url":"\/documentation\/swiftexplain\/treeshap","kind":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"type":"topic","title":"KernelSHAP","url":"\/documentation\/swiftexplain\/kernelshap","role":"symbol","abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}],"kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"KernelSHAP"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}]},"doc://SwiftExplain/documentation/SwiftExplain/TreeSHAPExplanation":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeSHAPExplanation","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"TreeSHAPExplanation"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAPExplanation","abstract":[{"type":"text","text":"Explanation structure containing TreeSHAP attributions and baseline predictions"},{"type":"text","text":" "},{"text":"(exact when ","type":"text"},{"type":"codeVoice","code":"K <= TreeSHAP.maxExactFeatures"},{"type":"text","text":", seeded Monte Carlo permutation estimate otherwise)."}],"role":"symbol","type":"topic","url":"\/documentation\/swiftexplain\/treeshapexplanation","title":"TreeSHAPExplanation","kind":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain/LIMEExplainer":{"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"LIMEExplainer"}],"navigatorTitle":[{"kind":"identifier","text":"LIMEExplainer"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","abstract":[{"type":"text","text":"