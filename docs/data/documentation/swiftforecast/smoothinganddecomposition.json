{"sections":[],"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Temporal data analysis requires separating underlying long-term trends, periodic seasonal patterns, and random innovations. ","type":"text"},{"code":"SwiftForecast","type":"codeVoice"},{"text":" provides hardware-accelerated time-series models leveraging Apple Accelerate FFT convolution and LAPACK linear solvers.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"1. Holt-Winters Exponential Smoothing & Nelder-Mead Optimization","anchor":"1-Holt-Winters-Exponential-Smoothing--Nelder-Mead-Optimization"},{"type":"paragraph","inlineContent":[{"code":"ExponentialSmoothing","type":"codeVoice"},{"text":" models level (","type":"text"},{"code":"α","type":"codeVoice"},{"text":"), trend (","type":"text"},{"code":"β","type":"codeVoice"},{"text":"), and seasonal (","type":"text"},{"code":"γ","type":"codeVoice"},{"text":") components with additive or multiplicative adjustments:","type":"text"}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Additive Formulation:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"ŷ_{t+h|t} = ℓ_t + h · b_t + s_{t+h-m(k+1)}","type":"codeVoice"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Parameters ","type":"text"},{"code":"α, β, γ","type":"codeVoice"},{"text":" are automatically optimized using the ","type":"text"},{"inlineContent":[{"text":"Nelder-Mead simplex optimizer","type":"text"}],"type":"strong"},{"text":" minimizing Mean Squared Error (MSE):","type":"text"}]},{"type":"codeListing","code":["import Foundation","import SwiftForecast","","\/\/ 1. Synthetic monthly seasonal dataset (36 observations, 3 years)","let series = (0..<36).map { t in","    let trend = 10.0 + Double(t) * 0.5","    let seasonal = sin(Double(t % 12) * 2.0 * Double.pi \/ 12.0) * 3.0","    return trend + seasonal + Double.random(in: -0.2...0.2)","}","","\/\/ 2. Configure Triple Exponential Smoothing (Holt-Winters)","let model = ExponentialSmoothing(","    trend: .additive,","    seasonal: .additive,","    seasonalPeriods: 12",")","","\/\/ 3. Fit parameters via continuous Nelder-Mead Simplex search","try model.fit(series: series)","","if let alpha = model.alpha, let beta = model.beta, let gamma = model.gamma {","    print(\"Optimized Parameters: alpha=\\(String(format: \"%.3f\", alpha)), beta=\\(String(format: \"%.3f\", beta)), gamma=\\(String(format: \"%.3f\", gamma))\")","}","","\/\/ 4. Forecast future periods","let forecast = try model.forecast(steps: 12)","print(\"12-Month Out-of-Sample Forecast: \\(forecast)\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"2. High-Performance 1D Kalman Filter (LAPACK `dgesv`)","anchor":"2-High-Performance-1D-Kalman-Filter-LAPACK-dgesv"},{"type":"paragraph","inlineContent":[{"code":"KalmanFilter","type":"codeVoice"},{"text":" estimates the hidden state vector of a linear dynamic system over time from noisy observations. The implementation uses contiguous 1D flat buffers with Apple Accelerate LAPACK ","type":"text"},{"code":"dgesv","type":"codeVoice"},{"text":" matrix inversions:","type":"text"}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"State Prediction:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"x_{k|k-1} = F_k · x_{k-1|k-1} + B_k · u_k","type":"codeVoice"},{"text":"","type":"text"},{"text":"\n","type":"text"},{"inlineContent":[{"type":"text","text":"Covariance Prediction:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"P_{k|k-1} = F_k · P_{k-1|k-1} · F_k^T + Q_k","type":"codeVoice"},{"text":"","type":"text"},{"text":"\n","type":"text"},{"inlineContent":[{"type":"text","text":"Kalman Gain:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"K_k = P_{k|k-1} · H_k^T · (H_k · P_{k|k-1} · H_k^T + R_k)^{-1}","type":"codeVoice"}],"type":"paragraph"}]},{"type":"codeListing","code":["import SwiftForecast","","\/\/ 1. Configure 2D state system: [position, velocity] with 1D observation [position]","let stateDim = 2","let obsDim = 1","","\/\/ State Transition Matrix F: position += dt * velocity","let F: [Double] = [","    1.0, 1.0,  \/\/ row 0: pos = 1.0*pos + 1.0*vel","    0.0, 1.0   \/\/ row 1: vel = 0.0*pos + 1.0*vel","]","","\/\/ Observation Matrix H: we measure position","let H: [Double] = [1.0, 0.0]","","\/\/ Process Noise Q and Measurement Noise R","let Q: [Double] = [","    0.01, 0.0,","    0.0,  0.01","]","let R: [Double] = [0.1]","","\/\/ Initial State and Covariance","let x0: [Double] = [0.0, 1.0]","let P0: [Double] = [","    1.0, 0.0,","    0.0, 1.0","]","","var kf = try KalmanFilter(","    stateDim: stateDim,","    obsDim: obsDim,","    transitionMatrix: F,","    observationMatrix: H,","    processNoise: Q,","    measurementNoise: R,","    initialState: x0,","    initialCovariance: P0",")","","\/\/ 2. Track real-time noisy trajectory","let noisyMeasurements: [[Double]] = [[0.95], [2.05], [2.98], [4.12], [5.01]]","","print(\"=== Kalman Filtering Updates ===\")","for (step, z) in noisyMeasurements.enumerated() {","    try kf.predict()","    try kf.update(observation: z)","    ","    let state = kf.state","    print(\"Step \\(step + 1): Position=\\(String(format: \"%.3f\", state[0])), Velocity=\\(String(format: \"%.3f\", state[1]))\")","}"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"3. Classical Seasonal Decomposition (STL)","anchor":"3-Classical-Seasonal-Decomposition-STL"},{"type":"paragraph","inlineContent":[{"text":"Separate series into Trend, Seasonal, and Residual components:","type":"text"}]},{"type":"codeListing","code":["let decomp = TimeSeriesDecomposition.decompose(series: series, period: 12, type: .additive)","","print(\"Extracted Trend Component count: \\(decomp.trend.compactMap { $0 }.count)\")","print(\"Seasonal Component Cycle: \\(decomp.seasonal.prefix(12))\")"],"syntax":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"SwiftForecast"}],"title":"Time Series Forecasting, Smoothing & Kalman Filtering"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Model trends, seasonality, volatility, and dynamic state transitions using "},{"type":"codeVoice","code":"ExponentialSmoothing"},{"type":"text","text":", "},{"type":"codeVoice","code":"NelderMead"},{"type":"text","text":", "},{"type":"codeVoice","code":"KalmanFilter"},{"type":"text","text":", "},{"type":"codeVoice","code":"GARCHModel"},{"type":"text","text":", and "},{"type":"codeVoice","code":"TimeSeriesDecomposition"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftforecast\/smoothinganddecomposition"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition"},"references":{"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"type":"topic","url":"\/documentation\/swiftforecast\/koopmanoperator","navigatorTitle":[{"kind":"identifier","text":"KoopmanOperator"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KoopmanOperator"}],"abstract":[{"text":"Koopman Operator time-series forecasting and dynamical system modeling actor.","type":"text"},{"text":" ","type":"text"},{"text":"Uses Extended Dynamic Mode Decomposition (EDMD) to approximate non-linear dynamics","type":"text"},{"text":" ","type":"text"},{"text":"via linear operators in lifted observable feature spaces.","type":"text"}],"title":"KoopmanOperator","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"},"doc://SwiftForecast/documentation/SwiftForecast":{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast","role":"collection","type":"topic","abstract":[{"text":"Time Series & Volatility Forecasting Models.","type":"text"}],"title":"SwiftForecast","url":"\/documentation\/swiftforecast","kind":"symbol"},"doc://SwiftForecast/documentation/SwiftForecast/ArimaAndSarima":{"type":"topic","url":"\/documentation\/swiftforecast\/arimaandsarima","abstract":[{"text":"Forecast univariate time series using Autoregressive Integrated Moving Average (ARIMA) and Seasonal ARIMA (SARIMA).","type":"text"}],"title":"ARIMA & SARIMA Time Series Models","role":"article","kind":"article","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAParallel":{"role":"collectionGroup","type":"topic","title":"Concurrent Order Selection with AutoARIMA","kind":"article","url":"\/documentation\/swiftforecast\/autoarimaparallel","abstract":[{"type":"text","text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency."}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel"}}}