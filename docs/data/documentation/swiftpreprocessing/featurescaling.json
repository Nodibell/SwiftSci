{"kind":"article","identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"],"anchor":"Guides--Tutorials"}],"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftPreprocessing"}],"title":"Feature Scaling, Normalization & Flat 1D Memory","role":"article"},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Feature scaling is crucial for gradient-based estimators (Neural Networks, Logistic Regression) and distance-based estimators (KNN, DBSCAN, SVM). Without scaling, features with large numeric scales disproportionately dominate distance calculations and gradient updates."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"%E2%9A%A1-Flat-1D-Memory-Layout--Hardware-Vectorization","level":2,"type":"heading","text":"⚡ Flat 1D Memory Layout & Hardware Vectorization"},{"inlineContent":[{"type":"codeVoice","code":"SwiftPreprocessing"},{"type":"text","text":" operates on contiguous 1D row-major flat buffers "},{"type":"codeVoice","code":"[Double]"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"[Float]"},{"type":"text","text":") with stride indexing "},{"type":"codeVoice","code":"index = row * cols + col"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"All arithmetic operations ("},{"type":"codeVoice","code":"vDSP_vsubD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_vsdivD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP.sort"},{"type":"text","text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"1-StandardScaler-Z-Score-Standardization","level":2,"type":"heading","text":"1. `StandardScaler` (Z-Score Standardization)"},{"inlineContent":[{"type":"text","text":"Transforms features to have zero mean ("},{"type":"codeVoice","code":"μ = 0"},{"type":"text","text":") and unit variance ("},{"type":"codeVoice","code":"σ² = 1"},{"type":"text","text":"):"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"z = (x - μ) \/ σ","type":"codeVoice"}]}],"style":"note","type":"aside","name":"Note"},{"code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"anchor":"2-MinMaxScaler-Bounded-Range-Scaling","level":2,"type":"heading","text":"2. `MinMaxScaler` (Bounded Range Scaling)"},{"inlineContent":[{"type":"text","text":"Linearly transforms features into a bounded range "},{"type":"codeVoice","code":"[a, b]"},{"type":"text","text":" (defaults to "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":"):"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)","type":"codeVoice"}]}],"style":"note","type":"aside","name":"Note"},{"code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"anchor":"3-RobustScaler-Median--IQR-Scaling","level":2,"type":"heading","text":"3. `RobustScaler` (Median & IQR Scaling)"},{"inlineContent":[{"type":"text","text":"When datasets contain extreme outliers, mean and standard deviation are distorted. "},{"type":"codeVoice","code":"RobustScaler"},{"type":"text","text":" scales features using the "},{"type":"strong","inlineContent":[{"text":"Median","type":"text"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"text":"Interquartile Range (IQR = Q3 - Q1)","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"x' = (x - Median) \/ IQR","type":"codeVoice"}]}],"style":"note","type":"aside","name":"Note"},{"code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling","level":2,"type":"heading","text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)"},{"inlineContent":[{"type":"text","text":"Scales each sample independently to have unit L1, L2, or Max norm:"}],"type":"paragraph"},{"code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Memory & Performance Tip:"}],"type":"strong"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"code":"Float","type":"codeVoice"},{"text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput.","type":"text"}]}],"style":"note","type":"aside","name":"Note"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using "},{"code":"StandardScaler","type":"codeVoice"},{"type":"text","text":", "},{"code":"MinMaxScaler","type":"codeVoice"},{"type":"text","text":", "},{"code":"RobustScaler","type":"codeVoice"},{"type":"text","text":", and "},{"code":"Normalizer","type":"codeVoice"},{"type":"text","text":" powered by Apple Accelerate "},{"code":"vDSP","type":"codeVoice"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/swiftpreprocessing\/featurescaling"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"kind":"article","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","url":"\/documentation\/swiftpreprocessing\/encodersandimputers","type":"topic","role":"article","title":"Categorical Encoding & Imputation","abstract":[{"type":"text","text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer."}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseDataStructures":{"kind":"article","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","url":"\/documentation\/swiftpreprocessing\/sparsedatastructures","type":"topic","role":"collectionGroup","title":"Memory-Efficient Sparse Matrix Representations","abstract":[{"type":"text","text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats."}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"kind":"symbol","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","url":"\/documentation\/swiftpreprocessing","type":"topic","role":"collection","title":"SwiftPreprocessing","abstract":[{"text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines.","type":"text"}]}}}