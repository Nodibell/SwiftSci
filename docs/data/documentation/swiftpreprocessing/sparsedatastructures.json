{"topicSections":[{"title":"Sparse Data Types","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"],"anchor":"Sparse-Data-Types"}],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"],"anchor":"Guides--Tutorials"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","variants":[{"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"abstract":[{"type":"text","text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats."}],"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftPreprocessing"}],"title":"Memory-Efficient Sparse Matrix Representations","role":"collectionGroup"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x."}],"type":"paragraph"},{"anchor":"Storage-Formats","level":2,"type":"heading","text":"Storage Formats"},{"anchor":"Compressed-Sparse-Row-CSR","level":3,"type":"heading","text":"Compressed Sparse Row (CSR)"},{"inlineContent":[{"type":"text","text":"Stores non-zero values row-by-row:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"values"},{"type":"text","text":": Non-zero numerical entries."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"colIndices"},{"type":"text","text":": Column indices corresponding to each entry in "},{"type":"codeVoice","code":"values"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"rowPointers"},{"type":"text","text":": Offsets into "},{"type":"codeVoice","code":"values"},{"type":"text","text":" marking where each row begins (length: "},{"type":"codeVoice","code":"rowCount + 1"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"],"syntax":null,"type":"codeListing"},{"anchor":"Compressed-Sparse-Column-CSC","level":3,"type":"heading","text":"Compressed Sparse Column (CSC)"},{"inlineContent":[{"type":"text","text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication."}],"type":"paragraph"},{"anchor":"Apple-Accelerate-Sparse-BLAS","level":2,"type":"heading","text":"Apple Accelerate Sparse BLAS"},{"inlineContent":[{"type":"text","text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_matrix_create_double"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_insert_row_double"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_commit"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_matrix_vector_product_dense_double"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput."}],"type":"paragraph"},{"anchor":"Example-Usage","level":2,"type":"heading","text":"Example Usage"},{"code":["import SwiftPreprocessing","","\/\/ 1. Create a sparse matrix from a dense array","let dense: [[Double]] = [","    [1.0, 0.0, 0.0],","    [0.0, 2.0, 0.0],","    [0.0, 0.0, 3.0]","]","let sparse = SparseMatrix(dense: dense, format: .csr)","print(\"Sparsity: \\(sparse.sparsity)\") \/\/ ~ 0.667","","\/\/ 2. Accelerated matrix-vector product","let x = [1.0, 2.0, 3.0]","let y = try sparse.multiply(vector: x)","print(y) \/\/ [1.0, 4.0, 9.0]","","\/\/ 3. Matrix Transpose & CSC conversion","let csc = sparse.toCSC()","let transposed = sparse.transpose()"],"syntax":"swift","type":"codeListing"}]}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"kind":"article","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","url":"\/documentation\/swiftpreprocessing\/encodersandimputers","type":"topic","role":"article","title":"Categorical Encoding & Imputation","abstract":[{"type":"text","text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer."}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseMatrix":{"kind":"symbol","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","url":"\/documentation\/swiftpreprocessing\/sparsematrix","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparseMatrix","kind":"identifier"}],"type":"topic","role":"symbol","title":"SparseMatrix","navigatorTitle":[{"text":"SparseMatrix","kind":"identifier"}],"abstract":[{"text":"Memory-efficient sparse matrix storage implementing Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseFormat":{"kind":"symbol","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat","url":"\/documentation\/swiftpreprocessing\/sparseformat","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparseFormat"}],"type":"topic","role":"symbol","title":"SparseFormat","navigatorTitle":[{"kind":"identifier","text":"SparseFormat"}],"abstract":[{"type":"text","text":"Storage format for compressed sparse matrix structures."}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"kind":"symbol","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","url":"\/documentation\/swiftpreprocessing","type":"topic","role":"collection","title":"SwiftPreprocessing","abstract":[{"text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines.","type":"text"}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/FeatureScaling":{"type":"topic","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","role":"article","url":"\/documentation\/swiftpreprocessing\/featurescaling","title":"Feature Scaling, Normalization & Flat 1D Memory","kind":"article","abstract":[{"type":"text","text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using "},{"code":"StandardScaler","type":"codeVoice"},{"type":"text","text":", "},{"code":"MinMaxScaler","type":"codeVoice"},{"type":"text","text":", "},{"code":"RobustScaler"