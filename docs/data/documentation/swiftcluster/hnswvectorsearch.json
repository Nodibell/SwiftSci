tion"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"200"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Size of dynamic candidate evaluation queue during insertion. Larger values produce higher-quality graph connectivity."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"efSearch"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"50"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dynamic queue size during search traversal. Higher values increase search recall towards 100% exact match."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"metric"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".euclideanDistance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choice of "},{"type":"codeVoice","code":".euclideanDistance"},{"type":"text","text":", "},{"type":"codeVoice","code":".cosineSimilarity"},{"type":"text","text":", or "},{"type":"codeVoice","code":".dotProduct"},{"type":"text","text":"."}]}]]],"type":"table","header":"row","alignments":["left","left","left"]},{"level":2,"anchor":"Example-Usage","text":"Example Usage","type":"heading"},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","\/\/ 1. Initialize the actor-isolated index","let hnsw = HNSWIndex(metric: .cosineSimilarity, M: 16, efConstruction: 200, efSearch: 50)","","\/\/ 2. Add embeddings asynchronously","await hnsw.add(id: \"doc_news_1\", vector: [0.12, 0.94, -0.31], metadata: [\"category\": \"news\"])","await hnsw.add(id: \"doc_tech_2\", vector: [-0.85, 0.11, 0.52], metadata: [\"category\": \"technology\"])","","\/\/ 3. Query Top-K nearest neighbors","let queryEmbedding = [0.10, 0.90, -0.30]","let matches = await hnsw.search(query: queryEmbedding, topK: 5)","","for match in matches {","    print(\"Matched: \\(match.id) with score: \\(match.score)\")","}"]},{"level":2,"anchor":"Thread-Safety--Swift-6-Strict-Concurrency","tex