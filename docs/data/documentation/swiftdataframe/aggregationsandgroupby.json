{"sections":[],"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory.","type":"text"}],"type":"paragraph"},{"anchor":"1-Basic-GroupBy-Aggregation","type":"heading","text":"1. Basic GroupBy Aggregation","level":2},{"syntax":"swift","type":"codeListing","code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"]},{"anchor":"2-Multi-Column-Grouping","type":"heading","text":"2. Multi-Column Grouping","level":2},{"inlineContent":[{"type":"text","text":"You can group by multiple categorical dimensions simultaneously:"}],"type":"paragraph"},{"code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"],"syntax":"swift","type":"codeListing"},{"text":"3. Performance & Memory Efficiency","type":"heading","anchor":"3-Performance--Memory-Efficiency","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Single-Pass Hash Accumulation"}],"type":"strong"},{"text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"vDSP Vector Reductions","type":"text"}],"type":"strong"},{"text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines (","type":"text"},{"type":"codeVoice","code":"vDSP_sveD"},{"text":", ","type":"text"},{"type":"codeVoice","code":"vDSP_meanvD"},{"text":").","type":"text"}],"type":"paragraph"}]}]}]}],"abstract":[{"text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"]}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"High-Performance GroupBy & Vectorized Aggregations","modules":[{"name":"SwiftDataFrame"}]},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"topicSections":[{"anchor":"Grouping-APIs","title":"Grouping APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"]}],"kind":"article","references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"title":"SwiftDataFrame","url":"\/documentation\/swiftdataframe","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","role":"collection","type":"topic","abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"type":"topic","abstract":[{"type":"text","text":"Returns a "},{"code":"GroupedDataFrame","type":"codeVoice"},{"type":"text","text"