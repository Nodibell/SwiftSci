{"metadata":{"title":"Feature Scaling, Normalization & Flat 1D Memory","modules":[{"name":"SwiftPreprocessing"}],"role":"article","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftpreprocessing\/featurescaling"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"],"generated":true,"anchor":"Guides--Tutorials"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Feature scaling is crucial for gradient-based estimators (Neural Networks, Logistic Regression) and distance-based estimators (KNN, DBSCAN, SVM). Without scaling, features with large numeric scales disproportionately dominate distance calculations and gradient updates."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"%E2%9A%A1-Flat-1D-Memory-Layout--Hardware-Vectorization","level":2,"text":"⚡ Flat 1D Memory Layout & Hardware Vectorization","type":"heading"},{"inlineContent":[{"code":"SwiftPreprocessing","type":"codeVoice"},{"text":" operates on contiguous 1D row-major flat buffers ","type":"text"},{"code":"[Double]","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"[Float]","type":"codeVoice"},{"text":") with stride indexing ","type":"text"},{"code":"index = row * cols + col","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"]},{"inlineContent":[{"type":"text","text":"All arithmetic operations ("},{"type":"codeVoice","code":"vDSP_vsubD"},{"text":", ","type":"text"},{"code":"vDSP_vsdivD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP.sort","type":"codeVoice"},{"text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"1-StandardScaler-Z-Score-Standardization","text":"1. `StandardScaler` (Z-Score Standardization)","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Transforms features to have zero mean ("},{"type":"codeVoice","code":"μ = 0"},{"type":"text","text":") and unit variance ("},{"type":"codeVoice","code":"σ² = 1"},{"type":"text","text":"):"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"text":" ","type":"text"},{"code":"z = (x - μ) \/ σ","type":"codeVoice"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"syntax":"swift","code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"anchor":"2-MinMaxScaler-Bounded-Range-Scaling","text":"2. `MinMaxScaler` (Bounded Range Scaling)","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Linearly transforms features into a bounded range "},{"type":"codeVoice","code":"[a, b]"},{"type":"text","text":" (defaults to "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":"):"}],"type":"paragraph"},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"syntax":"swift","code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"text":"3. `RobustScaler` (Median & IQR Scaling)","anchor":"3-RobustScaler-Median--IQR-Scaling","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When datasets contain extreme outliers, mean and standard deviation are distorted. "},{"type":"codeVoice","code":"RobustScaler"},{"type":"text","text":" scales features using the "},{"type":"strong","inlineContent":[{"text":"Median","type":"text"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"Interquartile Range (IQR = Q3 - Q1)"}]},{"type":"text","text":":"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"x' = (x - Median) \/ IQR"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)","anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Scales each sample independently to have unit L1, L2, or Max norm:"}]},{"code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"],"syntax":"swift","type":"codeListing"},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Memory & Performance Tip:"}],"type":"strong"},{"text":" ","type":"text"},{"text":"Use ","type":"text"},{"type":"codeVoice","code":"Float"},{"text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"}]}],"abstract":[{"type":"text","text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using "},{"type":"codeVoice","code":"StandardScaler"},{"type":"text","text":", "},{"type":"codeVoice","code":"MinMaxScaler"},{"type":"text","text":", "},{"type":"codeVoice","code":"RobustScaler"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Normalizer"},{"type":"text","text":" powered by Apple Accelerate "},{"type":"codeVoice","code":"vDSP"},{"type":"text","text":"."}],"kind":"article","sections":[],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"role":"collection","type":"topic","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","kind":"symbol","title":"SwiftPreprocessing","url":"\/documentation\/swiftpreprocessing","abstract":[{"type":"text","text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines."}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"role":"article","type":"topic","title":"Categorical Encoding & Imputation","abstract":[{"text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer.","type":"text"}],"kind":"article","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","url":"\/documentation\/swiftpreprocessing\/encodersandimputers"}}}