{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"topicSections":[{"anchor":"Sparse-Data-Types","title":"Sparse Data Types","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"]}],"variants":[{"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x."}]},{"type":"heading","level":2,"text":"Storage Formats","anchor":"Storage-Formats"},{"type":"heading","level":3,"text":"Compressed Sparse Row (CSR)","anchor":"Compressed-Sparse-Row-CSR"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stores non-zero values row-by-row:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"values"},{"text":": Non-zero numerical entries.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"colIndices","type":"codeVoice"},{"text":": Column indices corresponding to each entry in ","type":"text"},{"code":"values","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"rowPointers","type":"codeVoice"},{"text":": Offsets into ","type":"text"},{"code":"values","type":"codeVoice"},{"text":" marking where each row begins (length: ","type":"text"},{"code":"rowCount + 1","type":"codeVoice"},{"text":").","type":"text"}]}]}]},{"type":"codeListing","syntax":null,"code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"]},{"text":"Compressed Sparse Column (CSC)","anchor":"Compressed-Sparse-Column-CSC","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication."}],"type":"paragraph"},{"text":"Apple Accelerate Sparse BLAS","anchor":"Apple-Accelerate-Sparse-BLAS","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"sparse_matrix_create_double","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_insert_row_double"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"sparse_commit","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_matrix_vector_product_dense_double"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput.","type":"text"}],"type":"paragraph"},{"text":"Example Usage","anchor":"Example-Usage","level":2,"type":"h