{"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Agent Components","anchor":"Agent-Components","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGAndContextAugmentation"},"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftAgent"}],"title":"Building On-Device RAG Pipelines","roleHeading":"API Collection"},"abstract":[{"type":"text","text":"Construct privacy-preserving Retrieval-Augmented Generation workflows on Apple Silicon."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On-Device RAG combines fast local vector retrieval with on-device language models to provide accurate, grounded answers from private local documents without cloud network dependencies."}]},{"syntax":"mermaid","code":["graph LR","    Query[User Query] --> Embed[LocalEmbeddingEngine]","    Embed --> Vec[Dense Vector]","    Vec --> Search[VectorStore Top-K]","    Docs[Private Document Index] --> Search","    Search --> Chunks[Retrieved Text Snippets]","    Chunks --> Prompt[Augmented Prompt]","    Prompt --> LLM[SwiftLLM Metal Engine]","    LLM --> Answer[Grounded Answer]"],"type":"codeListing"},{"level":2,"type":"heading","text":"1. Complete End-to-End Pipeline Example","anchor":"1-Complete-End-to-End-Pipeline-Example"},{"syntax":"swift","code":["import SwiftAgent","import SwiftCluster","import SwiftNLP","import SwiftLLM","","\/\/ 1. Initialize local embedding engine and vector store","let embedEngine = LocalEmbeddingEngine(dimension: 128)","let vectorStore = VectorStore(metric: .cosineSimilarity)","","\/\/ 2. Ingest private knowledge base","let corpus = [","    \"SwiftSci uses Apple Accelerate vDSP for SIMD arithmetic.\",","    \"MLX provides unified memory GPU tensor computation on Mac.\",","    \"WiredMemoryManager prevents out-of-memory errors on shared RAM.\"","]","","for (id, text) in corpus.enumerated() {","    let vec = embedEngine.embed(text)","    vectorStore.add(id: \"doc_\\(id)\", vector: vec, metadata: [\"content\": text])","}","","\/\/ 3. Retrieve relevant context for user question","let userQuestion = \"How does SwiftSci accelerate vector math?\"","let queryVector = embedEngine.embed(userQuestion)","let topMatches = vectorStore.search(query: queryVector, topK: 1)","","let contextSnippet = topMatches.first?.metadata[\"content\"] ?? \"\"","","\/\/ 4. Assemble augmented prompt and query local LLM","let augmentedPrompt = \"\"\"","Context: \\(contextSnippet)","Question: \\(userQuestion)","Answer:","\"\"\""],"type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"kind":"article","variants":[{"paths":["\/documentation\/swiftagent\/ragandcontextaugmentation"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"url":"\/documentation\/swiftagent","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"kind":"symbol","type":"topic","role":"collection","title":"SwiftAgent","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","title":"SwiftAgentEvaluator","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SwiftAgentEvaluator"}],"url":"\/documentation\/swiftagent\/swiftagentevaluator","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SwiftAgentEvaluator"}]}}}