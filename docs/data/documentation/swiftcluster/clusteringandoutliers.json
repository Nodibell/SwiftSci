{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"SwiftCluster"}],"title":"Spatial Indexing, Clustering & Outlier Detection"},"sections":[],"abstract":[{"text":"High-performance clustering and density-based anomaly detection powered by ","type":"text"},{"code":"KDTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DBSCAN","type":"codeVoice"},{"text":", ","type":"text"},{"code":"KMeans","type":"codeVoice"},{"text":", ","type":"text"},{"code":"LocalOutlierFactor","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"IsolationForest","type":"codeVoice"},{"text":".","type":"text"}],"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Clustering and outlier detection algorithms often suffer from quadratic distance computation bottlenecks ("},{"type":"codeVoice","code":"O(N²)"},{"type":"text","text":"). "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" employs a balanced "},{"type":"strong","inlineContent":[{"type":"text","text":"KD-Tree spatial index"}]},{"type":"text","text":" reducing neighbor queries to "},{"type":"codeVoice","code":"O(N · log N)"},{"type":"text","text":", enabling instant processing of large spatial datasets."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"⚡ Spatial Indexing: KD-Tree vs Brute-Force","anchor":"%E2%9A%A1-Spatial-Indexing-KD-Tree-vs-Brute-Force"},{"type":"table","header":"row","alignments":["left","left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dataset Size (N)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Brute-Force DBSCAN ("},{"type":"codeVoice","code":"O(N²)"},{"type":"text","text":" Distance Matrix)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftCluster KD-Tree DBSCAN ("},{"type":"codeVoice","code":"O(N · log N)"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Speedup"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"1,000 points","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"42 ms"}]}],[{"type":"paragraph","inlineContent":[{"text":"1.8 ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"23.3× faster"}],"type":"strong"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"10,000 points","type":"text"}]}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"4,250 ms (4.25 s)"}]}],[{"inlineContent":[{"text":"28 ms","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"151.7× faster","type":"text"}]}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"100,000 points","type":"text"}]}]}],[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Out of Memory (100k × 100k matrix = 80 GB RAM)","type":"text"}]}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"380 ms (0.38 s)","type":"text"}]}],[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"∞ (Memory Safe)","type":"text"}]}],"type":"paragraph"}]]]},{"type":"thematicBreak"},{"text":"1. Density-Based Clustering (`DBSCAN`)","level":2,"anchor":"1-Density-Based-Clustering-DBSCAN","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"DBSCAN","type":"codeVoice"},{"type":"text","text":" discovers clusters of arbitrary shapes and isolates noise points without requiring a pre-specified cluster count "},{"code":"K","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["import Foundation","import SwiftCluster","","\/\/ 1. Generate multi-cluster 2D coordinates","let cluster1 = (0..<100).map { _ in [Double.random(in: 0...2), Double.random(in: 0...2)] }","let cluster2 = (0..<100).map { _ in [Double.random(in: 10...12), Double.random(in: 10...12)] }","let noise = [[5.0, 5.0], [8.0, 2.0]]","let points = cluster1 + cluster2 + noise","","\/\/ 2. Initialize DBSCAN with spatial neighborhood epsilon and minPoints","let dbscan = DBSCAN(eps: 1.5, minSamples: 5)","let labels = dbscan.fit(points)","","\/\/ -1 indicates noise \/ outlier points, 0, 1, ... indicate cluster IDs","let clusterCount = Set(labels.filter { $0 >= 0 }).count","let noiseCount = labels.filter { $0 == -1 }.count","","print(\"DBSCAN identified \\(clusterCount) clusters and \\(noiseCount) noise outliers.\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"anchor":"2-K-Means++-Clustering-KMeans","text":"2. K-Means++ Clustering (`KMeans`)","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Fast centroid-based clustering using D² weighted probabilistic initialization for accelerated convergence:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftCluster","","let kmeans = KMeans(nClusters: 3, maxIterations: 100, tolerance: 1e-4, randomSeed: 42)","try await kmeans.fit(features: points)","","let centroids = await kmeans.centroids","print(\"Learned Centroids: \\(centroids)\")","","let clusterAssignments = try await kmeans.predict(features: points)","let inertia = try await kmeans.inertia(features: points)","print(\"Within-Cluster Sum of Squares (Inertia): \\(String(format: \"%.2f\", inertia))\")"],"type":"codeListing"},{"type":"thematicBreak"},{"anchor":"3-Density-Based-Outlier-Detection-LocalOutlierFactor","text":"3. Density-Based Outlier Detection (`LocalOutlierFactor`)","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalOutlierFactor"},{"type":"text","text":" measures local density deviation of an observation relative to its K-nearest neighbors:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","let lof = LocalOutlierFactor(nNeighbors: 15, maxSamples: 5000)","let outlierLabels = try lof.fitPredict(points)","","\/\/ -1 indicates local density anomaly, +1 indicates inlier","let anomalies = outlierLabels.enumerated().filter { $0.element == -1 }.map { $0.offset }","print(\"LOF detected anomalies at indices: \\(anomalies)\")"]},{"type":"thematicBreak"},{"text":"4. Isolation Forest for High-Dimensional Anomaly Detection","level":2,"type":"heading","anchor":"4-Isolation-Forest-for-High-Dimensional-Anomaly-Detection"},{"type":"paragraph","inlineContent":[{"code":"IsolationForest","type":"codeVoice"},{"type":"text","text":" recursively partitions feature subspaces using random split hyperplanes. Anomalies require significantly fewer splits to isolate:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftCluster","","let isoForest = IsolationForest(nEstimators: 100, maxSamples: 256, contamination: 0.05, randomSeed: 42)","try await isoForest.fit(features: points)","","let anomalyScores = try await isoForest.decisionFunction(features: points)","let predictions = try await isoForest.predict(features: points)","","print(\"Isolation Forest predictions ready for \\(predictions.count) observations.\")"]}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcluster\/clusteringandoutliers"]}],"references":{"doc://SwiftCluster/documentation/SwiftCluster/HNSWVectorSearch":{"kind":"article","title":"High-Dimensional Vector Search with HNSW","url":"\/documentation\/swiftcluster\/hnswvectorsearch","type":"topic","role":"collectionGroup","abstract":[{"type":"text","text":"Scale approximate nearest neighbor (ANN) retrieval logarithmically using Hierarchical Navigable Small World graphs."}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"},"doc://SwiftCluster/documentation/SwiftCluster/VectorStoreAndRAG":{"role":"collectionGroup","kind":"article","url":"\/documentation\/swiftcluster\/vectorstoreandrag","abstract":[{"type":"text","text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate."}],"title":"In-Memory VectorStore & On-Device RAG","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"},"doc://SwiftCluster/documentation/SwiftCluster":{"title":"SwiftCluster","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster","abstract":[{"text":"PCA Dimensionality Reduction & Unsupervised Clustering.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/swiftcluster","role":"collection"},"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","title":"Principal Component Analysis (PCA)","type":"topic","url":"\/documentation\/swiftcluster\/dimensionalityreduction","abstract":[{"type":"text","text":"Reduce feature dimensionality using SVD-based PCA with automatic CPU and UMA GPU routing."}],"role":"article","kind":"article"}}}