"    \"trading stocks profit dividend inflation interest\"","]","","\/\/ Extract TF-IDF features","let vectorizer = TFIDFVectorizer()","try await vectorizer.fit(corpus)","let X = try await vectorizer.transform(corpus)","","\/\/ Train actor-based NaiveBayesClassifier","let labels: [Double] = [0.0, 0.0, 1.0, 1.0] \/\/ 0: sports, 1: finance","let nb = NaiveBayesClassifier(alpha: 1.0)","try await nb.fit(features: X, targets: labels)","","let testDoc = try await vectorizer.transform([\"goal score match\"])","let prediction = try await nb.predict(features: testDoc)","print(\"Prediction: \\(prediction.first ?? 0)\") \/\/ 0"]},{"level":3,"text":"2. Word Embeddings (Accelerated vDSP Cosine Similarity)","type":"heading","anchor":"2-Word-Embeddings-Accelerated-vDSP-Cosine-Similarity"},{"syntax":"swift","type":"codeListing","code":["let embeddings = try WordEmbeddings(fromTextFile: \"embeddings.txt\")","let similarity = embeddings.similarity(\"king\", \"queen\")","","let nearest = embeddings.topK(vector: queryVector, k: 5)"]},{"level":3,"text":"3. Fluent DataFrame Text Processing Extensions","type":"heading","anchor":"3-Fluent-DataFrame-Text-Processing-Extensions"},{"syntax":"swift","type":"codeListing","code":["import SwiftDataFrame","","var df = try DataFrame(columns: [","    TypedColumn<String>(name: \"text\", values: [\"I love SwiftSci!\", \"This error is bad.\"])","])","","\/\/ Chain NLP operations directly on DataFrames","let processedDF = try df","    .tokenizeColumn(column: \"text\", targetColumn: \"tokens\")","    .stemColumn(column: \"tokens\", targetColumn: \"stemmed\")","    .analyzeSentiment(column: \"text\", targetColumn: \"sentiment\")"]},{"level":3,"text":"4. Dense On-Device Text Embeddings (`LocalEmbeddingEngine`)","type":"heading","anchor":"4-Dense-On-Device-Text-Embeddings-LocalEmbeddingEngine"},{"syntax":"swift","type":"codeListing","code":["let engine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Generate 100% offline, unit-normalized dense embeddings for local RAG","let docVector = engine.embed(\"Apple Silicon M3 Max neural network computation\")","let batchVectors = engine.embedBatch([\"Machine Learning\", \"Data Engineering\"])"]}]}],"sections":[],"kind":"article","references":{"doc://SwiftNLP/documentation/SwiftNLP":{"title":"SwiftNLP","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"url":"\/documentation\/swiftnlp","role":"collection","kind":"symbol"},"doc://SwiftNLP/documentation/SwiftNLP/TextNormalizationAndTokenization":{"title":"Text Normalization, Tokenization & Linguistic Tagging","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","abstract":[{"text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native ","type":"text"},{"type":"codeVoice","code":"NaturalLanguage"},{"text":" framework.","type":"text"}],"url":"\/documentation\/swiftnlp\/textnormalizationandtokenization","role":"article","kind":"article"}}}