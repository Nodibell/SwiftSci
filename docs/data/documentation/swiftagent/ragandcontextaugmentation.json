{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGAndContextAugmentation"},"abstract":[{"type":"text","text":"Construct privacy-preserving Retrieval-Augmented Generation workflows on Apple Silicon."}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"variants":[{"paths":["\/documentation\/swiftagent\/ragandcontextaugmentation"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"On-Device RAG combines fast local vector retrieval with on-device language models to provide accurate, grounded answers from private local documents without cloud network dependencies."}],"type":"paragraph"},{"type":"codeListing","code":["graph LR","    Query[User Query] --> Embed[LocalEmbeddingEngine]","    Embed --> Vec[Dense Vector]","    Vec --> Search[VectorStore Top-K]","    Docs[Private Document Index] --> Search","    Search --> Chunks[Retrieved Text Snippets]","    Chunks --> Prompt[Augmented Prompt]","    Prompt --> LLM[SwiftLLM Metal Engine]","    LLM --> Answer[Grounded Answer]"],"syntax":"mermaid"},{"type":"heading","level":2,"text":"1. Complete End-to-End Pipeline Example","anchor":"1-Complete-End-to-End-Pipeline-Example"},{"type":"codeListing","code":["import SwiftAgent","import SwiftCluster","import SwiftNLP","import SwiftLLM","","\/\/ 1. Initialize local embedding engine and vector store","let embedEngine = LocalEmbeddingEngine(dimension: 128)","let vectorStore = VectorStore(metric: .cosineSimilarity)","","\/\/ 2. Ingest private knowledge base","let corpus = [","    \"SwiftSci uses Apple Accelerate vDSP for SIMD arithmetic.\",","    \"MLX provides unified memory GPU tensor computation on Mac.\",","    \"WiredMemoryManager prevents out-of-memory errors on shared RAM.\"","]","","for (id, text) in corpus.enumerated() {","    let vec = embedEngine.embed(text)","    vectorStore.add(id: \"doc_\\(id)\", vector: vec, metadata: [\"content\": text])","}","","\/\/ 3. Retrieve relevant context for user question","let userQuestion = \"How does SwiftSci accelerate vector math?\"","let queryVector = embedEngine.embed(userQuestion)","let topMatches = vectorStore.search(query: queryVector, topK: 1)","","let contextSnippet = topMatches.first?.metadata[\"content\"] ?? \"\"","","\/\/ 4. Assemble augmented prompt and query local LLM","let augmentedPrompt = \"\"\"","Context: \\(contextSnippet)","Question: \\(userQuestion)","Answer:","\"\"\""],"syntax":"swift"}],"kind":"content"}],"metadata":{"modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Building On-Device RAG Pipelines"},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Agent-Components","title":"Agent Components","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"]}],"kind":"article","references":{"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"kind":"symbol","type":"topic","title":"SwiftAgentEvaluator","abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiftAgentEvaluator"}],"navigatorTitle":[{"kind":"identifier","text":"SwiftAgentEvaluator"}],"url":"\/documentation\/swiftagent\/swiftagentevaluator"},"doc://SwiftAgent/documentation/SwiftAgent":{"url":"\/documentation\/swiftagent","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"role":"collection","title":"SwiftAgent","kind":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","type":"topic"}}}