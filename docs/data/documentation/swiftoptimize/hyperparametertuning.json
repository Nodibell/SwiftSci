r.ambiguousTaskType(uniqueValues:sampleCount:)"},"doc://SwiftOptimize/documentation/SwiftOptimize/CrossValidationFolds":{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","type":"topic","abstract":[{"type":"text","text":"Evaluate model stability and generalization performance across dataset splits using "},{"type":"codeVoice","code":"KFold"},{"type":"text","text":", "},{"type":"codeVoice","code":"StratifiedKFold"},{"type":"text","text":", and "},{"type":"codeVoice","code":"TimeSeriesSplit"},{"type":"text","text":"."}],"role":"article","url":"\/documentation\/swiftoptimize\/crossvalidationfolds","kind":"article","title":"Cross-Validation Strategies"},"doc://SwiftOptimize/documentation/SwiftOptimize/KFold":{"abstract":[{"text":"Splits a dataset into K folds for cross-validation.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/KFold","navigatorTitle":[{"text":"KFold","kind":"identifier"}],"url":"\/documentation\/swiftoptimize\/kfold","title":"KFold","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KFold","kind":"identifier"}],"kind":"symbol","type":"topic"}}}