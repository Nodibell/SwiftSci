{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}]},{"type":"heading","text":"1. Multi-lingual Word & Sentence Tokenization","level":3,"anchor":"1-Multi-lingual-Word--Sentence-Tokenization"},{"type":"codeListing","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"syntax":"swift"},{"type":"heading","anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","level":3,"text":"2. POS Tagging, Lemmatization & Entity Extraction"},{"type":"codeListing","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"syntax":"swift"},{"type":"heading","anchor":"3-Sentiment-Analysis-VADER--NLSentiment","level":3,"text":"3. Sentiment Analysis (VADER & NLSentiment)"},{"type":"codeListing","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"syntax":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Text Normalization, Tokenization & Linguistic Tagging","modules":[{"name":"SwiftNLP"}],"role":"article"},"abstract":[{"text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native ","type":"text"},{"code":"NaturalLanguage","type":"codeVoice"},{"text":" framework.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"kind":"article","sections":[],"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"generated":true,"anchor":"Guides--Tutorials"}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"url":"\/documentation\/swiftnlp\/vectorizationandembeddings","title":"Text Feature Vectorization, Embeddings & Naive Bayes Classification","abstract":[{"type":"text","text":"Convert text corpora into numerical feature matrices using "},{"type":"codeVoice","code":"CountVectorizer"},{"type":"text","text":", "},{"type":"codeVoice","code":"HashingVectorizer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"TFIDFVectorizer"},{"type":"text","text":", query "},{"type":"codeVoice","code":"WordEmbeddings"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppleNLEmbedding"},{"type":"text","text":", and train Naive Bayes classifiers with "},{"type":"codeVoice","code":"TextPipeline"},{"type":"text","text":"."}],"type":"topic","kind":"article","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","role":"article"},"doc://SwiftNLP/documentation/SwiftNLP":{"role":"collection","url":"\/documentation\/swiftnlp","kind":"symbol","title":"SwiftNLP","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","type":"topic"}}}