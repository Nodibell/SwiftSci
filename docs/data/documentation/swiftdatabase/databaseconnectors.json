{"metadata":{"role":"article","modules":[{"name":"SwiftDatabase"}],"roleHeading":"Article","title":"Relational Database Drivers & Zero-Copy SQL Ingestion"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/databaseconnectors"]}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftDatabase","type":"codeVoice"},{"text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 ","type":"text"},{"code":"public actor","type":"codeVoice"},{"text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"🔒 Driver Architecture & Concurrency Model","anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model"},{"type":"codeListing","code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"],"syntax":null},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Actor Isolation:","type":"text"}],"type":"strong"},{"text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Streaming ","type":"text"},{"type":"codeVoice","code":"recv"},{"text":" Buffer:","type":"text"}],"type":"strong"},{"text":" Network drivers use a 64KB receive buffer reading continuously until ","type":"text"},{"code":"ReadyForQuery ('Z')","type":"codeVoice"},{"text":" is received.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Authentication:","type":"text"}],"type":"strong"},{"text":" Built-in support for Cleartext and MD5 password authentication via ","type":"text"},{"code":"CommonCrypto","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"1. Querying SQLite Databases & C-Pointer Lifecycle Safety","anchor":"1-Querying-SQLite-Databases--C-Pointer-Lifecycle-Safety"},{"type":"paragraph","inlineContent":[{"code":"SQLiteConnection","type":"codeVoice"},{"text":" executes SQL statements through native ","type":"text"},{"code":"sqlite3_prepare_v2","type":"codeVoice"},{"text":" and directly streams result rows into columnar ","type":"text"},{"code":"TypedColumn","type":"codeVoice"},{"text":" buffers with full C-pointer lifecycle safety:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Statement Finalization:","type":"text"}],"type":"strong"},{"text":" All prepared statements are guaranteed to be finalized via ","type":"text"},{"code":"defer { if let stmt { sqlite3_finalize(stmt) } }","type":"codeVoice"},{"text":", preventing statement pointer leaks during both normal termination and thrown query errors.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Resource Cleanup:","type":"text"}],"type":"strong"},{"text":" In-memory or file-backed database handles are automatically closed via ","type":"text"},{"code":"sqlite3_close_v2","type":"codeVoice"},{"text":" upon deallocation. Callers may also invoke ","type":"text"},{"code":"await sqlite.close()","type":"codeVoice"},{"text":" to immediately release operating system locks and memory.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = SQLiteConnection(databasePath: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)","","\/\/ 3. Explicitly release SQLite database handle when done","await sqlite.close()"],"syntax":"swift"},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol"},{"type":"paragraph","inlineContent":[{"text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries (","type":"text"},{"code":"libpq","type":"codeVoice"},{"text":"):","type":"text"}]},{"type":"codeListing","code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    user: \"postgres\",","    password: \"secure_password\",","    sslMode: .disable",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"],"syntax":"swift"},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"3. High-Throughput Bulk Writeback (`toSQL`)","anchor":"3-High-Throughput-Bulk-Writeback-toSQL"},{"type":"paragraph","inlineContent":[{"text":"Bulk export in-memory ","type":"text"},{"code":"DataFrame","type":"codeVoice"},{"text":" objects back into database tables with configurable append, replace, or fail-if-exists modes:","type":"text"}]},{"type":"codeListing","code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append, .replace, or .failIfExists","    batchSize: 500",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"],"syntax":"swift"}],"kind":"content"}],"kind":"article","abstract":[{"type":"text","text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" under Swift 6 Actor Concurrency."}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions."}],"title":"Database Type System & Value Representation","url":"\/documentation\/swiftdatabase\/typesystem","kind":"article","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"},"doc://SwiftDatabase/documentation/SwiftDatabase/SecurityAndPerformance":{"kind":"article","url":"\/documentatio