{"hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"anchor":"Automated-Time-Series","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMACriterion"],"title":"Automated Time Series"}],"abstract":[{"type":"text","text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency."}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Manually diagnosing autocorrelation functions (ACF) and partial autocorrelation functions (PACF) to select ARIMA orders is time-consuming and error-prone. Standard automated packages like R’s "},{"code":"forecast::auto.arima","type":"codeVoice"},{"type":"text","text":" or Python’s "},{"code":"pmdarima","type":"codeVoice"},{"type":"text","text":" search across candidate orders sequentially."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AutoARIMA"},{"type":"text","text":" evaluates the entire hyperparameter lattice simultaneously across all CPU cores on Apple Silicon using structured Swift Concurrency ("},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"type":"text","text":")."}]},{"anchor":"Grid-Search-Architecture","type":"heading","level":2,"text":"Grid Search Architecture"},{"type":"codeListing","code":["           Observed Time Series [y_1, y_2, ..., y_N]","                               │","       ┌───────────────────────┼───────────────────────┐","       ▼                       ▼                       ▼","ARIMA(1, 1, 0)          ARIMA(2, 1, 1)          ARIMA(0, 1, 2)","Task 1                  Task 2                  Task 3","   │                       │                       │","   ├─ Hannan-Rissanen      ├─ Hannan-Rissanen      ├─ Hannan-Rissanen","   └─ Compute AIC\/BIC      └─ Compute AIC\/BIC      └─ Compute AIC\/BIC","       │                       │                       │","       └───────────────────────┼───────────────────────┘","                               ▼","                withThrowingTaskGroup Collector","                               │","                               ▼","                 Sorted Leaderboard & Best Model"],"syntax":null},{"anchor":"Information-Criteria","type":"heading","level":3,"text":"Information Criteria"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"AIC (Akaike Information Criterion)"}],"type":"strong"},{"type":"text","text":": Penalizes model complexity while rewarding likelihood:"},{"type":"text","text":" "},{"type":"text","text":"$$\\text{AIC} = 2k - 2\\ln(L)$$"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"BIC (Bayesian Information Criterion)","type":"text"}],"type":"strong"},{"type":"text","text":": Imposes a stronger penalty proportional to sample size:"},{"type":"text","text":" "},{"type":"text","text":"$$\\text{BIC} = k\\ln(N) - 2\\ln(L)$$"}]}]}],"type":"unorderedList"},{"text":"Example Usage","level":2,"type":"heading","anchor":"Example-Usage"},{"type":"codeListing","syntax":"swift","code":["import SwiftForecast","","\/\/ 1. Initialize AutoARIMA with bounded search ranges","let autoArima = AutoARIMA(","    maxP: 3,","    maxD: 2,","    maxQ: 3,","    criterion: .aic",")","","\/\/ 2. Concurrently fit candidates across all cores","let result = try await autoArima.fit(series: historicalPrices)","print(\"Optimal Order: \\(autoArima.bestOrder!) with AIC: \\(autoArima.bestScore!)\")","","\/\/ 3. Generate multi-step forecasts","let forecast = try await autoArima.forecast(horizon: 12)","print(\"Forecasted points: \\(forecast.forecast.predictions)\")"]},{"text":"Stability & Convergence Guarantees","level":2,"type":"heading","anchor":"Stability--Convergence-Guarantees"},{"text":"Zero-Variance Degenerate Inputs","level":3,"type":"heading","anchor":"Zero-Variance-Degenerate-Inputs"},{"inlineContent":[{"text":"If an input series is constant or exhibits zero numerical variance ($\\text{var} < 10^{-12}$), standard likelihood optimization can diverge or enter infinite loops. ","type":"text"},{"code":"AutoARIMA","type":"codeVoice"},{"text":" detects zero variance upfront, immediately fitting an exact ARIMA(0, 0, 0) constant model:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Avoids matrix singularities in the Hannan-Rissanen and Yule-Walker algorithms."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Guarantees instant return without stalling the task group."}]}]}],"type":"unorderedList"},{"text":"Fixed Iteration Bound","type":"heading","level":3,"anchor":"Fixed-Iteration-Bound"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All internal parameter search loops are strictly bounded by a "},{"code":"maxIterations = 500","type":"codeVoice"},{"type":"text","text":" ceiling, ensuring that optimization cannot exceed the configured iteration bound in deterministic time across parallel worker threads."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftforecast\/autoarimaparallel"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","interfaceLanguage":"swift"},"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftForecast"}],"title":"Concurrent Order Selection with AutoARIMA"},"seeAlsoSections":[{"anchor":"Guides--Tutorials","generated":true,"identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"],"title":"Guides & Tutorials"}],"sections":[],"references":{"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMA":{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoARIMA"}],"url":"\/documentation\/swiftforecast\/autoarima","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AutoARIMA"}],"abstract":[{"text":"Automated hyperparameter grid search for ARIMA and SARIMA time-series models.","type":"text"}],"kind":"symbol","title":"AutoARIMA"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAOrder":{"title":"AutoARIMAOrder","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoARIMAOrder","kind":"identifier"}],"url":"\/documentation\/swiftforecast\/autoarimaorder","type":"topic","navigatorTitle":[{"text":"AutoARIMAOrder","kind":"identifier"}],"abstract":[{"text":"A structure identifying the selected ARIMA \/ SARIMA order.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder"},"doc://SwiftForecast/documentation/SwiftForecast/ArimaAndSarima":{"type":"topic","title":"ARIMA & SARIMA Time Series Models","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","abstract":[{"text":"Forecast univariate time series using Autoregressive Integrated Moving Average (ARIMA) and Seasonal ARIMA (SARIMA).","type":"text"}],"role":"article","url":"\/documentation\/swiftforecast\/arimaandsarima","kind":"article"},"doc://SwiftForecast/documentation/SwiftForecast/SmoothingAndDecomposition":{"role":"article","title":"Time Series Forecasting, Smoothing & Kalman Filtering","type":"topic","abstract":[{"type":"text","text":"Model trends, seasonality, volatility, and dynamic state transitions using "},{"code":"ExponentialSmoothing","type":"codeVoice"},{"type":"text","text":", "},{"code":"NelderMead","type":"codeVoice"},{"type":"text","text":", "},{"code":"KalmanFilter","type":"codeVoice"},{"type":"text","text":", "},{"code":"GARCHModel","type":"codeVoice"},{"type":"text","text":", and "},{"code":"TimeSeriesDecomposition","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiftforecast\/smoothinganddecomposition","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","kind":"article"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMACriterion":{"abstract":[{"type":"text","text":"Information criterion utilized for model selection in "},{"code":"AutoARIMA","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/swiftforecast\/autoarimacriterion","type":"topic","role":"symbol","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMACriterion","navigatorTitle":[{"kind":"identifier","text":"AutoARIMACriterion"}],"title":"AutoARIMACriterion","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoARIMACriterion"}]},"doc://SwiftForecast/documentation/SwiftForecast":{"title":"SwiftForecast","role":"collection","url":"\/documentation\/swiftforecast","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast","abstract":[{"type":"text","text":"Time Series & Volatility Forecasting Models."}]},"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"kind":"symbol","abstract":[{"text":"Koopman Operator time-series forecasting and dynamical system modeling actor.","type":"text"},{"text":" ","type":"text"},{"text":"Uses Extended Dynamic Mode Decomposition (EDMD) to approximate non-linear dynamics","type":"text"},{"text":" ","type":"text"},{"text":"via linear operators in lifted observable feature spaces.","type":"text"}],"navigatorTitle":[{"text":"KoopmanOperator","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KoopmanOperator","kind":"identifier"}],"type":"topic","url":"\/documentation\/swiftforecast\/koopmanoperator","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator","role":"symbol","title":"KoopmanOperator"}}}