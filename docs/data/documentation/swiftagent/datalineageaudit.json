{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"kind":"article","abstract":[{"text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents.","type":"text"}],"metadata":{"modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","title":"Data Lineage & Transformation Audit Trails","role":"collectionGroup"},"topicSections":[{"title":"Audit Types","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Audit-Types"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/datalineageaudit"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation."}]},{"type":"paragraph","inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"type":"text","text":" automatically generates an immutable audit trail of "},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","type":"reference","isActive":true},{"type":"text","text":" entries for each command evaluated."}]},{"text":"LineageRecord Structure","type":"heading","level":2,"anchor":"LineageRecord-Structure"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","type":"reference","isActive":true},{"type":"text","text":" contains:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stepIndex"},{"type":"text","text":": Sequential index of the step within the agent trajectory."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"operation"},{"type":"text","text":": The normalized DSL command executed (e.g., "},{"type":"codeVoice","code":"filter(age)"},{"type":"text","text":", "},{"type":"codeVoice","code":"groupBy(category,mean)"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"inputRows"},{"type":"text","text":": Dataset row count immediately prior to transformation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"outputRows"},{"type":"text","text":": Dataset row count produced by the transformation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"},{"type":"text","text":": The exact timestamp of execution."}]}]}]},{"text":"Example: Accessing Audit Trails","type":"heading","level":2,"anchor":"Example-Accessing-Audit-Trails"},{"code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"url":"\/documentation\/swiftagent","abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"role":"collection","title":"SwiftAgent","kind":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","type":"topic"},"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"abstract":[{"type":"text","text":"Represents an immutable audit trail entry recording a discrete data transformation step."}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","title":"LineageRecord","navigatorTitle":[{"kind":"identifier","text":"LineageRecord"}],"url":"\/documentation\/swiftagent\/lineagerecord","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LineageRecord"}],"kind":"symbol","role":"symbol"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"kind":"symbol","type":"topic","title":"SwiftAgentEvaluator","abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiftAgentEvaluator"}],"navigatorTitle":[{"kind":"identifier","text":"SwiftAgentEvaluator"}],"url":"\/documentation\/swiftagent\/swiftagentevaluator"}}}