{"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability","interfaceLanguage":"swift"},"metadata":{"title":"Model Interpretability & XAI Guide","role":"article","modules":[{"name":"SwiftExplain"}],"roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Explainable Artificial Intelligence (XAI) bridges the gap between predictive accuracy and decision transparency. ","type":"text"},{"code":"SwiftExplain","type":"codeVoice"},{"text":" provides exact Shapley mathematical decomposition for tree-based models, local linear surrogate modeling with LIME, and model-agnostic permutation metrics.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","anchor":"%F0%9F%93%8A-Explainability-Methods-Comparison","level":2,"text":"📊 Explainability Methods Comparison"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Supported Models","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Algorithmic Complexity","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Scope"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Recommendation"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"TreeSHAP"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Decision Trees, Random Forests, GBDT","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"O(T · L · D²)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local & Global"}]}],[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Recommended for all tree models.","type":"text"}]},{"type":"text","text":" Exact polynomial Shapley computation directly on flat nodes without sampling noise."}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"KernelSHAP"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Any black-box model (MLP, SVM, Ensembles)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"O(S · D²)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Local","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Universal Shapley attribution using weighted coalition sampling."}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"LIME"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any black-box model (MLP, Vision, NLP)"}]}],[{"inlineContent":[{"type":"codeVoice","code":"O(S · D)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Local"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Fast local surrogate."}],"type":"strong"},{"type":"text","text":" Fits an interpretable weighted linear model around perturbations."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"PermutationImportance","type":"codeVoice"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Any model"}],"type":"paragraph"}],[{"inlineContent":[{"code":"O(D · N)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Global"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fast global feature ranking by measuring validation loss degradation upon feature column shuffling."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PartialDependencePlot"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Any model"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"O(G · N)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Global"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Visualizes marginal effect of 1 or 2 features across an evaluation grid."}],"type":"paragraph"}]]],"header":"row","alignments":["left","left","left","left","left"]},{"type":"thematicBreak"},{"type":"heading","anchor":"1-Exact-TreeSHAP-for-Tree-Ensembles","level":2,"text":"1. Exact TreeSHAP for Tree Ensembles"},{"type":"paragraph","inlineContent":[{"code":"TreeSHAP","type":"codeVoice"},{"text":" traverses tree branches in polynomial time, calculating exact Shapley values without random coalition sampling:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftML","import SwiftExplain","","\/\/ 1. Train a Random Forest Classifier","let X = [[1.0, 2.0], [2.0, 1.0], [5.0, 4.0], [6.0, 5.0]]","let y = [0, 0, 1, 1]","","let forest = try RandomForestClassifier(nTrees: 10, maxDepth: 4)","try await forest.fit(features: X, labels: y)","","\/\/ 2. Explain prediction on a target instance","let treeSHAP = TreeSHAP()","let instance = [5.5, 4.2]","","let shapValues = try await treeSHAP.explain(model: forest, instance: instance)","","print(\"=== TreeSHAP Feature Attributions ===\")","for (featureIdx, attribution) in shapValues.enumerated() {","    print(\"Feature \\(featureIdx): Contribution = \\(String(format: \"%+.4f\", attribution))\")","}"]},{"type":"thematicBreak"},{"type":"heading","anchor":"2-Local-Interpretable-Model-agnostic-Explanations-LIME","level":2,"text":"2. Local Interpretable Model-agnostic Explanations (`LIME`)"},{"type":"paragraph","inlineContent":[{"code":"LIMEExplainer","type":"codeVoice"},{"text":" perturbs the neighborhood of a target sample using Box-Muller Gaussian noise, weights samples by an exponential distance kernel, and fits a weighted Ridge regression surrogate model:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","import SwiftML","","\/\/ Black-box model closure","let modelClosure: @Sendable ([Double]) async -> Double = { x in","    \/\/ Non-linear complex interaction","    return 3.0 * x[0] + sin(x[1] * 2.0) - 1.5 * x[2] * x[2] + 4.0","}","","let instance = [1.5, 0.8, -0.4]","","let lime = LIMEExplainer(kernelWidth: 0.75, regularization: 0.1)","let explanation = await lime.explain(","    model: modelClosure,","    instance: instance,","    numSamples: 500",")","","print(\"=== LIME Local Surrogate Explanation ===\")","print(\"Local Prediction: \\(String(format: \"%.4f\", explanation.prediction))\")","print(\"Surrogate Intercept: \\(String(format: \"%.4f\", explanation.intercept))\")","print(\"Local Goodness-of-Fit (R²): \\(String(format: \"%.2f%%\", explanation.localR2 * 100))\")","","for (d, weight) in explanation.featureWeights.enumerated() {","    print(\"Feature [\\(d)] Local Slope: \\(String(format: \"%+.4f\", weight))\")","}"]},{"type":"thematicBreak"},{"type":"heading","anchor":"3-Global-Permutation-Feature-Importance","level":2,"text":"3. Global Permutation Feature Importance"},{"type":"paragraph","inlineContent":[{"text":"Measure global model dependence by quantifying score drop when a single feature column is randomly permuted:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","","let perm = PermutationImportance()","let importances = try await perm.computeImportance(","    features: X,","    targets: y.map(Double.init)",") { matrix in","    try await forest.predict(features: matrix).map(Double.init)","}","","print(\"=== Global Feature Importance Ranking ===\")","for (feat, score) in importances.sorted(by: { $0.value > $1.value }) {","    print(\"\\(feat): Importance Score = \\(String(format: \"%.4f\", score))\")","}"]}]}],"variants":[{"paths":["\/documentation\/swiftexplain\/modelinterpretability"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"kind":"article","sections":[],"abstract":[{"type":"text","text":"Understand black-box machine learning predictions using "},{"type":"codeVoice","code":"TreeSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"KernelSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"LIMEExplainer"},{"type":"text","text":", "},{"type":"codeVoice","code":"PermutationImportance"},{"type":"text","text":", and "},{"type":"codeVoice","code":"PartialDependencePlot"},{"type":"text","text":"."}],"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions"],"generated":true,"anchor":"Guides--Tutorials"}],"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"title":"SwiftExplain","kind":"symbol","url":"\/documentation\/swiftexplain","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"type":"topic","role":"collection"},"doc://SwiftExplain/documentation/SwiftExplain/ShapleyAttributions":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions","title":"SHAP Feature Attributions","type":"topic","url":"\/documentation\/swiftexplain\/shapleyattributions","kind":"article","abstract":[{"text":"Compute exact and approximate Shapley feature importance scores using parallel KernelSHAP and tree-accelerated TreeSHAP.","type":"text"}],"role":"article"}}}