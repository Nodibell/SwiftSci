{"metadata":{"title":"Hardware Routing & Unified Memory Governance","role":"collectionGroup","modules":[{"name":"SwiftPreprocessing"}],"roleHeading":"API Collection"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouterAndMemory"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Apple Silicon features a ","type":"text"},{"type":"strong","inlineContent":[{"text":"Unified Memory Architecture (UMA)","type":"text"}]},{"text":" where the CPU, GPU, and Apple Neural Engine (ANE) share a single high-bandwidth memory pool. ","type":"text"},{"type":"codeVoice","code":"SwiftPreprocessing"},{"text":" provides intelligent hardware routing and memory reservation primitives to prevent GPU saturation and avoid data copying.","type":"text"}]},{"type":"heading","text":"1. The Hardware Router","anchor":"1-The-Hardware-Router","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"HardwareRouter"},{"text":" assesses tensor dimensions and operation complexity to select the optimal computing engine:","type":"text"}]},{"type":"codeListing","code":["graph TD","    Op[Compute Operation] --> Router{HardwareRouter}","    Router -->|Small \/ Vector < 50k| CPU[Accelerate \/ AMX \/ NEON]","    Router -->|Large Matrix \/ Autodiff| GPU[MLX Metal GPU]","    Router -->|Static Inference| ANE[Core ML Engine]"],"syntax":"mermaid"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Small Vectors ("},{"type":"codeVoice","code":"N < 50,000"},{"type":"text","text":")"}],"type":"strong"},{"text":": Routed to CPU Accelerate (vDSP\/BLAS\/LAPACK) to eliminate GPU kernel dispatch latency.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"t