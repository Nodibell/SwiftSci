{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiftsci.local/benchmarks/profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "warmups": {
      "type": "integer",
      "minimum": 0
    },
    "samples": {
      "type": "integer",
      "minimum": 1
    },
    "batches": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dataset",
          "workload"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "dataset": {
            "type": "string"
          },
          "workload": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "warmups",
    "samples",
    "batches",
    "timeout_seconds",
    "cases"
  ]
}
