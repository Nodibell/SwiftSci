{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Architecture-Overview","text":"Architecture Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"text":" implements the modern Llama-3 \/ Mistral autoregressive causal decoder architecture natively in pure Swift and MLX:","type":"text"}]},{"code":["                          ┌────────────────────────┐","                          │    Input Token IDs     │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │   Token Embeddings     │","                          └───────────┬────────────┘","                                      ▼","                      ┌────────────────────────────────┐","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │ Multi-Head Attention + RoPE│ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │      SwiGLU FFN (SiLU)     │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │ └─────────────┬──────────────┘ │ x N Layers","                      └───────────────┼────────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │     Final RMSNorm      │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │  LM Head (Logits)      │","                          └────────────────────────┘"],"type":"codeListing","syntax":null},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"1-Core-Architectural-Components","text":"1. Core Architectural Components"},{"level":3,"type":"heading","anchor":"RoPE-Rotary-Position-Embedding","text":"RoPE (Rotary Position Embedding)"},{"type":"paragraph","inlineContent":[{"text":"Applies 2D rotation to query and key vectors based on absolute position index ","type":"text"},{"code":"m","type":"codeVoice"},{"text":", preserving relative token distance properties without learned position embeddings.","type":"text"}]},{"level":3,"type":"heading","anchor":"SwiGLU-Feed-Forward-Network","text":"SwiGLU Feed-Forward Network"},{"type":"paragraph","inlineContent":[{"text":"Replaces legacy ReLU\/GELU activations with Swish-Gated Linear Units (Llama-style):","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiGLU(x) = (SiLU(x · W_gate) ⊙ (x · W_up)) · W_down"}],"type":"paragraph"}],"type":"aside","name":"Note"},{"level":3,"type":"heading","anchor":"Paged-KV-Cache","text":"Paged KV-Cache"},{"type":"paragraph","inlineContent":[{"text":"Manages attention Key-Value projection states in fixed-size contiguous memory pages (vLLM architecture), eliminating RAM fragmentation during dynamic multi-turn autoregressive decoding.","type":"text"}]},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"2-Parsing-Weight-Formats-SafeTensors--GGUF","text":"2. Parsing Weight Formats (SafeTensors & GGUF)"},{"type":"paragraph","inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"text":" includes strict parsers for both HuggingFace ","type":"text"},{"code":".safetensors","type":"codeVoice"},{"text":" headers and ","type":"text"},{"code":"GGUF","type":"codeVoice"},{"text":" quantized binary models:","type":"text"}]},{"code":["import Foundation","import SwiftLLM","","\/\/ 1. Parse SafeTensors weight metadata","let safeTensorsURL = URL(fileURLWithPath: \"model.safetensors\")","let (tensors, metadata) = try SafeTensorsParser.parse(fileURL: safeTensorsURL)","","print(\"Found \\(tensors.count) tensor layers in SafeTensors archive.\")","for (tensorName, info) in tensors.prefix(5) {","    print(\"Layer '\\(tensorName)': dtype=\\(info.dtype), shape=\\(info.shape)\")","}","","\/\/ 2. Parse GGUF Quantized Binary Archive","let ggufURL = URL(fileURLWithPath: \"llama-3-8b.Q4_K_M.gguf\")","let ggufModel = try GGUFParser.parse(fileURL: ggufURL)","print(\"Loaded GGUF Model with \\(ggufModel.tensors.count) quantized tensors.\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"3-End-to-End-Decoder-Configuration--Inference","text":"3. End-to-End Decoder Configuration & Inference"},{"type":"paragraph","inlineContent":[{"text":"Construct an N-layer ","type":"text"},{"code":"TransformerDecoder","type":"codeVoice"},{"text":" using standard presets (","type":"text"},{"code":"LLMConfig.llama3_8B","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"LLMConfig.custom","type":"codeVoice"},{"text":") and generate tokens:","type":"text"}]},{"code":["import SwiftLLM","","\/\/ 1. Initialize TransformerDecoder with Llama-3-8B configuration","let config = LLMConfig.llama3_8B","let decoder = TransformerDecoder(config: config)","","\/\/ 2. Load model weights into memory","let weightsDictionary: [String: [Double]] = [:] \/\/ Populated from SafeTensors\/GGUF","try decoder.loadWeights(weightsDictionary)","","\/\/ 3. Configure sampling strategy","let sampler = TopKSampler(temperature: 0.7, topK: 40, topP: 0.9)","","\/\/ 4. Autoregressive token generation loop","let promptTokens: [Int] = [128000, 791, 7453, 374] \/\/ Tokenized input","var generatedTokens = promptTokens","let maxNewTokens = 50","","print(\"Generating output tokens...\")","for _ in 0..<maxNewTokens {","    let logits = try decoder.forward(tokens: generatedTokens)","    let nextToken = sampler.sample(logits: logits)","    ","    generatedTokens.append(nextToken)","    if nextToken == 128001 { \/\/ End of Sequence token (EOS)","        break","    }","}","","print(\"Generated sequence length: \\(generatedTokens.count) tokens.\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"4-Structured-JSON-Grammar-Decoding","text":"4. Structured JSON Grammar Decoding"},{"type":"paragraph","inlineContent":[{"text":"Enforce strict output conformance to Swift ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" schemas using ","type":"text"},{"code":"JSONGrammarDecoder","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["import SwiftLLM","","struct SentimentResponse: Codable {","    let label: String","    let confidence: Double","}","","let grammarDecoder = JSONGrammarDecoder(schema: SentimentResponse.self)","let constrainedTokens = try grammarDecoder.constrainSampling(logits: logits, validTokens: vocabulary)"],"type":"codeListing","syntax":"swift"}]}],"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"anchor":"Guides--Tutorials"}],"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/swiftllm\/transformerdecoderarchitecture"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"metadata":{"modules":[{"name":"SwiftLLM"}],"roleHeading":"Article","title":"Transformer Architecture & LLM Inference Guide","role":"article"},"abstract":[{"type":"text","text":"High-throughput, on-device causal language model execution on Apple Silicon Unified Memory Architecture using "},{"code":"TransformerDecoder","type":"codeVoice"},{"type":"text","text":", "},{"code":"PagedKVCache","type":"codeVoice"},{"type":"text","text":", "},{"code":"GGUFParser","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SafeTensorsParser","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://SwiftLLM/documentation/SwiftLLM":{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","url":"\/documentation\/swiftllm","kind":"symbol","type":"topic","role":"collection","abstract":[{"text":"Local Causal Transformer Decoder & Weight Parsers.","type":"text"}],"title":"SwiftLLM"},"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","type":"topic","title":"GGUF\/SafeTensors Parsing & Sampling","role":"article","kind":"article","url":"\/documentation\/swiftllm\/weightparsingandsampling","abstract":[{"text":"Parse GGUF and SafeTensors model weights zero-copy and sample tokens using Temperature and Top-K sampling.","type":"text"}]},"doc://SwiftLLM/documentation/SwiftLLM/MetalShadersQuantization":{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization","type":"topic","title":"Native Metal MSL Shaders for Quantized LLMs","role":"collectionGroup","url":"\/documentation\/swiftllm\/metalshadersquantization","kind":"article","abstract":[{"text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU.","type":"text"}]}}}