{"abstract":[{"text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftagent\/datalineageaudit"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Data Lineage & Transformation Audit Trails"},"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Audit-Types","title":"Audit Types"}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"SwiftAgentEvaluator","type":"codeVoice"},{"type":"text","text":" automatically generates an immutable audit trail of "},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","type":"reference","isActive":true},{"type":"text","text":" entries for each command evaluated."}]},{"anchor":"LineageRecord-Structure","type":"heading","level":2,"text":"LineageRecord Structure"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord"},{"text":" contains:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"stepIndex","type":"codeVoice"},{"type":"text","text":": Sequential index of the step within the agent trajectory."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"operation"},{"type":"text","text":": The normalized DSL command executed (e.g., "},{"type":"codeVoice","code":"filter(age)"},{"type":"text","text":", "},{"type":"codeVoice","code":"groupBy(category,mean)"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"inputRows","type":"codeVoice"},{"type":"text","text":": Dataset row count immediately prior to transformation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"outputRows","type":"codeVoice"},{"text":": Dataset row count produced by the transformation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"},{"text":": The exact timestamp of execution.","type":"text"}]}]}]},{"type":"heading","anchor":"Example-Accessing-Audit-Trails","level":2,"text":"Example: Accessing Audit Trails"},{"code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"type":"codeListing","syntax":"swift"}]}],"sections":[],"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"type":"topic","role":"collection","title":"SwiftAgent","kind":"symbol","url":"\/documentation\/swiftagent","abstract":[{"text":"Agentic REPL Execution Sandbox & RAG Summary Engine.","type":"text"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent"},"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LineageRecord"}],"title":"LineageRecord","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","url":"\/documentation\/swiftagent\/lineagerecord","navigatorTitle":[{"kind":"identifier","text":"LineageRecord"}],"abstract":[{"text":"Represents an immutable audit trail entry recording a discrete data transformation step.","type":"text"}]},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"kind":"symbol","abstract":[{"text":"Agentic Swift Execution Sandbox Evaluator.","type":"text"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","url":"\/documentation\/swiftagent\/swiftagentevaluator","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"text":"SwiftAgentEvaluator","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SwiftAgentEvaluator"}],"title":"SwiftAgentEvaluator","type":"topic"}}}