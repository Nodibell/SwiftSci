 "},{"code":"TextPipeline","type":"codeVoice"},{"type":"text","text":"."}],"title":"Text Feature Vectorization, Embeddings & Naive Bayes Classification","role":"article"},"doc://SwiftNLP/documentation/SwiftNLP":{"role":"collection","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"url":"\/documentation\/swiftnlp","type":"topic","title":"SwiftNLP","kind":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP"}}}