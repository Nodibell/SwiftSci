{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftVision"},{"text":" implements the full ","type":"text"},{"inlineContent":[{"text":"YOLOv8","type":"text"}],"type":"strong"},{"text":" deep learning architecture in native Swift and MLX. The pipeline combines Apple Accelerate ","type":"text"},{"type":"codeVoice","code":"vImageScale_PlanarF"},{"text":" for bilinear letterbox scaling, deep CSPDarknet backbone evaluation, decoupled PANet feature pyramid routing, and anchorless box decoding with Non-Maximum Suppression (NMS).","type":"text"}]},{"type":"codeListing","code":["Input Image (RGB \/ File \/ CVPixelBuffer)","               │","               ▼","┌────────────────────────────────────────┐","│ Apple Accelerate vImage Letterbox      │ ───► Resizes to 640x640 with (114, 114, 114) padding","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOBackbone (CSPDarknet + SPPF)       │ ───► P3, P4, P5 multi-scale feature maps","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLONeck (PANet Feature Pyramid)       │ ───► Top-down & bottom-up cross-scale fusion","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ YOLOHead (Decoupled Class & Box DFL)   │ ───► 8,400 raw candidate anchor predictions","└──────────────────┬─────────────────────┘","                   ▼","┌────────────────────────────────────────┐","│ Vectorized Non-Maximum Suppression     │ ───► Final BoundingBoxes with class IDs & confidences","└────────────────────────────────────────┘"],"syntax":null},{"type":"thematicBreak"},{"anchor":"1-Loading-Weights-and-Executing-Detection","level":2,"type":"heading","text":"1. Loading Weights and Executing Detection"},{"type":"paragraph","inlineContent":[{"text":"Load pre-trained ","type":"text"},{"code":".onnx","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".safetensors","type":"codeVoice"},{"text":" model weights and detect objects:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftVision","","\/\/ 1. Initialize YOLOv8 detector from model weights file","let modelURL = URL(fileURLWithPath: \"yolov8n.onnx\")","let detector = try YOLOv8Detector(weightsURL: modelURL)","","\/\/ 2. Perform object detection on an image file","let imageURL = URL(fileURLWithPath: \"street_scene.jpg\")","let detections = try await detector.detect(","    imageURL: imageURL,","    confidenceThreshold: 0.4,","    iouThreshold: 0.45",")","","print(\"=== YOLOv8 Detection Results ===\")","for box in detections {","    let rect = box.rect","    print(\"Class: '\\(box.className)' (ID: \\(box.classId)) | Confidence: \\(String(format: \"%.2f%%\", box.confidence * 100)) | Box: [x=\\(rect.minX), y=\\(rect.minY), w=\\(rect.width), h=\\(rect.height)]\")","}"]},{"type":"thematicBreak"},{"text":"2. Hardware-Accelerated Letterbox Preprocessing (`vImage`)","type":"heading","level":2,"anchor":"2-Hardware-Accelerated-Letterbox-Preprocessing-vImage"},{"inlineContent":[{"type":"codeVoice","code":"YOLOPreprocessor"},{"type":"text","text":" uses Apple Accelerate’s "},{"type":"codeVoice","code":"vImageScale_PlanarF"},{"type":"text","text":" with "},{"type":"codeVoice","code":"kvImageHighQualityResampling"},{"type":"text","text":", performing aspect-ratio preserving downsampling directly in hardware:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftVision","","\/\/ Preprocess raw image buffer into normalized Float32 planar tensor","let inputImage = URL(fileURLWithPath: \"input_1920x1080.jpg\")","let (tensorBuffer, scaleFactor, padX, padY) = try YOLOPreprocessor.preprocess(","    imageURL: inputImage,","    targetSize: (width: 640, height: 640)",")","","print(\"Preprocessed tensor count: \\(tensorBuffer.count) Float elements.\")","print(\"Scale Factor: \\(scaleFactor), Padding: (\\(padX), \\(padY))\")"]},{"type":"thematicBreak"},{"text":"3. Training & Batching Image Datasets","anchor":"3-Training--Batching-Image-Datasets","type":"heading","level":2},{"inlineContent":[{"text":"Load and normalize computer vision datasets in compact ","type":"text"},{"code":"Float32","type":"codeVoice"},{"text":" tensors:","type":"text"}],"type":"paragraph"},{"code":["let dataset = try ImageDataset(","    directoryURL: URL(fileURLWithPath: \"coco_val2017\/\"),","    targetSize: (width: 256, height: 256),","    normalize: true",")","","print(\"Loaded \\(dataset.count) images. Memory per image: \\(dataset.data.count * 4 \/ 1024) KB.\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"type":"text","text":"Execute real-time anchor-free object detection on Apple Silicon GPU and Neural Engine using "},{"code":"YOLOv8Detector","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"YOLOPreprocessor"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ImageDataset"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/RealTimeYOLOInference"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftvision\/realtimeyoloinference"]}],"kind":"article","metadata":{"title":"Real-Time YOLOv8 Object Detection & Hardware Acceleration","modules":[{"name":"SwiftVision"}],"roleHeading":"Article","role":"article"},"sections":[],"references":{"doc://SwiftVision/documentation/SwiftVision":{"abstract":[{"type":"text","text":"Computer Vision Neural Inference, Object Detection & Image Datasets."}],"identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision","url":"\/documentation\/swiftvision","kind":"symbol","type":"topic","title":"SwiftVision","role":"collection"}}}