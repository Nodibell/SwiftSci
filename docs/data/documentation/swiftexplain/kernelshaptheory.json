{"variants":[{"paths":["\/documentation\/swiftexplain\/kernelshaptheory"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"role":"collectionGroup","title":"Game-Theoretic Interpretability with Kernel SHAP","roleHeading":"API Collection","modules":[{"name":"SwiftExplain"}]},"topicSections":[{"title":"SHAP Explainer APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"anchor":"SHAP-Explainer-APIs"}],"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}]},{"text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory.","type":"text"}]},{"level":2,"text":"1. The Four Shapley Axioms","type":"heading","anchor":"1-The-Four-Shapley-Axioms"},{"type":"paragraph","inlineContent":[{"text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Efficiency"}],"type":"strong"},{"type":"text","text":": Feature attributions sum up to the difference between model prediction $f(x)$ and expected background prediction $E[f(X)]$:"},{"type":"text","text":" "},{"type":"text","text":"$$\\sum_{i=1}^{M} \\phi_i = f(x) - E[f(X)]$$"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Symmetry"}],"type":"strong"},{"type":"text","text":": If two features contribute equally to all possible feature subsets, their attributions are equal."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Dummy (Null Player)"}],"type":"strong"},{"type":"text","text":": A feature that does not change the model prediction for any coalition receives an attribution of zero ($\\phi_i = 0$)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Additivity"}],"type":"strong"},{"type":"text","text":": For ensemble models $f = f_1 + f_2$, attributions satisfy $\\phi_i(f) = \\phi_i(f_1) + \\phi_i(f_2)$."}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"2. Explaining Predictions in SwiftSci","type":"heading","anchor":"2-Explaining-Predictions-in-SwiftSci"},{"code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"sections":[],"abstract":[{"text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model.","type":"text"}],"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"url":"\/documentation\/swiftexplain","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","title":"SwiftExplain"},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"role":"symbol","url":"\/documentation\/swiftexplain\/kernelshap","navigatorTitle":[{"text":"KernelSHAP","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KernelSHAP","kind":"identifier"}],"title":"KernelSHAP","type":"topic","abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}]}}}