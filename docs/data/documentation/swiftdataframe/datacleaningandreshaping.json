ation\", with: \"Unknown\")","","\/\/ Drop rows with any null values","let cleanDF = try df.dropNulls()"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"2. Long-to-Wide Pivoting & Wide-to-Long Melting","anchor":"2-Long-to-Wide-Pivoting--Wide-to-Long-Melting"},{"code":["\/\/ Pivot long format table to wide format","let wideDF = try df.pivot(","    index: \"station\",","    columns: \"date\",","    values: \"temperature\",","    aggregate: .mean",")","","\/\/ Melt wide format back to long format","let longDF = try wideDF.melt(","    idVariables: [\"station\"],","    valueVariables: [\"2026-01-01\", \"2026-01-02\"],","    variableColumnName: \"date\",","    valueColumnName: \"temperature\"",")"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"3. Deduplication with `DataFrame.unique`","anchor":"3-Deduplication-with-DataFrameunique"},{"code":["\/\/ Remove identical duplicate rows across all columns","let uniqueDF = df.unique"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/datacleaningandreshaping"]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/pivot(index:columns:values:aggFunc:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"pivot","kind":"identifier"},{"text":"(","kind":"text"},{"text":"index","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"columns","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"values","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"aggFunc","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"