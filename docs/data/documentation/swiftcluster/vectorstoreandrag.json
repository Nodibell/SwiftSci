{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"article","abstract":[{"type":"text","text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Vector databases are essential for modern semantic search and AI agent knowledge retrieval. ","type":"text"},{"code":"SwiftCluster","type":"codeVoice"},{"text":" provides ","type":"text"},{"code":"VectorStore","type":"codeVoice"},{"text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations (","type":"text"},{"code":"vDSP_dotprD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_svesqD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_distancesqD","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"heading","anchor":"1-Creating-a-VectorStore","level":2,"text":"1. Creating a VectorStore"},{"type":"codeListing","syntax":"swift","code":["import SwiftCluster","import SwiftNLP","","\/\/ Initialize vector store with Cosine Similarity","let store = VectorStore(metric: .cosineSimilarity)","","\/\/ Generate dense text embeddings","let engine = LocalEmbeddingEngine(dimension: 128)","","let articles = [","    (id: \"art_1\", title: \"Apple Silicon Architecture\", text: \"Unified memory and neural engine overview\"),","    (id: \"art_2\", title: \"Swift Strict Concurrency\", text: \"Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"]},{"type":"heading","anchor":"2-Top-K-Semantic-Search","level":2,"text":"2. Top-K Semantic Search"},{"type":"codeListing","syntax":"swift","code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"]},{"type":"heading","anchor":"3-Supported-Metrics","level":2,"text":"3. Supported Metrics"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".cosineSimilarity","type":"codeVoice"}],"type":"strong"},{"text":": Ideal for normalized text embeddings (returns ","type":"text"},{"code":"[-1.0, 1.0]","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".dotProduct","type":"codeVoice"}],"type":"strong"},{"text":": Direct inner product for unnormalized projections.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}],"type":"strong"},{"text":": Geometric L2 distance for spatial clustering.","type":"text"}],"type":"paragraph"}]}]}]}],"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftCluster"}],"title":"In-Memory VectorStore & On-Device RAG"},"topicSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"],"title":"Vector Store Types","anchor":"Vector-Store-Types"}],"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftcluster\/vectorstoreandrag"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"seeAlsoSections":[{"identifiers":[