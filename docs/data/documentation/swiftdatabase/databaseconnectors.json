{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","interfaceLanguage":"swift"},"metadata":{"title":"Relational Database Drivers & Zero-Copy SQL Ingestion","role":"article","modules":[{"name":"SwiftDatabase"}],"roleHeading":"Article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/databaseconnectors"]}],"abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into ","type":"text"},{"type":"codeVoice","code":"SwiftDataFrame"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 "},{"type":"codeVoice","code":"public actor"},{"type":"text","text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model","text":"🔒 Driver Architecture & Concurrency Model","level":2,"type":"heading"},{"syntax":null,"code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Actor Isolation:"}],"type":"strong"},{"type":"text","text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Streaming ","type":"text"},{"code":"recv","type":"codeVoice"},{"text":" Buffer:","type":"text"}]},{"type":"text","text":" Network drivers use a 64KB receive buffer reading continuously until "},{"type":"codeVoice","code":"ReadyForQuery ('Z')"},{"type":"text","text":" is received."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication:"}]},{"text":" Built-in support for Cleartext and MD5 password authentication via ","type":"text"},{"code":"CommonCrypto","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"level":2,"anchor":"1-Querying-SQLite-Databases","text":"1. Querying SQLite Databases","type":"heading"},{"inlineContent":[{"code":"SQLiteConnection","type":"codeVoice"},{"type":"text","text":" executes SQL statements through native "},{"type":"codeVoice","code":"sqlite3_prepare_v2"},{"type":"text","text":" and directly streams result rows into columnar "},{"type":"codeVoice","code":"TypedColumn"},{"type":"text","text":" buffers:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = try SQLiteConnection(path: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)"]},{"type":"thematicBreak"},{"text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","level":2,"type":"heading","anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries ("},{"code":"libpq","type":"codeVoice"},{"type":"text","text":"):"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = try PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    username: \"postgres\",","    password: \"secure_password\",","    useSSL: false",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"]},{"type":"thematicBreak"},{"text":"3. High-Throughput Bulk Writeback (`toSQL`)","level":2,"type":"heading","anchor":"3-High-Throughput-Bulk-Writeback-toSQL"},{"type":"paragraph","inlineContent":[{"text":"Bulk export in-memory ","type":"text"},{"type":"codeVoice","code":"DataFrame"},{"text":" objects back into database tables with configurable append or replace modes:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Write transformed DataFrame to database"