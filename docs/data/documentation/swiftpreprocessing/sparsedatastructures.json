{"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftPreprocessing"}],"role":"collectionGroup","title":"Memory-Efficient Sparse Matrix Representations"},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"],"generated":true,"anchor":"Guides--Tutorials"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. "},{"type":"codeVoice","code":"SparseMatrix"},{"type":"text","text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x."}],"type":"paragraph"},{"level":2,"text":"Storage Formats","anchor":"Storage-Formats","type":"heading"},{"level":3,"text":"Compressed Sparse Row (CSR)","anchor":"Compressed-Sparse-Row-CSR","type":"heading"},{"inlineContent":[{"type":"text","text":"Stores non-zero values row-by-row:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"values"},{"type":"text","text":": Non-zero numerical entries."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"colIndices","type":"codeVoice"},{"text":": Column indices corresponding to each entry in ","type":"text"},{"type":"codeVoice","code":"values"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"rowPointers"},{"text":": Offsets into ","type":"text"},{"type":"codeVoice","code":"values"},{"text":" marking where each row begins (length: ","type":"text"},{"type":"codeVoice","code":"rowCount + 1"},{"text":").","type":"text"}]}]}]},{"syntax":null,"code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"],"type":"codeListing"},{"level":3,"text":"Compressed Sparse Column (CSC)","anchor":"Compressed-Sparse-Column-CSC","type":"heading"},{"inlineContent":[{"type":"text","text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication."}],"type":"paragraph"},{"level":2,"text":"Apple Accelerate Sparse BLAS","anchor":"Apple-Accelerate-Sparse-BLAS","type":"heading"},{"inlineContent":[{"text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), ","type":"text"},{"code":"SparseMatrix","type":"codeVoice"},{"text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"sparse_matrix_create_double","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_insert_row_double"}]}]},{"content":[{"inlineContent":[{"code":"sparse_commit","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"sparse_matrix_vector_product_dense_double","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput.","type":"text"}]},{"anchor":"Example-Usage","type":"heading","text":"Example Usage","level":2},{"type":"codeListing","syntax":"swift","code":["import SwiftPreprocessing","","\/\/ 1. Create a sparse matrix from a dense array","let dense: [[Double]] = [","    [1.0, 0.0, 0.0],","    [0.0, 2.0, 0.0],","    [0.0, 0.0, 3.0]","]","let sparse = SparseMatrix(dense: dense, format: .csr)","print(\"Sparsity: \\(sparse.sparsity)\") \/\/ ~ 0.667","","\/\/ 2. Accelerated matrix-vector product","let x = [1.0, 2.0, 3.0]","let y = try sparse.multiply(vector: x)","print(y) \/\/ [1.0, 4.0, 9.0]","","\/\/ 3. Matrix Transpose & CSC conversion","let csc = sparse.toCSC()","let transposed = sparse.transpose()"]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","topicSections":[{"title":"Sparse Data Types","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"],"anchor":"Sparse-Data-Types"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"},"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseMatrix":{"kind":"symbol","title":"SparseMatrix","navigatorTitle":[{"kind":"identifier","text":"SparseMatrix"}],"type":"topic","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","url":"\/documentation\/swiftpreprocessing\/sparsematrix","abstract":[{"text":"Memory-efficient sparse matrix storage implementing Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SparseMatrix"}],"role":"symbol"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessin