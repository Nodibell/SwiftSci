{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"],"anchor":"Embedding-APIs","title":"Embedding APIs"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"text":"Modern Retrieval-Augmented Generation (RAG) and semantic search systems require dense vector representations of text. Traditional approaches depend on remote APIs (e.g. OpenAI) or large multi-gigabyte models that exhaust memory. ","type":"text"},{"code":"SwiftNLP","type":"codeVoice"},{"text":" introduces ","type":"text"},{"code":"LocalEmbeddingEngine","type":"codeVoice"},{"text":", a subword N-gram character hashing projection engine that produces deterministic, unit-normalized dense embeddings in sub-millisecond execution times.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"1. Algorithmic Foundation","anchor":"1-Algorithmic-Foundation","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"code":"LocalEmbeddingEngine","type":"codeVoice"},{"text":" operates through a three-stage mathematical pipeline:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Subword N-gram Hashing"}]},{"text":": Text is tokenized into word and character n-grams (sizes 3 to 6). Each n-gram is hashed into a fixed integer space using FNV-1a hash functions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dimension Projection"}]},{"text":": Hashes are projected onto a ","type":"text"},{"code":"D","type":"codeVoice"},{"text":"-dimensional vector space (e.g., ","type":"text"},{"code":"D = 128","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"D = 256","type":"codeVoice"},{"text":") with deterministic sign flips to prevent feature collision bias.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Unit L2 Normalization"}]},{"text":": The resulting dense vector is projected onto the unit hypersphere:","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"v_norm = v \/ ||v||_2 = v \/ sqrt(Σ v_i²)"}]}],"type":"aside","name":"Note","style":"note"}]}]},{"inlineContent":[{"text":"Because all embeddings have ","type":"text"},{"code":"||v||_2 = 1.0","type":"codeVoice"},{"text":", the ","type":"text"},{"inlineContent":[{"text":"Cosine Similarity","type":"text"}],"type":"strong"},{"text":" between two embeddings is equivalent to their direct ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Dot Product"}]},{"text":", allowing single-instruction vector evaluation via Apple Accelerate ","type":"text"},{"code":"vDSP_dotprD","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"CosineSimilarity(u, v) = u · v"}]}],"type":"aside","name":"Note"},{"anchor":"2-Generating-Embeddings","text":"2. Generating Embeddings","type":"heading","level":2},{"syntax":"swift","code":["import SwiftNLP","","\/\/ Initialize a 128-dimensional local embedding engine","let engine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Generate embedding for a single text snippet","let vector = engine.embed(\"Apple Silicon M3 Max neural network processing\")","print(\"Vector dimension: \\(vector.count)\") \/\/ 128","","\/\/ Batch embedding generation","let documents = [","    \"High-performance computing on macOS\",","    \"Relational database wire protocol drivers\",","    \"Deep convolutional neural networks for vision\"","]","let batchEmbeddings = engine.embedBatch(documents)"],"type":"codeListing"},{"anchor":"3-Integration-with-SwiftClusterVectorStore","text":"3. Integration with SwiftCluster.VectorStore","type":"heading","level":2},{"syntax":"swift","code":["import SwiftCluster","","let store = VectorStore(metric: .cosineSimilarity)","","for (idx, doc) in documents.enumerated() {","    let vec = engine.embed(doc)","    store.add(id: \"doc_\\(idx)\", vector: vec, metadata: [\"text\": doc])","}","","\/\/ Perform instant semantic similarity search","let query = engine.embed(\"Mac hardware acceleration\")","let topHits = store.search(query: query, topK: 1)","print(\"Top match: \\(topHits.first?.metadata[\"text\"] ?? \"\")\")"],"type":"codeListing"}],"kind":"content"}],"metadata":{"role":"collectionGroup","title":"Dense Local Text Embeddings with Accelerate","roleHeading":"API Collection","modules":[{"name":"SwiftNLP"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/denselocalembeddings"]}],"abstract":[{"type":"text","text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon."}],"kind":"article","references":{"doc://SwiftNLP/documentation/SwiftNLP":{"url":"\/documentation\/swiftnlp","title":"SwiftNLP","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","type":"topic","role":"collection","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"kind":"symbol"},"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","type":"topic","url":"\/documentation\/swiftnlp\/localembeddingengine","abstract":[{"type":"text","text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon."}],"role":"symbol","navigatorTitle":[{"text":"LocalEmbeddingEngine","kind":"identifier"}],"title":"LocalEmbeddingEngine","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LocalEmbeddingEngine","kind":"identifier"}]}}}