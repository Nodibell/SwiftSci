{"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouterAndMemory","interfaceLanguage":"swift"},"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/hardwarerouterandmemory"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"collectionGroup","title":"Hardware Routing & Unified Memory Governance","roleHeading":"API Collection","modules":[{"name":"SwiftPreprocessing"}]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Apple Silicon features a ","type":"text"},{"inlineContent":[{"text":"Unified Memory Architecture (UMA)","type":"text"}],"type":"strong"},{"text":" where the CPU, GPU, and Apple Neural Engine (ANE) share a single high-bandwidth memory pool. ","type":"text"},{"code":"SwiftPreprocessing","type":"codeVoice"},{"text":" provides intelligent hardware routing and memory reservation primitives to prevent GPU saturation and avoid data copying.","type":"text"}]},{"type":"heading","level":2,"anchor":"1-The-Hardware-Router","text":"1. The Hardware Router"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"HardwareRouter","type":"codeVoice"},{"text":" assesses tensor dimensions and operation complexity to select the optimal computing engine:","type":"text"}]},{"type":"codeListing","syntax":"mermaid","code":["graph TD","    Op[Compute Operation] --> Router{HardwareRouter}","    Router -->|Small \/ Vector < 50k| CPU[Accelerate \/ AMX \/ NEON]","    Router -->|Large Matrix \/ Autodiff| GPU[MLX Metal GPU]","    Router -->|Static Inference| ANE[Core ML Engine]"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Small Vectors ("},{"type":"codeVoice","code":"N < 50,000"},{"type":"text","text":")"}]},{"text":": Routed to CPU Accelerate (vDSP\/BLAS\/LAPACK) to eliminate GPU kernel dispatch latency.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Large Tensors & Deep Learning"}]},{"type":"text","text":": Routed to MLX Metal GPU for massive parallel throughput."}]}]}]},{"level":2,"text":"2. WiredMemoryManager & Ticket System","anchor":"2-WiredMemoryManager--Ticket-System","type":"heading"},{"inlineContent":[{"type":"text","text":"To prevent out-of-memory (OOM) conditions during concurrent analytical workloads, "},{"type":"codeVoice","code":"WiredMemoryManager"},{"text":" implements an asynchronous FIFO reservation system:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftPreprocessing","","\/\/ Acquire a GPU execution slot","let ticket = try await WiredMemoryManager.shared.reserveMemory(estimatedBytes: 64 * 1024 * 1024)","","\/\/ Execute heavy MLX operations","\/\/ ...","","\/\/ Automatically flushes GPU caches upon completion","await ticket.release()"],"type":"codeListing"}]}],"abstract":[{"type":"text","text":"Understand how SwiftSci automatically routes workloads between CPU (Accelerate\/AMX\/NEON) and Metal GPU (MLX) with strict concurrency safety."}],"topicSections":[{"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket"],"title":"Memory & Routing APIs","anchor":"Memory--Routing-APIs"}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/HardwareRouter":{"navigatorTitle":[{"text":"HardwareRouter","kind":"identifier"}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","title":"HardwareRouter","type":"topic","