{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"sections":[],"abstract":[{"type":"text","text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties."}],"type":"paragraph"},{"level":2,"anchor":"1-Arrow-Memory-Layout--Bitmaps","text":"1. Arrow Memory Layout & Bitmaps","type":"heading"},{"inlineContent":[{"text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Validity Bitmaps"}],"type":"strong"},{"type":"text","text":": Each bit represents the presence (1) or absence (0) of a value at that index."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"SIMD Null Filtering"}],"type":"strong"},{"text":": Vectorized operations skip null evaluations using SIMD bitmasks (","type":"text"},{"code":"vDSP_vcmprsD","type":"codeVoice"},{"text":"), allowing full CPU register utilization.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"2. Feather File Format (Arrow IPC)","anchor":"2-Feather-File-Format-Arrow-IPC","type":"heading"},{"inlineContent":[{"text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:","type":"text"}],"type":"paragraph"},{"code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"3. Lazy Feather Streaming","anchor":"3-Lazy-Feather-Streaming","type":"heading"},{"inlineContent":[{"type":"text","text":"For large datasets, SwiftDataFrame supports streaming chunked reads:"}],"type":"paragraph"},{"type":"codeListing","code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration"},"metadata":{"modules":[{"name":"SwiftDataFrame"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Apache Arrow & Feather Zero-Copy Integration"},"topicSections":[{"anchor":"Arrow-Classes--Readers","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"],"title":"Arrow Classes & Readers"}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"title":"FeatherReader","type":"topic","url":"\/documentation\/swiftdataframe\/featherreader","abstract":[{"text":"Reader for Feather \/ Apache Arrow IPC binary file format.","type":"text"}],"navigatorTitle":[{"text":"FeatherReader","kind":"identifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeatherReader","kind":"identifier"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}],"title":"SwiftDataFrame","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","role":"collection","url":"\/documentation\/swiftdataframe","type":"topic"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypedColumn"}],"type":"topic","abstract":[{"text":"A strongly-typed column backed by a contiguous Swift array.","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" elements represent null \/ missing values.","type":"text"}],"title":"TypedColumn","kind":"symbol","url":"\/documentation\/swiftdataframe\/typedcolumn","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn","navigatorTitle":[{"kind":"identifier","text":"TypedColumn"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"title":"FeatherWriter","url":"\/documentation\/swiftdataframe\/featherwriter","type":"topic","abstract":[{"text":"Writer for Feather \/ Apache Arrow IPC binary file format.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"FeatherWriter"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherWriter"}]}}}