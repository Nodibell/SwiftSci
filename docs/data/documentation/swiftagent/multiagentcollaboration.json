{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration"},"metadata":{"role":"collectionGroup","title":"Multi-Agent Coordination & Protocols","roleHeading":"API Collection","modules":[{"name":"SwiftAgent"}]},"abstract":[{"text":"Orchestrate teams of specialized autonomous agents over an asynchronous message bus with concurrent parallel tool calling.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgenticReplAndRAG"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"topicSections":[{"anchor":"Multi-Agent-Coordination","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentOrchestrator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessageBus","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessage","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolCall","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolResult","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SpecializedAgent"],"title":"Multi-Agent Coordination"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Complex analytical and reasoning workflows are frequently error-prone when performed by a single monolithic model. Decomposing problems into specialized roles—such as "},{"type":"strong","inlineContent":[{"type":"text","text":"Planner"}]},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"type":"text","text":"Analyst"}]},{"type":"text","text":", and "},{"type":"strong","inlineContent":[{"type":"text","text":"Critic"}]},{"type":"text","text":"—drastically improves reasoning accuracy, reduces hallucinations, and permits parallelized tool execution."}],"