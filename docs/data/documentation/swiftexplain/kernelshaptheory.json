{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/kernelshaptheory"]}],"metadata":{"roleHeading":"API Collection","title":"Game-Theoretic Interpretability with Kernel SHAP","modules":[{"name":"SwiftExplain"}],"role":"collectionGroup"},"abstract":[{"type":"text","text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model."}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"topicSections":[{"title":"SHAP Explainer APIs","anchor":"SHAP-Explainer-APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"]}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}]},{"type":"text","text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory."}]},{"type":"heading","level":2,"text":"1. The Four Shapley Axioms","anchor":"1-The-Four-Shapley-Axioms"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Efficiency"}]},{"type":"text","text":": Feature attributions sum up to the difference between model prediction "},{"type":"codeVoice","code":"f(x)"},{"text":" and expected background prediction ","type":"text"},{"code":"E[f(X)]","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Symmetry"}]},{"type":"text","text":": If two features contribute equally to all possible feature subsets, their attributions are equal."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dummy (Null Player)"}]},{"type":"text","text":": A feature that does not change the model prediction for any coalition receives an attribution of zero ("},{"code":"φ_i = 0","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Additivity"}],"type":"strong"},{"type":"text","text":": For ensemble models "},{"code":"f = f1 + f2","type":"codeVoice"},{"text":", attributions satisfy ","type":"text"},{"code":"φ_i(f) = φ_i(f1) + φ_i(f2)","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"2. Explaining Predictions in SwiftSci","anchor":"2-Explaining-Predictions-in-SwiftSci"},{"syntax":"swift","type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory"},"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"type":"topic","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","kind":"symbol","title":"SwiftExplain","role":"collection","url":"\/documentation\/swiftexplain"},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}],"abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"url":"\/documentation\/swiftexplain\/kernelshap","title":"KernelSHAP","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KernelSHAP"}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"}}}