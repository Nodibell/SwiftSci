{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy"},"abstract":[{"type":"text","text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame."}],"kind":"article","metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftDataFrame"}],"title":"High-Performance GroupBy & Vectorized Aggregations","role":"collectionGroup"},"topicSections":[{"anchor":"Grouping-APIs","title":"Grouping APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"]},{"anchor":"Exact-integer-totals","title":"Exact integer totals","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/CheckedIntegerSums"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. ","type":"text"},{"type":"codeVoice","code":"SwiftDataFrame"},{"text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory.","type":"text"}],"type":"paragraph"},{"level":2,"text":"1. Basic GroupBy Aggregation","anchor":"1-Basic-GroupBy-Aggregation","type":"heading"},{"syntax":"swift","code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"],"type":"codeListing"},{"level":2,"text":"2. Multi-Column Grouping","anchor":"2-Multi-Column-Grouping","type":"heading"},{"inlineContent":[{"type":"text","text":"You can group by multiple categorical dimensions simultaneously:"}],"type":"paragraph"},{"syntax":"swift","code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"],"type":"codeListing"},{"level":2,"text":"3. Performance & Memory Efficiency","anchor":"3-Performance--Memory-Efficiency","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Single-Pass Hash Accumulation"}]},{"type":"text","text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"vDSP Vector Reductions","type":"text"}]},{"text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines (","type":"text"},{"type":"codeVoice","code":"vDSP_sveD"},{"text":", ","type":"text"},{"type":"codeVoice","code":"vDSP_meanvD"},{"text":").","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"sections":[],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupBy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"...) -> ","kind":"text"},{"text":"GroupedDataFrame","preciseIdentifier":"s:14SwiftDataFrame07Gr