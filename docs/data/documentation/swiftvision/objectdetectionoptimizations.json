{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"In real-time computer vision models such as YOLO, post-processing can generate tens of thousands of candidate detections per frame. Standard bounding box objects with heap-allocated "},{"code":"String","type":"codeVoice"},{"type":"text","text":" class names induce significant ARC and memory allocation overhead."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"SwiftVision"},{"type":"text","text":" introduces "},{"identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBoxSIMD","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Zero-Heap Value Representation","type":"text"}]},{"type":"text","text":": Encapsulates bounding coordinates in hardware "},{"type":"codeVoice","code":"SIMD4<Float>"},{"type":"text","text":" registers and replaces strings with integer "},{"type":"codeVoice","code":"classId: Int32"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Accelerated Vector IoU"}],"type":"strong"},{"text":": Computes intersection, union, and clamping entirely within SIMD registers without memory allocations.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"High-Throughput NMS"}]},{"text":": Provides ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/NonMaximumSuppression\/filter(boxes:iouThreshold:scoreThreshold:)-5ernf","isActive":true},{"text":" operating directly on SIMD bounding boxes.","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Usage-Example","text":"Usage Example","type":"heading","level":2},{"code":["import SwiftVision","","\/\/ Create candidates using SIMD coordinates:","let candidate = BoundingBoxSIMD(","    xMin: 12.5, yMin: 34.0,","    xMax: 150.0, yMax: 220.0,","    confidence: 0.92,","    classId: 0 \/\/ e.g. \"person\"",")","","\/\/ Filter detections with zero-heap NMS:","let detections = NonMaximumSuppression.filter(","    boxes: candidates,","    iouThreshold: 0.45,","    scoreThreshold: 0.25",")"],"type":"codeListing","syntax":"swift"}]}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBoxSIMD","doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBox","doc:\/\/SwiftVision\/documentation\/SwiftVision\/NonMaximumSuppression"],"anchor":"Structures"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/ObjectDetectionOptimizations"},"metadata":{"role":"collectionGroup","title":"Object Detection Optimizations & SIMD Bounding Boxes","modules":[{"name":"SwiftVision"}],"roleHeading":"API Collection"},"abstract":[{"type":"text","text":"Hardware-accelerated zero-heap bounding box processing and Non-Maximum Suppression (NMS) for real-time vision pipelines."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftvision\/objectdetectionoptimizations"]}],"references":{"doc://SwiftVision/documentation/SwiftVision/NonMaximumSuppression":{"navigatorTitle":[{"kind":"identifier","text":"NonMaximumSuppression"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"NonMaximumSuppression"}],"title":"NonMaximumSuppression","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/NonMaximumSuppression","abstract":[{"type":"text","text":"Pure Swift high-performance Non-Maximum Suppression (NMS) for filtering overlapping bounding boxes."}],"ty