{"abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 "},{"type":"codeVoice","code":"public actor"},{"type":"text","text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks."}]},{"type":"thematicBreak"},{"text":"🔒 Driver Architecture & Concurrency Model","level":2,"anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model","type":"heading"},{"code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"],"syntax":null,"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Actor Isolation:"}],"type":"strong"},{"text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Streaming "},{"type":"codeVoice","code":"recv"},{"type":"text","text":" Buffer:"}],"type":"strong"},{"type":"text","text":" Network drivers use a 64KB receive buffer reading continuously until "},{"type":"codeVoice","code":"ReadyForQuery ('Z')"},{"type":"text","text":" is received."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Authentication:"}],"type":"strong"},{"text":" Built-in support for Cleartext and MD5 password authentication via ","type":"text"},{"code":"CommonCrypto","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"text":"1. Querying SQLite Databases & C-Pointer Lifecycle Safety","level":2,"anchor":"1-Querying-SQLite-Databases--C-Pointer-Lifecycle-Safety","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SQLiteConnection"},{"type":"text","text":" executes SQL statements through native "},{"type":"codeVoice","code":"sqlite3_prepare_v2"},{"type":"text","text":" and directly streams result rows into columnar "},{"type":"codeVoice","code":"TypedColumn"},{"type":"text","text":" buffers with full C-pointer lifecycle safety:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Statement Finalization:"}],"type":"strong"},{"text":" All prepared statements are guaranteed to be finalized via ","type":"text"},{"code":"defer { if let stmt { sqlite3_finalize(stmt) } }","type":"codeVoice"},{"text":", preventing statement pointer leaks during both normal termination and thrown query errors.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Resource Cleanup:"}],"type":"strong"},{"text":" In-memory or file-backed database handles are automatically closed via ","type":"text"},{"code":"sqlite3_close_v2","type":"codeVoice"},{"text":" upon deallocation. Callers may also invoke ","type":"text"},{"code":"await sqlite.close()","type":"codeVoice"},{"text":" to immediately release operating system locks and memory.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = SQLiteConnection(databasePath: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)","","\/\/ 3. Explicitly release SQLite database handle when done","await sqlite.close()"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","level":2,"anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries ("},{"type":"codeVoice","code":"libpq"},{"type":"text","text":"):"}]},{"code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    user: \"postgres\",","    password: \"secure_password\",","    sslMode: .disable",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"text":"3. High-Throughput Bulk Writeback (`toSQL`)","level":2,"anchor":"3-High-Throughput-Bulk-Writeback-toSQL","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bulk export in-memory "},{"type":"codeVoice","code":"DataFrame"},{"type":"text","text":" objects back into database tables with configurable append, replace, or fail-if-exists modes:"}]},{"code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append, .replace, or .failIfExists","    batchSize: 500",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"],"syntax":"swift","type":"codeListing"}]}],"kind":"article","seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"],"generated":true,"anchor":"Guides--Tutorials"}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/databaseconnectors"]}],"metadata":{"role":"article","modules":[{"name":"SwiftDatabase"}],"roleHeading":"Article","title":"Relational Database Drivers & Zero-Copy SQL Ingestion"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors"},"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/SecurityAndPerformance":{"title":"Security & Performance in SwiftDatabase","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","role":"collectionGroup","kind":"article","url":"\/documentation\/swiftdatabase\/securityandperformance","abstract":[{"type":"text","text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL."}],"type":"topic"},"doc://SwiftDatabase/documentation/SwiftDatabase":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase","url":"\/documentation\/swiftdatabase","title":"SwiftDatabase","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Relational Database Connectors to DataFrames."}],"role":"collection"},"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"abstract":[{"text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions.","type":"text"}],"type":"topic","kind":"article","role":"collectionGroup","title":"Database Type System & Value Representation","url":"\/documentation\/swiftdatabase\/typesystem","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"abstract":[{"text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback.","type":"text"}],"type":"topic","kind":"article","role":"collectionGroup","title":"Bulk SQL Ingestion & Database Wire Protocols","url":"\/documentation\/swiftdatabase\/highthroughputingestion","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion"}}}