{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftDataFrame"}],"title":"Apache Arrow & Feather Zero-Copy Integration"},"topicSections":[{"identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"],"anchor":"Arrow-Classes--Readers","title":"Arrow Classes & Readers"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties."}],"type":"paragraph"},{"anchor":"1-Arrow-Memory-Layout--Bitmaps","level":2,"type":"heading","text":"1. Arrow Memory Layout & Bitmaps"},{"inlineContent":[{"type":"text","text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:"}],"type":"paragraph"},{"code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"],"syntax":null,"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Validity Bitmaps","type":"text"}]},{"text":": Each bit represents the presence (1) or absence (0) of a value at that index.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"SIMD Null Filtering","type":"text"}]},{"text":": Vectorized operations skip null evaluations using SIMD bitmasks (","type":"text"},{"type":"codeVoice","code":"vDSP_vcmprsD"},{"text":"), allowing full CPU register utilization.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"2-Feather-File-Format-Arrow-IPC","level":2,"type":"heading","text":"2. Feather File Format (Arrow IPC)"},{"inlineContent":[{"text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:","type":"text"}],"type":"paragraph"},{"code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"3. Lazy Feather Streaming","anchor":"3-Lazy-Feather-Streaming"},{"inlineContent":[{"text":"For large datasets, SwiftDataFrame supports streaming chunked reads:","type":"text"}],"type":"paragraph"},{"code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization."}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"url":"\/documentation\/swiftdataframe\/featherreader","abstract":[{"type":"text","text":"Reader for Feather \/ Apache Arrow IPC binary file format."}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"FeatherReader"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"FeatherReader"}],"title":"FeatherReader","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn","url":"\/documentation\/swiftdataframe\/typedcolumn","title":"TypedColumn","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A strongly-typed column backed by a contiguous Swift array."},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" elements represent null \/ missing values."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypedColumn"}],"navigatorTitle":[{"kind":"identifier","text":"TypedColumn"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","title":"FeatherWriter","url":"\/documentation\/swiftdataframe\/featherwriter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"FeatherWriter"}],"type":"topic","abstract":[{"text":"Writer for Feather \/ Apache Arrow IPC binary file format.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherWriter"}],"role":"symbol"},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","title":"SwiftDataFrame","url":"\/documentation\/swiftdataframe","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}],"role":"collection"}}}