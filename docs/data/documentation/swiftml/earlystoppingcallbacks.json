{"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting."}],"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport"],"anchor":"Guides--Tutorials","generated":true}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftML"}],"title":"Early Stopping & Generalization Control"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/earlystoppingcallbacks"]}],"topicSections":[{"title":"Training Callbacks","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStopping","doc:\/\/SwiftML\/documentation\/SwiftML\/MetricDirection"],"anchor":"Training-Callbacks"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Iterative estimators like multi-layer perceptrons (","type":"text"},{"code":"MLPClassifier","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MLPRegressor","type":"codeVoice"},{"text":") and gradient boosted decision trees (","type":"text"},{"code":"GradientBoostedTreesRegressor","type":"codeVoice"},{"text":") improve their training loss over successive iterations. However, after sufficient capacity has been fit, additional epochs frequently lead to overfitting on training noise and deteriorating generalization on unseen data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"EarlyStopping","type":"codeVoice"},{"text":" provides a decoupled, value-type training callback that monitors validation loss or performance metrics across successive epochs, halting training and optionally restoring optimal model weights.","type":"text"}]},{"level":2,"anchor":"Mechanics--State-Machine","type":"heading","text":"Mechanics & State Machine"},{"code":["Epoch Evaluation (Score S_t)","            │","            ▼"," Is (Best - S_t) > minDelta?","   ├── YES ──► Reset wait = 0, update bestScore = S_t, checkpoint weights","   └── NO  ──► Increment wait = wait + 1","                 │","            Is wait >= patience?","              ├── YES ──► shouldStop = true, restore best checkpoint weights","              └── NO  ──► Continue training"],"type":"codeListing","syntax":null},{"level":3,"anchor":"Configuration-Parameters","type":"heading","text":"Configuration Parameters"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"patience"},{"text":": Number of consecutive non-improving evaluations tolerated before triggering an early halt.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"minDelta"},{"text":": Minimum absolute improvement required to qualify as progress.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"direction"},{"text":": ","type":"text"},{"type":"codeVoice","code":".minimize"},{"text":" for loss functions (cross-entropy, MSE) or ","type":"text"},{"type":"codeVoice","code":".maximize"},{"text":" for scoring metrics (accuracy, R2, AUC).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"restoreBestWeights"},{"text":": When ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", automatically restores the model parameters from the epoch that achieved ","type":"text"},{"type":"codeVoice","code":"bestScore"},{"text":", avoiding overfit tail iterations.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Example-Usage","type":"heading","text":"Example Usage"},{"code":["import SwiftML","","\/\/ 1. Configure early stopping callback","let es = EarlyStopping(","    patience: 5,","    minDelta: 1e-4,","    direction: .minimize,","    restoreBestWeights: true",")","","\/\/ 2. Fit MLP with validation monitoring","let mlp = MLPClassifier(hiddenLayerSizes: [32, 16], maxIter: 200)","try await mlp.fit(","    features: X_train,","    targets: y_train,","    validationFeatures: X_val,","    validationTargets: y_val,","    earlyStopping: es",")"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://SwiftML/documentation/SwiftML/ReproducibilityAndPRNG":{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","title":"Reproducibility, Determinism & High-Quality PRNG","abstract":[{"text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators.","type":"text"}],"url":"\/documentation\/swiftml\/reproducibilityandprng","kind":"article","type":"topic","role":"collectionGroup"},"doc://SwiftML/documentation/SwiftML/SupervisedRegressors":{"abstract":[{"text":"Perform continuous target predictions using LinearRegression (exact OLS), DecisionTreeRegressor, and GradientBoostedTreesRegressor.","type":"text"}],"url":"\/documentation\/swiftml\/supervisedregressors","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","role":"article","kind":"article","title":"Supervised Regression Models","type":"topic"},"doc://SwiftML/documentation/SwiftML":{"abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"url":"\/documentation\/swiftml","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","role":"collection","title":"SwiftML","kind":"symbol