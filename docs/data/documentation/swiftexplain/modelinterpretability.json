{"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/modelinterpretability"]}],"sections":[],"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions"],"anchor":"Guides--Tutorials"}],"metadata":{"title":"Model Interpretability & XAI Guide","role":"article","modules":[{"name":"SwiftExplain"}],"roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Explainable Artificial Intelligence (XAI) bridges the gap between predictive accuracy and decision transparency. "},{"code":"SwiftExplain","type":"codeVoice"},{"type":"text","text":" provides exact Shapley mathematical decomposition for tree-based models, local linear surrogate modeling with LIME, and model-agnostic permutation metrics."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"%F0%9F%93%8A-Explainability-Methods-Comparison","level":2,"type":"heading","text":"📊 Explainability Methods Comparison"},{"rows":[[[{"inlineContent":[{"text":"Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Supported Models","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Algorithmic Complexity","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Scope","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Recommendation","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"code":"TreeSHAP","type":"codeVoice"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decision Trees, Random Forests, GBDT","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"O(T · L · D²)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Local & Global","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Recommended for all tree models."}],"type":"strong"},{"text":" Exact polynomial Shapley computation directly on flat nodes without sampling noise.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"code":"KernelSHAP","type":"codeVoice"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Any black-box model (MLP, SVM, Ensembles)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"O(S · D²)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Local","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Universal Shapley attribution using weighted coalition sampling.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"LIME"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Any black-box model (MLP, Vision, NLP)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"O(S · D)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Local","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Fast local surrogate."}],"type":"strong"},{"type":"text","text":" Fits an interpretable weighted linear model around perturbations."}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"code":"PermutationImportance","type":"codeVoice"}],"type":"strong"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any model"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"O(D · N)"}]}],[{"inlineContent":[{"type":"text","text":"Global"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fast global feature ranking by measuring validation loss degradation upon feature column shuffling."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"PartialDependencePlot","type":"codeVoice"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Any model","type":"text"}]}],[{"inlineContent":[{"type":"codeVoice","code":"O(G · N)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Global","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Visualizes marginal effect of 1 or 2 features across an evaluation grid."}],"type":"paragraph"}]]],"type":"table","header":"row","alignments":["left","left","left","left","left"]},{"type":"thematicBreak"},{"anchor":"1-Exact-TreeSHAP-for-Tree-Ensembles","level":2,"type":"heading","text":"1. Exact TreeSHAP for Tree Ensembles"},{"inlineContent":[{"type":"codeVoice","code":"TreeSHAP"},{"text":" traverses tree branches in polynomial time, calculating exact Shapley values without random coalition sampling:","type":"text"}],"type":"paragraph"},{"code":["import Foundation","import SwiftML","import SwiftExplain","","\/\/ 1. Train a Random Forest Classifier","let X = [[1.0, 2.0], [2.0, 1.0], [5.0, 4.0], [6.0, 5.0]]","let y = [0, 0, 1, 1]","","let forest = try RandomForestClassifier(nTrees: 10, maxDepth: 4)","try await forest.fit(features: X, labels: y)","","\/\/ 2. Explain prediction on a target instance","let treeSHAP = TreeSHAP()","let instance = [5.5, 4.2]","","let shapValues = try await treeSHAP.explain(model: forest, instance: instance)","","print(\"=== TreeSHAP Feature Attributions ===\")","for (featureIdx, attribution) in shapValues.enumerated() {","    print(\"Feature \\(featureIdx): Contribution = \\(String(format: \"%+.4f\", attribution))\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"2-Local-Interpretable-Model-agnostic-Explanations-LIME","level":2,"type":"heading","text":"2. Local Interpretable Model-agnostic Explanations (`LIME`)"},{"type":"paragraph","inlineContent":[{"code":"LIMEExplainer","type":"codeVoice"},{"type":"text","text":" perturbs the neighborhood of a target sample using Box-Muller Gaussian noise, weights samples by an exponential distance kernel, and fits a weighted Ridge regression surrogate model:"}]},{"code":["import SwiftExplain","import SwiftML","","\/\/ Black-box model closure","let modelClosure: @Sendable ([Double]) async -> Double = { x in","    \/\/ Non-linear complex interaction","    return 3.0 * x[0] + sin(x[1] * 2.0) - 1.5 * x[2] * x[2] + 4.0","}","","let instance = [1.5, 0.8, -0.4]","","let lime = LIMEExplainer(kernelWidth: 0.75, regularization: 0.1)","let explanation = await lime.explain(","    model: modelClosure,","    instance: instance,","    numSamples: 500",")","","print(\"=== LIME Local Surrogate Explanation ===\")","print(\"Local Prediction: \\(String(format: \"%.4f\", explanation.prediction))\")","print(\"Surrogate Intercept: \\(String(format: \"%.4f\", explanation.intercept))\")","print(\"Local Goodness-of-Fit (R²): \\(String(format: \"%.2f%%\", explanation.localR2 * 100))\")","","for (d, weight) in explanation.featureWeights.enumerated() {","    print(\"Feature [\\(d)] Local Slope: \\(String(format: \"%+.4f\", weight))\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"3-Global-Permutation-Feature-Importance","level":2,"type":"heading","text":"3. Global Permutation Feature Importance"},{"inlineContent":[{"type":"text","text":"Measure global model dependence by quantifying score drop when a single feature column is randomly permuted:"}],"type":"paragraph"},{"code":["import SwiftExplain","","let perm = PermutationImportance()","let importances = try await perm.computeImportance(","    features: X,","    targets: y.map(Double.init)",") { matrix in","    try await forest.predict(features: matrix).map(Double.init)","}","","print(\"=== Global Feature Importance Ranking ===\")","for (feat, score) in importances.sorted(by: { $0.value > $1.value }) {","    print(\"\\(feat): Importance Score = \\(String(format: \"%.4f\", score))\")","}"],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"abstract":[{"type":"text","text":"Understand black-box machine learning predictions using "},{"code":"TreeSHAP","type":"codeVoice"},{"type":"text","text":", "},{"code":"KernelSHAP","type":"codeVoice"},{"type":"text","text":", "},{"code":"LIMEExplainer","type":"codeVoice"},{"type":"text","text":", "},{"code":"PermutationImportance","type":"codeVoice"},{"type":"text","text":", and "},{"code":"PartialDependencePlot","type":"codeVoice"},{"type":"text","text":"."}],"references":{"doc://SwiftExplain/documentation/SwiftExplain/ShapleyAttributions":{"type":"topic","title":"SHAP Feature Attributions","kind":"article","role":"article","abstract":[{"type":"text","text":"Compute exact and approximate Shapley feature importance scores using parallel KernelSHAP and tree-accelerated TreeSHAP."}],"url":"\/documentation\/swiftexplain\/shapleyattributions","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions"},"doc://SwiftExplain/documentation/SwiftExplain":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","kind":"symbol","type":"topic","url":"\/documentation\/swiftexplain","title":"SwiftExplain","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}],"role":"collection"}}}