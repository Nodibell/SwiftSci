{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"During autoregressive language generation, logits from the transformer output layer are converted into probability distributions over the vocabulary. "},{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" executes sampling transformations strictly at the unnormalized logits level prior to softmax evaluation:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"$$\\text{Logits} \\xrightarrow{\\text{Repetition Penalty}} \\xrightarrow{\\text{Temperature}} \\xrightarrow{\\text{Top-K Mask (-inf)}} \\xrightarrow{\\text{Top-P Mask (-inf)}} \\xrightarrow{\\text{Softmax}} \\xrightarrow{\\text{Sample}}$$"}],"type":"paragraph"},{"level":2,"type":"heading","text":"1. Supported Sampling Methods","anchor":"1-Supported-Sampling-Methods"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Parameter","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Mathematical Formulation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Semantics & Defaults","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Temperature ("},{"type":"codeVoice","code":"temperature"},{"type":"text","text":")"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"$z_i \\leftarrow z_i \/ T$","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Controls distribution entropy. ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" = identity; ","type":"text"},{"code":"0.0","type":"codeVoice"},{"text":" = greedy deterministic argmax. Default: ","type":"text"},{"code":"0.7","type":"codeVoice"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Top-K ("},{"type":"codeVoice","code":"topK"},{"type":"text","text":")"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Masks all tokens outside top $K$ with $-\\infty$","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Eliminates low-probability tail tokens. ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" disables Top-K filtering. Default: ","type":"text"},{"code":"40","type":"codeVoice"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Top-P Nucleus ("},{"type":"codeVoice","code":"topP"},{"type":"text","text":")"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Retains cumulative probability $\\sum P(w_i) \\ge p$","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Dynamically bounds candidates based on probability mass. ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" disables Top-P. Default: ","type":"text"},{"code":"0.9","type":"codeVoice"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Repetition Penalty ("},{"type":"codeVoice","code":"repetitionPenalty"},{"type":"text","text":")"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"$z_i \\leftarrow z_i > 0 \\ ? \\ z_i \/ \\theta : z_i \\cdot \\theta$","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Penalizes tokens previously emitted in generation history. ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" disables penalty. Default: ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":".","type":"text"}]}]]],"alignments":["left","left","left"],"type":"table"},{"level":2,"type":"heading","text":"2. Configuration & Code Example","anchor":"2-Configuration--Code-Example"},{"inlineContent":[{"type":"text","text":"Generation options are unified within "},{"type":"codeVoice","code":"SamplingConfiguration"},{"type":"text","text":", serving as the single source of truth inside "},{"type":"codeVoice","code":"LLMOptions"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftLLM","","\/\/ 1. Define decoupled sampling parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","\/\/ 2. Configure model generation options","let options = LLMOptions(","    maxTokens: 128,","    stopTokens: [128001, 128009],","    sampling: sampling",")","","\/\/ 3. Stream generated tokens asynchronously","for try await token in model.generateStream(prompt: \"Explain rotary positional embeddings:\", options: options) {","    print(token, terminator: \"\")","}"]}]}],"abstract":[{"type":"text","text":"Control autoregressive language generation with Temperature, Top-P Nucleus, Top-K, and Repetition Penalty."}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials"}],"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"],["doc:\/\/SwiftLLM\/documentation\/SwiftLLM","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference"],["doc:\/\/SwiftLLM\/documentation\/SwiftLLM","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"API Collection","title":"Token Sampling & Decoding Strategies","modules":[{"name":"SwiftLLM"}],"role":"collectionGroup"},"identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\