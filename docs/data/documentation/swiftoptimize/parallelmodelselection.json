{"metadata":{"title":"Concurrent Model Selection & Cross-Validation","modules":[{"name":"SwiftOptimize"}],"roleHeading":"API Collection","role":"collectionGroup"},"abstract":[{"text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency ","type":"text"},{"code":"TaskGroup","type":"codeVoice"},{"text":" primitives.","type":"text"}],"topicSections":[{"anchor":"Optimization--Search","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoML","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLStrategy","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLTaskType","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLLeaderboardEntry","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLError","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationResult"],"title":"Optimization & Search"}],"kind":"article","seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/HyperparameterTuning"],"title":"Guides & Tutorials","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftoptimize\/parallelmodelselection"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Cross-validation and multi-class classification workflows are embarrassingly parallel: each fold split and one-vs-rest binary sub-problem operates on independent slices of tabular data."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"SwiftOptimize"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SwiftML"},{"type":"text","text":" leverage structured Swift Concurrency ("},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"type":"text","text":") to dispatch multiple fold and class estimators concurrently."}],"type":"paragraph"},{"text":"Structured Concurrency Pipeline","level":2,"anchor":"Structured-Concurrency-Pipeline","type":"heading"},{"syntax":null,"code":["           Input Dataset [Features, Targets]","                          │","       ┌──────────────────┴──────────────────┐","       ▼                                     ▼"," Fold 1 Split (Task 1)                 Fold 2 Split (Task 2)","   ├─ Fit Candidate                      ├─ Fit Candidate","   └─ Compute Metric                     └─ Compute Metric","       │                                     │","       └──────────────────┬──────────────────┘","                          ▼","            withThrowingTaskGroup Aggregator","                          ▼","         Cross-Validation Average Leaderboard"],"type":"codeListing"},{"text":"AutoML Budgets & Cancellation","level":3,"anchor":"AutoML-Budgets--Cancellation","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"AutoML"},{"type":"text","text":" deliberately evaluates candidates and folds "},{"type":"strong","inlineContent":[{"text":"sequentially","type":"text"}]},{"type":"text","text":" inside its actor, which keeps ordering deterministic and avoids oversubscribing CPU cores with nested parallel fits. Its "},{"type":"codeVoice","code":"timeBudgetSeconds"},{"type":"text","text":" is a soft deadline checked before each candidate and fold; a fit already in progress is not interrupted. Parent task cancellation is honoured at the same checkpoints and throws "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Deterministic Class Ordering","level":3,"anchor":"Deterministic-Class-Ordering","type":"heading"},{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"OneVsRestClassifier"},{"type":"text","text":", binary classification estimators are dispatched concurrently to maximize throughput across cores. Results are tagged with their class index "},{"type":"codeVoice","code":"(c, est)"},{"type":"text","text":" and sorted prior to storage, ensuring 100% deterministic prediction ordering across runs."}],"type":"paragraph"},{"text":"Example Usage","level":2,"anchor":"Example-Usage","type":"heading"},{"syntax":"swift","code":["import SwiftOptimize","import SwiftML","","\/\/ 1. AutoML model selection across Logistic Regression, Decision Tree, Random Forest, and MLP","let automl = AutoML(timeBudgetSeconds: 30.0)","let report = try await automl.fit(features: X, targets: y)","print(\"Winning Model: \\(await automl.bestModelName ?? \"-\")\")","print(\"CV score: \\(report.metrics[\"cv_score\"]!)\")","","\/\/ 2. Parallel One-Vs-Rest classification","let ovr = OneVsRestClassifier(numClasses: 5)","try await ovr.fit(features: X, targets: y)","let predictions = try await ovr.predict(features: X_test)"],"type":"codeListing"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"references":{"doc://SwiftOptimize/documentation/SwiftOptimize/AutoMLStrategy":{"abstract":[{"type":"text","text":"AutoML search strategy."}],"url":"\/documentation\/swiftoptimize\/automlstrategy","title":"AutoMLStrategy","kind":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLStrategy","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoMLStrategy","kind":"identifier"}],"navigatorTitle":[{"text":"AutoMLStrategy","kind":"identifier"}]},"doc://SwiftOptimize/documentation/SwiftOptimize/AutoMLTaskType":{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLTaskType","navigatorTitle":[{"kind":"identifier","text":"AutoMLTaskType"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoMLTaskType"}],"ki