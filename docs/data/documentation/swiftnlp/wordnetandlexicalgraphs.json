{"topicSections":[{"title":"WordNet Types","anchor":"WordNet-Types","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNet","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/Synset","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS"]}],"variants":[{"paths":["\/documentation\/swiftnlp\/wordnetandlexicalgraphs"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"WordNet Semantic Hierarchy & Lexical Graphs","roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftNLP"}]},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"code":"WordNet","type":"codeVoice"},{"type":"text","text":" is a large lexical database of English where nouns, verbs, adjectives, and adverbs are organized into sets of cognitive synonyms called "},{"type":"strong","inlineContent":[{"type":"text","text":"Synsets"}]},{"type":"text","text":", interlinked by conceptual-semantic and lexical relations."}],"type":"paragraph"},{"anchor":"1-Looking-Up-Synsets--Definitions","type":"heading","level":2,"text":"1. Looking Up Synsets & Definitions"},{"syntax":"swift","type":"codeListing","code":["import SwiftNLP","","let wordnet = WordNet.shared","","\/\/ Look up all noun synsets for \"bank\"","let synsets = wordnet.synsets(for: \"bank\", pos: .noun)","for s in synsets {","    print(\"ID: \\(s.id), Definition: \\(s.definition)\")","}"]},{"anchor":"2-Semantic-Similarity-Metrics","type":"heading","level":2,"text":"2. Semantic Similarity Metrics"},{"inlineContent":[{"type":"text","text":"SwiftSci implements standard lexical similarity algorithms:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Path Similarity"}]},{"text":": Shortest path distance in the hypernym taxonomy:","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Sim_path(s1, s2) = 1 \/ (1 + distance(s1, s2))"}]}],"type":"aside","name":"Note","style":"note"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wu-Palmer Similarity (WUP)"}]},{"text":": Measures depth of least common subsumer (LCS) relative to synset depths:","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Sim_wup(s1, s2) = (2 · depth(LCS)) \/ (depth(s1) + depth(s2))"}]}],"type":"aside","name":"Note","style":"note"}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["let dog = wordnet.synset(\"dog.n.01\")!","let cat = wordnet.synset(\"cat.n.01\")!","","let pathSim = wordnet.pathSimilarity(dog, cat)","let wupSim = wordnet.wuPalmerSimilarity(dog, cat)","","print(\"Path Similarity: \\(pathSim), Wu-Palmer: \\(wupSim)\")"]}]}],"kind":"article","identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNetAndLexicalGraphs","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"abstract":[{"text":"Navigate semantic relationships, compute synset distances, and explore English hypernym\/hyponym trees.","type":"text"}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/WordNet":{"navigatorTitle":[{"text":"WordNet","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WordNet","kind":"identifier"}],"type":"topic","role":"symbol","url":"\/documentation\/swiftnlp\/wordnet","title":"WordNet","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNet","kind":"symbol","abstract":[{"type":"text","text":"Native WordNet semantic database query engine and concept similarity computer."}]},"doc://SwiftNLP/documentation/SwiftNLP":