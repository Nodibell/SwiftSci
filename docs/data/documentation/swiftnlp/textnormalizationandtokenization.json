ger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"]},{"text":"3. Sentiment Analysis (VADER & NLSentiment)","level":3,"type":"heading","anchor":"3-Sentiment-Analysis-VADER--NLSentiment"},{"syntax":"swift","type":"codeListing","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native ","type":"text"},{"type":"codeVoice","code":"NaturalLanguage"},{"text":" framework.","type":"text"}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/LlamaTokenizer":{"kind":"article","title":"Llama checkpoint tokenization","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LlamaTokenizer","type":"topic","abstract":[{"code":"BPETokenizer(llama3TokenizerJSON:)","type":"codeVoice"},{"text":" loads the byte-level BPE pipeline used by the pinned Llama 3.2 1B Instruct checkpoint.","type":"text"}],"url":"\/documentation\/swiftnlp\/llamatokenizer","role":"article"},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"kind":"article","title":"Text Feature Vectorization, Sparse TF-IDF & Local Embeddings","identifier":"doc:\/\/SwiftNLP\/doc