{"kind":"article","sections":[],"abstract":[{"type":"text","text":"Measure true feature importance by evaluating loss degradation after shuffling feature columns."}],"topicSections":[{"title":"Diagnostic Tools","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationImportance"],"anchor":"Diagnostic-Tools"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Permutation Feature Importance"}],"type":"strong"},{"text":" measures how much a trained model’s error increases when a single feature column is randomly shuffled, breaking the relationship between that feature and the target outcome.","type":"text"}]},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Importance Metric:"}]},{"text":" ","type":"text"},{"code":"Importance(f_j) = Loss(X_shuffled(j), y) - Loss(X, y)","type":"codeVoice"}]}],"type":"aside"},{"type":"heading","text":"1. Computing Permutation Importance","level":2,"anchor":"1-Computing-Permutation-Importance"},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","import SwiftML","","let importance = try await PermutationImportance.compute(","    model: trainedModel,","    features: X_val,","    targets: y_val,","    metric: .meanSquaredError,","    nRepeats: 10",")","","for (idx, score) in importance.enumerated() {","    print(\"Feature \\(idx): Mean drop = \\(score.mean), Std = \\(score.std)\")","}"]}],"kind":"content"}],"metadata":{"title":"Permutation Feature Importance & Model Diagnostics","modules":[{"name":"SwiftExplain"}],"roleHeading":"API Collection","role":"collectionGroup"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationFeatureImportance","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage"