{"abstract":[{"text":"Randomized Singular Value Decomposition using the Halko et al. (2011) algorithm.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RandomizedSVD"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Computes an approximate rank-k SVD of an M×N matrix A:"},{"type":"text","text":" "},{"type":"text","text":"A ≈ U * diag(S) * Vᵀ"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"where U is M×k orthonormal, S is k-vector of singular values, Vᵀ is k×N."}],"type":"paragraph"},{"anchor":"Complexity","level":2,"text":"Complexity","type":"heading"},{"inlineContent":[{"type":"text","text":"O(M·N·k) — dramatically faster than full "},{"type":"codeVoice","code":"dgesdd_"},{"type":"text","text":" O(M·N²) when k ≪ min(M, N)."}],"type":"paragraph"},{"anchor":"Algorithm-Halko-2011","level":2,"text":"Algorithm (Halko 2011)","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Draw random Gaussian matrix Ω ∈ ℝ^{N×(k+p)}  (p=10 oversampling)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Compute range sketch Y = A·Ω  via BLAS dgemm."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Orthonormalize Y via thin QR (dgeqrf + dorgqr)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Project B = Qᵀ·A  (small k×N matrix)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Compute small exact SVD of B with dgesdd_."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Back-project left singular vectors: U = Q·Ũ."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Reference","level":2,"text":"Reference","type":"heading"},{"inline