{"topicSections":[{"anchor":"Grouping-APIs","title":"Grouping APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"]}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"abstract":[{"text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory.","type":"text"}]},{"anchor":"1-Basic-GroupBy-Aggregation","type":"heading","level":2,"text":"1. Basic GroupBy Aggregation"},{"syntax":"swift","type":"codeListing","code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"]},{"anchor":"2-Multi-Column-Grouping","type":"heading","level":2,"text":"2. Multi-Column Grouping"},{"type":"paragraph","inlineContent":[{"text":"You can group by multiple categorical dimensions simultaneously:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"]},{"anchor":"3-Performance--Memory-Efficiency","type":"heading","level":2,"text":"3. Performance & Memory Efficiency"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Single-Pass Hash Accumulation"}],"type":"strong"},{"text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"vDSP Vector Reductions"}],"type":"strong"},{"text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines (","type":"text"},{"code":"vDSP_sveD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_meanvD","type":"codeVoice"},{"text":").","type":"text"}]}]}]}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"SwiftDataFrame"}],"title":"High-Performance GroupBy & Vectorized Aggregations","roleHeading":"API Collection","role":"collectionGroup"},"kind":"article","identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"type":"topic","title":"groupBy(_:)","abstract":[{"type":"text","text":"Returns a "},{"type":"codeVoice","code":"GroupedDataFrame"},{"type":"text","text":" for aggregation."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"groupBy","kind":"identifier"},{"text":"(","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"...) -> ","kind":"text"},{"text":"GroupedDataFrame","preciseIdentifier":"s:14SwiftDataFrame07GroupedbC0V","kind":"typeIdentifier"}],"url":"\/documentation\/swiftdataframe\/dataframe\/groupby(_:)","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)","role":"symbol"},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}],"role":"collection","title":"SwiftDataFrame","type":"topic","kind":"symbol","url":"\/documentation\/swiftdataframe","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"}}}