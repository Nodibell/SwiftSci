{"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"]}],"abstract":[{"text":"Forecast univariate time series with trends and periodic seasonalities using Autoregressive Integrated Moving Average (ARIMA), Seasonal ARIMA (SARIMA), and Automated Order Selection (AutoARIMA).","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"metadata":{"title":"ARIMA & SARIMA Time Series Models","role":"collectionGroup","modules":[{"name":"SwiftForecast"}],"roleHeading":"API Collection"},"sections":[],"kind":"article","topicSections":[{"title":"Forecasting Models","anchor":"Forecasting-Models","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/TimeSeriesMetrics"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftforecast\/arimaandsarima"]}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"Time series observations often display temporal autocorrelation, stochastic drift, and repetitive seasonal cycles. ","type":"text"},{"code":"SwiftForecast","type":"codeVoice"},{"text":" provides high-performance, actor-isolated statistical models optimized with Apple Accelerate SIMD linear algebra:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Models non-seasonal series using $(p, d, q)$ specifications with vectorized two-stage Hannan-Rissanen conditional least-squares parameter estimation (","type":"text"},{"code":"aic()","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"bic()","type":"codeVoice"},{"text":" evaluate the Gaussian residual-MSE criterion from conditional OLS residuals, rather than exact state-space MLE).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Extends ARIMA to capture multiplicative seasonal cycles $(p, d, q) \\times (P, D, Q)_s$ via polynomial cross-term refinement.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Performs parallelized grid search over potential order permutations, selecting optimal configurations via AIC or BIC criteria.","type":"text"}]}]}]},{"type":"codeListing","syntax":"mermaid","code":["graph TD","    RawSeries[Raw Time Series Y_t] --> StationarityCheck{Requires Differencing?}","    StationarityCheck -->|Yes| Diff[Differencing: d order \/ Seasonal D order]","    StationarityCheck -->|No| ModelChoice{Model Selection}","    Diff --> ModelChoice","    ModelChoice -->|Manual Specification| FitARIMA[ARIMAModel \/ SARIMAModel]","    ModelChoice -->|Automated Grid Search| Auto[AutoARIMA Task Group]","    Auto --> BestOrder[Optimal Order via AIC\/BIC]","    BestOrder --> FitARIMA","    FitARIMA --> ForecastResult[ARIMAResult: Point Forecasts + Confidence Intervals]","    ForecastResult --> WAPE[WAPE \/ sMAPE Evaluation]"]},{"type":"thematicBreak"},{"text":"1. Non-Seasonal ARIMA Modeling","anchor":"1-Non-Seasonal-ARIMA-Modeling","type":"heading","level":2},{"inlineContent":[{"text":"An $\\text{ARIMA}(p, d, q)$ model combines:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"$p$ (Autoregressive Order)"}],"type":"strong"},{"text":": Dependence on preceding $p$ lagged values.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"$d$ (Differencing Order)"}]},{"type":"text","text":": Degree of differencing required to achieve weak stationarity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"$q$ (Moving Average Order)"}]},{"type":"text","text":": Dependence on preceding $q$ white-noise forecast errors."}]}]}]},{"type":"heading","text":"Fitting and Multi-Step Forecasting","level":3,"anchor":"Fitting-and-Multi-Step-Forecasting"},{"type":"codeListing","syntax":"swift","code":["import SwiftForecast","","\/\/ 1. Initialize historical series (e.g., monthly sales)","let monthlySales: [Double] = [","    112, 118, 132, 129, 121, 135, 148, 148, 136, 119, 104, 118,","    115, 126, 141, 135, 125, 149, 170, 170, 158, 133, 114, 140","]","","\/\/ 2. Initialize actor-isolated ARIMA(1, 1, 1) model","let arima = try ARIMAModel(p: 1, d: 1, q: 1)","","\/\/ 3. Fit parameters via Hannan-Rissanen conditional least-squares","try await arima.fit(series: monthlySales)","","\/\/ 4. Generate out-of-sample forecast for next 6 horizons","let result = try await arima.forecast(horizon: 6)","","print(\"Point Forecasts: \\(result.pointForecasts)\")","if let lower = result.lowerConfidenceInterval, let upper = result.upperConfidenceInterval {","    for i in 0..<result.pointForecasts.count {","        print(\"t+\\(i + 1): \\(String(format: \"%.1f\", result.pointForecasts[i])) [95% CI: \\(String(format: \"%.1f\", lower[i])) – \\(String(format: \"%.1f\", upper[i]))]\")","    }","}"]},{"type":"thematicBreak"},{"text":"2. Seasonal SARIMA Modeling","anchor":"2-Seasonal-SARIMA-Modeling","type":"heading","level":2},{"inlineContent":[{"text":"When data exhibits recurring seasonal patterns (such as quarterly retail spikes or 24-hour diurnal rhythms), standard non-seasonal differencing is insufficient.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","type":"reference"},{"text":" incorporates multiplicative seasonal operators:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"$$(p, d, q) \\times (P, D, Q)_s$$","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"where:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"$s$"}],"type":"strong"},{"text":": Seasonal period length ($s=4$ for quarterly, $s=12$ for monthly, $s=7$ for daily data).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"$P, D, Q$"}],"type":"strong"},{"text":": Seasonal autoregressive, seasonal differencing, and seasonal moving-average orders.","type":"text"}]}]}]},{"type":"codeListing","syntax":"swift","code":["import SwiftForecast","","\/\/ Initialize SARIMA(1, 1, 1) x (1, 1, 0)_12 for monthly seasonal data","let sarima = try SARIMAModel(","    p: 1, d: 1, q: 1,","    P: 1, D: 1, Q: 0,","    s: 12",")","","try await sarima.fit(series: monthlySales)","","\/\/ Forecast 12 months ahead","let seasonalForecast = try await sarima.forecast(horizon: 12)","print(\"12-Month Ahead Forecast: \\(seasonalForecast.pointForecasts)\")"]},{"text":"Fitted Values and Residual Alignment","anchor":"Fitted-Values-and-Residual-Alignment","type":"heading","level":3},{"inlineContent":[{"text":"Both ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","type":"reference"},{"text":" expose original-scale in-sample predictions via ","type":"text"},{"code":"fittedValues","type":"codeVoice"},{"text":" (","type":"text"},{"code":"fittedValues.count == series.count","type":"codeVoice"},{"text":") and innovation residuals via ","type":"text"},{"code":"residuals","type":"codeVoice"},{"text":" (","type":"text"},{"code":"residuals.count == series.count - (d + D * s)","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Warmup indices ("},{"code":"0..<(d + D * s)","type":"codeVoice"},{"type":"text","text":")"}],"type":"strong"},{"text":": ","type":"text"},{"code":"fittedValues[t]","type":"codeVoice"},{"text":" preserves the initial observed value ","type":"text"},{"code":"series[t]","type":"codeVoice"},{"text":" because full differencing history is unavailable before ","type":"text"},{"code":"t = d + D * s","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Post-warmup indices ("},{"code":"(d + D * s)..<series.count","type":"codeVoice"},{"type":"text","text":")"}],"type":"strong"},{"text":": ","type":"text"},{"code":"fittedValues[t]","type":"codeVoice"},{"text":" equals the ","type":"text"},{"inlineContent":[{"type":"text","text":"closed-loop one-step-ahead in-sample prediction"}],"type":"strong"},{"text":" on the original scale computed using observed values up to ","type":"text"},{"code":"t - 1","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"series[t] - fittedValues[t] == residuals[t - (d + D * s)]","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"thematicBreak"},{"text":"3. Automated Order Selection (`AutoARIMA`)","anchor":"3-Automated-Order-Selection-AutoARIMA","type":"heading","level":2},{"inlineContent":[{"text":"Determining optimal $(p, d, q)$ and $(P, D, Q)_s$ orders manually through autocorrelation (ACF) and partial autocorrelation (PACF) plots can be labor-intensive. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","type":"reference"},{"text":" evaluates an exhaustive or bounded grid concurrently across Apple Silicon CPU cores, penalizing complexity with AIC or BIC:","type":"text"}],"type":"paragraph"},{"code":["import SwiftForecast","","\/\/ Initialize automated grid search engine","let autoArima = AutoARIMA(","    maxP: 3,","    maxD: 2,","    maxQ: 3,","    seasonal: true,","    seasonalPeriod: 12,","    criterion: .aic",")","","\/\/ Search across candidate permutations","let searchResult = try await autoArima.fit(series: monthlySales)","","print(\"Selected Optimal Order: \\(searchResult.bestOrder)\")","\/\/ Example: SARIMA(1, 1, 1)(0, 1, 1)[12]","print(\"Optimal AIC Score: \\(searchResult.bestScore)\")","","\/\/ Forecast directly using the winning model","let bestForecast = try await searchResult.forecast(horizon: 6)","print(\"Best Forecast: \\(bestForecast.pointForecasts)\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"4-Forecasting-Accuracy-with-TimeSeriesMetrics","text":"4. Forecasting Accuracy with `TimeSeriesMetrics`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Validate predictions against holdout test folds using standard metric evaluators, including Weighted Absolute Percentage Error (WAPE):"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftForecast","","let actuals: [Double] = [150.0, 162.0, 180.0, 175.0, 160.0, 142.0]","let predictions = result.pointForecasts","","let wapeError = TimeSeriesMetrics.wape(actual: actuals, forecast: predictions)","let smapeError = TimeSeriesMetrics.smape(actual: actuals, forecast: predictions)","let rmseError = TimeSeriesMetrics.rmse(actual: actuals, forecast: predictions)","","print(\"WAPE: \\(String(format: \"%.2f%%\", wapeError * 100))\")","print(\"sMAPE: \\(String(format: \"%.2f%%\", smapeError * 100))\")","print(\"RMSE: \\(String(format: \"%.2f\", rmseError))\")"]},{"type":"thematicBreak"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima"},"references":{"doc://SwiftForecast/documentation/SwiftForecast/SARIMAModel":{"navigatorTitle":[{"text":"SARIMAModel","kind":"identifier"}],"abstract":[{"type":"text","text":"Seasonal AutoRegressive Integrated Moving Average (SARIMA) time-series forecasting model actor."}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SARIMAModel","kind":"identifier"}],"url":"\/documentation\/swiftforecast\/sarimamodel","title":"SARIMAModel","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","kind":"symbol","type":"topic","role":"symbol"},"doc://SwiftForecast/documentation/SwiftForecast/SmoothingAndDecomposition":{"url":"\/documentation\/swiftforecast\/smoothinganddecomposition","kind":"article","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","abstract":[{"text":"Model trends, seasonality, volatility, and dynamic state transitions using ","type":"text"},{"code":"ExponentialSmoothing","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NelderMead"},{"type":"text","text":", "},{"type":"codeVoice","code":"KalmanFilter"},{"type":"text","text":", "},{"type":"codeVoice","code":"GARCHModel"},{"type":"text","text":", and "},{"code":"TimeSeriesDecomposition","type":"codeVoice"},{"type":"text","text":"."}],"title":"Time Series Forecasting, Smoothing & Kalman Filtering","role":"article","type":"topic"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAOrder":{"url":"\/documentation\/swiftforecast\/autoarimaorder","title":"AutoARIMAOrder","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A structure identifying the selected ARIMA \/ SARIMA order."}],"navigatorTitle":[{"text":"AutoARIMAOrder","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoARIMAOrder","kind":"identifier"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","role":"symbol"},"doc://SwiftForecast/documentation/SwiftForecast/TimeSeriesMetrics":{"url":"\/documentation\/swiftforecast\/timeseriesmetrics","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/TimeSeriesMetrics","navigatorTitle":[{"text":"TimeSeriesMetrics","kind":"identifier"}],"title":"TimeSeriesMetrics","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimeSeriesMetrics","kind":"identifier"}],"abstract":[{"type":"text","text":"Canonical evaluation metrics for time-series forecasting and out-of-sample validation (G-020)."}]},"doc://SwiftForecast/documentation/SwiftForecast":{"title":"SwiftForecast","kind":"symbol","url":"\/documentation\/swiftforecast","role":"collection","type":"topic","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast","abstract":[{"type":"text","text":"Time Series & Volatility Forecasting Models."}]},"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"url":"\/documentation\/swiftforecast\/koopmanoperator","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator","navigatorTitle":[{"text":"KoopmanOperator","kind":"identifier"}],"title":"KoopmanOperator","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KoopmanOperator","kind":"identifier"}],"abstract":[{"type":"text","text":"Koopman Operator time-series forecasting and dynamical system modeling actor."},{"type":"text","text":" "},{"type":"text","text":"Uses Extended Dynamic Mode Decomposition (EDMD) to approximate non-linear dynamics"},{"text":" ","type":"text"},{"type":"text","text":"via linear operators in lifted observable feature spaces."}]},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMA":{"navigatorTitle":[{"text":"AutoARIMA","kind":"identifier"}],"abstract":[{"text":"Automated hyperparameter grid search for ARIMA and SARIMA time-series models.","type":"text"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoARIMA"}],"url":"\/documentation\/swiftforecast\/autoarima","title":"AutoARIMA","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","kind":"symbol","type":"topic","role":"symbol"},"doc://SwiftForecast/documentation/SwiftForecast/ARIMAModel":{"navigatorTitle":[{"kind":"identifier","text":"ARIMAModel"}],"kind":"symbol","title":"ARIMAModel","url":"\/documentation\/swiftforecast\/arimamodel","role":"symbol","type":"topic","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ARIMAModel"}],"abstract":[{"type":"text","text":"AutoRegressive Integrated Moving Average (ARIMA) time-series forecasting model actor."}]},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAParallel":{"url":"\/documentation\/swiftforecast\/autoarimaparallel","type":"topic","kind":"article","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","title":"Concurrent Order Selection with AutoARIMA","role":"collectionGroup","abstract":[{"type":"text","text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency."}]}}}