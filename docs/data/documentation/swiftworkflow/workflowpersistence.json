{"sections":[],"variants":[{"paths":["\/documentation\/swiftworkflow\/workflowpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"url":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"SwiftWorkflow"}],"title":"Deploying and Persisting Scientific Workflows","roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Learn how to safely persist, reload, and evaluate end-to-end machine learning workflows across processes."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"In production scientific machine learning systems, data leakage between training and evaluation phases is one of the most common causes of overly optimistic validation metrics. "},{"type":"codeVoice","code":"SwiftWorkflow"},{"type":"text","text":" eliminates leakage by enforcing structural invariants at the API level:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Explicit Supervised Batch Splitting"}],"type":"strong"},{"text":": Workflows accept ","type":"text"},{"code":"PreparedSupervisedBatch","type":"codeVoice"},{"text":" instances where row selection explicitly tracks ","type":"text"},{"code":"originalRowIndices","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Immutable Stages","type":"text"}]},{"type":"text","text":": Once trained, a workflow exposes no mutable hyperparameters or refitting paths."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Atomic Schema Validation"}]},{"type":"text","text":": When loading from JSON, dimensions and feature names are checked against the artifact header before initializing models."}]}]}],"type":"orderedList"},{"text":"End-to-End Persistence Pattern","type":"heading","anchor":"End-to-End-Persistence-Pattern","level":3},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftDataFrame","import SwiftWorkflow","","\/\/ Train workflow on designated training rows","let workflow = try await PCAClassificationWorkflow.train(","    training: trainingBatch,","    components: 2,","    learningRate: 0.125,","    epochs: 64",")","","\/\/ Serialize fitted stages to JSON artifact","let artifactURL = URL(fileURLWithPath: \"PCAWorkflow.json\")","try workflow.save(to: artifactURL)","","\/\/ Reload across independent processes with verified dimensions","let reloaded = try PCAClassificationWorkflow.load(from: artifactURL)","let predictions = try await reloaded.predict(unlabeledBatch)"]}],"kind":"content"}],"references":{"doc://SwiftWorkflow/documentation/SwiftWorkflow":{"url":"\/documentation\/swiftworkflow","title":"SwiftWorkflow","abstract":[{"text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization.","type":"text"}],"type":"topic","role":"collection","identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow","kind":"symbol"}}}