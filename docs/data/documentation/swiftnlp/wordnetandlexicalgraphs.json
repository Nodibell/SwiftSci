{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNetAndLexicalGraphs"},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Navigate semantic relationships, compute synset distances, and explore English hypernym\/hyponym trees."}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"code":"WordNet","type":"codeVoice"},{"text":" is a large lexical database of English where nouns, verbs, adjectives, and adverbs are organized into sets of cognitive synonyms called ","type":"text"},{"type":"strong","inlineContent":[{"text":"Synsets","type":"text"}]},{"text":", interlinked by conceptual-semantic and lexical relations.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"1-Looking-Up-Synsets--Definitions","type":"heading","text":"1. Looking Up Synsets & Definitions"},{"code":["import SwiftNLP","","let wordnet = WordNet.shared","","\/\/ Look up all noun synsets for \"bank\"","let synsets = wordnet.synsets(for: \"bank\", pos: .noun)","for s in synsets {","    print(\"ID: \\(s.id), Definition: \\(s.definition)\")","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"2-Semantic-Similarity-Metrics","type":"heading","text":"2. Semantic Similarity Metrics"},{"inlineContent":[{"text":"SwiftSci implements standard lexical similarity algorithms:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Path Similarity"}],"type":"strong"},{"type":"text","text":": Shortest path distance in the hypernym taxonomy:"}]},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Sim_path(s1, s2) = 1 \/ (1 + distance(s1, s2))"}],"type":"paragraph"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Wu-Palmer Similarity (WUP)"}],"type":"strong"},{"type":"text","text":": Measures depth of least common subsumer (LCS) relative to synset depths:"}]},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Sim_wup(s1, s2) = (2 · depth(LCS)) \/ (depth(s1) + depth(s2))"}],"type":"paragraph"}]}]}],"type":"unorderedList"},{"code":["let dog = wordnet.synset(\"dog.n.01\")!","let cat = wordnet.synset(\"cat.n.01\")!","","let pathSim = wordnet.pathSimilarity(dog, cat)","let wupSim = wordnet.wuPalmerSimilarity(dog, cat)","","print(\"Path Similarity: \\(pathSim), Wu-Palmer: \\(wupSim)\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/wordnetandlexicalgraphs"]}],"topicSections":[{"anchor":"WordNet-Types","title":"WordNet Types","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNet","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/Synset","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS"]}],"metadata":{"title":"WordNet Semantic Hierarchy & Lexical Graphs","modules":[{"name":"SwiftNLP"}],"roleHeading":"API Collection","role":"collectionGroup"},"references":{"doc://SwiftNLP/documentation/SwiftNLP/POS":{"url":"\/documentation\/swiftnlp\/pos","role":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"POS","kind":"identifier"}],"navigatorTitle":[{"text":"POS","kind":"identifier"}],"type":"topic","kind":"symbol","title":"POS","abstract":[{"text":"Part of Speech categories in WordNet.","type":"text"}]},"doc://SwiftNLP/documentation/SwiftNLP/Synset":{"kind":"symbol","type":"topic","url":"\/documentation\/swif