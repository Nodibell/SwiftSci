{"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode"],"anchor":"Estimators","title":"Estimators"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Traditional gradient boosted decision trees (GBDT) evaluate continuous threshold candidates by sorting or scanning exact values across all samples at every tree node. When datasets grow large, sorting becomes a major performance bottleneck.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"HistGradientBoostingClassifier","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"HistGradientBoostingRegressor","type":"codeVoice"},{"text":" implement histogram-based split optimization (inspired by LightGBM and scikit-learn’s ","type":"text"},{"code":"HistGradientBoostingClassifier","type":"codeVoice"},{"text":"). Continuous feature columns are pre-binned into at most 256 integer bins (","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":").","type":"text"}]},{"level":2,"type":"heading","text":"Algorithmic Architecture","anchor":"Algorithmic-Architecture"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Pre-Binning (Quantization)"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"Feature quantiles are evaluated once before boosting begins, establishing up to 256 discrete bins per feature column. All feature values are mapped to compact ","type":"text"},{"type":"codeVoice","code":"UInt8"},{"text":" memory arrays.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"One-Pass Histogram Accumulation"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"For any internal tree node, first-order negative gradients (g_i) and second-order Hessians (h_i) are accumulated into flat 256-bin histograms in an (O(N_{\\text{node}} \\cdot p)) linear pass over the node’s samples:","type":"text"},{"text":" ","type":"text"},{"text":"$$G[k] = \\sum_{i: b_i = k} g_i, \\quad H[k] = \\sum_{i: b_i = k} h_i$$","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Histogram-Bin Split Scan"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"Once histograms are built, evaluating all candidate thresholds scans only the (K \\le 256) populated bins per feature ((O(K \\cdot p))), rather than re-sorting (N_{\\text{node}}) continuous values:","type":"text"},{"text":" ","type":"text"},{"text":"$$\\text{Gain} = \\frac{1}{2} \\left[ \\frac{G_L^2}{H_L + \\lambda} + \\frac{G_R^2}{H_R + \\lambda} - \\frac{G_{\\text{tot}}^2}{H_{\\text{tot}} + \\lambda} \\right]$$","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"syntax":null,"code":["Continuous Floats [0.14, 0.92, -0.45] ──► Pre-Binning ──► UInt8 Bins [32, 215, 12]","                                                                  │  O(N_node · p) build","                                                                  ▼","Node Split Scan: O(K · p), K <= 256 ◄─── Accumulated Histograms G[k], H[k]"],"type":"codeListing"},{"level":2,"type":"heading","text":"Example Usage","anchor":"Example-Usage"},{"syntax":"swift","code":["import SwiftML","","let clf = try HistGradientBoostingClassifier(","    nEstimators: 50,","    learningRate: 0.1,","    maxDepth: 6,","    maxBins: 256,","    minSamplesLeaf: 10",")","","try await clf.fit(features: X_train, targets: y_train)","let predictions = try await clf.predict(features: X_test)","let probabilities = try await clf.predictProbability(features: X_test)"],"type":"codeListing"}],"kind":"content"}],"abstract":[{"type":"text","text":"Discretize continuous feature distributions into up to 256 compact bins ("},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":") so tree-node split gain scans take $O(K \\cdot p)$ time over $K \\le 256$ bins after an $O(N_{\\text{node}} \\cdot p)$ histogram accumulation pass."}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedClassification","doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLInference","doc:\/\/SwiftML\/documentation\/SwiftML\/BoundedInference","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","doc:\/\/SwiftML\/documentation\/SwiftML\/ReusableCPUPrediction"],"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/histogramgradientboosting"]}],"sections":[],"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftML"}],"role":"collectionGroup","title":"Fast Tabular Learning with Histogram Gradient Boosting"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","references":{"doc://SwiftML/documentation/SwiftML/BoundedInference":{"abstract":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"CoreMLBatchPipeline.run"},{"type":"text","text":" to pull batches through fitted preprocessing and a fixed-shape Core ML model. The pipeline holds capacity until each result consumer returns."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/BoundedInference","type":"topic","role":"article","title":"Run bounded batch inference","url":"\/documentation\/swiftml\/boundedinference","kind":"article"},"doc://SwiftML/documentation/SwiftML/EarlyStoppingCallbacks":{"abstract":[{"type":"text","text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","type":"topic","role":"collectionGroup","url":"\/documentation\/swiftml\/earlystoppingcallbacks","title":"Early Stopping & Generalization Control","kind":"article"},"doc://SwiftML/documentation/SwiftML/ReproducibilityAndPRNG":{"title":"Reproducibility, Determinism & High-Quality PRNG","kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","url":"\/documentation\/swiftml\/reproducibilityandprng","abstract":[{"text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators.","type":"text"}],"type":"topic","role":"collectionGroup"},"doc://SwiftML/documentation/SwiftML/CoreMLInference":{"abstract":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLPredictor"},{"type":"text","text":" to run a compiled Core ML regression, vector, or matrix model on"},{"type":"text","text":" "},{"type":"codeVoice","code":"PreparedNumericBatch"},{"type":"text","text":". The predictor matches named scalar features or packs bounded batches"},{"type":"text","text":" "},{"type":"text","text":"for a vector input. Results retain the input’s row order and source indices."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLInference","type":"topic","role":"article","title":"Run prepared data through Core ML","url":"\/documentation\/swiftml\/coremlinference","kind":"article"},"doc://SwiftML/documentation/SwiftML":{"url":"\/documentation\/swiftml","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","role":"collection","title":"SwiftML","abstract":[{"text":"Supervised Machine Learning Estimators & Neural Networks.","type":"text"}],"kind":"symbol"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingRegressor":{"url":"\/documentation\/swiftml\/histgradientboostingregressor","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistGradientBoostingRegressor","kind":"identifier"}],"type":"topic","title":"HistGradientBoostingRegressor","navigatorTitle":[{"kind":"identifier","text":"HistGradientBoostingRegressor"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular regression."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingClassifier":{"url":"\/documentation\/swiftml\/histgradientboostingclassifier","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistGradientBoostingClassifier","kind":"identifier"}],"type":"topic","title":"HistGradientBoostingClassifier","navigatorTitle":[{"text":"HistGradientBoostingClassifier","kind":"identifier"}],"kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular classification."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier"},"doc://SwiftML/documentation/SwiftML/PreparedRegression":{"url":"\/documentation\/swiftml\/preparedregression","title":"Prepared regression","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"Fit and predict from compact numeric columns without constructing nested row arrays in the StandardScaler and LinearRegression path."}]},"doc://SwiftML/documentation/SwiftML/MLOpsExport":{"url":"\/documentation\/swiftml\/mlopsexport","title":"Exporting Models to Core ML and ONNX","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","kind":"article","role":"collectionGroup","type":"topic","abstract":[{"text":"Export trained SwiftSci estimators to native Apple Core ML (","type":"text"},{"type":"codeVoice","code":".mlmodel"},{"text":") and cross-platform ONNX (","type":"text"},{"type":"codeVoice","code":".onnx"},{"text":") binary artifacts for production deployment.","type":"text"}]},"doc://SwiftML/documentation/SwiftML/EnsembleLearning":{"url":"\/documentation\/swiftml\/ensemblelearning","title":"Ensemble Learning: Random Forests & Gradient Boosted Trees","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","kind":"article","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism."}]},"doc://SwiftML/documentation/SwiftML/SupervisedRegressors":{"abstract":[{"type":"text","text":"Perform continuous target predictions using LinearRegression (exact OLS), DecisionTreeRegressor, and GradientBoostedTreesRegressor."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","type":"topic","role":"article","url":"\/documentation\/swiftml\/supervisedregressors","title":"Supervised Regression Models","kind":"article"},"doc://SwiftML/documentation/SwiftML/HistTreeNode":{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode","title":"HistTreeNode","navigatorTitle":[{"kind":"identifier","text":"HistTreeNode"}],"type":"topic","abstract":[{"type":"text","text":"A node in a histogram-binned decision tree."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistTreeNode"}],"url":"\/documentation\/swiftml\/histtreenode","role":"symbol"},"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"url":"\/documentation\/swiftml\/supervisedclassi