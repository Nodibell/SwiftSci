{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"metadata":{"title":"High-Dimensional Vector Search with HNSW","modules":[{"name":"SwiftCluster"}],"roleHeading":"API Collection","role":"collectionGroup"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"},"abstract":[{"type":"text","text":"Scale approximate nearest neighbor (ANN) retrieval logarithmically using Hierarchical Navigable Small World graphs."}],"topicSections":[{"anchor":"Spatial-Indexing","title":"Spatial Indexing","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When vector collections expand beyond tens of thousands of items, exact (O(N)) linear scans become a major latency bottleneck for real-time recommendation and retrieval-augmented generation (RAG) systems.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"HNSWIndex","type":"codeVoice"},{"text":" actor provides a hierarchical graph-based spatial partitioning index with sub-millisecond query latency and logarithmic (O(\\log N)) search scaling.","type":"text"}]},{"type":"heading","level":2,"text":"Hierarchical Navigable Small World Architecture","anchor":"Hierarchical-Navigable-Small-World-Architecture"},{"type":"paragraph","inlineContent":[{"text":"HNSW constructs a hierarchy of graph layers:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Top Layers (Sparse)","type":"text"}],"type":"strong"},{"text":": Contain widely spaced long-range highway edges for rapid coarse geometric routing across distant clusters.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Intermediate Layers","type":"text"}],"type":"strong"},{"text":": Progressively decrease edge length while increasing vertex density.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Bottom Layer (Layer 0, Dense)","type":"text"}],"type":"strong"},{"text":": Contains all indexed vertices connected by dense short-range edges for high-accuracy localized nearest-neighbor refinement.","type":"text"}]}]}]},{"type":"codeListing","syntax":null,"code":["Layer 2 (Express):   [A] ───────────────────────────► [F]","                      │                                │","                      ▼                                ▼","Layer 1 (Regional):  [A] ──────────► [C] ────────────► [F]","                      │               │                │","                      ▼               ▼                ▼","Layer 0 (Base):      [A] ──► [B] ──► [C] ──► [D] ──► [E] ──► [F]"]},{"type":"heading","level":2,"text":"Key Configuration Parameters","anchor":"Key-Configuration-Parameters"},{"alignments":["left","left","left"],"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Parameter","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Recommended Default","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Impact on Search Quality & Index Build Time","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"M","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"16","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Maximum outgoing connections per node. Higher values improve recall at the cost of higher memory and index construction time.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"efConstruction","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"200","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Size of dynamic candidate evaluation queue during insertion. Larger values produce higher-quality graph connectivity.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"efSearch","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"50","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Dynamic queue size during search traversal. Higher values increase search recall towards 100% exact match.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"metric","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Choice of ","type":"text"},{"code":".euclideanDistance","type":"codeVoice"},{"text":", ","type":"text"},{"code":".cosineSimilarity","type":"codeVoice"},{"text":", or ","type":"text"},{"code":".dotProduct","type":"codeVoice"},{"text":".","type":"text"}]}]]],"header":"row"},{"type":"heading","level":2,"text":"Example Usage","anchor":"Example-Usage"},{"type":"codeListing","syntax":"swift","code":["import SwiftCluster","","\/\/ 1. Initialize the actor-isolated index","let hnsw = HNSWIndex(metric: .cosineSimilarity, M: 16, efConstruction: 200, efSearch: 50)","","\/\/ 2. Add embeddings asynchronously","await hnsw.add(id: \"doc_news_1\", vector: [0.12, 0.94, -0.31], metadata: [\"category\": \"news\"])","await hnsw.add(id: \"doc_tech_2\", vector: [-0.85, 0.11, 0.52], metadata: [\"category\": \"technology\"])","","\/\/ 3. Query Top-K nearest neighbors","let queryEmbedding = [0.10, 0.90, -0.30]","let matches = await hnsw.search(query: queryEmbedding, topK: 5)","","for match in matches {","    print(\"Matched: \\(match.id) with score: \\(match.score)\")","}"]},{"type":"heading","level":2,"text":"Thread Safety & Swift 6 Strict Concurrency","anchor":"Thread-Safety--Swift-6-Strict-Concurrency"},{"type":"paragraph","inlineContent":[{"code":"HNSWIndex","type":"codeVoice"},{"text":" is implemented as an isolated Swift ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":", guaranteeing thread safety and eliminating race conditions when multiple background tasks insert items or execute queries concurrently.","type":"text"}]}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/swiftcluster\/hnswvectorsearch"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftCluster/documentation/SwiftCluster/VectorStore":{"title":"VectorStore","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","url":"\/documentation\/swiftcluster\/vectorstore","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorStore","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"VectorStore"}],"abstract":[{"type":"text","text":"An in-memory vector database and similarity search index optimized for Apple Silicon."}],"kind":"symbol"},"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","role":"article","abstract":[{"text":"Reduce feature dimensionality using SVD-based PCA with automatic CPU and UMA GPU routing.","type":"text"}],"kind":"article","title":"Principal Component Analysis (PCA)","url":"\/documentation\/swiftcluster\/dimensionalityreduction","type":"topic"},"doc://SwiftCluster/documentation/SwiftCluster/VectorSearchResult":{"title":"VectorSearchResult","url":"\/documentation\/swiftcluster\/vectorsearchresult","abstract":[{"type":"text","text":"Represen