{"abstract":[{"type":"text","text":"Parse GGUF and SafeTensors model weights zero-copy into Apple Silicon unified memory and sample tokens with fine-grained logits controls."}],"kind":"article","identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","interfaceLanguage":"swift"},"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftLLM"}],"roleHeading":"API Collection","title":"GGUF\/SafeTensors Parsing & Sampling"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"topicSections":[{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/GGUFParser","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SafeTensorsParser","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedTensor","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedLayoutMetadata"],"title":"Weight Parsers & Representations","anchor":"Weight-Parsers--Representations"},{"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies"],"title":"Sampling & Decoding","anchor":"Sampling--Decoding"}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"title":"Guides & Tutorials","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"text":" provides high-throughput binary weight parsers that map model weights directly into unified memory (UMA) without intermediate memory allocations, paired with a robust token sampling pipeline operating strictly on unnormalized logits.","type":"text"}]},{"type":"thematicBreak"},{"text":"1. GGUF Zero-Copy Weight Parsing","type":"heading","level":2,"anchor":"1-GGUF-Zero-Copy-Weight-Parsing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"GGUFParser"},{"type":"text","text":" decodes GGUF header metadata and extracts tensor blocks into semantic "},{"type":"codeVoice","code":"QuantizedTensor"},{"type":"text","text":" representations without eager dequantization into full floating-point arrays:"}]},{"type":"codeListing","code":["import Foundation","import SwiftLLM","","let modelURL = URL(fileURLWithPath: \"models\/llama-3-8b-instruct.Q4_0.gguf\")","","\/\/ 1. Parse GGUF weights into QuantizedTensor map","let weights: [String: QuantizedTensor] = try GGUFParser.parse(url: modelURL)","","\/\/ 2. Inspect parsed tensor metadata","if let attnWeight = weights[\"blk.0.attn_q.weight\"] {","    print(\"Tensor name: \\(attnWeight.name)\")","    print(\"Shape: \\(attnWeight.shape)\")","    print(\"Scheme: \\(String(describing: attnWeight.scheme))\") \/\/ .q4_0","    print(\"Block Size: \\(attnWeight.layoutMetadata.blockSize)\") \/\/ 32","}","","\/\/ 3. Extract separated packed weight and scale buffers for Metal GEMV","if let (packedWeights, scales) = weights[\"blk.0.attn_q.weight\"]?.extractSeparatedBuffers() {","    print(\"Extracted \\(packedWeights.count) weight bytes and \\(scales.count) scale bytes.\")","}"],"syntax":"swift"},{"type":"thematicBreak"},{"text":"2. SafeTensors Zero-Copy Weight Parsing","type":"heading","level":2,"anchor":"2-SafeTensors-Zero-Copy-Weight-Parsing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SafeTensorsParser"},{"type":"text","text":" parses JSON header descriptors and maps FP16\/FP32\/BF16 tensor payloads directly into "},{"type":"codeVoice","code":"MLXArray"},{"type":"text","text":" instances:"}]},{"type":"codeListing","code":["import Foundation","import SwiftLLM","import MLX","","let safeURL = URL(fileURLWithPath: \"models\/model.safetensors\")","","\/\/ Parse SafeTensors into native MLX tensor dictionary","let tensors: [String: MLXArray] = try SafeTensorsParser.parse(url: safeURL)","","for (tensorName, array) in tensors {","    print(\"Loaded tensor '\\(tensorName)': shape=\\(array.shape), dtype=\\(array.dtype)\")","}"],"syntax":"swift"},{"type":"thematicBreak"},{"text":"3. Token Sampling with SamplingConfiguration","type":"heading","level":2,"anchor":"3-Token-Sampling-with-SamplingConfiguration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After computing next-token logits from "},{"code":"TransformerDecoder.forward","type":"codeVoice"},{"text":", token selection is governed by ","type":"text"},{"code":"SamplingConfiguration","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftLLM","import MLX","","\/\/ 1. Define generation parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","let pastTokens = [128000, 791, 7453, 374]","let nextLogits: MLXArray = ... \/\/ Shape [vocab_size] from decoder.forward","","\/\/ 2. Sample next token ID applying penalty, temperature, top-k, and top-p","let nextToken = Sampler.sample(","    logits: nextLogits,","    config: sampling,","    pastTokens: pastTokens",")","","print(\"Sampled next token ID: \\(nextToken)\")"]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"For detailed mathematical formulations of repetition penalty, temperature scaling, top-k truncation, and nucleus (top-p) masking, see ","type":"text"},{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"type":"thematicBreak"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/weightparsingandsampling"]}],"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"references":{"doc://SwiftLLM/documentation/SwiftLLM/QuantizedTensor":{"navigatorTitle":[{"text":"QuantizedTensor","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swiftllm\/quantizedtensor","role":"symbol","abstract":[{"type":"text","text":"A semantic representation of a parsed tensor preserving raw quantized layout without eager dequantization."}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedTensor","title":"QuantizedTensor","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"QuantizedTensor","kind":"identifier"}]},"doc://SwiftLLM/documentation/SwiftLLM/GGUFParser":{"abstract":[{"text":"Parser for the GGUF (GGML Unified Format) file format.","type":"text"},{"text":" ","type":"text"},{"text":"Decodes the metadata headers and maps the binary tensor blocks directly into MLXArrays.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/GGUFParser","title":"GGUFParser","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GGUFParser","kind":"identifier"}],"navigatorTitle":[{"text":"GGUFParser","kind":"identifier"}],"role":"symbol","type":"topic","url":"\/documentation\/swiftllm\/ggufparser"},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoderInference":{"kind":"article","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","role":"collectionGroup","title":"Autoregressive Transformer Decoder Inference","url":"\/documentation\/swiftllm\/transformerdecoderinference","abstract":[{"type":"text","text":"Execute two-stage autoregressive generation with full prompt prefill and incremental single-token decoding using Apple Silicon KV-caching."}],"type":"topic"},"doc://SwiftLLM/documentation