{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings"},"topicSections":[{"anchor":"Embedding-Engine-Types","title":"Embedding Engine Types","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"]},{"anchor":"Zero-Shot-Classification","title":"Zero-Shot Classification","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotClassificationResult"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/denselocalembeddings"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Modern Retrieval-Augmented Generation (RAG), semantic vector search, and automated data categorization require fast, high-quality vector representations of text. ","type":"text"},{"type":"codeVoice","code":"SwiftNLP"},{"text":" provides a unified architecture via ","type":"text"},{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider","type":"reference","isActive":true},{"text":", offering two distinct engine implementations:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","isActive":true}]},{"type":"text","text":": Native 512-dimensional contextual semantic embeddings powered by Apple Natural Language and Core ML foundation models with Accelerate $L_2$ unit normalization."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","isActive":true}]},{"type":"text","text":": Deterministic, lightweight subword N-gram hashing projection producing customizable $D$-dimensional embeddings in microseconds with zero disk weight."}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"Both engines integrate seamlessly with ","type":"text"},{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","type":"reference","isActive":true},{"text":" for zero-shot text categorization and ","type":"text"},{"type":"codeVoice","code":"SwiftCluster.VectorStore"},{"text":" for real-time similarity search.","type":"text"}],"type":"paragraph"},{"code":["graph TD","    Text[Raw Text \/ Document] --> Provider[SentenceEmbeddingProvider]","    Provider --> Apple[AppleSentenceEmbeddingEngine: 512-D Core ML]","    Provider --> Hash[LocalEmbeddingEngine: Subword N-Gram Projection]","    Apple --> SIMDNorm[Accelerate vDSP L2 Unit Normalization]","    Hash --> SIMDNorm","    SIMDNorm --> NormalizedVec[Unit Vector: ||v|| = 1.0]","    NormalizedVec --> VectorStore[(SwiftCluster VectorStore \/ HNSW)]","    NormalizedVec --> ZeroShot[ZeroShotTextClassifier Softmax Probabilities]"],"syntax":"mermaid","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"1. Choosing an Embedding Engine","type":"heading","anchor":"1-Choosing-an-Embedding-Engine"},{"alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppleSentenceEmbeddingEngine"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalEmbeddingEngine"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Underlying Mechanism"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Apple Natural Language \/ Core ML"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Subword N-Gram Hashing (FNV-1a + Signs)"}]}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Embedding Dimension"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fixed 512-D"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Configurable (e.g., 64, 128, 256, 512)"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Weights on Disk"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"0 MB (pre-installed system foundation model)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0 MB (algorithmic hash projection)"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Semantic Awareness"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"High (contextual, synonym & paraphrase aware)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lexical \/ Syntactic (spelling, morphology, keyword)"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Typical Latency","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"~0.5 – 1.5 ms \/ text","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"~0.05 – 0.15 ms \/ text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Best Used For"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"RAG retrieval, zero-shot classification, semantic search"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"High-throughput deduplication, fuzzy search, microcontrollers"}]}]]],"type":"table","header":"row"},{"type":"thematicBreak"},{"level":2,"text":"2. Using `AppleSentenceEmbeddingEngine`","type":"heading","anchor":"2-Using-AppleSentenceEmbeddingEngine"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","isActive":true},{"type":"text","text":" leverages Apple Silicon’s Neural Engine to produce 512-dimensional contextual embeddings. All output vectors are automatically normalized to unit length ($|v|_2 = 1.0$) using Accelerate SIMD operations ("},{"type":"codeVoice","code":"vDSP_svesqD"},{"type":"text","text":" and "},{"type":"codeVoice","code":"vDSP_vsdivD"},{"type":"text","text":"):"}],"type":"paragraph"},{"code":["import SwiftNLP","","\/\/ Initialize native Apple sentence embedder","let engine = AppleSentenceEmbeddingEngine()","","\/\/ Verify availability for current device and locale","guard engine.isAvailable(for: .english) else {","    fatalError(\"Apple sentence embedding model not available for English on this system.\")","}","","\/\/ Generate a 512-dimensional embedding","let embedding = try await engine.embed(\"Retrieval-Augmented Generation with SwiftSci\")","print(\"Vector length: \\(embedding.count)\") \/\/ 512","","\/\/ Batch asynchronous embedding generation","let documents = [","    \"Apple Accelerate provides vectorized SIMD routines.\",","    \"Metal Performance Shaders accelerate tensor operations.\",","    \"SwiftData provides declarative SQLite persistence.\"","]","let batchVectors = try await engine.embedBatch(documents)"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"3. Using `LocalEmbeddingEngine`","type":"heading","anchor":"3-Using-LocalEmbeddingEngine"},{"inlineContent":[{"type":"text","text":"For memory-constrained environments or extreme throughput requirements, "},{"type":"reference","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","isActive":true},{"type":"text","text":" computes embeddings via subword character n-gram projections without model weights:"}],"type":"paragraph"},{"code":["import SwiftNLP","","\/\/ Initialize with custom dimensionality (default: 128)","let fastEngine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Synchronous and asynchronous embedding","let vector = fastEngine.embed(\"Fast in-memory hashing projection\")","let batch = try await fastEngine.embedBatch([\"Document A\", \"Document B\"])"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"4. Measuring Semantic Similarity","type":"heading","anchor":"4-Measuring-Semantic-Similarity"},{"inlineContent":[{"type":"text","text":"Because all embeddings produced by "},{"type":"codeVoice","code":"SentenceEmbeddingProvider"},{"type":"text","text":" are unit-normalized, the "},{"type":"strong","inlineContent":[{"type":"text","text":"Cosine Similarity"}]},{"type":"text","text":" between two vectors $u$ and $v$ is mathematically identical to their direct "},{"type":"strong","inlineContent":[{"type":"text","text":"Dot Product"}]},{"type":"text","text":":"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"$$\\text{CosineSimilarity}(u, v) = \\frac{u \\cdot v}{|u|_2 |v|_2} = u \\cdot v$$"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Calculate cosine similarity at native memory speeds using Apple Accelerate:"}],"type":"paragraph"},{"code":["import Accelerate","","func cosineSimilarity(_ a: [Double], _ b: [Double]) -> Double {","    guard a.count == b.count, !a.isEmpty else { return 0.0 }","    var dot: Double = 0.0","    vDSP_dotprD(a, 1, b, 1, &dot, vDSP_Length(a.count))","    return dot","}","","let queryVec = try await engine.embed(\"Vector mathematics on Mac\")","let docVec = try await engine.embed(\"Apple Accelerate linear algebra\")","let similarity = cosineSimilarity(queryVec, docVec)","print(\"Semantic similarity score: \\(similarity)\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"5. Zero-Shot Text Classification","type":"heading","anchor":"5-Zero-Shot-Text-Classification"},{"inlineContent":[{"type":"text","text":"Classify arbitrary text documents into dynamic candidate categories on the fly without training a classifier or labeling training sets:"}],"type":"paragraph"},{"code":["import SwiftNLP","","\/\/ Initialize classifier with Apple embeddings","let classifier = ZeroShotTextClassifier(","    embeddingEngine: AppleSentenceEmbeddingEngine(),","    hypothesisTemplate: \"This text is about {}.\"",")","","\/\/ Single-label classification (Softmax distribution)","let result = try await classifier.classify(","    text: \"The patient presented with elevated systolic pressure and sinus tachycardia.\",","    candidateLabels: [\"Cardiology\", \"Astronomy\", \"Sports\", \"Politics\"],","    multiLabel: false",")","","print(\"Top label: \\(result.topLabel ?? \"\") (confidence: \\(result.topScore))\")","for (label, score) in result.scores {","    print(\"  • \\(label): \\(String(format: \"%.3f\", score))\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Multi-Label Classification","type":"heading","anchor":"Multi-Label-Classification"},{"inlineContent":[{"type":"text","text":"For documents that can belong to multiple categories simultaneously, set "},{"type":"codeVoice","code":"multiLabel: true"},{"type":"text","text":" to compute independent sigmoid activations:"}],"type":"paragraph"},{"code":["let multiResult = try await classifier.classify(","    text: \"Quarterly corporate earnings and federal interest rate decisions.\",","    candidateLabels: [\"Finance\", \"Government\", \"Culinary\", \"Gaming\"],","    multiLabel: true",")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"6. DataFrame Zero-Shot Categorization","type":"heading","anchor":"6-DataFrame-Zero-Shot-Categorization"},{"inlineContent":[{"type":"text","text":"Classify entire columns of tabular data directly within a "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" using "},{"type":"codeVoice","code":"zeroShotClassify"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiftDataFrame","import SwiftNLP","","var feedbackDF = DataFrame(columns: [","    TypedColumn(name: \"FeedbackID\", values: [1, 2, 3]),","    TypedColumn(name: \"ReviewText\", values: [","        \"The app crashed when opening the PDF export screen.\",","        \"Monthly subscription pricing is too expensive.\",","        \"Smooth navigation and beautiful dark mode aesthetics.\"","    ])","])","","\/\/ Classify ReviewText column into sentiment and topic categories","let classifiedDF = try await feedbackDF.zeroShotClassify(","    textColumn: \"ReviewText\",","    candidateLabels: [\"Bug Report\", \"Pricing\", \"User Interface\"],","    outputColumn: \"Category\"",")","","print(classifiedDF.summary())"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"}]}],"kind":"article","metadata":{"title":"Dense Local Text Embeddings & Zero-Shot Classification","roleHeading":"API Collection","modules":[{"name":"SwiftNLP"}],"role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon and perform zero-shot classification without model training.","type":"text"}],"sections":[],"references":{"doc://SwiftNLP/documentation/SwiftNLP/ZeroShotClassificationResult":{"abstract":[{"type":"text","text":"The output of a zero-shot text classification inference."}],"role":"symbol","url":"\/documentation\/swiftnlp\/zeroshotclassificationresult","title":"ZeroShotClassificationResult","navigatorTitle":[{"text":"ZeroShotClassificationResult","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZeroShotClassificationResult","kind":"identifier"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotClassificationResult"},"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LocalEmbeddingEngine","kind":"identifier"}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","kind":"symbol","navigatorTitle":[{"text":"LocalEmbeddingEngine","kind":"identifier"}],"title":"LocalEmbeddingEngine","role":"symbol","type":"topic","url":"\/documentation\/swiftnlp\/localembeddingengine","abstract":[{"text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon.","type":"text"}]},"doc://SwiftNLP/documentation/SwiftNLP":{"role":"collection","kind":"symbol","url":"\/documentation\/swiftnlp","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","title":"SwiftNLP","type":"topic"},"doc://SwiftNLP/documentation/SwiftNLP/AppleSentenceEmbeddingEngine":{"title":"AppleSentenceEmbeddingEngine","role":"symbol","navigatorTitle":[{"text":"AppleSentenceEmbeddingEngine","kind":"identifier"}],"abstract":[{"type":"text","text":"A sentence embedding generator powered by Apple’s native pre-trained "},{"type":"codeVoice","code":"NLEmbedding"},{"type":"text","text":" models."}],"url":"\/documentation\/swiftnlp\/applesentenceembeddingengine","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/AppleSentenceEmbeddingEngine","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AppleSentenceEmbeddingEngine","kind":"identifier"}]},"doc://SwiftNLP/documentation/SwiftNLP/SentenceEmbeddingProvider":{"title":"SentenceEmbeddingProvider","role":"symbol","navigatorTitle":[{"text":"SentenceEmbeddingProvider","kind":"identifier"}],"abstract":[{"type":"text","text":"A protocol representing a local or model-based sentence embedding generator."}],"url":"\/documentation\/swiftnlp\/sentenceembeddingprovider","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/SentenceEmbeddingProvider","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SentenceEmbeddingProvider","kind":"identifier"}]},"doc://SwiftNLP/documentation/SwiftNLP/ZeroShotTextClassifier":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/ZeroShotTextClassifier","title":"ZeroShotTextClassifier","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZeroShotTextClassifier","kind":"identifier"}],"navigatorTitle":[{"text":"ZeroShotTextClassifier","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A zero-shot text classifier that categorizes text into arbitrary classes without task-specific training."}],"url":"\/documentation\/swiftnlp\/zeroshottextclassifier"}}}