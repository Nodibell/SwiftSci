{"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross-validation and multi-class classification workflows are embarrassingly parallel: each fold split and one-vs-rest binary sub-problem operates on independent slices of tabular data."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftOptimize"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SwiftML"},{"type":"text","text":" leverage structured Swift Concurrency ("},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"type":"text","text":") to dispatch multiple fold and class estimators concurrently."}]},{"type":"heading","level":2,"anchor":"Structured-Concurrency-Pipeline","text":"Structured Concurrency Pipeline"},{"type":"codeListing","syntax":null,"code":["           Input Dataset [Features, Targets]","                          │","       ┌──────────────────┴──────────────────┐","       ▼                                     ▼"," Fold 1 Split (Task 1)                 Fold 2 Split (Task 2)","   ├─ Fit Candidate                      ├─ Fit Candidate","   └─ Compute Metric                     └─ Compute Metric","       │                                     │","       └──────────────────┬──────────────────┘","                          ▼","            withThrowingTaskGroup Aggregator","                          ▼","         Cross-Validation Average Leaderboard"]},{"type":"heading","level":3,"anchor":"Cooperative-Cancellation--Bounded-Budgets","text":"Cooperative Cancellation & Bounded Budgets"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When training under a time budget (such as "},{"type":"codeVoice","code":"AutoML(timeBudgetSeconds:)"},{"type":"text","text":"), tasks run inside a managed scope. If the time budget expires or a fatal error occurs in a critical pipeline step, child tasks cooperatively respect task cancellation without leaking threads or memory."}]},{"type":"heading","level":3,"anchor":"Deterministic-Class-Ordering","text":"Deterministic Class Ordering"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"OneVsRestClassifier"},{"type":"text","text":", binary classification estimators are dispatched concurrently to maximize throughput across cores. Results are tagged with their class index "},{"type":"codeVoice","code":"(c, est)"},{"type":"text","text":" and sorted prior to storage, ensuring 100% deterministic prediction ordering across runs."}]},{"type":"heading","level":2,"anchor":"Example-Usage","text":"Example Usage"},{"type":"codeListing","syntax":"swift","code":["import SwiftOptimize","import SwiftML","","\/\/ 1. Concurrent AutoML search across DecisionTree, RandomForest, and MLP","let automl = AutoML(timeBudgetSeconds: 30.0)","let report = try await automl.fit(features: X, targets: y)","print(\"Winning Model: \\(report.bestModel)\")","","\/\/ 2. Parallel One-Vs-Rest classification","let ovr = OneVsRestClassifier(numClasses: 5)","try await ovr.fit(features: X, targets: y)","let predictions = try await ovr.predict(features: X_test)"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection"},"abstract":[{"type":"text","text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency "},{"type":"codeVoice","code":"TaskGroup"},{"type":"text","text":" primitives."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftoptimize\/parallelmodelselection"]}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"topicSections":[{"title":"Optimization & Search","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoML","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLStrategy","d