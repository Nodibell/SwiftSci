{"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Apple Silicon features a ","type":"text"},{"inlineContent":[{"text":"Unified Memory Architecture (UMA)","type":"text"}],"type":"strong"},{"text":" where the CPU, GPU, and Apple Neural Engine (ANE) share a single high-bandwidth memory pool. ","type":"text"},{"type":"codeVoice","code":"SwiftPreprocessing"},{"text":" provides intelligent hardware routing and memory reservation primitives to prevent GPU saturation and avoid data copying.","type":"text"}]},{"type":"heading","text":"1. The Hardware Router","level":2,"anchor":"1-The-Hardware-Router"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"HardwareRouter"},{"text":" assesses tensor dimensions and operation complexity to select the optimal computing engine:","type":"text"}]},{"type":"codeListing","code":["graph TD","    Op[Compute Operation] --> Router{HardwareRouter}","    Router -->|Small \/ Vector < 50k| CPU[Accelerate \/ AMX \/ NEON]","    Router -->|Large Matrix \/ Autodiff| GPU[MLX Metal GPU]","    Router -->|Static Inference| ANE[Core ML Engine]"],"syntax":"mermaid"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Small Vectors (","type":"text"},{"code":"N < 50,000","type":"codeVoice"},{"text":")","type":"text"}]},{"text":": Routed to CPU Accelerate (vDSP\/BLAS\/LAPACK) to eliminate GPU kernel dispatch latency.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Large Tensors & Deep Learning","type":"text"}]},{"text":": Routed to MLX Metal GPU for massive parallel throughput.","type":"text"}]}]}]},{"type":"heading","text":"2. WiredMemoryManager & Ticket System","level":2,"anchor":"2-WiredMemoryManager--Ticket-System"},{"type":"paragraph","inlineContent":[{"text":"To prevent out-of-memory (OOM) conditions during concurrent analytical workloads, ","type":"text"},{"type":"codeVoice","code":"WiredMemoryManager"},{"text":" implements an asynchronous FIFO reservation system:","type":"text"}]},{"type":"codeListing","code":["import SwiftPreprocessing","","\/\/ Acquire a GPU execution slot","let ticket = try await WiredMemoryManager.shared.reserveMemory(estimatedBytes: 64 * 1024 * 1024)","","\/\/ Execute heavy MLX operations","\/\/ ...","","\/\/ Automatically flushes GPU caches upon completion","await ticket.release()"],"syntax":"swift"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Understand how SwiftSci automatically routes workloads between CPU (Accelerate\/AMX\/NEON) and Metal GPU (MLX) with strict concurrency safety."}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"metadata":{"modules":[{"name":"SwiftPreprocessing"}],"title":"Hardware Routing & Unified Memory Governance","role":"collectionGroup","roleHeading":"API Collection"},"sections":[],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouterAndMemory","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Memory--Routing-APIs","title":"Memory & Routing APIs","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket"]}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/hardwarerouterandmemory"]}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/HardwareRouter":{"url":"\/documentation\/swiftpreprocessing\/hardwarerouter","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"HardwareRouter"}],"abstract":[{"text":"Serializes device selection and MLX default-device changes (global MLX state).","type":"text"}],"title":"HardwareRouter","navigatorTitle":[{"text":"HardwareRouter","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryTicket":{"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WiredMemoryTicket","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swiftpreprocessing\/wiredmemoryticket","title":"WiredMemoryTicket","abstract":[{"text":"A ticket representing a reservation of memory and a concurrency slot.","type":"text"}],"navigatorTitle":[{"text":"WiredMemoryTicket","kind":"identifier"}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryManager":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WiredMemoryManager","kind":"identifier"}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","abstract":[{"type":"text","text":"Actor-based manager that controls concurrent allocations and tasks in Apple Silicon Unified Memory."}],"navigatorTitle":[{"text":"WiredMemoryManager","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","title":"WiredMemoryManager","url":"\/documentation\/swiftpreprocessing\/wiredmemorymanager"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"abstract":[{"text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","role":"collection","url":"\/documentation\/swiftpreprocessing","type":"topic","title":"SwiftPreprocessing"}}}