{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/agenticreplandrag"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftAgent"}],"title":"Safe Swift REPL & RAG Context Generator","role":"collectionGroup"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgenticReplAndRAG"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Autonomous AI data analyst agents require two core capabilities when interacting with private local data:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Sandboxed Code & Command Execution","type":"text"}],"type":"strong"},{"text":": Safely filtering, grouping, projecting, and transforming tabular datasets without executing arbitrary unvetted shell scripts or system processes.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Token-Efficient Context Summarization","type":"text"}],"type":"strong"},{"text":": Compressing high-dimensional tables into structured, dense Markdown schema summaries that fit comfortably within LLM context windows.","type":"text"}]}]}]},{"inlineContent":[{"code":"SwiftAgent","type":"codeVoice"},{"text":" provides ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator","isActive":true,"type":"reference"},{"text":" to bridge on-device large language models (","type":"text"},{"code":"SwiftLLM","type":"codeVoice"},{"text":") with the native performance of ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["graph TD","    UserQuery[User Analytics Query] --> LLM[Local LLM Agent \/ ReAct Engine]","    DF[(SwiftDataFrame In-Memory Table)] --> RAGGen[RAGContextGenerator]","    RAGGen --> PromptCtx[Markdown Dataset Profile]","    PromptCtx --> LLM","    LLM --> DSLCommand[Generated DSL Command e.g. 'filter age > 30']","    DSLCommand --> Evaluator[SwiftAgentEvaluator Actor]","    DF --> Evaluator","    Evaluator --> TransformedDF[Transformed DataFrame Output]","    Evaluator --> LineageRecord[Lineage Record Audit Trail]","    TransformedDF --> LLMResponse[Agent Synthesizes Final Answer]"],"type":"codeListing","syntax":"mermaid"},{"type":"thematicBreak"},{"anchor":"1-Sandboxed-REPL--DSL-Command-Evaluation","level":2,"text":"1. Sandboxed REPL & DSL Command Evaluation","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","isActive":true,"type":"reference"},{"text":" is an actor-isolated engine that parses and executes high-level DSL commands on a ","type":"text"},{"code":"DataFrame","type":"codeVoice"},{"text":". Unlike raw interpreter bridges, it evaluates operations through a strongly typed AST (Abstract Syntax Tree), ensuring that memory safety, thread isolation, and data invariants are strictly preserved.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Supported DSL Operations","type":"heading","anchor":"Supported-DSL-Operations"},{"header":"row","type":"table","alignments":["left","left","left","left"],"rows":[[[{"inlineContent":[{"text":"Command Pattern","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Example Expression","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"AST Case","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Filter","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"filter Age > 30.0\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".filter(column, condition)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Evaluates scalar thresholds (","type":"text"},{"code":">","type":"codeVoice"},{"text":", ","type":"text"},{"code":"<","type":"codeVoice"},{"text":", ","type":"text"},{"code":">=","type":"codeVoice"},{"text":", ","type":"text"},{"code":"<=","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"=="},{"text":", ","type":"text"},{"code":"!=","type":"codeVoice"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Select","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"select Product, Price\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".select(columns)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Projects specific column subsets.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"GroupBy","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"groupby Category mean Price\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".groupBy(column, agg, target)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Computes aggregations (","type":"text"},{"code":"mean","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"min","type":"codeVoice"},{"text":", ","type":"text"},{"code":"max","type":"codeVoice"},{"text":", ","type":"text"},{"code":"count","type":"codeVoice"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Sample","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"sample 50\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".sample(n)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Randomly samples rows deterministically.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Head \/ Tail","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"head 10\"","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"\"tail 5\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".head(n)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".tail(n)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Slices initial or trailing records.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Null Handling","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"\"dropNulls\"","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"\"fillNulls Fare 0.0\"","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":".dropNulls","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".fillNulls","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cleans or imputes missing scalar entries.","type":"text"}]}]]]},{"level":3,"text":"Execution Example","type":"heading","anchor":"Execution-Example"},{"code":["import Foundation","import SwiftDataFrame","import SwiftAgent","","\/\/ 1. Initialize DataFrame","let rawDF = DataFrame(columns: [","    TypedColumn(name: \"Department\", values: [\"Sales\", \"Engineering\", \"Sales\", \"Support\", \"Engineering\"]),","    TypedColumn(name: \"Salary\", values: [75000.0, 120000.0, 82000.0, 58000.0, 135000.0]),","    TypedColumn(name: \"TenureYears\", values: [3, 5, 4, 1, 7])","])","","\/\/ 2. Initialize actor evaluator","let evaluator = SwiftAgentEvaluator()","","\/\/ 3. Execute sandboxed transformations","let highEarners = try await evaluator.evaluate(","    command: \"filter Salary >= 80000.0\",","    on: rawDF",")","","let departmentSummary = try await evaluator.evaluate(","    command: \"groupby Department mean Salary\",","    on: highEarners",")","","print(departmentSummary.summary())"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"level":2,"text":"2. Lineage Tracking & Immutable Audit Trails","type":"heading","anchor":"2-Lineage-Tracking--Immutable-Audit-Trails"},{"inlineContent":[{"type":"text","text":"When autonomous agents transform datasets over iterative multi-turn dialogues, tracking the provenance and step-by-step delta of the data is critical for compliance and verification."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"},{"type":"text","text":" automatically captures each successful transformation as an immutable "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ Inspect the execution trajectory","let auditTrail = await evaluator.lineage","","for record in auditTrail {","    print(\"\"\"","    [Step \\(record.stepIndex)] \\(record.operation)","      • Rows: \\(record.inputRows) -> \\(record.outputRows)","      • Executed At: \\(record.timestamp)","    \"\"\")","}","","\/\/ Reset trajectory between separate user tasks","await evaluator.clearLineage()"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"level":2,"text":"3. Tabular RAG Context Summarization","type":"heading","anchor":"3-Tabular-RAG-Context-Summarization"},{"inlineContent":[{"type":"text","text":"Large datasets cannot be pasted verbatim into an LLM context window without incurring prohibitive attention computation and context exhaustion. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator"},{"type":"text","text":" extracts metadata, column typings, and dimensional boundaries to produce token-efficient Markdown profiles for prompt injection:"}],"type":"paragraph"},{"code":["let contextGen = RAGContextGenerator()","let markdownProfile = contextGen.generateSummary(df: rawDF, name: \"EmployeePayroll\")","","print(markdownProfile)","\/\/ Output:","\/\/ ## EmployeePayroll Profile","\/\/ - Rows: 5, Columns: 3","\/\/ - Columns: Department, Salary, TenureYears"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Inject this profile directly into your system prompt so the language model understands available columns and schema constraints before generating transformation instructions."}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"text":"4. End-to-End LLM Function Calling & ReAct Integration","type":"heading","anchor":"4-End-to-End-LLM-Function-Calling--ReAct-Integration"},{"inlineContent":[{"type":"text","text":"Combine "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" to construct an autonomous tabular analyst:"}],"type":"paragraph"},{"code":["import SwiftAgent","import SwiftDataFrame","","public struct TabularAnalystTool: Sendable {","    private let evaluator: SwiftAgentEvaluator","    private var currentDataFrame: DataFrame","","    public init(df: DataFrame) {","        self.evaluator = SwiftAgentEvaluator()","        self.currentDataFrame = df","    }","","    \/\/\/ Tool invocation callback conforming to ReActAgent tool schema","    public mutating func execute(command: String) async throws -> String {","        let transformed = try await evaluator.evaluate(command: command, on: currentDataFrame)","        self.currentDataFrame = transformed","        return \"Command succeeded. Result dimensions: \\(transformed.rowCount) rows x \\(transformed.columnNames.count) columns.\"","    }","","    public func datasetContext() -> String {","        RAGContextGenerator().generateSummary(df: currentDataFrame, name: \"ActiveWorkspace\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"level":2,"text":"5. Safe Error Handling & Guardrails","type":"heading","anchor":"5-Safe-Error-Handling--Guardrails"},{"inlineContent":[{"type":"text","text":"The evaluation sandbox rejects unparseable strings, missing columns, or type mismatches early, throwing structured "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentError"},{"type":"text","text":" instances:"}],"type":"paragraph"},{"code":["do {","    let result = try await evaluator.evaluate(command: \"filter NonExistentCol > 10\", on: rawDF)","} catch let AgentError.unparseable(cmd) {","    print(\"Agent emitted an invalid DSL syntax: \\(cmd)\")","} catch let AgentError.executionFailed(reason) {","    print(\"Execution rejected: \\(reason)\")","} catch {","    print(\"Unexpected error: \\(error)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration"],"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"abstract":[{"text":"Execute dynamic Swift expressions in a sandboxed evaluation engine, trace immutable lineage audit trails, and summarize tabular DataFrame context for local LLM agents.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentError","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentCommand"],"anchor":"Agent-Components","title":"Agent Components"}],"kind":"article","references":{"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","title":"SwiftAgentEvaluator","abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SwiftAgentEvaluator"}],"url":"\/documentation\/swiftagent\/swiftagentevaluator","type":"topic","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SwiftAgentEvaluator"}]},"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"navigatorTitle":[{"kind":"identifier","text":"LineageRecord"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LineageRecord"}],"abstract":[{"text":"Represents an immutable audit trail entry recording a discrete data transformation step.","type":"text"}],"url":"\/documentation\/swiftagent\/lineagerecord","title":"LineageRecord"},"doc://SwiftAgent/documentation/SwiftAgent/AgentCommand":{"role":"symbol","navigatorTitle":[{"text":"AgentCommand","kind":"identifier"}],"title":"AgentCommand","abstract":[{"text":"Structured Agent AST representation for sandboxed execution.","type":"text"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentCommand","kind":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AgentCommand","kind":"identifier"}],"url":"\/documentation\/swiftagent\/agentcommand"},"doc://SwiftAgent/documentation/SwiftAgent":{"role":"collection","title":"SwiftAgent","abstract":[{"text":"Agentic REPL Execution Sandbox & RAG Summary Engine.","type":"text"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","kind":"symbol","type":"topic","url":"\/documentation\/swiftagent"},"doc://SwiftAgent/documentation/SwiftAgent/AgentError":{"navigatorTitle":[{"text":"AgentError","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentError","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AgentError"}],"abstract":[{"text":"Errors thrown by SwiftAgent evaluation sandbox.","type":"text"}],"title":"AgentError","url":"\/documentation\/swiftagent\/agenterror"},"doc://SwiftAgent/documentation/SwiftAgent/MultiAgentCollaboration":{"role":"collectionGroup","url":"\/documentation\/swiftagent\/multiagentcollaboration","type":"topic","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration","title":"Multi-Agent Coordination & Protocols","abstract":[{"text":"Orchestrate teams of specialized autonomous agents over an asynchronous message bus with concurrent parallel tool calling.","type":"text"}],"kind":"article"},"doc://SwiftAgent/documentation/SwiftAgent/RAGContextGenerator":{"navigatorTitle":[{"kind":"identifier","text":"RAGContextGenerator"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGContextGenerator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RAGContextGenerator"}],"abstract":[{"text":"RAG Context summary generator for dataframes.","type":"text"}],"url":"\/documentation\/swiftagent\/ragcontextgenerator","title":"RAGContextGenerator"}}}