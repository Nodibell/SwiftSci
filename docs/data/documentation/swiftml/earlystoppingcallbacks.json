{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/earlystoppingcallbacks"]}],"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"abstract":[{"type":"text","text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting."}],"metadata":{"role":"collectionGroup","title":"Early Stopping & Generalization Control","roleHeading":"API Collection","modules":[{"name":"SwiftML"}]},"topicSections":[{"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStopping","doc:\/\/SwiftML\/documentation\/SwiftML\/MetricDirection"],"anchor":"Training-Callbacks","title":"Training Callbacks"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Iterative estimators like multi-layer perceptrons ("},{"type":"codeVoice","code":"MLPClassifier"},{"type":"text","text":", "},{"type":"codeVoice","code":"MLPRegressor"},{"type":"text","text":") and gradient boosted decision trees ("},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"type":"text","text":") improve their training loss over successive iterations. However, after sufficient capacity has been fit, additional epochs frequently lead to overfitting on training noise and deteriorating generalization on unseen data."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EarlyStopping"},{"type":"text","text":" provides a decoupled, value-type training callback that monitors validation loss or performance metrics across successive epochs, halting training and optionally restoring optimal model weights."}]},{"type":"heading","level":2,"anchor":"Mechanics--State-Machine","text":"Mechanics & State Machine"},{"type":"codeListing","code":["Epoch Evaluation (Score S_t)","            │","            ▼"," Is (Best - S_t) > minDelta?","   ├── YES ──► Reset wait = 0, update bestScore = S_t, checkpoint weights","   └── NO  ──► Increment wait = wait + 1","                 │","            Is wait >= patience?","              ├── YES ──► shouldStop = true, restore best checkpoint weights","              └── NO  ──► Continue training"],"syntax":null},{"type":"heading","level":3,"anchor":"Configuration-Parameters","text":"Configuration Parameters"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"patience"},{"type":"text","text":": Number of consecutive non-improving evaluations tolerated before triggering an early halt."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"minDelta"},{"type":"text","text":": Minimum absolute improvement required to qualify as progress."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"direction"},{"type":"text","text":": "},{"type":"codeVoice","code":".minimize"},{"type":"text","text":" for loss functions (cross-entropy, MSE) or "},{"type":"codeVoice","code":".maximize"},{"type":"text","text":" for scoring metrics (accuracy, R2, AUC)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"restoreBestWeights"},{"type":"text","text":": When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", automatically restores the model parameters from the epoch that achieved "},{"type":"codeVoice","code":"bestScore"},{"type":"text","text":", avoiding overfit tail iterations."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Example-Usage","text":"Example Usage"},{"type":"codeListing","code":["import SwiftML","","\/\/ 1. Configure early stopping callback","let es = EarlyStopping(","    patience: 5,","    minDelta: 1e-4,","    direction: .minimize,","    restoreBestWeights: true",")","","\/\/ 2. Fit MLP with validation monitoring","let mlp = MLPClassifier(hiddenLayerSizes: [32, 16], maxIter: 200)","try await mlp.fit(","    features: X_train,","    targets: y_train,","    validationFeatures: X_val,","    validationTargets: y_val,","    earlyStopping: es",")"],"syntax":"swift"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks"},"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport"],"generated":true,"title":"Guides & Tutorials"}],"references":{"doc://SwiftML/documentation/SwiftML":{"url":"\/documentation\/swiftml","role":"collection","title":"SwiftML","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"kind":"symbol","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","type":"topic"},"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"title":"Supervised Classification Models","kind":"article","abstract":[{"type":"text","text":"Train classification models using LogisticRegression, DecisionTreeClassifier, RandomForestClassifier, and MLPClassifier."}],"url":"\/documentation\/swiftml\/supervisedclassifiers","role":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","type":"topic"},"doc://SwiftML/documentation/SwiftML/ReproducibilityAndPRNG":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators.","type":"text"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","title":"Reproducibility, Determinism & High-Quality PRNG","kind":"article","url":"\/documentation\/swiftml\/reproducibi