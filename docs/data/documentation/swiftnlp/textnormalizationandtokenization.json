{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies."}],"type":"paragraph"},{"level":3,"text":"1. Multi-lingual Word & Sentence Tokenization","anchor":"1-Multi-lingual-Word--Sentence-Tokenization","type":"heading"},{"syntax":"swift","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"type":"codeListing"},{"level":3,"text":"2. POS Tagging, Lemmatization & Entity Extraction","anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","type":"heading"},{"syntax":"swift","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"type":"codeListing"},{"level":3,"text":"3. Sentiment Analysis (VADER & NLSentiment)","anchor":"3-Sentiment-Analysis-VADER--NLSentiment","type":"heading"},{"syntax":"swift","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native ","type":"text"},{"code":"NaturalLanguage","type":"codeVoice"},{"text":" framework.","type":"text"}],"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"]}],"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Text Normalization, Tokenization & Linguistic Tagging","role":"article","modules":[{"name":"SwiftNLP"}]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization"},"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"kind":"symbol","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"type":"topic","role":"collection","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","url":"\/documentation\/swiftnlp","title":"SwiftNLP"},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"type":"topic","title":"Text Feature Vectorization, Embeddings & Naive Bayes Classification","url":"\/documentation\/swiftnlp\/vectorizationandembeddings","kind":"article","abstract":[{"text":"Convert text corpora into numerical feature matrices using ","type":"text"},{"code":"CountVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Hashin