Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","anchor":"2-Top-K-Semantic-Search","text":"2. Top-K Semantic Search"},{"code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","anchor":"3-Supported-Metrics","text":"3. Supported Metrics"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".cosineSimilarity","type":"codeVoice"}],"type":"strong"},{"text":": Ideal for normalized text embeddings (returns ","type":"text"},{"type":"codeVoice","code":"[-1.0, 1.0]"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".dotProduct","type":"codeVoice"}]},{"text":": Direct inner product for unnormalized projections.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}],"type":"strong"},{"text":": Geometric L2 distance for spatial clustering.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"topicSections":[{"anchor":"Vector-Store-Types","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"],"title":"Vector Store Types"}],"seeAlsoSections":[{"generated":tru