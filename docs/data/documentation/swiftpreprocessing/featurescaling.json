{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Feature scaling is crucial for gradient-based estimators (Neural Networks, Logistic Regression) and distance-based estimators (KNN, DBSCAN, SVM). Without scaling, features with large numeric scales disproportionately dominate distance calculations and gradient updates.","type":"text"}]},{"type":"thematicBreak"},{"text":"⚡ Flat 1D Memory Layout & Hardware Vectorization","type":"heading","level":2,"anchor":"%E2%9A%A1-Flat-1D-Memory-Layout--Hardware-Vectorization"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftPreprocessing"},{"text":" operates on contiguous 1D row-major flat buffers ","type":"text"},{"type":"codeVoice","code":"[Double]"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"[Float]"},{"text":") with stride indexing ","type":"text"},{"type":"codeVoice","code":"index = row * cols + col"},{"text":":","type":"text"}]},{"type":"codeListing","code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"All arithmetic operations (","type":"text"},{"type":"codeVoice","code":"vDSP_vsubD"},{"text":", ","type":"text"},{"type":"codeVoice","code":"vDSP_vsdivD"},{"text":", ","type":"text"},{"type":"codeVoice","code":"vDSP.sort"},{"text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections.","type":"text"}]},{"type":"thematicBreak"},{"text":"1. `StandardScaler` (Z-Score Standardization)","type":"heading","level":2,"anchor":"1-StandardScaler-Z-Score-Standardization"},{"type":"paragraph","inlineContent":[{"text":"Transforms features to have zero mean (","type":"text"},{"type":"codeVoice","code":"μ = 0"},{"text":") and unit variance (","type":"text"},{"type":"codeVoice","code":"σ² = 1"},{"text":"):","type":"text"}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"code":"z = (x - μ) \/ σ","type":"codeVoice"}]}]},{"type":"codeListing","code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"],"syntax":"swift"},{"type":"thematicBreak"},{"text":"2. `MinMaxScaler` (Bounded Range Scaling)","type":"heading","level":2,"anchor":"2-MinMaxScaler-Bounded-Range-Scaling"},{"type":"paragraph","inlineContent":[{"text":"Linearly transforms features into a bounded range ","type":"text"},{"type":"codeVoice","code":"[a, b]"},{"text":" (defaults to ","type":"text"},{"type":"codeVoice","code":"[0, 1]"},{"text":"):","type":"text"}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)","type":"codeVoice"}]}]},{"type":"codeListing","code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"],"syntax":"swift"},{"type":"thematicBreak"},{"text":"3. `RobustScaler` (Median & IQR Scaling)","type":"heading","level":2,"anchor":"3-RobustScaler-Median--IQR-Scaling"},{"type":"paragraph","inlineContent":[{"text":"When datasets contain extreme outliers, mean and standard deviation are distorted. ","type":"text"},{"type":"codeVoice","code":"RobustScaler"},{"text":" scales features using the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Median"}]},{"text":" and ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Interquartile Range (IQR = Q3 - Q1)"}]},{"text":":","type":"text"}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"code":"x' = (x - Median) \/ IQR","type":"codeVoice"}]}]},{"type":"codeListing","code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"],"syntax":"swift"},{"type":"thematicBreak"},{"text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)","type":"heading","level":2,"anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling"},{"type":"paragraph","inlineContent":[{"text":"Scales each sample independently to have unit L1, L2, or Max norm:","type":"text"}]},{"type":"codeListing","code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"],"syntax":"swift"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Memory & Performance Tip:","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"Use "},{"code":"Float","type":"codeVoice"},{"type":"text","text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput."}]}]}]}],"abstract":[{"text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using ","type":"text"},{"type":"codeVoice","code":"StandardScaler"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MinMaxScaler"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RobustScaler"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"Normalizer"},{"text":" powered by Apple Accelerate ","type":"text"},{"type":"codeVoice","code":"vDSP"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"article","modules":[{"name":"SwiftPreprocessing"}],"title":"Feature Scaling, Normalization & Flat 1D Memory","roleHeading":"Article"},"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/featurescaling"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling"},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"seeAlsoSections":[{"generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"],"anchor":"Guides--Tutorials"}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"title":"SwiftPreprocessing","type":"topic","role":"collection","abstract":[{"type":"text","text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines."}],"kind":"symbol","url":"\/documentation\/swiftpreprocessing","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseDataStructures":{"title":"Memory-Efficient Sparse Matrix Representations","type":"topic","role":"collectionGroup","abstract":[{"text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"url":"\/documentation\/swiftpreprocessing\/sparsedatastructures","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","kind":"article"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"title":"Categorical Encoding & Imputation","role":"article","abstract":[{"text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer.","type":"text"}],"kind":"article","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","type":"topic","url":"\/documentation\/swiftpreprocessing\/encodersandimputers"}}}