{"sections":[],"abstract":[{"text":"Transform messy tabular data using type-safe null handling, column casting, pivoting, and deduplication.","type":"text"}],"topicSections":[{"title":"Reshaping APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/unique"],"anchor":"Reshaping-APIs"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Data Cleaning, Pivoting & Reshaping","modules":[{"name":"SwiftDataFrame"}]},"kind":"article","identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataCleaningAndReshaping","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Real-world datasets require extensive preprocessing before model training. "},{"code":"SwiftDataFrame","type":"codeVoice"},{"type":"text","text":" provides declarative, vector-accelerated functions to clean missing data, cast column types, reshape wide\/long representations, and remove duplicates."}]},{"text":"1. Handling Missing Data (Null Imputation)","type":"heading","level":2,"anchor":"1-Handling-Missing-Data-Null-Imputation"},{"type":"codeListing","code":["import SwiftDataFrame","","var df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"temperature\", values: [21.5, nil, 23.0, nil, 25.5]),","    TypedColumn<String>(name: \"station\", values: [\"A\", \"B\", \"A\", nil, \"B\"])","])","","\/\/ Fill null values with a constant or column mean","let filledDF = try df","    .fillNulls(column: \"temperature\", with: 20.0)","    .fillNulls(column: \"station\", with: \"Unknown\")","","\/\/ Drop rows with any null values","let cleanDF = try df.dropNulls()"],"syntax":"swift"},{"text":"2. Long-to-Wide Pivoting & Wide-to-Long Melting","type":"heading","level":2,"anchor":"2-Long-to-Wide-Pivoting--Wide-to-Long-Melting"},{"type":"codeListing","code":["\/\/ Pivot long format table to wide format","let wideDF = try df.pivot(","    index: \"station\",","    columns: \"date\",","    values: \"temperature\",","    aggregate: .mean",")","","\/\/ Melt wide format back to long format","let longDF = try wideDF.melt(","    idVariables: [\"station\"],","    valueVariables: [\"2026-01-01\", \"2026-01-02\"],","    variableColumnName: \"date\",","    valueColumnName: \"temperature\"",")"],"syntax":"swift"},{"text":"3. Deduplication with `DataFrame.unique`","type":"heading","level":2,"anchor":"3-Deduplication-with-DataFrameunique"},{"type":"codeListing","code":["\/\/ Remove identical duplicate rows across all columns","let uniqueDF = df.unique"],"syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftdataframe\/datacleaningandreshaping"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/unique":{"type":"topic","abstract":[{"type":"text","text":"Returns a new "},{"code":"DataFrame","type":"codeVoice"},{"type":"text","text":" containing only unique rows (deduplicated), preserving order of first appearance."}],"title":"unique","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unique","kind":"identifier"},{"text":": ","kind":"text"},{"text":"DataFrame","kind":"typeIdentifier","preciseIdentifier":"s:14SwiftDataFrame0bC0V"}],"url":"\/documentation\/swiftdataframe\/dataframe\/unique","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/unique","role":"symbol"},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"type":"topic","title":"SwiftDataFrame","url":"\/documentation\/swiftdataframe","kind":"symbol","role":"collection","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Ar