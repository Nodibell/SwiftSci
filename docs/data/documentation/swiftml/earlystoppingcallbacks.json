le":"collectionGroup","title":"Fast Tabular Learning with Histogram Gradient Boosting"},"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"type":"topic","url":"\/documentation\/swiftml\/supervisedclassifiers","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","title":"Supervised Classification Models","abstract":[{"text":"Train classification models using LogisticRegression, DecisionTreeClassifier, RandomForestClassifier, and MLPClassifier.","type":"text"}],"role":"article","kind":"article"},"doc://SwiftML/documentation/SwiftML/EarlyStopping":{"abstract":[{"type":"text","text":"A training callback that halts iterative model fitting when validation performance ceases to improve."}],"title":"EarlyStopping","navigatorTitle":[{"text":"EarlyStopping","kind":"identifier"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStopping","type":"topic","url":"\/documentation\/swiftml\/earlystopping","role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EarlyStopping","kind":"identifier"}]}}}