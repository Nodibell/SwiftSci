{"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}]},{"text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory.","type":"text"}]},{"type":"heading","level":2,"text":"1. The Four Shapley Axioms","anchor":"1-The-Four-Shapley-Axioms"},{"type":"paragraph","inlineContent":[{"text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Efficiency"}]},{"type":"text","text":": Feature attributions sum up to the difference between model prediction "},{"code":"f(x)","type":"codeVoice"},{"type":"text","text":" and expected background prediction "},{"code":"E[f(X)]","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}]}],"type":"aside","style":"note"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Symmetry"}]},{"type":"text","text":": If two features contribute equally to all possible feature subsets, their attributions are equal."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dummy (Null Player)"}]},{"type":"text","text":": A feature that does not change the model prediction for any coalition receives an attribution of zero ("},{"code":"φ_i = 0","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Additivity"}]},{"type":"text","text":": For ensemble models "},{"code":"f = f1 + f2","type":"codeVoice"},{"type":"text","text":", attributions satisfy "},{"code":"φ_i(f) = φ_i(f1) + φ_i(f2)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"2. Explaining Predictions in SwiftSci","anchor":"2-Explaining-Predictions-in-SwiftSci"},{"type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/kernelshaptheory"]}],"topicSections":[{"title":"SHAP Explainer APIs","anchor":"SHAP-Explainer-APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"SwiftExplain"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Game-Theoretic Interpretability with Kernel SHAP"},"kind":"article","identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model."}],"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"title":"SwiftExplain","type":"topic","url":"\/documentation\/swiftexplain","role":"collection","kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}]},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","kind":"symbol","title":"KernelSHAP","type":"topic","role":"symbol","url":"\/documentation\/swiftexplain\/kernelshap","abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KernelSHAP","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}]}}}