{"metadata":{"role":"article","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","modules":[{"name":"SwiftDatabase"}],"roleHeading":"Article"},"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/databaseconnectors"]}],"sections":[],"identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","interfaceLanguage":"swift"},"abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 "},{"type":"codeVoice","code":"public actor"},{"type":"text","text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks."}],"type":"paragraph"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"🔒 Driver Architecture & Concurrency Model","anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model"},{"type":"codeListing","syntax":null,"code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Actor Isolation:"}]},{"type":"text","text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Streaming "},{"type":"codeVoice","code":"recv"},{"type":"text","text":" Buffer:"}]},{"type":"text","text":" Network drivers use a 64KB receive buffer reading continuously until "},{"code":"ReadyForQuery ('Z')","type":"codeVoice"},{"type":"text","text":" is received."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication:"}]},{"type":"text","text":" Built-in support for Cleartext and MD5 password authentication via "},{"type":"codeVoice","code":"CommonCrypto"},{"type":"text","text":"."}]}]}]},{"type":"thematicBreak"},{"anchor":"1-Querying-SQLite-Databases--C-Pointer-Lifecycle-Safety","type":"heading","level":2,"text":"1. Querying SQLite Databases & C-Pointer Lifecycle Safety"},{"type":"paragraph","inlineContent":[{"code":"SQLiteConnection","type":"codeVoice"},{"text":" executes SQL statements through native ","type":"text"},{"code":"sqlite3_prepare_v2","type":"codeVoice"},{"type":"text","text":" and directly streams result rows into columnar "},{"type":"codeVoice","code":"TypedColumn"},{"type":"text","text":" buffers with full C-pointer lifecycle safety:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Statement Finalization:"}]},{"type":"text","text":" All prepared statements are guaranteed to be finalized via "},{"code":"defer { if let stmt { sqlite3_finalize(stmt) } }","type":"codeVoice"},{"type":"text","text":", preventing statement pointer leaks during both normal termination and thrown query errors."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resource Cleanup:"}]},{"type":"text","text":" In-memory or file-backed database handles are automatically closed via "},{"type":"codeVoice","code":"sqlite3_close_v2"},{"type":"text","text":" upon deallocation. Callers may also invoke "},{"type":"codeVoice","code":"await sqlite.close()"},{"type":"text","text":" to immediately release operating system locks and memory."}]}]}]},{"code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = SQLiteConnection(databasePath: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)","","\/\/ 3. Explicitly release SQLite database handle when done","await sqlite.close()"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries ("},{"type":"codeVoice","code":"libpq"},{"type":"text","text":"):"}]},{"code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    user: \"postgres\",","    password: \"secure_password\",","    sslMode: .disable",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"3. High-Throughput Bulk Writeback (`toSQL`)","anchor":"3-High-Throughput-Bulk-Writeback-toSQL"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bulk export in-memory "},{"type":"codeVoice","code":"DataFrame"},{"type":"text","text":" objects back into database tables with configurable append, replace, or fail-if-exists modes:"}]},{"code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append, .replace, or .failIfExists","    batchSize: 500",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"],"syntax":"swift","type":"codeListing"}]}],"kind":"article","references":{"doc://SwiftDatabase/documentation/SwiftDatabase/SecurityAndPerformance":{"role":"collectionGroup","kind":"article","url":"\/documentation\/swiftdatabase\/securityandperformance","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","type":"topic","title":"Security & Performance in SwiftDatabase","abstract":[{"type":"text","text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL."}]},"doc://SwiftDatabase/documentation/SwiftDatabase":{"type":"topic","role":"collection","url":"\