{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In machine learning workflows, deterministic reproducibility is vital for auditing, hyperparameter tuning, and regression testing. SwiftSci provides:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Xoshiro256++ Generator","type":"text"}],"type":"strong"},{"type":"text","text":": A modern, high-throughput pseudo-random number generator conforming to standard "},{"code":"RandomNumberGenerator","type":"codeVoice"},{"type":"text","text":" with period $2^{256} - 1$ passing BigCrush."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"randomState","type":"codeVoice"},{"type":"text","text":" Parameter Propagation"}],"type":"strong"},{"text":": Standardized ","type":"text"},{"code":"randomState: Int?","type":"codeVoice"},{"text":" parameters across ensemble estimators (","type":"text"},{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestClassifier","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestRegressor","type":"reference","isActive":true},{"text":") and clustering models (","type":"text"},{"type":"codeVoice","code":"KMeans"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deterministic Parallel Construction"}]},{"text":": Fixed-order tree compilation preserving deterministic tie-breaking even under multi-threaded Swift Concurrency execution (","type":"text"},{"code":"TaskGroup","type":"codeVoice"},{"text":").","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"1-Using-randomState-in-Random-Forests","text":"1. Using `randomState` in Random Forests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass an integer "},{"type":"codeVoice","code":"randomState"},{"type":"text","text":" to ensure identical bootstrapping and split selections across runs:"}]},{"type":"codeListing","code":["import SwiftML","","let rf = try RandomForestClassifier(","    nEstimators: 50,","    maxDepth: 8,","    randomState: 42",")","","try await rf.fit(features: X_train, targets: y_train)","let predictions = try await rf.predict(features: X_test)"],"syntax":"swift"},{"level":2,"type":"heading","text":"2. Low-Level PRNG with `SeededRandom`","anchor":"2-Low-Level-PRNG-with-SeededRandom"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftPreprocessing"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"SeededRandom"},{"type":"text","text":", backed by Xoshiro256++ and SplitMix64 initialization:"}]},{"type":"codeListing","code":["import SwiftPreprocessing","","var rng = SeededRandom(seed: 12345)","let randomValue = rng.nextDouble() \/\/ in [0, 1)","let randomIndex = rng.nextInt(upperBound: 100)","","\/\/ Conforms to Swift's standard RandomNumberGenerator","var items = [1, 2, 3, 4, 5]","items.shuffle(using: &rng)"],"syntax":"swift"}],"kind":"content"}],"kind":"article","abstract":[{"type":"text","text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators."}],"variants":[{"paths":["\/documentation\/swiftml\/reproducibilityandprng"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftML"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Reproducibility, Determinism & High-Quality PRNG"},"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedClassification","doc:\/\/Swift