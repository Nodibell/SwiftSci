{"sections":[],"abstract":[{"type":"text","text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency "},{"type":"codeVoice","code":"TaskGroup"},{"type":"text","text":" primitives."}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"topicSections":[{"title":"Optimization & Search","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoML","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLStrategy","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLTaskType","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLLeaderboardEntry","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLError","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationResult"],"anchor":"Optimization--Search"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftoptimize\/parallelmodelselection"]}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Cross-validation and multi-class classification workflows are embarrassingly parallel: each fold split and one-vs-rest binary sub-problem operates on independent slices of tabular data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"SwiftOptimize","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SwiftML","type":"codeVoice"},{"text":" leverage structured Swift Concurrency (","type":"text"},{"code":"withThrowingTaskGroup","type":"codeVoice"},{"text":") to dispatch multiple fold and class estimators concurrently.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Structured-Concurrency-Pipeline","type":"heading","text":"Structured Concurrency Pipeline"},{"syntax":null,"type":"codeListing","code":["           Input Dataset [Features, Targets]","                          │","       ┌──────────────────┴────────────