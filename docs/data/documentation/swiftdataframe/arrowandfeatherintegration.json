{"sections":[],"metadata":{"modules":[{"name":"SwiftDataFrame"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Apache Arrow & Feather Zero-Copy Integration"},"abstract":[{"text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration"},"topicSections":[{"identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"],"anchor":"Arrow-Classes--Readers","title":"Arrow Classes & Readers"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties.","type":"text"}]},{"level":2,"type":"heading","text":"1. Arrow Memory Layout & Bitmaps","anchor":"1-Arrow-Memory-Layout--Bitmaps"},{"type":"paragraph","inlineContent":[{"text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:","type":"text"}]},{"code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"],"syntax":null,"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Validity Bitmaps"}]},{"type":"text","text":": Each bit represents the presence (1) or absence (0) of a value at that index."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SIMD Null Filtering"}]},{"text":": Vectorized operations skip null evaluations using SIMD bitmasks (","type":"text"},{"type":"codeVoice","code":"vDSP_vcmprsD"},{"text":"), allowing full CPU register utilization.","type":"text"}]}]}],"type":"unorderedList"},{"text":"2. Feather File Format (Arrow IPC)","type":"heading","anchor":"2-Feather-File-Format-Arrow-IPC","level":2},{"inlineContent":[{"text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:","type":"text"}],"type":"paragraph"},{"code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"3. Lazy Feather Streaming","anchor":"3-Lazy-Feather-Streaming","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For large datasets, SwiftDataFrame supports streaming chunked reads:"}]},{"code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherReader"}],"type":"topic","url":"\/documentation\/swiftdataframe\/featherreader","kind":"symbol","abstract":[{"type":"text","text":"Reader for Feather \/ Apache Arrow IPC binary file format."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"FeatherReader"}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","title":"FeatherReader"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TypedColumn"}],"abstract":[{"text":"A strongly-typed column backed by a contiguous Swift array.","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" elements represent null \/ missing values.","type":"text"}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn","kind":"symbol","type":"topic","title":"TypedColumn","url":"\/documentation\/swiftdataframe\/typedcolumn","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TypedColumn"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"abstract":[{"text":"Writer for Feather \/ Apache Arrow IPC binary file format.","type":"text"}],"title":"FeatherWriter","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherWriter"}],"role":"symbol","url":"\/documentation\/swiftdataframe\/featherwriter","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"FeatherWriter"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","title":"SwiftDataFrame","url":"\/documentation\/swiftdataframe","role":"collection","type":"topic","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}]}}}