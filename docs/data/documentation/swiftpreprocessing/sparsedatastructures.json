{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. ","type":"text"},{"code":"SparseMatrix","type":"codeVoice"},{"text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x.","type":"text"}]},{"type":"heading","anchor":"Storage-Formats","level":2,"text":"Storage Formats"},{"type":"heading","anchor":"Compressed-Sparse-Row-CSR","level":3,"text":"Compressed Sparse Row (CSR)"},{"type":"paragraph","inlineContent":[{"text":"Stores non-zero values row-by-row:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"values"},{"type":"text","text":": Non-zero numerical entries."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"colIndices"},{"type":"text","text":": Column indices corresponding to each entry in "},{"type":"codeVoice","code":"values"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"rowPointers"},{"type":"text","text":": Offsets into "},{"type":"codeVoice","code":"values"},{"type":"text","text":" marking where each row begins (length: "},{"type":"codeVoice","code":"rowCount + 1"},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"],"type":"codeListing","syntax":null},{"type":"heading","anchor":"Compressed-Sparse-Column-CSC","level":3,"text":"Compressed Sparse Column (CSC)"},{"type":"paragraph","inlineContent":[{"text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication.","type":"text"}]},{"type":"heading","anchor":"Apple-Accelerate-Sparse-BLAS","level":2,"text":"Apple Accelerate Sparse BLAS"},{"type":"paragraph","inlineContent":[{"text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), ","type":"text"},{"code":"SparseMatrix","type":"codeVoice"},{"text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_matrix_create_double"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_insert_row_double"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_commit"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sparse_matrix_vector_product_dense_double"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput.","type":"text"}]},{"type":"heading","anchor":"Example-Usage","level":2,"text":"Example Usage"},{"code":["import SwiftPreprocessing","","\/\/ 1. Create a sparse matrix from a dense array","let dense: [[Double]] = [","    [1.0, 0.0, 0.0],","    [0.0, 2.0, 0.0],","    [0.0, 0.0, 3.0]","]","let sparse = SparseMatrix(dense: dense, format: .csr)","print(\"Sparsity: \\(sparse.sparsity)\") \/\/ ~ 0.667","","\/\/ 2. Accelerated matrix-vector product","let x = [1.0, 2.0, 3.0]","let y = try sparse.multiply(vector: x)","print(y) \/\/ [1.0, 4.0, 9.0]","","\/\/ 3. Matrix Transpose & CSC conversion","let csc = sparse.toCSC()","let transposed = sparse.transpose()"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftPreprocessing"}],"title":"Memory-Efficient Sparse Matrix Representations","roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"abstract":[{"type":"text","text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats."}],"topicSections":[{"title":"Sparse Data Types","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"],"anchor":"Sparse-Data-Types"}],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"],"anchor":"Guides--Tutorials","generated":true}],"kind":"article","variants":[{"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseFormat":{"abstract":[{"type":"text","text":"Storage format for compressed sparse matrix structures."}],"type":"topic","navigatorTitle":[{"text":"SparseFormat","kind":"identifier"}],"role":"symbol","title":"SparseFormat","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SparseFormat","kind":"identifier"}],"url":"\/documentation\/swiftpreprocessing\/sparseformat","kind":"symbol"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseMatrix":{"fragments":[{"text":"struct","kind