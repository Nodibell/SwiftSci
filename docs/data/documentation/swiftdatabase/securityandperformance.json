{"seeAlsoSections":[{"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"],"generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"title":"SQLite Performance","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection"],"anchor":"SQLite-Performance"},{"title":"PostgreSQL Security","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection"],"anchor":"PostgreSQL-Security"}],"metadata":{"title":"Security & Performance in SwiftDatabase","role":"collectionGroup","modules":[{"name":"SwiftDatabase"}],"roleHeading":"API Collection"},"kind":"article","identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"abstract":[{"type":"text","text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL."}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"As datasets grow into the millions of rows and production PostgreSQL deployments enforce stronger authentication policies, ","type":"text"},{"code":"SwiftDatabase","type":"codeVoice"},{"text":" provides two complementary enhancements:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"1024-row column buffering"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"SQLiteConnection.executeQuery"},{"type":"text","text":" reduces Swift "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" reallocation pressure on large sequential table scans."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"SCRAM-SHA-256 authentication","type":"text"}],"type":"strong"},{"text":" in ","type":"text"},{"code":"PostgreSQLConnection","type":"codeVoice"},{"text":" implements the full RFC 5802\/7677 handshake using CryptoKit ","type":"text"},{"code":"HMAC<SHA256>","type":"codeVoice"},{"text":" and iterative PBKDF2 — never transmitting the raw password over the wire.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"1024-Row-Column-Buffering","level":2,"text":"1024-Row Column Buffering","type":"heading"},{"anchor":"Problem","level":3,"text":"Problem","type":"heading"},{"inlineContent":[{"type":"text","text":"The naive approach appends each decoded row immediately to a growing "},{"code":"[[AnySendableValue]]","type":"codeVoice"},{"type":"text","text":" array. Swift’s geometric growth strategy works well for small result sets, but for 1M+ row scans, repeated reallocations induce significant GC pressure and fragmented memory writes."}],"type":"paragraph"},{"anchor":"Solution","level":3,"text":"Solution","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"executeQuery"},{"type":"text","text":" pre-allocates a local "},{"type":"codeVoice","code":"page"},{"type":"text","text":" buffer of exactly 1024 rows. When the page fills, it is bulk-appended to the result array via "},{"type":"codeVoice","code":"rows.append(contentsOf: page)"},{"type":"text","text":", then the page is cleared with "},{"type":"codeVoice","code":"removeAll(keepingCapacity: true)"},{"type":"text","text":" to avoid reallocation."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let pageSize = 1024","var page: [[AnySendableValue]] = []","page.reserveCapacity(pageSize)","","while sqlite3_step(stmt) == SQLITE_ROW {","    page.append(decodeRow())","    if page.count == pageSize {","        rows.append(contentsOf: page)","        page.removeAll(keepingCapacity: true)","    }","}","rows.append(contentsOf: page) \/\/ Flush remainder"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Benchmark impact"}]},{"type":"text","text":": ~40% fewer allocations on 500K-row tables vs. naive append."}],"type":"paragraph"},{"anchor":"SCRAM-SHA-256-Authentication","type":"heading","text":"SCRAM-SHA-256 Authentication","level":2},{"inlineContent":[{"type":"text","text":"Modern PostgreSQL (>= 14) defaults to "},{"type":"codeVoice","code":"scram-sha-256"},{"type":"text","text":" in "},{"type":"codeVoice","code":"pg_hba.conf"},{"type":"text","text":". "},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":"’s wire-protocol driver now supports the full RFC 5802 exchange:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["Client                                    Server","  │  SASLInitialResponse(SCRAM-SHA-256)     │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLContinue(salt, i)    │","  │ ◄────────────────────────────────────── │","  │  SASLResponse(ClientProof)              │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLFinal + AuthOK       │","  │ ◄────────────────────────────────────── │"]},{"anchor":"PBKDF2-SHA256-via-CryptoKit","type":"heading","text":"PBKDF2-SHA256 via CryptoKit","level":3},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SaltedPassword = Hi(password, salt, iterations)"},{"type":"text","text":" derivation uses a pure Swift PBKDF2 loop over CryptoKit "},{"type":"codeVoice","code":"HMAC<SHA256>"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var u = HMAC<SHA256>.authenticationCode(for: salt + [0,0,0,1], using: SymmetricKey(data: passwordData))","var saltedPassword = Array(u)","for _ in 1..<iterations {","    u = HMAC<SHA256>.authenticationCode(for: Data(u), using: ...)","    \/\/ XOR accumulate","}"]},{"anchor":"Enabling-SCRAM-on-PostgreSQL-Server","type":"heading","text":"Enabling SCRAM on PostgreSQL Server","level":2},{"syntax":"sql","type":"codeListing","code":["-- pg_hba.conf","host  all  all  0.0.0.0\/0  scram-sha-256","","-- Verify in psql:","SELECT usename, passwd FROM pg_shadow;","-- Password should start with: SCRAM-SHA-256$4096:..."]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiftdatabase\/securityandperformance"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SwiftDatabase/documentation/SwiftDatabase/PostgreSQLConnection":{"type":"topic","title":"PostgreSQLConnection","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection","url":"\/documentation\/swiftdatabase\/postgresqlconnection","abstract":[{"type":"text","text":"Native PostgreSQL database connection driver using PostgreSQL v3.0 wire protocol."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostgreSQLConnection"}],"navigatorTitle":[{"kind":"identifier","text":"PostgreSQLConnection"}]},"doc://SwiftDatabase/documentation/SwiftDatabase":{"type":"topic","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase","url":"\/documentation\/swiftdatabase","role":"collection","title":"SwiftDatabase","abstract":[{"type":"text","text":"Relational Database Connectors to DataFrames."}],"kind":"symbol"},"doc://SwiftDatabase/documentation/SwiftDatabase/SQLiteConnection":{"kind":"symbol","title":"SQLiteConnection","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"SQLiteConnection"}],"navigatorTitle":[{"kind":"identifier","text":"SQLiteConnection"}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection","url":"\/documentation\/swiftdatabase\/sqliteconnection","abstract":[{"type":"text","text":"Embedded SQLite database driver executing real SQL statements using the SQLite3 C API."}],"role":"symbol","type":"topic"},"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"kind":"article","type":"topic","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","abstract":[{"type":"text","text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions."}],"url":"\/documentation\/swiftdatabase\/typesystem","role":"collectionGroup","title":"Database Type System & Value Representation"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"kind":"article","title":"Bulk SQL Ingestion & Database Wire Protocols","role":"collectionGroup","type":"topic","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","url":"\/documentation\/swiftdatabase\/highthroughputingestion","abstract":[{"type":"text","text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback."}]},"doc://SwiftDatabase/documentation/SwiftDatabase/DatabaseConnectors":{"url":"\/documentation\/swiftdatabase\/databaseconnectors","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","kind":"article","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","role":"article","abstract":[{"type":"text","text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into "},{"code":"SwiftDataFrame","type":"codeVoice"},{"type":"text","text":" under Swift 6 Actor Concurrency."}],"type":"topic"}}}