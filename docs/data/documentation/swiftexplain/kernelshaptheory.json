{"abstract":[{"text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"anchor":"SHAP-Explainer-APIs","title":"SHAP Explainer APIs"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}]},{"type":"text","text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory."}],"type":"paragraph"},{"level":2,"text":"1. The Four Shapley Axioms","type":"heading","anchor":"1-The-Four-Shapley-Axioms"},{"inlineContent":[{"type":"text","text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Efficiency"}]},{"text":": Feature attributions sum up to the difference between model prediction ","type":"text"},{"code":"f(x)","type":"codeVoice"},{"text":" and expected background prediction ","type":"text"},{"code":"E[f(X)]","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"code":"Σ_i=1..M φ_i = f(x) - E[f(X)]","type":"codeVoice"}]}],"type":"aside"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Symmetry"}]},{"text":": If two features contribute equally to all possible feature subsets, their attributions are equal.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dummy (Null Player)"}]},{"text":": A feature that does not change the model prediction for any coalition receives an attribution of zero (","type":"text"},{"code":"φ_i = 0","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Additivity"}]},{"text":": For ensemble models ","type":"text"},{"code":"f = f1 + f2","type":"codeVoice"},{"text":", attributions satisfy ","type":"text"},{"code":"φ_i(f) = φ_i(f1) + φ_i(f2)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"2. Explaining Predictions in SwiftSci","type":"heading","anchor":"2-Explaining-Predictions-in-SwiftSci"},{"syntax":"swift","type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory"},"variants":[{"paths":["\/documentation\/swiftexplain\/kernelshaptheory"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","metadata":{"title":"Game-Theoretic Interpretability with Kernel SHAP","modules":[{"name":"SwiftExplain"}],"roleHeading":"API Collection","role":"collectionGroup"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"type":"topic","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","kind":"symbol","url":"\/documentation\/swiftexplain","title":"SwiftExplain","role":"collection","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}]},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KernelSHAP"}],"navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}],"title":"KernelSHAP","abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","url":"\/documentation\/swiftexplain\/kernelshap"}}}