{"sections":[],"topicSections":[{"title":"Embedding APIs","anchor":"Embedding-APIs","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"]}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"metadata":{"modules":[{"name":"SwiftNLP"}],"role":"collectionGroup","title":"Dense Local Text Embeddings with Accelerate","roleHeading":"API Collection"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings"},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Modern Retrieval-Augmented Generation (RAG) and semantic search systems require dense vector representations of text. Traditional approaches depend on remote APIs (e.g. OpenAI) or large multi-gigabyte models that exhaust memory. ","type":"text"},{"type":"codeVoice","code":"SwiftNLP"},{"text":" introduces ","type":"text"},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"text":", a subword N-gram character hashing projection engine that produces deterministic, unit-normalized dense embeddings in sub-millisecond execution times.","type":"text"}]},{"anchor":"1-Algorithmic-Foundation","level":2,"type":"heading","text":"1. Algorithmic Foundation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"type":"text","text":" operates through a three-stage mathematical pipeline:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Subword N-gram Hashing"}],"type":"strong"},{"type":"text","text":": Text is tokenized into word and character n-grams (sizes 3 to 6). Each n-gram is hashed into a fixed integer space using FNV-1a hash functions."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dimension Projection"}]},{"type":"text","text":": Hashes are projected onto a "},{"code":"D","type":"codeVoice"},{"type":"text","text":"-dimensional vector space (e.g., "},{"code":"D = 128","type":"codeVoice"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"D = 256"},{"text":") with deterministic sign flips to prevent feature collision bias.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Unit L2 Normalization","type":"text"}],"type":"strong"},{"type":"text","text":": The resulting dense vector is projected onto the unit hypersphere:"}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Formula:"}],"type":"strong"},{"text":" ","type":"text"},{"code":"v_norm = v \/ ||v||_2 = v \/ sqrt(Σ v_i²)","type":"codeVoice"}]}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Because all embeddings have ","type":"text"},{"code":"||v||_2 = 1.0","type":"codeVoice"},{"text":", the ","type":"text"},{"inlineContent":[{"type":"text","text":"Cosine Similarity"}],"type":"strong"},{"text":" between two embeddings is equivalent to their direct ","type":"text"},{"inlineContent":[{"type":"text","text":"Dot Product"}],"type":"strong"},{"type":"text","text":", allowing single-instruction vector evaluation via Apple Accelerate "},{"type":"codeVoice","code":"vDSP_dotprD"},{"type":"text","text":":"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"CosineSimilarity(u, v) = u · v"}]}],"style":"note","name":"Note","type":"aside"},{"text":"2. Generating Embeddings","anchor":"2-Generating-Embeddings","level":2,"type":"heading"},{"code":["import SwiftNLP","","\/\/ Initialize a 128-dimensional local embedding engine","let engine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Generate embedding for a single text snippet","let vector = engine.embed(\"Apple Silicon M3 Max neural network processing\")","print(\"Vector dimension: \\(vector.count)\") \/\/ 128","","\/\/ Batch embedding generation","let documents = [","    \"High-performance computing on macOS\",","    \"Relational database wire protocol drivers\",","    \"Deep convolutional neural networks for vision\"","]","let batchEmbeddings = engine.embedBatch(documents)"],"syntax":"swift","type":"codeListing"},{"text":"3. Integration with SwiftCluster.VectorStore","anchor":"3-Integration-with-SwiftClusterVectorStore","level":2,"type":"heading"},{"code":["import SwiftCluster","","let store = VectorStore(metric: .cosineSimilarity)","","for (idx, doc) in documents.enumerated() {","    let vec = engine.embed(doc)","    store.add(id: \"doc_\\(idx)\", vector: vec, metadata: [\"text\": doc])","}","","\/\/ Perform instant semantic similarity search","let query = engine.embed(\"Mac hardware acceleration\")","let topHits = store.search(query: query, topK: 1)","print(\"Top match: \\(topHits.first?.metadata[\"text\"] ?? \"\")\")"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/denselocalembeddings"]}],"references":{"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","title":"LocalEmbeddingEngine","url":"\/documentation\/swiftnlp\/localembeddingengine","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LocalEmbeddingEngine","kind":"identifier"}],"navigatorTitle":[{"text":"LocalEmbeddingEngine","kind":"identifier"}],"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon."}]},"doc://SwiftNLP/documentation/SwiftNLP":{"url":"\/documentation\/swiftnlp","title":"SwiftNLP","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"role":"collection"}}}