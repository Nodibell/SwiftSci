"},{"text":" to pull batches through fitted preprocessing and a fixed-shape Core ML model. The pipeline holds capacity until each result consumer returns.","type":"text"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/BoundedInference","title":"Run bounded batch inference","url":"\/documentation\/swiftml\/boundedinference","role":"article"},"doc://SwiftML/documentation/SwiftML/MLOpsExport":{"abstract":[{"text":"Export trained SwiftSci estimators to native Apple Core ML (","type":"text"},{"code":".mlmodel","type":"codeVoice"},{"text":") and cross-platform ONNX (","type":"text"},{"code":".onnx","type":"codeVoice"},{"text":") binary artifacts for production deployment.","type":"text"}],"role":"collectionGroup","url":"\/documentation\/swiftml\/mlopsexport","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","kind":"article","type":"topic","title":"Exporting Models to Core ML and ONNX"},"doc://SwiftML/documentation/SwiftML":{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"type":"topic","title":"SwiftML","url":"\/documentation\/swiftml","kind":"symbol","role":"collection"},"doc://SwiftML/documentation/SwiftML/ReusableCPUPrediction":{"type":"topic","abstract":[{"text":"Fit one preprocessing and model snapshot, then prepare and reuse selected inputs under an explicit memory budget.","type":"text"}],"role":"article","url":"\/documentation\/swiftml\/reusablecpuprediction","title":"Reuse standardized CPU predictions","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReusableCPUPrediction","kind":"article"},"doc://SwiftML/documentation/SwiftML/SupervisedRegressors":{"type":"topic","url":"\/documentation\/swiftml\/supervisedregressors","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","abstract":[{"text":"Perform continuous target predictions using LinearRegression (exact OLS), DecisionTreeRegressor, and GradientBoostedTreesRegressor.","type":"text"}],"kind":"article","role":"article","title":"Supervised Regression Models"},"doc://SwiftML/documentation/SwiftML/ReproducibilityAndPRNG":{"abstract":[{"text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators.","type":"text"}],"role":"collectionGroup","url":"\/documentation\/swiftml\/reproducibilityandprng","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","kind":"article","type":"topic","title":"Reproducibility, Determinism & High-Quality PRNG"},"doc://SwiftML/documentation/SwiftML/EarlyStoppingCallbacks":{"type":"topic","abstract":[{"type":"text","text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting."}],"role":"collectionGroup","url":"\/documentation\/swiftml\/earlystoppingcallbacks","title":"Early Stopping & Generalization Control","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","kind":"article"},"doc://SwiftML/documentation/SwiftML/CoreMLInference":{"type":"topic","url":"\/documentation\/swiftml\/coremlinference","abstract":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLPredictor"},{"text":" to run a compiled Core ML regression, vector, or matrix model on","type":"text"},{"text":" ","type":"text"},{"code":"PreparedNumericBatch","type":"codeVoice"},{"type":"text","text":". The predictor matches named scalar features or packs bounded batches"},{"text":" ","type":"text"},{"text":"for a vector input. Results retain the input’s row order and source indices.","type":"text"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLInference","kind":"article","role":"article","title":"Run prepared data through Core ML"}}}