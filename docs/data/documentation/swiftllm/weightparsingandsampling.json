{"topicSections":[{"anchor":"Weight-Parsers--Representations","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/GGUFParser","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SafeTensorsParser","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedTensor","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedLayoutMetadata"],"title":"Weight Parsers & Representations"},{"anchor":"Sampling--Decoding","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies"],"title":"Sampling & Decoding"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/weightparsingandsampling"]}],"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"text":" provides high-throughput binary weight parsers that map model weights directly into unified memory (UMA) without intermediate memory allocations, paired with a robust token sampling pipeline operating strictly on unnormalized logits.","type":"text"}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"1-GGUF-Zero-Copy-Weight-Parsing","type":"heading","level":2,"text":"1. GGUF Zero-Copy Weight Parsing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"GGUFParser"},{"text":" decodes GGUF header metadata and extracts tensor blocks into semantic ","type":"text"},{"type":"codeVoice","code":"QuantizedTensor"},{"text":" representations without eager dequantization into full floating-point arrays:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import SwiftLLM","","let modelURL = URL(fileURLWithPath: \"models\/llama-3-8b-instruct.Q4_0.gguf\")","","\/\/ 1. Parse GGUF weights into QuantizedTensor map","let weights: [String: QuantizedTensor] = try GGUFParser.parse(url: modelURL)","","\/\/ 2. Inspect parsed tensor metadata","if let attnWeight = weights[\"blk.0.attn_q.weight\"] {","    print(\"Tensor name: \\(attnWeight.name)\")","    print(\"Shape: \\(attnWeight.shape)\")","    print(\"Scheme: \\(String(describing: attnWeight.scheme))\") \/\/ .q4_0","    print(\"Block Size: \\(attnWeight.layoutMetadata.blockSize)\") \/\/ 32","}","","\/\/ 3. Extract separated packed weight and scale buffers for Metal GEMV","if let (packedWeights, scales) = weights[\"blk.0.attn_q.weight\"]?.extractSeparatedBuffers() {","    print(\"Extracted \\(packedWeights.count) weight bytes and \\(scales.count) scale bytes.\")","}"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"2. SafeTensors Zero-Copy Weight Parsing","anchor":"2-SafeTensors-Zero-Copy-Weight-Parsing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SafeTensorsParser"},{"text":" parses JSON header descriptors and maps FP16\/FP32\/BF16 tensor payloads directly into ","type":"text"},{"code":"MLXArray","type":"codeVoice"},{"text":" instances:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import SwiftLLM","import MLX","","let safeURL = URL(fileURLWithPath: \"models\/model.safetensors\")","","\/\/ Parse SafeTensors into native MLX tensor dictionary","let tensors: [String: MLXArray] = try SafeTensorsParser.parse(url: safeURL)","","for (tensorName, array) in tensors {","    print(\"Loaded tensor '\\(tensorName)': shape=\\(array.shape), dtype=\\(array.dtype)\")","}"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"3. Token Sampling with SamplingConfiguration","anchor":"3-Token-Sampling-with-SamplingConfiguration"},{"type":"paragraph","inlineContent":[{"text":"After computing next-token logits from ","type":"text"},{"code":"TransformerDecoder.forward","type":"codeVoice"},{"text":", token selection is governed by ","type":"text"},{"code":"SamplingConfiguration","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftLLM","import MLX","","\/\/ 1. Define generation parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","let pastTokens = [128000, 791, 7453, 374]","let nextLogits: MLXArray = ... \/\/ Shape [vocab_size] from decoder.forward","","\/\/ 2. Sample next token ID applying penalty, temperature, top-k, and top-p","let nextToken = Sampler.sample(","    logits: nextLogits,","    config: sampling,","    pastTokens: pastTokens",")","","print(\"Sampled next token ID: \\(nextToken)\")"]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"[!TIP]","type":"text"},{"text":" ","type":"text"},{"text":"For detailed mathematical formulations of repetition penalty, temperature scaling, top-k truncation, and nucleus (top-p) masking, see ","type":"text"},{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"type":"thematicBreak"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling"},"metadata":{"modules":[{"name":"SwiftLLM"}],"role":"collectionGroup","title":"GGUF\/SafeTensors Parsing & Sampling","roleHeading":"API Collection"},"abstract":[{"type":"text","text":"Parse GGUF and SafeTensors model weights zero-copy into Apple Silicon unified memory and sample tokens with fine-grained logits controls."}],"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"title":"Guides & Tutorials"}],"references":{"doc://SwiftLLM/documentation/SwiftLLM/QuantizedTensor":{"role":"symbol","kind":"symbol","title":"QuantizedTensor","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"QuantizedTensor","kind":"identifier"}],"navigatorTitle":[{"text":"QuantizedTensor","kind":"identifier"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/QuantizedTensor","type":"topic","url":"\/documentation\/swiftllm\/quantizedtensor","abstract":[{"type":"text","text":"A semantic representation of a parsed tensor preserving raw quantized layout without eager dequantization."}]},"doc://SwiftLLM/documentation/SwiftLLM/GGUFParser":{"navigatorTitle":[{"text":"GGUFParser","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"GGUFParser","kind":"identifier"}],"abstract":[{"text":"Parser for the GGUF (GGML Unified Format) file format.","type":"text"},{"text":" ","type":"text"},{"text":"Decodes the metadata headers and maps the binary tensor blocks directly into MLXArrays.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/swiftllm\/ggufparser","type":"topic","title":"GGUFParser","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/GGUFParser"},"doc://SwiftLLM/documentation/SwiftLLM/LLMOptions":{"navigatorTitle":[{"kind":"identifier","text":"LLMOptions"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"LLMOptions"}],"abstract":[{"type":"text","text":"Options configuring generative text inference."}],"role":"symbol","url":"\/documentation\/swiftllm\/llmoptions","kind":"symbol","type":"topic","title":"LLMOptions","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions"},"doc://SwiftLLM/documentation/SwiftLL