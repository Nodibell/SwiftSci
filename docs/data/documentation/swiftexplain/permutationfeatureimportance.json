{"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Permutation Feature Importance"}],"type":"strong"},{"type":"text","text":" measures how much a trained model’s error increases when a single feature column is randomly shuffled, breaking the relationship between that feature and the target outcome."}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Importance Metric:"}],"type":"strong"},{"type":"text","text":" "},{"code":"Importance(f_j) = Loss(X_shuffled(j), y) - Loss(X, y)","type":"codeVoice"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"type":"heading","level":2,"text":"1. Computing Permutation Importance","anchor":"1-Computing-Permutation-Importance"},{"type":"codeListing","code":["import SwiftExplain","import SwiftML","","let importance = try await PermutationImportance.compute(","    model: trainedModel,","    features: X_val,","    targets: y_val,","    metric: .meanSquaredError,","    nRepeats: 10",")","","for (idx, score) in importance.enumerated() {","    print(\"Feature \\(idx): Mean drop = \\(score.mean), Std = \\(score.std)\")","}"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/permutationfeatureimportance"]}],"metadata":{"title":"Permutation Feature Importance & Model Diagnostics","roleHeading":"API Collection","modules":[{"name":"SwiftExplain"}],"role":"collectionGroup"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationFeatureImportance","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Measure true feature importance by evaluating loss degradation after shuffling feature columns."}],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"to