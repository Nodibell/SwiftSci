{"sections":[],"kind":"article","metadata":{"modules":[{"name":"SwiftLLM"}],"roleHeading":"Article","role":"article","title":"Transformer Architecture & LLM Inference Guide"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"High-throughput, on-device causal language model execution on Apple Silicon Unified Memory Architecture using "},{"type":"codeVoice","code":"TransformerDecoder"},{"type":"text","text":", "},{"type":"codeVoice","code":"PagedKVCache"},{"type":"text","text":", "},{"type":"codeVoice","code":"GGUFParser"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SafeTensorsParser"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Architecture Overview","anchor":"Architecture-Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" implements the modern Llama-3 \/ Mistral autoregressive causal decoder architecture natively in pure Swift and MLX:"}]},{"syntax":null,"type":"codeListing","code":["                          ┌────────────────────────┐","                          │    Input Token IDs     │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │   Token Embeddings     │","                          └───────────┬────────────┘","                                      ▼","                      ┌────────────────────────────────┐","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │ Multi-Head Attention + RoPE│ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          RMSNorm           │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │      SwiGLU FFN (SiLU)     │ │","                      │ └─────────────┬──────────────┘ │","                      │               ▼                │","                      │ ┌────────────────────────────┐ │","                      │ │          Residual          │ │","                      │ └─────────────┬──────────────┘ │","                      │ └─────────────┬──────────────┘ │ x N Layers","                      └───────────────┼────────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │     Final RMSNorm      │","                          └───────────┬────────────┘","                                      ▼","                          ┌────────────────────────┐","                          │  LM Head (Logits)      │","                          └────────────────────────┘"]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"1. Core Architectural Components","anchor":"1-Core-Architectural-Components"},{"type":"heading","level":3,"text":"RoPE (Rotary Position Embedding)","anchor":"RoPE-Rotary-Position-Embedding"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applies 2D rotation to query and key vectors based on absolute position index "},{"type":"codeVoice","code":"m"},{"type":"text","text":", preserving relative token distance properties without learned position embeddings."}]},{"type":"heading","level":3,"text":"SwiGLU Feed-Forward Network","anchor":"SwiGLU-Feed-Forward-Network"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replaces legacy ReLU\/GELU activations with Swish-Gated Linear Units (Llama-style):"}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"code":"SwiGLU(x) = (SiLU(x · W_gate) ⊙ (x · W_up)) · W_down","type":"codeVoice"}]}],"style":"note"},{"type":"heading","level":3,"text":"Paged KV-Cache","anchor":"Paged-KV-Cache"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Manages attention Key-Value projection states in fixed-size contiguous memory pages (vLLM architecture), eliminating RAM fragmentation during dynamic multi-turn autoregressive decoding."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"anchor":"2-Parsing-Weight-Formats-SafeTensors--GGUF","text":"2. Parsing Weight Formats (SafeTensors & GGUF)"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" includes strict parsers for both HuggingFace "},{"type":"codeVoice","code":".safetensors"},{"type":"text","text":" headers and "},{"code":"GGUF","type":"codeVoice"},{"type":"text","text":" quantized binary models:"}]},{"type":"codeListing","code":["import Foundation","import SwiftLLM","","\/\/ 1. Parse SafeTensors weight metadata","let safeTensorsURL = URL(fileURLWithPath: \"model.safetensors\")","let (tensors, metadata) = try SafeTensorsParser.parse(fileURL: safeTensorsURL)","","print(\"Found \\(tensors.count) tensor layers in SafeTensors archive.\")","for (tensorName, info) in tensors.prefix(5) {","    print(\"Layer '\\(tensorName)': dtype=\\(info.dtype), shape=\\(info.shape)\")","}","","\/\/ 2. Parse GGUF Quantized Binary Archive","let ggufURL = URL(fileURLWithPath: \"llama-3-8b.Q4_K_M.gguf\")","let ggufModel = try GGUFParser.parse(fileURL: ggufURL)","print(\"Loaded GGUF Model with \\(ggufModel.tensors.count) quantized tensors.\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","level":2,"anchor":"3-End-to-End-Decoder-Configuration--Inference","text":"3. End-to-End Decoder Configuration & Inference"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct an N-layer "},{"type":"codeVoice","code":"TransformerDecoder"},{"type":"text","text":" using standard presets ("},{"type":"codeVoice","code":"LLMConfig.llama3_8B"},{"type":"text","text":" or "},{"type":"codeVoice","code":"LLMConfig.custom"},{"type":"text","text":") and generate tokens:"}]},{"type":"codeListing","code":["import SwiftLLM","","\/\/ 1. Initialize TransformerDecoder with Llama-3-8B configuration","let config = LLMConfig.llama3_8B","let decoder = TransformerDecoder(config: config)","","\/\/ 2. Load model weights into memory","let weightsDictionary: [String: [Double]] = [:] \/\/ Populated from SafeTensors\/GGUF","try decoder.loadWeights(weightsDictionary)","","\/\/ 3. Configure sampling strategy","let sampler = TopKSampler(temperature: 0.7, topK: 40, topP: 0.9)","","\/\/ 4. Autoregressive token generation loop","let promptTokens: [Int] = [128000, 791, 7453, 374] \/\/ Tokenized input","var generatedTokens = promptTokens","let maxNewTokens = 50","","print(\"Generating output tokens...\")","for _ in 0..<maxNewTokens {","    let logits = try decoder.forward(tokens: generatedTokens)","    let nextToken = sampler.sample(logits: logits)","    ","    generatedTokens.append(nextToken)","    if nextToken == 128001 { \/\/ End of Sequence token (EOS)","        break","    }","}","","print(\"Generated sequence length: \\(generatedTokens.count) tokens.\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","level":2,"anchor":"4-Structured-JSON-Grammar-Decoding","text":"4. Structured JSON Grammar Decoding"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enforce strict output conformance to Swift "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" schemas using "},{"type":"codeVoice","code":"JSONGrammarDecoder"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import SwiftLLM","","struct SentimentResponse: Codable {","    let label: String","    let confidence: Double","}","","let grammarDecoder = JSONGrammarDecoder(schema: SentimentResponse.self)","let constrainedTokens = try grammarDecoder.constrainSampling(logits: logits, validTokens: vocabulary)"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/transformerdecoderarchitecture"]}],"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"anchor":"Guides--Tutorials"}],"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"references":{"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"type":"topic","title":"GGUF\/SafeTensors Parsing & Sampling","abstract":[{"type":"text","text":"Parse GGUF and SafeTensors model weights zero-copy and sample tokens using Temperature and Top-K sampling."}],"kind":"article","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","role":"article","url":"\/documentation\/swiftllm\/weightparsingandsampling"},"doc://SwiftLLM/documentation/SwiftLLM/MetalShadersQuantization":{"type":"topic","title":"Native Metal MSL Shaders for Quantized LLMs","abstract":[{"type":"text","text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU."}],"kind":"article","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization","role":"collectionGroup","url":"\/documentation\/swiftllm\/metalshadersquantization"},"doc://SwiftLLM/documentation/SwiftLLM":{"abstract":[{"type":"text","text":"Local Causal Transformer Decoder & Weight Parsers."}],"type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","title":"SwiftLLM","url":"\/documentation\/swiftllm"}}}