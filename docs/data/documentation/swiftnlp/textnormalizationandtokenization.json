{"metadata":{"title":"Text Normalization, Tokenization & Linguistic Tagging","modules":[{"name":"SwiftNLP"}],"role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"]}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies.","type":"text"}],"type":"paragraph"},{"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","level":3,"text":"1. Multi-lingual Word & Sentence Tokenization","type":"heading"},{"syntax":"swift","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"type":"codeListing"},{"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","level":3,"text":"2. POS Tagging, Lemmatization & Entity Extraction","type":"heading"},{"syntax":"swift","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"type":"codeListing"},{"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","level":3,"text":"3. Sentiment Analysis (VADER & NLSentiment)","type":"heading"},{"syntax":"swift","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"sections":[],"abstract":[{"text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native ","type":"text"},{"type":"codeVoice","code":"NaturalLanguage"},{"text":" framework.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"anchor":"Guides--Tutorials"}],"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"kind":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","title":"SwiftNLP","role":"collection","type":"topic","url":"\/documentation\/swiftnlp","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}]},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"kind":"article","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","title":"Text Feature Vectorization, Embeddings & Naive Bayes Classification","role":"article","type":"topic","url":"\/documentation\/swiftnlp\/vectorizationandembeddings","abstract":[{"type":"text","text":"Convert text corpora into numerical feature matri