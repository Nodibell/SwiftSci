{"topicSections":[{"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStopping","doc:\/\/SwiftML\/documentation\/SwiftML\/MetricDirection"],"anchor":"Training-Callbacks","title":"Training Callbacks"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Early Stopping & Generalization Control","modules":[{"name":"SwiftML"}]},"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"Iterative estimators like multi-layer perceptrons (","type":"text"},{"code":"MLPClassifier","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MLPRegressor","type":"codeVoice"},{"text":") and gradient boosted decision trees (","type":"text"},{"code":"GradientBoostedTreesRegressor","type":"codeVoice"},{"text":") improve their training loss over successive iterations. However, after sufficient capacity has been fit, additional epochs frequently lead to overfitting on training noise and deteriorating generalization on unseen data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"EarlyStopping","type":"codeVoice"},{"text":" provides a decoupled, value-type training callback that monitors validation loss or performance metrics across successive epochs, halting training and optionally restoring optimal model weights.","type":"text"}],"type":"paragraph"},{"anchor":"Mechanics--State-Machine","text":"Mechanics & State Machine","level":2,"type":"heading"},{"syntax":null,"code":["Epoch Evaluation (Score S_t)","            │","            ▼"," Is (Best - S_t) > minDelta?","   ├── YES ──► Reset wait = 0, update bestScore = S_t, checkpoint weights","   └── NO  ──► Increment wait = wait + 1","                 │","            Is wait >= patience?","              ├── YES ──► shouldStop = true, restore best checkpoint weights","              └── NO  ──► Continue training"],"type":"codeListing"},{"anchor":"Configuration-Parameters","text":"Configuration Parameters","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"patience"},{"type":"text","text":": Number of consecutive non-improving evaluations tolerated before triggering an early halt."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"minDelta"},{"type":"text","text":": Minimum absolute improvement required to qualify as progress."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"direction"},{"type":"text","text":": "},{"type":"codeVoice","code":".minimize"},{"type":"text","text":" for loss functions (cross-entropy, MSE) or "},{"type":"codeVoice","code":".maximize"},{"type":"text","text":" for scoring metrics (accuracy, R2, AUC)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"restoreBestWeights"},{"type":"text","text":": When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", automatically restores the model parameters from the epoch that achieved "},{"type":"codeVoice","code":"bestScore"},{"type":"text","text":", avoiding overfit tail iterations."}]}]}],"type":"unorderedList"},{"anchor":"Example-Usage","text":"Example Usage","level":2,"type":"heading"},{"syntax":"swift","code":["import SwiftML","","\/\/ 1. Configure early stopping callback","let es = EarlyStopping(","    patience: 5,","    minDelta: 1e-4,","    direction: .minimize,","    restoreBestWeights: true",")","","\/\/ 2. Fit MLP with validation monitoring","let mlp = MLPClassifier(hiddenLayerSizes: [32, 16], maxIter: 200)","try await mlp.fit(","    features: X_train,","    targets: y_train,","    validationFeatures: X_val,","    validationTargets: y_val,","    earlyStopping: es",")"],"type":"codeListing"}]}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/earlystoppingcallbacks"]}],"references":{"doc://SwiftML/documentation/SwiftML/MLOpsExport":{"url":"\/documentation\/swiftml\/mlopsexport","role":"collectionGroup","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","kind":"article","type":"topic","abstract":[{"text":"Export trained SwiftSci estimators to native Apple Core ML (","type":"text"},{"code":".mlmodel","type":"codeVoice"},{"text":") and cross-platform ONNX (","type":"text"},{"code":".onnx","type":"codeVoice"},{"text":") binary artifacts for production deployment.","type":"text"}],"title":"Exporting Models to Core ML and ONNX"},"doc://SwiftML/documentation/SwiftML/EnsembleLearning":{"kind":"article","title":"Ensemble Learning: Random Forests & Gradient Boosted Trees","abstract":[{"type":"text","text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism."}],"role":"collectionGroup","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","url":"\/documentation\/swiftml\/ensemblelearning","type":"topic"},"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"url":"\/documentation\/swiftml\/supervisedclassifiers","role":"article","identifier":"doc:\/\/SwiftML\/documentation