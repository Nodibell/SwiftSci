{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning"},"abstract":[{"text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism.","type":"text"}],"topicSections":[{"title":"Tree Estimators","anchor":"Tree-Estimators","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestClassifier","doc:\/\/SwiftML\/documentation\/SwiftML\/RandomForestRegressor"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/ensemblelearning"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Ensemble methods combine multiple base estimators to improve generalization and reduce variance. "},{"type":"codeVoice","code":"SwiftML"},{"type":"text","text":" implements both "},{"type":"strong","inlineContent":[{"type":"text","text":"Random Forests"}]},{"type":"text","text":" (bagging) and "},{"type":"strong","inlineContent":[{"type":"text","text":"Gradient Boosted Decision Trees"}]},{"type":"text","text":" (boosting) with high-performance tree split search."}],"type":"paragraph"},{"text":"1. Random Forest Classification & Regression","level":2,"type":"heading","anchor":"1-Random-Forest-Classification--Regression"},{"inlineContent":[{"type":"codeVoice","code":"RandomForestClassifier"},{"type":"text","text":" trains an ensemble of randomized decision trees using bootstrap aggregation (bagging) and random feature subsets:"}],"type":"paragraph"},{"code":["import SwiftML","","let rf = try RandomForestClassifier(","    nEstimators: 100,","    maxDepth: 10,","    minSamplesSplit: 2,","    criterion: .gini",")","","try await rf.fit(features: X_train, targets: y_train)","let predictions = try await rf.predict(features: X_test)","let probabilities = try await rf.predictProba(features: X_test)"],"type":"codeListing","sy