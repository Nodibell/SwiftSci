{"kind":"article","metadata":{"role":"article","title":"Deploying and Persisting Scientific Workflows","modules":[{"name":"SwiftWorkflow"}],"roleHeading":"Article"},"abstract":[{"text":"Learn how to safely persist, reload, and evaluate end-to-end machine learning workflows across processes.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"In production scientific machine learning systems, data leakage between training and evaluation phases is one of the most common causes of overly optimistic validation metrics. "},{"type":"codeVoice","code":"SwiftWorkflow"},{"type":"text","text":" eliminates leakage by enforcing structural invariants at the API level:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Explicit Supervised Batch Splitting"}]},{"type":"text","text":": Workflows accept "},{"type":"codeVoice","code":"PreparedSupervisedBatch"},{"type":"text","text":" instances where row selection explicitly tracks "},{"type":"codeVoice","code":"originalRowIndices"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Immutable Stages"}]},{"type":"text","text":": Once trained, a workflow exposes no mutable hyperparameters or refitting paths."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Atomic Schema Validation"}]},{"type":"text","text":": When loading from JSON, dimensions and feature names are checked against the artifact header before initializing models."}]}]}],"type":"orderedList"},{"text":"End-to-End Persistence Pattern","anchor":"End-to-End-Persistence-Pattern","level":3,"type":"heading"},{"syntax":"swift","code":["import Foundation","import SwiftDataFrame","import SwiftWorkflow","","\/\/ Train workflow on designated training rows","let workflow = try await PCAClassificationWorkflow.train(","    training: trainingBatch,","    components: 2,","    learningRate: 0.125,","    epochs: 64",")","","\/\/ Serialize fitted stages to JSON artifact","let artifactURL = URL(fileURLWithPath: \"PCAWorkflow.json\")","try workflow.save(to: artifactURL)","","\/\/ Reload across independent processes with verified dimensions","let reloaded = try PCAClassificationWorkflow.load(from: artifactURL)","let predictions = try await reloaded.predict(unlabeledBatch)"],"type":"codeListing"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftworkflow\/workflowpersistence"]}],"references":{"doc://SwiftWorkflow/documentation/SwiftWorkflow":{"type":"topic","identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow","role":"collection","abstract":[{"text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization.","type":"text"}],"url":"\/documentation\/swiftworkflow","title":"SwiftWorkflow","kind":"symbol"}}}