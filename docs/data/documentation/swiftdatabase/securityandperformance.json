{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/securityandperformance"]}],"seeAlsoSections":[{"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","interfaceLanguage":"swift"},"kind":"article","abstract":[{"text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL.","type":"text"}],"topicSections":[{"title":"SQLite Performance","anchor":"SQLite-Performance","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection"]},{"title":"PostgreSQL Security","anchor":"PostgreSQL-Security","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection"]}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"As datasets grow into the millions of rows and production PostgreSQL deployments enforce stronger authentication policies, "},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" provides two complementary enhancements:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"1024-row column buffering"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"SQLiteConnection.executeQuery"},{"type":"text","text":" reduces Swift "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" reallocation pressure on large sequential table scans."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SCRAM-SHA-256 authentication"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"PostgreSQLConnection"},{"type":"text","text":" implements the full RFC 5802\/7677 handshake using CryptoKit "},{"type":"codeVoice","code":"HMAC<SHA256>"},{"type":"text","text":" and iterative PBKDF2 — never transmitting the raw password over the wire."}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"1024-Row Column Buffering","type":"heading","level":2,"anchor":"1024-Row-Column-Buffering"},{"type":"heading","level":3,"text":"Problem","anchor":"Problem"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The naive approach appends each decoded row immediately to a growing "},{"type":"codeVoice","code":"[[AnySendableValue]]"},{"type":"text","text":" array. Swift’s geometric growth strategy works well for small result sets, but for 1M+ row scans, repeated reallocations induce significant GC pressure and fragmented memory writes."}]},{"type":"heading","level":3,"text":"Solution","anchor":"Solution"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"executeQuery"},{"text":" pre-allocates a local ","type":"text"},{"type":"codeVoice","code":"page"},{"type":"text","text":" buffer of exactly 1024 rows. When the page fills, it is bulk-appended to the result array via "},{"type":"codeVoice","code":"rows.append(contentsOf: page)"},{"type":"text","text":", then the page is cleared with "},{"code":"removeAll(keepingCapacity: true)","type":"codeVoice"},{"text":" to avoid reallocation.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let pageSize = 1024","var page: [[AnySendableValue]] = []","page.reserveCapacity(pageSize)","","while sqlite3_step(stmt) == SQLITE_ROW {","    page.append(decodeRow())","    if page.count == pageSize {","        rows.append(contentsOf: page)","        page.removeAll(keepingCapacity: true)","    }","}","rows.append(contentsOf: page) \/\/ Flush remainder"]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Benchmark impact","type":"text"}]},{"type":"text","text":": ~40% fewer allocations on 500K-row tables vs. naive append."}],"type":"paragraph"},{"level":2,"anchor":"SCRAM-SHA-256-Authentication","text":"SCRAM-SHA-256 Authentication","type":"heading"},{"inlineContent":[{"type":"text","text":"Modern PostgreSQL (>= 14) defaults to "},{"type":"codeVoice","code":"scram-sha-256"},{"type":"text","text":" in "},{"code":"pg_hba.conf","type":"codeVoice"},{"type":"text","text":". "},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":"’s wire-protocol driver now supports the full RFC 5802 exchange:"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["Client                                    Server","  │  SASLInitialResponse(SCRAM-SHA-256)     │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLContinue(salt, i)    │","  │ ◄────────────────────────────────────── │","  │  SASLResponse(ClientProof)              │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLFinal + AuthOK       │","  │ ◄────────────────────────────────────── │"]},{"type":"heading","level":3,"text":"PBKDF2-SHA256 via CryptoKit","anchor":"PBKDF2-SHA256-via-CryptoKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SaltedPassword = Hi(password, salt, iterations)"},{"text":" derivation uses a pure Swift PBKDF2 loop over CryptoKit ","type":"text"},{"type":"codeVoice","code":"HMAC<SHA256>"},{"type":"text","text":":"}]},{"code":["var u = HMAC<SHA256>.authenticationCode(for: salt + [0,0,0,1], using: SymmetricKey(data: passwordData))","var saltedPassword = Array(u)","for _ in 1..<iterations {","    u = HMAC<SHA256>.authenticationCode(for: Data(u), using: ...)","    \/\/ XOR accumulate","}"],"type":"codeListing","syntax":"swift"},{"text":"Enabling SCRAM on PostgreSQL Server","type":"heading","anchor":"Enabling-SCRAM-on-PostgreSQL-Server","level":2},{"code":["-- pg_hba.conf","host  all  all  0.0.0.0\/0  scram-sha-256","","-- Verify in psql:","SELECT usename, passwd FROM pg_shadow;","-- Password should start with: SCRAM-SHA-256$4096:..."],"type":"codeListing","syntax":"sql"}]}],"sections":[],"metadata":{"modules":[{"name":"SwiftDatabase"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Security & Performance in SwiftDatabase"},"references":{"doc://SwiftDatabase/documentation/SwiftDatabase":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase","url":"\/documentation\/swiftdatabase","title":"SwiftDatabase","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Relational Database Connectors to DataFrames."}],"role":"collection"},"doc://SwiftDatabase/documentation/SwiftDatabase/DatabaseConnectors":{"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","url":"\/documentation\/swiftdatabase\/databaseconnectors","kind":"article","type":"topic","abstract":[{"type":"text","text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into "},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"role":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"abstract":[{"text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback.","type":"text"}],"type":"topic","kind":"article","role":"collectionGroup","title":"Bulk SQL Ingestion & Database Wire Protocols","url":"\/documentation\/swiftdatabase\/highthroughputingestion","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion"},"doc://SwiftDatabase/documentation/SwiftDatabase/PostgreSQLConnection":{"title":"PostgreSQLConnection","navigatorTitle":[{"text":"PostgreSQLCon