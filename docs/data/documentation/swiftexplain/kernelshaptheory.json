{"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftExplain"}],"title":"Game-Theoretic Interpretability with Kernel SHAP"},"abstract":[{"type":"text","text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory"},"topicSections":[{"title":"SHAP Explainer APIs","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"anchor":"SHAP-Explainer-APIs"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}],"type":"strong"},{"text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory.","type":"text"}]},{"type":"heading","level":2,"anchor":"1-The-Four-Shapley-Axioms","text":"1. The Four Shapley Axioms"},{"type":"paragraph","inlineContent":[{"text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Efficiency"}]},{"type":"text","text":": Feature attributions sum up to the difference between model prediction $f(x)$ and expected background prediction $E[f(X)]$:"},{"type":"text","text":" "},{"type":"text","text":"$$\\sum_{i=1}^{M} \\phi_i = f(x) - E[f(X)]$$"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Symmetry"}]},{"type":"text","text":": If two features contribute equally to all possible feature subsets, their attributions are equal."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dummy (Null Player)"}]},{"type":"text","text":": A feature that does not change the model prediction for any coalition receives an attribution of zero ($\\phi_i = 0$)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Additivity"}]},{"type":"text","text":": For ensemble models $f = f_1 + f_2$, attributions satisfy $\\phi_i(f) = \\phi_i(f_1) + \\phi_i(f_2)$."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"2-Explaining-Predictions-in-SwiftSci","text":"2. Explaining Predictions in SwiftSci"},{"type":"codeListing","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/kernelshaptheory"]}],"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","type":"topic","url":"\/documentation\/swiftexplain\/kernelshap","kind":"symbol","navigatorTitle":[{"text":"KernelSHAP","kind":"identifier"}],"abstract":[{"type":"text","text":"Model interpretation using the KernelSHAP algorithm."}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"KernelSHAP"}],"title":"KernelSHAP","role":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain":{"kind":"symbol","title":"SwiftExplain","url":"\/documentation\/swiftexplain","abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","type":"topic","role":"collection"}}}