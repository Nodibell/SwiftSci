{"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Spatial Indexing, Clustering & Outlier Detection","modules":[{"name":"SwiftCluster"}],"roleHeading":"Article","role":"article"},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"],"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Clustering and outlier detection algorithms often suffer from quadratic distance computation bottlenecks ("},{"type":"codeVoice","code":"O(N²)"},{"type":"text","text":"). "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" employs a balanced "},{"type":"strong","inlineContent":[{"text":"KD-Tree spatial index","type":"text"}]},{"type":"text","text":" reducing neighbor queries to "},{"type":"codeVoice","code":"O(N · log N)"},{"type":"text","text":", enabling instant processing of large spatial datasets."}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"text":"⚡ Spatial Indexing: KD-Tree vs Brute-Force","anchor":"%E2%9A%A1-Spatial-Indexing-KD-Tree-vs-Brute-Force","type":"heading"},{"alignments":["left","left","left","left"],"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Dataset Size (N)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Brute-Force DBSCAN (","type":"text"},{"code":"O(N²)","type":"codeVoice"},{"text":" Distance Matrix)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"SwiftCluster KD-Tree DBSCAN (","type":"text"},{"code":"O(N · log N)","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Speedup","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"1,000 points","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"42 ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"1.8 ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"23.3× faster","type":"text"}],"type":"strong"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"10,000 points","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"4,250 ms (4.25 s)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"28 ms","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"151.7× faster","type":"text"}],"type":"strong"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"100,000 points","type":"text"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Out of Memory (100k × 100k matrix = 80 GB RAM)","type":"text"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"380 ms (0.38 s)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"∞ (Memory Safe)","type":"text"}],"type":"strong"}]}]]],"type":"table"},{"type":"thematicBreak"},{"level":2,"text":"1. Density-Based Clustering (`DBSCAN`)","anchor":"1-Density-Based-Clustering-DBSCAN","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DBSCAN"},{"type":"text","text":" discovers clusters of arbitrary shapes and isolates noise points without requiring a pre-specified cluster count "},{"type":"codeVoice","code":"K"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import SwiftCluster","","\/\/ 1. Generate multi-cluster 2D coordinates","let cluster1 = (0..<100).map { _ in [Double.random(in: 0...2), Double.random(in: 0...2)] }","let cluster2 = (0..<100).map { _ in [Double.random(in: 10...12), Double.random(in: 10...12)] }","let noise = [[5.0, 5.0], [8.0, 2.0]]","let points = cluster1 + cluster2 + noise","","\/\/ 2. Initialize DBSCAN with spatial neighborhood epsilon and minPoints","let dbscan = DBSCAN(eps: 1.5, minSamples: 5)","let labels = dbscan.fit(points)","","\/\/ -1 indicates noise \/ outlier points, 0, 1, ... indicate cluster IDs","let clusterCount = Set(labels.filter { $0 >= 0 }).count","let noiseCount = labels.filter { $0 == -1 }.count","","print(\"DBSCAN identified \\(clusterCount) clusters and \\(noiseCount) noise outliers.\")"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"2. K-Means++ Clustering (`KMeans`)","anchor":"2-K-Means++-Clustering-KMeans","type":"heading"},{"inlineContent":[{"type":"text","text":"Fast centroid-based clustering using D² weighted probabilistic initialization for accelerated convergence:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftCluster","","let kmeans = KMeans(nClusters: 3, maxIterations: 100, tolerance: 1e-4, randomSeed: 42)","try await kmeans.fit(features: points)","","let centroids = await kmeans.centroids","print(\"Learned Centroids: \\(centroids)\")","","let clusterAssignments = try await kmeans.predict(features: points)","let inertia = try await kmeans.inertia(features: points)","print(\"Within-Cluster Sum of Squares (Inertia): \\(String(format: \"%.2f\", inertia))\")"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"3. Density-Based Outlier Detection (`LocalOutlierFactor`)","anchor":"3-Density-Based-Outlier-Detection-LocalOutlierFactor","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"LocalOutlierFactor"},{"type":"text","text":" measures local density deviation of an observation relative to its K-nearest neighbors:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftCluster","","let lof = LocalOutlierFactor(nNeighbors: 15, maxSamples: 5000)","let outlierLabels = try lof.fitPredict(points)","","\/\/ -1 indicates local density anomaly, +1 indicates inlier","let anomalies = outlierLabels.enumerated().filter { $0.element == -1 }.map { $0.offset }","print(\"LOF detected anomalies at indices: \\(anomalies)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"4. Isolation Forest for High-Dimensional Anomaly Detection","anchor":"4-Isolation-Forest-for-High-Dimensional-Anomaly-Detection","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"IsolationForest"},{"type":"text","text":" recursively partitions feature subspaces using random split hyperplanes. Anomalies require significantly fewer splits to isolate:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftCluster","","let isoForest = IsolationForest(nEstimators: 100, maxSamples: 256, contamination: 0.05, randomSeed: 42)","try await isoForest.fit(features: points)","","let anomalyScores = try await isoForest.decisionFunction(features: points)","let predictions = try await isoForest.predict(features: points)","","print(\"Isolation Forest predictions ready for \\(predictions.count) observations.\")"],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcluster\/clusteringandoutliers"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers"},"abstract":[{"text":"High-performance clustering and density-based anomaly detection powered by ","type":"text"},{"code":"KDTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DBSCAN","type":"codeVoice"},{"text":", ","type":"text"},{"code":"KMeans","type":"codeVoice"},{"text":", ","type":"text"},{"code":"LocalOutlierFactor","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"IsolationForest","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://SwiftCluster/documentation/SwiftCluster/VectorStoreAndRAG":{"abstract":[{"type":"text","text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate."}],"role":"collectionGroup","kind":"article","title":"In-Memory VectorStore & On-Device RAG","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","url":"\/documentation\/swiftcluster\/vectorstoreandrag"},"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"abstract":[{"type":"text","text":"Reduce feature dimensionality using SVD-based PCA with automatic CPU and UMA GPU routing."}],"role":"article","kind":"article","title":"Principal Component Analysis (PCA)","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","url":"\/documentation\/swiftcluster\/dimensionalityreduction"},"doc://SwiftCluster/documentation/SwiftCluster":{"abstract":[{"type":"text","text":"PCA Dimensionality Reduction & Unsupervised Clustering."}],"url":"\/documentation\/swiftcluster","kind":"symbol","role":"collection","title":"SwiftCluster","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster"},"doc://SwiftCluster/documentation/SwiftCluster/HNSWVectorSearch":{"abstract":[{"type":"text","text":"Scale approximate nearest neighbor (ANN) retrieval logarithmically using Hierarchical Navigable Small World graphs."}],"role":"collectionGroup","kind":"article","title":"High-Dimensional Vector Search with HNSW","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch","url":"\/documentation\/swiftcluster\/hnswvectorsearch"}}}