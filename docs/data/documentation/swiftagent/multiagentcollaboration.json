{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Complex analytical and reasoning workflows are frequently error-prone when performed by a single monolithic model. Decomposing problems into specialized roles—such as "},{"inlineContent":[{"type":"text","text":"Planner"}],"type":"strong"},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"Analyst"}],"type":"strong"},{"type":"text","text":", and "},{"inlineContent":[{"text":"Critic","type":"text"}],"type":"strong"},{"text":"—drastically improves reasoning accuracy, reduces hallucinations, and permits parallelized tool execution.","type":"text"}]},{"inlineContent":[{"type":"codeVoice","code":"SwiftAgent"},{"type":"text","text":" provides "},{"code":"MultiAgentOrchestrator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AgentMessageBus","type":"codeVoice"},{"text":", a reactive multi-agent framework built on Swift’s structured concurrency primitives (","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"withTaskGroup","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"text":"Architectural Topology","anchor":"Architectural-Topology","type":"heading","level":2},{"type":"codeListing","code":["                         ┌───────────────────────┐","                         │   User \/ Prompt Task  │","                         └───────────┬───────────┘","                                     │","                                     ▼","                       ┌───────────────────────────┐","                       │      AgentMessageBus      │","                       │       (AsyncStream)       │","                       └─────────────┬─────────────┘","                                     │ Broadcasts","         ┌───────────────────────────┼───────────────────────────┐","         ▼                           ▼                           ▼","┌──────────────────┐       ┌──────────────────┐       ┌──────────────────┐","│     Planner      │       │     Analyst      │       │      Critic      │","│ Decomposes steps │       │ Queries & Models │       │ Validates logic  │","└────────┬─────────┘       └────────┬─────────┘       └────────┬─────────┘","         │                          │                          │","         └──────────────────────────┼──────────────────────────┘","                                    │ Parallel Tool Calls","                                    ▼","                     ┌─────────────────────────────┐","                     │ MultiAgentOrchestrator      │","                     │ withTaskGroup Tool Executor │","                     └──────────────┬──────────────┘","                                    │","               ┌────────────────────┴────────────────────┐","               ▼                                         ▼","      DataFrame Query Tool                      Statistical Model Tool"],"syntax":null},{"anchor":"Parallel-Tool-Calling","type":"heading","level":2,"text":"Parallel Tool Calling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When an agent requests multiple tool executions in a single reasoning step (e.g. computing standard deviations across three columns concurrently), "},{"code":"MultiAgentOrchestrator.executeToolsInParallel(_:)","type":"codeVoice"},{"type":"text","text":" executes them simultaneously across available CPU cores using "},{"code":"withTaskGroup","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"This reduces total latency from $\\sum_{i=1}^M T_i$ to $\\max_{i} T_i$.","type":"text"}]},{"type":"heading","level":2,"anchor":"Example-Usage","text":"Example Usage"},{"code":["import SwiftAgent","import SwiftDataFrame","","\/\/ 1. Initialize orchestrator and message bus","let orchestrator = MultiAgentOrchestrator(maxRounds: 5)","","\/\/ 2. Register specialized agents","orchestrator.registerAgent(PlannerAgent())","orchestrator.registerAgent(DataAnalystAgent())","orchestrator.registerAgent(CriticAgent())","","\/\/ 3. Register tools","orchestrator.registerTool(DataFrameAgentTool(dataframe: salesData))","","\/\/ 4. Run collaborative execution","let solution = try await orchestrator.run(","    taskPrompt: \"Identify top 3 departments by salary variance and critique findings.\"",")","print(\"Consensus Answer: \\(solution)\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"title":"Multi-Agent Coordination & Protocols","roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftAgent"}]},"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/swiftagent\/multiagentcollaboration"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgenticReplAndRAG"]}],"abstract":[{"type":"text","text":"Orchestrate teams of specialized autonomous agents over an asynchronous message bus with concurrent parallel tool calling."}],"topicSections":[{"anchor":"Multi-Agent-Coordination","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentOrchestrator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessageBus","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessage","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolCall","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolResult","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SpecializedAgent"],"title":"Multi-Agent Coordination"}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"kind":"article","references":{"doc://SwiftAgent/documentation/SwiftAgent/SpecializedAgent":{"fragments":[{"kind":"k