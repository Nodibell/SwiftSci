{"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"abstract":[{"text":"Build low-latency semantic search, embedding retrieval, and Retrieval-Augmented Generation (RAG) pipelines on Apple Silicon using SIMD Accelerate.","type":"text"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftCluster"}],"title":"In-Memory VectorStore & On-Device RAG"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vector databases are essential for modern semantic search, AI agent memory, and Retrieval-Augmented Generation (RAG). "},{"type":"codeVoice","code":"SwiftCluster"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"VectorStore"},{"type":"text","text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations ("},{"type":"codeVoice","code":"vDSP_dotprD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_svesqD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_distancesqD"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For datasets up to 100,000 vectors, in-memory linear scans accelerated by Apple Silicon unified memory and NEON SIMD registers deliver sub-millisecond retrieval without the complexity, disk overhead, or C++ dependencies of external databases like Chroma or FAISS."}]},{"syntax":"mermaid","type":"codeListing","code":["graph LR","    Doc[Document \/ Text Chunk] --> Embed[SentenceEmbeddingProvider]","    Embed --> Vec[Dense Vector R^D]","    Vec --> Store[VectorStore In-Memory Index]","    Query[User Query] --> EmbedQuery[SentenceEmbeddingProvider]","    EmbedQuery --> QVec[Query Vector]","    QVec --> Search[Accelerate SIMD Top-K Search]","    Store --> Search","    Search --> Hits[Top-K Ranked Results + Metadata]"]},{"type":"thematicBreak"},{"anchor":"1-Supported-Distance--Similarity-Metrics","text":"1. Supported Distance & Similarity Metrics","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"VectorStore","type":"codeVoice"},{"type":"text","text":" supports three fundamental metric spaces via "},{"isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","type":"reference"},{"type":"text","text":":"}]},{"header":"row","alignments":["left","left","center","left"],"rows":[[[{"inlineContent":[{"type":"text","text":"Metric"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enum Case"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Range"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Ideal Use Case"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cosine Similarity"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".cosineSimilarity"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[-1.0, 1.0]"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Normalized or unnormalized text embeddings. Evaluates semantic angular closeness regardless of vector magnitude."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dot Product"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".dotProduct"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"(-inf, inf)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pre-normalized unit vectors ($|v|_2 = 1.0$), maximizing execution speed via direct single-pass multiply-accumulate."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Euclidean Distance"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".euclideanDistance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[0.0, inf)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Spatial clustering, image feature prints, physical embeddings. Lower values indicate closer proximity."}],"type":"paragraph"}]]],"type":"table"},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","","\/\/ Initialize with cosine similarity (default)","let store = VectorStore(metric: .cosineSimilarity)"]},{"type":"thematicBreak"},{"anchor":"2-Ingesting-Vectors--Metadata","text":"2. Ingesting Vectors & Metadata","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each item in the index is encapsulated in a "},{"isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorEntry","type":"reference"},{"type":"text","text":", storing a unique identifier, the dense numerical vector, and arbitrary string key-value metadata (such as document titles, URLs, timestamps, or raw text content)."}]},{"anchor":"Single-Entry-Ingestion","text":"Single Entry Ingestion","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["store.add(","    id: \"doc_101\",","    vector: [0.12, 0.85, -0.44, 0.31],","    metadata: [","        \"title\": \"Apple Silicon Architecture\",","        \"author\": \"Engineering Team\",","        \"category\": \"hardware\"","    ]",")"]},{"anchor":"High-Throughput-Batch-Ingestion","text":"High-Throughput Batch Ingestion","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"When ingesting thousands of document chunks, use "},{"code":"addBatch(entries:)","type":"codeVoice"},{"type":"text","text":" to minimize locking overhead:"}]},{"syntax":"swift","type":"codeListing","code":["let entries = chunks.enumerated().map { idx, chunk in","    VectorEntry(","        id: \"chunk_\\(idx)\",","        vector: embeddings[idx],","        metadata: [\"text\": chunk.text, \"doc_id\": chunk.documentId]","    )","}","","store.addBatch(entries: entries)","print(\"Indexed \\(store.count) vectors into VectorStore.\")"]},{"type":"thematicBreak"},{"anchor":"3-Top-K-Semantic-Similarity-Search","text":"3. Top-K Semantic Similarity Search","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"search(query:topK:)","type":"codeVoice"},{"type":"text","text":" to retrieve the most relevant vectors. The search uses a bounded collection pattern that avoids sorting the entire dataset, maintaining peak performance even as the collection grows."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Query with a high-dimensional vector","let queryVector: [Double] = [0.10, 0.82, -0.40, 0.29]","","\/\/ Retrieve Top-3 nearest neighbors","let results: [VectorSearchResult] = store.search(query: queryVector, topK: 3)","","for match in results {","    print(\"Match ID: \\(match.id)\")","    print(\"Similarity Score: \\(String(format: \"%.4f\", match.score))\")","    print(\"Document Title: \\(match.metadata[\"title\"] ?? \"Unknown\")\")","    print(\"---\")","}"]},{"anchor":"Relevance-Threshold-Filtering","text":"Relevance Threshold Filtering","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"In production RAG workflows, avoid hallucination by filtering out retrieved items that fall below a minimum semantic similarity threshold:"}]},{"syntax":"swift","type":"codeListing","code":["let minimumRelevanceThreshold = 0.70","let relevantHits = results.filter { $0.score >= minimumRelevanceThreshold }","","guard !relevantHits.isEmpty else {","    print(\"No relevant context found above threshold.\")","    return","}"]},{"type":"thematicBreak"},{"anchor":"4-Index-Lifecycle--Thread-Safety","text":"4. Index Lifecycle & Thread Safety","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"VectorStore","type":"codeVoice"},{"type":"text","text":" is thread-safe ("},{"code":"@unchecked Sendable","type":"codeVoice"},{"type":"text","text":") and guarded by internal "},{"code":"NSLock","type":"codeVoice"},{"type":"text","text":" synchronization, making it safe to query and update concurrently across Swift "},{"code":"Task","type":"codeVoice"},{"type":"text","text":" groups and actors."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Check existence","let exists = store.contains(id: \"doc_101\")","","\/\/ Retrieve raw vector entry","if let entry = store.get(id: \"doc_101\") {","    print(\"Retrieved dimension: \\(entry.vector.count)\")","}","","\/\/ Remove obsolete documents","let wasRemoved = store.remove(id: \"doc_101\")","","\/\/ Purge index","store.clear()"]},{"type":"thematicBreak"},{"anchor":"5-Scaling-to-Large-Collections-with-HNSW","text":"5. Scaling to Large Collections with HNSW","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When vector collections grow beyond 100,000 items, linear scans ($O(N)$) may exceed interactive latency budgets. "},{"code":"SwiftCluster","type":"codeVoice"},{"type":"text","text":" provides "},{"isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex","type":"reference"},{"type":"text","text":" (Hierarchical Navigable Small World), an approximate nearest neighbor graph offering $O(\\log N)$ search latency."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Initialize an HNSW graph index","let hnsw = HNSWIndex(","    metric: .cosineSimilarity,","    M: 16,               \/\/ Number of bi-directional links per node","    efConstruction: 200, \/\/ Search depth during index construction","    efSearch: 50         \/\/ Search depth during query time",")","","\/\/ Ingest into HNSW graph","for entry in entries {","    await hnsw.add(id: entry.id, vector: entry.vector, metadata: entry.metadata)","}","","\/\/ Sub-millisecond ANN search across 500,000 vectors","let annResults = await hnsw.search(query: queryVector, topK: 5)"]},{"type":"thematicBreak"},{"anchor":"6-Persistence--Serialization","text":"6. Persistence & Serialization","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because "},{"isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorEntry","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","type":"reference"},{"type":"text","text":" conform to "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":", an entire vector store can be saved to disk as compressed JSON or binary Property List, and restored at application launch:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Export vector store entries to JSON Data","func exportStore(store: VectorStore) throws -> Data {","    \/\/ Collect all entries (or maintain a list during ingestion)","    let encoder = JSONEncoder()","    return try encoder.encode(entries)","}","","\/\/ Restore store from disk","func importStore(from data: Data) throws -> VectorStore {","    let decoder = JSONDecoder()","    let loadedEntries = try decoder.decode([VectorEntry].self, from: data)","    let store = VectorStore(metric: .cosineSimilarity)","    store.addBatch(entries: loadedEntries)","    return store","}"]},{"type":"thematicBreak"},{"anchor":"7-Complete-On-Device-Semantic-Search-Example","text":"7. Complete On-Device Semantic Search Example","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["import SwiftCluster","import SwiftNLP","","\/\/ 1. Initialize sentence embedding provider and vector store","let embeddingEngine = try AppleSentenceEmbeddingEngine(language: .english)","let vectorStore = VectorStore(metric: .cosineSimilarity)","","\/\/ 2. Sample documents to index","let corpus = [","    \"SwiftSci utilizes Apple Accelerate SIMD kernels for linear algebra.\",","    \"MLX provides unified memory GPU tensor computation on macOS.\",","    \"Autoregressive LLM decoders leverage KV-caches to optimize throughput.\",","    \"Pandas-like DataFrame operations in Swift support typed column queries.\"","]","","\/\/ 3. Vectorize and ingest corpus","for (idx, text) in corpus.enumerated() {","    let vector = try embeddingEngine.embed(text)","    vectorStore.add(","        id: \"doc_\\(idx)\",","        vector: vector,","        metadata: [\"content\": text]","    )","}","","\/\/ 4. Query vector store","let query = \"How does SwiftSci accelerate vector operations?\"","let queryVector = try embeddingEngine.embed(query)","let topMatches = vectorStore.search(query: queryVector, topK: 1)","","if let bestMatch = topMatches.first {","    print(\"Top match (Score: \\(bestMatch.score)):\")","    print(bestMatch.metadata[\"content\"] ?? \"\")","}"]},{"type":"thematicBreak"}]}],"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorEntry","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex"],"title":"Vector Store Types","anchor":"Vector-Store-Types"}],"kind":"article","sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"],"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcluster\/vectorstoreandrag"]}],"references":{"doc://SwiftCluster/documentation/SwiftCluster/VectorSearchResult":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"VectorSearchResult"}],"url":"\/documentation\/swiftcluster\/vectorsearchresult","abstract":[{"text":"Represents a single nearest-neighbor match result from a vector search query.","type":"text"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"VectorSearchResult"}],"type":"topic","title":"VectorSearchResult"},"doc://SwiftCluster/documentation/SwiftCluster":{"abstract":[{"text":"PCA Dimensionality Reduction & Unsupervised Clustering.","type":"text"}],"title":"SwiftCluster","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/swiftcluster"},"doc://SwiftCluster/documentation/SwiftCluster/HNSWVectorSearch":{"kind":"article","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch","type":"topic","abstract":[{"type":"text","text":"Scale approximate nearest neighbor (ANN) retrieval logarithmically using Hierarchical Navigable Small World graphs."}],"url":"\/documentation\/swiftcluster\/hnswvectorsearch","role":"collectionGroup","title":"High-Dimensional Vector Search with HNSW"},"doc://SwiftCluster/documentation/SwiftCluster/VectorMetric":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"VectorMetric"}],"url":"\/documentation\/swiftcluster\/vectormetric","navigatorTitle":[{"kind":"identifier","text":"VectorMetric"}],"type":"topic","title":"VectorMetric","abstract":[{"text":"Distance or similarity metrics supported by ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","role":"symbol"},"doc://SwiftCluster/documentation/SwiftCluster/VectorEntry":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VectorEntry","kind":"identifier"}],"url":"\/documentation\/swiftcluster\/vectorentry","abstract":[{"type":"text","text":"Represents an item stored inside a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorEntry","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"VectorEntry"}],"type":"topic","title":"VectorEntry"},"doc://SwiftCluster/documentation/SwiftCluster/HNSWIndex":{"kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"text":"HNSWIndex","kind":"identifier"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex","type":"topic","url":"\/documentation\/swiftcluster\/hnswindex","abstract":[{"text":"A hierarchical navigable small world graph index for sub-millisecond approximate nearest neighbor search.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"HNSWIndex"}],"role":"symbol","title":"HNSWIndex"},"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"kind":"article","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","type":"topic","url":"\/documentation\/swiftcluster\/dimensionalityreduction","abstract":[{"text":"Reduce high-dimensional feature spaces, uncover latent structures, and visualize complex datasets using PCA, Randomized SVD, and t-SNE.","type":"text"}],"role":"collectionGroup","title":"Dimensionality Reduction & Manifold Learning"},"doc://SwiftCluster/documentation/SwiftCluster/ClusteringAndOutliers":{"abstract":[{"text":"High-performance clustering and density-based anomaly detection powered by ","type":"text"},{"code":"KDTree","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DBSCAN","type":"codeVoice"},{"text":", ","type":"text"},{"code":"KMeans","type":"codeVoice"},{"text":", ","type":"text"},{"code":"LocalOutlierFactor","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"IsolationForest","type":"codeVoice"},{"text":".","type":"text"}],"title":"Spatial Indexing, Clustering & Outlier Detection","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","type":"topic","kind":"article","role":"article","url":"\/documentation\/swiftcluster\/clusteringandoutliers"},"doc://SwiftCluster/documentation/SwiftCluster/VectorStore":{"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"VectorStore"}],"url":"\/documentation\/swiftcluster\/vectorstore","navigatorTitle":[{"kind":"identifier","text":"VectorStore"}],"type":"topic","title":"VectorStore","abstract":[{"text":"An in-memory vector database and similarity search index optimized for Apple Silicon.","type":"text"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","role":"symbol"}}}