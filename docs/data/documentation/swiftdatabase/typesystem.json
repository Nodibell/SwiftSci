{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiftDatabase"},{"text":" module bridges the gap between relational SQL storage engines and Swift’s type-safe, actor-isolated data ecosystem. Traditional database client libraries often convert SQL fields to intermediate strings or untyped objects, imposing significant heap allocation overhead and potential loss of numeric precision.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnySendableValue"},{"type":"text","text":" provides a unified, zero-copy, enum-based abstraction covering primary relational types:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"64-bit IEEE 754 floating point numbers ("},{"type":"codeVoice","code":".double"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Standard host-width integers ("},{"code":".int","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Explicit 64-bit signed integers ("},{"code":".int64","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"UTF-8 text strings (","type":"text"},{"type":"codeVoice","code":".string"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Boolean flags ("},{"code":".bool","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"High-precision timestamps ("},{"code":".date","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Raw byte buffers ("},{"code":".data","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[