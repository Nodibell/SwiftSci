{"metadata":{"modules":[{"name":"SwiftDataFrame"}],"title":"Getting Started with SwiftSci DataFrame","roleHeading":"Article","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/gettingstarted"]}],"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/GettingStarted","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"kind":"article","abstract":[{"type":"text","text":"A complete guide to columnar data loading, O(1) indexing, zero-allocation row iteration, group-by aggregations, joins, and machine learning exports."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"anchor":"Core-Guides","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/EmptyRowSelections","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/MachineLearningWorkflow","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TimeSeriesForecasting"],"generated":true,"title":"Core Guides"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" is an immutable, columnar data analysis engine built natively in Swift 6 for Apple Silicon. It combines Apache Arrow \/ Feather zero-copy memory buffers, O(1) schema lookups, and SIMD bitmask filtering.","type":"text"}]},{"code":["DataFrame (Value Type: Immutable Struct + Copy-On-Write)","┌─────────────────────────────────────────────────────────────┐","│ Schema (FieldMap: O(1) dictionary lookup by column name)    │","├─────────────────────────────────────────────────────────────┤","│ Column 0: TypedColumn<Int64>   [ 101, 102, 103, 104 ]       │","│ Column 1: TypedColumn<String>  [ \"A\", \"B\", \"A\", nil ]       │","│ Column 2: TypedColumn<Double>  [ 12.5, 45.0, 33.2, 98.1 ]   │","└─────────────────────────────────────────────────────────────┘"],"type":"codeListing","syntax":null},{"type":"thematicBreak"},{"type":"heading","level":2,"anchor":"1-Loading-Datasets-CSV-Feather--Parquet","text":"1. Loading Datasets (CSV, Feather & Parquet)"},{"inlineContent":[{"type":"text","text":"Load data from local files or memory buffers using streaming asynchronous APIs:"}],"type":"paragraph"},{"code":["import Foundation","import SwiftDataFrame","","\/\/ 1. Load CSV with automatic delimiter and type inference","let csvURL = URL(fileURLWithPath: \"passengers.csv\")","let df = try await DataFrame(csv: csvURL)","","print(\"Loaded DataFrame: \\(df.shape.rows) rows x \\(df.shape.columns) columns\")","df.head(5).debugPrint()","","\/\/ 2. Load binary Feather \/ Apache Arrow IPC format (Zero-Copy)","let featherURL = URL(fileURLWithPath: \"dataset.feather\")","let featherDF = try await DataFrame(feather: featherURL)","","\/\/ 3. Load compressed Apache Parquet format","let parquetURL = URL(fileURLWithPath: \"telemetry.parquet\")","let parquetDF = try await DataFrame(parquet: parquetURL)"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","level":2,"anchor":"2-O1-Column-Access--Zero-Allocation-Row-Iteration","text":"2. O(1) Column Access & Zero-Allocation Row Iteration"},{"inlineContent":[{"text":"Access typed columns by name or iterate through rows using ","type":"text"},{"type":"codeVoice","code":"DataFrameRowSequence"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ 1. O(1) Typed Column Subscript","if let ageCol = df[column: \"Age\", as: Double.self] {","    let meanAge = ageCol.mean","    print(\"Mean Age: \\(meanAge ?? 0.0)\")","}","","\/\/ 2. Zero-Allocation Row Iteration (Bypasses heap dictionary creation)","for row in df.rows {","    if let city = row.string(\"City\"), let score = row.double(\"Score\") {","        if score > 90.0 {","            print(\"Top Performer in \\(city): Score = \\(score)\")","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"3. High-Performance Filtering & Feature Transformation","level":2,"anchor":"3-High-Performance-Filtering--Feature-Transformation","type":"heading"},{"inlineContent":[{"text":"Filter datasets using SIMD bitmasks or transform columns functional-style:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ 1. Fast condition-based filtering","let filtered = try df.filter(column: \"Fare\", where: .greaterThan(50.0))","","\/\/ 2. Predicate filter closure","let adultFirstClass = df.filter { row in","    (row.int(\"Pclass\") == 1) && ((row.double(\"Age\") ?? 0) >= 18.0)","}","","\/\/ 3. Add calculated feature column","let engineeredDF = try df.addColumn(\"FarePerYear\", as: Double.self) { row in","    guard let fare = row.double(\"Fare\"), let age = row.double(\"Age\"), age > 0 else { return nil }","    return fare \/ age","}"],"type":"codeListing"},{"type":"thematicBreak"},{"text":"4. GroupBy Aggregations & Joins","level":2,"anchor":"4-GroupBy-Aggregations--Joins","type":"heading"},{"inlineContent":[{"text":"Group by categorical columns and aggregate numeric columns:","type":"text"}],"type":"paragraph"},{"code":["\/\/ 1. GroupBy with Mean Aggregation","let deptAverages = df.groupBy(\"Department\").mean()","deptAverages.debugPrint()","","\/\/ 2. High-Performance SIMD Hash Join","let employees = try DataFrame(columns: [","    TypedColumn<Int64>(name: \"id\", values: [1, 2, 3]),","    TypedColumn<String>(name: \"name\", values: [\"Alice\", \"Bob\", \"Charlie\"])","])","let departments = try DataFrame(columns: [","    TypedColumn<Int64>(name: \"id\", values: [1, 2, 3]),","    TypedColumn<String>(name: \"dept\", values: [\"AI\", \"Cloud\", \"Security\"])","])","","let merged = try employees.join(departments, on: \"id\", how: .inner)","merged.debugPrint()"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"text":"5. Exporting Flat 1D Matrices for ML","level":2,"anchor":"5-Exporting-Flat-1D-Matrices-for-ML","type":"heading"},{"inlineContent":[{"text":"Export tabular data directly into contiguous flat buffers for machine learning training:","type":"text"}],"type":"paragraph"},{"code":["let (flatMatrix, rows, cols) = try df.toFlatFeatureMatrix([\"Age\", \"Fare\", \"Pclass\"])","print(\"Generated flat feature matrix: \\(rows) samples x \\(cols) features.\")"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/TimeSeriesForecasting":{"role":"article","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TimeSeriesForecasting","title":"Time Series Decomposition & Forecasting with SwiftForecast","abstract":[{"type":"text","text":"Perform classical time series decomposition, SARIMA forecasting, and Kalman filtering."}],"type":"topic","kind":"article","url":"\/documentation\/swiftdataframe\/timeseriesforecasting"},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"abstract":[{"text":"High-Performance Columnar Data Tables built on Apache Arrow.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame","url":"\/documentation\/swiftdataframe","role":"collection","title":"SwiftDataFrame"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/MachineLearningWorkflow":{"url":"\/documentation\/swiftdataframe\/machinelearningworkflow","kind":"article","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/MachineLearningWorkflow","role":"article","abstract":[{"type":"text","text":"End-to-end Machine Learning pipelines using "},{"code":"SwiftML","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiftPreprocessing","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SwiftCluster","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","title":"Machine Learning Workflow with SwiftML"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/EmptyRowSelections":{"role":"article","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/EmptyRowSelections","title":"Empty row selections","abstract":[{"type":"text","text":"Row selection preserves column names, column order, and column types even when the result has no rows. Every retained column then has zero values and a null count of zero. The source dataframe remains unchanged."}],"type":"topic","kind":"article","url":"\/documentation\/swiftdataframe\/emptyrowselections"}}}