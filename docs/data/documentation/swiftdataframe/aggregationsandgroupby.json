{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory.","type":"text"}]},{"level":2,"text":"1. Basic GroupBy Aggregation","type":"heading","anchor":"1-Basic-GroupBy-Aggregation"},{"syntax":"swift","type":"codeListing","code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"]},{"level":2,"text":"2. Multi-Column Grouping","type":"heading","anchor":"2-Multi-Column-Grouping"},{"type":"paragraph","inlineContent":[{"text":"You can group by multiple categorical dimensions simultaneously:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"]},{"level":2,"text":"3. Performance & Memory Efficiency","type":"heading","anchor":"3-Performance--Memory-Efficiency"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Single-Pass Hash Accumulation","type":"text"}]},{"type":"text","text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"vDSP Vector Reductions"}]},{"type":"text","text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines ("},{"type":"codeVoice","code":"vDSP_sveD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_meanvD"},{"type":"text","text":")."}]}]}]}]}],"kind":"article","identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"sections":[],"topicSections":[{"identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"],"anchor":"Grouping-APIs","title":"Grouping APIs"},{"title":"Exact integer totals","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/CheckedIntegerSums"],"anchor":"Exact-integer-totals"}],"variants":[{"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame."}],"metadata":{"role":"collectionGroup","title":"High-Performance GroupBy & Vectorized Aggregations","roleHeading":"API Collection","modules":[{"name":"SwiftDataFrame"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"kind":"symbol","title":"groupBy(_:)","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)","role":"symbol","abstract":[{"text":"Returns a ","type":"text"},{"code":"GroupedDataFrame","type":"codeVoice"},{"text":" for aggregation.","type":"text"}],"type":"topic","fragments"