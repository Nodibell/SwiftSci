{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Permutation Feature Importance","type":"text"}]},{"text":" measures how much a trained model’s error increases when a single feature column is randomly shuffled, breaking the relationship between that feature and the target outcome.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Importance Metric:","type":"text"}]},{"text":" ","type":"text"},{"code":"Importance(f_j) = Loss(X_shuffled(j), y) - Loss(X, y)","type":"codeVoice"}]}],"name":"Note","type":"aside"},{"text":"1. Computing Permutation Importance","level":2,"anchor":"1-Computing-Permutation-Importance","type":"heading"},{"syntax":"swift","code":["import SwiftExplain","import SwiftML","","let importance = try await PermutationImportance.compute(","    model: trainedModel,","    features: X_val,","    targets: y_val,","    metric: .meanSquaredError,","    nRepeats: 10",")","","for (idx, score) in importance.enumerated() {","    print(\"Feature \\(idx): Mean drop = \\(score.mean), Std = \\(score.std)\")","}"],"type":"codeListing"}]}],"metadata":{"modules":[{"name":"SwiftExplain"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Permutation Feature Importance & Model Diagnostics"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationFeatureImportance"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"kind":"article","variants":[{"paths":["\/documentation\/swiftexplain\/permutationfeatureimportance"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationImportance"],"anchor":"Diagnostic-Tools",