{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"kind":"article","seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","generated":true,"identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Time series observations often display temporal autocorrelation, stochastic drift, and repetitive seasonal cycles. "},{"code":"SwiftForecast","type":"codeVoice"},{"type":"text","text":" provides high-performance, actor-isolated statistical models optimized with Apple Accelerate SIMD linear algebra:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","isActive":true}],"type":"strong"},{"type":"text","text":": Models non-seasonal series using $(p, d, q)$ specifications with vectorized two-stage Hannan-Rissanen conditional least-squares parameter estimation ("},{"code":"aic()","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"bic()","type":"codeVoice"},{"type":"text","text":" evaluate the Gaussian residual-MSE criterion from conditional OLS residuals, rather than exact state-space MLE)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel"}],"type":"strong"},{"type":"text","text":": Extends ARIMA to capture multiplicative seasonal cycles $(p, d, q) \\times (P, D, Q)_s$ via polynomial cross-term refinement."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Performs parallelized grid search over potential order permutations, selecting optimal configurations via AIC or BIC criteria.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"codeListing","code":["graph TD","    RawSeries[Raw Time Series Y_t] --> StationarityCheck{Requires Differencing?}","    StationarityCheck -->|Yes| Diff[Differencing: d order \/ Seasonal D order]","    StationarityCheck -->|No| ModelChoice{Model Selection}","    Diff --> ModelChoice","    ModelChoice -->|Manual Specification| FitARIMA[ARIMAModel \/ SARIMAModel]","    ModelChoice -->|Automated Grid Search| Auto[AutoARIMA Task Group]","    Auto --> BestOrder[Optimal Order via AIC\/BIC]","    BestOrder --> FitARIMA","    FitARIMA --> ForecastResult[ARIMAResult: Point Forecasts + Confidence Intervals]","    ForecastResult --> WAPE[WAPE \/ sMAPE Evaluation]"],"syntax":"mermaid"},{"type":"thematicBreak"},{"type":"heading","anchor":"1-Non-Seasonal-ARIMA-Modeling","level":2,"text":"1. Non-Seasonal ARIMA Modeling"},{"type":"paragraph","inlineContent":[{"text":"An $\\text{ARIMA}(p, d, q)$ model combines:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"$p$ (Autoregressive Order)","type":"text"}]},{"type":"text","text":": Dependence on preceding $p$ lagged values."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"$d$ (Differencing Order)"}]},{"type":"text","text":": Degree of differencing required to achieve weak stationarity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"$q$ (Moving Average Order)"}]},{"type":"text","text":": Dependence on preceding $q$ white-noise forecast errors."}]}]}]},{"type":"heading","anchor":"Fitting-and-Multi-Step-Forecasting","level":3,"text":"Fitting and Multi-Step Forecasting"},{"syntax":"swift","type":"codeListing","code":["import SwiftForecast","","\/\/ 1. Initialize historical series (e.g., monthly sales)","let monthlySales: [Double] = [","    112, 118, 132, 129, 121, 135, 148, 148, 136, 119, 104, 118,","    115, 126, 141, 135, 125, 149, 170, 170, 158, 133, 114, 140","]","","\/\/ 2. Initialize actor-isolated ARIMA(1, 1, 1) model","let arima = try ARIMAModel(p: 1, d: 1, q: 1)","","\/\/ 3. Fit parameters via Hannan-Rissanen conditional least-squares","try await arima.fit(series: monthlySales)","","\/\/ 4. Generate out-of-sample forecast for next 6 horizons","let result = try await arima.forecast(horizon: 6)","","print(\"Point Forecasts: \\(result.pointForecasts)\")","if let lower = result.lowerConfidenceInterval, let upper = result.upperConfidenceInterval {","    for i in 0..<result.pointForecasts.count {","        print(\"t+\\(i + 1): \\(String(format: \"%.1f\", result.pointForecasts[i])) [95% CI: \\(String(format: \"%.1f\", lower[i])) – \\(String(format: \"%.1f\", upper[i]))]\")","    }","}"]},{"type":"thematicBreak"},{"type":"heading","anchor":"2-Seasonal-SARIMA-Modeling","level":2,"text":"2. Seasonal SARIMA Modeling"},{"type":"paragraph","inlineContent":[{"text":"When data exhibits recurring seasonal patterns (such as quarterly retail spikes or 24-hour diurnal rhythms), standard non-seasonal differencing is insufficient.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","isActive":true},{"type":"text","text":" incorporates multiplicative seasonal operators:"}]},{"type":"paragraph","inlineContent":[{"text":"$$(p, d, q) \\times (P, D, Q)_s$$","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"where:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"$s$","type":"text"}],"type":"strong"},{"text":": Seasonal period length ($s=4$ for quarterly, $s=12$ for monthly, $s=7$ for daily data).","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"$P, D, Q$","type":"text"}],"type":"strong"},{"text":": Seasonal autoregressive, seasonal differencing, and seasonal moving-average orders.","type":"text"}],"type":"paragraph"}]}]},{"code":["import SwiftForecast","","\/\/ Initialize SARIMA(1, 1, 1) x (1, 1, 0)_12 for monthly seasonal data","let sarima = try SARIMAModel(","    p: 1, d: 1, q: 1,","    P: 1, D: 1, Q: 0,","    s: 12",")","","try await sarima.fit(series: monthlySales)","","\/\/ Forecast 12 months ahead","let seasonalForecast = try await sarima.forecast(horizon: 12)","print(\"12-Month Ahead Forecast: \\(seasonalForecast.pointForecasts)\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"3-Automated-Order-Selection-AutoARIMA","type":"heading","text":"3. Automated Order Selection (`AutoARIMA`)","level":2},{"type":"paragraph","inlineContent":[{"text":"Determining optimal $(p, d, q)$ and $(P, D, Q)_s$ orders manually through autocorrelation (ACF) and partial autocorrelation (PACF) plots can be labor-intensive. ","type":"text"},{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","isActive":true,"type":"reference"},{"text":" evaluates an exhaustive or bounded grid concurrently across Apple Silicon CPU cores, penalizing complexity with AIC or BIC:","type":"text"}]},{"code":["import SwiftForecast","","\/\/ Initialize automated grid search engine","let autoArima = AutoARIMA(","    maxP: 3,","    maxD: 2,","    maxQ: 3,","    seasonal: true,","    seasonalPeriod: 12,","    criterion: .aic",")","","\/\/ Search across candidate permutations","let searchResult = try await autoArima.fit(series: monthlySales)","","print(\"Selected Optimal Order: \\(searchResult.bestOrder)\")","\/\/ Example: SARIMA(1, 1, 1)(0, 1, 1)[12]","print(\"Optimal AIC Score: \\(searchResult.bestScore)\")","","\/\/ Forecast directly using the winning model","let bestForecast = try await searchResult.forecast(horizon: 6)","print(\"Best Forecast: \\(bestForecast.pointForecasts)\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"anchor":"4-Forecasting-Accuracy-with-TimeSeriesMetrics","type":"heading","text":"4. Forecasting Accuracy with `TimeSeriesMetrics`","level":2},{"type":"paragraph","inlineContent":[{"text":"Validate predictions against holdout test folds using standard metric evaluators, including Weighted Absolute Percentage Error (WAPE):","type":"text"}]},{"code":["import SwiftForecast","","let actuals: [Double] = [150.0, 162.0, 180.0, 175.0, 160.0, 142.0]","let predictions = result.pointForecasts","","let wapeError = TimeSeriesMetrics.wape(actual: actuals, forecast: predictions)","let smapeError = TimeSeriesMetrics.smape(actual: actuals, forecast: predictions)","let rmseError = TimeSeriesMetrics.rmse(actual: actuals, forecast: predictions)","","print(\"WAPE: \\(String(format: \"%.2f%%\", wapeError * 100))\")","print(\"sMAPE: \\(String(format: \"%.2f%%\", smapeError * 100))\")","print(\"RMSE: \\(String(format: \"%.2f\", rmseError))\")"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Forecasting Models","anchor":"Forecasting-Models","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/TimeSeriesMetrics"]}],"abstract":[{"type":"text","text":"Forecast univariate time series with trends and periodic seasonalities using Autoregressive Integrated Moving Average (ARIMA), Seasonal ARIMA (SARIMA), and Automated Order Selection (AutoARIMA)."}],"variants":[{"paths":["\/documentation\/swiftforecast\/arimaandsarima"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftForecast"}],"title":"ARIMA & SARIMA Time Series Models"},"references":{"doc://SwiftForecast/documentation/SwiftForecast/TimeSeriesMetrics":{"navigatorTitle":[{"kind":"identifier","text":"TimeSeriesMetrics"}],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimeSeriesMetrics"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/TimeSeriesMetrics","role":"symbol","url":"\/documentation\/swiftforecast\/timeseriesmetrics","abstract":[{"type":"text","text":"Canonical evaluation metrics for time-series forecasting and out-of-sample validation (G-020)."}],"title":"TimeSeriesMetrics"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMA":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AutoARIMA"}],"url":"\/documentation\/swiftforecast\/autoarima","abstract":[{"type":"text","text":"Automated hyperparameter grid search for ARIMA and SARIMA time-series models."}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","title":"AutoARIMA","type":"topic","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoARIMA","kind":"identifier"}]},"doc://SwiftForecast/documentation/SwiftForecast/SARIMAModel":{"kind":"symbol","abstract":[{"type":"text","text":"Seasonal AutoRegressive Integrated Moving Average (SARIMA) time-series forecasting model actor."}],"title":"SARIMAModel","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SARIMAModel"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SARIMAModel","type":"topic","url":"\/documentation\/swiftforecast\/sarimamodel","navigatorTitle":[{"text":"SARIMAModel","kind":"identifier"}],"role":"symbol"},"doc://SwiftForecast/documentation/SwiftForecast/ARIMAModel":{"title":"ARIMAModel","abstract":[{"text":"AutoRegressive Integrated Moving Average (ARIMA) time-series forecasting model actor.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ARIMAModel","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ARIMAModel","kind":"identifier"}],"navigatorTitle":[{"text":"ARIMAModel","kind":"identifier"}],"url":"\/documentation\/swiftforecast\/arimamodel","role":"symbol","type":"topic"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAParallel":{"url":"\/documentation\/swiftforecast\/autoarimaparallel","kind":"article","type":"topic","title":"Concurrent Order Selection with AutoARIMA","abstract":[{"text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency.","type":"text"}],"role":"collectionGroup","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel"},"doc://SwiftForecast/documentation/SwiftForecast/SmoothingAndDecomposition":{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","title":"Time Series Forecasting, Smoothing & Kalman Filtering","url":"\/documentation\/swiftforecast\/smoothinganddecomposition","role":"article","type":"topic","kind":"article","abstract":[{"text":"Model trends, seasonality, volatility, and dynamic state transitions using ","type":"text"},{"code":"ExponentialSmoothing","type":"codeVoice"},{"text":", ","type":"text"},{"code":"NelderMead","type":"codeVoice"},{"text":", ","type":"text"},{"code":"KalmanFilter","type":"codeVoice"},{"text":", ","type":"text"},{"code":"GARCHModel","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"TimeSeriesDecomposition","type":"codeVoice"},{"text":".","type":"text"}]},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAOrder":{"kind":"symbol","url":"\/documentation\/swiftforecast\/autoarimaorder","abstract":[{"text":"A structure identifying the selected ARIMA \/ SARIMA order.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoARIMAOrder"}],"navigatorTitle":[{"kind":"identifier","text":"AutoARIMAOrder"}],"type":"topic","role":"symbol","title":"AutoARIMAOrder","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder"},"doc://SwiftForecast/documentation/SwiftForecast":{"role":"collection","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast","type":"topic","abstract":[{"text":"Time Series & Volatility Forecasting Models.","type":"text"}],"title":"SwiftForecast","url":"\/documentation\/swiftforecast","kind":"symbol"},"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"kind":"symbol","abstract":[{"type":"text","text":"Koopman Operator time-series forecasting and dynamical system modeling actor."},{"type":"text","text":" "},{"type":"text","text":"Uses Extended Dynamic Mode Decomposition (EDMD) to approximate non-linear dynamics"},{"type":"text","text":" "},{"type":"text","text":"via linear operators in lifted observable feature spaces."}],"title":"KoopmanOperator","fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"text":"KoopmanOperator","kind":"identifier"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator","type":"topic","url":"\/documentation\/swiftforecast\/koopmanoperator","navigatorTitle":[{"text":"KoopmanOperator","kind":"identifier"}],"role":"symbol"}}}