:"AutoARIMA"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMACriterion","kind":"symbol","title":"AutoARIMACriterion"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMA":{"url":"\/documentation\/swiftforecast\/autoarima","navigatorTitle":[{"text":"AutoARIMA","kind":"identifier"}],"role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoARIMA","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Automated hyperparameter grid search for ARIMA and SARIMA time-series models."}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","kind":"symbol","title":"AutoARIMA"},"doc://SwiftForecast/documentation/SwiftForecast/SmoothingAndDecomposition":{"url":"\/documentation\/swiftforecast\/smoothinganddecomposition","role":"article","type":"topic","abstract":[{"text":"Model trends, seasonality, volatility, and dynamic state transitions using ","type":"text"},{"type":"codeVoice","code":"ExponentialSmoothing"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NelderMead"},{"text":", ","type":"text"},{"type":"codeVoice","code":"KalmanFilter"},{"text":", ","type":"text"},{"type":"codeVoice","code":"GARCHModel"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"TimeSeriesDecomposition"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","kind":"article","title":"Time Series Forecasting, Smoothing & Kalman Filtering"},"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"url":"\/documentation\/swiftforecast\/koopmanoperator","navigatorTitle":[{"kind":"identifier","text":"KoopmanOperator"}],"role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KoopmanOperator","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Koopman Operator time-series forecasting and dynamical system