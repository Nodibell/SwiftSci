{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization"},"sections":[],"abstract":[{"type":"text","text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native "},{"type":"codeVoice","code":"NaturalLanguage"},{"type":"text","text":" framework."}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftNLP"}],"role":"article","title":"Text Normalization, Tokenization & Linguistic Tagging"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","text":"1. Multi-lingual Word & Sentence Tokenization","type":"heading"},{"syntax":"swift","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"],"type":"codeListing"},{"level":3,"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","text":"2. POS Tagging, Lemmatization & Entity Extraction","type":"heading"},{"syntax":"swift","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"],"type":"codeListing"},{"text":"3. Sentiment Analysis (VADER & NLSentiment)","level":3,"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","type":"heading"},{"syntax":"swift","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"],"type":"codeListing"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"generated":true}],"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","references":{"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"type":"topic","title":"Text Feature Vectorization, Embeddings & Naive Bayes Classification","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","url":"\/documentation\/swiftnlp\/vectorizationandembeddings","role":"article","kind":"article","abstract":[{"type":"text","text":"Convert text corpora into numerical feature matrices using "},{"code":"CountVectorizer","type":"codeVoice"},{"type":"text","text":", "},{"code":"HashingVectorizer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"TFIDFVectorizer","type":"codeVoice"},{"type":"text","text":", query "},{"type":"codeVoice","code":"WordEmbeddings"},{"type":"text","text":" and "},{"type":"codeVo