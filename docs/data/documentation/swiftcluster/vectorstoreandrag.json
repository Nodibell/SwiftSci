{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Vector databases are essential for modern semantic search and AI agent knowledge retrieval. ","type":"text"},{"code":"SwiftCluster","type":"codeVoice"},{"text":" provides ","type":"text"},{"code":"VectorStore","type":"codeVoice"},{"text":", a thread-safe in-memory vector index optimized with Apple Accelerate SIMD operations (","type":"text"},{"code":"vDSP_dotprD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_svesqD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_distancesqD","type":"codeVoice"},{"text":").","type":"text"}]},{"anchor":"1-Creating-a-VectorStore","level":2,"text":"1. Creating a VectorStore","type":"heading"},{"syntax":"swift","code":["import SwiftCluster","import SwiftNLP","","\/\/ Initialize vector store with Cosine Similarity","let store = VectorStore(metric: .cosineSimilarity)","","\/\/ Generate dense text embeddings","let engine = LocalEmbeddingEngine(dimension: 128)","","let articles = [","    (id: \"art_1\", title: \"Apple Silicon Architecture\", text: \"Unified memory and neural engine overview\"),","    (id: \"art_2\", title: \"Swift Strict Concurrency\", text: \"Data-race safety and Sendable types in Swift 6\"),","    (id: \"art_3\", title: \"Quantum Computing Basics\", text: \"Qubits and superposition principles\")","]","","for art in articles {","    let vec = engine.embed(art.text)","    store.add(id: art.id, vector: vec, metadata: [\"title\": art.title])","}","","print(\"Total indexed vectors: \\(store.count)\")"],"type":"codeListing"},{"anchor":"2-Top-K-Semantic-Search","level":2,"text":"2. Top-K Semantic Search","type":"heading"},{"syntax":"swift","code":["let queryVec = engine.embed(\"How does memory sharing work on M-series chips?\")","let results = store.search(query: queryVec, topK: 2)","","for hit in results {","    print(\"Found ID: \\(hit.id), Score: \\(hit.score), Title: \\(hit.metadata[\"title\"] ?? \"\")\")","}"],"type":"codeListing"},{"anchor":"3-Supported-Metrics","level":2,"text":"3. Supported Metrics","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".cosineSimilarity","type":"codeVoice"}]},{"type":"text","text":": Ideal for normalized text embeddings (returns "},{"type":"codeVoice","code":"[-1.0, 1.0]"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".dotProduct","type":"codeVoice"}]},{"type":"text","text":": Direct inner product for unnormalized projections."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".euclideanDistance","type":"codeVoice"}]},{"type":"text","text":": Geometric L2 distance for spatial clustering."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcluster\/vectorstoreandrag"]}],"topicSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric"],"title":"Vector Store Types","anchor":"Vector-Store-Types"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"kind":"article","sections":[],"abstract":[{"type":"text","text":"Bui