{"metadata":{"title":"Early Stopping & Generalization Control","roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftML"}]},"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Iterative estimators like multi-layer perceptrons (","type":"text"},{"code":"MLPClassifier","type":"codeVoice"},{"type":"text","text":", "},{"code":"MLPRegressor","type":"codeVoice"},{"type":"text","text":") and gradient boosted decision trees ("},{"code":"GradientBoostedTreesRegressor","type":"codeVoice"},{"type":"text","text":") improve their training loss over successive iterations. However, after sufficient capacity has been fit, additional epochs frequently lead to overfitting on training noise and deteriorating generalization on unseen data."}]},{"type":"paragraph","inlineContent":[{"code":"EarlyStopping","type":"codeVoice"},{"type":"text","text":" provides a decoupled, value-type training callback that monitors validation loss or performance metrics across successive epochs, halting training and optionally restoring optimal model weights."}]},{"text":"Mechanics & State Machine","type":"heading","level":2,"anchor":"Mechanics--State-Machine"},{"type":"codeListing","code":["Epoch Evaluation (Score S_t)","            │","            ▼"," Is (Best - S_t) > minDelta?","   ├── YES ──► Reset wait = 0, update bestScore = S_t, checkpoint weights","   └── NO  ──► Increment wait = wait + 1","                 │","            Is wait >= patience?","              ├── YES ──► shouldStop = true, restore best checkpoint weights","              └── NO  ──► Continue training"],"syntax":null},{"text":"Configuration Parameters","type":"heading","level":3,"anchor":"Configuration-Parameters"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"patience"},{"type":"text","text":": Number of consecutive non-improving evaluations tolerated before triggering an early halt."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"minDelta"},{"type":"text","text":": Minimum absolute improvement required to qualify as progress."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"direction"},{"type":"text","text":": "},{"type":"codeVoice","code":".minimize"},{"type":"text","text":" for loss functions (cross-entropy, MSE) or "},{"type":"codeVoice","code":".maximize"},{"type":"text","text":" for scoring metrics (accuracy, R2, AUC)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"restoreBestWeights"},{"type":"text","text":": When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", automatically restores the model parameters from the epoch that achieved "},{"type":"codeVoice","code":"bestScore"},{"type":"text","text":", avoiding overfit tail iterations."}],"type":"paragraph"}]}]},{"text":"Example Usage","type":"heading","level":2,"anchor":"Example-Usage"},{"type":"codeListing","code":["import SwiftML","","\/\/ 1. Configure early stopping callback","let es = EarlyStopping(","    patience: 5,","    minDelta: 1e-4,","    direction: .minimize,","    restoreBestWeights: true",")","","\/\/ 2. Fit MLP with validation monitoring","let mlp = MLPClassifier(hiddenLayerSizes: [32, 16], maxIter: 200)","try await mlp.fit(","    features: X_train,","    targets: y_train,","    validationFeatures: X_val,","    validationTargets: y_val,","    earlyStopping: es",")"],"syntax":"swift"}]}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","