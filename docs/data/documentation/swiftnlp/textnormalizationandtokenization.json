{"abstract":[{"text":"Clean text, strip punctuation, tokenize sentences\/words, tag parts of speech, extract entities, stem and lemmatize tokens, and score sentiment using NLTK-equivalent algorithms and Apple’s native ","type":"text"},{"type":"codeVoice","code":"NaturalLanguage"},{"text":" framework.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings"],"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/TextNormalizationAndTokenization"},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/swiftnlp\/textnormalizationandtokenization"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Text Normalization, Tokenization & Linguistic Tagging","modules":[{"name":"SwiftNLP"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"Prepare raw unstructured text for machine learning pipelines with high performance and zero external dependencies.","type":"text"}],"type":"paragraph"},{"anchor":"1-Multi-lingual-Word--Sentence-Tokenization","type":"heading","level":3,"text":"1. Multi-lingual Word & Sentence Tokenization"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","\/\/ Apple OS multi-lingual word boundary detection","let wordTokenizer = AppleWordTokenizer()","let words = wordTokenizer.tokenize(text: \"SwiftSci 2.5.0 is fantastic for NLP!\")","","\/\/ Sentence boundary tokenizer","let sentenceTokenizer = SentenceTokenizer()","let sentences = sentenceTokenizer.tokenize(text: \"First sentence. Second sentence!\")"]},{"anchor":"2-POS-Tagging-Lemmatization--Entity-Extraction","type":"heading","level":3,"text":"2. POS Tagging, Lemmatization & Entity Extraction"},{"type":"codeListing","syntax":"swift","code":["\/\/ Part-of-speech tagging","let posTagger = POSTagger()","let tags = posTagger.tag(text: \"SwiftSci runs fast\")","\/\/ [TaggedToken(token: \"SwiftSci\", tag: .noun), TaggedToken(token: \"runs\", tag: .verb), ...]","","\/\/ Lemmatization (base canonical form)","let lemmaTagger = AppleLemmaTagger()","let lemmas = lemmaTagger.lemmatize(text: \"running faster\")","\/\/ [\"run\", \"fast\"]","","\/\/ Named Entity Recognition","let ner = AppleNamedEntityRecognizer()","let entities = ner.extractEntities(text: \"Tim Cook visited Apple in Cupertino.\")"]},{"anchor":"3-Sentiment-Analysis-VADER--NLSentiment","type":"heading","level":3,"text":"3. Sentiment Analysis (VADER & NLSentiment)"},{"type":"codeListing","syntax":"swift","code":["\/\/ Pure Swift VADER Sentiment Analysis","let vader = VADERSentimentAnalyzer()","let score = vader.polarityScores(text: \"SwiftSci is an amazing library!\")","print(score.compound) \/\/ > 0.5 (positive)","","\/\/ Apple OS ML Sentiment Analyzer","let nlSentiment = NLSentimentAnalyzer()","let sentimentScore = nlSentiment.score(text: \"I love coding in Swift!\")"]}]}],"sections":[],"references":{"doc://SwiftNLP/documentation/SwiftNLP":{"role":"collection","title":"SwiftNLP","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"url":"\/documentation\/swiftnlp"},"doc://SwiftNLP/documentation/SwiftNLP/VectorizationAndEmbeddings":{"abstract":[{"text":"Convert text corpora into numerical and sparse feature matrices using ","type":"text"},{"code":"TFIDFVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CountVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"HashingVectorizer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SparseVector","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"LocalEmbeddingEngine","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/swiftnlp\/vectorizationandembeddings","title":"Text Feature Vectorization, Sparse TF-IDF & Local Embeddings","type":"topic","kind":"article","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/VectorizationAndEmbeddings","role":"article"}}}