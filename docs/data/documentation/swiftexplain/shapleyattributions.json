{"metadata":{"role":"collectionGroup","title":"SHAP & LIME Model Interpretability","modules":[{"name":"SwiftExplain"}],"roleHeading":"API Collection"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ShapleyAttributions","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Black-box machine learning models—such as deep neural networks, random forests, and gradient boosting trees—produce accurate predictions but obscure the individual feature contributions that drove a particular decision.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"SwiftExplain","type":"codeVoice"},{"text":" provides mathematically grounded, axiomatic interpretability algorithms:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP"}]},{"type":"text","text":": Path-dependent Shapley attributions for tree-based models ("},{"code":"DecisionTreeClassifier","type":"codeVoice"},{"type":"text","text":", "},{"code":"RandomForestClassifier","type":"codeVoice"},{"type":"text","text":", "},{"code":"RandomForestRegressor","type":"codeVoice"},{"type":"text","text":"). Solves trees with "},{"code":"K <= TreeSHAP.maxExactFeatures","type":"codeVoice"},{"type":"text","text":" ("},{"code":"12","type":"codeVoice"},{"type":"text","text":") distinct split features exactly via $2^K$ coalition enumeration, and uses deterministic seeded Monte Carlo permutation sampling ("},{"code":"approximationSamples = 2048","type":"codeVoice"},{"type":"text","text":") with exact additive efficiency enforcement ($\\sum_i \\phi_i = f(x) - \\mathbb{E}[f(X)]$) for larger $K$."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"}]},{"type":"text","text":": Model-agnostic explainer solving constrained weighted linear regression against an empirical background dataset for any arbitrary asynchronous prediction function."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer"}]},{"type":"text","text":": Local Interpretable Model-agnostic Explanations fitting ridge linear surrogate models around perturbed neighborhoods."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"mermaid","code":["graph TD","    Model[Trained Model \/ Ensemble] --> ModelType{Model Architecture}","    ModelType -->|Tree Ensemble \/ Forest| Tree[TreeSHAP: Exact K<=12 \/ Seeded MC K>12]","    ModelType -->|Arbitrary Black-Box \/ Pipeline| Kernel[KernelSHAP: Empirical Regression]","    ModelType -->|Local Linear Surrogate| LIME[LIMEExplainer: Perturbation Neighborhood]","    Tree --> Attributions[Shapley Attributions: sum phi_i = f(x) - E(f)]","    Kernel --> Attributions","    LIME --> SurrogateWeights[Local Coefficients + R^2 Goodness of Fit]","    Attributions --> FeatureRanking[Feature Importance Ranking & Waterfall Breakdown]"]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"1. Path-Dependent TreeSHAP for Tree Ensembles","anchor":"1-Path-Dependent-TreeSHAP-for-Tree-Ensembles"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP"},{"text":" evaluates path-dependent conditional expectations over a tree’s internal sample weights (Lundberg et al., 2018; Nature Machine Intelligence):","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"When a tree splits on "},{"code":"K <= TreeSHAP.maxExactFeatures","type":"codeVoice"},{"type":"text","text":" ("},{"code":"12","type":"codeVoice"},{"type":"text","text":") distinct features, "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP"},{"type":"text","text":" enumerates all $2^K$ coalitions to return "},{"type":"strong","inlineContent":[{"type":"text","text":"exact"}]},{"type":"text","text":" path-dependent Shapley values."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When "},{"code":"K > 12","type":"codeVoice"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP"},{"type":"text","text":" switches to deterministic Monte Carlo permutation sampling ("},{"code":"TreeSHAP.approximationSamples = 2048","type":"codeVoice"},{"type":"text","text":" with "},{"code":"permutationSeed","type":"codeVoice"},{"type":"text","text":"), renormalizing any efficiency discrepancy evenly across active features. Use "},{"code":"treeShap.isExact(tree:numFeatures:)","type":"codeVoice"},{"type":"text","text":" to inspect which regime a tree uses."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["import SwiftML","import SwiftExplain","","\/\/ 1. Train a Random Forest model on feature data","let rf = RandomForestClassifier(nEstimators: 50, maxDepth: 6)","try await rf.fit(features: X_train, targets: y_train)","","\/\/ 2. Initialize TreeSHAP explainer","let treeShap = TreeSHAP()","","\/\/ 3. Compute exact Shapley attributions for an individual observation","let testInstance = X_test[0]","let shapValues = await treeShap.explain(randomForest: rf, instance: testInstance)","","\/\/ 4. Rank features by absolute impact on the decision","let featureNames = [\"Income\", \"DebtToIncome\", \"CreditScore\", \"EmploymentYears\", \"LoanAmount\"]","let ranked = zip(featureNames, shapValues).sorted { abs($0.1) > abs($1.1) }","","print(\"Feature attributions for instance:\")","for (name, phi) in ranked {","    let direction = phi >= 0 ? \"+\" : \"-\"","    print(\"  • \\(name): \\(direction)\\(String(format: \"%.4f\", abs(phi)))\")","}"]},{"level":3,"type":"heading","text":"Concurrent Batch Explanations","anchor":"Concurrent-Batch-Explanations"},{"type":"paragraph","inlineContent":[{"text":"For dataset-wide interpretability or global summary plots, compute attributions concurrently across Apple Silicon CPU cores:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let flatTrees = await rf.flatTrees","let batchAttributions = await treeShap.explainBatch(","    trees: flatTrees,","    instances: X_test,","    numFeatures: featureNames.count",")","print(\"Computed SHAP matrix for \\(batchAttributions.count) instances.\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"2. Model-Agnostic Explanations with `KernelSHAP`","anchor":"2-Model-Agnostic-Explanations-with-KernelSHAP"},{"type":"paragraph","inlineContent":[{"text":"When interpreting models without tree structures—such as support vector machines, neural decoders, or multi-stage pipelines—","type":"text"},{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","type":"reference","isActive":true},{"text":" estimates Shapley values through weighted linear regression over coalition permutations:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","","\/\/ 1. Initialize KernelSHAP explainer actor","let kernelShap = KernelSHAP()","","\/\/ 2. Compute Shapley attributions using background baseline dataset","let attributions = await kernelShap.explain(","    model: { features in","        \/\/ Any asynchronous prediction function mapping [Double] -> Double","        return await myNeuralNetwork.predict(features)","    },","    instance: testInstance,","    background: backgroundSampleData,","    numCoalitions: 300",")","","print(\"KernelSHAP Attributions: \\(attributions)\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"3. Local Surrogate Explanations with LIME","anchor":"3-Local-Surrogate-Explanations-with-LIME"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","type":"reference","isActive":true},{"text":" perturbs the target instance with Gaussian noise, queries the black-box model on the neighborhood, and trains an interpretable, locally-weighted ridge linear surrogate:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","","let lime = LIMEExplainer(kernelWidth: 0.75, regularization: 1.0)","","let explanation = await lime.explain(","    model: { x in await complexPipeline.predictScore(x) },","    instance: testInstance,","    numSamples: 500",")","","print(\"Local Model Intercept: \\(explanation.intercept)\")","print(\"Local Surrogate Fidelity (R²): \\(String(format: \"%.3f\", explanation.localR2))\")","","for (idx, weight) in explanation.featureWeights.enumerated() {","    print(\"Feature \\(idx) Local Weight: \\(String(format: \"%.4f\", weight))\")","}"]},{"type":"thematicBreak"}]}],"abstract":[{"text":"Explain machine learning model predictions with game-theoretic Shapley value attributions (TreeSHAP, KernelSHAP) and local linear surrogates (LIME).","type":"text"}],"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability"],"title":"Guides & Tutorials"}],"sections":[],"topicSections":[{"anchor":"Explainability-Engines","title":"Explainability Engines","identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAPExplanation","doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/shapleyattributions"]}],"references":{"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","kind":"symbol","title":"KernelSHAP","type":"topic","role":"symbol","url":"\/documentation\/swiftexplain\/kernelshap","abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KernelSHAP","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"KernelSHAP"}]},"doc://SwiftExplain/documentation/SwiftExplain":{"title":"SwiftExplain","type":"topic","url":"\/documentation\/swiftexplain","role":"collection","kind":"symbol","identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","abstract":[{"type":"text","text":"Model Explainability, SHAP & Feature Attributions."}]},"doc://SwiftExplain/documentation/SwiftExplain/LIMEExplainer":{"role":"symbol","navigatorTitle":[{"text":"LIMEExplainer","kind":"identifier"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/LIMEExplainer","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LIMEExplainer","kind":"identifier"}],"title":"LIMEExplainer","abstract":[{"type":"text","text":"Local Interpretable Model-agnostic Explanations (LIME)."}],"url":"\/documentation\/swiftexplain\/limeexplainer","kind":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain/TreeSHAPExplanation":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeSHAPExplanation","kind":"identifier"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAPExplanation","navigatorTitle":[{"text":"TreeSHAPExplanation","kind":"identifier"}],"title":"TreeSHAPExplanation","type":"topic","url":"\/documentation\/swiftexplain\/treeshapexplanation","abstract":[{"type":"text","text":"Explanation structure containing TreeSHAP attributions and baseline predictions"},{"type":"text","text":" "},{"text":"(exact when ","type":"text"},{"type":"codeVoice","code":"K <= TreeSHAP.maxExactFeatures"},{"text":", seeded Monte Carlo permutation estimate otherwise).","type":"text"}],"role":"symbol"},"doc://SwiftExplain/documentation/SwiftExplain/ModelInterpretability":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/ModelInterpretability","kind":"article","title":"Model Interpretability & XAI Guide","type":"topic","role":"article","url":"\/documentation\/swiftexplain\/modelinterpretability","abstract":[{"type":"text","text":"Understand black-box machine learning predictions using "},{"type":"codeVoice","code":"TreeSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"KernelSHAP"},{"type":"text","text":", "},{"type":"codeVoice","code":"LIMEExplainer"},{"type":"text","text":", "},{"type":"codeVoice","code":"PermutationImportance"},{"type":"text","text":", and "},{"type":"codeVoice","code":"PartialDependencePlot"},{"type":"text","text":"."}]},"doc://SwiftExplain/documentation/SwiftExplain/TreeSHAP":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeSHAP","kind":"identifier"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/TreeSHAP","navigatorTitle":[{"text":"TreeSHAP","kind":"identifier"}],"title":"TreeSHAP","type":"topic","url":"\/documentation\/swiftexplain\/treeshap","abstract":[{"type":"text","text":"TreeSHAP (Tree Shapley Additive Explanations) for decision trees and tree ensembles"},{"text":" ","type":"text"},{"text":"(Lundberg et al., 2018; Nature Machine Intelligence).","type":"text"}],"role":"symbol"}}}