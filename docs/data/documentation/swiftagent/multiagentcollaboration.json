{"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration","interfaceLanguage":"swift"},"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","title":"Multi-Agent Coordination & Protocols"},"abstract":[{"type":"text","text":"Orchestrate teams of specialized autonomous agents over an asynchronous message bus with concurrent parallel tool calling."}],"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgenticReplAndRAG"],"generated":true,"anchor":"Guides--Tutorials"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Complex analytical and reasoning workflows are frequently error-prone when performed by a single monolithic model. Decomposing problems into specialized roles—such as "},{"type":"strong","inlineContent":[{"text":"Planner","type":"text"}]},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"text":"Analyst","type":"text"}]},{"type":"text","text":", and "},{"type":"strong","inlineContent":[{"text":"Critic","type":"text"}]},{"type":"text","text":"—drastically improves reasoning accuracy, reduces hallucinations, and permits parallelized tool execution."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"SwiftAgent"},{"type":"text","text":" provides "},{"type":"codeVoice","code":"MultiAgentOrchestrator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AgentMessageBus"},{"type":"text","text":", a reactive multi-agent framework built on Swift’s structured concurrency primitives ("},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" and "},{"type":"codeVoice","code":"withTaskGroup"},{"type":"text","text":")."}],"type":"paragraph"},{"level":2,"anchor":"Architectural-Topology","type":"heading","text":"Architectural Topology"},{"code":["                         ┌───────────────────────┐","                         │   User \/ Prompt Task  │","                         └───────────┬───────────┘","                                     │","                                     ▼","                       ┌───────────────────────────┐","                       │      AgentMessageBus      │","                       │       (AsyncStream)       │","                       └─────────────┬─────────────┘","                                     │ Broadcasts","         ┌───────────────────────────┼───────────────────────────┐","         ▼                           ▼                           ▼","┌──────────────────┐       ┌──────────────────┐       ┌──────────────────┐","│     Planner      │       │     Analyst      │       │      Critic      │","│ Decomposes steps │       │ Queries & Models │       │ Validates logic  │","└────────┬─────────┘       └────────┬─────────┘       └────────┬─────────┘","         │                          │                          │","         └──────────────────────────┼──────────────────────────┘","                                    │ Parallel Tool Calls","                                    ▼","                     ┌─────────────────────────────┐","                     │ MultiAgentOrchestrator      │","                     │ withTaskGroup Tool Executor │","                     └──────────────┬──────────────┘","                                    │","               ┌────────────────────┴────────────────────┐","               ▼                                         ▼","      DataFrame Query Tool                      Statistical Model Tool"],"type":"codeListing","syntax":null},{"level":2,"anchor":"Parallel-Tool-Calling","type":"heading","text":"Parallel Tool Calling"},{"inlineContent":[{"type":"text","text":"When an agent requests multiple tool executions in a single reasoning step (e.g. computing standard deviations across three columns concurrently), "},{"type":"codeVoice","code":"MultiAgentOrchestrator.executeToolsInParallel(_:)"},{"type":"text","text":" executes them simultaneously across available CPU cores using "},{"type":"codeVoice","code":"withTaskGroup"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This reduces total latency from $\\sum_{i=1}^M T_i$ to $\\max_{i} T_i$."}],"type":"paragraph"},{"level":2,"anchor":"Example-Usage","type":"heading","text":"Example Usage"},{"code":["import SwiftAgent","import SwiftDataFrame","","\/\/ 1. Initialize orchestrator and message bus","let orchestrator = MultiAgentOrchestrator(maxRounds: 5)","","\/\/ 2. Register specialized agents","orchestrator.registerAgent(PlannerAgent())","orchestrator.registerAgent(DataAnalystAgent())","orchestrator.registerAgent(CriticAgent())","","\/\/ 3. Register tools","orchestrator.registerTool(DataFrameAgentTool(dataframe: salesData))","","\/\/ 4. Run collaborative execution","let solution = try await orchestrator.run(","    taskPrompt: \"Identify top 3 departments by salary variance and critique findings.\"",")","print(\"Consensus Answer: \\(solution)\")"],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/multiagentcollaboration"]}],"topicSections":[{"title":"Multi-Agent Coordination","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentOrchestrator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessageBus","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessage","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolCall","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolResult","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SpecializedAgent"],"anchor":"Multi-Agent-Coordination"}],"references":{"doc://SwiftAgent/documentation/SwiftAgent/AgentToolCall":{"navigatorTitle":[{"text":