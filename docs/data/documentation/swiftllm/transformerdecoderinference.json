{"abstract":[{"text":"Explore the low-level mechanics of Metal GPU-accelerated transformer decoders and KV-Caching in SwiftLLM.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"code":"SwiftLLM","type":"codeVoice"},{"type":"text","text":" implements modern decoder-only generative transformer models (such as Llama, Qwen, and Gemma) leveraging MLX Metal acceleration on Apple Silicon unified memory."}],"type":"paragraph"},{"text":"1. Key Architectural Blocks","anchor":"1-Key-Architectural-Blocks","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Rotary Position Embedding (RoPE)"}]},{"type":"text","text":": Encodes positional information by rotating query and key vectors in 2D planes, preserving relative distance relationships."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"RMSNorm"}]},{"type":"text","text":": Root Mean Square Layer Normalization provides training stability with reduced computational overhead compared to LayerNorm."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SwiGLU Activation"}]},{"type":"text","text":": Gated linear unit activation "},{"code":"SwiGLU(x) = Swish(x · W_1) ⊙ (x · W_2)","type":"codeVoice"},{"type":"text","text":" for enhanced non-linear representation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Paged KV-Cache"}]},{"type":"text","text":": Stores precomputed Key and Value projection matrices across generation steps, eliminating "},{"code":"O(N²)","type":"codeVoice"},{"text":" recomputation.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"2-Generating-Tokens","text":"2. Generating Tokens"},{"code":["import SwiftLLM","","\/\/ Load model weights and tokenizer","let config = LLMConfiguration(","    vocabSize: 32000,","    hiddenDimension: 4096,","    numLayers: 32,","    numHeads: 32,","    contextLength: 4096",")","","let model = TransformerDecoder(configuration: config)","","\/\/ Stream autoregressive tokens","for try await token in model.generateStream(prompt: \"The future of scientific computing\", maxTokens: 50) {","    print(token, terminator: \"\")","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/transformerdecoderinference"]}],"topicSections":[{"title":"LLM Components","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache"],"anchor":"LLM-Components"}],"sections":[],"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftLLM"}],"roleHeading":"API Collection","title":"Autoregressive Transformer Decoder Architecture"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference"},"kind":"article","references":{"doc://SwiftLLM/documentation/SwiftLLM/KVCache":{"abstract":[{"type":"text","text":"Key-Value cache storing previous Attention Keys and Values per layer for O(N) generation."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"KVCache","kind":"identifier"}],"title":"KVCache","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KVCache","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache","url":"\/documentation\/swiftllm\/kvcache"},"doc://SwiftLLM/documentation/SwiftLLM":{"kind":"symbol","role":"collection","abstract":[{"text":"Local Causal Transformer Decoder & Weight Parsers.","type":"text"}],"identifier":"doc:\/\/SwiftLLM\/document