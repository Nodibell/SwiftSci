{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"SwiftML"}],"roleHeading":"Article","title":"Multi-Layer Perceptrons & Neural Network Architecture","role":"article"},"abstract":[{"text":"Train neural network classifiers and regressors with hardware-accelerated BLAS forward passes, Adam optimization, Dropout regularization, and Batch Normalization.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftML\/documentation\/SwiftML\/NeuralNetworkArchitectures"},"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiftML"},{"text":" provides ","type":"text"},{"type":"codeVoice","code":"MLPClassifier"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"MLPRegressor"},{"text":" multi-layer perceptrons designed for high-throughput tabular modeling. The architecture uses contiguous ","type":"text"},{"type":"codeVoice","code":"LayerWeights"},{"text":" flat buffers with Apple Accelerate BLAS ","type":"text"},{"type":"codeVoice","code":"cblas_dgemm"},{"text":" matrix multiplications and vectorized Adam optimizer updates.","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["Input Layer (D features)","      │","      ▼","┌──────────────┐","│ Linear (W1)  │ ───► Apple Accelerate cblas_dgemm","├──────────────┤","│  BatchNorm   │ ───► (x - mean) \/ sqrt(var + eps)","├──────────────┤","│  Activation  │ ───► ReLU \/ Tanh \/ Sigmoid","├──────────────┤","│   Dropout    │ ───► Bernoulli Mask (p = 0.2)","└──────────────┘","      │","      ▼","┌──────────────┐","│ Linear (W2)  │ ───► cblas_dgemm","├──────────────┤","│  Softmax\/Lin │ ───► Probabilities \/ Continuous Output","└──────────────┘"],"type":"codeListing"},{"type":"thematicBreak"},{"text":"1. Mathematical Formulation","level":2,"anchor":"1-Mathematical-Formulation","type":"heading"},{"inlineContent":[{"text":"For each hidden layer $l$:","type":"text"},{"text":" ","type":"text"},{"text":"$$\\mathbf{z}^{(l)} = \\mathbf{W}^{(l)} \\mathbf{a}^{(l-1)} + \\mathbf{b}^{(l)}$$","type":"text"},{"text":" ","type":"text"},{"text":"$$\\mathbf{a}^{(l)} = \\sigma\\left(\\mathbf{z}^{(l)}\\right)$$","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Supported activations ($\\sigma$):","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"ReLU"}]},{"text":": $\\max(0, x)$","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tanh"}]},{"text":": $\\tanh(x) = \\frac{e^x - e^{-x}}{e^x + e^{-x}}$","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sigmoid"}]},{"text":": $\\sigma(x) = \\frac{1}{1 + e^{-x}}$","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Linear"}]},{"text":": $f(x) = x$","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"text":"2. Training an MLP Classifier with Dropout & BatchNorm","level":2,"anchor":"2-Training-an-MLP-Classifier-with-Dropout--BatchNorm","type":"heading"},{"syntax":"swift","code":["import Foundation","import SwiftML","","\/\/ 1. Synthetic training dataset (100 samples, 4 features)","let sampleCount = 100","let inDim = 4","let X_train = (0..<sampleCount).map { i in","    (0..<inDim).map { d in Double(i * inDim + d) * 0.02 }","}","let y_train = (0..<sampleCount).map { $0 % 2 } \/\/ Binary classification","","\/\/ 2. Configure MLPClassifier with hidden layers, Adam optimizer, Dropout, and BatchNorm","let mlp = try MLPClassifier(","    hiddenLayerSizes: [32, 16],","    activation: .relu,","    learningRate: 0.01,","    maxEpochs: 150,","    batchSize: 16,","    dropoutRate: 0.2,","    batchNorm: true,","    randomSeed: 42",")","","\/\/ 3. Train model asynchronously under Swift 6 actor isolation","try await mlp.fit(features: X_train, targets: y_train)","","\/\/ 4. Predict class labels and posterior probabilities","let X_test = [[0.1, 0.2, 0.3, 0.4], [1.5, 1.8, 2.1, 2.4]]","let predictions = try await mlp.predict(features: X_test)","let probabilities = try await mlp.predictProba(features: X_test)","","print(\"Predictions: \\(predictions)\")","for (idx, prob) in probabilities.enumerated() {","    print(\"Sample \\(idx) Class 1 Probability: \\(String(format: \"%.2f%%\", prob[1] * 100))\")","}"],"type":"codeListing"},{"type":"thematicBreak"},{"text":"3. Training an MLP Regressor","level":2,"anchor":"3-Training-an-MLP-Regressor","type":"heading"},{"inlineContent":[{"text":"For continuous target estimation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let y_reg = X_train.map { $0.reduce(0.0, +) * 2.5 }","","let regressor = try MLPRegressor(","    hiddenLayerSizes: [64, 32],","    activation: .tanh,","    learningRate: 0.005,","    maxEpochs: 200,","    batchSize: 32",")","","try await regressor.fit(features: X_train, targets: y_reg)","let regPredictions = try await regressor.predict(features: X_test)","print(\"Regression Predictions: \\(regPredictions)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"text":"4. Binary Core ML Model Export","level":2,"anchor":"4-Binary-Core-ML-Model-Export","type":"heading"},{"inlineContent":[{"text":"Export trained MLP architectures directly to Apple Core ML binary protobuf ","type":"text"},{"type":"codeVoice","code":".mlmodel"},{"text":" files:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["try await mlp.writeCoreML(","    to: URL(fileURLWithPath: \"TabularMLP.mlmodel\"),","    featureNames: [\"feat_0\", \"feat_1\", \"feat_2\", \"feat_3\"],","    outputName: \"target_class\"",")","print(\"Successfully exported MLP to Core ML binary format.\")"],"type":"codeListing"}],"kind":"content"}],"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/swiftml\/neuralnetworkarchitectures"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftML/documentation/SwiftML":{"abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","url":"\/documentation\/swiftml","type":"topic","kind":"symbol","title":"SwiftML","role":"collection"}}}