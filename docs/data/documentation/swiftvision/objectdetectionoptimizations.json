{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In real-time computer vision models such as YOLO, post-processing can generate tens of thousands of candidate detections per frame. Standard bounding box objects with heap-allocated "},{"type":"codeVoice","code":"String"},{"type":"text","text":" class names induce significant ARC and memory allocation overhead."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftVision"},{"type":"text","text":" introduces "},{"type":"reference","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBoxSIMD","isActive":true},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Zero-Heap Value Representation","type":"text"}]},{"type":"text","text":": Encapsulates bounding coordinates in hardware "},{"code":"SIMD4<Float>","type":"codeVoice"},{"type":"text","text":" registers and replaces strings with integer "},{"code":"classId: Int32","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Accelerated Vector IoU","type":"text"}]},{"type":"text","text":": Computes intersection, union, and clamping entirely within SIMD registers without memory allocations."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"High-Throughput NMS","type":"text"}]},{"type":"text","text":": Provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/NonMaximumSuppression\/filter(boxes:iouThreshold:scoreThreshold:)-5ernf"},{"type":"text","text":" operating directly on SIMD bounding boxes."}]}]}],"type":"orderedList"},{"level":2,"text":"Usage Example","type":"heading","anchor":"Usage-Example"},{"code":["import SwiftVision","","\/\/ Create candidates using SIMD coordinates:","let candidate = BoundingBoxSIMD(","    xMin: 12.5, yMin: 34.0,","    xMax: 150.0, yMax: 220.0,","    confidence: 0.92,","    classId: 0 \/\/ e.g. \"person\"",")","","\/\/ Filter detections with zero-heap NMS:","let detections = NonMaximumSuppression.filter(","    boxes: candidates,","    iouThreshold: 0.45,","    scoreThreshold: 0.25",")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/ObjectDetectionOptimizations","interfaceLanguage":"swift"},"abstract":[{"text":"Hardware-accelerated zero-heap bounding box processing and Non-Maximum Suppression (NMS) for real-time vision pipelines.","type":"text"}],"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBoxSIMD","doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBox","doc:\/\/SwiftVision\/documentation\/SwiftVision\/NonMaximumSuppression"]}],"metadata":{"title":"Object Detection Optimizations & SIMD Bounding Boxes","role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftVision"}]},"variants":[{"paths":["\/documentation\/swiftvision\/objectdetectionoptimizations"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"kind":"article","references":{"doc://SwiftVision/documentation/SwiftVision/BoundingBoxSIMD":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BoundingBoxSIMD","kind":"identifier"}],"navigatorTitle":[{"text":"BoundingBoxSIMD","kind":"identifier"}],"url":"\/documentation\/swiftvision\/boundingboxsimd","abstract":[{"type":"text","text":"Memory-efficient bounding box representation using hardware SIMD registers."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiftVision\/documentation\/SwiftVision\/BoundingBoxSIMD","type":"top