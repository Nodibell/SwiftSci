──────────────────────────────────────────┘"],"syntax":null},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Actor Isolation:","type":"text"}]},{"text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Streaming ","type":"text"},{"type":"codeVoice","code":"recv"},{"text":" Buffer:","type":"text"}]},{"text":" Network drivers use a 64KB receive buffer reading continuously until ","type":"text"},{"type":"codeVoice","code":"ReadyForQuery ('Z')"},{"text":" is received.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Authentication:","type":"text"}]},{"text":" Built-in support for Cleartext and MD5 password authentication via ","type":"text"},{"type":"codeVoice","code":"CommonCrypto"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"1-Querying-SQLite-Databases","text":"1. Querying SQLite Databases"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SQLiteConnection"},{"type":"text","text":" executes SQL statements through native "},{"type":"codeVoice","code":"sqlite3_prepare_v2"},{"type":"text","text":" and directly streams result rows into columnar "},{"type":"codeVoice","code":"TypedColumn"},{"type":"text","text":" buffers:"}]},{"type":"codeListing","code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = try SQLiteConnection(path: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) 