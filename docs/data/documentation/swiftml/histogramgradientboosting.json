{"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport"],"anchor":"Guides--Tutorials","generated":true}],"topicSections":[{"title":"Estimators","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode"],"anchor":"Estimators"}],"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftML"}],"title":"Fast Tabular Learning with Histogram Gradient Boosting","role":"collectionGroup"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/histogramgradientboosting"]}],"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Discretize continuous feature distributions into 256 compact bins to accelerate decision tree split evaluations from (O(N \\log N)) to (O(K)).","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Traditional gradient boosted decision trees (GBDT) sort continuous feature values across all samples at every internal tree node to find optimal split thresholds. When datasets grow to millions of rows, sorting becomes the primary performance bottleneck."}],"type":"paragraph"},{"inlineContent":[{"code":"HistGradientBoostingClassifier","type":"codeVoice"},{"type":"text","text":" and "},{"code":"HistGradientBoostingRegressor","type":"codeVoice"},{"type":"text","text":" implement histogram-based split optimization (inspired by LightGBM and scikit-learn’s "},{"code":"HistGradientBoostingClassifier","type":"codeVoice"},{"type":"text","text":"). Continuous feature columns are discretized into at most 256 integer bins ("},{"code":"UInt8","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"level":2,"text":"Algorithmic Architecture","type":"heading","anchor":"Algorithmic-Architecture"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Pre-Binning (Quantization)"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"Feature quantiles are evaluated once before boosting begins, establishing up to 256 discrete bins per feature column. All feature values are mapped to compact ","type":"text"},{"code":"UInt8","type":"codeVoice"},{"text":" memory arrays.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"One-Pass Histogram Accumulation"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"For any internal tree node, first-order negative gradients (g_i) and second-order Hessians (h_i) are accumulated into a flat 256-bin histogram in a single linear pass over the node’s samples:","type":"text"},{"text":" ","type":"text"},{"text":"$$G[k] = \\sum_{i: b_i = k} g_i, \\quad H[k] = \\sum_{i: b_i = k} h_i$$","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Constant-Time Split Finding"}],"type":"strong"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"Evaluating all split candidates requires iterating over (K \\le 256) bins, regardless of how many millions of samples reside in the node:","type":"text"},{"text":" ","type":"text"},{"text":"$$\\text{Gain} = \\frac{1}{2} \\left[ \\frac{G_L^2}{H_L + \\lambda} + \\frac{G_R^2}{H_R + \\lambda} - \\frac{G_{\\text{tot}}^2}{H_{\\text{tot}} + \\lambda} \\right]$$","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"code":["Continuous Floats [0.14, 0.92, -0.45] ──► Quantization ──► UInt8 Bins [32, 215, 12]","                                                                  │","                                                                  ▼","Node Split Search: O(256) Bin Scan ◄─── Accumulated Histograms G[k], H[k]"],"type":"codeListing","syntax":null},{"level":2,"text":"Example Usage","type":"heading","anchor":"Example-Usage"},{"code":["import SwiftML","","let clf = try HistGradientBoostingClassifier(","    nEstimators: 50,","    learningRate: 0.1,","    maxDepth: 6,","    maxBins: 256,","    minSamplesLeaf: 10",")","","try await clf.fit(features: X_train, targets: y_train)","let predictions = try await clf.predict(features: X_test)","let probabilities = try await clf.predictProbability(features: X_test)"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"references":{"doc://SwiftML/documentation/SwiftML/EnsembleLearning":{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","url":"\/documentation\/swiftml\/ensemblelearning","kind":"article","abstract":[{"text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism.","type":"text"}],"type":"topic","role":"collectionGroup","title":"Ensemble Learning: Random Forests & Gradient Boosted Trees"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingClassifier":{"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistGradientBoostingClassifier"}],"type":"topic","abstract":[{"type":"text","text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular classification."}],"navigatorTitle":[{"kind":"identifier","text":"HistGradientBoostingClassifier"}],"title":"HistGradientBoostingClassifier","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","url":"\/documentation\/swiftml\/histgradientboostingclassifier"},"doc://SwiftML/documentation/SwiftML/SupervisedRegressors":{"title":"Supervised Regression Models","kind":"article","role":"article","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","abstract":[{"type":"text","text":"Perform continuous target predictions using LinearRegression (exact OLS), DecisionTreeRegressor, and GradientBoostedTreesRegressor."}],"url":"\/documentation\/swiftml\/supervisedregressors"},"doc://SwiftML/documentation/SwiftML":{"type":"topic","role":"collection","url":"\/documentation\/swiftml","kind":"symbol","title":"SwiftML","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}]},"doc://SwiftML/documentation/SwiftML/EarlyStoppingCallbacks":{"url":"\/documentation\/swiftml\/earlystoppingcallbacks","type":"topic","role":"collectionGroup","title":"Early Stopping & Generalization Control","kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","abstract":[{"text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting.","type":"text"}]},"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","abstract":[{"text":"Train classification models using LogisticRegression, DecisionTreeClassifier, RandomForestClassifier, and MLPClassifier.","type":"text"}],"title":"Supervised Classification Models","url":"\/documentation\/swiftml\/supervisedclassifiers","type":"topic","role":"article"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingRegressor":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistGradientBoostingRegressor","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"HistGradientBoostingRegressor","kind":"identifier"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","kind":"symbol","title":"HistGradientBoostingRegressor","url":"\/documentation\/swiftml\/histgradientboostingregressor","abstract":[{"type":"text","text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular regression."}],"role":"symbol"},"doc://SwiftML/documentation/SwiftML/ReproducibilityAndPRNG":{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","url":"\/documentation\/swiftml\/reproducibilityandprng","kind":"article","abstract":[{"text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators.","type":"text"}],"type":"topic","role":"collectionGroup","title":"Reproducibility, Determinism & High-Quality PRNG"},"doc://SwiftML/documentation/SwiftML/HistTreeNode":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistTreeNode"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"HistTreeNode"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode","kind":"symbol","title":"HistTreeNode","url":"\/documentation\/swiftml\/histtreenode","abstract":[{"type":"text","text":"A node in a histogram-binned decision tree."}],"role":"symbol"},"doc://SwiftML/documentation/SwiftML/MLOpsExport":{"url":"\/documentation\/swiftml\/mlopsexport","type":"topic","role":"collectionGroup","title":"Exporting Models to Core ML and ONNX","kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","abstract":[{"text":"Export trained SwiftSci estimators to native Apple Core ML (","type":"text"},{"type":"codeVoice","code":".mlmodel"},{"text":") and cross-platform ONNX (","type":"text"},{"type":"codeVoice","code":".onnx"},{"text":") binary artifacts for production deployment.","type":"text"}]}}}