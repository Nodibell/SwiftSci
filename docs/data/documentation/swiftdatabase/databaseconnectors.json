{"sections":[],"metadata":{"modules":[{"name":"SwiftDatabase"}],"role":"article","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","roleHeading":"Article"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 "},{"type":"codeVoice","code":"public actor"},{"type":"text","text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks."}]},{"type":"thematicBreak"},{"anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model","type":"heading","text":"🔒 Driver Architecture & Concurrency Model","level":2},{"type":"codeListing","code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"],"syntax":null},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Actor Isolation:","type":"text"}]},{"type":"text","text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Streaming ","type":"text"},{"code":"recv","type":"codeVoice"},{"text":" Buffer:","type":"text"}],"type":"strong"},{"text":" Network drivers use a 64KB receive buffer reading continuously until ","type":"text"},{"code":"ReadyForQuery ('Z')","type":"codeVoice"},{"text":" is received.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Authentication:","type":"text"}],"type":"strong"},{"text":" Built-in support for Cleartext and MD5 password authentication via ","type":"text"},{"code":"CommonCrypto","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"thematicBreak"},{"type":"heading","text":"1. Querying SQLite Databases & C-Pointer Lifecycle Safety","level":2,"anchor":"1-Querying-SQLite-Databases--C-Pointer-Lifecycle-Safety"},{"type":"paragraph","inlineContent":[{"code":"SQLiteConnection","type":"codeVoice"},{"type":"text","text":" executes SQL statements through native "},{"type":"codeVoice","code":"sqlite3_prepare_v2"},{"type":"text","text":" and directly streams result rows into columnar "},{"type":"codeVoice","code":"TypedColumn"},{"type":"text","text":" buffers with full C-pointer lifecycle safety:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Statement Finalization:"}],"type":"strong"},{"text":" All prepared statements are guaranteed to be finalized via ","type":"text"},{"code":"defer { if let stmt { sqlite3_finalize(stmt) } }","type":"codeVoice"},{"text":", preventing statement pointer leaks during both normal termination and thrown query errors.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resource Cleanup:"}]},{"type":"text","text":" In-memory or file-backed database handles are automatically closed via "},{"type":"codeVoice","code":"sqlite3_close_v2"},{"type":"text","text":" upon deallocation. Callers may also invoke "},{"type":"codeVoice","code":"await sqlite.close()"},{"type":"text","text":" to immediately release operating system locks and memory."}],"type":"paragraph"}]}]},{"code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = SQLiteConnection(databasePath: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)","","\/\/ 3. Explicitly release SQLite database handle when done","await sqlite.close()"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","type":"heading","anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries ("},{"type":"codeVoice","code":"libpq"},{"type":"text","text":"):"}]},{"code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    user: \"postgres\",","    password: \"secure_password\",","    sslMode: .disable",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"type":"heading","anchor":"3-High-Throughput-Bulk-Writeback-toSQL","level":2,"text":"3. High-Throughput Bulk Writeback (`toSQL`)"},{"inlineContent":[{"type":"text","text":"Bulk export in-memory "},{"type":"codeVoice","code":"DataFrame"},{"type":"text","text":" objects back into database tables with configurable append, replace, or fail-if-exists modes:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append, .replace, or .failIfExists","    batchSize: 500",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"]}]}],"seeAlsoSections":[{"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"],"title":"Guides & Tutorials","generated":true}],"identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/databaseconnectors"]}],"abstract":[{"type":"text","text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" under Swift 6 Actor Concurrency."}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://SwiftDatabase/documentation/SwiftDatabase":{"title":"SwiftDatabase","type":"topic","abstract":[{"text":"Relational Database Connectors to DataFrames.","type":"text"}],"role":"collection","kind":"symbol","url":"\/documentation\/swiftdatabase","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"kind":"article","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","type":"topic","title":"Bulk SQL Ingestion & Database Wire Protocols","abstract":[{"type":"text","text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback."}],"url":"\/documentation\/swiftdatabase\/highthroughputingestion","role":"collectionGroup"},"doc://SwiftDatabase/documentation/SwiftDatabase/SecurityAndPerformance":{"kind":"article","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","type":"topic","title":"Security & Performance in SwiftDatabase","abstract":[{"type":"text","text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL."}],"url":"\/documentation\/swiftdatabase\/securityandperformance","role":"collectionGroup"},"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"kind":"article","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","title":"Database Type System & Value Representation","type":"topic","abstract":[{"text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions.","type":"text"}],"url":"\/documentation\/swiftdatabase\/typesystem","role":"collectionGroup"}}}