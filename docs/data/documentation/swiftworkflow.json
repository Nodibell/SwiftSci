{"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"code":"SwiftWorkflow","type":"codeVoice"},{"type":"text","text":" provides immutable, production-grade pipelines that compose missing-value imputation, feature scaling, dimensionality reduction, and classification into single deployable units."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Key Capabilities","anchor":"Key-Capabilities"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Fitted End-to-End Pipeline"}],"type":"strong"},{"text":": ","type":"text"},{"code":"PCAClassificationWorkflow","type":"codeVoice"},{"text":" integrating mean imputation, standard scaling, SVD-based PCA projection, and binary logistic regression.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Strict Row Provenance","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"Predictions"},{"type":"text","text":" preserving "},{"type":"codeVoice","code":"sourceRowIndices"},{"type":"text","text":" directly from the input "},{"type":"codeVoice","code":"PreparedSupervisedBatch"},{"type":"text","text":" or "},{"type":"codeVoice","code":"PreparedNumericBatch"},{"type":"text","text":" across non-contiguous batch selections."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Training-Only Fitting","type":"text"}]},{"text":": Fitted state is computed solely on the designated training batch, preventing data leakage from test or validation sets.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Atomic JSON Serialization"}],"type":"strong"},{"text":": Lightweight, versioned JSON serialization (","type":"text"},{"code":"save(to:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"load(from:)","type":"codeVoice"},{"text":") enabling cross-process persistence and cold-start inference without retaining raw datasets.","type":"text"}],"type":"paragraph"}]}]},{"text":"Example Usage","anchor":"Example-Usage","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftDataFrame","import SwiftWorkflow","","\/\/ 1. Prepare supervised numeric batch","let batch = try rawDF.prepareNumericBatch([\"signal\", \"companion\", \"noise\", \"target\"])","let supervised = try PreparedSupervisedBatch(batch, targetColumn: \"target\")","","\/\/ 2. Train workflow strictly on training partition","let trainingBatch = try supervised.selectingRows([0, 1, 2, 4, 5])","let workflow = try await PCAClassificationWorkflow.train(","    training: trainingBatch,","    components: 2,","    learningRate: 0.125,","    epochs: 64",")","","\/\/ 3. Atomically persist to disk","let fileURL = URL(fileURLWithPath: \"model.json\")","try workflow.save(to: fileURL)","","\/\/ 4. Reload and predict with zero test leakage","let loadedWorkflow = try PCAClassificationWorkflow.load(from: fileURL)","let predictions = try await loadedWorkflow.predict(heldOutBatch.features)"]}]}],"metadata":{"title":"SwiftWorkflow","symbolKind":"module","roleHeading":"Framework","externalID":"SwiftWorkflow","modules":[{"name":"SwiftWorkflow"}],"role":"collection"},"abstract":[{"text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"anchor":"Workflows","identifiers":["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/PCAClassificationWorkflow"],"title":"Workflows"},{"anchor":"Articles","identifiers":["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence"],"title":"Articles"}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftworkflow"]}],"references":{"doc://SwiftWorkflow/documentation/SwiftWorkflow/WorkflowPersistence":{"role":"article","type":"topic","title":"Deploying and Persisting Scientific Workflows","kind":"article","identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence","abstract":[{"text":"Learn how to safely persist, reload, and evaluate end-to-end machine learning workflows across processes.","type":"text"}],"url":"\/documentation\/swiftworkflow\/workflowpersistence"},"doc://SwiftWorkflow/documentation/SwiftWorkflow/PCAClassificationWorkflow":{"url":"\/documentation\/swiftworkflow\/pcaclassificationworkflow","title":"PCAClassificationWorkflow","abstract":[{"text":"A fitted CPU mean-imputation, standardization, PCA and binary logistic workflow.","type":"text"},{"text":" ","type":"text"},{"text":"Published instances expose no mutable stages. Saving never refits or reads prediction data.","type":"text"}],"navigatorTitle":[{"text":"PCAClassificationWorkflow","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/PCAClassificationWorkflow","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PCAClassificationWorkflow","kind":"identifier"}]},"doc://SwiftWorkflow/documentation/SwiftWorkflow":{"url":"\/documentation\/swiftworkflow","title":"SwiftWorkflow","abstract":[{"text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization.","type":"text"}],"type":"topic","role":"collection","identifier":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow","kind":"symbol"}}}