{"topicSections":[{"identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNet","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/Synset","doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/POS"],"anchor":"WordNet-Types","title":"WordNet Types"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"abstract":[{"type":"text","text":"Navigate semantic relationships, compute synset distances, and explore English hypernym\/hyponym trees."}],"kind":"article","sections":[],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftNLP"}],"title":"WordNet Semantic Hierarchy & Lexical Graphs"},"identifier":{"url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/WordNetAndLexicalGraphs","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/wordnetandlexicalgraphs"]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"WordNet"},{"type":"text","text":" is a large lexical database of English where nouns, verbs, adjectives, and adverbs are organized into sets of cognitive synonyms called "},{"type":"strong","inlineContent":[{"type":"text","text":"Synsets"}]},{"type":"text","text":", interlinked by conceptual-semantic and lexical relations."}]},{"level":2,"type":"heading","text":"1. Looking Up Synsets & Definitions","anchor":"1-Looking-Up-Synsets--Definitions"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","let wordnet = WordNet.shared","","\/\/ Look up all noun synsets for \"bank\"","let synsets = wordnet.synsets(for: \"bank\", pos: .noun)","for s in synsets {","    print(\"ID: \\(s.id), Definition: \\(s.definition)\")","}"]},{"level":2,"type":"heading","text":"2. Semantic Similarity Metrics","anchor":"2-Semantic-Similarity-Metrics"},{"type":"paragraph","inlineContent":[{"type":"text","tex