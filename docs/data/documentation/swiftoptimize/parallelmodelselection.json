{"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Cross-validation and multi-class classification workflows are embarrassingly parallel: each fold split and one-vs-rest binary sub-problem operates on independent slices of tabular data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"SwiftOptimize","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SwiftML","type":"codeVoice"},{"text":" leverage structured Swift Concurrency (","type":"text"},{"code":"withThrowingTaskGroup","type":"codeVoice"},{"text":") to dispatch multiple fold and class estimators concurrently.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Structured-Concurrency-Pipeline","text":"Structured Concurrency Pipeline","type":"heading"},{"syntax":null,"code":["           Input Dataset [Features, Targets]","                          │","       ┌──────────────────┴──────────────────┐","       ▼                                     ▼"," Fold 1 Split (Task 1)                 Fold 2 Split (Task 2)","   ├─ Fit Candidate                      ├─ Fit Candidate","   └─ Compute Metric                     └─ Compute Metric","       │                                     │","       └──────────────────┬──────────────────┘","                          ▼","            withThrowingTaskGroup Aggregator","                          ▼","         Cross-Validation Average Leaderboard"],"type":"codeListing"},{"level":3,"anchor":"Cooperative-Cancellation--Bounded-Budgets","text":"Cooperative Cancellation & Bounded Budgets","type":"heading"},{"inlineContent":[{"type":"text","text":"When training under a time budget (such as "},{"type":"codeVoice","code":"AutoML(timeBudgetSeconds:)"},{"type":"text","text":"), tasks run inside a managed scope. If the time budget expires or a fatal error occurs in a critical pipeline step, child tasks cooperatively respect task cancellation without leaking threads or memory."}],"type":"paragraph"},{"level":3,"anchor":"Deterministic-Class-Ordering","text":"Deterministic Class Ordering","type":"heading"},{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"OneVsRestClassifier"},{"text":", binary classification estimators are dispatched concurrently to maximize throughput across cores. Results are tagged with their class index ","type":"text"},{"type":"codeVoice","code":"(c, est)"},{"text":" and sorted prior to storage, ensuring 100% deterministic prediction ordering across runs.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Example-Usage","text":"Example Usage","type":"heading"},{"type":"codeListing","code":["import SwiftOptimize","import SwiftML","","\/\/ 1. Concurrent AutoML search across DecisionTree, RandomForest, and MLP","let automl = AutoML(timeBudgetSeconds: 30.0)","let report = try await automl.fit(features: X, targets: y)","print(\"Winning Model: \\(report.bestModel)\")","","\/\/ 2. Parallel One-Vs-Rest classification","let ovr = OneVsRestClassifier(numClasses: 5)","try await ovr.fit(features: X, targets: y)","let predictions = try await ovr.predict(features: X_test)"],"syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"variants":[{"paths":["\/documentation\/swiftoptimize\/parallelmodelselection"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency ","type":"text"},{"code":"TaskGroup","type":"codeVoice"},{"text":" primitives.","type":"text"}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/HyperparameterTuning"],"generated":true,"anchor":"Guides--Tutorials"}],"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftOptimize"}