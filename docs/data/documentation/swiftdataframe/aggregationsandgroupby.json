{"abstract":[{"text":"Master high-throughput columnar grouping, multi-key aggregations, and window transformations in SwiftDataFrame.","type":"text"}],"topicSections":[{"anchor":"Grouping-APIs","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)"],"title":"Grouping APIs"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/AggregationsAndGroupBy","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tabular analytical queries frequently demand grouping by categorical columns and computing summary statistics (mean, sum, variance, min, max, count) across numerical dimensions. "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" provides SIMD-accelerated grouping algorithms optimized for Apple Silicon unified memory."}]},{"level":2,"text":"1. Basic GroupBy Aggregation","anchor":"1-Basic-GroupBy-Aggregation","type":"heading"},{"type":"codeListing","code":["import SwiftDataFrame","","let df = try DataFrame(columns: [","    TypedColumn<String>(name: \"category\", values: [\"Tech\", \"Finance\", \"Tech\", \"Healthcare\", \"Finance\"]),","    TypedColumn<Double>(name: \"revenue\", values: [120.5, 340.0, 210.0, 95.0, 450.5]),","    TypedColumn<Double>(name: \"growth\", values: [0.15, 0.08, 0.22, 0.05, 0.12])","])","","\/\/ Compute mean revenue and sum of growth grouped by category","let grouped = try df.groupBy(\"category\")","    .aggregate([","        \"revenue\": .mean,","        \"growth\": .sum","    ])","","grouped.debugPrint()"],"syntax":"swift"},{"level":2,"text":"2. Multi-Column Grouping","anchor":"2-Multi-Column-Grouping","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can group by multiple categorical dimensions simultaneously:"}]},{"type":"codeListing","code":["let multiGrouped = try df.groupBy([\"region\", \"product_tier\"])","    .aggregate([","        \"sales\": .sum,","        \"discount\": .mean,","        \"quantity\": .count","    ])"],"syntax":"swift"},{"level":2,"text":"3. Performance & Memory Efficiency","anchor":"3-Performance--Memory-Efficiency","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Single-Pass Hash Accumulation"}],"type":"strong"},{"type":"text","text":": Group indices are computed using contiguous hash tables, avoiding unnecessary row permutations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"vDSP Vector Reductions"}],"type":"strong"},{"type":"text","text":": Numerical summaries within each group are calculated using Apple Accelerate SIMD routines ("},{"type":"codeVoice","code":"vDSP_sveD"},{"type":"text","text":", "},{"type":"codeVoice","code":"vDSP_meanvD"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"paths":["\/documentation\/swiftdataframe\/aggregationsandgroupby"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftDataFrame"}],"role":"collectionGroup","title":"High-Performance GroupBy & Vectorized Aggregations","roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"kind":"article","sections":[],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/DataFrame/groupBy(_:)":{"abstract":[{"text":"Returns a ","type":"text"},{"code":"GroupedDataFrame","type":"codeVoice"},{"text":" for aggregation.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/DataFrame\/groupBy(_:)","title":"groupBy(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"groupBy"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"