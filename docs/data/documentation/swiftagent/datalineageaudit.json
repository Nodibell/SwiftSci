{"abstract":[{"text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Audit-Types","title":"Audit Types"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"SwiftAgentEvaluator"},{"text":" automatically generates an immutable audit trail of ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true,"type":"reference"},{"text":" entries for each command evaluated.","type":"text"}],"type":"paragraph"},{"text":"LineageRecord Structure","type":"heading","level":2,"anchor":"LineageRecord-Structure"},{"inlineContent":[{"text":"Each ","type":"text"},{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","isActive":true,"type":"reference"},{"text":" contains:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"stepIndex","type":"codeVoice"},{"text":": Sequential index of the step within the agent trajectory.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"operation","type":"codeVoice"},{"text":": The normalized DSL command executed (e.g., ","type":"text"},{"type":"codeVoice","code":"filter(age)"},{"type":"text","text":", "},{"type":"codeVoice","code":"groupBy(category,mean)"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"inputRows"},{"type":"text","text":": Dataset row count immediately prior to transformation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"outputRows"},{"type":"text","text":": Dataset row count produced by the transformation."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"timestamp"},{"type":"text","text":": The exact timestamp of execution."}]}]}]},{"text":"Example: Accessing Audit Trails","type":"heading","level":2,"anchor":"Example-Accessing-Audit-Trails"},{"code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"],"type":"codeListing","syntax":"swift"}]}],"metadata":{"roleHeading":"API Collection","title":"Data Lineage & Transformation Audit Trails","modules":[{"name":"SwiftAgent"}],"role":"collectionGroup"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit"},"variants":[{"paths":["\/documentation\/swiftagent\/datalineageaudit"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"kind":"article","references":{"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"navigatorTitle":[{"kind":"identifier","text":"LineageRecord"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LineageRecord"}],"abstract":[{"text":"Represents an immutable audit trail entry recording a discrete data transformation step.","type":"text"}],"url":"\/documentation\/swiftagent\/lineagerecord","title":"LineageRecord"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","title":"SwiftAgentEvaluator","abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SwiftAgentEvaluator"}],"url":"\/documentation\/swiftagent\/swiftagentevaluator","type":"topic","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SwiftAgentEvaluator"}]},"doc://SwiftAgent/documentation/SwiftAgent":{"role":"collection","title":"SwiftAgent","abstract":[{"text":"Agentic REPL Execution Sandbox & RAG Summary Engine.","type":"text"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","kind":"symbol","type":"topic","url":"\/documentation\/swiftagent"}}}