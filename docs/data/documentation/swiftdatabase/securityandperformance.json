{"abstract":[{"type":"text","text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL."}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"topicSections":[{"title":"SQLite Performance","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SQLiteConnection"],"anchor":"SQLite-Performance"},{"title":"PostgreSQL Security","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection"],"anchor":"PostgreSQL-Security"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"],"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/securityandperformance"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"API Collection","title":"Security & Performance in SwiftDatabase","role":"collectionGroup","modules":[{"name":"SwiftDatabase"}]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"As datasets grow into the millions of rows and production PostgreSQL deployments enforce stronger authentication policies, ","type":"text"},{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" provides two complementary enhancements:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"1024-row column buffering","type":"text"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"SQLiteConnection.executeQuery"},{"type":"text","text":" reduces Swift "},{"type":"codeVoice","code":"Array"},{"type":"text","text":" reallocation pressure on large sequential table scans."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"SCRAM-SHA-256 authentication"}]},{"type":"text","text":" in "},{"type":"codeVoice","code":"PostgreSQLConnection"},{"type":"text","text":" implements the full RFC 5802\/7677 handshake using CryptoKit "},{"type":"codeVoice","code":"HMAC<SHA256>"},{"type":"text","text":" and iterative PBKDF2 — never transmitting the raw password over the wire."}]}]}],"type":"orderedList"},{"type":"heading","text":"1024-Row Column Buffering","anchor":"1024-Row-Column-Buffering","level":2},{"type":"heading","text":"Problem","anchor":"Problem","level":3},{"inlineContent":[{"type":"text","text":"The naive approach appends each decoded row immediately to a growing "},{"code":"[[AnySendableValue]]","type":"codeVoice"},{"type":"text","text":" array. Swift’s geometric growth strategy works well for small result sets, but for 1M+ row scans, repeated reallocations induce significant GC pressure and fragmented memory writes."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Solution","anchor":"Solution"},{"inlineContent":[{"type":"codeVoice","code":"executeQuery"},{"text":" pre-allocates a local ","type":"text"},{"type":"codeVoice","code":"page"},{"text":" buffer of exactly 1024 rows. When the page fills, it is bulk-appended to the result array via ","type":"text"},{"code":"rows.append(contentsOf: page)","type":"codeVoice"},{"text":", then the page is cleared with ","type":"text"},{"code":"removeAll(keepingCapacity: true)","type":"codeVoice"},{"text":" to avoid reallocation.","type":"text"}],"type":"paragraph"},{"code":["let pageSize = 1024","var page: [[AnySendableValue]] = []","page.reserveCapacity(pageSize)","","while sqlite3_step(stmt) == SQLITE_ROW {","    page.append(decodeRow())","    if page.count == pageSize {","        rows.append(contentsOf: page)","        page.removeAll(keepingCapacity: true)","    }","}","rows.append(contentsOf: page) \/\/ Flush remainder"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Benchmark impact","type":"text"}]},{"type":"text","text":": ~40% fewer allocations on 500K-row tables vs. naive append."}]},{"text":"SCRAM-SHA-256 Authentication","level":2,"type":"heading","anchor":"SCRAM-SHA-256-Authentication"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modern PostgreSQL (>= 14) defaults to "},{"code":"scram-sha-256","type":"codeVoice"},{"type":"text","text":" in "},{"code":"pg_hba.conf","type":"codeVoice"},{"type":"text","text":". "},{"code":"SwiftDatabase","type":"codeVoice"},{"type":"text","text":"’s wire-protocol driver now supports the full RFC 5802 exchange:"}]},{"type":"codeListing","syntax":null,"code":["Client                                    Server","  │  SASLInitialResponse(SCRAM-SHA-256)     │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLContinue(salt, i)    │","  │ ◄────────────────────────────────────── │","  │  SASLResponse(ClientProof)              │","  │ ──────────────────────────────────────► │","  │  AuthenticationSASLFinal + AuthOK       │","  │ ◄────────────────────────────────────── │"]},{"text":"PBKDF2-SHA256 via CryptoKit","level":3,"type":"heading","anchor":"PBKDF2-SHA256-via-CryptoKit"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"SaltedPassword = Hi(password, salt, iterations)","type":"codeVoice"},{"text":" derivation uses a pure Swift PBKDF2 loop over CryptoKit ","type":"text"},{"code":"HMAC<SHA256>","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["var u = HMAC<SHA256>.authenticationCode(for: salt + [0,0,0,1], using: SymmetricKey(data: passwordData))","var saltedPassword = Array(u)","for _ in 1..<iterations {","    u = HMAC<SHA256>.authenticationCode(for: Data(u), using: ...)","    \/\/ XOR accumulate","}"]},{"text":"Enabling SCRAM on PostgreSQL Server","level":2,"type":"heading","anchor":"Enabling-SCRAM-on-PostgreSQL-Server"},{"type":"codeListing","syntax":"sql","code":["-- pg_hba.conf","host  all  all  0.0.0.0\/0  scram-sha-256","","-- Verify in psql:","SELECT usename, passwd FROM pg_shadow;","-- Password should start with: SCRAM-SHA-256$4096:..."]}]}],"identifier":{"url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance","interfaceLanguage":"swift"},"sections":[],"kind":"article","references":{"doc://SwiftDatabase/documentation/SwiftDatabase/DatabaseConnectors":{"url":"\/documentation\/swiftdatabase\/databaseconnectors","abstract":[{"text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into ","type":"text"},{"code":"SwiftDataFrame","type":"codeVoice"},{"text":" under Swift 6 Actor Concurrency.","type":"text"}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors","kind":"article","title":"Relational Database Drivers & Zero-Copy SQL Ingestion","type":"topic","role":"article"},"doc://SwiftDatabase/documentation/SwiftDatabase":{"type":"topic","title":"SwiftDatabase","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase","kind":"symbol","abstract":[{"text":"Relational Database Connectors to DataFrames.","type":"text"}],"url":"\/documentation\/swiftdatabase","role":"collection"},"doc://SwiftDatabase/documentation/SwiftDatabase/PostgreSQLConnection":{"role":"symbol","abstract":[{"type":"text","text":"Native PostgreSQL database connection driver using PostgreSQL v3.0 wire protocol."}],"identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/PostgreSQLConnection","url":"\/documentation\/swiftdatabase\/postgresqlconnection","title":"PostgreSQLConnection","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostgreSQLConnection"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PostgreSQLConnection"}]},"doc://SwiftDatabase/documentat