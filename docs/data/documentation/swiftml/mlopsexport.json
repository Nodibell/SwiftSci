{"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Core ML Exporter API","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter"],"anchor":"Core-ML-Exporter-API"}],"metadata":{"modules":[{"name":"SwiftML"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Exporting Models to Core ML and ONNX"},"variants":[{"paths":["\/documentation\/swiftml\/mlopsexport"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Export trained SwiftSci estimators to native Apple Core ML ("},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":") and cross-platform ONNX ("},{"type":"codeVoice","code":".onnx"},{"type":"text","text":") binary artifacts for production deployment."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftSci provides native, wire-format serialization engines for both Apple Core ML and ONNX without requiring external Python tooling or code generation steps. Models trained natively in Swift can be directly exported to binary artifacts compatible with Apple Neural Engine (ANE), Metal GPU, CPU, and ONNX Runtime."}]},{"level":2,"anchor":"1-Core-ML-Binary-Export-mlmodel","type":"heading","text":"1. Core ML Binary Export (`.mlmodel`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftSci implements binary Protocol Buffer serialization directly conforming to Apple’s "},{"type":"codeVoice","code":"Model.proto"},{"type":"text","text":" specification (v4)."}]},{"type":"heading","anchor":"Supported-Estimators","level":3,"text":"Supported Estimators"},{"header":"row","alignments":["left","left","left"],"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Estimator"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Core ML Message"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Target Hardware"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LinearRegression"}]}],[{"inlineContent":[{"type":"codeVoice","code":"GLMRegressor"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"LogisticRegression","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"GLMClassifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"DecisionTreeClassifier"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TreeEnsembleClassifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"DecisionTreeRegressor","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"TreeEnsembleRegressor"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"RandomForestClassifier"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"TreeEnsembleClassifier","type":"codeVoice"},{"text":" (multi-tree)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"RandomForestRegressor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"TreeEnsembleRegressor","type":"codeVoice"},{"text":" (multi-tree)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}]}]]]},{"level":3,"type":"heading","anchor":"Using-the-CoreMLExportable-Protocol","text":"Using the `CoreMLExportable` Protocol"},{"inlineContent":[{"type":"text","text":"All supported model types conform to the "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","isActive":true},{"type":"text","text":" protocol, providing asynchronous export methods:"}],"type":"paragraph"},{"code":["import SwiftML","","\/\/ Train a Random Forest Classifier","let rf = try RandomForestClassifier(nEstimators: 50, maxDepth: 8)","try await rf.fit(features: X_train, targets: y_train)","","\/\/ Export directly to a .mlmodel file","let exportURL = URL(fileURLWithPath: \"\/path\/to\/RandomForest.mlmodel\")","try await rf.writeCoreML(","    to: exportURL,","    featureNames: [\"age\", \"income\", \"credit_score\"],","    outputName: \"approved\"",")"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Direct-Serialization-via-CoreMLExporter","text":"Direct Serialization via `CoreMLExporter`"},{"inlineContent":[{"type":"text","text":"You can also use static methods on "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","isActive":true},{"type":"text","text":" to produce binary "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" payloads:"}],"type":"paragraph"},{"code":["\/\/ Export fitted linear regression","let modelData = CoreMLExporter.exportBinaryLinearModel(","    name: \"HousePricePredictor\",","    inputNames: [\"sqft\", \"bedrooms\", \"bathrooms\"],","    outputName: \"price\",","    weights: [250.0, 15000.0, 10000.0],","    bias: 50000.0",")","","try modelData.write(to: URL(fileURLWithPath: \"HousePricePredictor.mlmodel\"))"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Exporting-Composite-Pipelines--Modern-mlpackage","text":"Exporting Composite Pipelines & Modern .mlpackage"},{"inlineContent":[{"type":"text","text":"SwiftSci v3.3.0 supports exporting multi-stage composite pipelines and modern "},{"type":"codeVoice","code":".mlpackage"},{"type":"text","text":" directory bundles:"}],"type":"paragraph"},{"code":["\/\/ Export composite pipeline chaining preprocessing + classifier","let pipelineData = CoreMLExporter.exportBinaryPipelineClassifier(","    models: [scalerData, rfData],","    names: [\"Scaler\", \"RandomForestClassifier\"],","    inputNames: [\"age\", \"income\"],","    outputName: \"approved\"",")","","\/\/ Export directly into modern .mlpackage bundle format","try CoreMLExporter.writeMLPackage(","    modelData: pipelineData,","    to: URL(fileURLWithPath: \"\/path\/to\/MyPipeline.mlpackage\"),","    author: \"SwiftSci Developer\",","    description: \"End-to-end data science inference pipeline\"",")"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Loading-in-Client-Applications","text":"Loading in Client Applications"},{"inlineContent":[{"type":"text","text":"Exported "},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":" and "},{"type":"codeVoice","code":".mlpackage"},{"type":"text","text":" files can be compiled and loaded dynamically using Apple’s "},{"type":"codeVoice","code":"CoreML"},{"type":"text","text":" framework:"}],"type":"paragraph"},{"code":["import CoreML","","let compiledURL = try MLModel.compileModel(at: exportURL)","let mlModel = try MLModel(contentsOf: compiledURL)","","let inputDict: [String: Any] = [\"age\": 35.0, \"income\": 75000.0, \"credit_score\": 720.0]","let featureProvider = try MLDictionaryFeatureProvider(dictionary: inputDict)","let output = try mlModel.prediction(from: featureProvider)"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"2-ONNX-Binary-Export-onnx","text":"2. ONNX Binary Export (`.onnx`)"},{"inlineContent":[{"type":"text","text":"SwiftSci provides native binary ONNX wire-format export via "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiftML","","let onnxData = ONNXExporter.exportBinaryONNX(","    name: \"LinearONNX\",","    inputs: [\"features\"],","    output: \"prediction\",","    weights: [1.5, -2.0, 0.75],","    bias: 0.5",")","","try onnxData.write(to: URL(fileURLWithPath: \"model.onnx\"))"],"type":"codeListing","syntax":"swift"}]}],"seeAlsoSections":[{"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG"],"generated":true,"anchor":"Guides--Tutorials"}],"sections":[],"kind":"article","identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"references":{"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"kind":"article","url":"\/documentation\/swiftml\/supervisedclassifiers","role":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","abstract":[{"type":"text","text":"Train classification models using LogisticRegression, DecisionTreeClassifier, RandomForestClassifier, and MLPClassifier."}],"title":"Supervised Classification Models","type":"topic"},"doc://SwiftML/documentation/SwiftML/CoreMLExportable":{"navigatorTitle":[{"text":"CoreMLExportable","kind":"identifier"}],"url":"\/documentation\/swiftml\/coremlexportable","title":"CoreMLExportable","type":"topic","role":"symbol","abstract":[{"text":"A protocol for SwiftML estimators that support exporting a trained model","type":"text"},{"text":" ","type":"text"},{"text":"as a binary Apple Core ML ","type":"text"},{"type":"codeVoice","code":".mlmodel"},{"text":" artifact.","type":"text"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreMLExportable","kind":"identifier"}]},"doc://SwiftML/documentation/SwiftML/CoreMLExporter":{"navigatorTitle":[{"kind":"identifier","text":"CoreMLExporter"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","type":"topic","abstract":[{"type":"text","text":"Exports fitted SwiftML models to Apple Core ML artifact formats."}],"kind":"symbol","title":"CoreMLExporter","url":"\/documentation\/swiftml\/coremlexporter","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreMLExporter"}]},"doc://SwiftML/documentation/SwiftML/EarlyStoppingCallbacks":{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","type":"topic","abstract":[{"text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting.","type":"text"}],"title":"Early Stopping & Generalization Control","url":"\/documentation\/swiftml\/earlystoppingcallbacks","kind":"article","role":"collectionGroup"},"doc://SwiftML/documentation/SwiftML":{"kind":"symbol","url":"\/documentation\/swiftml","role":"collection","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","abstract":[{"text":"Supervised Machine Learning Estimators & Neural Networks.","type":"text"}],"title":"SwiftML","type":"topic"},"doc://SwiftML/documentation/SwiftML/EnsembleLearning":{"title":"Ensemble Learning: Random Forests & Gradient Boosted Trees","abstract":[{"type":"text","text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism."}],"role":"collectionGroup","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","kind":"article","url":"\/documentation\/swiftml\/ensemblelearning"},"doc://SwiftML/documentation/SwiftML/ONNXExporter":{"abstract":[{"text":"Exporter for serializing SwiftML models into ONNX model graph specification JSON format.","type":"text"},{"text":" ","type":"text"},{"text":"Note: Produces a JSON representation of the ONNX graph, not a binary .onnx file.","type":"text"}],"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ONNXExporter"}],"title":"ONNXExporter","navigatorTitle":[{"kind":"identifier","text":"ONNXExporter"}],"kind":"symbol","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter","url":"\/documentation\/swiftml\/onnxexporter"},"doc://SwiftML/documentation/SwiftML/HistogramGradientBoosting":{"title":"Fast Tabular Learning with Histogram Gradient Boosting","abstract":[{"type":"text","text":"Discretize continuous feature distributions into 256 compact bins to accelerate decision tree split evaluations from (O(N \\log N)) to (O(K))."}],"role":"collectionGroup","type":"topic","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","kind":"article","url":"\/documentation\/swiftml\/histogramgradientboosting"},"doc://SwiftML/documentation/SwiftML/ReproducibilityAndPRNG":{"kind":"article","url":"\/documentation\/swiftml\/reproducibilityandprng","role":"collectionGroup","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","abstract":[{"type":"text","text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators."}],"title":"Reproducibility, Determinism & High-Quality PRNG","type":"topic"},"doc://SwiftML/documentation/SwiftML/SupervisedRegressors":{"kind":"article","url":"\/documentation\/swiftml\/supervisedregressors","role":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","abstract":[{"type":"text","text":"Perform continuous target predictions using LinearRegression (exact OLS), DecisionTreeRegressor, and GradientBoostedTreesRegressor."}],"title":"Supervised Regression Models","type":"topic"}}}