{"kind":"article","identifier":{"url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KalmanFiltering","interfaceLanguage":"swift"},"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftForecast"}],"title":"State-Space Modeling & Joseph-Form Kalman Filters"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftforecast\/kalmanfiltering"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"The Kalman Filter is an optimal linear-quadratic recursive estimator for dynamical systems observed through noisy measurements. ","type":"text"},{"code":"SwiftForecast","type":"codeVoice"},{"text":" implements both 1D and multidimensional Kalman filters with ","type":"text"},{"inlineContent":[{"type":"text","text":"Joseph-form covariance stabilization"}],"type":"strong"},{"text":" to prevent numerical divergence.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"1-Joseph-Form-Covariance-Update","text":"1. Joseph-Form Covariance Update"},{"inlineContent":[{"text":"Standard covariance update $P_{k|k} = (I - K_k H) P_{k|k-1}$ can become non-positive definite due to floating-point round-off errors. SwiftForecast uses the ","type":"text"},{"inlineContent":[{"type":"text","text":"Joseph stabilized form"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"$$P_{k|k} = (I - K_k H) P_{k|k-1} (I - K_k H)^T + K_k R_k K_k^T$$","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This formulation guarantees that the error covariance matrix remains symmetric and positive-semidefinite under all operating conditions.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"2-Code-Example-1D-Kalman-Tracking","text":"2. Code Example: 1D Kalman Tracking"},{"code":["import SwiftForecast","","var kf = KalmanFilter1D(","    processVariance: 1e-4,","    measurementVariance: 0.1,","    estimationError: 1.0,","    initialValue: 0.0",")","","let noisySignals = [1.02, 0.98, 1.05, 0.95, 1.10, 0.99]","var filteredValues: [Double] = []","","for z in noisySignals {","    let state = kf.update(measurement: z)","    filteredValues.append(state)","}","","print(\"Filtered trajectory: \\(filteredValues)\")"],"type":"codeListing","syntax":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Perform real-time sensor fusion, state estimation, and noise reduction with numerically stable Kalman Filters."}],"hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://SwiftForecast/documentation/SwiftForecast":{"url":"\/documentation\/swiftforecast","abstract":[{"text":"Time Series & Volatility Forecasting Models.","type":"text"}],"type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast","title":"SwiftForecast"}}}