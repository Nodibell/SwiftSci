{"sections":[],"abstract":[{"type":"text","text":"Direct high-throughput database connectivity for SQLite, PostgreSQL, and MySQL into "},{"type":"codeVoice","code":"SwiftDataFrame"},{"type":"text","text":" under Swift 6 Actor Concurrency."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem","doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"],"title":"Guides & Tutorials"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/DatabaseConnectors"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdatabase\/databaseconnectors"]}],"hierarchy":{"paths":[["doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"SwiftDatabase"}],"title":"Relational Database Drivers & Zero-Copy SQL Ingestion","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiftDatabase"},{"type":"text","text":" provides native, zero-dependency, pure-Swift network wire-protocol drivers and embedded SQLite connectors. All connection types are implemented as Swift 6 "},{"type":"codeVoice","code":"public actor"},{"type":"text","text":" types, guaranteeing complete thread safety and preventing data races across concurrent tasks."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"🔒 Driver Architecture & Concurrency Model","level":2,"anchor":"%F0%9F%94%92-Driver-Architecture--Concurrency-Model","type":"heading"},{"code":["Swift 6 Concurrency Layer","┌─────────────────────────────────────────────────────────────┐","│ actor SQLiteConnection        (C-API Prepared Statements)   │","│ actor PostgreSQLConnection    (Pure-Swift v3.0 Wire Recv)   │","│ actor MySQLConnection         (Client\/Server Binary Packet) │","└──────────────────────────────┬──────────────────────────────┘","                               │","                               ▼","┌─────────────────────────────────────────────────────────────┐","│       Zero-Copy Column Ingestion into SwiftDataFrame        │","└─────────────────────────────────────────────────────────────┘"],"syntax":null,"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Actor Isolation:","type":"text"}],"type":"strong"},{"type":"text","text":" Concurrent queries to the same database connection are automatically serialized without external lock primitives."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Streaming "},{"type":"codeVoice","code":"recv"},{"type":"text","text":" Buffer:"}]},{"type":"text","text":" Network drivers use a 64KB receive buffer reading continuously until "},{"type":"codeVoice","code":"ReadyForQuery ('Z')"},{"type":"text","text":" is received."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Authentication:"}]},{"type":"text","text":" Built-in support for Cleartext and MD5 password authentication via "},{"type":"codeVoice","code":"CommonCrypto"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"text":"1. Querying SQLite Databases","level":2,"anchor":"1-Querying-SQLite-Databases","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SQLiteConnection"},{"type":"text","text":" executes SQL statements through native "},{"type":"codeVoice","code":"sqlite3_prepare_v2"},{"type":"text","text":" and directly streams result rows into columnar "},{"type":"codeVoice","code":"TypedColumn"},{"type":"text","text":" buffers:"}],"type":"paragraph"},{"code":["import Foundation","import SwiftDatabase","import SwiftDataFrame","","\/\/ 1. Initialize SQLite connection to file or in-memory","let sqlite = try SQLiteConnection(path: \"analytics.sqlite\")","","\/\/ 2. Execute SQL query into a DataFrame","let df = try await DataFrame.fromSQL(","    \"SELECT id, temperature, humidity, timestamp FROM sensor_logs WHERE temperature > 25.0\",","    connection: sqlite",")","","print(\"Ingested \\(df.shape.rows) rows with \\(df.shape.columns) columns:\")","df.debugPrint(maxRows: 5)"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"text":"2. PostgreSQL Wire Connection (v3.0 Protocol)","level":2,"anchor":"2-PostgreSQL-Wire-Connection-v30-Protocol","type":"heading"},{"inlineContent":[{"type":"text","text":"Connect to remote PostgreSQL clusters over TCP\/TLS without external C libraries ("},{"type":"codeVoice","code":"libpq"},{"type":"text","text":"):"}],"type":"paragraph"},{"code":["import SwiftDatabase","import SwiftDataFrame","","let pgConn = try PostgreSQLConnection(","    host: \"localhost\",","    port: 5432,","    database: \"production_db\",","    username: \"postgres\",","    password: \"secure_password\",","    useSSL: false",")","","\/\/ Ingest query results asynchronously","let salesDF = try await DataFrame.fromSQL(","    \"SELECT customer_id, total_amount, order_date FROM orders ORDER BY order_date DESC LIMIT 1000\",","    connection: pgConn",")","","print(\"Fetched \\(salesDF.shape.rows) orders from PostgreSQL.\")"],"syntax":"swift","type":"codeListing"},{"type":"thematicBreak"},{"text":"3. High-Throughput Bulk Writeback (`toSQL`)","level":2,"anchor":"3-High-Throughput-Bulk-Writeback-toSQL","type":"heading"},{"inlineContent":[{"type":"text","text":"Bulk export in-memory "},{"type":"codeVoice","code":"DataFrame"},{"type":"text","text":" objects back into database tables with configurable append or replace modes:"}],"type":"paragraph"},{"code":["\/\/ Write transformed DataFrame to database","try await salesDF.toSQL(","    table: \"aggregated_metrics\",","    connection: sqlite,","    mode: .replace,      \/\/ .append or .replace","    batchSize: 500,","    failIfExists: false",")","","print(\"Successfully written DataFrame to 'aggregated_metrics' table.\")"],"syntax":"swift","type":"codeListing"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Concurrency Tip:"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"For multi-threaded web servers and asynchronous pipelines, initialize a pool of actor connections ("},{"type":"codeVoice","code":"DatabasePool"},{"type":"text","text":") to parallelize read workloads across multiple connections."}]}],"style":"note","type":"aside"}]}],"references":{"doc://SwiftDatabase/documentation/SwiftDatabase":{"url":"\/documentation\/swiftdatabase","abstract":[{"text":"Relational Database Connectors to DataFrames.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase","title":"SwiftDatabase"},"doc://SwiftDatabase/documentation/SwiftDatabase/SecurityAndPerformance":{"abstract":[{"type":"text","text":"High-throughput SQLite column-buffered ingestion and modern SCRAM-SHA-256 password authentication for PostgreSQL."}],"role":"collectionGroup","title":"Security & Performance in SwiftDatabase","kind":"article","type":"topic","url":"\/documentation\/swiftdatabase\/securityandperformance","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/SecurityAndPerformance"},"doc://SwiftDatabase/documentation/SwiftDatabase/HighThroughputIngestion":{"url":"\/documentation\/swiftdatabase\/highthroughputingestion","abstract":[{"type":"text","text":"Ingest millions of tabular rows into SQLite, PostgreSQL, and MySQL using zero-dependency wire protocols and batch writeback."}],"kind":"article","role":"collectionGroup","type":"topic","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/HighThroughputIngestion","title":"Bulk SQL Ingestion & Database Wire Protocols"},"doc://SwiftDatabase/documentation/SwiftDatabase/TypeSystem":{"abstract":[{"type":"text","text":"Explore the strongly typed, thread-safe value representations supporting relational database columns and zero-copy conversions."}],"role":"collectionGroup","title":"Database Type System & Value Representation","kind":"article","type":"topic","url":"\/documentation\/swiftdatabase\/typesystem","identifier":"doc:\/\/SwiftDatabase\/documentation\/SwiftDatabase\/TypeSystem"}}}