{"metadata":{"modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Data Lineage & Transformation Audit Trails"},"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/datalineageaudit"]}],"topicSections":[{"anchor":"Audit-Types","title":"Audit Types","identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When autonomous LLM agents manipulate datasets via DSL commands or tool execution, compliance and debugging require a complete record of every transformation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftAgentEvaluator"},{"type":"text","text":" automatically generates an immutable audit trail of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord"},{"text":" entries for each command evaluated.","type":"text"}]},{"anchor":"LineageRecord-Structure","text":"LineageRecord Structure","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/LineageRecord"},{"type":"text","text":" contains:"}]},{"items":[{"content":[{"inlineContent":[{"code":"stepIndex","type":"codeVoice"},{"type":"text","text":": Sequential index of the step within the agent trajectory."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"operation","type":"codeVoice"},{"type":"text","text":": The normalized DSL command executed (e.g., "},{"type":"codeVoice","code":"filter(age)"},{"type":"text","text":", "},{"type":"codeVoice","code":"groupBy(category,mean)"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"inputRows"},{"text":": Dataset row count immediately prior to transformation.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"outputRows"},{"text":": Dataset row count produced by the transformation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"timestamp"},{"text":": The exact timestamp of execution.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Example: Accessing Audit Trails","type":"heading","level":2,"anchor":"Example-Accessing-Audit-Trails"},{"syntax":"swift","type":"codeListing","code":["import SwiftAgent","import SwiftDataFrame","","let evaluator = SwiftAgentEvaluator()","let filteredDF = try await evaluator.evaluate(command: \"filter age > 25\", on: rawDF)","let aggregatedDF = try await evaluator.evaluate(command: \"groupby department mean\", on: filteredDF)","","let auditTrail = await evaluator.lineage","for record in auditTrail {","    print(\"Step \\(record.stepIndex): \\(record.operation) [\\(record.inputRows) -> \\(record.outputRows) rows] at \\(record.timestamp)\")","}","","\/\/ Reset audit trail when starting a fresh session:","await evaluator.clearLineage()"]}],"kind":"content"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/DataLineageAudit"},"abstract":[{"type":"text","text":"Track and inspect the complete lifecycle and data flow of tabular transformations in autonomous agents."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://SwiftAgent/documentation/SwiftAgent/LineageRecord":{"kind":"symbol","abstract":[{"type":"text","text":"Represents an immutable audit trail entry recording a discrete data transformation step."}],"url":"\/documentation\/swiftagent\/lineagerecord","type":"topic","role":"symbol","title":"LineageRec