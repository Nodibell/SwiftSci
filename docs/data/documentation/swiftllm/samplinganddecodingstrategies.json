{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"During autoregressive language generation, logits from the transformer output layer are converted into probability distributions over the vocabulary. ","type":"text"},{"type":"codeVoice","code":"SwiftLLM"},{"text":" executes sampling transformations strictly at the unnormalized logits level prior to softmax evaluation:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"$$\\text{Logits} \\xrightarrow{\\text{Repetition Penalty}} \\xrightarrow{\\text{Temperature}} \\xrightarrow{\\text{Top-K Mask (-inf)}} \\xrightarrow{\\text{Top-P Mask (-inf)}} \\xrightarrow{\\text{Softmax}} \\xrightarrow{\\text{Sample}}$$","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"1. Supported Sampling Methods","anchor":"1-Supported-Sampling-Methods"},{"type":"table","alignments":["left","left","left"],"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mathematical Formulation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Semantics & Defaults"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Temperature ("},{"type":"codeVoice","code":"temperature"},{"type":"text","text":")"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"$z_i \\leftarrow z_i \/ T$"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Controls distribution entropy. "},{"code":"1.0","type":"codeVoice"},{"type":"text","text":" = identity; "},{"code":"0.0","type":"codeVoice"},{"text":" = greedy deterministic argmax. Default: ","type":"text"},{"type":"codeVoice","code":"0.7"},{"text":".","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Top-K ("},{"type":"codeVoice","code":"topK"},{"type":"text","text":")"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Masks all tokens outside top $K$ with $-\\infty$"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Eliminates low-probability tail tokens. "},{"type":"codeVoice","code":"0"},{"type":"text","text":" disables Top-K filtering. Default: "},{"type":"codeVoice","code":"40"},{"type":"text","text":"."}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Top-P Nucleus ("},{"type":"codeVoice","code":"topP"},{"type":"text","text":")"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Retains cumulative probability $\\sum P(w_i) \\ge p$","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Dynamically bounds candidates based on probability mass. ","type":"text"},{"type":"codeVoice","code":"1.0"},{"text":" disables Top-P. Default: ","type":"text"},{"type":"codeVoice","code":"0.9"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Repetition Penalty ("},{"type":"codeVoice","code":"repetitionPenalty"},{"type":"text","text":")"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"$z_i \\leftarrow z_i > 0 \\ ? \\ z_i \/ \\theta : z_i \\cdot \\theta$"}]}],[{"inlineContent":[{"type":"text","text":"Penalizes tokens previously emitted in generation history. "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":" disables penalty. Default: "},{"type":"codeVoice","code":"1.0"},{"type":"text","text":"."}],"type":"paragraph"}]]],"header":"row"},{"anchor":"2-Configuration--Code-Example","level":2,"type":"heading","text":"2. Configuration & Code Example"},{"inlineContent":[{"type":"text","text":"Generation options are unified within "},{"code":"SamplingConfiguration","type":"codeVoice"},{"text":", serving as the single source of truth inside ","type":"text"},{"code":"LLMOptions","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["im