{"hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"kind":"article","primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"On-Device RAG combines fast local vector retrieval with on-device language models to provide accurate, grounded answers from private local documents without cloud network dependencies.","type":"text"}],"type":"paragraph"},{"code":["graph LR","    Query[User Query] --> Embed[LocalEmbeddingEngine]","    Embed --> Vec[Dense Vector]","    Vec --> Search[VectorStore Top-K]","    Docs[Private Document Index] --> Search","    Search --> Chunks[Retrieved Text Snippets]","    Chunks --> Prompt[Augmented Prompt]","    Prompt --> LLM[SwiftLLM Metal Engine]","    LLM --> Answer[Grounded Answer]"],"type":"codeListing","syntax":"mermaid"},{"level":2,"anchor":"1-Complete-End-to-End-Pipeline-Example","type":"heading","text":"1. Complete End-to-End Pipeline Example"},{"code":["import SwiftAgent","import SwiftCluster","import SwiftNLP","import SwiftLLM","","\/\/ 1. Initialize local embedding engine and vector store","let embedEngine = LocalEmbeddingEngine(dimension: 128)","let vectorStore = VectorStore(metric: .cosineSimilarity)","","\/\/ 2. Ingest private knowledge base","let corpus = [","    \"SwiftSci uses Apple Accelerate vDSP for SIMD arithmetic.\",","    \"MLX provides unified memory GPU tensor computation on Mac.\",","    \"WiredMemoryManager prevents out-of-memory errors on shared RAM.\"","]","","for (id, text) in corpus.enumerated() {","    let vec = embedEngine.embed(text)","    vectorStore.add(id: \"doc_\\(id)\", vector: vec, metadata: [\"content\": text])","}","","\/\/ 3. Retrieve relevant context for user question","let userQuestion = \"How does SwiftSci accelerate vector math?\"","let queryVector = embedEngine.embed(userQuestion)","let topMatches = vectorStore.search(query: queryVector, topK: 1)","","let contextSnippet = topMatches.first?.metadata[\"content\"] ?? \"\"","","\/\/ 4. Assemble augmented prompt and query local LLM","let augmentedPrompt = \"\"\"","Context: \\(contextSnippet)","Question: \\(userQuestion)","Answer:","\"\"\""],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/ragandcontextaugmentation"]}],"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGAndContextAugmentation","interfaceLanguage":"swift"},"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftAgent"}],"roleHeading":"API Collection","title":"Building On-Device RAG Pipelines"},"abstract":[{"type":"text","text":"Construct privacy-preserving Retrieval-Augmented Generation workflows on Apple Silicon."}],"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Agent-Components","title":"Agent Components"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://SwiftAgent/documentation/SwiftAgent":{"abstract":[{"text":"Agentic REPL Execution Sandbox & RAG Summary Engine.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","title":"SwiftAgent","url":"\/documentation\/swiftagent","role":"collection"},"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiftAgentEvaluator","kind":"identifier"}],"identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","abstract":[{"text":"Agentic Swift Execution Sandbox Evaluator.","type":"text"}],"title":"SwiftAgentEvaluator","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"SwiftAgentEvaluator","kind":"identifier"}],"url":"\/documentation\/swiftagent\/swiftagentevaluator"}}}