{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Orchestrate teams of specialized autonomous agents over an asynchronous message bus with concurrent parallel tool calling.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftagent\/multiagentcollaboration"]}],"identifier":{"url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentCollaboration","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"API Collection","title":"Multi-Agent Coordination & Protocols","role":"collectionGroup","modules":[{"name":"SwiftAgent"}]},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/MultiAgentOrchestrator","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessageBus","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentMessage","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolCall","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgentToolResult","doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SpecializedAgent"],"anchor":"Multi-Agent-Coordination","title":"Multi-Agent Coordination"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"Complex analytical and reasoning workflows are frequently error-prone when performed by a single monolithic model. Decomposing problems into specialized roles—such as ","type":"text"},{"inlineContent":[{"text":"Planner","type":"text"}],"type":"strong"},{"text":", ","type":"text"},{"inlineContent":[{"text":"Analyst","type":"text"}],"type":"strong"},{"text":", and ","type":"text"},{"inlineContent":[{"text":"Critic","type":"text"}],"type":"strong"},{"text":"—drastically improves reasoning accuracy, reduces hallucinations, and permits parallelized tool execution.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"SwiftAgent","type":"codeVoice"},{"text":" provides ","type":"text"},{"code":"MultiAgentOrchestrator","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AgentMessageBus","type":"codeVoice"},{"text":", a reactive multi-agent framework built on Swift’s structured concurrency primitives (","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"withTaskGroup","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"anchor":"Architectural-Topology","level":2,"type":"heading","text":"Architectural Topology"},{"code":["                         ┌───────────────────────┐","                         │   User \/ Prompt Task  │","                         └───────────┬───────────┘","                                     │","                                     ▼","                       ┌───────────────────────────┐","                       │      AgentMessageBus      │","                       │       (AsyncStream)       │","                       └─────────────┬─────────────┘","                                     │ Broadcasts","         ┌───────────────────────────┼───────────────────────────┐","         ▼                           ▼                           ▼","┌──────────────────┐       ┌──────────────────┐       ┌──────────────────┐","│     Planner      │       │     Analyst      │       │      Critic      │","│ Decomposes steps │       │ Queries & Models │       │ Validates logic  │","└────────┬─────────┘       └────────┬─────────┘       └────────┬─────────┘","         │                          │                          │","         └──────────────────────────┼──────────────────────────┘","                                    │ Parallel Tool Calls","                                    ▼","                     ┌─────────────────────────────┐","                     │ MultiAgentOrchestrator      │","                     │ withTaskGroup Tool Executor │","                     └──────────────┬──────────────┘","                                    │","               ┌────────────────────┴────────────────────┐","               ▼                                         ▼","      DataFrame Query Tool                      Statistical Model Tool"],"syntax":null,"type":"codeListing"},{"anchor":"Parallel-Tool-Calling","level":2,"type":"heading","text":"Parallel Tool Calling"},{"inlineContent":[{"text":"When an agent requests multiple tool executions in a single reasoning step (e.g. computing standard deviations across three columns concurrently), ","type":"text"},{"code":"MultiAgentOrchestrator.executeToolsInParallel(_:)","type":"codeVoice"},{"text":" executes them simultaneously across available CPU cores using ","type":"text"},{"code":"withTaskGroup","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This reduces total latency from $\\sum_{i=1}^M T_i$ to $\\max_{i} T_i$.","type":"text"}],"type":"paragraph"},{"anchor":"Example-Usage","level":2,"type":"heading","text":"Example Usage"},{"code":["import SwiftAgent","import SwiftDataFrame","","\/\/ 1. Initialize orchestrator and message bus","let orchestrator = MultiAgentOrchestrator(maxRounds: 5)","","\/\/ 2. Register specialized agents","orchestrator.registerAgent(PlannerAgent())","orchestrator.registerAgent(DataAnalystAgent())","orchestrator.registerAgent(CriticAgent())","","\/\/ 3. Register tools","orchestrator.registerTool(DataFrameAgentTool(dataframe: salesData))","","\/\/ 4. Run collaborative execution","let solution = try await orchestrator.run(","    taskPrompt: \"Identify top 3 departments by salary variance and critique findings.\"",")","print(\"Consensus Answer: \\(solution)\")"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/AgenticReplAndRAG"],"anchor":"Guides--Tutorials","generated":true,"title":"Guides & Tutorials"}],"references":{"doc://SwiftAgent/documentation/SwiftAgent/AgentMessage":{"url":"\/documentation\/swi