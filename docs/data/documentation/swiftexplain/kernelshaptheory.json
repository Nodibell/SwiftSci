{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"SHAP (SHapley Additive exPlanations)","type":"text"}],"type":"strong"},{"text":" is a game-theoretic approach to explain the output of any machine learning model. It connects optimal credit allocation with local explanations using the classic Shapley values from cooperative game theory.","type":"text"}]},{"level":2,"text":"1. The Four Shapley Axioms","type":"heading","anchor":"1-The-Four-Shapley-Axioms"},{"type":"paragraph","inlineContent":[{"text":"Shapley values are the only attribution method that uniquely satisfies all four fundamental properties:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Efficiency","type":"text"}],"type":"strong"},{"text":": Feature attributions sum up to the difference between model prediction ","type":"text"},{"type":"codeVoice","code":"f(x)"},{"text":" and expected background prediction ","type":"text"},{"type":"codeVoice","code":"E[f(X)]"},{"text":":","type":"text"}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Σ_i=1..M φ_i = f(x) - E[f(X)]"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Symmetry","type":"text"}]},{"text":": If two features contribute equally to all possible feature subsets, their attributions are equal.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Dummy (Null Player)","type":"text"}]},{"text":": A feature that does not change the model prediction for any coalition receives an attribution of zero (","type":"text"},{"type":"codeVoice","code":"φ_i = 0"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Additivity","type":"text"}]},{"text":": For ensemble models ","type":"text"},{"type":"codeVoice","code":"f = f1 + f2"},{"text":", attributions satisfy ","type":"text"},{"type":"codeVoice","code":"φ_i(f) = φ_i(f1) + φ_i(f2)"},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"level":2,"text":"2. Explaining Predictions in SwiftSci","type":"heading","anchor":"2-Explaining-Predictions-in-SwiftSci"},{"syntax":"swift","code":["import SwiftExplain","import SwiftML","","\/\/ Initialize KernelSHAP with background dataset","let explainer = try KernelSHAP(","    model: { features in","        \/\/ Arbitrary inference closure","        return try await rf.predictProba(features: features).map { $0[1] }","    },","    background: backgroundSamples,","    nSamples: 100",")","","\/\/ Compute Shapley values for an instance","let instance = [35.0, 75000.0, 720.0, 1.0]","let explanation = try await explainer.explain(instance: instance)","","print(\"Base Value: \\(explanation.baseValue)\")","print(\"Feature Attributions: \\(explanation.values)\")"],"type":"codeListing"}]}],"metadata":{"title":"Game-Theoretic Interpretability with Kernel SHAP","roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"SwiftExplain"}]},"abstract":[{"text":"Compute exact and sampled Shapley feature attributions to explain predictions of any machine learning model.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP"],"anchor":"SHAP-Explainer-APIs","title":"SHAP Explainer APIs"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/kernelshaptheory"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAPTheory"},"sections":[],"references":{"doc://SwiftExplain/documentation/SwiftExplain":{"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain","kind":"symbol","abstract":[{"text":"Model Explainability, SHAP & Feature Attributions.","type":"text"}],"type":"topic","title":"SwiftExplain","url":"\/documentation\/swiftexplain","role":"collection"},"doc://SwiftExplain/documentation/SwiftExplain/KernelSHAP":{"url":"\/documentation\/swiftexplain\/kernelshap","title":"KernelSHAP","navigatorTitle":[{"text":"KernelSHAP","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Model interpretation using the KernelSHAP algorithm.","type":"text"}],"identifier":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/KernelSHAP","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KernelSHAP","kind":"identifier"}]}}}