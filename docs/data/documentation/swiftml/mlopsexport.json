{"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"kind":"article","abstract":[{"type":"text","text":"Export trained SwiftSci estimators to native Apple Core ML ("},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":") and cross-platform ONNX ("},{"type":"codeVoice","code":".onnx"},{"type":"text","text":") binary artifacts for production deployment."}],"metadata":{"modules":[{"name":"SwiftML"}],"title":"Exporting Models to Core ML and ONNX","roleHeading":"API Collection","role":"collectionGroup"},"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"SwiftSci provides native, wire-format serialization engines for both Apple Core ML and ONNX without requiring external Python tooling or code generation steps. Models trained natively in Swift can be directly exported to binary artifacts compatible with Apple Neural Engine (ANE), Metal GPU, CPU, and ONNX Runtime."}],"type":"paragraph"},{"level":2,"type":"heading","text":"1. Core ML Binary Export (`.mlmodel`)","anchor":"1-Core-ML-Binary-Export-mlmodel"},{"inlineContent":[{"type":"text","text":"SwiftSci implements binary Protocol Buffer serialization directly conforming to Apple’s "},{"type":"codeVoice","code":"Model.proto"},{"type":"text","text":" specification (v4)."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Supported Estimators","anchor":"Supported-Estimators"},{"rows":[[[{"inlineContent":[{"text":"Estimator","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Core ML Message","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Target Hardware","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"LinearRegression","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"GLMRegressor","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"LogisticRegression","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"GLMClassifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"DecisionTreeClassifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TreeEnsembleClassifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"DecisionTreeRegressor","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TreeEnsembleRegressor","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"RandomForestClassifier","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TreeEnsembleClassifier","type":"codeVoice"},{"text":" (multi-tree)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"RandomForestRegressor","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"TreeEnsembleRegressor","type":"codeVoice"},{"text":" (multi-tree)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table","alignments":["left","left","left"]},{"level":3,"type":"heading","text":"Using the `CoreMLExportable` Protocol","anchor":"Using-the-CoreMLExportable-Protocol"},{"inlineContent":[{"type":"text","text":"All supported model types conform to the "},{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","type":"reference","isActive":true},{"type":"text","text":" protocol, providing asynchronous export methods:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftML","","\/\/ Train a Random Forest Classifier","let rf = try RandomForestClassifier(nEstimators: 50, maxDepth: 8)","try await rf.fit(features: X_train, targets: y_train)","","\/\/ Export directly to a .mlmodel file","let exportURL = URL(fileURLWithPath: \"\/path\/to\/RandomForest.mlmodel\")","try await rf.writeCoreML(","    to: exportURL,","    featureNames: [\"age\", \"income\", \"credit_score\"],","    outputName: \"approved\"",")"]},{"level":3,"type":"heading","text":"Direct Serialization via `CoreMLExporter`","anchor":"Direct-Serialization-via-CoreMLExporter"},{"inlineContent":[{"type":"text","text":"You can also use static methods on "},{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","type":"reference","isActive":true},{"type":"text","text":" to produce binary "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" payloads:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Export fitted linear regression","let modelData = CoreMLExporter.exportBinaryLinearModel(","    name: \"HousePricePredictor\",","    inputNames: [\"sqft\", \"bedrooms\", \"bathrooms\"],","    outputName: \"price\",","    weights: [250.0, 15000.0, 10000.0],","    bias: 50000.0",")","","try modelData.write(to: URL(fileURLWithPath: \"HousePricePredictor.mlmodel\"))"]},{"level":3,"type":"heading","text":"Loading in Client Applications","anchor":"Loading-in-Client-Applications"},{"inlineContent":[{"type":"text","text":"Exported "},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":" files can be compiled and loaded dynamically using Apple’s "},{"type":"codeVoice","code":"CoreML"},{"type":"text","text":" framework:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import CoreML","","let compiledURL = try MLModel.compileModel(at: exportURL)","let mlModel = try MLModel(contentsOf: compiledURL)","","let inputDict: [String: Any] = [\"age\": 35.0, \"income\": 75000.0, \"credit_score\": 720.0]","let featureProvider = try MLDictionaryFeatureProvider(dictionary: inputDict)","let output = try mlModel.prediction(from: featureProvider)"]},{"level":2,"type":"heading","text":"2. ONNX Binary Export (`.onnx`)","anchor":"2-ONNX-Binary-Export-onnx"},{"inlineContent":[{"type":"text","text":"SwiftSci provides native binary ONNX wire-format export via "},{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiftML","","let onnxData = ONNXExporter.exportBinaryONNX(","    name: \"LinearONNX\",","    inputs: [\"features\"],","    output: \"prediction\",","    weights: [1.5, -2.0, 0.75],","    bias: 0.5",")","","try onnxData.write(to: URL(fileURLWithPath: \"model.onnx\"))"]}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors"]}],"topicSections":[{"anchor":"Core-ML-Exporter-API","title":"Core ML Exporter API","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/mlopsexport"]}],"references":{"doc://SwiftML/documentation/SwiftML/ONNXExporter":{"navigatorTitle":[{"kind":"identifier","text":"ONNXExporter"}],"abstract":[{"type":"text","text":"Exporter for serializing SwiftML models into ONNX model graph specification JSON format."},{"type":"text","text":" "},{"type":"text","text":"Note: Produces a JSON representation of the ONNX graph, not a binary .onnx file."}],"type":"topic","identifier":"doc:\/\/SwiftML\/d