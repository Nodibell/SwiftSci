{"metadata":{"title":"Feature Scaling, Normalization & Flat 1D Memory","modules":[{"name":"SwiftPreprocessing"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using "},{"type":"codeVoice","code":"StandardScaler"},{"type":"text","text":", "},{"type":"codeVoice","code":"MinMaxScaler"},{"type":"text","text":", "},{"type":"codeVoice","code":"RobustScaler"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Normalizer"},{"type":"text","text":" powered by Apple Accelerate "},{"type":"codeVoice","code":"vDSP"},{"type":"text","text":"."}],"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Feature scaling is crucial for gradient-based estimators (Neural Networks, Logistic Regression) and distance-based estimators (KNN, DBSCAN, SVM). Without scaling, features with large numeric scales disproportionately dominate distance calculations and gradient updates.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"⚡ Flat 1D Memory Layout & Hardware Vectorization","anchor":"%E2%9A%A1-Flat-1D-Memory-Layout--Hardware-Vectorization"},{"type":"paragraph","inlineContent":[{"code":"SwiftPreprocessing","type":"codeVoice"},{"text":" operates on contiguous 1D row-major flat buffers ","type":"text"},{"code":"[Double]","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"[Float]","type":"codeVoice"},{"text":") with stride indexing ","type":"text"},{"code":"index = row * cols + col","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"All arithmetic operations (","type":"text"},{"code":"vDSP_vsubD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP_vsdivD","type":"codeVoice"},{"text":", ","type":"text"},{"code":"vDSP.sort","type":"codeVoice"},{"text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections.","type":"text"}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"1. `StandardScaler` (Z-Score Standardization)","anchor":"1-StandardScaler-Z-Score-Standardization"},{"type":"paragraph","inlineContent":[{"text":"Transforms features to have zero mean (","type":"text"},{"code":"μ = 0","type":"codeVoice"},{"text":") and unit variance (","type":"text"},{"code":"σ² = 1","type":"codeVoice"},{"text":"):","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"code":"z = (x - μ) \/ σ","type":"codeVoice"}],"type":"paragraph"}],"name":"Note"},{"type":"codeListing","code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"2. `MinMaxScaler` (Bounded Range Scaling)","anchor":"2-MinMaxScaler-Bounded-Range-Scaling"},{"type":"paragraph","inlineContent":[{"text":"Linearly transforms features into a bounded range ","type":"text"},{"code":"[a, b]","type":"codeVoice"},{"text":" (defaults to ","type":"text"},{"code":"[0, 1]","type":"codeVoice"},{"text":"):","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)","type":"codeVoice"}],"type":"paragraph"}],"name":"Note"},{"type":"codeListing","code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"3. `RobustScaler` (Median & IQR Scaling)","anchor":"3-RobustScaler-Median--IQR-Scaling"},{"type":"paragraph","inlineContent":[{"text":"When datasets contain extreme outliers, mean and standard deviation are distorted. ","type":"text"},{"code":"RobustScaler","type":"codeVoice"},{"text":" scales features using the ","type":"text"},{"inlineContent":[{"type":"text","text":"Median"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"Interquartile Range (IQR = Q3 - Q1)"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"code":"x' = (x - Median) \/ IQR","type":"codeVoice"}],"type":"paragraph"}],"name":"Note"},{"type":"codeListing","code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)","anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling"},{"type":"paragraph","inlineContent":[{"text":"Scales each sample independently to have unit L1, L2, or Max norm:","type":"text"}]},{"type":"codeListing","code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"],"syntax":"swift"},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Memory & Performance Tip:"}]},{"type":"text","text":" "},{"type":"text","text":"Use "},{"code":"Float","type":"codeVoice"},{"type":"text","text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput."}],"type":"paragraph"}],"name":"Note"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/featurescaling"]}],"kind":"article","identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","interfaceLanguage":"swift"},"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"title":"SwiftPreprocessing","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","url":"\/documentation\/swiftpreprocessing","abstract":[{"text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines.","type":"text"}],"kind":"symbol","role":"collection","type":"topic"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"abstract":[{"text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer.","type":"text"}],"kind":"article","url":"\/documentation\/swiftpreprocessing\/encodersandimputers","type":"topic","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","role":"article","title":"Categorical Encoding & Imputation"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseDataStructures":{"url":"\/documentation\/swiftpreprocessing\/sparsedatastructures","type":"topic","kind":"article","role":"collectionGroup","title":"Memory-Efficient Sparse Matrix Representations","abstract":[{"type":"text","text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats."}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"}}}