{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"High-dimensional data transformations—including one-hot categorical encodings, n-gram bags of words, TF-IDF vectors, and interaction graphs—typically yield matrices where 95% to 99.9% of entries are zeros."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Storing such datasets as dense arrays requires gigabytes of memory and burns CPU cycles iterating over zeros. "},{"code":"SparseMatrix","type":"codeVoice"},{"type":"text","text":" implements Compressed Sparse Row (CSR) and Compressed Sparse Column (CSC) compression formats, reducing memory consumption by 10x–50x."}],"type":"paragraph"},{"level":2,"anchor":"Storage-Formats","text":"Storage Formats","type":"heading"},{"level":3,"anchor":"Compressed-Sparse-Row-CSR","text":"Compressed Sparse Row (CSR)","type":"heading"},{"inlineContent":[{"type":"text","text":"Stores non-zero values row-by-row:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"values","type":"codeVoice"},{"text":": Non-zero numerical entries.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"colIndices","type":"codeVoice"},{"text":": Column indices corresponding to each entry in ","type":"text"},{"code":"values","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"rowPointers","type":"codeVoice"},{"text":": Offsets into ","type":"text"},{"code":"values","type":"codeVoice"},{"text":" marking where each row begins (length: ","type":"text"},{"code":"rowCount + 1","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"code":["Dense 3x3:","[ 10.0,  0.0,  0.0 ]","[  0.0, 20.0, 30.0 ]","[  0.0,  0.0, 40.0 ]","","CSR Representation:","values:      [10.0, 20.0, 30.0, 40.0]","colIndices:  [0, 1, 2, 2]","rowPointers: [0, 1, 3, 4]"],"syntax":null,"type":"codeListing"},{"level":3,"anchor":"Compressed-Sparse-Column-CSC","text":"Compressed Sparse Column (CSC)","type":"heading"},{"inlineContent":[{"type":"text","text":"Stores non-zero values column-by-column, optimal for column slicing and sparse-sparse matrix multiplication."}],"type":"paragraph"},{"level":2,"anchor":"Apple-Accelerate-Sparse-BLAS","text":"Apple Accelerate Sparse BLAS","type":"heading"},{"inlineContent":[{"type":"text","text":"When multiplying large sparse matrices by dense vectors ($y = A \\cdot x$), "},{"code":"SparseMatrix","type":"codeVoice"},{"type":"text","text":" delegates to Apple’s native Accelerate Sparse BLAS C routines:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"sparse_matrix_create_double","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"sparse_insert_row_double","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_commit"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"sparse_matrix_vector_product_dense_double"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"These routines utilize SIMD hardware instructions on Apple Silicon CPUs, delivering maximum throughput.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Example Usage","anchor":"Example-Usage","type":"heading"},{"syntax":"swift","code":["import SwiftPreprocessing","","\/\/ 1. Create a sparse matrix from a dense array","let dense: [[Double]] = [","    [1.0, 0.0, 0.0],","    [0.0, 2.0, 0.0],","    [0.0, 0.0, 3.0]","]","let sparse = SparseMatrix(dense: dense, format: .csr)","print(\"Sparsity: \\(sparse.sparsity)\") \/\/ ~ 0.667","","\/\/ 2. Accelerated matrix-vector product","let x = [1.0, 2.0, 3.0]","let y = try sparse.multiply(vector: x)","print(y) \/\/ [1.0, 4.0, 9.0]","","\/\/ 3. Matrix Transpose & CSC conversion","let csc = sparse.toCSC()","let transposed = sparse.transpose()"],"type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/swiftpreprocessing\/sparsedatastructures"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"metadata":{"title":"Memory-Efficient Sparse Matrix Representations","modules":[{"name":"SwiftPreprocessing"}],"roleHeading":"API Collection","role":"collectionGroup"},"sections":[],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseMatrix","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseFormat"],"title":"Sparse Data Types","anchor":"Sparse-Data-Types"}],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers"],"generated":true,"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/FeatureScaling":{"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling","abstract":[{"text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using ","type":"text"},{"code":"StandardScaler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MinMaxScaler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RobustScaler","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Normalizer","type":"codeVoice"},{"text":" powered by Apple Accelerate ","type":"text"},{"code":"vDSP","type":"codeVoice"},{"text":".","type":"text"}],"type":"t