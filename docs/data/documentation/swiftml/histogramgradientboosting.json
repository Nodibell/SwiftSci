{"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Traditional gradient boosted decision trees (GBDT) sort continuous feature values across all samples at every internal tree node to find optimal split thresholds. When datasets grow to millions of rows, sorting becomes the primary performance bottleneck."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"HistGradientBoostingClassifier"},{"type":"text","text":" and "},{"type":"codeVoice","code":"HistGradientBoostingRegressor"},{"type":"text","text":" implement histogram-based split optimization (inspired by LightGBM and scikit-learn’s "},{"type":"codeVoice","code":"HistGradientBoostingClassifier"},{"type":"text","text":"). Continuous feature columns are discretized into at most 256 integer bins ("},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":")."}]},{"type":"heading","text":"Algorithmic Architecture","level":2,"anchor":"Algorithmic-Architecture"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Pre-Binning (Quantization)"}]},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"Feature quantiles are evaluated once before boosting begins, establishing up to 256 discrete bins per feature column. All feature values are mapped to compact "},{"type":"codeVoice","code":"UInt8"},{"type":"text","text":" memory arrays."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"One-Pass Histogram Accumulation"}]},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"For any internal tree node, first-order negative gradients (g_i) and second-order Hessians (h_i) are accumulated into a flat 256-bin histogram in a single linear pass over the node’s samples:"},{"type":"text","text":" "},{"type":"text","text":"$$G[k] = \\sum_{i: b_i = k} g_i, \\quad H[k] = \\sum_{i: b_i = k} h_i$$"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Constant-Time Split Finding"}]},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"Evaluating all split candidates requires iterating over (K \\le 256) bins, regardless of how many millions of samples reside in the node:"},{"type":"text","text":" "},{"type":"text","text":"$$\\text{Gain} = \\frac{1}{2} \\left[ \\frac{G_L^2}{H_L + \\lambda} + \\frac{G_R^2}{H_R + \\lambda} - \\frac{G_{\\text{tot}}^2}{H_{\\text{tot}} + \\lambda} \\right]$$"}]}]}]},{"type":"codeListing","code":["Continuous Floats [0.14, 0.92, -0.45] ──► Quantization ──► UInt8 Bins [32, 215, 12]","                                                                  │","                                                                  ▼","Node Split Search: O(256) Bin Scan ◄─── Accumulated Histograms G[k], H[k]"],"syntax":null},{"type":"heading","text":"Example Usage","level":2,"anchor":"Example-Usage"},{"type":"codeListing","code":["import SwiftML","","let clf = try HistGradientBoostingClassifier(","    nEstimators: 50,","    learningRate: 0.1,","    maxDepth: 6,","    maxBins: 256,","    minSamplesLeaf: 10",")","","try await clf.fit(features: X_train, targets: y_train)","let predictions = try await clf.predict(features: X_test)","let probabilities = try await clf.predictProbability(features: X_test)"],"syntax":"swift"}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"abstract":[{"type":"text","text":"Discretize continuous feature distributions into 256 compact bins to accelerate decision tree split evaluations from (O(N \\log N)) to (O(K))."}],"variants":[{"paths":["\/documentation\/swiftml\/histogramgradientboosting"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Fast Tabular Learning with Histogram Gradient Boosting","role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"SwiftML"}]},"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport"],"title":"Guides & Tutorials","anchor":"Guides--Tutorials"}],"topicSections":[{"identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode"],"title":"Estimators","anchor":"Estimators"}],"references":{"doc://SwiftML/documentation/SwiftML/ReproducibilityAndPRNG":{"type":"topic","url":"\/documentation\/swiftml\/reproducibilityandprng","abstract":[{"type":"text","text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators."}],"kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","role":"collectionGroup","title":"Reproducibility, Determinism & High-Quality PRNG"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingRegressor":{"role":"symbol","kind":"symbol","url":"\/documentation\/swiftml\/histgradientboostingregressor","abstract":[{"type":"text","text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular regression."}],"fragments":[{"kind":"keyword","text":"actor"},{"text":" ","kind":"text"},{"kind":"identifier","text":"HistGradientBoostingRegressor"}],"navigatorTitle":[{"kind":"identifier","text":"HistGradientBoostingRegressor"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingRegressor","type":"topic","title":"HistGradientBoostingRegressor"},"doc://SwiftML/documentation/SwiftML/EnsembleLearning":{"kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","title":"Ensemble Learning: Random Forests & Gradient Boosted Trees","type":"topic","abstract":[{"type":"text","text":"Train high-accuracy bagging and boosting decision tree ensembles natively in Swift with multicore parallelism."}],"role":"collectionGroup","url":"\/documentation\/swiftml\/ensemblelearning"},"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"type":"topic","kind":"article","url":"\/documentation\/swiftml\/supervisedclassifiers","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","abstract":[{"type":"text","text":"Train classification models using LogisticRegression, DecisionTreeClassifier, RandomForestClassifier, and MLPClassifier."}],"role":"article","title":"Supervised Classification Models"},"doc://SwiftML/documentation/SwiftML/SupervisedRegressors":{"abstract":[{"text":"Perform continuous target predictions using LinearRegression (exact OLS), DecisionTreeRegressor, and GradientBoostedTreesRegressor.","type":"text"}],"kind":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","role":"article","type":"topic","title":"Supervised Regression Models","url":"\/documentation\/swiftml\/supervisedregressors"},"doc://SwiftML/documentation/SwiftML/HistGradientBoostingClassifier":{"url":"\/documentation\/swiftml\/histgradientboostingclassifier","type":"topic","abstract":[{"text":"Fast histogram-binned gradient boosted decision trees for large-scale tabular classification.","type":"text"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"HistGradientBoostingClassifier"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistGradientBoostingClassifier","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistGradientBoostingClassifier"}],"title":"HistGradientBoostingClassifier"},"doc://SwiftML/documentation/SwiftML/MLOpsExport":{"title":"Exporting Models to Core ML and ONNX","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","abstract":[{"type":"text","text":"Export trained SwiftSci estimators to native Apple Core ML ("},{"type":"codeVoice","code":".mlmodel"},{"type":"text","text":") and cross-platform ONNX ("},{"type":"codeVoice","code":".onnx"},{"type":"text","text":") binary artifacts for production deployment."}],"role":"collectionGroup","type":"topic","kind":"article","url":"\/documentation\/swiftml\/mlopsexport"},"doc://SwiftML/documentation/SwiftML/HistTreeNode":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistTreeNode","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swiftml\/histtreenode","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/HistTreeNode","abstract":[{"type":"text","text":"A node in a histogram-binned decision tree."}],"role":"symbol","navigatorTitle":[{"text":"HistTreeNode","kind":"identifier"}],"title":"HistTreeNode"},"doc://SwiftML/documentation/SwiftML/EarlyStoppingCallbacks":{"title":"Early Stopping & Generalization Control","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","abstract":[{"type":"text","text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting."}],"role":"collectionGroup","type":"topic","kind":"article","url":"\/documentation\/swiftml\/earlystoppingcallbacks"},"doc://SwiftML/documentation/SwiftML":{"kind":"symbol","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","type":"topic","title":"SwiftML","role":"collection","url":"\/documentation\/swiftml"}}}