{"topicSections":[{"anchor":"Embedding-APIs","title":"Embedding APIs","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"Dense Local Text Embeddings with Accelerate","modules":[{"name":"SwiftNLP"}],"role":"collectionGroup","roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/denselocalembeddings"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings"},"abstract":[{"text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon.","type":"text"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Modern Retrieval-Augmented Generation (RAG) and semantic search systems require dense vector representations of text. Traditional approaches depend on remote APIs (e.g. OpenAI) or large multi-gigabyte models that exhaust memory. ","type":"text"},{"code":"SwiftNLP","type":"codeVoice"},{"text":" introduces ","type":"text"},{"code":"LocalEmbeddingEngine","type":"codeVoice"},{"text":", a subword N-gram character hashing projection engine that produces deterministic, unit-normalized dense embeddings in sub-millisecond execution times.","type":"text"}]},{"anchor":"1-Algorithmic-Foundation","level":2,"text":"1. Algorithmic Foundation","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"LocalEmbeddingEngine","type":"codeVoice"},{"text":" operates through a three-stage mathematical pipeline:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Subword N-gram Hashing"}],"type":"strong"},{"text":": Text is tokenized into word and character n-grams (sizes 3 to 6). Each n-gram is hashed into a fixed integer space using FNV-1a hash functions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Dimension Projection"}],"type":"strong"},{"text":": Hashes are projected onto a $D$-dimensional vector space (e.g., $D=128$ or $D=256$) with deterministic sign flips to prevent feature collision bias.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Unit $L_2$ Normalization"}],"type":"strong"},{"text":": The resulting dense vector is projected onto the unit hypersphere:","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"$$v_{\\text{norm}} = \\frac{v}{|v|","type":"text"},{"inlineContent":[{"type":"text","text":"2} = \\frac{v}{\\sqrt{\\sum"}],"type":"emphasis"},{"text":"{i=1}^{D} v_i^2}}$$","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because all embeddings have $|v|_2 = 1.0$, the ","type":"text"},{"inlineContent":[{"type":"text","text":"Cosine Similarity"}],"type":"strong"},{"text":" between two embeddings is equivalent to their direct ","type":"text"},{"inlineContent":[{"type":"text","text":"Dot Product"}],"type":"strong"},{"text":", allowing single-instruction vector evaluation via Apple Accelerate ","type":"text"},{"code":"vDSP_dotprD","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"$$\\text{CosineSimilarity}(u, v) = u \\cdot v$$","type":"text"}]},{"anchor":"2-Generating-Embeddings","level":2,"text":"2. Generating Embeddings","type":"heading"},{"code":["import SwiftNLP","","\/\/ Initialize a 128-dimensional local embedding engine","let engine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Generate embedding for a single text snippet","let vector = engine.embed(\"Apple Silicon M3 Max neural network processing\")","print(\"Vector dimension: \\(vector.count)\") \/\/ 128","","\/\/ Batch embedding generation","let documents = [","    \"High-performance computing on macOS\",","    \"Relational database wire protocol drivers\",","    \"Deep convolutional neural networks for vision\"","]","let batchEmbeddings = engine.embedBatch(documents)"],"syntax":"swift","type":"codeListing"},{"anchor":"3-Integration-with-SwiftClusterVectorStore","level":2,"text":"3. Integration with SwiftCluster.VectorStore","type":"heading"},{"code":["import SwiftCluster","","let store = VectorStore(metric: .cosineSimilarity)","","for (idx, doc) in documents.enumerated() {","    let vec = engine.embed(doc)","    store.add(id: \"doc_\\(idx)\", vector: vec, metadata: [\"text\": doc])","}","","\/\/ Perform instant semantic similarity search","let query = engine.embed(\"Mac hardware acceleration\")","let topHits = store.search(query: query, topK: 1)","print(\"Top match: \\(topHits.first?.metadata[\"text\"] ?? \"\")\")"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"sections":[],"kind":"article","references":{"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LocalEmbeddingEngine"}],"title":"LocalEmbeddingEngine","navigatorTitle":[{"kind":"identifier","text":"LocalEmbeddingEngine"}],"type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","abstract":[{"type":"text","text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon."}],"url":"\/documentation\/swiftnlp\/localembeddingengine","kind":"symbol"},"doc://SwiftNLP/documentation/SwiftNLP":{"title":"SwiftNLP","type":"topic","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","abstract":[{"type":"text","text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration."}],"url":"\/documentation\/swiftnlp","role":"collection","kind":"symbol"}}}