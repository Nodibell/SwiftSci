h"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Paged KV-Cache"}]},{"type":"text","text":": Stores precomputed Key and Value projection matrices across generation steps, eliminating "},{"type":"codeVoice","code":"O(N²)"},{"type":"text","text":" recomputation."}]}]}]},{"type":"heading","text":"2. Generating Tokens","level":2,"anchor":"2-Generating-Tokens"},{"syntax":"swift","type":"codeListing","code":["import SwiftLLM","","\/\/ Load model weights and tokenizer","let config = LLMConfiguration(","    vocabSize: 32000,","    hiddenDimension: 4096,","    numLayers: 32,","    numHeads: 32,","    contextLength: 4096",")","","let model = TransformerDecoder(configuration: config)","","\/\/ Stream autoregressive tokens","for try await token in model.generateStream(prompt: \"The future of scientific computing\", maxTokens: 50) {","    print(token, terminator: \"\")","}"]}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"Explore the low-level mechanics of Metal GPU-accelerated transformer decoders and KV-Caching in SwiftLLM."}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference"},"references":{"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoder":{"title":"TransformerDecoder","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransformerDecoder","kind":"identifier"}],"navigatorTitle":[{"text":"TransformerDecoder","kind":"identifier"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"A full N-layer decoder-only Transformer."}],"url":"\/documentation\/swiftllm\/transformerdecoder","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","kind":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM":{"abstract":[{"type":"text","text":"Local Causal Transformer Decoder & Weight Parsers."}],"type":"topic","kind":"symbol","role":"collection","identif