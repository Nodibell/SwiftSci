{"variants":[{"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Apache Arrow & Feather Zero-Copy Integration","modules":[{"name":"SwiftDataFrame"}],"roleHeading":"API Collection","role":"collectionGroup"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"sections":[],"abstract":[{"type":"text","text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization."}],"topicSections":[{"title":"Arrow Classes & Readers","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"],"anchor":"Arrow-Classes--Readers"}],"identifier":{"url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"code":"SwiftDataFrame","type":"codeVoice"},{"type":"text","text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties."}],"type":"paragraph"},{"type":"heading","text":"1. Arrow Memory Layout & Bitmaps","anchor":"1-Arrow-Memory-Layout--Bitmaps","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:"}]},{"type":"codeListing","syntax":null,"code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Validity Bitmaps","type":"text"}],"type":"strong"},{"type":"text","text":": Each bit represents the presence (1) or absence (0) of a value at that index."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"SIMD Null Filtering","type":"text"}],"type":"strong"},{"text":": Vectorized operations skip null evaluations using SIMD bitmasks (","type":"text"},{"type":"codeVoice","code":"vDSP_vcmprsD"},{"text":"), allowing full CPU register utilization.","type":"text"}],"type":"paragraph"}]}]},{"text":"2. Feather File Format (Arrow IPC)","level":2,"type":"heading","anchor":"2-Feather-File-Format-Arrow-IPC"},{"inlineContent":[{"text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:","type":"text"}],"type":"paragraph"},{"code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"syntax":"swift","type":"codeListing"},{"text":"3. Lazy Feather Streaming","level":2,"type":"heading","anchor":"3-Lazy-Feather-Streaming"},{"inlineContent":[{"text":"For large datasets, SwiftDataFrame supports streaming chunked reads:","type":"text"}],"type":"paragraph"},{"code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"kind":"article","references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"role":"symbol","url":"\/documentation\/swiftdataframe\/featherreader","abstract":[{"text":"Reader for Feather \/ Apache Arrow IPC binary file format.","type":"text"}],"title":"FeatherReader","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeatherReader","kind":"identifier"}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","type":"topic","navigatorTitle":[{"text":"FeatherReader","kind":"identifier"}],"kind":"symbol"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"navigatorTitle":[{"kind":"identifier","text":"TypedColumn"}],"type":"topic","abstract":[{"type":"text","text":"A strongly-typed column backed by a contiguous Swift array."},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" elements represent null \/ missing values."}],"url":"\/documentation\/swiftdataframe\/typedcolumn","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypedColumn","kind":"identifier"}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn","title":"TypedColumn","role":"symbol","kind":"symbol"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"url":"\/documentation\/swiftdataframe\/featherwriter","role":"symbol","title":"FeatherWriter","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeatherWriter","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","navigatorTitle":[{"text":"FeatherWriter","kind":"identifier"}],"abstract":[{"text":"Writer for Feather \/ Apache Arrow IPC binary file format.","type":"text"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"type":"topic","url":"\/documentation\/swiftdataframe","title":"SwiftDataFrame","role":"collection","kind":"symbol","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}],"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"}}}