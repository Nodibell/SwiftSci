{"sections":[],"metadata":{"roleHeading":"API Collection","modules":[{"name":"SwiftAgent"}],"title":"Building On-Device RAG Pipelines","role":"collectionGroup"},"abstract":[{"text":"Construct privacy-preserving Retrieval-Augmented Generation workflows on Apple Silicon.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator"],"anchor":"Agent-Components","title":"Agent Components"}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"On-Device RAG combines fast local vector retrieval with on-device language models to provide accurate, grounded answers from private local documents without cloud network dependencies.","type":"text"}]},{"type":"codeListing","syntax":"mermaid","code":["graph LR","    Query[User Query] --> Embed[LocalEmbeddingEngine]","    Embed --> Vec[Dense Vector]","    Vec --> Search[VectorStore Top-K]","    Docs[Private Document Index] --> Search","    Search --> Chunks[Retrieved Text Snippets]","    Chunks --> Prompt[Augmented Prompt]","    Prompt --> LLM[SwiftLLM Metal Engine]","    LLM --> Answer[Grounded Answer]"]},{"type":"heading","text":"1. Complete End-to-End Pipeline Example","level":2,"anchor":"1-Complete-End-to-End-Pipeline-Example"},{"code":["import SwiftAgent","import SwiftCluster","import SwiftNLP","import SwiftLLM","","\/\/ 1. Initialize local embedding engine and vector store","let embedEngine = LocalEmbeddingEngine(dimension: 128)","let vectorStore = VectorStore(metric: .cosineSimilarity)","","\/\/ 2. Ingest private knowledge base","let corpus = [","    \"SwiftSci uses Apple Accelerate vDSP for SIMD arithmetic.\",","    \"MLX provides unified memory GPU tensor computation on Mac.\",","    \"WiredMemoryManager prevents out-of-memory errors on shared RAM.\"","]","","for (id, text) in corpus.enumerated() {","    let vec = embedEngine.embed(text)","    vectorStore.add(id: \"doc_\\(id)\", vector: vec, metadata: [\"content\": text])","}","","\/\/ 3. Retrieve relevant context for user question","let userQuestion = \"How does SwiftSci accelerate vector math?\"","let queryVector = embedEngine.embed(userQuestion)","let topMatches = vectorStore.search(query: queryVector, topK: 1)","","let contextSnippet = topMatches.first?.metadata[\"content\"] ?? \"\"","","\/\/ 4. Assemble augmented prompt and query local LLM","let augmentedPrompt = \"\"\"","Context: \\(contextSnippet)","Question: \\(userQuestion)","Answer:","\"\"\""],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftAgent\/documentation\/SwiftAgent"]]},"variants":[{"paths":["\/documentation\/swiftagent\/ragandcontextaugmentation"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/RAGAndContextAugmentation"},"references":{"doc://SwiftAgent/documentation/SwiftAgent/SwiftAgentEvaluator":{"abstract":[{"type":"text","text":"Agentic Swift Execution Sandbox Evaluator."}],"url":"\/documentation\/swiftagent\/swiftagentevaluator","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"text":"SwiftAgentEvaluator","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"SwiftAgentEvaluator"}],"title":"SwiftAgentEvaluator","type":"topic","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent\/SwiftAgentEvaluator","kind":"symbol"},"doc://SwiftAgent/documentation/SwiftAgent":{"abstract":[{"type":"text","text":"Agentic REPL Execution Sandbox & RAG Summary Engine."}],"role":"collection","title":"SwiftAgent","type":"topic","url":"\/documentation\/swiftagent","identifier":"doc:\/\/SwiftAgent\/documentation\/SwiftAgent","kind":"symbol"}}}