{"kind":"symbol","metadata":{"role":"collection","title":"SwiftWorkflow","symbolKind":"module","externalID":"SwiftWorkflow","modules":[{"name":"SwiftWorkflow"}],"roleHeading":"Framework"},"topicSections":[{"title":"Workflows","identifiers":["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/PCAClassificationWorkflow"],"anchor":"Workflows"},{"title":"Articles","identifiers":["doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow\/WorkflowPersistence"],"anchor":"Articles"}],"abstract":[{"text":"Production Machine Learning Pipelines, Preprocessing Composition, and Artifact Serialization.","type":"text"}],"identifier":{"url":"doc:\/\/SwiftWorkflow\/documentation\/SwiftWorkflow","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiftWorkflow"},{"type":"text","text":" provides immutable, production-grade pipelines that compose missing-value imputation, feature scaling, dimensionality reduction, and classification into single deployable units."}],"type":"paragraph"},{"text":"Key Capabilities","anchor":"Key-Capabilities","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fitted End-to-End Pipeline"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"PCAClassificationWorkflow"},{"type":"text","text":" integrating mean imputation, standard scaling, SVD-based PCA projection, and binary logistic regression."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Strict Row Provenance"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"Predictions"},{"type":"text","text":" preserving "},{"type":"codeVoice","code":"sourceRowIndices"},{"type":"text","text":" directly from the input "},{"type":"codeVoice","code":"PreparedSupervisedBatch"},{"type":"text","text":" or "},{"type":"codeVoice","code":"PreparedNumericBatch"},{"type":"text","text":" across non-contiguous batch selections."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Training-Only Fitting"}]},{"type":"text","text":": Fitted state is computed solely on the designated training batch, preventing data leakage from test or validation sets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Atomic JSON Serialization"}]},{"type":"text","text":": Lightweight, versioned JSON serialization ("},{"type":"codeVoice","code":"save(to:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"load(from:)"},{"type":"text","text":") enabling cross-process persistence and cold-start inference without retaining raw datasets."}]}]}],"type":"unorderedList"},{"text":"Example Usage","anchor":"Example-Usage","level":3,"type":"heading"},{"syntax":"swift","code":["import Foundation","import SwiftDataFrame","import SwiftWorkflow","","\/\/ 1. Prepare supervised numeric batch","let batch = try rawDF.prepareNumericBatch([\"signal\", \"companion\", \"noise\", \"target\"])","let supervised = try PreparedSupervisedBatch(batch, targetColumn: \"target\")","","\/\/ 2. Train workflow strictly on training partition","let trainingBatch = try supervised.selectingRows([0, 1, 2, 4, 5])","let workflow = try await PCAClassificationWorkflow.train(","    training: trainingBatch,","    components: 2,","    learningRate: 0.125,","    epochs: 64",")","","\/\/ 3. Atomically persist to disk","let fileURL = URL(fileURLWithPath: \"model.json\")","try workflow.save(to: fileURL)","","\/\/ 4. Reload and predict with zero test leakage","let loadedWorkflow = try PCAClassificationWorkflow.load(from: fileURL)","let predictions = try await loadedWorkflow.predict(heldOutBatch.features)"],"type":"codeListing"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[[]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"