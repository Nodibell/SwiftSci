{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"collectionGroup","roleHeading":"API Collection","title":"Permutation Feature Importance & Model Diagnostics","modules":[{"name":"SwiftExplain"}]},"abstract":[{"type":"text","text":"Measure true feature importance by evaluating loss degradation after shuffling feature columns."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftexplain\/permutationfeatureimportance"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftExplain\/documentation\/SwiftExplain"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftExplain\/documentation\/SwiftExplain\/PermutationFeatureImportance"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Permutation Feature Importance"}],"type":"strong"},{"text":" measures how much a trained model’s error increases when a single feature column is randomly shuffled, breaking the relationship between that feature and the target outcome.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Importance Metric:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Importance(f_j) = Loss(X_shuffled(j), y) - Loss(X, y)"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"type":"heading","level":2,"text":"1. Computing Permutation Importance","anchor":"1-Computing-Permutation-Importance"},{"type":"codeListing","syntax":"swift","code":["import SwiftExplain","import SwiftML","","let importance = try await PermutationImportance.compute(","    model: trainedModel,","    features: X_val,","    targets: y_val,","    metric: .meanSquaredError,","    nRepeats: 10",")","","for (idx, score) in importance.enumerated() {","    print(\"Feature \\(idx): Mean drop = \\(score.mean), Std = \\(score.std)\")","}"]}]}],"sections":[],"to