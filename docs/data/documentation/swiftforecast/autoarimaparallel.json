{"variants":[{"paths":["\/documentation\/swiftforecast\/autoarimaparallel"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"topicSections":[{"title":"Automated Time Series","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMACriterion"],"anchor":"Automated-Time-Series"}],"metadata":{"role":"collectionGroup","title":"Concurrent Order Selection with AutoARIMA","modules":[{"name":"SwiftForecast"}],"roleHeading":"API Collection"},"abstract":[{"text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency.","type":"text"}],"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Manually diagnosing autocorrelation functions (ACF) and partial autocorrelation functions (PACF) to select ARIMA orders is time-consuming and error-prone. Standard automated packages like R’s ","type":"text"},{"code":"forecast::auto.arima","type":"codeVoice"},{"text":" or Python’s ","type":"text"},{"code":"pmdarima","type":"codeVoice"},{"text":" search across candidate orders sequentially.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"AutoARIMA","type":"codeVoice"},{"text":" evaluates the entire hyperparameter lattice simultaneously across all CPU cores on Apple Silicon using structured Swift Concurrency (","type":"text"},{"code":"withThrowingTaskGroup","type":"codeVoice"},{"text":").","type":"text"}]},{"level":2,"type":"heading","text":"Grid Search Architecture","anchor":"Grid-Search-Architecture"},{"code":["           Observed Time Series [y_1, y_2, ..., y_N]","                               │","       ┌───────────────────────┼───────────────────────┐","       ▼                       ▼                       ▼","ARIMA(1, 1, 0)          ARIMA(2, 1, 1)          ARIMA(0, 1, 2)","Task 1                  Task 2                  Task 3","   │                       │                       │","   ├─ Hannan-Rissanen      ├─ Hannan-Rissanen      ├─ Hannan-Rissanen","   └─ Compute AIC\/BIC      └─ Compute AIC\/BIC      └─ Compute AIC\/BIC","       │                       │                       │","       └───────────────────────┼───────────────────────┘","                               ▼","                withThrowingTaskGroup Collector","                               │","                               ▼","                 Sorted Leaderboard & Best Model"],"type":"codeListing","syntax":null},{"level":3,"type":"heading","text":"Information Criteria","anchor":"Information-Criteria"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"AIC (Akaike Information Criterion)","type":"text"}]},{"type":"text","text":": Penalizes model complexity while rewarding likelihood:"},{"type":"text","text":" "},{"type":"text","text":"$$\\text{AIC} = 2k - 2\\ln(L)$$"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"BIC (Bayesian Information Criterion)","type":"text"}]},{"text":": Imposes a stronger penalty proportional to sample size:","type":"text"},{"type":"text","text":" "},{"type":"text","text":"$$\\text{BIC} = k\\ln(N) - 2\\ln(L)$$"}]}]}]},{"level":2,"type":"heading","text":"Example Usage","anchor":"Example-Usage"},{"code":["import SwiftForecast","","\/\/ 1. Initialize AutoARIMA with bounded search ranges","let autoArima = AutoARIMA(","    maxP: 3,","    maxD: 2,","    maxQ: 3,","    criterion: .aic",")","","\/\/ 2. Concurrently fit candidates across all cores","let result = try await autoArima.fit(series: historicalPrices)","print(\"Optimal Order: \\(autoArima.bestOrder!) with AIC: \\(autoArima.bestScore!)\")","","\/\/ 3. Generate multi-step forecasts","let forecast = try await autoArima.forecast(horizon: 12)","print(\"Forecasted points: \\(forecast.forecast.predictions)\")"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"seeAlsoSections":[{"generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"],"anchor":"Guides--Tutorials"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KoopmanOperator","kind":"identifier"}],"title":"KoopmanOperator","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator","url":"\/documentation\/swiftforecast\/koopmanoperator","navigatorTitle":[{"text":"KoopmanOperator","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Koopman Operator time-series forecasting and dynamical system modeling actor.","type":"text"},{"text":" ","type":"text"},{"text":"Uses Extended Dynamic Mode Decomposition (EDMD) to approximate non-linear dynamics","type":"text"},{"text":" ","type":"text"},{"text":"via linear operators in lifted observable feature spaces.","type":"text"}],"type":"topic"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMACriterion":{"type":"topic","role":"symbol","title":"AutoARIMACriterion","navigatorTitle":[{"kind":"identifier","text":"AutoARIMACriterion"}],"kind":"symbol","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMACriterion","abstract":[{"text":"Information criterion utilized for model selection in ","type":"text"},{"code":"AutoARIMA","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoARIMACriterion"}],"url":"\/documentation\/swiftforecast\/autoarimacriterion"},"doc://SwiftForecast/documentation/SwiftForecast":{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast","kind":"symbol","title":"SwiftForecast","url":"\/documentation\/swiftforecast","type":"topic","abstract":[{"text":"Time Series & Volatility Forecasting Models.","type":"text"}],"role":"collection"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMA":{"role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoARIMA","kind":"identifier"}],"title":"AutoARIMA","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMA","url":"\/documentation\/swiftforecast\/autoarima","navigatorTitle":[{"text":"AutoARIMA","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Automated hyperparameter grid search for ARIMA and SARIMA time-series models."}],"type":"topic"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAOrder":{"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAOrder","navigatorTitle":[{"kind":"identifier","text":"AutoARIMAOrder"}],"type":"topic","title":"AutoARIMAOrder","abstract":[{"type":"text","text":"A structure identifying the selected ARIMA \/ SARIMA order."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AutoARIMAOrder"}],"kind":"symbol","url":"\/documentation\/swiftforecast\/autoarimaorder"},"doc://SwiftForecast/documentation/SwiftForecast/ArimaAndSarima":{"url":"\/documentation\/swiftforecast\/arimaandsarima","role":"article","title":"ARIMA & SARIMA Time Series Models","kind":"article","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","abstract":[{"text":"Forecast univariate time series u