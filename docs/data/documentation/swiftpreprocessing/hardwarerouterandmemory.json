{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Apple Silicon features a ","type":"text"},{"type":"strong","inlineContent":[{"text":"Unified Memory Architecture (UMA)","type":"text"}]},{"text":" where the CPU, GPU, and Apple Neural Engine (ANE) share a single high-bandwidth memory pool. ","type":"text"},{"type":"codeVoice","code":"SwiftPreprocessing"},{"text":" provides intelligent hardware routing and memory reservation primitives to prevent GPU saturation and avoid data copying.","type":"text"}]},{"anchor":"1-The-Hardware-Router","level":2,"type":"heading","text":"1. The Hardware Router"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"HardwareRouter","type":"codeVoice"},{"type":"text","text":" assesses tensor dimensions and operation complexity to select the optimal computing engine:"}]},{"type":"codeListing","code":["graph TD","    Op[Compute Operation] --> Router{HardwareRouter}","    Router -->|Small \/ Vector < 50k| CPU[Accelerate \/ AMX \/ NEON]","    Router -->|Large Matrix \/ Autodiff| GPU[MLX Metal GPU]","    Router -->|Static Inference| ANE[Core ML Engine]"],"syntax":"mermaid"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Small Vectors (","type":"text"},{"code":"N < 50,000","type":"codeVoice"},{"type":"text","text":")"}]},{"type":"text","text":": Routed to CPU Accelerate (vDSP\/BLAS\/LAPACK) to eliminate GPU kernel dispatch latency."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Large Tensors & Deep Learning","type":"text"}],"type":"strong"},{"type":"text","text":": Routed to MLX Metal GPU for massive parallel throughput."}]}]}],"type":"unorderedList"},{"anchor":"2-WiredMemoryManager--Ticket-System","type":"heading","text":"2. WiredMemoryManager & Ticket System","level":2},{"type":"paragraph","inlineContent":[{"text":"To prevent out-of-memory (OOM) conditions during concurrent analytical workloads, ","type":"text"},{"type":"codeVoice","code":"WiredMemoryManager"},{"text":" implements an asynchronous FIFO reservation system:","type":"text"}]},{"code":["import SwiftPreprocessing","","\/\/ Acquire a GPU execution slot","let ticket = try await WiredMemoryManager.shared.reserveMemory(estimatedBytes: 64 * 1024 * 1024)","","\/\/ Execute heavy MLX operations","\/\/ ...","","\/\/ Automatically flushes GPU caches upon completion","await ticket.release()"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"type":"text","text":"Understand how SwiftSci automatically routes workloads between CPU (Accelerate\/AMX\/NEON) and Metal GPU (MLX) with strict concurrency safety."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"SwiftPreprocessing"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Hardware Routing & Unified Memory Governance"},"kind":"article","sections":[],"variants":[{"paths":["\/documentation\/swiftpreprocessing\/hardwarerouterandmemory"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Memory--Routing-APIs","identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket"],"title":"Memory & Routing APIs"}],"identifier":{"url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouterAndMemory","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryManager":{"type":"topic","title":"WiredMemoryManager","role":"symbol","url":"\/documentation\/swiftpreprocessing\/wiredmemorymanager","navigatorTitle":[{"kind":"identifier","text":"WiredMemoryManager"}],"abstract":[{"type":"text","text":"Actor-based manager that controls concurrent allocations and tasks in Apple Silicon Unified Memory."}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryManager","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"WiredMemoryManager"}],"kind":"symbol"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/WiredMemoryTicket":{"type":"topic","title":"WiredMemoryTicket","role":"symbol","url":"\/documentation\/swiftpreprocessing\/wiredmemoryticket","navigatorTitle":[{"kind":"identifier","text":"WiredMemoryTicket"}],"abstract":[{"type":"text","text":"A ticket representing a reservation of memory and a concurrency slot."}],"identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/WiredMemoryTicket","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"WiredMemoryTicket"}],"kind":"symbol"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"title":"SwiftPreprocessing","type":"topic","role":"collection","abstract":[{"type":"text","text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines."}],"kind":"symbol","url":"\/documentation\/swiftpreprocessing","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/HardwareRouter":{"title":"HardwareRouter","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HardwareRouter","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"HardwareRouter","kind":"identifier"}],"abstract":[{"text":"Serializes device selection and MLX default-device changes (global MLX state).","type":"text"}],"url":"\/documentation\/swiftpreprocessing\/hardwarerouter","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/HardwareRouter","kind":"symbol"}}}