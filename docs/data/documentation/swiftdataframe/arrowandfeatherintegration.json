{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"type":"text","text":"Learn how SwiftDataFrame leverages Apache Arrow memory buffers and Feather IPC format for ultra-fast, zero-copy tabular serialization."}],"kind":"article","topicSections":[{"title":"Arrow Classes & Readers","identifiers":["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn"],"anchor":"Arrow-Classes--Readers"}],"hierarchy":{"paths":[["doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/ArrowAndFeatherIntegration"},"metadata":{"roleHeading":"API Collection","title":"Apache Arrow & Feather Zero-Copy Integration","role":"collectionGroup","modules":[{"name":"SwiftDataFrame"}]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiftDataFrame","type":"codeVoice"},{"type":"text","text":" integrates directly with Apache Arrow, the industry standard for in-memory columnar data. By utilizing Arrow’s contiguous memory buffers and bitmapped null representations, SwiftSci achieves seamless interoperability with Python, Rust, and C++ analytical ecosystems without data serialization penalties."}]},{"type":"heading","level":2,"anchor":"1-Arrow-Memory-Layout--Bitmaps","text":"1. Arrow Memory Layout & Bitmaps"},{"type":"paragraph","inlineContent":[{"text":"In traditional row-oriented memory layouts, checking for null values requires conditional branching or sentinel values, causing CPU cache misses. Arrow organizes data into contiguous columnar arrays with an accompanying validity bitmap:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["┌───────────────────────────────────────────────────────────────┐","│                     TYPED COLUMN (ARROW BUFFER)               │","├───────────────────────────────────────────────────────────────┤","│ Values Buffer : [ 42.0,  18.5,  99.9,  0.0,   12.4,  55.1 ]   │","│ Validity Mask : [  1  ,   1  ,   1  ,   0 ,    1  ,   1   ]   │","│                                        └── NULL               │","└───────────────────────────────────────────────────────────────┘"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Validity Bitmaps"}]},{"type":"text","text":": Each bit represents the presence (1) or absence (0) of a value at that index."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"SIMD Null Filtering"}],"type":"strong"},{"text":": Vectorized operations skip null evaluations using SIMD bitmasks (","type":"text"},{"code":"vDSP_vcmprsD","type":"codeVoice"},{"text":"), allowing full CPU register utilization.","type":"text"}]}]}]},{"anchor":"2-Feather-File-Format-Arrow-IPC","level":2,"text":"2. Feather File Format (Arrow IPC)","type":"heading"},{"inlineContent":[{"text":"Feather is a lightweight, portable binary columnar format built on top of Arrow IPC:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftDataFrame","","\/\/ Write DataFrame directly to Arrow Feather format","let df = try DataFrame(columns: [","    TypedColumn<Double>(name: \"signal\", values: [1.2, 3.4, 5.6]),","    TypedColumn<String>(name: \"label\", values: [\"A\", \"B\", \"C\"])","])","","let featherURL = URL(fileURLWithPath: \"\/tmp\/data.feather\")","try FeatherWriter.write(dataFrame: df, to: featherURL)","","\/\/ Read Feather file back with zero memory overhead","let loadedDF = try FeatherReader.read(from: featherURL)","print(\"Loaded \\(loadedDF.rowCount) rows and \\(loadedDF.columnCount) columns.\")"],"type":"codeListing"},{"anchor":"3-Lazy-Feather-Streaming","level":2,"text":"3. Lazy Feather Streaming","type":"heading"},{"inlineContent":[{"type":"text","text":"For large datasets, SwiftDataFrame supports streaming chunked reads:"}],"type":"paragraph"},{"syntax":"swift","code":["let lazyDF = try LazyDataFrame.fromFeather(url: featherURL)","let filtered = try lazyDF","    .filter(column: \"signal\", operation: .greaterThan(2.0))","    .select([\"label\"])","    .collect()"],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftdataframe\/arrowandfeatherintegration"]}],"references":{"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherReader":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatherReader"}],"role":"symbol","url":"\/documentation\/swiftdataframe\/featherreader","abstract":[{"text":"Reader for Feather \/ Apache Arrow IPC binary file format.","type":"text"}],"title":"FeatherReader","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherReader","type":"topic","navigatorTitle":[{"kind":"identifier","text":"FeatherReader"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame":{"url":"\/documentation\/swiftdataframe","abstract":[{"type":"text","text":"High-Performance Columnar Data Tables built on Apache Arrow."}],"kind":"symbol","title":"SwiftDataFrame","type":"topic","role":"collection","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame"},"doc://SwiftDataFrame/documentation/SwiftDataFrame/FeatherWriter":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeatherWriter","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swiftdataframe\/featherwriter","abstract":[{"type":"text","text":"Writer for Feather \/ Apache Arrow IPC binary file format."}],"title":"FeatherWriter","kind":"symbol","identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/FeatherWriter","type":"topic","navigatorTitle":[{"text":"FeatherWriter","kind":"identifier"}]},"doc://SwiftDataFrame/documentation/SwiftDataFrame/TypedColumn":{"identifier":"doc:\/\/SwiftDataFrame\/documentation\/SwiftDataFrame\/TypedColumn","role":"symbol","abstract":[{"type":"text","text":"A strongly-typed column backed by a contiguous Swift array."},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" elements represent null \/ missing values."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TypedColumn","kind":"identifier"}],"type":"topic","title":"TypedColumn","kind":"symbol","url":"\/documentation\/swiftdataframe\/typedcolumn","navigatorTitle":[{"text":"TypedColumn","kind":"identifier"}]}}}