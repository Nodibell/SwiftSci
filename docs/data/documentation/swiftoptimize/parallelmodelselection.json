{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","metadata":{"modules":[{"name":"SwiftOptimize"}],"roleHeading":"API Collection","title":"Concurrent Model Selection & Cross-Validation","role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"topicSections":[{"identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoML","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLStrategy","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationResult"],"anchor":"Optimization--Search","title":"Optimization & Search"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/HyperparameterTuning"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials"}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Cross-validation and multi-class classification workflows are embarrassingly parallel: each fold split and one-vs-rest binary sub-problem operates on independent slices of tabular data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftOptimize"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"SwiftML"},{"text":" leverage structured Swift Concurrency (","type":"text"},{"type":"codeVoice","code":"withThrowingTaskGroup"},{"text":") to dispatch multiple fold and class estimators concurrently.","type":"text"}]},{"type":"heading","anchor":"Structured-Concurrency-Pipeline","level":2,"text":"Structured Concurrency Pipeline"},{"type":"codeListing","code":["           Input Dataset [Features, Targets]","                          │","       ┌──────────────────┴──────────────────┐","       ▼                                     ▼"," Fold 1 Split (Task 1)                 Fold 2 Split (Task 2)","   ├─ Fit Candidate                      ├─ Fit Candidate","   └─ Compute Metric                     └─ Compute Metric","       │                                     │","       └──────────────────┬──────────────────┘","                          ▼","            withThrowingTaskGroup Aggregator","                          ▼","         Cross-Validation Average Leaderboard"],"syntax":null},{"type":"heading","anchor":"Cooperative-Cancellation--Bounded-Budgets","level":3,"text":"Cooperative Cancellation & Bounded Budgets"},{"type":"paragraph","inlineContent":[{"text":"When training under a time budget (such as ","type":"text"},{"type":"codeVoice","code":"AutoML(timeBudgetSeconds:)"},{"text":"), tasks run inside a managed scope. If the time budget expires or a fatal error occurs in a critical pipeline step, child tasks cooperatively respect task cancellation without leaking threads or memory.","type":"text"}]},{"type":"heading","anchor":"Deterministic-Class-Ordering","level":3,"text":"Deterministic Class Ordering"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"OneVsRestClassifier"},{"text":", binary classification estimators are dispatched concurrently to maximize throughput across cores. Results are tagged with their class index ","type":"text"},{"type":"codeVoice","code":"(c, est)"},{"text":" and sorted prior to storage, ensuring 100% deterministic prediction ordering across runs.","type":"text"}]},{"type":"heading","anchor":"Example-Usage","level":2,"text":"Example Usage"},{"type":"codeListing","code":["import SwiftOptimize","import SwiftML","","\/\/ 1. Concurrent AutoML search across DecisionTree, RandomForest, and MLP","let automl = AutoML(timeBudgetSeconds: 30.0)","let report = try await automl.fit(features: X, targets: y)","print(\"Winning Model: \\(report.bestModel)\")","","\/\/ 2. Parallel One-Vs-Rest classification","let ovr = OneVsRestClassifier(numClasses: 5)","try await ovr.fit(features: X, targets: y)","let predictions = try await ovr.predict(features: X_test)"],"syntax":"swift"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection"},"abstract":[{"type":"text","text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency "},{"type":"codeVoice","code":"TaskGroup"},{"type":"text","text":" primitives."}],"variants":[{"paths":["\/documentation\/swiftoptimize\/parallelmodelselection"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SwiftOptimize/documentation/SwiftOptimize":{"title":"SwiftOptimize","kind":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize","abstract":[{"type":"text","text":"AutoML, Cross-Validation Folds & Hyperparameter Tuning."}],"role":"collection","url":"\/documentation\/swiftoptimize","type":"topic"},"doc://SwiftOptimize/documentation/SwiftOptimize/AutoML":{"navigatorTitle":[{"text":"AutoML","kind":"identifier"}],"title":"AutoML","kind":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoML","abstract":[{"type":"text","text":"Automated Machine Learning (AutoML) controller providing intelligent model selection"},{"type":"text","text":" "},{"type":"text","text":"and automated cross-validation benchmarking under time constraints."}],"role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoML","kind":"identifier"}],"url":"\/documentation\/swiftoptimize\/automl","type":"topic"},"doc://SwiftOptimize/documentation/SwiftOptimize/AutoMLStrategy":{"navigatorTitle":[{"text":"AutoMLStrategy","kind":"identifier"}],"title":"AutoMLStrategy","kind":"symbol","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/AutoMLStrategy","abstract":[{"type":"text","text":"AutoML hyperparameter optimization strategy."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AutoMLStrategy","kind":"iden