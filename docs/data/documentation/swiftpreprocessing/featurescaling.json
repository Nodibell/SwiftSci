{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"SwiftPreprocessing"}],"roleHeading":"Article","role":"article","title":"Feature Scaling, Normalization & Flat 1D Memory"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures"],"title":"Guides & Tutorials","generated":true,"anchor":"Guides--Tutorials"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature scaling is crucial for gradient-based estimators (Neural Networks, Logistic Regression) and distance-based estimators (KNN, DBSCAN, SVM). Without scaling, features with large numeric scales disproportionately dominate distance calculations and gradient updates."}]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"⚡ Flat 1D Memory Layout & Hardware Vectorization","anchor":"%E2%9A%A1-Flat-1D-Memory-Layout--Hardware-Vectorization"},{"type":"paragraph","inlineContent":[{"code":"SwiftPreprocessing","type":"codeVoice"},{"type":"text","text":" operates on contiguous 1D row-major flat buffers "},{"code":"[Double]","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"[Float]","type":"codeVoice"},{"type":"text","text":") with stride indexing "},{"code":"index = row * cols + col","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":null,"code":["Matrix (3 rows x 2 columns)","Row 0: [ 1.0, 200.0 ]","Row 1: [ 2.0, 300.0 ]","Row 2: [ 3.0, 400.0 ]","","Contiguous Flat Memory Buffer:","┌───────┬─────────┬───────┬─────────┬───────┬─────────┐","│  1.0  │  200.0  │  2.0  │  300.0  │  3.0  │  400.0  │","└───────┴─────────┴───────┴─────────┴───────┴─────────┘"," offset:0  offset:1  offset:2  offset:3  offset:4  offset:5"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All arithmetic operations ("},{"code":"vDSP_vsubD","type":"codeVoice"},{"type":"text","text":", "},{"code":"vDSP_vsdivD","type":"codeVoice"},{"type":"text","text":", "},{"code":"vDSP.sort","type":"codeVoice"},{"type":"text","text":") execute SIMD instructions directly across contiguous memory without heap pointer indirections."}]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"1. `StandardScaler` (Z-Score Standardization)","anchor":"1-StandardScaler-Z-Score-Standardization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforms features to have zero mean ("},{"code":"μ = 0","type":"codeVoice"},{"type":"text","text":") and unit variance ("},{"code":"σ² = 1","type":"codeVoice"},{"type":"text","text":"):"}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"z = (x - μ) \/ σ"}],"type":"paragraph"}],"style":"note"},{"type":"codeListing","syntax":"swift","code":["import Foundation","import SwiftPreprocessing","","\/\/ 1. Prepare flat dataset: 3 rows x 2 columns","let rows = 3","let cols = 2","let flatData: [Double] = [","    1.0, 200.0,","    2.0, 300.0,","    3.0, 400.0","]","","\/\/ 2. Fit and transform","var scaler = StandardScaler()","try scaler.fit(data: flatData, rows: rows, cols: cols)","","let scaled = try scaler.transform(data: flatData, rows: rows, cols: cols)","","print(\"=== Standard Scaled Values ===\")","for r in 0..<rows {","    let rowVals = (0..<cols).map { c in String(format: \"%+.4f\", scaled[r * cols + c]) }","    print(\"Row \\(r): [\\(rowVals.joined(separator: \", \"))]\")","}","","\/\/ 3. Inverse transform back to original scale","let reconstructed = try scaler.inverseTransform(data: scaled, rows: rows, cols: cols)","print(\"Reconstructed matches original: \\(reconstructed == flatData)\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"2. `MinMaxScaler` (Bounded Range Scaling)","anchor":"2-MinMaxScaler-Bounded-Range-Scaling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Linearly transforms features into a bounded range "},{"code":"[a, b]","type":"codeVoice"},{"type":"text","text":" (defaults to "},{"code":"[0, 1]","type":"codeVoice"},{"type":"text","text":"):"}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"x' = a + ((x - x_min) \/ (x_max - x_min)) · (b - a)"}],"type":"paragraph"}],"style":"note"},{"type":"codeListing","syntax":"swift","code":["import SwiftPreprocessing","","var minMax = MinMaxScaler(featureRange: (0.0, 1.0))","let normalized = try minMax.fitTransform(data: flatData, rows: rows, cols: cols)","","print(\"Min-Max scaled to [0, 1]: \\(normalized)\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"3. `RobustScaler` (Median & IQR Scaling)","anchor":"3-RobustScaler-Median--IQR-Scaling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When datasets contain extreme outliers, mean and standard deviation are distorted. "},{"code":"RobustScaler","type":"codeVoice"},{"type":"text","text":" scales features using the "},{"inlineContent":[{"type":"text","text":"Median"}],"type":"strong"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"Interquartile Range (IQR = Q3 - Q1)"}],"type":"strong"},{"type":"text","text":":"}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Formula:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"x' = (x - Median) \/ IQR"}],"type":"paragraph"}],"style":"note"},{"type":"codeListing","syntax":"swift","code":["import SwiftPreprocessing","","\/\/ Dataset with an extreme outlier in column 1","let outlierData: [Double] = [","    1.0, 10.0,","    2.0, 11.0,","    2.1, 12.0,","    2.2, 11.5,","    3.0, 1000.0 \/\/ extreme outlier","]","","var robust = RobustScaler()","let robustScaled = try robust.fitTransform(data: outlierData, rows: 5, cols: 2)","","print(\"Robust scaled IQR data: \\(robustScaled)\")"]},{"type":"thematicBreak"},{"level":2,"type":"heading","text":"4. `Normalizer` (Row-wise Unit Norm Vector Scaling)","anchor":"4-Normalizer-Row-wise-Unit-Norm-Vector-Scaling"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Scales each sample independently to have unit L1, L2, or Max norm:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftPreprocessing","","var normalizer = Normalizer(norm: .l2)","let l2Normalized = try normalizer.fitTransform(data: flatData, rows: rows, cols: cols)"]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Memory & Performance Tip:","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"Float"},{"type":"text","text":" overloads for deep learning image datasets and embeddings to halve RAM usage and maximize Neural Engine throughput."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftpreprocessing\/featurescaling"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/FeatureScaling"},"abstract":[{"type":"text","text":"Scale, standardize, and normalize feature matrices at memory bandwidth speeds using "},{"type":"codeVoice","code":"StandardScaler"},{"type":"text","text":", "},{"type":"codeVoice","code":"MinMaxScaler"},{"type":"text","text":", "},{"type":"codeVoice","code":"RobustScaler"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Normalizer"},{"type":"text","text":" powered by Apple Accelerate "},{"type":"codeVoice","code":"vDSP"},{"type":"text","text":"."}],"kind":"article","references":{"doc://SwiftPreprocessing/documentation/SwiftPreprocessing":{"kind":"symbol","url":"\/documentation\/swiftpreprocessing","type":"topic","role":"collection","title":"SwiftPreprocessing","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing","abstract":[{"type":"text","text":"Feature Scaling, Categorical Encoders & Preprocessing Pipelines."}]},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/EncodersAndImputers":{"role":"article","abstract":[{"type":"text","text":"Encode categorical features and impute missing data with OneHotEncoder, TargetEncoder, KNNImputer, and ColumnTransformer."}],"url":"\/documentation\/swiftpreprocessing\/encodersandimputers","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/EncodersAndImputers","type":"topic","title":"Categorical Encoding & Imputation","kind":"article"},"doc://SwiftPreprocessing/documentation/SwiftPreprocessing/SparseDataStructures":{"abstract":[{"type":"text","text":"Drastically reduce RAM footprint and accelerate matrix-vector products using Compressed Sparse Row (CSR) and Column (CSC) formats."}],"type":"topic","role":"collectionGroup","title":"Memory-Efficient Sparse Matrix Representations","identifier":"doc:\/\/SwiftPreprocessing\/documentation\/SwiftPreprocessing\/SparseDataStructures","url":"\/documentation\/swiftpreprocessing\/sparsedatastructures","kind":"article"}}}