{"abstract":[{"type":"text","text":"GPU-accelerated real-time object detection inference using YOLOv8 architectures and native binary ONNX weight parsing in SwiftVision."}],"variants":[{"paths":["\/documentation\/swiftvision\/yolov8objectdetection"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftVision\/documentation\/SwiftVision"]]},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftVision"},{"text":" provides a complete GPU-accelerated forward-pass inference engine for YOLOv8 object detection models (","type":"text"},{"type":"codeVoice","code":"YOLOv8n"},{"text":", ","type":"text"},{"code":"YOLOv8s","type":"codeVoice"},{"type":"text","text":", "},{"code":"YOLOv8m","type":"codeVoice"},{"type":"text","text":", "},{"code":"YOLOv8l","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"YOLOv8x"},{"text":") running natively on Apple Silicon UMA via MLX \/ MLXNN.","type":"text"}]},{"text":"1. Preprocessing Images with Letterbox","type":"heading","level":3,"anchor":"1-Preprocessing-Images-with-Letterbox"},{"inlineContent":[{"type":"codeVoice","code":"YOLOPreprocessor"},{"type":"text","text":" resizes input images to the model’s expected "},{"type":"codeVoice","code":"640 × 640"},{"type":"text","text":" resolution while strictly preserving original aspect ratios using symmetric "},{"code":"(114, 114, 114)","type":"codeVoice"},{"type":"text","text":" gray padding:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiftVision","import MLX","","let (inputTensor, letterboxMeta) = try YOLOPreprocessor.preprocess(","    imagePath: \"sample.jpg\",","    targetSize: (640, 640)",")"]},{"text":"2. Loading ONNX Weights","type":"heading","level":3,"anchor":"2-Loading-ONNX-Weights"},{"inlineContent":[{"text":"Parse bi