{"seeAlsoSections":[{"generated":true,"title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection"],"anchor":"Guides--Tutorials"}],"sections":[],"abstract":[{"text":"Automate model exploration and parameter optimization with ","type":"text"},{"type":"codeVoice","code":"GridSearchCV"},{"text":", ","type":"text"},{"code":"RandomizedSearchCV","type":"codeVoice"},{"type":"text","text":", and the intelligent "},{"code":"AutoML","type":"codeVoice"},{"type":"text","text":" model selector."}],"metadata":{"title":"Hyperparameter Tuning & AutoML Engine","modules":[{"name":"SwiftOptimize"}],"role":"article","roleHeading":"Article"},"variants":[{"paths":["\/documentation\/swiftoptimize\/hyperparametertuning"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/HyperparameterTuning","interfaceLanguage":"swift"},"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Finding the optimal combination of hyperparameters is critical for maximizing generalization accuracy. ","type":"text"},{"code":"SwiftOptimize","type":"codeVoice"},{"text":" provides exhaustive grid search, randomized sampling for high-dimensional parameter spaces, and end-to-end ","type":"text"},{"code":"AutoML","type":"codeVoice"},{"text":" selection across multiple model families.","type":"text"}]},{"type":"thematicBreak"},{"anchor":"1-AutoML-Automated-Model--Parameter-Selection","level":2,"type":"heading","text":"1. AutoML — Automated Model & Parameter Selection"},{"inlineContent":[{"type":"codeVoice","code":"AutoML"},{"type":"text","text":" evaluates candidate model architectures (Decision Trees, Random Forests, Logistic Regression, Linear Regression, and Multi-Layer Perceptrons) using cross-validation, ranking candidates by performance metrics (F1-score for classification, R² for regression)."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import SwiftOptimize","import SwiftML","","\/\/ 1. Synthetic classification dataset","let N = 120","let D = 4","let X = (0..<N).map { i in","    (0..<D).map { d in Double(i * D + d) * 0.05 + sin(Double(i + d)) }","}","let y = (0..<N).map { i in i % 2 }","","\/\/ 2. Configure AutoML with 3-fold cross validation","let autoML = AutoML(","    task: .classification,","    timeLimitSeconds: 30,","    cvFolds: 3,","    metric: \"f1\"",")","","\/\/ 3. Train and select the optimal estimator","let result = try await autoML.fit(features: X, targets: y)","","print(\"=== AutoML Optimization Results ===\")","print(\"Selected Best Model: \\(result.bestModelName)\")","print(\"Validation F1 Score: \\(String(format: \"%.4f\", result.bestScore))\")","print(\"Tuned Hyperparameters: \\(result.bestParameters)\")","","\/\/ 4. Run inference directly on new test samples","let newSample = [0.5, 1.2, 0.3, 0.8]","let testPrediction = try await result.bestEstimator.predict(features: [newSample])","print(\"Prediction: \\(testPrediction)\")"]},{"type":"thematicBreak"},{"text":"2. Exhaustive Grid Search (`GridSearchCV`)","anchor":"2-Exhaustive-Grid-Search-GridSearchCV","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GridSearchCV"},{"text":" exhaustively tests all Cartesian combinations of hyperparameter discrete values.","type":"text"}]},{"code":["import SwiftOptimize","import SwiftML","","\/\/ Define hyperparameter search grid for DecisionTreeClassifier","let paramGrid: [String: [Any]] = [","    \"maxDepth\": [3, 5, 8],","    \"minSamplesSplit\": [2, 5, 10],","    \"criterion\": [\"gini\", \"entropy\"]","]","","let gridSearch = GridSearchCV(","    estimator: DecisionTreeClassifier(maxDepth: 3),","    paramGrid: paramGrid,","    cv: 5,","    scoring: .accuracy",")","","try await gridSearch.fit(features: X, targets: y)","","if let bestParams = gridSearch.bestParams {","    print(\"Optimal Depth: \\(bestParams[\"maxDepth\"] ?? \"default\")\")","    print(\"Peak CV Accuracy: \\(String(format: \"%.4f\", gridSearch.bestScore ?? 0.0))\")","}"],"type":"codeListing","syntax":"swift"},{"type":"thematicBreak"},{"text":"3. Randomized Search (`RandomizedSearchCV`)","anchor":"3-Randomized-Search-RandomizedSearchCV","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When searching through large continuous or discrete combinatorial spaces, "},{"type":"codeVoice","code":"RandomizedSearchCV"},{"type":"text","text":" samples $N$ random configurations, finding near-optimal solutions in a fraction of the compute time."}],"type":"paragraph"},{"code":["import SwiftOptimize","import SwiftML","","let distributions: [String: [Any]] = [","    \"learningRate\": [0.001, 0.005, 0.01, 0.05, 0.1],","    \"epochs\": [100, 200, 500, 1000],","    \"l2Penalty\": [0.0, 0.0001, 0.001, 0.01]","]","","let randomSearch = RandomizedSearchCV(","    estimator: LogisticRegression(learningRate: 0.01),","    paramDistributions: distributions,","    nIter: 20,","    cv: 3,","    randomSeed: 42",")","","try await randomSearch.fit(features: X, targets: y)","print(\"Top Configuration Score: \\(randomSearch.bestScore ?? 0.0)\")"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://SwiftOptimize/documentation/SwiftOptimize/CrossValidationFolds":{"identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/CrossValidationFolds","role":"article","url":"\/documentation\/swiftoptimize\/crossvalidationfolds","abstract":[{"text":"Evaluate model stability and generalization performance across dataset splits using ","type":"text"},{"code":"KFold","type":"codeVoice"},{"type":"text","text":", "},{"code":"StratifiedKFold","type":"codeVoice"},{"type":"text","text":", and "},{"code":"TimeSeriesSplit","type":"codeVoice"},{"type":"text","text":"."}],"title":"Cross-Validation Strategies","kind":"article","type":"topic"},"doc://SwiftOptimize/documentation/SwiftOptimize":{"kind":"symbol","abstract":[{"type":"text","text":"AutoML, Cross-Validation Folds & Hyperparameter Tuning."}],"url":"\/documentation\/swiftoptimize","type":"topic","title":"SwiftOptimize","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize","role":"collection"},"doc://SwiftOptimize/documentation/SwiftOptimize/ParallelModelSelection":{"abstract":[{"text":"Harness all available Apple Silicon CPU and GPU cores using structured Swift Concurrency ","type":"text"},{"type":"codeVoice","code":"TaskGroup"},{"text":" primitives.","type":"text"}],"url":"\/documentation\/swiftoptimize\/parallelmodelselection","role":"collectionGroup","identifier":"doc:\/\/SwiftOptimize\/documentation\/SwiftOptimize\/ParallelModelSelection","kind":"article","type":"topic","title":"Concurrent Model Selection & Cross-Validation"}}}