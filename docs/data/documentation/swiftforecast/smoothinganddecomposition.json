{"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel","doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"],"anchor":"Guides--Tutorials","title":"Guides & Tutorials","generated":true}],"variants":[{"paths":["\/documentation\/swiftforecast\/smoothinganddecomposition"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Temporal data analysis requires separating underlying long-term trends, periodic seasonal patterns, and random innovations. "},{"code":"SwiftForecast","type":"codeVoice"},{"type":"text","text":" provides hardware-accelerated time-series models leveraging Apple Accelerate FFT convolution and LAPACK linear solvers."}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"text":"1. Holt-Winters Exponential Smoothing & Nelder-Mead Optimization","anchor":"1-Holt-Winters-Exponential-Smoothing--Nelder-Mead-Optimization","type":"heading"},{"inlineContent":[{"code":"ExponentialSmoothing","type":"codeVoice"},{"type":"text","text":" models level ("},{"code":"α","type":"codeVoice"},{"type":"text","text":"), trend ("},{"code":"β","type":"codeVoice"},{"type":"text","text":"), and seasonal ("},{"code":"γ","type":"codeVoice"},{"type":"text","text":") components with additive or multiplicative adjustments:"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Additive Formulation:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"ŷ_{t+h|t} = ℓ_t + h · b_t + s_{t+h-m(k+1)}"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Parameters "},{"code":"α, β, γ","type":"codeVoice"},{"type":"text","text":" are automatically optimized using the "},{"type":"strong","inlineContent":[{"type":"text","text":"Nelder-Mead simplex optimizer"}]},{"type":"text","text":" minimizing Mean Squared Error (MSE):"}],"type":"paragraph"},{"syntax":"swift","code":["import Foundation","import SwiftForecast","","\/\/ 1. Synthetic monthly seasonal dataset (36 observations, 3 years)","let series = (0..<36).map { t in","    let trend = 10.0 + Double(t) * 0.5","    let seasonal = sin(Double(t % 12) * 2.0 * Double.pi \/ 12.0) * 3.0","    return trend + seasonal + Double.random(in: -0.2...0.2)","}","","\/\/ 2. Configure Triple Exponential Smoothing (Holt-Winters)","let model = ExponentialSmoothing(","    trend: .additive,","    seasonal: .additive,","    seasonalPeriods: 12",")","","\/\/ 3. Fit parameters via continuous Nelder-Mead Simplex search","try model.fit(series: series)","","if let alpha = model.alpha, let beta = model.beta, let gamma = model.gamma {","    print(\"Optimized Parameters: alpha=\\(String(format: \"%.3f\", alpha)), beta=\\(String(format: \"%.3f\", beta)), gamma=\\(String(format: \"%.3f\", gamma))\")","}","","\/\/ 4. Forecast future periods","let forecast = try model.forecast(steps: 12)","print(\"12-Month Out-of-Sample Forecast: \\(forecast)\")"],"type":"codeListing"},{"type":"thematicBreak"},{"level":2,"text":"2. High-Performance 1D Kalman Filter (LAPACK `dgesv`)","anchor":"2-High-Performance-1D-Kalman-Filter-LAPACK-dgesv","type":"heading"},{"inlineContent":[{"code":"KalmanFilter","type":"codeVoice"},{"type":"text","text":" estimates the hidden state vector of a linear dynamic system over time from noisy observations. The implementation uses contiguous 1D flat buffers with Apple Accelerate LAPACK "},{"code":"dgesv","type":"codeVoice"},{"type":"text","text":" matrix inversions:"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"State Prediction:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"x_{k|k-1} = F_k · x_{k-1|k-1} + B_k · u_k"},{"type":"text","text":""},{"type":"text","text":"\n"},{"inlineContent":[{"type":"text","text":"Covariance Prediction:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"P_{k|k-1} = F_k · P_{k-1|k-1} · F_k^T + Q_k"},{"type":"text","text":""},{"type":"text","text":"\n"},{"inlineContent":[{"type":"text","text":"Kalman Gain:"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"K_k = P_{k|k-1} · H_k^T · (H_k · P_{k|k-1} · H_k^T + R_k)^{-1}"}]}],"type":"aside"},{"syntax":"swift","code":["import SwiftForecast","","\/\/ 1. Configure 2D state system: [position, velocity] with 1D observation [position]","let stateDim = 2","let obsDim = 1","","\/\/ State Transition Matrix F: position += dt * velocity","let F: [Double] = [","    1.0, 1.0,  \/\/ row 0: pos = 1.0*pos + 1.0*vel","    0.0, 1.0   \/\/ row 1: vel = 0.0*pos + 1.0*vel","]","","\/\/ Observation Matrix H: we measure position","let H: [Double] = [1.0, 0.0]","","\/\/ Process Noise Q and Measurement Noise R","let Q: [Double] = [","    0.01, 0.0,","    0.0,  0.01","]","let R: [Double] = [0.1]","","\/\/ Initial State and Covariance","let x0: [Double] = [0.0, 1.0]","let P0: [Double] = [","    1.0, 0.0,","    0.0, 1.0","]","","var kf = try KalmanFilter(","    stateDim: stateDim,","    obsDim: obsDim,","    transitionMatrix: F,","    observationMatrix: H,","    processNoise: Q,","    measurementNoise: R,","    initialState: x0,","    initialCovariance: P0",")","","\/\/ 2. Track real-time noisy trajectory","let noisyMeasurements: [[Double]] = [[0.95], [2.05], [2.98], [4.12], [5.01]]","","print(\"=== Kalman Filtering Updates ===\")","for (step, z) in noisyMeasurements.enumerated() {","    try kf.predict()","    try kf.update(observation: z)","    ","    let state = kf.state","    print(\"Step \\(step + 1): Position=\\(String(format: \"%.3f\", state[0])), Velocity=\\(String(format: \"%.3f\", state[1]))\")","}"],"type":"codeListing"},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"3. Classical Seasonal Decomposition (STL)","anchor":"3-Classical-Seasonal-Decomposition-STL"},{"type":"paragraph","inlineContent":[{"text":"Separate series into Trend, Seasonal, and Residual components:","type":"text"}]},{"type":"codeListing","code":["let decomp = TimeSeriesDecomposition.decompose(series: series, period: 12, type: .additive)","","print(\"Extracted Trend Component count: \\(decomp.trend.compactMap { $0 }.count)\")","print(\"Seasonal Component Cycle: \\(decomp.seasonal.prefix(12))\")"],"syntax":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/SwiftForecast\/documentation\/SwiftForecast"]]},"metadata":{"title":"Time Series Forecasting, Smoothing & Kalman Filtering","role":"article","roleHeading":"Article","modules":[{"name":"SwiftForecast"}]},"abstract":[{"type":"text","text":"Model trends, seasonality, volatility, and dynamic state transitions using "},{"type":"codeVoice","code":"ExponentialSmoothing"},{"type":"text","text":", "},{"code":"NelderMead","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"KalmanFilter"},{"type":"text","text":", "},{"code":"GARCHModel","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"TimeSeriesDecomposition","type":"codeVoice"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/SmoothingAndDecomposition"},"sections":[],"references":{"doc://SwiftForecast/documentation/SwiftForecast/KoopmanOperator":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"KoopmanOperator"}],"url":"\/documentation\/swiftforecast\/koopmanoperator","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KoopmanOperator"}],"title":"KoopmanOperator","abstract":[{"text":"Koopman Operator time-series forecasting and dynamical system modeling actor.","type":"text"},{"text":" ","type":"text"},{"text":"Uses Extended Dynamic Mode Decomposition (EDMD) to approximate non-linear dynamics","type":"text"},{"text":" ","type":"text"},{"text":"via linear operators in lifted observable feature spaces.","type":"text"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/KoopmanOperator"},"doc://SwiftForecast/documentation/SwiftForecast":{"type":"topic","abstract":[{"text":"Time Series & Volatility Forecasting Models.","type":"text"}],"role":"collection","url":"\/documentation\/swiftforecast","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast","kind":"symbol","title":"SwiftForecast"},"doc://SwiftForecast/documentation/SwiftForecast/AutoARIMAParallel":{"kind":"article","type":"topic","url":"\/documentation\/swiftforecast\/autoarimaparallel","role":"collectionGroup","title":"Concurrent Order Selection with AutoARIMA","abstract":[{"text":"Discover optimal autoregressive, integrated, and moving average orders across ((p, d, q) \\times (P, D, Q)_s) grids using parallel Swift Concurrency.","type":"text"}],"identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/AutoARIMAParallel"},"doc://SwiftForecast/documentation/SwiftForecast/ArimaAndSarima":{"title":"ARIMA & SARIMA Time Series Models","identifier":"doc:\/\/SwiftForecast\/documentation\/SwiftForecast\/ArimaAndSarima","type":"topic","abstract":[{"type":"text","text":"Forecast univariate time series using Autoregressive Integrated Moving Average (ARIMA) and Seasonal ARIMA (SARIMA)."}],"kind":"article","url":"\/documentation\/swiftforecast\/arimaandsarima","role":"article"}}}