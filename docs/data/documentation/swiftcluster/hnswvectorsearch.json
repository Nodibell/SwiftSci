{"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult"],"anchor":"Spatial-Indexing","title":"Spatial Indexing"}],"seeAlsoSections":[{"title":"Guides & Tutorials","generated":true,"identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"],"anchor":"Guides--Tutorials"}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When vector collections expand beyond tens of thousands of items, exact (O(N)) linear scans become a major latency bottleneck for real-time recommendation and retrieval-augmented generation (RAG) systems."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"HNSWIndex"},{"type":"text","text":" actor provides a hierarchical graph-based spatial partitioning index with sub-millisecond query latency and logarithmic (O(\\log N)) search scaling."}],"type":"paragraph"},{"anchor":"Hierarchical-Navigable-Small-World-Architecture","type":"heading","level":2,"text":"Hierarchical Navigable Small World Architecture"},{"inlineContent":[{"text":"HNSW constructs a hierarchy of graph layers:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Top Layers (Sparse)","type":"text"}]},{"text":": Contain widely spaced long-range highway edges for rapid coarse geometric routing across distant clusters.","ty