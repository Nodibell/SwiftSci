{"variants":[{"paths":["\/documentation\/swiftml\/earlystoppingcallbacks"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"topicSections":[{"anchor":"Training-Callbacks","title":"Training Callbacks","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStopping","doc:\/\/SwiftML\/documentation\/SwiftML\/MetricDirection"]}],"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStoppingCallbacks","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Iterative estimators like multi-layer perceptrons (","type":"text"},{"type":"codeVoice","code":"MLPClassifier"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MLPRegressor"},{"text":") and gradient boosted decision trees (","type":"text"},{"type":"codeVoice","code":"GradientBoostedTreesRegressor"},{"text":") improve their training loss over successive iterations. However, after sufficient capacity has been fit, additional epochs frequently lead to overfitting on training noise and deteriorating generalization on unseen data.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EarlyStopping"},{"text":" provides a decoupled, value-type training callback that monitors validation loss or performance metrics across successive epochs, halting training and optionally restoring optimal model weights.","type":"text"}]},{"anchor":"Mechanics--State-Machine","text":"Mechanics & State Machine","type":"heading","level":2},{"syntax":null,"code":["Epoch Evaluation (Score S_t)","            │","            ▼"," Is (Best - S_t) > minDelta?","   ├── YES ──► Reset wait = 0, update bestScore = S_t, checkpoint weights","   └── NO  ──► Increment wait = wait + 1","                 │","            Is wait >= patience?","              ├── YES ──► shouldStop = true, restore best checkpoint weights","              └── NO  ──► Continue training"],"type":"codeListing"},{"anchor":"Configuration-Parameters","text":"Configuration Parameters","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"code":"patience","type":"codeVoice"},{"type":"text","text":": Number of consecutive non-improving evaluations tolerated before triggering an early halt."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"minDelta","type":"codeVoice"},{"type":"text","text":": Minimum absolute improvement required to qualify as progress."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"direction","type":"codeVoice"},{"type":"text","text":": "},{"code":".minimize","type":"codeVoice"},{"type":"text","text":" for loss functions (cross-entropy, MSE) or "},{"code":".maximize","type":"codeVoice"},{"type":"text","text":" for scoring metrics (accuracy, R2, AUC)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"restoreBestWeights","type":"codeVoice"},{"type":"text","text":": When "},{"code":"true","type":"codeVoice"},{"type":"text","text":", automatically restores the model parameters from the epoch that achieved "},{"code":"bestScore","type":"codeVoice"},{"type":"text","text":", avoiding overfit tail iterations."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Example-Usage","text":"Example Usage","type":"heading","level":2},{"syntax":"swift","code":["import SwiftML","","\/\/ 1. Configure early stopping callback","let es = EarlyStopping(","    patience: 5,","    minDelta: 1e-4,","    direction: .minimize,","    restoreBestWeights: true",")","","\/\/ 2. Fit MLP with validation monitoring","let mlp = MLPClassifier(hiddenLayerSizes: [32, 16], maxIter: 200)","try await mlp.fit(","    features: X_train,","    targets: y_train,","    validationFeatures: X_val,","    validationTargets: y_val,","    earlyStopping: es",")"],"type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Halt iterative training dynamically when validation performance ceases to improve to prevent overfitting.","type":"text"}],"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","title":"Guides & Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors","doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLInference","doc:\/\/SwiftML\/documentation\/SwiftML\/BoundedInference","doc:\/\/SwiftML\/documentation\/SwiftML\/EnsembleLearning","doc:\/\/SwiftML\/documentation\/SwiftML\/HistogramGradientBoosting","doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport"]}],"metadata":{"title":"Early Stopping & Generalization Control","modules":[{"name":"SwiftML"}],"roleHeading":"API Collection","role":"collectionGroup"},"sections":[],"references":{"doc://SwiftML/documentation/SwiftML/PreparedRegression":{"title":"Prepared regression","url":"\/documentation\/swiftml\/preparedregression","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/PreparedRegression","role":"article","type":"topic","kind":"article","abstract":[{"text":"Fit and predict from compact numeric columns without constructing nested row arrays in the StandardScaler and LinearRegression path.","type":"text"}]},"doc://SwiftML/documentation/SwiftML/MLOpsExport":{"title":"Exporting Models to Core ML and ONNX","url":"\/documentation\/swiftml\/mlopsexport","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","role":"collectionGroup","type":"topic","kind":"article","abstract":[{"text":"Export trained SwiftSci estimators to native Apple Core ML (","type":"text"},{"code":".mlmodel","type":"codeVoice"},{"text":") and cross-platform ONNX (","type":"text"},{"code":".onnx","type":"codeVoice"},{"text":") binary artifacts for production deployment.","type":"text"}]},"doc://SwiftML/d