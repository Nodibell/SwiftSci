{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftllm\/transformerdecoderinference"]}],"topicSections":[{"title":"Core Inference Components","anchor":"Core-Inference-Components","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/PagedKVCache","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMConfig","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/RoPEEmbedding"]},{"title":"Sampling & Decoding","anchor":"Sampling--Decoding","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies"]}],"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftLLM"}],"roleHeading":"API Collection","title":"Autoregressive Transformer Decoder Inference"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Execute two-stage autoregressive generation with full prompt prefill and incremental single-token decoding using Apple Silicon KV-caching."}],"sections":[],"identifier":{"url":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiftLLM\/documentation\/SwiftLLM"]]},"seeAlsoSections":[{"title":"Guides & Tutorials","anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization"],"generated":true}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiftLLM"},{"type":"text","text":" implements modern decoder-only causal transformer architectures (such as Llama 3, Mistral, and Gemma) leveraging MLX unified memory acceleration on Apple Silicon GPUs. Inference is divided into two distinct computational phases:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Prompt Prefill Phase ("},{"code":"isPrefill: true","type":"codeVoice"},{"type":"text","text":")"}]},{"text":": Processes all initial prompt tokens in parallel, computing attention matrices and populating the key-value cache across all transformer layers.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Incremental Decoding Phase ("},{"code":"isPrefill: false","type":"codeVoice"},{"type":"text","text":")"}]},{"text":": Processes a single token per step, computing query projections and attending over the accumulated key-value history ($O(N)$ attention over cached history, avoiding repeated full-sequence forward passes).","type":"text"}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"type":"heading","text":"1. Two-Stage Generation Loop","level":2,"anchor":"1-Two-Stage-Generation-Loop"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following complete example demonstrates configuring a model, prefilling the KV-cache, and executing an autoregressive generation loop:"}]},{"type":"codeListing","code":["import Foundation","import SwiftLLM","import MLX","","\/\/ 1. Initialize configuration and decoder","let config = LLMConfig.llama3_8B","let decoder = TransformerDecoder(config: config)","let cache = KVCache(config: config)","","\/\/ Tokenized prompt sequence","let promptTokens: [Int] = [128000, 791, 7453, 374]","var generatedTokens = promptTokens","let maxNewTokens = 64","","\/\/ 2. Stage 1: Prefill prompt tokens into KV-cache","let promptLogits = try decoder.forward(","    tokens: promptTokens,","    cache: cache,","    isPrefill: true",")","","\/\/ 3. Configure sampling parameters","let sampling = SamplingConfiguration(","    temperature: 0.7,","    topK: 40,","    topP: 0.9,","    repetitionPenalty: 1.1",")","","\/\/ 4. Sample first generated token from prefill logits","var currentToken = Sampler.sample(","    logits: promptLogits,","    config: sampling,","    pastTokens: generatedTokens",")","generatedTokens.append(currentToken)","","\/\/ 5. Stage 2: Incremental single-token decoding loop","for _ in 1..<maxNewTokens {","    \/\/ Forward single token with isPrefill: false","    let stepLogits = try decoder.forward(","        tokens: [currentToken],","        cache: cache,","        isPrefill: false","    )","    ","    \/\/ Sample next token ID","    let nextToken = Sampler.sample(","        logits: stepLogits,","        config: sampling,","        pastTokens: generatedTokens","    )","    ","    generatedTokens.append(nextToken)","    currentToken = nextToken","    ","    \/\/ Check for EOS (End of Sequence) tokens","    if nextToken == 128001 || nextToken == 128009 {","        break","    }","}","","print(\"Generated total sequence: \\(generatedTokens.count) tokens.\")"],"syntax":"swift"},{"type":"thematicBreak"},{"type":"heading","text":"2. Rotary Position Embeddings (RoPE) During Incremental Decoding","level":2,"anchor":"2-Rotary-Position-Embeddings-RoPE-During-Incremental-Decoding"},{"type":"paragraph","inlineContent":[{"type":"text","text":"During single-token decoding ("},{"type":"codeVoice","code":"isPrefill: false"},{"type":"text","text":"), position frequencies must match the actual sequential position in the generated sequence rather than index "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RoPEEmbedding"},{"type":"text","text":" tracks this via the "},{"type":"codeVoice","code":"positionOffset"},{"type":"text","text":" parameter:"}]},{"type":"codeListing","code":["\/\/ Internal RoPE position calculation:","\/\/ position = positionOffset + tokenIndex","let rotatedQ = rope.apply(x: query, positionOffset: cache.currentLength)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"KVCache"},{"type":"text","text":" dynamically tracks "},{"type":"codeVoice","code":"currentLength"},{"type":"text","text":", positions increment faithfully from the end of the prefill boundary through every subsequent token generation step."}]},{"type":"thematicBreak"},{"type":"heading","text":"3. High-Level Streaming API","level":2,"anchor":"3-High-Level-Streaming-API"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For streaming applications, "},{"type":"codeVoice","code":"LLMModel"},{"type":"text","text":" wraps the decoder and cache lifecycle into an asynchronous sequence:"}]},{"type":"codeListing","code":["import SwiftLLM","","let options = LLMOptions(","    maxTokens: 128,","    sampling: SamplingConfiguration(temperature: 0.7, topK: 40, topP: 0.9)",")","","for try await token in model.generateStream(prompt: \"Explain rotary embeddings:\", options: options) {","    print(token, terminator: \"\")","}"],"syntax":"swift"},{"type":"thematicBreak"}],"kind":"content"}],"references":{"doc://SwiftLLM/documentation/SwiftLLM/RoPEEmbedding":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RoPEEmbedding"}],"navigatorTitle":[{"kind":"identifier","text":"RoPEEmbedding"}],"url":"\/documentation\/swiftllm\/ropeembedding","kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/RoPEEmbedding","title":"RoPEEmbedding","abstract":[{"type":"text","text":"Rotary Positional Embedding (RoPE) applying frequency-based rotations to query and key tensors."}]},"doc://SwiftLLM/documentation/SwiftLLM/WeightParsingAndSampling":{"role":"collectionGroup","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/WeightParsingAndSampling","type":"topic","url":"\/documentation\/swiftllm\/weightparsingandsampling","title":"GGUF\/SafeTensors Parsing & Sampling","abstract":[{"type":"text","text":"Parse GGUF and SafeTensors model weights zero-copy into Apple Silicon unified memory and sample tokens with fine-grained logits controls."}],"kind":"article"},"doc://SwiftLLM/documentation/SwiftLLM/Sampler":{"role":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/Sampler","navigatorTitle":[{"kind":"identifier","text":"Sampler"}],"type":"topic","title":"Sampler","url":"\/documentation\/swiftllm\/sampler","kind":"symbol","abstract":[{"text":"Generates next token predictions from logits using probabilistic sampling.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Sampler"}]},"doc://SwiftLLM/documentation/SwiftLLM/KVCache":{"navigatorTitle":[{"kind":"identifier","text":"KVCache"}],"title":"KVCache","type":"topic","abstract":[{"type":"text","text":"Key-Value cache storing previous Attention Keys and Values per layer for O(N) generation."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"KVCache"}],"kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/KVCache","url":"\/documentation\/swiftllm\/kvcache","role":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoderArchitecture":{"kind":"article","url":"\/documentation\/swiftllm\/transformerdecoderarchitecture","type":"topic","abstract":[{"type":"text","text":"High-throughput, on-device causal language model execution on Apple Silicon Unified Memory Architecture using "},{"code":"TransformerDecoder","type":"codeVoice"},{"type":"text","text":", "},{"code":"PagedKVCache","type":"codeVoice"},{"type":"text","text":", "},{"code":"GGUFParser","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SafeTensorsParser","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderArchitecture","role":"article","title":"Transformer Architecture & LLM Inference Guide"},"doc://SwiftLLM/documentation/SwiftLLM/SamplingAndDecodingStrategies":{"title":"Token Sampling & Decoding Strategies","type":"topic","abstract":[{"type":"text","text":"Control autoregressive language generation with Temperature, Top-P Nucleus, Top-K, and Repetition Penalty."}],"kind":"article","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingAndDecodingStrategies","url":"\/documentation\/swiftllm\/samplinganddecodingstrategies","role":"collectionGroup"},"doc://SwiftLLM/documentation/SwiftLLM":{"kind":"symbol","url":"\/documentation\/swiftllm","type":"topic","role":"collection","title":"SwiftLLM","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM","abstract":[{"type":"text","text":"Local Causal Transformer Decoder & Weight Parsers."}]},"doc://SwiftLLM/documentation/SwiftLLM/MetalShadersQuantization":{"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/MetalShadersQuantization","title":"Native Metal MSL Shaders for Quantized LLMs","url":"\/documentation\/swiftllm\/metalshadersquantization","role":"collectionGroup","kind":"article","type":"topic","abstract":[{"text":"Hardware dequantization and SIMD-group matrix multiplication for 4-bit and 8-bit quantized weights on Apple Silicon GPU.","type":"text"}]},"doc://SwiftLLM/documentation/SwiftLLM/LLMOptions":{"navigatorTitle":[{"text":"LLMOptions","kind":"identifier"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LLMOptions","kind":"identifier"}],"url":"\/documentation\/swiftllm\/llmoptions","abstract":[{"text":"Options configuring generative text inference.","type":"text"}],"role":"symbol","title":"LLMOptions","type":"topic","kind":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/PagedKVCache":{"navigatorTitle":[{"kind":"identifier","text":"PagedKVCache"}],"title":"PagedKVCache","type":"topic","abstract":[{"type":"text","text":"A dynamic paged Key-Value attention cache allocator for high-throughput batch and stream inference."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PagedKVCache"}],"kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/PagedKVCache","url":"\/documentation\/swiftllm\/pagedkvcache","role":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/SamplingConfiguration":{"navigatorTitle":[{"kind":"identifier","text":"SamplingConfiguration"}],"title":"SamplingConfiguration","type":"topic","abstract":[{"type":"text","text":"Fine-grained configuration of the generative token sampling pipeline."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SamplingConfiguration"}],"kind":"symbol","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/SamplingConfiguration","url":"\/documentation\/swiftllm\/samplingconfiguration","role":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/LLMConfig":{"role":"symbol","title":"LLMConfig","kind":"symbol","url":"\/documentation\/swiftllm\/llmconfig","abstract":[{"type":"text","text":"Architectural hyperparameter configuration for a decoder-only Transformer language model."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LLMConfig","kind":"identifier"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMConfig","navigatorTitle":[{"text":"LLMConfig","kind":"identifier"}],"type":"topic"},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoder":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"TransformerDecoder"}],"url":"\/documentation\/swiftllm\/transformerdecoder","type":"topic","abstract":[{"type":"text","text":"A full N-layer decoder-only Transformer."}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoder","role":"symbol","title":"TransformerDecoder","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransformerDecoder","kind":"identifier"}]}}}