dtensor","title":"QuantizedTensor","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"QuantizedTensor"}],"navigatorTitle":[{"text":"QuantizedTensor","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A semantic representation of a parsed tensor preserving raw quantized layout without eager dequantization."}]},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoderInference":{"type":"topic","role":"collectionGroup","url":"\/documentation\/swiftllm\/transformerdecoderinference","kind":"article","identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/TransformerDecoderInference","title":"Autoregressive Transformer Decoder Inference","abstract":[{"type":"text","text":"Execute two-stage autoregressive generation with full prompt prefill and incremental single-token decoding using Apple Silicon KV-caching."}]},"doc://SwiftLLM/documentation/SwiftLLM/LLMOptions":{"navigatorTitle":[{"text":"LLMOptions","kind":"identifier"}],"identifier":"doc:\/\/SwiftLLM\/documentation\/SwiftLLM\/LLMOptions","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LLMOptions","kind":"identifier"}],"url":"\/documentation\/swiftllm\/llmoptions","abstract":[{"text":"Options configuring generative text inference.","type":"text"}],"role":"symbol","title":"LLMOptions","type":"topic","kind":"symbol"},"doc://SwiftLLM/documentation/SwiftLLM/TransformerDecoderArchitecture":{"kind":"article","url":"\/documentation\/swiftllm\/transformerdecoderarchitecture","type":"topic","abstract":[{"type":"text","text":"High-throughput, on-device causal language model execution on Apple Silicon Unified Memory Architecture using "},{"code":"TransformerDecoder","type":"codeVoice"},{"type":"text","text":", "},{"code":"PagedKVCache","type":"codeVoice"},{"type":"text","text":", "},{"code":"GGUFParser","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SafeTensorsParser","type":"