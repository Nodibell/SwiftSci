{"hierarchy":{"paths":[["doc:\/\/SwiftCluster\/documentation\/SwiftCluster"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When vector collections expand beyond tens of thousands of items, exact (O(N)) linear scans become a major latency bottleneck for real-time recommendation and retrieval-augmented generation (RAG) systems.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"HNSWIndex"},{"text":" actor provides a hierarchical graph-based spatial partitioning index with sub-millisecond query latency and logarithmic (O(\\log N)) search scaling.","type":"text"}]},{"level":2,"type":"heading","text":"Hierarchical Navigable Small World Architecture","anchor":"Hierarchical-Navigable-Small-World-Architecture"},{"type":"paragraph","inlineContent":[{"text":"HNSW constructs a hierarchy of graph layers:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Top Layers (Sparse)"}]},{"type":"text","text":": Contain widely spaced long-range highway edges for rapid coarse geometric routing across distant clusters."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Intermediate Layers"}]},{"type":"text","text":": Progressively decrease edge length while increasing vertex density."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Bottom Layer (Layer 0, Dense)"}],"type":"strong"},{"text":": Contains all indexed vertices connected by dense short-range edges for high-accuracy localized nearest-neighbor refinement.","type":"text"}]}]}]},{"type":"codeListing","syntax":null,"code":["Layer 2 (Express):   [A] ───────────────────────────► [F]","                      │                                │","                      ▼                                ▼","Layer 1 (Regional):  [A] ──────────► [C] ────────────► [F]","                      │               │                │","                      ▼               ▼                ▼","Layer 0 (Base):      [A] ──► [B] ──► [C] ──► [D] ──► [E] ──► [F]"]},{"level":2,"type":"heading","text":"Key Configuration Parameters","anchor":"Key-Configuration-Parameters"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Parameter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Recommended Default"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Impact on Search Quality & Index Build Time"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"M"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"16"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum outgoing connections per node. Higher values improve recall at the cost of higher memory and index construction time."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"efConstruction"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"200"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Size of dynamic candidate evaluation queue during insertion. Larger values produce higher-quality graph connectivity."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"efSearch"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"50"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dynamic queue size during search traversal. Higher values increase search recall towards 100% exact match."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"metric"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".euclideanDistance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choice of "},{"type":"codeVoice","code":".euclideanDistance"},{"type":"text","text":", "},{"type":"codeVoice","code":".cosineSimilarity"},{"type":"text","text":", or "},{"type":"codeVoice","code":".dotProduct"},{"type":"text","text":"."}]}]]],"alignments":["left","left","left"],"header":"row"},{"level":2,"type":"heading","text":"Example Usage","anchor":"Example-Usage"},{"type":"codeListing","syntax":"swift","code":["import SwiftCluster","","\/\/ 1. Initialize the actor-isolated index","let hnsw = HNSWIndex(metric: .cosineSimilarity, M: 16, efConstruction: 200, efSearch: 50)","","\/\/ 2. Add embeddings asynchronously","await hnsw.add(id: \"doc_news_1\", vector: [0.12, 0.94, -0.31], metadata: [\"category\": \"news\"])","await hnsw.add(id: \"doc_tech_2\", vector: [-0.85, 0.11, 0.52], metadata: [\"category\": \"technology\"])","","\/\/ 3. Query Top-K nearest neighbors","let queryEmbedding = [0.10, 0.90, -0.30]","let matches = await hnsw.search(query: queryEmbedding, topK: 5)","","for match in matches {","    print(\"Matched: \\(match.id) with score: \\(match.score)\")","}"]},{"level":2,"type":"heading","text":"Thread Safety & Swift 6 Strict Concurrency","anchor":"Thread-Safety--Swift-6-Strict-Concurrency"},{"inlineContent":[{"type":"codeVoice","code":"HNSWIndex"},{"type":"text","text":" is implemented as an isolated Swift "},{"type":"codeVoice","code":"actor"},{"type":"text","text":", guaranteeing thread safety and eliminating race conditions when multiple background tasks insert items or execute queries concurrently."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"article","metadata":{"title":"High-Dimensional Vector Search with HNSW","modules":[{"name":"SwiftCluster"}],"roleHeading":"API Collection","role":"collectionGroup"},"identifier":{"url":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWVectorSearch","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiftcluster\/hnswvectorsearch"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Scale approximate nearest neighbor (ANN) retrieval logarithmically using Hierarchical Navigable Small World graphs.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"anchor":"Spatial-Indexing","title":"Spatial Indexing","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/HNSWIndex","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorSearchResult"]}],"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStoreAndRAG"],"title":"Guides & Tutorials"}],"references":{"doc://SwiftCluster/documentation/SwiftCluster":{"title":"SwiftCluster","abstract":[{"text":"PCA Dimensionality Reduction & Unsupervised Clustering.","type":"text"}],"kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/swiftcluster","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster"},"doc://SwiftCluster/documentation/SwiftCluster/VectorMetric":{"type":"topic","title":"VectorMetric","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"VectorMetric","kind":"identifier"}],"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorMetric","navigatorTitle":[{"text":"VectorMetric","kind":"identifier"}],"abstract":[{"text":"Distance or similarity metrics supported by ","type":"text"},{"identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/VectorStore","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"symbol","url":"\/documentation\/swiftcluster\/vectormetric","kind":"symbol"},"doc://SwiftCluster/documentation/SwiftCluster/HNSWIndex":{"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"HNSWIndex"}],"kind":"symbol","role":"symbol