{"hierarchy":{"paths":[["doc:\/\/SwiftML\/documentation\/SwiftML"]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftSci provides native, wire-format serialization engines for both Apple Core ML and ONNX without requiring external Python tooling or code generation steps. Models trained natively in Swift can be directly exported to binary artifacts compatible with Apple Neural Engine (ANE), Metal GPU, CPU, and ONNX Runtime."}]},{"level":2,"type":"heading","anchor":"1-Core-ML-Binary-Export-mlmodel","text":"1. Core ML Binary Export (`.mlmodel`)"},{"type":"paragraph","inlineContent":[{"text":"SwiftSci implements binary Protocol Buffer serialization directly conforming to Apple’s ","type":"text"},{"type":"codeVoice","code":"Model.proto"},{"text":" specification (v4).","type":"text"}]},{"level":3,"type":"heading","anchor":"Supported-Estimators","text":"Supported Estimators"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Estimator","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Core ML Message","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Target Hardware"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"LinearRegression"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"GLMRegressor"}],"type":"paragraph"}],[{"inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"LogisticRegression","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"GLMClassifier","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DecisionTreeClassifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeEnsembleClassifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"DecisionTreeRegressor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeEnsembleRegressor"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RandomForestClassifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeEnsembleClassifier"},{"type":"text","text":" (multi-tree)"}]}],[{"inlineContent":[{"text":"CPU \/ GPU \/ ANE","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"RandomForestRegressor","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TreeEnsembleRegressor"},{"text":" (multi-tree)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU \/ GPU \/ ANE"}]}]]],"alignments":["left","left","left"]},{"text":"Using the `CoreMLExportable` Protocol","anchor":"Using-the-CoreMLExportable-Protocol","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"All supported model types conform to the ","type":"text"},{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","type":"reference","isActive":true},{"text":" protocol, providing asynchronous export methods:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftML","","\/\/ Train a Random Forest Classifier","let rf = try RandomForestClassifier(nEstimators: 50, maxDepth: 8)","try await rf.fit(features: X_train, targets: y_train)","","\/\/ Export directly to a .mlmodel file","let exportURL = URL(fileURLWithPath: \"\/path\/to\/RandomForest.mlmodel\")","try await rf.writeCoreML(","    to: exportURL,","    featureNames: [\"age\", \"income\", \"credit_score\"],","    outputName: \"approved\"",")"]},{"text":"Direct Serialization via `CoreMLExporter`","anchor":"Direct-Serialization-via-CoreMLExporter","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also use static methods on "},{"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","isActive":true,"type":"reference"},{"type":"text","text":" to produce binary "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" payloads:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Export fitted linear regression","let modelData = CoreMLExporter.exportBinaryLinearModel(","    name: \"HousePricePredictor\",","    inputNames: [\"sqft\", \"bedrooms\", \"bathrooms\"],","    outputName: \"price\",","    weights: [250.0, 15000.0, 10000.0],","    bias: 50000.0",")","","try modelData.write(to: URL(fileURLWithPath: \"HousePricePredictor.mlmodel\"))"]},{"text":"Exporting Composite Pipelines & Modern .mlpackage","anchor":"Exporting-Composite-Pipelines--Modern-mlpackage","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"SwiftSci v3.3.0 supports exporting multi-stage composite pipelines and modern ","type":"text"},{"code":".mlpackage","type":"codeVoice"},{"text":" directory bundles:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Export composite pipeline chaining preprocessing + classifier","let pipelineData = CoreMLExporter.exportBinaryPipelineClassifier(","    models: [scalerData, rfData],","    names: [\"Scaler\", \"RandomForestClassifier\"],","    inputNames: [\"age\", \"income\"],","    outputName: \"approved\"",")","","\/\/ Export directly into modern .mlpackage bundle format","try CoreMLExporter.writeMLPackage(","    modelData: pipelineData,","    to: URL(fileURLWithPath: \"\/path\/to\/MyPipeline.mlpackage\"),","    author: \"SwiftSci Developer\",","    description: \"End-to-end data science inference pipeline\"",")"]},{"text":"Loading in Client Applications","anchor":"Loading-in-Client-Applications","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Exported ","type":"text"},{"type":"codeVoice","code":".mlmodel"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".mlpackage"},{"text":" files can be compiled and loaded dynamically using Apple’s ","type":"text"},{"type":"codeVoice","code":"CoreML"},{"text":" framework:","type":"text"}]},{"code":["import CoreML","","let compiledURL = try MLModel.compileModel(at: exportURL)","let mlModel = try MLModel(contentsOf: compiledURL)","","let inputDict: [String: Any] = [\"age\": 35.0, \"income\": 75000.0, \"credit_score\": 720.0]","let featureProvider = try MLDictionaryFeatureProvider(dictionary: inputDict)","let output = try mlModel.prediction(from: featureProvider)"],"type":"codeListing","syntax":"swift"},{"anchor":"2-ONNX-Binary-Export-onnx","type":"heading","level":2,"text":"2. ONNX Binary Export (`.onnx`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftSci provides native binary ONNX wire-format export via "},{"type":"reference","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter","isActive":true},{"type":"text","text":":"}]},{"code":["import SwiftML","","let onnxData = ONNXExporter.exportBinaryONNX(","    name: \"LinearONNX\",","    inputs: [\"features\"],","    output: \"prediction\",","    weights: [1.5, -2.0, 0.75],","    bias: 0.5",")","","try onnxData.write(to: URL(fileURLWithPath: \"model.onnx\"))"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"SwiftML"}],"title":"Exporting Models to Core ML and ONNX","role":"collectionGroup","roleHeading":"API Collection"},"topicSections":[{"anchor":"Core-ML-Exporter-API","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable","doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter"],"title":"Core ML Exporter API"}],"identifier":{"url":"doc:\/\/SwiftML\/documentation\/SwiftML\/MLOpsExport","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Guides--Tutorials","identifiers":["doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors"],"title":"Guides & Tutorials"}],"abstract":[{"type":"text","text":"Export trained SwiftSci estimators to native Apple Core ML ("},{"code":".mlmodel","type":"codeVoice"},{"type":"text","text":") and cross-platform ONNX ("},{"code":".onnx","type":"codeVoice"},{"type":"text","text":") binary artifacts for production deployment."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftml\/mlopsexport"]}],"kind":"article","references":{"doc://SwiftML/documentation/SwiftML/ONNXExporter":{"title":"ONNXExporter","url":"\/documentation\/swiftml\/onnxexporter","type":"topic","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ONNXExporter"}],"navigatorTitle":[{"kind":"identifier","text":"ONNXExporter"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ONNXExporter","abstract":[{"type":"text","text":"Exporter for serializing SwiftML models into ONNX model graph specification JSON format."},{"type":"text","text":" "},{"type":"text","text":"Note: Produces a JSON representation of the ONNX graph, not a binary .onnx file."}],"kind":"symbol"},"doc://SwiftML/documentation/SwiftML/CoreMLExportable":{"abstract":[{"type":"text","text":"A protocol for SwiftML estimators that support exporting a trained model"},{"type":"text","text":" "},{"type":"text","text":"as a binary Apple Core ML "},{"code":".mlmodel","type":"codeVoice"},{"type":"text","text":" artifact."}],"navigatorTitle":[{"text":"CoreMLExportable","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","title":"CoreMLExportable","url":"\/documentation\/swiftml\/coremlexportable","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CoreMLExportable","kind":"identifier"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExportable"},"doc://SwiftML/documentation/SwiftML":{"type":"topic","url":"\/documentation\/swiftml","title":"SwiftML","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML","kind":"symbol","abstract":[{"type":"text","text":"Supervised Machine Learning Estimators & Neural Networks."}],"role":"collection"},"doc://SwiftML/documentation/SwiftML/SupervisedClassifiers":{"title":"Supervised Classification Models","url":"\/documentation\/swiftml\/supervisedclassifiers","type":"topic","role":"article","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedClassifiers","abstract":[{"text":"Train classification models using LogisticRegression, DecisionTreeClassifier, RandomForestClassifier, and MLPClassifier.","type":"text"}],"kind":"article"},"doc://SwiftML/documentation/SwiftML/SupervisedRegressors":{"abstract":[{"type":"text","text":"Perform continuous target predictions using LinearRegression (exact OLS), DecisionTreeRegressor, and GradientBoostedTreesRegressor."}],"type":"topic","kind":"article","role":"article","title":"Supervised Regression Models","url":"\/documentation\/swiftml\/supervisedregressors","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/SupervisedRegressors"},"doc://SwiftML/documentation/SwiftML/CoreMLExporter":{"title":"CoreMLExporter","url":"\/documentation\/swiftml\/coremlexporter","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CoreMLExporter"}],"navigatorTitle":[{"kind":"identifier","text":"CoreMLExporter"}],"identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/CoreMLExporter","abstract":[{"text":"Exports fitted SwiftML models to Apple Core ML artifact formats.","type":"text"}],"kind":"symbol"}}}