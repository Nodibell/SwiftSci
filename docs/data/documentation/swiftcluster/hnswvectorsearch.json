[{"type":"text","text":"Maximum outgoing connections per node. Higher values improve recall at the cost of higher memory and index construction time."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"efConstruction"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"200"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Size of dynamic candidate evaluation queue during insertion. Larger values produce higher-quality graph connectivity."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"efSearch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"50"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Dynamic queue size during search traversal. Higher values increase search recall towards 100% exact match."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"metric"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".euclideanDistance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Choice of "},{"type":"codeVoice","code":".euclideanDistance"},{"type":"text","text":", "},{"type":"codeVoice","code":".cosineSimilarity"},{"type":"text","text":", or "},{"type":"codeVoice","code":".dotProduct"},{"type":"text","text":"."}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Example-Usage","type":"heading","level":2,"text":"Example Usage"},{"type":"codeListing","syntax":"swift","code":["import SwiftCluster","","\/\/ 1. Initialize the actor-isolated index","let hnsw = HNSWIndex(metric: .cosineSimilarity, M: 16, efConstruction: 200, efSearch: 50)","","\/\/ 2. Add embeddings asynchronously","await hnsw.add(id: \"doc_news_1\", vector: [0.12, 0.94, -0.31], metadata: [\"category\": \"news\"])","await hnsw.add(id: \"doc_tech_2\", vector: [-0.85, 0.11, 0.52], metadata: [\"category\": \"technology\"])","","\/\/ 3. Query Top-K nearest neighbors","let queryEmbedding = [0.10, 0.90, -0.30]","let matches = await hnsw.search(query: queryEmbedding, topK: 5)","","for match in matches {","    print(\"Matched: \\(match.id) with score: \\(match.score)\")","}"]},{"anchor":"Thread-Safety--Swift-6-Strict-Concurrency","type":"heading","level":2,"text":"Thread Safety & Swift 6 Strict Concurrency"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"HNSWIndex"},{"text":" is implemented as an isolated Swift ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":", guaranteeing thread safety and eliminating race conditions when multiple background tasks insert items or execute queries concurrently.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftcluster\/hnswvectorsearch"]}],"references":{"doc://SwiftCluster/documentation/SwiftCluster/DimensionalityReduction":{"url":"\/documentation\/swiftcluster\/dimensionalityreduction","kind":"article","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/DimensionalityReduction","abstract":[{"text":"Reduce feature dimensionality using SVD-based PCA with automatic CPU and UMA GPU routing.","type":"text"}],"role":"article","type":"topic","title":"Principal Component Analysis (PCA)"},"doc://SwiftCluster/documentation/SwiftCluster/ClusteringAndOutliers":{"role":"article","abstract":[{"text":"High-performance clustering and density-based anomaly detection powered by ","type":"text"},{"type":"codeVoice","code":"KDTree"},{"text":", ","type":"text"},{"type":"codeVoice","code":"DBSCAN"},{"text":", ","type":"text"},{"type":"codeVoice","code":"KMeans"},{"text":", ","type":"text"},{"type":"codeVoice","code":"LocalOutlierFactor"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"IsolationForest"},{"text":".","type":"text"}],"title":"Spatial Indexing, Clustering & Outlier Detection","kind":"article","type":"topic","identifier":"doc:\/\/SwiftCluster\/documentation\/SwiftCluster\/ClusteringAndOutliers","url":"\/documentation\/swiftclu