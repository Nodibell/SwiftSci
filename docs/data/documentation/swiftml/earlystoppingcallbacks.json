arly stopping.","type":"text"}],"title":"MetricDirection"},"doc://SwiftML/documentation/SwiftML/EarlyStopping":{"kind":"symbol","title":"EarlyStopping","abstract":[{"type":"text","text":"A training callback that halts iterative model fitting when validation performance ceases to improve."}],"role":"symbol","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/EarlyStopping","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EarlyStopping","kind":"identifier"}],"url":"\/documentation\/swiftml\/earlystopping","type":"topic","navigatorTitle":[{"text":"EarlyStopping","kind":"identifier"}]},"doc://SwiftML/documentation/SwiftML/ReproducibilityAndPRNG":{"kind":"article","title":"Reproducibility, Determinism & High-Quality PRNG","abstract":[{"text":"Ensure bit-exact experimental reproducibility and statistical robustness across ensemble models and clustering estimators.","type":"text"}],"role":"collectionGroup","identifier":"doc:\/\/SwiftML\/documentation\/SwiftML\/ReproducibilityAndPRNG","url":"\/documentation\/swiftml\/reproducibilityandprng","type":"topic"}}}