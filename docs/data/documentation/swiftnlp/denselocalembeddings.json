{"topicSections":[{"anchor":"Embedding-APIs","title":"Embedding APIs","identifiers":["doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/DenseLocalEmbeddings"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Modern Retrieval-Augmented Generation (RAG) and semantic search systems require dense vector representations of text. Traditional approaches depend on remote APIs (e.g. OpenAI) or large multi-gigabyte models that exhaust memory. ","type":"text"},{"code":"SwiftNLP","type":"codeVoice"},{"text":" introduces ","type":"text"},{"code":"LocalEmbeddingEngine","type":"codeVoice"},{"text":", a subword N-gram character hashing projection engine that produces deterministic, unit-normalized dense embeddings in sub-millisecond execution times.","type":"text"}]},{"type":"heading","text":"1. Algorithmic Foundation","level":2,"anchor":"1-Algorithmic-Foundation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"LocalEmbeddingEngine"},{"type":"text","text":" operates through a three-stage mathematical pipeline:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Subword N-gram Hashing","type":"text"}]},{"type":"text","text":": Text is tokenized into word and character n-grams (sizes 3 to 6). Each n-gram is hashed into a fixed integer space using FNV-1a hash functions."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Dimension Projection","type":"text"}]},{"type":"text","text":": Hashes are projected onto a "},{"code":"D","type":"codeVoice"},{"type":"text","text":"-dimensional vector space (e.g., "},{"code":"D = 128","type":"codeVoice"},{"type":"text","text":" or "},{"code":"D = 256","type":"codeVoice"},{"type":"text","text":") with deterministic sign flips to prevent feature collision bias."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Unit L2 Normalization"}]},{"type":"text","text":": The resulting dense vector is projected onto the unit hypersphere:"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"inlineContent":[{"text":"Formula:","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"v_norm = v \/ ||v||_2 = v \/ sqrt(Σ v_i²)"}],"type":"paragraph"}],"name":"Note"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Because all embeddings have ","type":"text"},{"type":"codeVoice","code":"||v||_2 = 1.0"},{"text":", the ","type":"text"},{"inlineContent":[{"text":"Cosine Similarity","type":"text"}],"type":"strong"},{"text":" between two embeddings is equivalent to their direct ","type":"text"},{"inlineContent":[{"type":"text","text":"Dot Product"}],"type":"strong"},{"text":", allowing single-instruction vector evaluation via Apple Accelerate ","type":"text"},{"type":"codeVoice","code":"vDSP_dotprD"},{"text":":","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Formula:"}]},{"type":"text","text":" "},{"code":"CosineSimilarity(u, v) = u · v","type":"codeVoice"}]}]},{"anchor":"2-Generating-Embeddings","type":"heading","level":2,"text":"2. Generating Embeddings"},{"type":"codeListing","syntax":"swift","code":["import SwiftNLP","","\/\/ Initialize a 128-dimensional local embedding engine","let engine = LocalEmbeddingEngine(dimension: 128)","","\/\/ Generate embedding for a single text snippet","let vector = engine.embed(\"Apple Silicon M3 Max neural network processing\")","print(\"Vector dimension: \\(vector.count)\") \/\/ 128","","\/\/ Batch embedding generation","let documents = [","    \"High-performance computing on macOS\",","    \"Relational database wire protocol drivers\",","    \"Deep convolutional neural networks for vision\"","]","let batchEmbeddings = engine.embedBatch(documents)"]},{"anchor":"3-Integration-with-SwiftClusterVectorStore","type":"heading","level":2,"text":"3. Integration with SwiftCluster.VectorStore"},{"type":"codeListing","syntax":"swift","code":["import SwiftCluster","","let store = VectorStore(metric: .cosineSimilarity)","","for (idx, doc) in documents.enumerated() {","    let vec = engine.embed(doc)","    store.add(id: \"doc_\\(idx)\", vector: vec, metadata: [\"text\": doc])","}","","\/\/ Perform instant semantic similarity search","let query = engine.embed(\"Mac hardware acceleration\")","let topHits = store.search(query: query, topK: 1)","print(\"Top match: \\(topHits.first?.metadata[\"text\"] ?? \"\")\")"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftnlp\/denselocalembeddings"]}],"metadata":{"role":"collectionGroup","modules":[{"name":"SwiftNLP"}],"title":"Dense Local Text Embeddings with Accelerate","roleHeading":"API Collection"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Generate high-dimensional, unit-normalized semantic embeddings 100% offline on Apple Silicon.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SwiftNLP\/documentation\/SwiftNLP"]]},"sections":[],"kind":"article","references":{"doc://SwiftNLP/documentation/SwiftNLP/LocalEmbeddingEngine":{"abstract":[{"text":"A lightweight, on-device dense text embedding generator optimized for Apple Silicon.","type":"text"}],"type":"topic","title":"LocalEmbeddingEngine","navigatorTitle":[{"text":"LocalEmbeddingEngine","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swiftnlp\/localembeddingengine","role":"symbol","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP\/LocalEmbeddingEngine","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LocalEmbeddingEngine","kind":"identifier"}]},"doc://SwiftNLP/documentation/SwiftNLP":{"abstract":[{"text":"Natural Language Processing, Text Feature Extraction & Native Apple NaturalLanguage Integration.","type":"text"}],"url":"\/documentation\/swiftnlp","identifier":"doc:\/\/SwiftNLP\/documentation\/SwiftNLP","kind":"symbol","role":"collection","title":"SwiftNLP","type":"topic"}}}